def value_position(sheet, lookvalue, lookat_type, match = False):
    cell = sheet.api.Cells.Find(lookvalue, After = sheet.api.Cells(1,1) , 
                       LookAt=lookat_type,
                       LookIn=xw.constants.FindLookIn.xlValues,
                       SearchOrder=xw.constants.SearchOrder.xlByRows,
                       MatchCase=match)
    return cell

def column_index_to_letter(index):
    letters = ""    
    while index > 0:
        index, remainder = divmod(index - 1, 26)
        letters = chr(65 + remainder) + letters
    return letters

def sheet_exists_in_file(file_path, sheet_name):
    try:
        with xw.App(visible=False) as app:
            wb = app.books.open(file_path, update_links=False)
            exists = sheet_name in [s.name for s in wb.sheets]
            wb.close()
        return exists
    except Exception:
        return False

def is_file_open_in_excel(fname):
    for wb in xw.apps.active.books:
        if wb.name == fname:
            return True
    # Also check all open workbooks in all apps
    for app in xw.apps:
        for wb in app.books:
            if wb.name == fname:
                return True
    return False

def send_email_from_outlook(macro_wb, process, errorDetails, lineno):
    try:
        to_emails = macro_wb.sheets['Interface'].range('AT5').value
        outlook = win32.Dispatch('Outlook.Application')
        mail = outlook.CreateItem(0)
        session = outlook.Session
        current_user = session.CurrentUser.AddressEntry.GetExchangeUser().PrimarySmtpAddress

        body_text = (
            "<p><br>***This is an autogenerated email whenever the utility raises an error.***<br><br>"
            "</ul><br>The utility has encountered error. Please reach out to the Audit user.<br></p>"
            f"<ul><b><li>Error occurred at:</b> {datetime.now().strftime('%m/%d/%Y %H:%M:%S')}</li>"
            f"<b><li>Error occurred in procedure:</b> {process}</li>"
            f"<b><li>Error description:</b> {errorDetails} </li>"
            f"<b><li>Error occurred in line number</b> {lineno}</li>"
            f"<b><li>User Logged In:</b> {getpass.getuser()}</li>"
            "</ul><br><br></p>"
        )

        mail.To = to_emails
        mail.CC = current_user
        mail.Subject = "(Critical) Blackstone - CITCO Admin - Error Notification!"
        mail.HTMLBody = body_text
        #mail.Display()
        mail.Send()

    except Exception as e:
        print("Exception while sending email.")
        print(f"Error Number: {type(e).__name__}\nError Description: {e}")

