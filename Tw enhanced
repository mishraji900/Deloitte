# MAIN EXECUTOR
# ══════════════════════════════════════════════════════════════════════════════

def run():
    print("=" * 70)
    print("Converting TB_Final from Spark to pandas...")
    # Assuming TB_Final is globally provided by the environment
    df_full = TB_Final.toPandas()
    print("=" * 70)

    for acct_group in Account_Grp_List:
        print(f"\nProcessing: '{acct_group}'")
        
        try:
            df = prepare_data(df_full, acct_group)
            wb = cp.openpyxl.read(TEMPLATE_PATH) # Assuming cp is globally provided
            
            ws_summary = _copy_sheet_from_template(wb, TEMPLATE_SHEET_SUMMARY, _make_sheet_name(acct_group, "Sum"))
            ws_analysis = _copy_sheet_from_template(wb, TEMPLATE_SHEET_ANALYSIS, _make_sheet_name(acct_group, "Ana"))
            ws_tickmarks = _copy_sheet_from_template(wb, TEMPLATE_SHEET_TICKMARKS, _make_sheet_name(acct_group, "Tick"))
            
            group_totals = write_sheet1_summary(ws_summary, df, acct_group)
            write_sheet2_analysis(ws_analysis, group_totals, acct_group)
            
            # Sheet 3 (Tickmarks) remains a stub
            apply_white_background(ws_tickmarks, 100)
            write_sheet_header(ws_tickmarks, acct_group)
            write_cell(ws_tickmarks, 8, 2, "Tickmarks — not yet implemented", font=ITALIC, align=LEFT)
            
            if DELETE_TEMPLATE_SHEETS:
                for t in [TEMPLATE_SHEET_SUMMARY, TEMPLATE_SHEET_ANALYSIS, TEMPLATE_SHEET_TICKMARKS]:
                    if t in wb.sheetnames: del wb[t]
            
            cp.openpyxl.write(wb, _make_output_path(acct_group), register=True)
            print(f"✅ SUCCEEDED: {acct_group}")
            
        except Exception as exc:
            print(f"❌ FAILED on '{acct_group}': {exc}")

if __name__ == "__main__":
    run()
