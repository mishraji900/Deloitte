def _s2_type_of_accounts_table(
        ws, row: int, title: str,
        group_totals: "OrderedDict[str, dict]",
        col_cur_key: str, col_pri_key: str,
        label_cur: str, label_pri: str,
        total_assets_cur_m: float, total_assets_pri_m: float,
        acct_group_val: str) -> tuple:

    B, C, D, E, F = _S2_B, _S2_C, _S2_D, _S2_E, _S2_F

    wc(ws, row, B, title, font=BOLD_ITALIC, align=LEFT)
    row += 2

    wc(ws, row, B, None, border=MED_BOX)
    safe_merge(ws, row, C, row, D)
    wc(ws, row, C, "Carrying Value", font=BOLD, border=MED_BOX, align=CENTER)
    _apply_border_to_merge(ws, row, C, D, MED_BOX)
    safe_merge(ws, row, E, row, F)
    wc(ws, row, E, "Fluctuation", font=BOLD, border=MED_BOX, align=CENTER)
    _apply_border_to_merge(ws, row, E, F, MED_BOX)
    row += 1

    for col_idx, label in [(B, "Type of accounts"), (C, label_cur), (D, label_pri),
                            (E, "$"), (F, "%")]:
        wc(ws, row, col_idx, label, font=HDR_FONT, border=THIN_ALL,
           align=LEFT if col_idx == B else CENTER)
    row += 1

    grand_cur = grand_pri = 0.0
    group_row_start = row

    for group_name, totals in group_totals.items():
        cur_val   = totals.get(col_cur_key, 0.0) / 1e6
        pri_val   = totals.get(col_pri_key, 0.0) / 1e6
        fluct_abs = cur_val - pri_val
        fluct_pct = (fluct_abs / pri_val) if pri_val else 0.0
        grand_cur += cur_val
        grand_pri += pri_val

        for col_idx, val, fmt in [(B, group_name, None), (C, cur_val, MILLION_FMT),
                                   (D, pri_val, MILLION_FMT), (E, fluct_abs, MILLION_FMT),
                                   (F, fluct_pct, PCT_FMT)]:
            wc(ws, row, col_idx, val, font=NORMAL, border=THIN_ALL,
               fmt=fmt, align=LEFT if col_idx == B else RIGHT)
        row += 1

    group_row_end = row - 1

    fluct     = grand_cur - grand_pri
    fluct_pct = (fluct / grand_pri) if grand_pri else 0.0
    for col_idx, val, fmt in [(B, f"      Total {acct_group_val}", None), (C, grand_cur, MILLION_FMT),
                               (D, grand_pri, MILLION_FMT), (E, fluct, MILLION_FMT),
                               (F, fluct_pct, PCT2_FMT)]:
        wc(ws, row, col_idx, val, font=BOLD, border=THIN_ALL,
           fmt=fmt, align=LEFT if col_idx == B else RIGHT)
    row += 1

    ta_fluct = total_assets_cur_m - total_assets_pri_m
    ta_pct   = (ta_fluct / total_assets_pri_m) if total_assets_pri_m else 0.0
    for col_idx, val, fmt in [(B, "Total Assets", None), (C, total_assets_cur_m, MILLION_FMT),
                               (D, total_assets_pri_m, MILLION_FMT), (E, ta_fluct, MILLION_FMT),
                               (F, ta_pct, PCT2_FMT)]:
        wc(ws, row, col_idx, val, font=BOLD, border=THIN_ALL,
           fmt=fmt, align=LEFT if col_idx == B else RIGHT)
    row += 1

    pct_cur = grand_cur / total_assets_cur_m if total_assets_cur_m else 0.0
    pct_pri = grand_pri / total_assets_pri_m if total_assets_pri_m else 0.0
    for col_idx, val, fmt in [(B, "%", None), (C, pct_cur, PCT2_FMT), (D, pct_pri, PCT2_FMT),
                               (E, None, None), (F, None, None)]:
        wc(ws, row, col_idx, val, font=BOLD, border=THIN_ALL,
           fmt=fmt, align=LEFT if col_idx == B else CENTER)
    row += 1

    print(f"  ✓ {title} (S2) written ending at row {row - 1}")
    return row + 2, group_row_start, group_row_end


