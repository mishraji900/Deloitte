# ══════════════════════════════════════════════════════════════════════════════

def write_s1_table1(ws, row: int, group_totals: "OrderedDict[str, dict]",
                    cfg: dict, acct_group_val: str) -> tuple:
    B, C, D, E, F = _START_COL, _START_COL+1, _START_COL+2, _START_COL+3, _START_COL+4

    col_cur = cfg["col_current"]
    col_pri = cfg["col_prior"]

    wc(ws, row, B, "Type of Currencies", font=BOLD_ITALIC, align=LEFT)
    row += 2

    wc(ws, row, B, None, border=MED_BOX)
    safe_merge(ws, row, C, row, D)
    wc(ws, row, C, "Carrying Value", font=BOLD, border=MED_BOX, align=CENTER)
    _apply_border_to_merge(ws, row, C, D, MED_BOX)
    safe_merge(ws, row, E, row, F)
    wc(ws, row, E, "Fluctuation", font=BOLD, border=MED_BOX, align=CENTER)
    _apply_border_to_merge(ws, row, E, F, MED_BOX)
    row += 1

    for col_idx, label in [
        (B, "Type of currencies"),
        (C, cfg["label_current"]),
        (D, cfg["label_prior"]),
        (E, "$"),
        (F, "%"),
    ]:
        wc(ws, row, col_idx, label, font=HDR_FONT, border=THIN_ALL,
           align=LEFT if col_idx == B else CENTER)
    row += 1

    grand_cur = 0.0
    grand_pri = 0.0
    data_row_start = row   # NEW — first group-detail row, chart source start

    for group_name, totals in group_totals.items():
        cur_val   = totals.get(col_cur, 0.0) / 1e6
        pri_val   = totals.get(col_pri, 0.0) / 1e6
        fluct_abs = cur_val - pri_val
        fluct_pct = (fluct_abs / pri_val) if pri_val != 0 else 0.0

        grand_cur += cur_val
        grand_pri += pri_val

        wc(ws, row, B, group_name, font=NORMAL, border=THIN_ALL, align=LEFT)
        wc(ws, row, C, cur_val,    font=NORMAL, border=THIN_ALL,
           fmt=MILLION_FMT, align=RIGHT)
        wc(ws, row, D, pri_val,    font=NORMAL, border=THIN_ALL,
           fmt=MILLION_FMT, align=RIGHT)
        wc(ws, row, E, fluct_abs,  font=NORMAL, border=THIN_ALL,
           fmt=MILLION_FMT, align=RIGHT)
        wc(ws, row, F, fluct_pct,  font=NORMAL, border=THIN_ALL,
           fmt=PCT_FMT,    align=RIGHT)
        row += 1

    data_row_end = row - 1   # NEW — last group-detail row, chart source end

    g_fluct_abs = grand_cur - grand_pri
    g_fluct_pct = (g_fluct_abs / grand_pri) if grand_pri != 0 else 0.0

    wc(ws, row, B, f"Total {acct_group_val}", font=BOLD, border=THIN_ALL, align=LEFT)
    wc(ws, row, C, grand_cur,  font=BOLD, border=THIN_ALL,
       fmt=MILLION_FMT, align=RIGHT)
    wc(ws, row, D, grand_pri,  font=BOLD, border=THIN_ALL,
       fmt=MILLION_FMT, align=RIGHT)
    wc(ws, row, E, g_fluct_abs, font=BOLD, border=THIN_ALL,
       fmt=MILLION_FMT, align=RIGHT)
    wc(ws, row, F, g_fluct_pct, font=BOLD, border=THIN_ALL,
       fmt=PCT_FMT,    align=RIGHT)
    row += 1

    wc(ws, row, B, "Total Assets", font=NORMAL, border=THIN_ALL, align=LEFT)
    wc(ws, row, C, cfg["total_assets_current_m"], font=NORMAL, border=THIN_ALL,
       fmt=MILLION_FMT, align=RIGHT)
    wc(ws, row, D, cfg["total_assets_prior_m"],   font=NORMAL, border=THIN_ALL,
       fmt=MILLION_FMT, align=RIGHT)
    wc(ws, row, E, None, border=THIN_ALL)
    wc(ws, row, F, None, border=THIN_ALL)
    row += 1

    wc(ws, row, B, "%", font=ITALIC, border=THIN_ALL, align=LEFT)
    wc(ws, row, C, grand_cur / cfg["total_assets_current_m"],
       font=ITALIC, border=THIN_ALL, fmt=PCT2_FMT, align=RIGHT)
    wc(ws, row, D, grand_pri / cfg["total_assets_prior_m"],
       font=ITALIC, border=THIN_ALL, fmt=PCT2_FMT, align=RIGHT)
    wc(ws, row, E, None, border=THIN_ALL)
    wc(ws, row, F, None, border=THIN_ALL)

    print(f"  ✅ Table 1 (S1) written ending at row {row}")
    return row + 2, data_row_start, data_row_end   # NEW — 3-tuple


