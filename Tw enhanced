def build_unmatched_rows(base_df, rem_sales_df, rem_credit_df, name: str, stage_path: str = None):
    remaining_ids = (
        rem_sales_df.select(F.col("sales_row_id").alias("row_id"))
        .unionByName(rem_credit_df.select(F.col("credit_row_id").alias("row_id")))
        .distinct()
    )
    unmatched = base_df.join(remaining_ids, on="row_id", how="inner")
    return materialize_df(unmatched, name, "primary_key", stage_path)

def resolve_to_original(pairs_df, base_df, match_label: str, stage_name: str,
                        stage_path: str = None, has_year_flag: bool = False):
    if pairs_df is None:
        return None
    w_pair = Window.orderBy(F.col("primary_key").asc(),
                            F.col("sales_row_id").asc(),
                            F.col("credit_row_id").asc())
    pairs_with_id = (
        pairs_df
        .withColumn("pair_id",
                    F.concat(F.lit(f"{match_label}_"), F.row_number().over(w_pair).cast("string")))
        .select("pair_id", "sales_row_id", "credit_row_id", "match_type")
    )
    if has_year_flag:
        yf_sales = base_df.select(
            F.col("row_id").alias("sales_row_id"),
            F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("sales_year_flag"),
        )
        yf_credit = base_df.select(
            F.col("row_id").alias("credit_row_id"),
            F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("credit_year_flag"),
        )
        pairs_with_id = (
            pairs_with_id
            .join(yf_sales, on="sales_row_id", how="left")
            .join(yf_credit, on="credit_row_id", how="left")
            .withColumn(
                "Year Pair Flag",
                F.when(
                    (F.col("sales_year_flag") == PRIOR_FY) & (F.col("credit_year_flag") == CURRENT_FY),
                    F.lit(f"PY Sales Inv with CY Credit Memo")
                ).when(
                    (F.col("sales_year_flag") == CURRENT_FY) & (F.col("credit_year_flag") == CURRENT_FY),
                    F.lit("CY Sales Inv with CY Credit Memo")
                ).when(
                    (F.col("sales_year_flag") == PRIOR_FY) & (F.col("credit_year_flag") == PRIOR_FY),
                    F.lit("PY Sales Inv with PY Credit Memo")
                ).when(
                    (F.col("sales_year_flag") == CURRENT_FY) & (F.col("credit_year_flag") == PRIOR_FY),
                    F.lit("CY Sales Inv with PY Credit Memo")
                ).otherwise(F.lit("Unknown"))
            )
            .select("pair_id", "sales_row_id", "credit_row_id", "match_type", "Year Pair Flag")
        )
        _select_cols = ["pair_id", "match_type", "Year Pair Flag"] + base_df.columns
    else:
        _select_cols = ["pair_id", "match_type"] + base_df.columns

    orig_cols = [F.col(f"orig.`{c}`") for c in base_df.columns]
    meta_cols = [F.col(c) for c in _select_cols if c in ("pair_id", "match_type", "Year Pair Flag")
                 and c not in base_df.columns]
    sales_side = (
        pairs_with_id
        .join(base_df.alias("orig"), pairs_with_id["sales_row_id"] == F.col("orig.row_id"), "inner")
        .select(*meta_cols, *orig_cols)
    )
    credit_side = (
        pairs_with_id
        .join(base_df.alias("orig"), pairs_with_id["credit_row_id"] == F.col("orig.row_id"), "inner")
        .select(*meta_cols, *orig_cols)
    )
    resolved = sales_side.unionByName(credit_side)
    return materialize_df(resolved, stage_name, "primary_key", stage_path)

def rank_based_match(sales_df, credit_df, condition_fn, match_label: str, stage_path: str = None):
    candidates = (
        sales_df.alias("s")
        .join(credit_df.alias("c"), on="primary_key", how="inner")
        .withColumn("amount_diff", F.abs(F.col("s.sales_amt") + F.col("c.credit_amt")))
        .withColumn("month_lag",
                    F.months_between(F.col("c.credit_month").cast("date"),
                                     F.col("s.sales_month").cast("date")).cast("int"))
    )
    candidates = condition_fn(candidates)
    if candidates.limit(1).count() == 0:
        return None, sales_df, credit_df
    w_sales = Window.partitionBy("primary_key", "s.sales_row_id").orderBy(
        F.col("amount_diff").asc(), F.col("month_lag").asc(),
        F.col("c.credit_eff_dt").asc(), F.col("c.credit_row_id").asc(),
    )
    w_credit = Window.partitionBy("primary_key", "c.credit_row_id").orderBy(
        F.col("amount_diff").asc(), F.col("month_lag").asc(),
        F.col("s.sales_eff_dt").asc(), F.col("s.sales_row_id").asc(),
    )
    confirmed = (
        candidates
        .withColumn("rn_sales", F.row_number().over(w_sales))
        .filter(F.col("rn_sales") == 1)
        .withColumn("rn_credit", F.row_number().over(w_credit))
        .filter(F.col("rn_credit") == 1)
        .select(
            F.col("primary_key"),
            F.col("s.sales_row_id").alias("sales_row_id"),
            F.col("c.credit_row_id").alias("credit_row_id"),
            F.col("s.sales_amt").alias("sales_amt"),
            F.col("c.credit_amt").alias("credit_amt"),
            F.col("amount_diff"),
            F.col("s.sales_eff_dt").alias("sales_eff_dt"),
            F.col("c.credit_eff_dt").alias("credit_eff_dt"),
            F.col("s.sales_month").alias("sales_month"),
            F.col("c.credit_month").alias("credit_month"),
            F.col("s.sales_ref").alias("sales_ref"),
            F.col("c.credit_ref").alias("credit_ref"),
            F.col("month_lag"),
            F.lit(match_label).alias("match_type"),
        )
    )
    if confirmed.limit(1).count() == 0:
        return None, sales_df, credit_df
    confirmed = materialize_df(confirmed, f"confirmed_{match_label}", stage_path)
    matched_s = confirmed.select("sales_row_id").distinct()
    matched_c = confirmed.select("credit_row_id").distinct()
    rem_sales = materialize_df(
        sales_df.join(matched_s, on="sales_row_id", how="left_anti"),
        f"rem_s_{match_label}", stage_path,
    )
    rem_credit = materialize_df(
        credit_df.join(matched_c, on="credit_row_id", how="left_anti"),
        f"rem_c_{match_label}", stage_path,
    )
    return confirmed, rem_sales, rem_credit

def exhaustive_match(sales_df, credit_df, condition_fn, match_label: str,
                     base_df, stage_path: str = None, has_year_flag: bool = False):
    print(f"\n[EXHAUSTIVE MATCH] {match_label}")
    accumulated = []
    cur_sales, cur_credit = sales_df, credit_df
    for iteration in range(1, 9999):
        print(f"  Iteration {iteration} ...")
        pairs, rem_s, rem_c = rank_based_match(
            cur_sales, cur_credit, condition_fn, f"{match_label}_i{iteration}", stage_path
        )
        if pairs is None:
            print(f"  No pairs at iteration {iteration}. Done.")
            break
        n = pairs.count()
        print(f"  Iteration {iteration}: {n:,} pairs.")
        if n == 0:
            break
        pairs = pairs.withColumn("match_type", F.lit(match_label))
        pairs = materialize_df(pairs, f"pairs_{match_label}_i{iteration}", stage_path)
        accumulated.append(pairs)
        cur_sales, cur_credit = rem_s, rem_c
    if not accumulated:
        print(f"  [{match_label}] Total pairs: 0")
        return None, sales_df, credit_df
    slim_all = accumulated[0]
    for p in accumulated[1:]:
        slim_all = slim_all.unionByName(p)
    slim_all = materialize_df(slim_all, f"SLIM_{match_label}", stage_path)
    total_pairs = slim_all.count()
    print(f"  [{match_label}] Total pairs across {len(accumulated)} iteration(s): {total_pairs:,}")
    resolved = resolve_to_original(
        slim_all, base_df, match_label, f"RESOLVED_{match_label}", stage_path, has_year_flag
    )
    print(f"  [{match_label}] Resolved rows : {resolved.count():,}")
    print(f"  [{match_label}] Remaining sales : {cur_sales.count():,}")
    print(f"  [{match_label}] Remaining credit: {cur_credit.count():,}")
    return resolved, cur_sales, cur_credit

MATCH_STEPS = [
    ("NEXT_MONTH_EXACT",
     lambda df: df.filter((F.col("month_lag") == 1) & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt")) & (F.col("amount_diff") == EXACT_ZERO))),
    ("SAME_MONTH_EXACT",
     lambda df: df.filter((F.col("month_lag") == 0) & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt")) & (F.col("amount_diff") == EXACT_ZERO))),
    ("LAG_1_2_MONTH",
     lambda df: df.filter(F.col("month_lag").between(1,2) & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt")) & (F.col("amount_diff") == EXACT_ZERO))),
    ("SAME_MONTH_ITERATIVE",
     lambda df: df.filter((F.col("month_lag") == 0) & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt")) & (F.col("amount_diff") == EXACT_ZERO))),
]

def run_match_pipeline(sales_df, credit_df, base_df, steps: list, stage_path: str, has_year_flag: bool = False):
    resolved_datasets = []
    cur_s, cur_c = sales_df, credit_df
    for match_label, condition_fn in steps:
        resolved, cur_s, cur_c = exhaustive_match(
            cur_s, cur_c, condition_fn, match_label, base_df, stage_path, has_year_flag
        )
        resolved_datasets.append((match_label, resolved))
    return resolved_datasets, cur_s, cur_c

def assign_aa_comment(df, raw_df, small_amt_threshold: float = SMALL_AMT_MAX):
    """
    AA Comment using the record's own Source Quarter (not execution quarter).
    """
    # First, enrich df with vendor stats from raw_df
    vendor_stats = (
        raw_df
        .withColumn("vendor_num_clean", F.trim(F.col("Vendor/Customer Number").cast("string")))
        .withColumn("cat_clean", F.trim(F.upper(F.col("JE Category"))))
        .groupBy("vendor_num_clean")
        .agg(
            F.countDistinct(F.when(F.col("cat_clean") == "SALES INVOICES", F.col("Invoice Reference"))).alias("sales_inv_count"),
            F.countDistinct(F.when(F.col("cat_clean") == "CREDIT MEMOS", F.col("Invoice Reference"))).alias("credit_memo_count"),
            F.countDistinct(F.when(F.col("cat_clean") == "CREDIT MEMOS",
                                   F.struct("Vendor/Customer Number", "Net Entered"))).alias("credit_combinations"),
        )
    )
    df = df.join(
        vendor_stats.select(
            F.col("vendor_num_clean").alias("_vn"),
            "sales_inv_count", "credit_memo_count", "credit_combinations",
        ),
        df["vendor_num_clean"] == F.col("_vn"),
        "left"
    ).drop("_vn")

    # Helper to get first month from Source Quarter string (e.g. "Q2" → April)
    def first_month_of_quarter(quarter_col):
        return F.when(quarter_col == "Q1", F.lit(1)) \
                 .when(quarter_col == "Q2", F.lit(4)) \
                 .when(quarter_col == "Q3", F.lit(7)) \
                 .when(quarter_col == "Q4", F.lit(10))

    first_month_num = first_month_of_quarter(F.col("Source Quarter"))

    # Apply rules in priority order
    df = df.withColumn("AA Comment", F.lit(None).cast("string"))
    df = df.withColumn("AA Rule", F.lit(None).cast("string"))

    # Rule Group 1: ONE_TO_MANY
    otm = F.col("match_type") == "ONE_TO_MANY"
    df = df.withColumn(
        "AA Comment",
        F.when(otm, AA_REQUIRES_REVIEW).otherwise(F.col("AA Comment"))
    ).withColumn(
        "AA Rule",
        F.when(otm, F.lit("Rule1_OTM_BaseReview")).otherwise(F.col("AA Rule"))
    )

    # Rule Group 2: ONE_TO_ONE_DATE_UNSYNC
    unsync = F.col("match_type") == "ONE_TO_ONE_DATE_UNSYNC"
    # For unsync we need to detect exact cancellation; we'll use a placeholder logic:
    # In resolved pairs, exact cancellation can be checked via pair-level sum.
    # For simplicity (and because this is a business rule placeholder), we assume
    # exact match if |sales_amt + credit_amt| == 0. The real pair info is not in this df,
    # so we keep the rule as "Exact Match" / "Approx Match" based on the existence of a pair.
    # In practice, you may need to join back pair-level data. Here we assign a default.
    df = df.withColumn(
        "AA Comment",
        F.when(unsync & F.col("AA Comment").isNull(), AA_EXACT_MATCH).otherwise(F.col("AA Comment"))
    ).withColumn(
        "AA Rule",
        F.when(unsync & F.col("AA Rule").isNull(), F.lit("Rule2_OTM_Unsync")).otherwise(F.col("AA Rule"))
    )

    # Rule Group 3: NO_MATCH_FOUND (priority 1-5)
    no_match = F.col("match_type") == "NO_MATCH_FOUND"
    # P1: only credit memos for vendor
    df = df.withColumn(
        "AA Comment",
        F.when(no_match & (F.col("sales_inv_count") == 0) & (F.col("credit_memo_count") > 0),
               AA_ONLY_CREDITS).otherwise(F.col("AA Comment"))
    ).withColumn(
        "AA Rule",
        F.when(no_match & (F.col("sales_inv_count") == 0) & (F.col("credit_memo_count") > 0),
               F.lit("Rule3P1_OnlyCredits")).otherwise(F.col("AA Rule"))
    )
    # P2: single credit combo
    df = df.withColumn(
        "AA Comment",
        F.when(no_match & (F.col("credit_combinations") == 1),
               AA_SINGLE_CREDIT_COMBO).otherwise(F.col("AA Comment"))
    ).withColumn(
        "AA Rule",
        F.when(no_match & (F.col("credit_combinations") == 1),
               F.lit("Rule3P2_SingleCreditCombo")).otherwise(F.col("AA Rule"))
    )
    # P3: small amount
    df = df.withColumn(
        "AA Comment",
        F.when(no_match & (F.col("abs_entered_dec") <= F.lit(small_amt_threshold).cast(DECIMAL_TYPE)),
               AA_SMALL_AMOUNT).otherwise(F.col("AA Comment"))
    ).withColumn(
        "AA Rule",
        F.when(no_match & (F.col("abs_entered_dec") <= F.lit(small_amt_threshold).cast(DECIMAL_TYPE)),
               F.lit(f"Rule3P3_SmallAmt_le_{small_amt_threshold}")).otherwise(F.col("AA Rule"))
    )
    # P4: first month of Source Quarter
    df = df.withColumn(
        "AA Comment",
        F.when(no_match & (F.month(F.col("eff_dt")) == first_month_num),
               F.concat(F.lit(QUARTER_FIRST_MONTH[F.col("Source Quarter")]), F.lit(" Credit Memo"))).otherwise(F.col("AA Comment"))
    ).withColumn(
        "AA Rule",
        F.when(no_match & (F.month(F.col("eff_dt")) == first_month_num),
               F.concat(F.lit("Rule3P4_FirstMonthOfQtr_"), F.col("Source Quarter"))).otherwise(F.col("AA Rule"))
    )
    # P5: catch-all
    df = df.withColumn(
        "AA Comment",
        F.when(no_match & F.col("AA Comment").isNull(), AA_CLIENT_CONFIRM).otherwise(F.col("AA Comment"))
    ).withColumn(
        "AA Rule",
        F.when(no_match & F.col("AA Rule").isNull(), F.lit("Rule3P5_ClientConfirm")).otherwise(F.col("AA Rule"))
    )
    return df.drop("sales_inv_count", "credit_memo_count", "credit_combinations")

