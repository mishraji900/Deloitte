write_table(P2_EXC_1,            "P2_DATASET_EXC_1")
write_table(P2_DUP_OTHER_OR_ZERO,"P2_DUP_OTHER_OR_ZERO")
write_table(P2_UNIQUE_OTHER,     "P2_UNIQUE_OTHER")
write_table(P2_UNIQUE_SALES,     "P2_UNIQUE_SALES")
write_table(P2_UNIQUE_CREDITS,   "P2_UNIQUE_CREDITS")
for lbl, df in p2_resolved_list:
    write_table(df, f"P2_MATCHED_{lbl}")
write_table(P2_UNMATCHED, "P2_REMAIN_UNMATCHED")

print("\n[P2] === PIPELINE 2 AUDIT ===")
audit_summary({
    "P2_INVALID":          P2_INVALID,
    "P2_EXC_1":            P2_EXC_1,
    "P2_UNIQUE_OTHER":     P2_UNIQUE_OTHER,
    "P2_UNIQUE_SALES":     P2_UNIQUE_SALES,
    "P2_UNIQUE_CREDITS":   P2_UNIQUE_CREDITS,
    "P2_DUP_OTHER_OR_ZERO": P2_DUP_OTHER_OR_ZERO,
    **{f"P2_MATCHED_{lbl}": df for lbl, df in p2_resolved_list},
    "P2_UNMATCHED":        P2_UNMATCHED,
})

P2_ALL_MATCHED  = union_non_null(*[df for _, df in p2_resolved_list])
P2_ALL_UNMATCHED = union_non_null(P2_UNIQUE_SALES, P2_UNIQUE_CREDITS, P2_UNMATCHED)

print("\n[P2] Done.")

# COMMAND ----------

# =============================================================================
# CELL 6 — PIPELINE 3 (Tolerance matching on looser PK, propagates Source Quarter)
# =============================================================================
print("\n" + "="*70)
print("PIPELINE 3 — Tolerance matching on looser PK (no amount in key)")
print("="*70)

# ── Step P3-0: Prep derived columns ──────────────────────────────────────────
print("\n[P3-S0] Preparing derived columns on P2 unmatched...")

# Re-derive from raw columns (idempotent; safe even if columns already exist)
p3_input = base_tag(P2_ALL_UNMATCHED, PIPE2_RAW_COLUMNS)

# Build loose PK: company_desc + vendor_num (no amount component)
p3_input = p3_input.withColumn(
    "p3_primary_key",
    F.when(
        F.col("valid_company_desc").isNull()
        | (F.col("company_desc_clean") == "")
        | F.col("valid_vendor_num").isNull()
        | (F.col("vendor_num_clean") == ""),
        F.lit(None),
    ).otherwise(
        F.concat_ws("_", F.col("company_desc_clean"), F.col("vendor_num_clean"))
    )
).drop("is_valid_row", "valid_company_desc", "valid_vendor_num")

p3_invalid_pk = materialize_df(
    p3_input.filter(F.col("p3_primary_key").isNull()),
    "P3_invalid_pk", "row_id", STAGE_PATH_P3,
)
p3_base = materialize_df(
    p3_input.filter(F.col("p3_primary_key").isNotNull()),
    "P3_base", "p3_primary_key", STAGE_PATH_P3,
)

debug_count("P3 valid PK",   p3_base)
debug_count("P3 invalid PK", p3_invalid_pk)

# Null profile on invalid PK rows
print("\n  [PROFILE] PK failure breakdown")
p3_invalid_pk.select(
    F.sum(F.when(F.col("company_desc_clean").isNull() | (F.col("company_desc_clean") == ""), 1)
           .otherwise(0)).alias("missing_company_desc"),
    F.sum(F.when(F.col("vendor_num_clean").isNull() | (F.col("vendor_num_clean") == ""), 1)
           .otherwise(0)).alias("missing_vendor_num"),
    F.sum(F.when(
        (F.col("company_desc_clean").isNull() | (F.col("company_desc_clean") == ""))
        & (F.col("vendor_num_clean").isNull()   | (F.col("vendor_num_clean") == "")),
        1).otherwise(0)).alias("missing_both"),
).show(truncate=False)

# ── Step P3-2: Sales / credit side tables (using p3_primary_key) ─────────────
print("\n[P3-S2] Building sales / credit side tables...")

p3_sales  = materialize_df(make_sales(p3_base, "p3_primary_key"),  "P3_sales",  STAGE_PATH_P3)
p3_credit = materialize_df(make_credit(p3_base, "p3_primary_key"), "P3_credit", STAGE_PATH_P3)

debug_count("P3 sales",  p3_sales)
debug_count("P3 credit", p3_credit)

# ── Step P3-3: Tolerance cross-join ──────────────────────────────────────────
print(f"\n[P3-S3] Cross-joining within PK; tolerance = {P3_TOLERANCE}...")

_tol = F.lit(P3_TOLERANCE).cast(DECIMAL_TYPE)

p3_candidates = (
    p3_sales.alias("s")
    .join(p3_credit.alias("c"), on="primary_key", how="inner")
    .withColumn("amount_net", F.abs(F.col("s.sales_amt") + F.col("c.credit_amt")))
    .filter(F.col("amount_net") <= _tol)
    .select(
        "primary_key",
        F.col("s.sales_row_id"), F.col("c.credit_row_id"),
        F.col("s.sales_amt"),    F.col("c.credit_amt"),    F.col("amount_net"),
        F.col("s.sales_eff_dt"), F.col("c.credit_eff_dt"),
        F.col("s.sales_month"),  F.col("c.credit_month"),
        F.col("s.sales_ref"),    F.col("c.credit_ref"),
    )
)
p3_candidates = materialize_df(p3_candidates, "P3_candidates", STAGE_PATH_P3)
debug_count("P3 candidates (within tolerance)", p3_candidates)

# ── Step P3-4: One-to-many vs one-to-one classification ──────────────────────
print("\n[P3-S4] Classifying one-to-many vs one-to-one...")

sales_match_cts  = p3_candidates.groupBy("sales_row_id") \
    .agg(F.countDistinct("credit_row_id").alias("credit_count_per_sale"))
credit_match_cts = p3_candidates.groupBy("credit_row_id") \
    .agg(F.countDistinct("sales_row_id").alias("sales_count_per_credit"))

p3_classified = (
    p3_candidates
    .join(sales_match_cts,  on="sales_row_id",  how="left")
    .join(credit_match_cts, on="credit_row_id", how="left")
    .withColumn("is_one_to_many",
        (F.col("credit_count_per_sale") > 1) | (F.col("sales_count_per_credit") > 1))
)
p3_classified = materialize_df(p3_classified, "P3_classified", STAGE_PATH_P3)

# ── Step P3-5: ONE_TO_MANY ───────────────────────────────────────────────────
print("\n[P3-S5] Building ONE_TO_MANY dataset...")

otm_ids = (
    p3_classified.filter(F.col("is_one_to_many"))
    .select(F.col("sales_row_id").alias("row_id"))
    .unionByName(
        p3_classified.filter(F.col("is_one_to_many"))
        .select(F.col("credit_row_id").alias("row_id"))
    )
    .distinct()
)

P3_ONE_TO_MANY = materialize_df(
    p3_base.join(otm_ids, on="row_id", how="inner")
           .withColumn("match_type", F.lit("ONE_TO_MANY")),
    "P3_ONE_TO_MANY", STAGE_PATH_P3,
)
debug_count("P3_ONE_TO_MANY", P3_ONE_TO_MANY)

# ── Step P3-6: ONE_TO_ONE — date sync/unsync ─────────────────────────────────
print("\n[P3-S6] Building DATE_SYNC / DATE_UNSYNC datasets...")

oto = (
    p3_classified.filter(~F.col("is_one_to_many"))
    .withColumn("date_sync", F.col("sales_eff_dt") < F.col("credit_eff_dt"))
)
oto = materialize_df(oto, "P3_oto", STAGE_PATH_P3)

def _ids_for_flag(oto_df, flag_val):
    flt = oto_df.filter(F.col("date_sync") == flag_val)
    return (
        flt.select(F.col("sales_row_id").alias("row_id"))
           .unionByName(flt.select(F.col("credit_row_id").alias("row_id")))
           .distinct()
    )

sync_ids   = _ids_for_flag(oto, True)
unsync_ids = _ids_for_flag(oto, False)

P3_DATE_SYNC = materialize_df(
    p3_base.join(sync_ids, on="row_id", how="inner")
           .withColumn("match_type", F.lit("ONE_TO_ONE_DATE_SYNC")),
    "P3_DATE_SYNC", STAGE_PATH_P3,
)
P3_DATE_UNSYNC = materialize_df(
    p3_base.join(unsync_ids, on="row_id", how="inner")
           .withColumn("match_type", F.lit("ONE_TO_ONE_DATE_UNSYNC")),
    "P3_DATE_UNSYNC", STAGE_PATH_P3,
)

debug_count("P3_DATE_SYNC",   P3_DATE_SYNC)
debug_count("P3_DATE_UNSYNC", P3_DATE_UNSYNC)

# ── Step P3-7: NO_MATCH_FOUND ─────────────────────────────────────────────────
print("\n[P3-S7] Building NO_MATCH_FOUND...")

matched_ids_all = (
    otm_ids.unionByName(sync_ids).unionByName(unsync_ids).distinct()
)

p3_no_match = materialize_df(
    p3_base.join(matched_ids_all, on="row_id", how="left_anti")
           .withColumn("match_type", F.lit("NO_MATCH_FOUND")),
    "P3_no_match", STAGE_PATH_P3,
)

P3_NO_MATCH_FOUND = materialize_df(
    union_non_null(
        p3_no_match,
        p3_invalid_pk.withColumn("match_type", F.lit("NO_MATCH_FOUND")),
    ),
    "P3_NO_MATCH_FOUND", STAGE_PATH_P3,
)
debug_count("P3_NO_MATCH_FOUND", P3_NO_MATCH_FOUND)

# ── Step P3-8: Row conservation audit ────────────────────────────────────────
print("\n[P3-S8] === PIPELINE 3 AUDIT ===")

cnt_in      = p3_input.count()
cnt_otm     = P3_ONE_TO_MANY.count()
cnt_sync    = P3_DATE_SYNC.count()
cnt_unsync  = P3_DATE_UNSYNC.count()
cnt_no_match= P3_NO_MATCH_FOUND.count()
cnt_out     = cnt_otm + cnt_sync + cnt_unsync + cnt_no_match

print(f"\n  {'INPUT  — p3_input':<50} {cnt_in:>10,}")
print(f"  {'OUTPUT — P3_ONE_TO_MANY':<50} {cnt_otm:>10,}")
print(f"  {'OUTPUT — P3_DATE_SYNC':<50} {cnt_sync:>10,}")
print(f"  {'OUTPUT — P3_DATE_UNSYNC':<50} {cnt_unsync:>10,}")
print(f"  {'OUTPUT — P3_NO_MATCH_FOUND':<50} {cnt_no_match:>10,}")
print(f"  {'-'*62}")
print(f"  {'Total IN':<50} {cnt_in:>10,}")
print(f"  {'Total OUT':<50} {cnt_out:>10,}")
print(f"  {'Diff (should be 0)':<50} {cnt_in - cnt_out:>10,}")

assert cnt_in == cnt_out, (
    f"Row count mismatch! IN={cnt_in:,}  OUT={cnt_out:,}  DIFF={cnt_in-cnt_out:,}"
)

# ── Step P3-9: Write outputs ──────────────────────────────────────────────────
print("\n[P3-S9] Writing Pipeline 3 outputs...")

write_table(P3_ONE_TO_MANY,    "P3_ONE_TO_MANY")
write_table(P3_DATE_SYNC,      "P3_DATE_SYNC")
write_table(P3_DATE_UNSYNC,    "P3_DATE_UNSYNC")
write_table(P3_NO_MATCH_FOUND, "P3_NO_MATCH_FOUND")

