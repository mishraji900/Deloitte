def prepare_data(df_full: pd.DataFrame, acct_group_val: str) -> pd.DataFrame:
    df = df_full[df_full[ACCT_GROUP_COL] == acct_group_val].copy()
    if df.empty:
        raise ValueError(f"No rows where {ACCT_GROUP_COL} = '{acct_group_val}'.")

    df[BAL_COLS + FLUCT_COLS] = df[BAL_COLS + FLUCT_COLS].apply(pd.to_numeric, errors="coerce").fillna(0)
    return df

