def _make_output_path(acct_group: str) -> str:
    clean = re.sub(r'[^\w\s-]', '', acct_group).strip()
    clean = re.sub(r'\s+', '_', clean).strip('_')
    return f"{OUTPUT_DIRECTORY}/Risk_Assessment_{clean}.xlsx"

def _make_sheet_name(acct_group: str, suffix: str) -> str:
    clean = re.sub(r'[\[\]:*?/\\]', '', acct_group).strip()
    return f"{clean[:(31 - len(suffix) - 1)]}-{suffix}"

def _copy_sheet_from_template(wb, template_name: str, new_name: str):
    if new_name in wb.sheetnames:
        return wb[new_name]
    new_ws = wb.copy_worksheet(wb[template_name])
    new_ws.title = new_name
    return new_ws

def write_cell(ws, row, col, value=None, font=None, border=None, fmt=None, align=None, fill=None):
    cell = ws.cell(row=row, column=col, value=value)
    if font:   cell.font = font
    if border: cell.border = border
    if fmt:    cell.number_format = fmt
    if align:  cell.alignment = align
    if fill:   cell.fill = fill
    return cell

def write_merged_box(ws, r1, c1, r2, c2, value, font, border, align):
    ws.merge_cells(start_row=r1, start_column=c1, end_row=r2, end_column=c2)
    write_cell(ws, r1, c1, value, font=font, align=align)
    for r in range(r1, r2 + 1):
        for c in range(c1, c2 + 1):
            ws.cell(row=r, column=c).border = border

def apply_white_background(ws, n_rows: int, n_cols: int = 15):
    for r in range(1, n_rows + 1):
        for c in range(1, n_cols + 1):
            ws.cell(row=r, column=c).fill = WHITE_FILL

