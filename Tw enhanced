APPROVED_COLORS = [
    "C8D96F", "046A38", "D0E9DA", "9DC3B4", "43B39A", "007B74",
    "005151", "003D33", "A7C9E0", "2E7FAF", "012169", "BBBCBC", "53565A",
]

BAR_COLORS = [
    "C8D96F",   # Type of accounts      — yellow
    "012169",   # Carrying Value cur    — dark navy
    "86BC25",   # Carrying Value pri-1  — Deloitte green
    "2E7FAF",   # Carrying Value pri-2  — steel blue
]


def _legend(position: str = "r") -> Legend:
    lg          = Legend()
    lg.position = position
    lg.overlay  = False
    return lg


def _pie_labels() -> DataLabelList:
    dl = DataLabelList()
    dl.showPercent      = True
    dl.showVal          = False
    dl.showCatName      = False
    dl.showSerName      = False
    dl.showLegendKey    = False
    dl.showLeaderLines  = True
    dl.numFmt = NumFmt(formatCode="0%", sourceLinked=False)
    return dl


def _bar_labels() -> DataLabelList:
    dl = DataLabelList()
    dl.showVal          = True
    dl.showPercent      = False
    dl.showCatName      = False
    dl.showSerName      = False
    dl.showLegendKey    = False
    dl.position         = "outEnd"
    dl.numFmt = NumFmt(formatCode="#,##0.00", sourceLinked=False)
    return dl


def _color_pie_slices(chart: PieChart, num_slices: int) -> None:
    if not chart.series:
        return
    series = chart.series[0]
    for i in range(num_slices):
        pt = DataPoint(idx=i)
        pt.graphicalProperties.solidFill = APPROVED_COLORS[i % len(APPROVED_COLORS)]
        series.dPt.append(pt)


def _color_bar_series(series, hex_color: str) -> None:
    series.graphicalProperties.solidFill      = hex_color
    series.graphicalProperties.line.solidFill = hex_color


def _build_pie(ws, fig_num: int, title: str, first_data_row: int,
               last_data_row: int, label_col: int, val_col: int,
               chart_width: float, chart_height: float) -> PieChart:
    num_slices = last_data_row - first_data_row + 1

    chart            = PieChart()
    chart.title      = f"Figure {fig_num}: {title}"
    chart.dataLabels = _pie_labels()
    chart.legend     = _legend("r")
    chart.width      = chart_width
    chart.height     = chart_height

    data = Reference(ws, min_col=val_col,   min_row=first_data_row, max_row=last_data_row)
    cats = Reference(ws, min_col=label_col, min_row=first_data_row, max_row=last_data_row)

    chart.add_data(data, titles_from_data=False)
    chart.set_categories(cats)
    _color_pie_slices(chart, num_slices)

    return chart


def write_pie_charts(
        ws, first_data_row: int, last_data_row: int, label_col: int,
        cur_val_col: int, cur_label: str,
        pri1_val_col: int, pri1_label: str,
        cur2_val_col: int = None, cur2_label: str = None,
        pri2_val_col: int = None, pri2_label: str = None,
        anchor_fig1: str = "B12", anchor_fig2: str = "L12",
        anchor_fig3: str = "B42", anchor_fig4: str = "L42",
        chart_width: float = 16, chart_height: float = 12,
) -> None:
    cur2_val_col = cur2_val_col or cur_val_col
    cur2_label   = cur2_label   or cur_label
    pri2_val_col = pri2_val_col or pri1_val_col
    pri2_label   = pri2_label   or pri1_label

    charts = [
        (1, f"{cur_label} - Composition",  cur_val_col,  anchor_fig1),
        (2, f"{pri1_label} - Composition", pri1_val_col, anchor_fig2),
        (3, f"{cur2_label} - Composition", cur2_val_col, anchor_fig3),
        (4, f"{pri2_label} - Composition", pri2_val_col, anchor_fig4),
    ]

    for fig_num, title, val_col, anchor in charts:
        chart = _build_pie(
            ws=ws, fig_num=fig_num, title=title,
            first_data_row=first_data_row, last_data_row=last_data_row,
            label_col=label_col, val_col=val_col,
            chart_width=chart_width, chart_height=chart_height,
        )
        ws.add_chart(chart, anchor)
        print(f"  ✅ Fig {fig_num} Pie  '{title}' → '{anchor}'")


def write_single_comparison_bar_chart(
        ws, first_data_row: int, last_data_row: int, label_col: int,
        cur_val_col: int, cur_label: str,
        pri1_val_col: int, pri1_label: str,
        pri2_val_col: int = None, pri2_label: str = None,
        type_val_col: int = None, type_label: str = "Type of accounts",
        chart_title: str = "Cash — Period Comparison",
        anchor: str = None, chart_width: float = 28, chart_height: float = 14,
) -> None:
    if anchor is None:
        anchor = f"B{last_data_row + 2}"

    series_spec: list[tuple[int, str, str]] = []
    if type_val_col is not None:
        series_spec.append((type_val_col, type_label, BAR_COLORS[0]))
    series_spec.append((cur_val_col,  cur_label,  BAR_COLORS[1]))
    series_spec.append((pri1_val_col, pri1_label, BAR_COLORS[2]))
    if pri2_val_col is not None:
        series_spec.append((pri2_val_col, pri2_label, BAR_COLORS[3]))

    chart                   = BarChart()
    chart.type              = "col"
    chart.grouping          = "clustered"
    chart.title             = chart_title
    chart.y_axis.numFmt     = "#,##0.00"
    chart.y_axis.title      = None
    chart.x_axis.title      = None
    chart.x_axis.tickLblPos = "low"
    chart.width             = chart_width
    chart.height            = chart_height
    chart.legend            = _legend("b")

    cats = Reference(ws, min_col=label_col, min_row=first_data_row, max_row=last_data_row)

    for idx, (val_col, label, hex_color) in enumerate(series_spec):
        data = Reference(ws, min_col=val_col, min_row=first_data_row, max_row=last_data_row)
        chart.add_data(data, titles_from_data=False)
        series        = chart.series[idx]
        series.title  = SeriesLabel(v=label)
        series.dLbls  = _bar_labels()
        _color_bar_series(series, hex_color)

    chart.set_categories(cats)
    ws.add_chart(chart, anchor)

    print(f"  ✅ Bar chart '{chart_title}' → '{anchor}' "
          f"| {len(series_spec)} series "
          f"| {last_data_row - first_data_row + 1} categories")


def write_all_charts(
        ws, first_data_row: int, last_data_row: int, label_col: int,
        cur_val_col: int, cur_label: str,
        pri1_val_col: int, pri1_label: str,
        pri2_val_col: int = None, pri2_label: str = None,
        type_val_col: int = None, type_label: str = "Type of accounts",
        cur2_val_col: int = None, cur2_label: str = None,
        cur_period: str = "9/30/2025", pri1_period: str = "6/30/2025",
        pri2_period: str = "9/30/2024",
        anchor_fig1: str = "B12", anchor_fig2: str = "L12",
        anchor_fig3: str = "B42", anchor_fig4: str = "L42",
        anchor_bar: str = None,
        pie_width: float = 16, pie_height: float = 12,
        bar_width: float = 28, bar_height: float = 14,
) -> None:
    print(f"\n  📊 Writing charts — {last_data_row - first_data_row + 1} categories ...")

    write_pie_charts(
        ws=ws, first_data_row=first_data_row, last_data_row=last_data_row,
        label_col=label_col, cur_val_col=cur_val_col, cur_label=cur_label,
        pri1_val_col=pri1_val_col, pri1_label=pri1_label,
        cur2_val_col=cur2_val_col, cur2_label=cur2_label,
        pri2_val_col=pri2_val_col, pri2_label=pri2_label,
        anchor_fig1=anchor_fig1, anchor_fig2=anchor_fig2,
        anchor_fig3=anchor_fig3, anchor_fig4=anchor_fig4,
        chart_width=pie_width, chart_height=pie_height,
    )

    write_single_comparison_bar_chart(
        ws=ws, first_data_row=first_data_row, last_data_row=last_data_row,
        label_col=label_col, cur_val_col=cur_val_col, cur_label=cur_label,
        pri1_val_col=pri1_val_col, pri1_label=pri1_label,
        pri2_val_col=pri2_val_col, pri2_label=pri2_label,
        type_val_col=type_val_col, type_label=type_label,
        chart_title=(f"Cash {cur_period} VS {pri1_period}"
                     + (f" VS {pri2_period}" if pri2_val_col else "")),
        anchor=anchor_bar,   # below the 4 pies — caller passes fixed anchor
        chart_width=bar_width, chart_height=bar_height,
    )

    print("  ✅ All charts written.\n")


