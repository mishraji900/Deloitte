def assign_aa_comment(df, raw_df, source_quarter_col="Source Quarter", small_amt_threshold=SMALL_AMT_MAX):
    """
    Assign AA Comment using the record's own Source Quarter.
    If Source Quarter is missing, falls back to CURRENT_QUARTER.
    """
    # Helper to get first month number from quarter string column
    first_month_expr = F.when(
        F.col(source_quarter_col) == "Q1", F.lit(1)
    ).when(
        F.col(source_quarter_col) == "Q2", F.lit(4)
    ).when(
        F.col(source_quarter_col) == "Q3", F.lit(7)
    ).when(
        F.col(source_quarter_col) == "Q4", F.lit(10)
    ).otherwise(F.lit(QUARTER_FIRST_MONTH_NUM.get(CURRENT_QUARTER, 1)))

    first_month_label_expr = F.when(
        F.col(source_quarter_col) == "Q1", F.lit("January")
    ).when(
        F.col(source_quarter_col) == "Q2", F.lit("April")
    ).when(
        F.col(source_quarter_col) == "Q3", F.lit("July")
    ).when(
        F.col(source_quarter_col) == "Q4", F.lit("October")
    ).otherwise(F.lit(QUARTER_FIRST_MONTH.get(CURRENT_QUARTER, "January")))

    # Same logic as before, but the "first month of quarter" rule uses the above expressions
    # ... (rest of the function identical, just replace hardcoded month number/label)
    # We'll show the relevant changed part:

    # Priority 4 — first month of the record's own quarter
    df = df.withColumn(
        "AA Comment",
        F.when(
            F.col("AA Comment").isNull()
            & no_match_expr
            & (F.month(F.col("eff_dt")) == first_month_expr),
            F.concat(first_month_label_expr, F.lit(" Credit Memo"))
        ).otherwise(F.col("AA Comment"))
    ).withColumn(
        "AA Rule",
        F.when(F.col("AA Rule").isNull() & no_match_expr
               & (F.month(F.col("eff_dt")) == first_month_expr),
               F.concat(F.lit("Rule3P4_FirstMonthOfQtr_"), F.col(source_quarter_col))
        ).otherwise(F.col("AA Rule"))
    )

    # ... (rest unchanged)
    return df

