        chart_title=f"{acct_group_val} — Carrying Value by Period",
    )

    current_row = _s2_table2_materiality(
        ws, current_row, group_totals, cfg, acct_group_val
    )

    print(f"  ✅ Analysis sheet fully written — last row: {current_row}")
    print(f"     Groups in all tables: {list(group_totals.keys())}")


