def ensure_required_columns(df, required_cols: list):
    """Add missing columns as NULL strings; coalesce Company Description; handle Source Quarter."""
    for c in required_cols:
        if c not in df.columns:
            df = df.withColumn(c, F.lit(None).cast("string"))
    df = df.withColumn(
        "Company Description",
        F.coalesce(
            F.col("Company Description").cast("string"),
            F.col("Company").cast("string"),
        )
    )
    # If Source Quarter is required but missing, add as NULL (will be set later)
    if "Source Quarter" in required_cols and "Source Quarter" not in df.columns:
        df = df.withColumn("Source Quarter", F.lit(None).cast("string"))
    return df.select(*required_cols)

def add_source_quarter_col(df, quarter_value: str):
    """Add a literal Source Quarter column to a DataFrame."""
    return df.withColumn("Source Quarter", F.lit(quarter_value))

def ensure_row_id(df):
    """Assign deterministic row_id via row_number over preferred sort key."""
    if "row_id" in df.columns:
        return df.withColumn("row_id", F.col("row_id").cast("string"))
    preferred = [
        "Company Description", "Vendor/Customer Number", "JE Category",
        "Default Effective Date", "Month", "Net Entered",
        "Invoice Reference", "JE Batch Id", "JE Line Number",
    ]
    order_cols = [c for c in preferred if c in df.columns] or sorted(df.columns)
    return df.withColumn(
        "row_id",
        F.row_number()
         .over(Window.orderBy(*[F.col(c).asc_nulls_last() for c in order_cols]))
         .cast("string"),
    )

# ── Type-conversion helpers ───────────────────────────────────────────────────

def to_decimal_clean(col_name: str, precision: int = 38, scale: int = 6):
    """Cast string→decimal handling commas, parenthetical negatives, blanks."""
    cleaned = F.trim(F.col(col_name).cast("string"))
    cleaned = F.regexp_replace(cleaned, ",", "")
    cleaned = F.when(
        cleaned.rlike(r"^\(.*\)$"),
        F.concat(F.lit("-"), F.regexp_replace(cleaned, r"[()]", "")),
    ).otherwise(cleaned)
    cleaned = F.when(cleaned == "", None).otherwise(cleaned)
    return cleaned.cast(T.DecimalType(precision, scale))

def to_date_clean(col_name: str):
    """Parse date column through multiple format patterns."""
    raw = F.trim(F.col(col_name).cast("string"))
    return F.coalesce(
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "M/d/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )

def month_from_business_column(month_col):
    """Parse 'Month' column which may be 'Jan-25', '01-Jan-25', date string, etc."""
    raw = F.trim(month_col.cast("string"))
    return F.coalesce(
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yyyy"),
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )

# ── DataFrame set helpers ─────────────────────────────────────────────────────

def union_non_null(*dfs):
    """Union any number of DataFrames, skipping Nones."""
    valid = [df for df in dfs if df is not None]
    if not valid:
        return None
    out = valid[0]
    for df in valid[1:]:
        out = out.unionByName(df, allowMissingColumns=True)
    return out

# ── Pipeline base transformation ──────────────────────────────────────────────

def base_tag(df, required_cols: list):
    """
    Steps shared by every pipeline:
      1. ensure_required_columns
      2. ensure_row_id
      3. derive cleaned fields, dates, amounts, primary_key, is_valid_row
    Returns tagged DataFrame (all rows, including invalids).
    """
    df = ensure_required_columns(df, required_cols)
    df = ensure_row_id(df)
    df = (
        df
        .withColumn("invoice_ref_clean", F.trim(F.col("Invoice Reference")))
        .withColumn("cat_clean",          F.trim(F.upper(F.col("JE Category"))))
        .withColumn("company_desc_clean", F.trim(F.upper(F.col("Company Description"))))
        .withColumn("vendor_num_clean",   F.trim(F.col("Vendor/Customer Number").cast("string")))
        .withColumn("eff_dt",             to_date_clean("Default Effective Date"))
        .withColumn("Default Effective Date", F.col("eff_dt"))
        .withColumn("month_dt",           month_from_business_column(F.col("Month")))
        .withColumn("entered_net_dec",    to_decimal_clean("Net Entered"))
        .withColumn("abs_entered_dec",    F.abs(F.col("entered_net_dec")))
        .withColumn("abs_entered_key",    F.col("abs_entered_dec").cast("string"))
        .withColumn("valid_company_desc",
            F.col("company_desc_clean").isNotNull() & (F.col("company_desc_clean") != ""))
        .withColumn("valid_vendor_num",
            F.col("vendor_num_clean").isNotNull() & (F.col("vendor_num_clean") != ""))
        .withColumn("primary_key",
            F.when(
                F.col("valid_company_desc")
                & F.col("valid_vendor_num")
                & F.col("abs_entered_dec").isNotNull(),
                F.concat_ws("_",
                    F.col("company_desc_clean"),
                    F.col("vendor_num_clean"),
                    F.col("abs_entered_key"),
                ),
            )
        )
        .withColumn("is_valid_row",
            F.col("row_id").isNotNull()
            & F.col("entered_net_dec").isNotNull()
            & F.col("eff_dt").isNotNull()
            & F.col("month_dt").isNotNull()
            & F.col("primary_key").isNotNull()
        )
    )
    return df

