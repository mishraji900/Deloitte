def _write_row(ws, row: int, label: str, font, border, data):
    sc = _START_COL
    wc(ws, row, sc, label, font=font, align=LEFT)
    for i, col in enumerate(BAL_COLS):
        val = data[col] if isinstance(data, dict) else data.get(col, 0.0)
        wc(ws, row, sc + _BAL_OFF[i], val,
           font=font, border=border, fmt=MILLION_FMT, align=RIGHT)
    for i, col in enumerate(FLUCT_COLS):
        val = data[col] if isinstance(data, dict) else data.get(col, 0.0)
        wc(ws, row, sc + _FLUCT_OFF[i], val,
           font=font, border=border, fmt=MILLION_FMT, align=RIGHT)


