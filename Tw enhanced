def _s2_fluctuation_table(ws, row: int, title: str, group_totals: dict, 
                          col_cur: str, col_pri: str, 
                          lbl_cur: str, lbl_pri: str, 
                          asset_cur: float, asset_pri: float, acct_group: str) -> tuple:
    
    write_cell(ws, row, 2, title, font=BOLD_ITALIC, align=LEFT)
    row += 2
    
    write_cell(ws, row, 2, None, border=MED_BOX)
    write_merged_box(ws, row, 3, row, 4, "Carrying Value", font=BOLD, border=MED_BOX, align=CENTER)
    write_merged_box(ws, row, 5, row, 6, "Fluctuation", font=BOLD, border=MED_BOX, align=CENTER)
    row += 1
    
    for i, lbl in enumerate(["Type of accounts", lbl_cur, lbl_pri, "$", "%"]):
        write_cell(ws, row, 2 + i, lbl, font=HDR_FONT, border=THIN_ALL, align=LEFT if i==0 else CENTER)
    row += 1
    
    g_cur = g_pri = 0.0
    group_row_start = row
    
    for g_name, t_vals in group_totals.items():
        c_val = t_vals.get(col_cur, 0.0) / 1e6
        p_val = t_vals.get(col_pri, 0.0) / 1e6
        fl_abs = c_val - p_val
        fl_pct = (fl_abs / p_val) if p_val else 0.0
        g_cur += c_val; g_pri += p_val
        
        write_cell(ws, row, 2, g_name, font=NORMAL, border=THIN_ALL, align=LEFT)
        write_cell(ws, row, 3, c_val,  font=NORMAL, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
        write_cell(ws, row, 4, p_val,  font=NORMAL, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
        write_cell(ws, row, 5, fl_abs, font=NORMAL, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
        write_cell(ws, row, 6, fl_pct, font=NORMAL, border=THIN_ALL, fmt=PCT_FMT, align=RIGHT)
        row += 1
        
    group_row_end = row - 1
    
    # Totals Row
    fl_abs = g_cur - g_pri
    fl_pct = (fl_abs / g_pri) if g_pri else 0.0
    write_cell(ws, row, 2, f"      Total {acct_group}", font=BOLD, border=THIN_ALL, align=LEFT)
    write_cell(ws, row, 3, g_cur, font=BOLD, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
    write_cell(ws, row, 4, g_pri, font=BOLD, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
    write_cell(ws, row, 5, fl_abs, font=BOLD, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
    write_cell(ws, row, 6, fl_pct, font=BOLD, border=THIN_ALL, fmt=PCT2_FMT, align=RIGHT)
    row += 1
    
    # Total Assets Row
    ta_fl = asset_cur - asset_pri
    ta_pct = (ta_fl / asset_pri) if asset_pri else 0.0
    write_cell(ws, row, 2, "Total Assets", font=BOLD, border=THIN_ALL, align=LEFT)
    write_cell(ws, row, 3, asset_cur, font=BOLD, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
    write_cell(ws, row, 4, asset_pri, font=BOLD, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
    write_cell(ws, row, 5, ta_fl, font=BOLD, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
    write_cell(ws, row, 6, ta_pct, font=BOLD, border=THIN_ALL, fmt=PCT2_FMT, align=RIGHT)
    row += 1
    
    # % Row
    write_cell(ws, row, 2, "%", font=BOLD, border=THIN_ALL, align=LEFT)
    write_cell(ws, row, 3, (g_cur/asset_cur) if asset_cur else 0, font=BOLD, border=THIN_ALL, fmt=PCT2_FMT, align=CENTER)
    write_cell(ws, row, 4, (g_pri/asset_pri) if asset_pri else 0, font=BOLD, border=THIN_ALL, fmt=PCT2_FMT, align=CENTER)
    write_cell(ws, row, 5, None, font=BOLD, border=THIN_ALL, align=CENTER)
    write_cell(ws, row, 6, None, font=BOLD, border=THIN_ALL, align=CENTER)
    
    return row + 2, group_row_start, group_row_end


def _build_pie(ws, title: str, start_r: int, end_r: int, val_col: int) -> PieChart:
    chart = PieChart()
    chart.title = title
    chart.width = 16
    chart.height = 12
    
    dl = DataLabelList()
    dl.showPercent = True
    dl.showLeaderLines = True
    dl.numFmt = NumFmt(formatCode="0%", sourceLinked=False)
    chart.dataLabels = dl
    
    chart.legend = Legend()
    chart.legend.position = "r"
    chart.legend.overlay = False

    data = Reference(ws, min_col=val_col, min_row=start_r, max_row=end_r)
    cats = Reference(ws, min_col=2, min_row=start_r, max_row=end_r)
    chart.add_data(data, titles_from_data=False)
    chart.set_categories(cats)

    if chart.series:
        series = chart.series[0]
        num_slices = end_r - start_r + 1
        for i in range(num_slices):
            pt = DataPoint(idx=i)
            pt.graphicalProperties.solidFill = APPROVED_COLORS[i % len(APPROVED_COLORS)]
            series.dPt.append(pt)
            
    return chart

