# =============================================================================
# CELL — ACCOUNT DESCRIPTION SUMMARY, 4 DATASETS x ALL ACCOUNTS x 4 COMPANIES
# =============================================================================
# 4 input datasets, kept separate (not unioned):
#   P1_ALL_MATCHED
#   P2_ALL_MATCHED
#   P3_ALL_MATCHED_Lag_Greater_than_2
#   P3_ALL_UNMATCHED_COMMENTED  -> filtered to CURRENT_QUARTER/CURRENT_FY only
#                                  (reuses is_current_period from Cell 8)
#
# Per Company Description (Tradeweb Europe Limited, TW SEF, Tradeweb LLC,
# Tradeweb Direct LLC) -> one Excel sheet. Within each sheet:
#   "Total" block (all Account Descriptions combined) first, then one block
#   per distinct Account Description actually present for that company.
# Each block = 4 rows (one per dataset above) x
#   [Count(primary_key), Sum(Entered Dr), Sum(Entered CR), Sum(Net Entered)]
# =============================================================================

COMPANIES = ["Tradeweb Europe Limited", "TW SEF", "Tradeweb LLC", "Tradeweb Direct LLC"]

# is_current_period: same definition already used in Cell 8's row filter —
# reused here rather than redefined, so "current period" means one thing
# everywhere in the notebook.
is_current_period = (
    (F.upper(F.trim(F.col("Source Quarter"))) == F.lit(CURRENT_QUARTER))
    & (F.upper(F.trim(F.col("Year Flag"))) == F.lit(CURRENT_FY))
)

SUMMARY_DATASETS = {
    "P1_ALL_MATCHED":                     P1_ALL_MATCHED,
    "P2_ALL_MATCHED":                     P2_ALL_MATCHED,
    "P3_ALL_MATCHED_Lag_Greater_than_2":  P3_ALL_MATCHED_Lag_Greater_than_2,
    "P3_ALL_UNMATCHED_COMMENTED":         P3_ALL_UNMATCHED_COMMENTED.filter(is_current_period),
}


def _agg_block(df):
    """One row's worth of numbers for a (dataset, account, company) slice."""
    if df is None:
        return (0, 0.0, 0.0, 0.0)
    row = df.agg(
        F.count("primary_key").alias("cnt"),
        F.sum("Entered Dr").alias("dr"),
        F.sum("Entered CR").alias("cr"),
        F.sum("Net Entered").alias("net"),
    ).collect()[0]
    return (
        row["cnt"] or 0,
        float(row["dr"]) if row["dr"] is not None else 0.0,
        float(row["cr"]) if row["cr"] is not None else 0.0,
        float(row["net"]) if row["net"] is not None else 0.0,
    )


def build_company_summary(company_desc: str):
    """Returns a pandas DataFrame for one company: stacked blocks of
    [Account Description, Dataset, Count, Entered Dr, Entered CR, Net Entered],
    "Total" block first, then one block per Account Description present for
    this company across any of the 4 datasets."""
    per_company = {
        name: df.filter(F.trim(F.upper(F.col("Company Description"))) == company_desc.strip().upper())
        for name, df in SUMMARY_DATASETS.items()
    }

    # Account Descriptions actually present for this company, across all 4
    # datasets combined — not a fixed list, so any new account shows up
    # automatically instead of needing to be hardcoded.
    acct_values = (
        union_non_null(*[df.select("Account Description") for df in per_company.values()])
        .filter(F.col("Account Description").isNotNull())
        .distinct()
        .orderBy("Account Description")
        .collect()
    )
    acct_list = ["Total"] + [r["Account Description"] for r in acct_values]

    rows = []
    for acct in acct_list:
        for ds_name, df in per_company.items():
            sub = df if acct == "Total" else df.filter(F.col("Account Description") == acct)
            cnt, dr, cr, net = _agg_block(sub)
            rows.append((acct, ds_name, cnt, dr, cr, net))

    return spark.createDataFrame(
        rows, ["Account Description", "Dataset", "Count", "Entered Dr", "Entered CR", "Net Entered"]
    ).toPandas()


def write_summary_workbook(path: str):
    """One sheet per company, each sheet's rows stacked block-by-block in
    the order Total, then each Account Description — matches the layout of
    the reference workbook (image), just generalized to every Account
    Description instead of two hardcoded fee types."""
    sheets = {}
    for company in COMPANIES:
        pdf = build_company_summary(company)
        # short, sheet-name-safe tab label
        tab = company.replace("Tradeweb ", "TW ").replace(" ", "")[:31]
        sheets[tab] = pdf

    with __import__("pandas").ExcelWriter(path, engine="openpyxl") as writer:
        for tab, pdf in sheets.items():
            start_row = 0
            for acct, block in pdf.groupby("Account Description", sort=False):
                block = block.drop(columns=["Account Description"])
                header_df = __import__("pandas").DataFrame({tab: [acct]})
                header_df.to_excel(writer, sheet_name=tab, startrow=start_row, index=False, header=False)
                block.to_excel(writer, sheet_name=tab, startrow=start_row + 1, index=False)
                start_row += len(block) + 3  # +1 header row, +1 title row, +1 blank spacer

    print(f"  [EXCEL] Written -> {path}")


write_summary_workbook(f"{output_path_et}/Account_Description_Summary - {CURRENT_FY} {CURRENT_QUARTER}.xlsx")
