def write_type_accounts_time_comparison_bar(
        ws, label_col: int,
        t1_first: int, t1_last: int, col_cur: int, col_pri1: int,
        cur_label: str, pri1_label: str,
        t11_first: int, t11_last: int, col_pri2: int, pri2_label: str,
        chart_title: str, anchor: str = None) -> None:
    if anchor is None:
        anchor = f"B{max(t1_last, t11_last) + 2}"

    chart = BarChart()
    chart.type               = "col"
    chart.grouping           = "clustered"
    chart.title               = chart_title
    chart.y_axis.numFmt       = "#,##0.0"
    chart.x_axis.tickLblPos   = "low"
    chart.width, chart.height = 28, 14
    chart.legend               = _legend("b")

    cats = Reference(ws, min_col=label_col, min_row=t1_first, max_row=t1_last)

    specs = [
        (Reference(ws, min_col=col_cur,  min_row=t1_first,  max_row=t1_last),  cur_label,  BAR_COLORS[1]),
        (Reference(ws, min_col=col_pri1, min_row=t1_first,  max_row=t1_last),  pri1_label, BAR_COLORS[2]),
        (Reference(ws, min_col=col_pri2, min_row=t11_first, max_row=t11_last), pri2_label, BAR_COLORS[3]),
    ]
    for idx, (data, label, color) in enumerate(specs):
        chart.add_data(data, titles_from_data=False)
        s = chart.series[idx]
        s.title = SeriesLabel(v=label)
        s.dLbls = _bar_labels()
        _color_bar_series(s, color)
    chart.set_categories(cats)

    ws.add_chart(chart, anchor)
    print(f"  ✅ Bar chart '{chart_title}' → '{anchor}'")


