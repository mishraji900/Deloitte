    g_c2 = sum(t.get("06/30/2025", 0.0) for t in group_totals.values()) / 1e6 / mat
    g_c3 = sum(t.get("09/30/2024", 0.0) for t in group_totals.values()) / 1e6 / mat
    
    for i, (val, fmt) in enumerate([(f"Total {acct_group}", None), (g_c1, MILLION_FMT), (g_c2, MILLION_FMT), (g_c3, MILLION_FMT)]):
        write_cell(ws, row, 2 + i, val, font=BOLD, border=THIN_ALL, fmt=fmt, align=LEFT if i==0 else RIGHT)
    row += 1
    
    for g_name, t_vals in group_totals.items():
        v1 = (t_vals.get("09/30/2025", 0.0) / 1e6) / mat
        v2 = (t_vals.get("06/30/2025", 0.0) / 1e6) / mat
        v3 = (t_vals.get("09/30/2024", 0.0) / 1e6) / mat
        
        for i, (val, fmt) in enumerate([(g_name, None), (v1, MILLION_FMT), (v2, MILLION_FMT), (v3, MILLION_FMT)]):
            write_cell(ws, row, 2 + i, val, font=NORMAL, border=THIN_ALL, fmt=fmt, align=LEFT if i==0 else RIGHT)
        row += 1
        
    write_merged_box(ws, t2_start, 6, row - 1, 6, "", font=NORMAL, border=THIN_ALL, align=LEFT_WRAP)
    row += 2

    # --- Charts Generation ---
    # Render Pies (deduplicated)
    pie_candidates = [
        ("09/30/2025", "Sept 2025", 3, t1_start, t1_end),
        ("06/30/2025", "June 2025", 4, t1_start, t1_end),
        ("09/30/2025", "Sept 2025", 3, t11_start, t11_end),
        ("09/30/2024", "Sept 2024", 4, t11_start, t11_end),
    ]
    
    seen = set()
    unique_pies = []
    for c_key, lbl, val_col, sr, er in pie_candidates:
        if c_key not in seen:
            seen.add(c_key)
            unique_pies.append((lbl, val_col, sr, er))

    pie_grid = [("H", 0), ("S", 0), ("H", 26), ("S", 26)]
    for i, (lbl, val_col, sr, er) in enumerate(unique_pies):
        col_letter, row_offset = pie_grid[i]
        anchor = f"{col_letter}{2 + row_offset}"
        ws.add_chart(_build_pie(ws, f"Figure {i+1}: {lbl} - Composition", sr, er, val_col), anchor)

    # Render Time Comparison Bar Chart (OVERLAP FIX APPLIED)
    bar = BarChart()
    bar.type = "col"
    bar.grouping = "clustered"
    bar.title = f"{acct_group} — Carrying Value by Period"
    bar.width = 32  # Wider to accommodate legend
    bar.height = 20
    bar.gapWidth = 219
    bar.overlap = -100
    
    # 1. Legend moved to right
    bar.legend = Legend()
    bar.legend.position = "r"
    bar.legend.overlay = False

    # 2. Let Excel calculate layout automatically
    bar.plot_area.layout = None 

    # 3. Suppress axis titles that fight for space
    bar.y_axis.title = None 
    bar.y_axis.numFmt = "#,##0.0"
    bar.y_axis.majorGridlines = ChartLines()
    bar.y_axis.scaling.min = 0
    bar.y_axis.scaling.max = 350
    bar.y_axis.majorUnit = 50

    bar.x_axis.title = None
    bar.x_axis.tickLblPos = "low"
    bar.x_axis.noMultiLvlLbl = 0

    cats = Reference(ws, min_col=2, min_row=t1_start, max_row=t1_end)
    specs = [
        (Reference(ws, min_col=3, min_row=t1_start, max_row=t1_end), "Sept 2025", BAR_COLORS[1]),
        (Reference(ws, min_col=4, min_row=t1_start, max_row=t1_end), "June 2025", BAR_COLORS[2]),
        (Reference(ws, min_col=4, min_row=t11_start, max_row=t11_end), "Sept 2024", BAR_COLORS[3]),
    ]

    for idx, (data, lbl, color) in enumerate(specs):
        bar.add_data(data, titles_from_data=False)
        s = bar.series[idx]
        s.title = SeriesLabel(v=lbl)
        
        # Set Data Labels
        dl = DataLabelList()
        dl.showVal = True
        dl.position = "outEnd"
        dl.numFmt = NumFmt(formatCode="#,##0.00", sourceLinked=False)
        s.dLbls = dl
        
        s.graphicalProperties.solidFill = color
        s.graphicalProperties.line.solidFill = color

    bar.set_categories(cats)
    bar_top_row = 2 + (26 if len(unique_pies) >= 3 else 0) + 27
    ws.add_chart(bar, f"H{bar_top_row}")

