def write_table(df, name: str, log: bool = True):
    """Persist DataFrame as parquet to output_path and register as table."""
    if df is None:
        print(f"  [SKIP] {name} — no data")
        return
    path = f"{output_path}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    if log:
        print(f"  [WRITTEN] {path}")

def materialize_df(df, name: str, repartition_key: str = None,
                   stage_path: str = None, num_partitions: int = NUM_PARTITIONS):
    """
    Write df to stage parquet and re-read it.
    Breaks the Spark lineage chain → prevents plan blow-up in iterative loops.
    stage_path defaults to output_path/_stage so each pipeline can use its own.
    """
    print(f"  [MATERIALIZE] {name}")
    base = stage_path or f"{output_path}/_stage"
    if repartition_key and repartition_key in df.columns:
        df = df.repartition(num_partitions, repartition_key)
    path = f"{base}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    return cp.read(path)

