def audit_summary(datasets: dict):
    """
    Print a formatted count table.
    datasets = {"label": df_or_None, ...}
    Returns True if all counts present (no Nones).
    """
    print(f"\n  {'Dataset':<50} {'Count':>10}")
    print(f"  {'-' * 62}")
    total = 0
    ok = True
    for label, df in datasets.items():
        if df is None:
            print(f"  {label:<50} {'None':>10}")
            ok = False
        else:
            n = df.count()
            total += n
            print(f"  {label:<50} {n:>10,}")
    print(f"  {'-' * 62}")
    print(f"  {'TOTAL':<50} {total:>10,}")
    return ok

def export_to_excel(sheets: dict, path: str):
    """
    sheets = OrderedDict/dict of {sheet_name: spark_df}
    Drops internal columns, reorders front columns, exports via cp.pandas.to_excel.
    """
    _front = ["primary_key", "JE Category", "Net Entered", "Default Effective Date", "Source Quarter"]
    _drop  = {
        "pair_id", "pk_row_count", "row_id", "invoice_ref_clean", "cat_clean",
        "company_desc_clean", "vendor_num_clean", "eff_dt", "month_dt",
        "entered_net_dec", "abs_entered_dec", "abs_entered_key",
        "is_valid_row", "valid_company_desc", "valid_vendor_num", "abs_usd_net",
    }

    def _prep(df):
        if df is None:
            return None
        df = df.drop(*[c for c in _drop if c in df.columns])
        present_front = [c for c in _front if c in df.columns]
        rest = [c for c in df.columns if c not in present_front]
        return df.select(*(present_front + rest)).pandas_api()

    cp.pandas.to_excel(
        dataframes=[_prep(df) for df in sheets.values()],
        sheet_names=list(sheets.keys()),
        path=path,
    )
    print(f"  [EXCEL] Written → {path}")

