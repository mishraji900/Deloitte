def _enable_outline(ws):
    ws.sheet_properties.outlinePr = Outline(summaryBelow=True,
                                            summaryRight=False)


def _group_rows(ws, first_detail_row: int, last_detail_row: int):
    for r in range(first_detail_row,
                   min(first_detail_row + VISIBLE_DETAIL_ROWS,
                       last_detail_row + 1)):
        ws.row_dimensions[r].outline_level = 0
        ws.row_dimensions[r].hidden        = False
    for r in range(first_detail_row + VISIBLE_DETAIL_ROWS,
                   last_detail_row + 1):
        ws.row_dimensions[r].outline_level = 1
        ws.row_dimensions[r].hidden        = True


