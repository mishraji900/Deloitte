def _s1_write_group(ws, df_group: pd.DataFrame, row: int,
                    group_name: str) -> tuple:
    wc(ws, row, _START_COL, group_name, font=BOLD, align=LEFT)
    row += 1

    first_detail = row
    for _, r in df_group.iterrows():
        _write_row(ws, row, r[ACCOUNT_COL], NORMAL, None, r)
        row += 1
    last_detail = row - 1
    n_detail    = last_detail - first_detail + 1

    subtotals = {c: df_group[c].sum() for c in BAL_COLS + FLUCT_COLS}
    _write_row(ws, row, f"Total {group_name}", BOLD, THIN_TB, subtotals)
    row += 1

    if n_detail > GROUP_COLLAPSE_THRESHOLD:
        _group_rows(ws, first_detail, last_detail)
        hidden = n_detail - VISIBLE_DETAIL_ROWS
        print(f"     📂 '{group_name}': {VISIBLE_DETAIL_ROWS} visible, "
              f"{hidden} collapsed (rows "
              f"{first_detail + VISIBLE_DETAIL_ROWS}–{last_detail})")

    return row + 1, subtotals


def _s1_write_grand_total(ws, df: pd.DataFrame, row: int,
                          acct_group_val: str) -> int:
    grand = {c: df[c].sum() for c in BAL_COLS + FLUCT_COLS}
    _write_row(ws, row, f"Total {acct_group_val}", BOLD, MED_TB, grand)
    return row + 2


