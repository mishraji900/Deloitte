def write_cell(
    cell,
    value: Any = None,
    font=None,
    fill=None,
    border=None,
    alignment=None,
    number_format: str | None = None,
) -> None:
    cell.value = value
    if font is not None:
        cell.font = font
    if fill is not None:
        cell.fill = fill
    if border is not None:
        cell.border = border
    if alignment is not None:
        cell.alignment = alignment
    if number_format is not None:
        cell.number_format = number_format


def put(
    worksheet,
    reference: str,
    value: Any = None,
    **style,
) -> None:
    write_cell(worksheet[reference], value, **style)


def put_rc(
    worksheet,
    row: int,
    column: int,
    value: Any = None,
    **style,
) -> None:
    write_cell(worksheet.cell(row=row, column=column), value, **style)


def variance_formulas(
    row: int,
    config: SheetConfig,
    comparisons: list[ComparisonBlock],
) -> dict[str, str]:
    current_column = config.role_to_excel_column["current"]
    formulas = {}

    for comparison in comparisons:
        comparison_column = config.role_to_excel_column[
            comparison.comparison_role
        ]
        dollar = comparison.dollar_column
        percent = comparison.percent_column
        flag = comparison.flag_column

        formulas[f"{dollar}{row}"] = (
            f"={current_column}{row}-{comparison_column}{row}"
        )
        formulas[f"{percent}{row}"] = (
            f"=IFERROR({dollar}{row}/{comparison_column}{row},0)"
        )
        formulas[f"{flag}{row}"] = (
            f'=IF(AND(ABS({dollar}{row})>{config.materiality_dollar_anchor},'
            f'ABS({percent}{row})>{config.materiality_percent_anchor}),'
            f'"{YES_VALUE}","{NO_VALUE}")'
        )

    return formulas


def write_variance_cells(
    worksheet,
    formulas: dict[str, str],
    comparisons: list[ComparisonBlock],
    font,
    border=None,
) -> None:
    percent_columns = {item.percent_column for item in comparisons}
    flag_columns = {item.flag_column for item in comparisons}

    for reference, formula in formulas.items():
        column = re.sub(r"\d", "", reference)
        put(
            worksheet,
            reference,
            formula,
            font=font,
            border=border,
            alignment=CENTER_ALIGN if column in flag_columns else RIGHT_ALIGN,
            number_format=(
                PERCENT_FORMAT if column in percent_columns else NUMBER_FORMAT
            ),
        )


def apply_conditional_formatting(
    worksheet,
    comparisons: list[ComparisonBlock],
    first_row: int,
    last_row: int,
) -> None:
    worksheet.conditional_formatting._cf_rules = {}

    for comparison in comparisons:
        for row in range(first_row, last_row + 1):
            reference = f"{comparison.flag_column}{row}"
            formula = f'{absolute_coordinate(reference)}="{YES_VALUE}"'
            rule = FormulaRule(formula=[formula], stopIfTrue=True)
            rule.dxf = YES_FILL
            rule.priority = 1
            worksheet.conditional_formatting.add(reference, rule)


def write_summary_sheet(
    worksheet,
    config: SheetConfig,
    dataframe: pd.DataFrame,
    display_roles: dict[str, str],
    comparisons: list[ComparisonBlock],
) -> None:
    # ── Remove old comparison merges and clear old values ──────────────────
    for merged_range in list(worksheet.merged_cells.ranges):
        if str(merged_range) in {
            item.merge_range for item in config.all_comparison_blocks
        }:
            worksheet.unmerge_cells(str(merged_range))

    for row in worksheet.iter_rows(
        min_row=config.first_data_row,
        max_row=max(worksheet.max_row, config.first_data_row),
        min_col=2,
        max_col=config.max_data_column,
    ):
        for cell in row:
            cell.value = None

    for row in (SUMMARY_BLOCK_ROW, SUMMARY_HEADER_ROW):
        for column in range(2, config.max_data_column + 1):
            worksheet.cell(row=row, column=column).value = None

    worksheet.sheet_view.showGridLines = False
    # worksheet.freeze_panes = SUMMARY_FREEZE_CELL

    # ── Title and materiality section ──────────────────────────────────────
    put(worksheet, "B1", CLIENT_NAME, font=BOLD_FONT)
    put(worksheet, "B2", config.subtitle, font=BOLD_FONT)
    put(worksheet, "B3", PERIOD_LABEL, font=BOLD_FONT)

    put(worksheet, f"{config.materiality_label_column}2",
        "Materiality", font=BOLD_FONT)
    put(worksheet, f"{config.materiality_label_column}3",
        "Threshold (in $)", font=BOLD_FONT)
    put(worksheet, f"{config.materiality_label_column}4",
        "Threshold (in %)", font=BOLD_FONT)
    put(worksheet, f"{config.materiality_value_column}2",
        MATERIALITY, font=BOLD_FONT,fill=RED_HIGHLIGHT_FILL,number_format=NUMBER_FORMAT)
    put(worksheet, f"{config.materiality_value_column}3",
        THRESHOLD_DOLLARS, font=BOLD_FONT, fill=RED_HIGHLIGHT_FILL,number_format=NUMBER_FORMAT)
    put(worksheet, f"{config.materiality_value_column}4",
        THRESHOLD_PERCENT, font=BOLD_FONT, fill=RED_HIGHLIGHT_FILL,number_format=PERCENT_FORMAT)

    # ── Procedure box ──────────────────────────────────────────────────────
    put(
        worksheet, f"B6", PROCEDURE_TEXT,
        font=NORMAL_FONT, fill=PROCEDURE_FILL, alignment=LEFT_WRAP,
    )
    worksheet.merge_cells(config.procedure_merge_range)

    # ── Column-header rows (row 10 = block label, row 11 = sub-headers) ───
    # Fixed columns B and C–F (amount columns)
    put(
        worksheet, f"B{SUMMARY_HEADER_ROW}",
        "Account Description",
        font=HEADER_FONT, fill=HEADER_FILL,
        border=THIN_BORDER, alignment=CENTER_WRAP,
    )
    for role, col in config.role_to_excel_column.items():
        put(
            worksheet, f"{col}{SUMMARY_HEADER_ROW}",
            display_roles[role],
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )

    # Comparison blocks: each block writes its block-label merge (row 10),
    # three sub-headers ($ Var, % Var, flag) in row 11, then the NEW
    # "Accounts Flagged (Yes)" header in the column immediately after the
    # flag column.
    for item in comparisons:
        # Row 10 — merged period-pair label
        put(
            worksheet, f"{item.dollar_column}{SUMMARY_BLOCK_ROW}",
            f"{display_roles[item.current_role]} vs "
            f"{display_roles[item.comparison_role]}",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        worksheet.merge_cells(item.merge_range)

        # Row 11 — $ Variance
        put(
            worksheet, f"{item.dollar_column}{SUMMARY_HEADER_ROW}",
            "$ Variance",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        # Row 11 — % Variance
        put(
            worksheet, f"{item.percent_column}{SUMMARY_HEADER_ROW}",
            "% Variance",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        # Row 11 — Further explain at LE level?
        put(
            worksheet, f"{item.flag_column}{SUMMARY_HEADER_ROW}",
            "Further explain at\nLE level?",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        # Row 11 — NEW: Accounts Flagged (Yes)
        if item.yes_list_column:
            put(
                worksheet, f"{item.yes_list_column}{SUMMARY_HEADER_ROW}",
                "Accounts Flagged\n(Yes)",
                font=HEADER_FONT, fill=HEADER_FILL,
                border=THIN_BORDER, alignment=CENTER_WRAP,
            )

    # Tickmark header
    put(
        worksheet, f"{config.tickmark_column}{SUMMARY_HEADER_ROW}",
        "Tickmark",
        font=HEADER_FONT, fill=HEADER_FILL,
        border=THIN_BORDER, alignment=CENTER_WRAP,
    )

    worksheet.row_dimensions[SUMMARY_BLOCK_ROW].height = 30
    worksheet.row_dimensions[SUMMARY_HEADER_ROW].height = 42

    # ── Detail rows ────────────────────────────────────────────────────────
    # Pre-compute the full list of Account Descriptions for each comparison
    # block so the TEXTJOIN-style "Yes" list can be resolved in Python
    # (avoiding the need for an Excel array formula that requires Ctrl+Shift+Enter).
    first_row = config.first_data_row
    last_data_row = config.first_data_row + len(dataframe) - 1

    for row_number, (_, source_row) in enumerate(
        dataframe.iterrows(), config.first_data_row
    ):
        # Column B — account description
        put(
            worksheet, f"B{row_number}",
            source_row[ACCOUNT_GROUP_COLUMN],
            font=NORMAL_FONT, alignment=LEFT_ALIGN,
        )

        # Amount columns
        for role, column in config.role_to_excel_column.items():
            put(
                worksheet,
                f"{column}{row_number}",
                float(source_row[display_roles[role]]),
                font=NORMAL_FONT,
                alignment=RIGHT_ALIGN,
                number_format=NUMBER_FORMAT,
            )

        # Variance + flag cells ($ var, % var, flag)
        write_variance_cells(
            worksheet,
            variance_formulas(row_number, config, comparisons),
            comparisons,
            NORMAL_FONT,
        )

        # NEW: Accounts Flagged (Yes) — one column per comparison block.
        # Each cell in this column holds a TEXTJOIN array formula that
        # collects every Account Description in column B whose flag cell
        # (same row, flag_column) equals "Yes" across the whole data range.
        # Because the list is the same for every data row within a block,
        # we write the same array formula in every data cell; analysts can
        # simply look at any row. If you prefer the list only in the first
        # data row, wrap the put() call in `if row_number == first_row:`.
        for item in comparisons:
            if not item.yes_list_column:
                continue
            cell_ref = f"{item.yes_list_column}{row_number}"
            yes_list_formula = (
                f'=IFERROR(TEXTJOIN(", ", TRUE, '
                f'IF({item.flag_column}{first_row}:'
                f'{item.flag_column}{last_data_row}="{YES_VALUE}", '
                f'B{first_row}:B{last_data_row}, "")), "—")'
            )
            cell = worksheet[cell_ref]
            cell.value = ArrayFormula(cell_ref, yes_list_formula)  # ← key fix
            cell.font = NORMAL_FONT
            cell.border = THIN_BORDER
            cell.alignment = LEFT_WRAP

        # Tickmark column (blank, formatted only)
        put(
            worksheet, f"{config.tickmark_column}{row_number}",
            None, font=RED_BOLD_FONT, alignment=CENTER_ALIGN,
        )
        worksheet.row_dimensions[row_number].height = 18

    # ── Total row ──────────────────────────────────────────────────────────
    total_row = config.first_data_row + len(dataframe)
    put(
        worksheet, f"B{total_row}", config.total_label,
        font=BOLD_FONT, border=TOTAL_BORDER, alignment=LEFT_ALIGN,
    )

    for column in config.role_to_excel_column.values():
        value = (
            f"=SUM({column}{config.first_data_row}:{column}{total_row - 1})"
            if len(dataframe) else 0
        )
        put(
            worksheet, f"{column}{total_row}", value,
            font=BOLD_FONT, border=TOTAL_BORDER,
            alignment=RIGHT_ALIGN, number_format=NUMBER_FORMAT,
        )

    write_variance_cells(
        worksheet,
        variance_formulas(total_row, config, comparisons),
        comparisons,
        BOLD_FONT,
        TOTAL_BORDER,
    )

    # NEW: Yes-list total cell — blank with border (no sum makes sense here)
    for item in comparisons:
        if item.yes_list_column:
            put(
                worksheet, f"{item.yes_list_column}{total_row}",
                None, font=BOLD_FONT, border=TOTAL_BORDER,
                alignment=CENTER_ALIGN,
            )

    put(
        worksheet, f"{config.tickmark_column}{total_row}",
        None, font=BOLD_FONT, border=TOTAL_BORDER,
        alignment=CENTER_ALIGN,
    )

    # ── Borders, auto-filter, conditional formatting ───────────────────────
    for row in worksheet.iter_rows(
        min_row=config.first_data_row,
        max_row=total_row,
        min_col=2,
        max_col=config.max_data_column,
    ):
        for cell in row:
            if cell.column not in config.spacer_columns and cell.border == Border():
                cell.border = THIN_BORDER

    worksheet.auto_filter.ref = f"B11:{config.tickmark_column}{total_row}"
    apply_conditional_formatting(
        worksheet, comparisons, config.first_data_row, total_row
    )


