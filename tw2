# _path_exists(): existence check used by exhaustive_match()'s checkpoint
# logic (both for the meta file and for each per-iteration pairs_*.parquet
# it references). Returns False on ANY failure (not found, permission,
# transient), which is the conservative choice for a checkpoint check —
# "can't confirm it's there" and "not there" both mean "start fresh".
def _path_exists(path: str) -> bool:
    try:
        dbutils.fs.ls(path)
        return True
    except Exception:
        return False


# write_table(): the terminal write for anything meant to be a FINAL,
# user-facing output table — always writes to output_path_et (or an
# explicit base_path override) rather than a pipeline's scratch
# STAGE_PATH. Returns the path it wrote to, so materialize_df() (below)
# can read straight back off it without duplicating the cp.write() call.
def write_table(df, name: str, log: bool = True, base_path: str = None):
    if df is None:
        print(f"  [SKIP] {name} – no data")
        return
    path = f"{base_path or output_path}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    if log:
        print(f"  [WRITTEN] {path}")
    return path


# materialize_df(): the workhorse used everywhere a lazy Spark transform
# chain needs to be forced to disk and re-read as a fresh DataFrame — this
# breaks lineage so later stages don't re-evaluate an ever-growing chain of
# joins/filters, and (via repartition_key) lets a call site pre-shuffle on
# the column that the next join/groupBy will use. Delegates the actual
# write to write_table() so there's exactly one place that calls
# cp.write(..., "overwrite", register=True).
def materialize_df(df, name: str, repartition_key: str = None,
                   stage_path: str = None, num_partitions: int = NUM_PARTITIONS):
    print(f"  [MATERIALIZE] {name}")
    if repartition_key and repartition_key in df.columns:
        df = df.repartition(num_partitions, repartition_key)
    path = write_table(df, name, log=False, base_path=stage_path)
    return cp.read(path)


# debug_count / display_metric / debug_group_count / audit_summary all
# render through Databricks display() rather than print(), so every count,
# profile, and audit shows as a proper notebook table instead of console
# text. The one deliberate exception is exhaustive_match()'s own
# per-iteration progress logging ("Iter N: ...", "[CKPT] ..."), which stays
# on plain print() — that's live status output about a loop still running,
# not a finished result worth a table.

def debug_count(label: str, df):
    """One-row [Metric, Count] table for a DataFrame's row count."""
    n = df.count() if df is not None else None
    row_df = spark.createDataFrame([(label, n)], ["Metric", "Count"])
    display(row_df)


def display_metric(label: str, value):
    """Same one-row [Metric, Count] shape as debug_count, but for a value
    that's already a plain Python scalar (e.g. an accumulated total pairs
    count) rather than something with a live .count() to call."""
    display(spark.createDataFrame([(label, value)], ["Metric", "Count"]))


def debug_group_count(df, col_name: str, label: str, limit: int = 20):
    """groupBy(col_name).count() breakdown, top `limit` rows by count desc,
    rendered as a table — the standard "distribution of X" profile call
    used throughout every pipeline stage."""
    print(f"\n  [PROFILE] {label}")
    profiled = (
        df.groupBy(col_name)
          .count()
          .orderBy(F.desc("count"), F.asc(col_name))
          .limit(limit)
    )
    display(profiled)


def audit_summary(datasets: dict):
    """Row-count table across every named dataset in a pipeline stage, plus
    a TOTAL row — the per-pipeline reconciliation check (e.g. does
    INVALID + EXC_1 + UNIQUE_* + DUP_* + MATCHED_* + UNMATCHED add up to
    the pipeline's input row count?). Returns False if any dataset was
    None, so a caller can assert on it if desired."""
    rows  = []
    total = 0
    ok    = True
    for label, df in datasets.items():
        if df is None:
            rows.append((label, None))
            ok = False
        else:
            n      = df.count()
            total += n
            rows.append((label, n))
    rows.append(("TOTAL", total))
    summary_df = spark.createDataFrame(rows, ["Dataset", "Count"])
    display(summary_df)
    return ok


# export_to_excel(): the Cell 9 terminal step. Takes {sheet_name: df},
# strips every internal/derived working column (primary keys, cleaned
# helper columns, validity flags — none of which are meant for a client-
# facing workbook) via _drop, pins a handful of the most load-bearing
# business columns to the front of each sheet via _front, and writes one
# multi-sheet .xlsx.
def export_to_excel(sheets: dict, path: str):
    _front = ["primary_key", "JE Category", "Net Entered",
              "Default Effective Date", "Source Quarter"]
    _drop  = {
        "pair_id", "pk_row_count", "row_id", "invoice_ref_clean", "cat_clean",
        "company_desc_clean", "vendor_num_clean", "eff_dt", "month_dt",
        "entered_net_dec", "abs_entered_dec", "abs_entered_key",
        "is_valid_row", "valid_company_desc", "valid_vendor_num", "abs_usd_net",
        "p4_primary_key", "pk_sales_count", "pk_credit_count",
    }

    def _prep(df):
        if df is None:
            return None
        df            = df.drop(*[c for c in _drop if c in df.columns])
        present_front = [c for c in _front if c in df.columns]
        rest          = [c for c in df.columns if c not in present_front]
        return df.select(*(present_front + rest)).pandas_api()

    cp.pandas.to_excel(
        dataframes  =[_prep(df) for df in sheets.values()],
        sheet_names =list(sheets.keys()),
        path        =path,
    )
    print(f"  [EXCEL] Written → {path}")


# ── Schema helpers ───────────────────────────────────────────────────────────

# ensure_required_columns(): forces any input frame onto the exact column
# list a pipeline expects (BASE_RAW_COLUMNS or PIPE2_RAW_COLUMNS) — missing
# columns are null-padded in, anything not in the list is dropped by the
# final select(). Also backfills "Company Description" from "Company" when
# the former is null, since some source extracts only populate one or the
# other. This is what lets P1's ragged output be fed straight into P2's
# base_tag() (and P2's into P3's, and P3's into P4's) without a manual
# reconciliation step.
def ensure_required_columns(df, required_cols: list):
    for c in required_cols:
        if c not in df.columns:
            df = df.withColumn(c, F.lit(None).cast("string"))
    df = df.withColumn(
        "Company Description",
        F.coalesce(
            F.col("Company Description").cast("string"),
            F.col("Company").cast("string"),
        )
    )
    return df.select(*required_cols)


# ensure_row_id(): every row needs a stable, unique row_id so it can be
# tracked through the join/anti-join dance in rank_based_match() and
# rejoined to its original values in resolve_to_original(). If the frame
# already carries a row_id (e.g. a re-tagged P1/P2/P3 leftover frame) it's
# just re-cast to string and left alone. Otherwise a fresh row_number() is
# assigned over a deterministic natural sort — deterministic so the same
# input always produces the same row_id, which matters for checkpoint
# resume (a checkpointed sales/credit frame has to line up with a fresh
# re-run of base_tag() on the same input).
def ensure_row_id(df):
    if "row_id" in df.columns:
        return df.withColumn("row_id", F.col("row_id").cast("string"))
    preferred = [
        "Company Description", "Vendor/Customer Number", "JE Category",
        "Default Effective Date", "Month", "Net Entered",
        "Invoice Reference", "JE Batch Id", "JE Line Number",
    ]
    order_cols = [c for c in preferred if c in df.columns] or sorted(df.columns)
    return df.withColumn(
        "row_id",
        F.row_number()
         .over(Window.orderBy(*[F.col(c).asc_nulls_last() for c in order_cols]))
         .cast("string"),
    )


# ── Type-conversion helpers ──────────────────────────────────────────────────

# to_decimal_clean(): normalizes a raw amount string into DECIMAL_TYPE —
# strips thousands separators, converts accounting-style "(123.45)"
# negatives into "-123.45", and turns "" into NULL rather than 0 (an empty
# amount is missing data, not a zero dollar amount — is_valid_row in
# base_tag() depends on this distinction).
def to_decimal_clean(col_name: str, precision: int = 38, scale: int = 6):
    cleaned = F.trim(F.col(col_name).cast("string"))
    cleaned = F.regexp_replace(cleaned, ",", "")
    cleaned = F.when(
        cleaned.rlike(r"^\(.*\)$"),
        F.concat(F.lit("-"), F.regexp_replace(cleaned, r"[()]", "")),
    ).otherwise(cleaned)
    cleaned = F.when(cleaned == "", None).otherwise(cleaned)
    return cleaned.cast(T.DecimalType(precision, scale))


# (to_date_clean lives in Cell 1 — Cell 2's year/quarter derivation runs
# before this cell and needs it too, so there is exactly one copy of the
# date-format coalesce list for the whole notebook.)


# month_from_business_column(): parses the raw "Month" business column
# (typically "MMM-yy" style, e.g. "Mar-26") into a real date, with two
# extra fallbacks that prepend "01-" so a bare "Mar-26"/"March-2026" string
# still resolves to the 1st of that month, plus the same numeric/ISO
# fallbacks to_date_clean uses in case "Month" was populated with a full
# date instead of a month label. month_dt (not eff_dt) is what
# rank_based_match() uses for month_lag, since "Month" is the business
# period a JE was booked to, which can differ from its effective date.
def month_from_business_column(month_col):
    raw = F.trim(month_col.cast("string"))
    return F.coalesce(
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yyyy"),
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )


# ── DataFrame set helpers ────────────────────────────────────────────────────

# union_non_null(): unionByName across any number of DataFrames, silently
# skipping any that are None (e.g. a pipeline stage that found zero rows
# for a given match_type and returned None instead of an empty frame).
# allowMissingColumns=True so frames with slightly different derived-column
# sets (e.g. a P1 frame without Year Flag vs a P2 frame with it) can still
# be unioned — missing columns are null-filled on the narrower side.
def union_non_null(*dfs):
    valid = [df for df in dfs if df is not None]
    if not valid:
        return None
    out = valid[0]
    for df in valid[1:]:
        out = out.unionByName(df, allowMissingColumns=True)
    return out


# ── Pipeline base transformation ─────────────────────────────────────────────

# base_tag(): the single entry point every pipeline (P1/P2/P3/P4) runs its
# raw input through before any matching happens. Given a raw frame and the
# column list it should conform to, this:
#   1. Pads/selects onto required_cols (ensure_required_columns)
#   2. Assigns a stable row_id (ensure_row_id)
#   3. Derives every "clean" helper column matching logic depends on:
#        invoice_ref_clean / cat_clean / company_desc_clean / vendor_num_clean
#          — trimmed/uppercased raw text, used for equality comparisons
#            that need to ignore casing/whitespace noise from source data.
#        eff_dt   — Default Effective Date, parsed to a real date (also
#                    overwrites the original string column with the parsed
#                    date, so every downstream reference to "Default
#                    Effective Date" is already a proper date).
#        Source Quarter / Year Flag — recomputed HERE, per row, straight
#          from this row's own eff_dt, every single time base_tag() runs
#          (P1, P2, P3, and P4 all call it fresh) — Q1=Jan-Mar...Q4=Oct-Dec,
#          Year Flag="FY"+last 2 digits of the calendar year. This is what
#          makes carry-forward rows correctly self-tag as whatever prior
#          FY/quarter they actually belong to, rather than being stamped
#          with a single global PRIOR_FY constant.
#        month_dt        — parsed "Month" business column (see above)
#        entered_net_dec / abs_entered_dec / abs_entered_key
#          — the cleaned amount, its absolute value, and that absolute
#            value as a string (used as one leg of primary_key, below).
#        valid_company_desc / valid_vendor_num
#          — booleans gating whether this row has enough identifying info
#            to form a primary_key at all.
#        primary_key = "{company}_{vendor}_{|amount|}" — the join key every
#          matching pass groups Sales Invoices against Credit Memos on.
#          NULL if company/vendor/amount is missing (see valid_* above).
#        is_valid_row — the row-id/amount/date/primary_key completeness
#          gate that Cell 4/5/6 split INVALID vs prep rows on.
def base_tag(df, required_cols: list):
    df = ensure_required_columns(df, required_cols)
    df = ensure_row_id(df)
    df = (
        df
        .withColumn("invoice_ref_clean", F.trim(F.col("Invoice Reference")))
        .withColumn("cat_clean",          F.trim(F.upper(F.col("JE Category"))))
        .withColumn("company_desc_clean", F.trim(F.upper(F.col("Company Description"))))
        .withColumn("vendor_num_clean",   F.trim(F.col("Vendor/Customer Number").cast("string")))
        .withColumn("eff_dt",             to_date_clean("Default Effective Date"))
        .withColumn("Default Effective Date", F.col("eff_dt"))
        .withColumn("Source Quarter",     F.concat(F.lit("Q"), F.quarter(F.col("eff_dt")).cast("string")))
        .withColumn("Year Flag",          F.concat(F.lit("FY"), F.date_format(F.col("eff_dt"), "yy")))
        .withColumn("month_dt",           month_from_business_column(F.col("Month")))
        .withColumn("entered_net_dec",    to_decimal_clean("Net Entered"))
        .withColumn("abs_entered_dec",    F.abs(F.col("entered_net_dec")))
        .withColumn("abs_entered_key",    F.col("abs_entered_dec").cast("string"))
        .withColumn("valid_company_desc",
            F.col("company_desc_clean").isNotNull() & (F.col("company_desc_clean") != ""))
        .withColumn("valid_vendor_num",
            F.col("vendor_num_clean").isNotNull() & (F.col("vendor_num_clean") != ""))
        .withColumn("primary_key",
            F.when(
                F.col("valid_company_desc")
                & F.col("valid_vendor_num")
                & F.col("abs_entered_dec").isNotNull(),
                F.concat_ws("_",
                    F.col("company_desc_clean"),
                    F.col("vendor_num_clean"),
                    F.col("abs_entered_key"),
                ),
            )
        )
        .withColumn("is_valid_row",
            F.col("row_id").isNotNull()
            & F.col("entered_net_dec").isNotNull()
            & F.col("eff_dt").isNotNull()
            & F.col("month_dt").isNotNull()
            & F.col("primary_key").isNotNull()
        )
    )
    return df


# ── Matching helpers ──────────────────────────────────────────────────────────

# make_sales() / make_credit(): project a base_tag()'d frame down to just
# the "Sales Invoices" (resp. "Credit Memos") rows, keep only the columns
# rank_based_match() actually needs, alias every column with a sales_/
# credit_ prefix so a self-join on primary_key doesn't collide column
# names, and repartition on the join key up front so the join in
# rank_based_match() doesn't have to re-shuffle every iteration.
def make_sales(src_df, pk_col: str = "primary_key"):
    return (
        src_df.filter(F.col("cat_clean") == "SALES INVOICES")
        .select(
            F.col(pk_col).alias("primary_key"),
            F.col("row_id").alias("sales_row_id"),
            F.col("entered_net_dec").alias("sales_amt"),
            F.col("eff_dt").alias("sales_eff_dt"),
            F.col("month_dt").alias("sales_month"),
            F.col("invoice_ref_clean").alias("sales_ref"),
        )
        .repartition(NUM_PARTITIONS, "primary_key")
    )


def make_credit(src_df, pk_col: str = "primary_key"):
    return (
        src_df.filter(F.col("cat_clean") == "CREDIT MEMOS")
        .select(
            F.col(pk_col).alias("primary_key"),
            F.col("row_id").alias("credit_row_id"),
            F.col("entered_net_dec").alias("credit_amt"),
            F.col("eff_dt").alias("credit_eff_dt"),
            F.col("month_dt").alias("credit_month"),
            F.col("invoice_ref_clean").alias("credit_ref"),
        )
        .repartition(NUM_PARTITIONS, "primary_key")
    )


# build_unmatched_rows(): given whatever's left in the sales/credit sides
# after all match steps for a pipeline have run, pulls the row_ids that
# never got consumed, and joins back to the pipeline's base_df (the
# DUP_SI_CM frame — see Cell 4/5/6) to recover their full original rows.
# This is how "P1_REMAIN_UNMATCHED" / "P2_REMAIN_UNMATCHED" /
# "P3_REMAIN_UNMATCHED" get built.
def build_unmatched_rows(base_df, rem_sales_df, rem_credit_df,
                         name: str, stage_path: str = None):
    remaining_ids = (
        rem_sales_df.select(F.col("sales_row_id").alias("row_id"))
        .unionByName(rem_credit_df.select(F.col("credit_row_id").alias("row_id")))
        .distinct()
    )
    unmatched = base_df.join(remaining_ids, on="row_id", how="inner")
    return materialize_df(unmatched, name, "primary_key", stage_path=stage_path)


# resolve_to_original(): takes the SLIM pairs table (just sales_row_id /
# credit_row_id / match_type) that a completed exhaustive_match() run
# produced, and expands it back out to full original rows for both legs of
# every pair. Also:
#   1. Assigns a pair_id ("{match_label}_{n}") — a stable identifier per
#      confirmed pair, deterministic via row_number() over a fixed sort so
#      the same pairing always gets the same pair_id.
#   2. (has_year_flag=True, Pipelines 2 & 3) Computes "Year Pair Flag" —
#      e.g. "CY Sales Inv with PY Credit Memo". CY means this leg's own
#      Year Flag equals CURRENT_FY; PY means anything else (any number of
#      years back — carry-forward isn't assumed to be exactly one year
#      old). This is a quick-glance label only; the row's real Year
#      Flag/Source Quarter (carried all the way to the final export) is
#      what you'd filter on to know exactly which prior period a row is
#      actually from.
# Both legs of every pair (the sales row AND the credit row) are unioned
# together into one output frame — every resolved dataset has exactly 2
# rows per confirmed pair.
def resolve_to_original(pairs_df, base_df, match_label: str,
                        stage_name: str, stage_path: str = None,
                        has_year_flag: bool = False):
    if pairs_df is None:
        return None

    w_pair = Window.orderBy(
        F.col("primary_key").asc(),
        F.col("sales_row_id").asc(),
        F.col("credit_row_id").asc(),
    )

    pairs_with_id = (
        pairs_df
        .withColumn(
            "pair_id",
            F.concat(
                F.lit(f"{match_label}_"),
                F.row_number().over(w_pair).cast("string"),
            ),
        )
        .select("pair_id", "sales_row_id", "credit_row_id", "match_type")
    )

    if has_year_flag:
        yf_sales  = base_df.select(
            F.col("row_id").alias("sales_row_id"),
            F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("sales_year_flag"),
            F.upper(F.trim(F.col("Source Quarter").cast("string"))).alias("sales_quarter_flag"),
        )
        yf_credit = base_df.select(
            F.col("row_id").alias("credit_row_id"),
            F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("credit_year_flag"),
            F.upper(F.trim(F.col("Source Quarter").cast("string"))).alias("credit_quarter_flag"),
        )
        _sales_cy_py  = F.when(F.col("sales_year_flag")  == CURRENT_FY, F.lit("CY")).otherwise(F.lit("PY"))
        _credit_cy_py = F.when(F.col("credit_year_flag") == CURRENT_FY, F.lit("CY")).otherwise(F.lit("PY"))

        pairs_with_id = (
            pairs_with_id
            .join(yf_sales,  on="sales_row_id",  how="left")
            .join(yf_credit, on="credit_row_id", how="left")
            .withColumn(
                "Year Pair Flag",
                F.when(
                    F.col("sales_year_flag").isNull() | F.col("credit_year_flag").isNull(),
                    F.lit("Unknown"),
                ).otherwise(
                    F.concat(_sales_cy_py, F.lit(" Sales Inv with "), _credit_cy_py, F.lit(" Credit Memo"))
                )
            )
            .select("pair_id", "sales_row_id", "credit_row_id", "match_type", "Year Pair Flag")
        )

    orig_cols = [F.col(f"orig.`{c}`") for c in base_df.columns]
    extra_meta = ["pair_id", "match_type"] + (["Year Pair Flag"] if has_year_flag else [])
    meta_cols  = [F.col(c) for c in extra_meta if c not in base_df.columns]

    sales_side = (
        pairs_with_id
        .join(base_df.alias("orig"),
              pairs_with_id["sales_row_id"] == F.col("orig.row_id"), "inner")
        .select(*meta_cols, *orig_cols)
    )
    credit_side = (
        pairs_with_id
        .join(base_df.alias("orig"),
              pairs_with_id["credit_row_id"] == F.col("orig.row_id"), "inner")
        .select(*meta_cols, *orig_cols)
    )

    resolved = sales_side.unionByName(credit_side)
    return materialize_df(resolved, stage_name, "primary_key", stage_path=stage_path)


# rank_based_match(): ONE greedy matching pass. Cross-joins sales/credit
# candidates that share a primary_key, computes amount_diff
# (|sales_amt + credit_amt| — zero means they exactly cancel) and month_lag
# (how many calendar months apart their "Month" business periods are), then
# hands the joined candidates to condition_fn (one of MATCH_STEPS' or
# LAG_GT_2_STEPS' lambdas) to filter down to whichever specific rule this
# pass is enforcing.
#
# Among the surviving candidates, this does a MUTUAL best-match pick, not a
# first-match pick: for every sales row, rank its candidate credits by
# (amount_diff, month_lag, credit_eff_dt, credit_row_id) and take rank 1;
# separately, for every credit row, rank its candidate sales the mirrored
# way and take rank 1. A candidate pair only survives BOTH rankings
# (rn_sales==1 AND rn_credit==1) — i.e. it has to be each other's best
# option, not just one side's. This is what prevents a popular sales row
# from being greedily claimed by the first credit row it's checked against
# when a better mutual pairing exists elsewhere in the same primary_key
# group.
# Returns (confirmed_pairs, remaining_sales, remaining_credit) — confirmed
# rows are removed from both sides via left_anti join before returning the
# remainders, so a caller can feed those remainders into the next
# iteration/step without re-matching what's already settled.
def rank_based_match(sales_df, credit_df, condition_fn, match_label: str,
                     stage_path: str = None):
    candidates = (
        sales_df.alias("s")
        .join(credit_df.alias("c"), on="primary_key", how="inner")
        .withColumn("amount_diff",
            F.abs(F.col("s.sales_amt") + F.col("c.credit_amt")))
        .withColumn("month_lag",
            F.months_between(
                F.col("c.credit_month").cast("date"),
                F.col("s.sales_month").cast("date"),
            ).cast("int"))
    )
    candidates = condition_fn(candidates)
 
    if candidates.limit(1).count() == 0:
        return None, sales_df, credit_df
 
    w_sales = Window.partitionBy("primary_key", "s.sales_row_id").orderBy(
        F.col("amount_diff").asc(), F.col("month_lag").asc(),
        F.col("c.credit_eff_dt").asc(), F.col("c.credit_row_id").asc(),
    )
    w_credit = Window.partitionBy("primary_key", "c.credit_row_id").orderBy(
        F.col("amount_diff").asc(), F.col("month_lag").asc(),
        F.col("s.sales_eff_dt").asc(), F.col("s.sales_row_id").asc(),
    )
 
    confirmed = (
        candidates
        .withColumn("rn_sales",  F.row_number().over(w_sales))
        .filter(F.col("rn_sales") == 1)
        .withColumn("rn_credit", F.row_number().over(w_credit))
        .filter(F.col("rn_credit") == 1)
        .select(
            F.col("primary_key"),
            F.col("s.sales_row_id").alias("sales_row_id"),
            F.col("c.credit_row_id").alias("credit_row_id"),
            F.col("s.sales_amt").alias("sales_amt"),
            F.col("c.credit_amt").alias("credit_amt"),
            F.col("amount_diff"),
            F.col("s.sales_eff_dt").alias("sales_eff_dt"),
            F.col("c.credit_eff_dt").alias("credit_eff_dt"),
            F.col("s.sales_month").alias("sales_month"),
            F.col("c.credit_month").alias("credit_month"),
            F.col("s.sales_ref").alias("sales_ref"),
            F.col("c.credit_ref").alias("credit_ref"),
            F.col("month_lag"),
            F.lit(match_label).alias("match_type"),
        )
    )
 
    if confirmed.limit(1).count() == 0:
        return None, sales_df, credit_df
 
    # This is the ONLY write of "pairs_{match_label}" — match_type is
    # already stamped in the select() above. Do NOT re-materialize this
    # same output again under the same path in the caller (exhaustive_match);
    # writing "overwrite" to a path a lazy DF handle already points to,
    # then later re-reading via that stale handle/lineage, is what produced
    # the FILE_NOT_EXIST error on old tid-stamped part files.
    confirmed = materialize_df(confirmed, f"pairs_{match_label}", stage_path=stage_path)
 
    matched_s_ids = confirmed.select("sales_row_id").distinct()
    matched_c_ids = confirmed.select("credit_row_id").distinct()
 
    rem_sales  = sales_df.join(matched_s_ids,  on="sales_row_id",  how="left_anti")
    rem_credit = credit_df.join(matched_c_ids, on="credit_row_id", how="left_anti")
 
    return confirmed, rem_sales, rem_credit


# exhaustive_match(): runs rank_based_match() REPEATEDLY against the same
# condition_fn until one of three natural stop conditions fires:
#   1. one side (sales or credit) is completely drained, or
#   2. a fresh pass finds zero candidates matching condition_fn at all, or
#   3. a fresh pass finds candidates but the mutual-best-match ranking in
#      rank_based_match() confirms zero pairs from them.
# This repetition is the "exhaustive" part — a single rank_based_match()
# pass only grabs each row's single best mutual match; some rows only
# become any row's best match AFTER their original best match has been
# claimed and removed in an earlier iteration, so this loop keeps
# re-running the same rule against the shrinking remainder until nothing
# more falls out. Each iteration strictly shrinks both sides (matched
# row_ids are removed via left_anti in rank_based_match()), so the loop is
# guaranteed to terminate — there is no iteration cap, because the 3 stop
# conditions above already guarantee it will.
#
# CHECKPOINTING: every iteration writes 3 files under stage_path —
# CKPT_{label}_meta (last_completed_iteration + running total_pairs),
# CKPT_{label}_rem_sales/_rem_credit (the surviving sales/credit frames as
# of that iteration). If this cell is re-run after a partial failure,
# exhaustive_match() reads the meta file, confirms every iteration's
# pairs_{label}_i{n}.parquet file it claims to have produced still exists
# on disk, and if so resumes from iteration (last_completed_iteration + 1)
# instead of re-matching from scratch. last_completed_iteration == -1 is
# the "this match_label finished cleanly on a prior run" sentinel.
#
# Once the loop stops, every iteration's slim pairs table
# (pairs_{label}_i{n}) is unioned into one SLIM_{label} frame, expanded
# back to full original rows via resolve_to_original(), and the
# intermediate per-iteration parquet files + checkpoint remainder files are
# deleted (they've served their purpose — SLIM_{label} and the checkpoint
# meta's final -1 sentinel are what matters going forward).
def exhaustive_match(sales_df, credit_df, condition_fn, match_label: str,
                     base_df, stage_path: str = None,
                     has_year_flag: bool = False):
    """
    RECTIFIED: previously this function re-materialized `pairs` to the
    exact same path (f"pairs_{iter_lbl}.parquet") that rank_based_match()
    had just written and read back from. That second overwrite of a path
    whose old file handle/lineage was still referenced elsewhere (directly
    by `pairs`, and indirectly by anything resuming off the checkpoint)
    caused Spark Connect to later look for a part file under a tid that no
    longer existed on disk -> FILE_NOT_EXIST / KD001.
 
    Fix: rank_based_match() already materializes + writes
    "pairs_{match_label}" (== "pairs_{iter_lbl}" here) with match_type
    already set. The redundant second materialize_df() call on the same
    path has been removed — `pairs` returned from rank_based_match() is
    used as-is.
    """
    print(f"\n[EXHAUSTIVE MATCH] {match_label}")
    base = stage_path or output_path
 
    ckpt_meta_path   = f"{base}/CKPT_{match_label}_meta.parquet"
    ckpt_sales_path  = f"{base}/CKPT_{match_label}_rem_sales.parquet"
    ckpt_credit_path = f"{base}/CKPT_{match_label}_rem_credit.parquet"
 
    start_iteration  = 1
    accumulated      = []
    cur_sales        = sales_df
    cur_credit       = credit_df
    total_pairs      = 0
 
    if _path_exists(ckpt_meta_path):
        try:
            ckpt_row  = cp.read(ckpt_meta_path).collect()[0]
            last_iter = ckpt_row["last_completed_iteration"]
 
            if last_iter == -1:
                print(f"  [CKPT] Prior run completed cleanly — starting fresh.")
 
            elif last_iter > 0:
                _candidate_paths = [
                    (f"{match_label}_i{i}", f"{base}/pairs_{match_label}_i{i}.parquet")
                    for i in range(1, last_iter + 1)
                ]
                try:
                    _all_exist = all(
                        _path_exists(p) for _, p in _candidate_paths
                    )
                except Exception:
                    _all_exist = False
 
                if _all_exist:
                    total_pairs     = ckpt_row["total_pairs"]
                    cur_sales       = cp.read(ckpt_sales_path)
                    cur_credit      = cp.read(ckpt_credit_path)
                    accumulated     = list(_candidate_paths)
                    start_iteration = last_iter + 1
                    print(f"  [CKPT] Resuming from iteration {start_iteration} "
                          f"(pairs so far: {total_pairs:,})")
                else:
                    print(f"  [CKPT] Stale checkpoint (pair files missing) — starting fresh.")
            else:
                print(f"  [CKPT] Checkpoint unreadable (last_iter={last_iter}) — starting fresh.")
 
        except Exception:
            print(f"  [CKPT] Checkpoint unreadable — starting fresh.")
    else:
        print(f"  [CKPT] No checkpoint found — starting fresh.")
 
    iteration = start_iteration
    while True:
 
        if cur_sales.limit(1).count() == 0 or cur_credit.limit(1).count() == 0:
            print(f"  Iter {iteration}: one side exhausted — stopping.")
            break
 
        iter_lbl = f"{match_label}_i{iteration}"
        print(f"  Iter {iteration} — matching...")
 
        pairs, rem_s, rem_c = rank_based_match(
            cur_sales, cur_credit, condition_fn, iter_lbl, stage_path=base
        )
 
        if pairs is None:
            print(f"  Iter {iteration}: no candidates — stopping.")
            break
 
        n = pairs.count()
        print(f"  Iter {iteration}: {n:,} pairs.")
        if n == 0:
            break
 
        total_pairs += n
 
        # --- FIX: removed the duplicate materialize_df(pairs, f"pairs_{iter_lbl}", ...)
        # call that used to sit here. `pairs` is already the materialized,
        # match_type-stamped output of rank_based_match() at path
        # f"{base}/pairs_{iter_lbl}.parquet" — reuse it directly instead of
        # overwriting the same path a second time.
        accumulated.append((iter_lbl, f"{base}/pairs_{iter_lbl}.parquet"))
 
        cur_sales  = materialize_df(rem_s, f"rem_s_{match_label}_cur", stage_path=base)
        cur_credit = materialize_df(rem_c, f"rem_c_{match_label}_cur", stage_path=base)
 
        cp.write(cur_sales,  ckpt_sales_path,  "overwrite", register=True)
        cp.write(cur_credit, ckpt_credit_path, "overwrite", register=True)
        ckpt_meta = spark.createDataFrame(
            [(match_label, iteration, total_pairs)],
            schema=T.StructType([
                T.StructField("match_label",              T.StringType()),
                T.StructField("last_completed_iteration", T.IntegerType()),
                T.StructField("total_pairs",              T.LongType()),
            ])
        )
        cp.write(ckpt_meta, ckpt_meta_path, "overwrite", register=True)
        print(f"  [CKPT] Iter {iteration} saved. Cumulative pairs: {total_pairs:,}")
        iteration += 1
 
    if not accumulated:
        display_metric(f"[{match_label}] Total pairs", 0)
        return None, sales_df, credit_df
 
    slim_df = cp.read(accumulated[0][1])
    for _, path in accumulated[1:]:
        slim_df = slim_df.unionByName(cp.read(path))
 
    slim_all = materialize_df(slim_df, f"SLIM_{match_label}", stage_path=base)
    display_metric(f"[{match_label}] Total pairs", total_pairs)
 
    for iter_lbl, path in accumulated:
        try:
            dbutils.fs.rm(path, recurse=True)
            print(f"  [CLEANUP] Removed {path}")
        except Exception:
            pass
 
    for suffix in [f"rem_s_{match_label}_cur", f"rem_c_{match_label}_cur"]:
        try:
            dbutils.fs.rm(f"{base}/{suffix}.parquet", recurse=True)
        except Exception:
            pass
 
    resolved = resolve_to_original(
        slim_all, base_df, match_label,
        f"RESOLVED_{match_label}", base, has_year_flag,
    )
 
    debug_count(f"[{match_label}] Resolved rows",   resolved)
    debug_count(f"[{match_label}] Remaining sales",  cur_sales)
    debug_count(f"[{match_label}] Remaining credit", cur_credit)
 
    ckpt_done = spark.createDataFrame(
        [(match_label, -1, total_pairs)],
        schema=T.StructType([
            T.StructField("match_label",              T.StringType()),
            T.StructField("last_completed_iteration", T.IntegerType()),
            T.StructField("total_pairs",              T.LongType()),
        ])
    )
    cp.write(ckpt_done, ckpt_meta_path, "overwrite", register=True)
 
    return resolved, cur_sales, cur_credit

