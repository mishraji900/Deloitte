def s3a_build_residual_rows(
    updated_raw_tb_CY,
    materiality,
    row_id_col=ROW_ID_COLUMN_NAME,
):
    materiality_value = s3a_to_decimal(materiality)

    if materiality_value in {None, Decimal("0")}:
        raise ValueError(
            "MATERIALITY must be a non-zero number."
        )

    source_columns = list(updated_raw_tb_CY.columns)
    records = s3a_get_records(updated_raw_tb_CY)

    row_id_column = s3a_require_column(
        source_columns,
        row_id_col,
    )
    account_column = s3a_require_column(
        source_columns,
        ACCOUNT_COLUMN_NAME,
    )
    percentage_column = s3a_require_column(
        source_columns,
        PERCENTAGE_COLUMN_NAME,
    )
    test_column = s3a_require_column(
        source_columns,
        TEST_COLUMN_NAME,
    )
    untested_column = s3a_require_column(
        source_columns,
        UNTESTED_COLUMN_NAME,
    )

    residual_rows = []

    for record in records:
        raw_row_id = record.get(row_id_column)

        try:
            source_row_id = int(raw_row_id)
        except (ValueError, TypeError):
            raise ValueError(
                f"Invalid {row_id_col}: {raw_row_id!r}"
            )

        if source_row_id < 1:
            raise ValueError(
                f"{row_id_col} must be positive."
            )

        account_name = record.get(account_column)

        if s3a_normalize(account_name) == "":
            continue

        percentage_value = s3a_to_decimal(
            record.get(percentage_column)
        )

        if percentage_value in {None, Decimal("0")}:
            continue

        if s3a_normalize(record.get(test_column)) != "no":
            continue

        untested_value = s3a_to_decimal(
            record.get(untested_column)
        )

        if untested_value is None:
            continue

        if (
            abs(untested_value / materiality_value)
            <= Decimal("1")
        ):
            continue

        residual_rows.append(
            {
                "Account_CY": account_name,
                "row_id": source_row_id,
                "record": record,
            }
        )

    residual_rows.sort(
        key=lambda row: row["row_id"]
    )

    return residual_rows


