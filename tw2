def prepare_data(
    df_full: pd.DataFrame,
    acct_group_value: str,
) -> pd.DataFrame:
    """Filter data for one account group and standardize numeric fields."""
    data_cfg = data_config()
    account_group_col = data_cfg["account_group_column"]

    required_columns = [
        account_group_col,
        data_cfg["group_column"],
        data_cfg["account_column"],
        *numeric_columns(),
    ]

    missing_columns = [
        column for column in required_columns if column not in df_full.columns
    ]

    if missing_columns:
        raise KeyError(
            "The input data is missing these required columns: "
            f"{missing_columns}"
        )

    # Restrict the full dataset to the account group currently being reported.
    df = df_full[
        df_full[account_group_col] == acct_group_value
    ].copy()

    if df.empty:
        raise ValueError(
            f"No rows where {account_group_col} = '{acct_group_value}'."
        )

    # Convert balances and fluctuations to numeric values for calculations.
    df[numeric_columns()] = df[numeric_columns()].apply(
        pd.to_numeric,
        errors="coerce",
    )

    # Replace invalid, blank, or nonnumeric source values with zero.
    df[numeric_columns()] = df[numeric_columns()].fillna(0)

    return df


