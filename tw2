# DBTITLE 1,AA Comment logic
def assign_aa_comment(df, raw_df):
    """First match wins. Needs match_type, cat_clean, company_desc_clean, vendor_num_clean, _pair_net_abs on df."""
    nm = F.col("match_type")
    cm = (nm == "NO_MATCH_FOUND") & (F.col("cat_clean") == "CREDIT MEMOS")
    exact = F.col("_pair_net_abs") == EXACT_ZERO  # null -> falsy

    # company+vendor grain (same key matching uses). ponytail: raw_df is JE_raw only (old behavior);
    # union JE_raw_2_aligned if prior-year sales should count as "sales exist for this vendor".
    stats = (raw_df
             .withColumn("_co", F.trim(F.upper(F.col("Company Description"))))
             .withColumn("_vn", F.trim(F.col("Vendor/Customer Number").cast("string")))
             .withColumn("_cat", F.trim(F.upper(F.col("JE Category"))))
             .groupBy("_co", "_vn")
             .agg(F.countDistinct(F.when(F.col("_cat") == "SALES INVOICES", F.col("Invoice Reference"))).alias("sales_inv_count"),
                  F.countDistinct(F.when(F.col("_cat") == "CREDIT MEMOS", F.col("Invoice Reference"))).alias("credit_memo_count")))
    df = df.join(stats, (df["company_desc_clean"] == F.col("_co")) & (df["vendor_num_clean"] == F.col("_vn")), "left") \
           .drop("_co", "_vn")
    only_cm = cm & (F.col("sales_inv_count") == 0) & (F.col("credit_memo_count") > 0)

    comment = (F.when(nm == "ONE_TO_MANY", F.lit(AA_ONE_TO_MANY))
                .when((nm == "ONE_TO_ONE_DATE_SYNC") & exact, F.lit(AA_EXACT_MATCH_SYNC))
                .when(nm == "ONE_TO_ONE_DATE_SYNC", F.lit(AA_APPROX_MATCH))
                .when((nm == "ONE_TO_ONE_DATE_UNSYNC") & exact, F.lit(AA_EXACT_MATCH_UNSYNC))
                .when(nm == "ONE_TO_ONE_DATE_UNSYNC", F.lit(AA_APPROX_MATCH))
                .when(only_cm, F.lit(AA_ONLY_CREDITS))
                .when(cm, F.lit(AA_CLIENT_CONFIRM)))
    rule = (F.when(nm == "ONE_TO_MANY", F.lit("Rule1_OTM"))
             .when((nm == "ONE_TO_ONE_DATE_SYNC") & exact, F.lit("Rule2a_DateSync_ExactMatch"))
             .when(nm == "ONE_TO_ONE_DATE_SYNC", F.lit("Rule2a_DateSync_ApproxMatch"))
             .when((nm == "ONE_TO_ONE_DATE_UNSYNC") & exact, F.lit("Rule2b_DateUnsync_ExactMatch"))
             .when(nm == "ONE_TO_ONE_DATE_UNSYNC", F.lit("Rule2b_DateUnsync_ApproxMatch"))
             .when(only_cm, F.lit("Rule3P1_OnlyCredits_CompanyVendor"))
             .when(cm, F.lit("Rule3P4_ClientConfirm")))
    return (df.withColumn("AA Comment", comment).withColumn("AA Rule", rule)
              .drop("_pair_net_abs", "sales_inv_count", "credit_memo_count"))

