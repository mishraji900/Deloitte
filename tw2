# SECTION 7 — Per-sheet builder  ← reads shared constants + only as_of_text
# ══════════════════════════════════════════════════════════════════════════════

def build_tb_tieout(ws, cfg: SheetConfig):
    """Populate one worksheet. Only cfg.as_of_text varies between sheets."""
    ws.sheet_view.showGridLines = False

    entity_cols, post_cols, print_cols = _get_print_columns(cfg.dataset)
    n_cols = len(print_cols)

    ws.column_dimensions[get_column_letter(COL_SPACER)].width  = 2
    ws.column_dimensions[get_column_letter(COL_ACCOUNT)].width = 55
    for i in range(1, n_cols):
        ws.column_dimensions[get_column_letter(_xl(i))].width = 18

    ws.freeze_panes = ws.cell(row=ROW_FIRST_TABLE, column=_xl(1))

    # Rows 1–4: all constants except row 3 (as_of_text comes from cfg)
    _write_banner(ws, ROW_TITLE_1,  BANNER_TITLE_1,
                  FONT_TITLE, height=18)
    _write_banner(ws, ROW_TITLE_2,  BANNER_TITLE_2,
                  make_font(BLACK, size=11, bold=True), height=18)
    _write_banner(ws, ROW_AS_OF,    cfg.as_of_text,          # ← only dynamic field
                  make_font(BLACK, size=11), border=BORDER_GREEN, height=18)
    _write_banner(ws, ROW_CURRENCY, BANNER_CURRENCY,
                  make_font(BLACK, size=11, bold=True), height=18)

    ws.row_dimensions[ROW_SPACER_1].height = 6
    _write_note_box(ws)

    bs_records, is_records = _split_bs_is(cfg.dataset)

    next_row = _write_table(
        ws, "Balance Sheet", bs_records,
        print_cols, entity_cols, start_row=ROW_FIRST_TABLE,
    )
    if is_records:
        _write_table(
            ws, "Income Statement", is_records,
            print_cols, entity_cols, start_row=next_row,
        )
