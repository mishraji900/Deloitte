        out["rows"] += 1
        cy_cell, py_cell = ws.cell(row=r, column=col["cy"]).value, ws.cell(row=r, column=col["py"]).value
        if has_formula(ws.cell(row=r, column=col["diff"]).value):   # active rows carry formulas, greyed rows don't
            out["active"] += 1
            cy, py = to_decimal(cy_cell), to_decimal(py_cell)
            if cy is not None: out["cy_count"] += 1; out["cy_sum"] += cy
            if py is not None: out["py_count"] += 1; out["py_sum"] += py
        else:
            out["greyed"] += 1
            out["leaks"] += sum(1 for v in (cy_cell, py_cell) if v is not None)
    return out

