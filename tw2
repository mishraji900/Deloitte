def _apply_investigate_colors(
    worksheet,
    column_letters,
    non_grey_rows,
):
    """
    Applies static and dynamic colors to Investigate? columns.
    """

    for row_number in non_grey_rows:
        for key in ("inv1", "inv2"):
            cell_reference = (
                f"{column_letters[key]}{row_number}"
            )
            cell = worksheet[cell_reference]

            if (
                isinstance(cell.value, str)
                and not cell.value.startswith("=")
            ):
                cell.fill = (
                    GREEN_FILL
                    if cell.value.strip().casefold() == "no"
                    else RED_FILL
                )
            else:
                cell.fill = WHITE_FILL

            no_formula = (
                f'IFERROR(UPPER(TRIM({cell_reference}))="NO",FALSE)'
            )

            worksheet.conditional_formatting.add(
                cell_reference,
                FormulaRule(
                    formula=[no_formula],
                    fill=GREEN_FILL,
                    stopIfTrue=True,
                ),
            )

            worksheet.conditional_formatting.add(
                cell_reference,
                FormulaRule(
                    formula=[f"NOT({no_formula})"],
                    fill=RED_FILL,
                    stopIfTrue=True,
                ),
            )


