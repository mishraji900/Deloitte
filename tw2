    )
    test_value = str(
        get_value(record, TEST_COLUMN, "Test Consolidated Amount") or ""
    ).strip().casefold()
    return (
        present(account)
        and percentage is not None
        and percentage != Decimal("0")
        and test_value == "no"
    )


