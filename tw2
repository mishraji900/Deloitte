def tab3_replica(rows):
    d_mat, d_thr = to_decimal(MATERIALITY), to_decimal(THRESHOLD_VALUE)
    d_pct, d_mult = to_decimal(THRESHOLD_PERCENTAGE), to_decimal(INVESTIGATE_MULTIPLE)
    inv1 = inv2 = 0
    for rec in rows:
        if rec.get("CY_Greyed"): continue
        cy, py = to_decimal(rec.get("Untested_Balance_CY")), to_decimal(rec.get("Untested_Balance_PY"))
        if cy is not None and abs(cy / d_mat) > d_mult: inv2 += 1
        if cy is None or py is None or py == 0 or cy == 0: continue
        diff = cy - py
        if abs(diff) > d_thr and abs(diff / cy) > d_pct: inv1 += 1
    return inv1, inv2

