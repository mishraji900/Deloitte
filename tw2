    )


# ==============================================================================
# _strip_plural
# ==============================================================================

def _strip_plural(token: str) -> str:
    """
    Strips trailing 's' ONLY when it is a genuine plural suffix.

    Keeps token unchanged when:
      - length ≤ 2
      - does not end with 's'
      - ends with a protected suffix: ss / us / is / as / ous

    Examples
    ────────
    investments  →  investment      ✅ stripped
    fees         →  fee             ✅ stripped
    concessions  →  concession      ✅ stripped
    gross        →  gross           ✅ protected  (ss)
    excess       →  excess          ✅ protected  (ss)
    basis        →  basis           ✅ protected  (is)
    surplus      →  surplus         ✅ protected  (us)
    various      →  various         ✅ protected  (ous)
    """

    if len(token) <= 2 or not token.endswith("s"):
        return token

    for safe_ending in _PLURAL_SAFE_ENDINGS:
        if token.endswith(safe_ending):
            return token

    return token[:-1]


# ==============================================================================
# _py_account_key
# ==============================================================================

def _py_account_key(value: str) -> str:
    """
    Deterministic normalization key for account name matching.

    Pipeline (order matters)
    ────────────────────────
    1.  casefold() + strip()            → upper/lower + surrounding spaces
    2.  Remove apostrophes              → "client's"  = "clients"
    3.  '&' → 'and'                    → "Cash & …"  = "Cash and …"
    4.  Hyphens / dashes → space       → "non-cash"  = "non cash"
    5.  Spelling typo corrections       → "valutaion" = "valuation"
    6.  Strip all non-alphanumeric      → commas, slashes, parens, etc.
    7.  Collapse whitespace + trim      → extra internal spaces removed
    8.  Token-sort                      → word-order differences eliminated
    9.  _strip_plural per token         → singular/plural unified,
                                          root-ending words protected
    """

    if not value:
        return ""

    text = str(value).casefold().strip()

    # Step 2 – remove apostrophes (straight + curly)
    text = text.replace("'", "").replace("\u2019", "")

    # Step 3 – ampersand → and
    text = text.replace("&", " and ")

    # Step 4 – hyphens / dashes → space
    text = re.sub(r"[-\u2013\u2014]", " ", text)

    # Step 5 – spelling typo corrections
    for pattern, replacement in _ACCOUNT_KEY_CORRECTIONS:
        text = pattern.sub(replacement, text)

    # Step 6 – strip everything except letters, digits, spaces
    text = re.sub(r"[^a-z0-9 ]+", " ", text)

    # Step 7 – collapse spaces + trim
    text = re.sub(r"\s+", " ", text).strip()

    # Step 8 – token sort
    tokens = sorted(text.split())

    # Step 9 – safe plural strip
    tokens = [_strip_plural(t) for t in tokens]

    return " ".join(tokens)


# ==============================================================================
# _build_fuzzy_alias_map
# ==============================================================================

def _build_fuzzy_alias_map(
    cy_keys: list[str],
    py_keys: list[str],
) -> dict[str, str]:
    """
    Builds {py_rich_key → cy_rich_key} alias map using EXACT match on
    fully-normalized keys produced by _py_account_key.

    No similarity score. Adding or removing a real word never aliases.
    """

    cy_norm_to_key: dict[str, str] = {}
    for key in cy_keys:
        norm = _py_account_key(key)
        if norm and norm not in cy_norm_to_key:
            cy_norm_to_key[norm] = key

    alias_map: dict[str, str] = {}
    for py_key in set(py_keys):
        if not py_key:
            continue
        py_norm = _py_account_key(py_key)
        cy_key  = cy_norm_to_key.get(py_norm)
        if cy_key is not None and cy_key != py_key:
            alias_map[py_key] = cy_key

    return alias_map


# ==============================================================================
# _collect_account_rich_keys
# ==============================================================================

def _collect_account_rich_keys(
    dataframe,
    account_column: str,
) -> list[str]:
    """
    Collects all distinct non-null account key values from the dataframe
    as a Python list for alias-map construction in the driver.
    """

    return [
        row[0]
        for row in (
            dataframe
            .select(F.col(f"`{account_column}`").cast("string"))
            .filter(F.col(f"`{account_column}`").isNotNull())
            .distinct()
            .collect()
        )
    ]


def _spark_account_key_aliased(
    column_name: str,
    alias_map: dict[str, str],
):
    """
    Replicates _py_account_key entirely inside Spark expressions, then
    applies the alias map as a create_map literal lookup.
    """

    raw  = F.trim(F.col(f"`{column_name}`").cast("string"))
    step = F.lower(raw)

    # Step 2 – remove apostrophes (straight + curly)
    step = F.regexp_replace(step, r"['\u2019]", "")

    # Step 3 – & → and
    step = F.regexp_replace(step, r"&", " and ")

    # Step 4 – hyphens / dashes → space
    step = F.regexp_replace(step, r"[-\u2013\u2014]", " ")

    # Step 5 – typo corrections
    step = F.regexp_replace(step, r"(?i)\bvalutaions?\b", "valuation")

    # Step 6 – strip non-alphanumeric except spaces
    step = F.regexp_replace(step, r"[^a-z0-9 ]+", " ")

    # Step 7 – collapse spaces + trim
    step = F.trim(F.regexp_replace(step, r"\s+", " "))

    # Step 8 – token-sort
    tokens = F.array_sort(F.split(step, " "))

    # Step 9 – safe plural strip per token
    # Mirrors _strip_plural: only strip 's' when NOT a protected suffix.
    tokens_singular = F.transform(
        tokens,
        lambda t: F.when(
            (F.length(t) > 2)
            & t.endswith("s")
            & (~t.endswith("ss"))
            & (~t.endswith("us"))
            & (~t.endswith("is"))
            & (~t.endswith("as"))
            & (~t.endswith("ous")),
            F.regexp_replace(t, "s$", ""),
        ).otherwise(t),
    )

    # Step 10 – rejoin
    rich_key = F.concat_ws(" ", tokens_singular)

    # Step 11 – alias-map lookup
    if alias_map:
        map_literal = F.create_map(
            *[
                item
                for pair in alias_map.items()
                for item in (F.lit(pair[0]), F.lit(pair[1]))
            ]
        )
        return F.coalesce(map_literal[rich_key], rich_key)

    return rich_key




