# _path_exists(): existence check used by exhaustive_match()'s checkpoint
# logic (both for the meta file and for each per-iteration pairs_*.parquet
# it references). Returns False on ANY failure (not found, permission,
# transient), which is the conservative choice for a checkpoint check —
# "can't confirm it's there" and "not there" both mean "start fresh".
def _path_exists(path: str) -> bool:
    try:
        dbutils.fs.ls(path)
        return True
    except Exception:
        return False


# write_table(): the terminal write for anything meant to be a FINAL,
# user-facing output table — always writes to output_path_et (or an
# explicit base_path override) rather than a pipeline's scratch
# STAGE_PATH. Returns the path it wrote to, so materialize_df() (below)
# can read straight back off it without duplicating the cp.write() call.
def write_table(df, name: str, log: bool = True, base_path: str = None):
    if df is None:
        print(f"  [SKIP] {name} – no data")
        return
    path = f"{base_path or output_path}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    if log:
        print(f"  [WRITTEN] {path}")
    return path


# materialize_df(): the workhorse used everywhere a lazy Spark transform
# chain needs to be forced to disk and re-read as a fresh DataFrame — this
# breaks lineage so later stages don't re-evaluate an ever-growing chain of
# joins/filters, and (via repartition_key) lets a call site pre-shuffle on
# the column that the next join/groupBy will use. Delegates the actual
# write to write_table() so there's exactly one place that calls
# cp.write(..., "overwrite", register=True).
def materialize_df(df, name: str, repartition_key: str = None,
                   stage_path: str = None, num_partitions: int = NUM_PARTITIONS):
    print(f"  [MATERIALIZE] {name}")
    if repartition_key and repartition_key in df.columns:
        df = df.repartition(num_partitions, repartition_key)
    path = write_table(df, name, log=False, base_path=stage_path)
    return cp.read(path)


# debug_count / display_metric / debug_group_count / audit_summary all
# render through Databricks display() rather than print(), so every count,
# profile, and audit shows as a proper notebook table instead of console
# text. The one deliberate exception is exhaustive_match()'s own
# per-iteration progress logging ("Iter N: ...", "[CKPT] ..."), which stays
# on plain print() — that's live status output about a loop still running,
# not a finished result worth a table.

def debug_count(label: str, df):
    """One-row [Metric, Count] table for a DataFrame's row count."""
    n = df.count() if df is not None else None
    row_df = spark.createDataFrame([(label, n)], ["Metric", "Count"])
    display(row_df)


def display_metric(label: str, value):
    """Same one-row [Metric, Count] shape as debug_count, but for a value
    that's already a plain Python scalar (e.g. an accumulated total pairs
    count) rather than something with a live .count() to call."""
    display(spark.createDataFrame([(label, value)], ["Metric", "Count"]))


def debug_group_count(df, col_name: str, label: str, limit: int = 20):
    """groupBy(col_name).count() breakdown, top `limit` rows by count desc,
    rendered as a table — the standard "distribution of X" profile call
    used throughout every pipeline stage."""
    print(f"\n  [PROFILE] {label}")
    profiled = (
        df.groupBy(col_name)
          .count()
          .orderBy(F.desc("count"), F.asc(col_name))
          .limit(limit)
    )
    display(profiled)


def audit_summary(datasets: dict):
    """Row-count table across every named dataset in a pipeline stage, plus
    a TOTAL row — the per-pipeline reconciliation check (e.g. does
    INVALID + EXC_1 + UNIQUE_* + DUP_* + MATCHED_* + UNMATCHED add up to
    the pipeline's input row count?). Returns False if any dataset was
    None, so a caller can assert on it if desired."""
    rows  = []
    total = 0
    ok    = True
    for label, df in datasets.items():
        if df is None:
            rows.append((label, None))
            ok = False
        else:
            n      = df.count()
            total += n
            rows.append((label, n))
    rows.append(("TOTAL", total))
    summary_df = spark.createDataFrame(rows, ["Dataset", "Count"])
    display(summary_df)
    return ok


# export_to_excel(): the Cell 8 terminal step. Takes {sheet_name: df},
# strips every internal/derived working column (primary keys, cleaned
# helper columns, validity flags — none of which are meant for a client-
# facing workbook) via _drop, pins a handful of the most load-bearing
# business columns to the front of each sheet via _front, and writes one
# multi-sheet .xlsx.
def export_to_excel(sheets: dict, path: str):
    _front = ["primary_key", "JE Category", "Net Entered",
              "Default Effective Date", "Source Quarter"]
    _drop  = {
        "pair_id", "pk_row_count", "row_id", "invoice_ref_clean", "cat_clean",
        "company_desc_clean", "vendor_num_clean", "eff_dt", "month_dt",
        "entered_net_dec", "abs_entered_dec", "abs_entered_key",
        "is_valid_row", "valid_company_desc", "valid_vendor_num", "abs_usd_net",
        "p3_primary_key", "p4_primary_key",
    }

    def _prep(df):
        if df is None:
            return None
        df            = df.drop(*[c for c in _drop if c in df.columns])
        present_front = [c for c in _front if c in df.columns]
        rest          = [c for c in df.columns if c not in present_front]
        return df.select(*(present_front + rest)).pandas_api()

    cp.pandas.to_excel(
        dataframes  =[_prep(df) for df in sheets.values()],
        sheet_names =list(sheets.keys()),
        path        =path,
    )
    print(f"  [EXCEL] Written → {path}")


# ── Schema helpers ───────────────────────────────────────────────────────────

# ensure_required_columns(): forces any input frame onto the exact column
# list a pipeline expects (BASE_RAW_COLUMNS or PIPE2_RAW_COLUMNS) — missing
# columns are null-padded in, anything not in the list is dropped by the
# final select(). Also backfills "Company Description" from "Company" when
# the former is null, since some source extracts only populate one or the
# other. This is what lets P1's ragged output be fed straight into P2's
# base_tag() without a manual reconciliation step.
def ensure_required_columns(df, required_cols: list):
    for c in required_cols:
        if c not in df.columns:
            df = df.withColumn(c, F.lit(None).cast("string"))
    df = df.withColumn(
        "Company Description",
        F.coalesce(
            F.col("Company Description").cast("string"),
            F.col("Company").cast("string"),
        )
    )
    return df.select(*required_cols)


# ensure_row_id(): every row needs a stable, unique row_id so it can be
# tracked through the join/anti-join dance in rank_based_match() and
# rejoined to its original values in resolve_to_original(). If the frame
# already carries a row_id (e.g. a re-tagged P1/P2/P3 leftover frame) it's
# just re-cast to string and left alone. Otherwise a fresh row_number() is
# assigned over a deterministic natural sort — deterministic so the same
# input always produces the same row_id, which matters for checkpoint
# resume (a checkpointed sales/credit frame has to line up with a fresh
# re-run of base_tag() on the same input).
def ensure_row_id(df):
    if "row_id" in df.columns:
        return df.withColumn("row_id", F.col("row_id").cast("string"))
    preferred = [
        "Company Description", "Vendor/Customer Number", "JE Category",
        "Default Effective Date", "Month", "Net Entered",
        "Invoice Reference", "JE Batch Id", "JE Line Number",
    ]
    order_cols = [c for c in preferred if c in df.columns] or sorted(df.columns)
    return df.withColumn(
        "row_id",
        F.row_number()
         .over(Window.orderBy(*[F.col(c).asc_nulls_last() for c in order_cols]))
         .cast("string"),
    )


# ── Type-conversion helpers ──────────────────────────────────────────────────

# to_decimal_clean(): normalizes a raw amount string into DECIMAL_TYPE —
# strips thousands separators, converts accounting-style "(123.45)"
# negatives into "-123.45", and turns "" into NULL rather than 0 (an empty
# amount is missing data, not a zero dollar amount — is_valid_row in
# base_tag() depends on this distinction).
def to_decimal_clean(col_name: str, precision: int = 38, scale: int = 6):
    cleaned = F.trim(F.col(col_name).cast("string"))
    cleaned = F.regexp_replace(cleaned, ",", "")
    cleaned = F.when(
        cleaned.rlike(r"^\(.*\)$"),
        F.concat(F.lit("-"), F.regexp_replace(cleaned, r"[()]", "")),
    ).otherwise(cleaned)
    cleaned = F.when(cleaned == "", None).otherwise(cleaned)
    return cleaned.cast(T.DecimalType(precision, scale))


# (to_date_clean lives in Cell 1 — Cell 2's year/quarter derivation runs
# before this cell and needs it too, so there is exactly one copy of the
# date-format coalesce list for the whole notebook.)


# month_from_business_column(): parses the raw "Month" business column
# (typically "MMM-yy" style, e.g. "Mar-26") into a real date, with two
# extra fallbacks that prepend "01-" so a bare "Mar-26"/"March-2026" string
# still resolves to the 1st of that month, plus the same numeric/ISO
# fallbacks to_date_clean uses in case "Month" was populated with a full
# date instead of a month label. month_dt (not eff_dt) is what
# rank_based_match() uses for month_lag, since "Month" is the business
# period a JE was booked to, which can differ from its effective date.
def month_from_business_column(month_col):
    raw = F.trim(month_col.cast("string"))
    return F.coalesce(
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yyyy"),
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )


# ── DataFrame set helpers ────────────────────────────────────────────────────

# union_non_null(): unionByName across any number of DataFrames, silently
# skipping any that are None (e.g. a pipeline stage that found zero rows
# for a given match_type and returned None instead of an empty frame).
# allowMissingColumns=True so frames with slightly different derived-column
# sets (e.g. a P1 frame without Year Flag vs a P2 frame with it) can still
# be unioned — missing columns are null-filled on the narrower side.
def union_non_null(*dfs):
    valid = [df for df in dfs if df is not None]
    if not valid:
        return None
    out = valid[0]
    for df in valid[1:]:
        out = out.unionByName(df, allowMissingColumns=True)
    return out


# ── Pipeline base transformation ─────────────────────────────────────────────

# base_tag(): the single entry point every pipeline (P1/P2/P3/P4) runs its
# raw input through before any matching happens. Given a raw frame and the
# column list it should conform to, this:
#   1. Pads/selects onto required_cols (ensure_required_columns)
#   2. Assigns a stable row_id (ensure_row_id)
#   3. Derives every "clean" helper column matching logic depends on:
#        invoice_ref_clean / cat_clean / company_desc_clean / vendor_num_clean
#          — trimmed/uppercased raw text, used for equality comparisons
#            that need to ignore casing/whitespace noise from source data.
#        eff_dt   — Default Effective Date, parsed to a real date (also
#                    overwrites the original string column with the parsed
#                    date, so every downstream reference to "Default
#                    Effective Date" is already a proper date).
#        Source Quarter / Year Flag — recomputed HERE, per row, straight
#          from this row's own eff_dt, every single time base_tag() runs
#          (P1, P2, P3, P4 all call it fresh) — Q1=Jan-Mar...Q4=Oct-Dec,
#          Year Flag="FY"+last 2 digits of the calendar year. This is what
#          makes carry-forward rows correctly self-tag as whatever prior
#          FY/quarter they actually belong to, rather than being stamped
#          with a single global PRIOR_FY constant.
#        month_dt        — parsed "Month" business column (see above)
#        entered_net_dec / abs_entered_dec / abs_entered_key
#          — the cleaned amount, its absolute value, and that absolute
#            value as a string (used as one leg of primary_key, below).
#        valid_company_desc / valid_vendor_num
#          — booleans gating whether this row has enough identifying info
#            to form a primary_key at all.
#        primary_key = "{company}_{vendor}_{|amount|}" — the join key every
#          matching pass groups Sales Invoices against Credit Memos on.
#          NULL if company/vendor/amount is missing (see valid_* above).
#        is_valid_row — the row-id/amount/date/primary_key completeness
#          gate that Cell 4/5/5B split INVALID vs prep rows on.
def base_tag(df, required_cols: list):
    df = ensure_required_columns(df, required_cols)
    df = ensure_row_id(df)
    df = (
        df
        .withColumn("invoice_ref_clean", F.trim(F.col("Invoice Reference")))
        .withColumn("cat_clean",          F.trim(F.upper(F.col("JE Category"))))
        .withColumn("company_desc_clean", F.trim(F.upper(F.col("Company Description"))))
        .withColumn("vendor_num_clean",
