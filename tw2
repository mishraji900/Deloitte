def _split_bs_is(spark_df):
    all_records = sorted(
        records_from(spark_df),
        key=lambda r: int(r.get(ROW_ID_COL, 0)),
    )
    accounts = [normalize_text(str(r.get(ACCOUNT_COL, ""))) for r in all_records]

    bs_start = next((i for i, a in enumerate(accounts) if a == "balance sheet"), None)
    is_start = next((i for i, a in enumerate(accounts) if a == "income statement"), None)

    if bs_start is None:
        raise ValueError(
            "'Balance Sheet' marker not found. "
            "Ensure the dataset has a row where Account == 'Balance Sheet'."
        )

    bs_raw = (all_records[bs_start + 1: is_start]
              if is_start is not None else all_records[bs_start + 1:])
    is_raw = all_records[is_start + 1:] if is_start is not None else []

    def _is_data_row(rec):
        return normalize_text(str(rec.get(ACCOUNT_COL, ""))) not in _SENTINEL_ACCOUNTS

    return [r for r in bs_raw if _is_data_row(r)], \
           [r for r in is_raw  if _is_data_row(r)]

