# GROUPING FILE: ORDER + GROUP TOTAL ROWS
# ============================================================================
import unicodedata

_INVISIBLE = dict.fromkeys(map(ord, "\u200b\u200c\u200d\u2060\ufeff\u00ad"), None)


def _norm_2(value: Any) -> str:
    """Match key: NFKC, drop invisibles, casefold, keep letters/digits only.
    'Common Stock' == 'Common  Stock' == 'Common-Stock' == 'Gains / Losses'."""
    text = unicodedata.normalize("NFKC", str(value)).translate(_INVISIBLE)
    return re.sub(r"[\W_]+", "", text.casefold())


_norm = _norm_2  # apply_grouping uses the same key


def adopt_orphans(grouping):
    """Subtotal that is nobody's child -> parent its neighbouring subtotals share.
    e.g. Equity Investment Gain/Loss sits between FX and Gains/Losses (both under
    Earnings Before Taxes), so it joins Earnings Before Taxes."""
    out, parent = list(grouping), {}
    for t, g in grouping:
        if t and _norm_2(g) != _norm_2(t):
            parent.setdefault(_norm_2(g), t)
    runs = [t for t, _ in groupby(grouping, key=lambda x: x[0])]
    for i in range(1, len(runs) - 1):
        t = runs[i]
        a = parent.get(_norm_2(runs[i - 1]))
        if t and _norm_2(t) not in parent and a and a == parent.get(_norm_2(runs[i + 1])):
            last = max(k for k, (p, _) in enumerate(out) if p == a)
            out.insert(last + 1, (a, t))
            parent[_norm_2(t)] = a
            print(f"Adopted orphan total {t!r} -> {a!r}")
    return tuple(out)


def read_grouping(source: Any, name: str) -> tuple[tuple[str, str], ...]:
    """(Grouping Total, Group) from first two columns, row order kept. Other cols ignored.
    Orphan subtotals are adopted by their neighbours' parent."""
    df = convert_to_pandas(source, name).iloc[:, :2]
    return adopt_orphans(tuple(
        (str(total).strip() if pd.notna(total) else "", str(group).strip())
        for total, group in df.itertuples(index=False, name=None)
        if pd.notna(group) and str(group).strip()
    ))


def apply_grouping(df: pd.DataFrame, grouping) -> pd.DataFrame:
    """Order rows like grouping file. Unlisted groups go last."""
    inf = float("inf")
    pos: dict[str, int] = {}
    for i, (_, group) in enumerate(grouping):
        pos.setdefault(_norm(group), i)
    key = df[ACCOUNT_GROUP_COLUMN].map(lambda s: pos.get(_norm(s), inf))
    unlisted = df.loc[key == inf, ACCOUNT_GROUP_COLUMN].tolist()
    if unlisted:
        print(f"Not in grouping file (appended last): {unlisted}")
    return (
        df.assign(_pos=key)
        .sort_values("_pos", kind="stable")
        .drop(columns="_pos")
        .reset_index(drop=True)
    )


def sum_formula(column: str, rows: list[int]) -> str:
    runs: list[list[int]] = []
    for row in sorted(rows):
        if runs and row == runs[-1][1] + 1:
            runs[-1][1] = row
        else:
            runs.append([row, row])
    return "=SUM(" + ",".join(
        f"{column}{a}:{column}{b}" if a != b else f"{column}{a}"
        for a, b in runs
    ) + ")"


def plan_rows(dataframe, first_row, grouping):
    """-> (sheet row per df row, [(total_row, label, member_rows)], grand_total_row).
    A Groups entry can be a TB account, a Grouping Total (computed row), or both.
    Both parts are handled independently. Totals can nest to any depth."""
    idx: dict[str, list[int]] = {}
    for i, name in enumerate(dataframe[ACCOUNT_GROUP_COLUMN]):
        idx.setdefault(_norm_2(name), []).append(i)
    labels = {_norm_2(t) for t, _ in grouping if t}

    detail_rows = [0] * len(dataframe)
    placed, blocks, row = set(), [], first_row

    for total, items in groupby(grouping, key=lambda x: x[0]):
        t_norm, own, kids = _norm_2(total), [], []
        for _, g in items:
            n = _norm_2(g)
            for i in idx.get(n, []):                     # 1) actual TB account
                if i not in placed:
                    detail_rows[i] = row
                    placed.add(i)
                    own.append(row)
                    row += 1
            if n in labels and n != t_norm and n not in kids:   # 2) grouping total
                kids.append(n)
        if total and (own or kids):
            blocks.append((row, total, own, kids))
            row += 2                                     # total row + blank row

    for i in range(len(dataframe)):                      # groups not in grouping file
        if i not in placed:
            detail_rows[i] = row
            row += 1

    names = [_norm_2(label) for _, label, _, _ in blocks]
    repeated = sorted({n for n in names if names.count(n) > 1})
    if repeated:
        print(f"WARNING Grouping Total split into separate runs (keep rows together): {repeated}")

    where = {_norm_2(label): r for r, label, _, _ in blocks}
    unresolved = sorted({k for *_, kids in blocks for k in kids if k not in where})
    if unresolved:
        print(f"WARNING subtotal references with no rows (skipped in parent): {unresolved}")

    totals = [
        (r, label, list(dict.fromkeys(own + [where[k] for k in kids if k in where])))
        for r, label, own, kids in blocks
    ]
    return detail_rows, totals, row


def _selfcheck() -> None:
    # subtotal inside subtotal
    grouping = [("T1", "A"), ("T1", "B"), ("T1", "C"), ("T2", "D"), ("T2", "T1")]
    df = pd.DataFrame({ACCOUNT_GROUP_COLUMN: ["A", "B", "C", "D", "E"]})
    rows, totals, grand = plan_rows(df, 14, grouping)
    assert rows == [14, 15, 16, 19, 22] and grand == 23
    assert totals == [(17, "T1", [14, 15, 16]), (20, "T2", [19, 17])]
    assert sum_formula("C", [19, 17]) == "=SUM(C17,C19)"
    assert sum_formula("C", [14, 15, 17, 18, 20]) == "=SUM(C14:C15,C17:C18,C20)"

    # equity side: three levels, self-named rows, repeated child
    grouping = [
        ("OCI", "Pension"), ("Treasury Stock", "Treasury Stock"), ("APIC", "APIC"),
        ("Total Equity", "OCI"), ("Total Equity", "Treasury Stock"),
        ("Total Equity", "APIC"), ("Total Equity", "Common Stock"),
        ("Total Equity", "OCI"),
        ("TL", "Payable"),
        ("TLSE", "Total Equity"), ("TLSE", "TL"),
    ]
    df = pd.DataFrame({ACCOUNT_GROUP_COLUMN:
                       ["Pension", "Treasury Stock", "APIC", "Common Stock", "Payable"]})
    rows, totals, grand = plan_rows(df, 14, grouping)
    assert rows == [14, 17, 20, 23, 26] and grand == 31
    assert totals == [
        (15, "OCI", [14]), (18, "Treasury Stock", [17]), (21, "APIC", [20]),
        (24, "Total Equity", [23, 15, 18, 21]),
        (27, "TL", [26]), (29, "TLSE", [24, 27]),
    ]

    # name is BOTH a TB account and a grouping total: account row AND subtotal both roll up
    for parent in ([("P", "X"), ("P", "B")], [("P", "X"), ("P", "X"), ("P", "B")]):
        grouping = [("X", "A")] + parent
        df = pd.DataFrame({ACCOUNT_GROUP_COLUMN: ["A", "X", "B"]})
        rows, totals, grand = plan_rows(df, 14, grouping)
        assert rows == [14, 17, 18] and grand == 21
        assert totals == [(15, "X", [14]), (19, "P", [17, 18, 15])]

    # punctuation / spacing / case never break a match
    assert _norm_2("Gains / Losses  / Impairments") == _norm_2("gains/losses/impairments")
    assert _norm_2("Common Stock") == _norm_2("COMMON-STOCK")

    # orphan subtotal between two siblings is adopted by their parent
    g = adopt_orphans(
        (("FX", "FX"), ("EQ", "EQ"), ("G", "G"), ("EBT", "FX"), ("EBT", "G"))
    )
    assert ("EBT", "EQ") in g
    df = pd.DataFrame({ACCOUNT_GROUP_COLUMN: ["FX", "EQ", "G"]})
    _, totals, _ = plan_rows(df, 14, g)
    assert sorted([t for t in totals if t[1] == "EBT"][0][2]) == [15, 18, 21]


def apply_conditional_formatting(
    worksheet,
    comparisons: list[ComparisonBlock],
    first_row: int,
    last_row: int,
) -> None:
    # No reset here: stacked sections share one sheet. write_summary_sheet resets once.
    for comparison in comparisons:
        for row in range(first_row, last_row + 1):
            reference = f"{comparison.flag_column}{row}"
            formula = f'{absolute_coordinate(reference)}="{YES_VALUE}"'
            rule = FormulaRule(formula=[formula], stopIfTrue=True)
            rule.dxf = YES_FILL
            rule.priority = 1
            worksheet.conditional_formatting.add(reference, rule)


def shift_range(rng: str, top: int) -> str:
    """'B6:M8' -> same columns, first row = top, height kept."""
    left, right = rng.split(":")
    row_a, row_b = (int(re.sub(r"\D", "", part)) for part in (left, right))
    col_a, col_b = (re.sub(r"\d+", "", part) for part in (left, right))
    return f"{col_a}{top}:{col_b}{top + row_b - row_a}"


def put_banner(worksheet, row: int, text: str, last_column: int) -> None:
    for column in range(2, last_column + 1):
        put_rc(
            worksheet, row, column, text if column == 2 else None,
            font=SECTION_FONT, fill=SECTION_FILL, alignment=LEFT_ALIGN,
        )
    worksheet.row_dimensions[row].height = 20


def write_summary_sheet(
    worksheet,
    config: SheetConfig,
    dataframe: pd.DataFrame,
    display_roles: dict[str, str],
    comparisons: list[ComparisonBlock],
    grouping,
    below: int | None = None,
    banner: str | None = None,
) -> int:
    """Write one analytics section. below=None -> first section on the sheet
    (clears sheet, writes title + materiality). below=row -> stacked under that
    row, reusing the sheet's materiality cells. Returns the section's total row."""
    stacked = below is not None

    if stacked:
        banner_row = below + YTD_GAP_ROWS
        procedure_row = banner_row + 2
        block_row = procedure_row + 4
    else:
        banner_row = 9
        procedure_row = 6
        block_row = SUMMARY_BLOCK_ROW
    header_row = block_row + 1
    first_row = header_row + 1 if stacked else config.first_data_row

    # ---- first section only: wipe template, title, shared materiality -------
    if not stacked:
        for merged_range in list(worksheet.merged_cells.ranges):
            if (
                merged_range.min_row == block_row
                or merged_range.max_row >= first_row
            ):
                worksheet.unmerge_cells(str(merged_range))

        for row in worksheet.iter_rows(
            min_row=first_row,
            max_row=max(worksheet.max_row, first_row),
            min_col=2,
            max_col=config.max_data_column,
        ):
            for cell in row:
                cell.value = None

        for row in (block_row, header_row):
            for column in range(2, config.max_data_column + 1):
                worksheet.cell(row=row, column=column).value = None

        worksheet.sheet_view.showGridLines = False
        worksheet.conditional_formatting._cf_rules = {}
        for row in range(2, 5):
            for column in range(3, 10):  # C:I
                worksheet.cell(row=row, column=column).value = None

        put(worksheet, "B1", CLIENT_NAME, font=BOLD_FONT)
        put(worksheet, "B2", config.subtitle, font=BOLD_FONT)
        put(worksheet, "B3", PERIOD_LABEL, font=BOLD_FONT)

        put(worksheet, f"{config.materiality_label_column}2",
            "Materiality", font=BOLD_FONT)
        put(worksheet, f"{config.materiality_label_column}3",
            "Threshold (in $)", font=BOLD_FONT)
        put(worksheet, f"{config.materiality_label_column}4",
            "Threshold (in %)", font=BOLD_FONT)
        put(worksheet, f"{config.materiality_value_column}2",
            MATERIALITY, font=BOLD_FONT, fill=RED_HIGHLIGHT_FILL,
            number_format=NUMBER_FORMAT)
        put(worksheet, f"{config.materiality_value_column}3",
            THRESHOLD_DOLLARS, font=BOLD_FONT, fill=RED_HIGHLIGHT_FILL,
            number_format=NUMBER_FORMAT)
        put(worksheet, f"{config.materiality_value_column}4",
            THRESHOLD_PERCENT, font=BOLD_FONT, fill=RED_HIGHLIGHT_FILL,
            number_format=PERCENT_FORMAT)

    # ---- section indicator ----------------------------------------------------
    if banner:
        put_banner(worksheet, banner_row, banner, BANNER_LAST_COLUMN)
    if stacked:
        target = f"'{worksheet.title}'!B{banner_row}"
        put(worksheet, "B4", f'=HYPERLINK("#{target}","Jump to YTD section >>")',
            font=LINK_FONT)

    # ---- procedure box --------------------------------------------------------
    put(
        worksheet, f"B{procedure_row}", PROCEDURE_TEXT,
        font=NORMAL_FONT, fill=PROCEDURE_FILL, alignment=LEFT_WRAP,
    )
    worksheet.merge_cells(shift_range(config.procedure_merge_range, procedure_row))

    # ---- column headers -------------------------------------------------------
    put(
        worksheet, f"B{header_row}",
        "Account Description",
        font=HEADER_FONT, fill=HEADER_FILL,
        border=THIN_BORDER, alignment=CENTER_WRAP,
    )
    for role, col in config.role_to_excel_column.items():
        put(
            worksheet, f"{col}{header_row}",
            f"{config.header_prefix}{display_roles[role]}",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )

    for item in comparisons:
        put(
            worksheet, f"{item.dollar_column}{block_row}",
            f"{config.header_prefix}{display_roles[item.current_role]} vs "
            f"{config.header_prefix}{display_roles[item.comparison_role]}",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        worksheet.merge_cells(shift_range(item.merge_range, block_row))

        put(
            worksheet, f"{item.dollar_column}{header_row}",
            "$ Variance",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        put(
            worksheet, f"{item.percent_column}{header_row}",
            "% Variance",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        put(
            worksheet, f"{item.flag_column}{header_row}",
            "Further explain at\nLE level?",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        if item.yes_list_column:
            put(
                worksheet, f"{item.yes_list_column}{header_row}",
                "Accounts Flagged\n(Yes)",
                font=HEADER_FONT, fill=YES_HEADER_FILL,
                border=THIN_BORDER, alignment=CENTER_WRAP,
            )

    put(
        worksheet, f"{config.tickmark_column}{header_row}",
        "Tickmark",
        font=HEADER_FONT, fill=HEADER_FILL,
        border=THIN_BORDER, alignment=CENTER_WRAP,
    )

    worksheet.row_dimensions[block_row].height = 30
    worksheet.row_dimensions[header_row].height = 42

    # ---- detail rows ----------------------------------------------------------
    detail_rows, totals, total_row = plan_rows(dataframe, first_row, grouping)
    last_data_row = total_row - 1

    for row_number, (_, source_row) in zip(detail_rows, dataframe.iterrows()):
        put(
            worksheet, f"B{row_number}",
            source_row[ACCOUNT_GROUP_COLUMN],
            font=NORMAL_FONT, alignment=LEFT_ALIGN,
        )

        for role, column in config.role_to_excel_column.items():
            put(
                worksheet,
                f"{column}{row_number}",
                float(source_row[display_roles[role]]),
                font=NORMAL_FONT,
                alignment=RIGHT_ALIGN,
                number_format=NUMBER_FORMAT,
            )

        write_variance_cells(
            worksheet,
            variance_formulas(row_number, config, comparisons),
            comparisons,
            NORMAL_FONT,
        )

        put(
            worksheet, f"{config.tickmark_column}{row_number}",
            None, font=RED_BOLD_FONT, alignment=CENTER_ALIGN,
        )
        worksheet.row_dimensions[row_number].height = 18

    # ---- group total rows -----------------------------------------------------
    skip_cols = config.spacer_columns | {
        column_index_from_string(item.yes_list_column)
        for item in comparisons if item.yes_list_column
    }
    subtotal_rows = {sub_row for sub_row, _, _ in totals}
    spacer_rows = {sub_row + 1 for sub_row in subtotal_rows}

    for sub_row, label, members in totals:
        for col in range(2, config.max_data_column + 1):
            if col not in skip_cols:
                worksheet.cell(row=sub_row, column=col).border = SUBTOTAL_BORDER
        put(
            worksheet, f"B{sub_row}", label,
            font=BOLD_FONT, fill=PROCEDURE_FILL, alignment=LEFT_ALIGN,
        )
        for column in config.role_to_excel_column.values():
            put(
                worksheet, f"{column}{sub_row}",
                sum_formula(column, members) if members else 0,
                font=BOLD_FONT, fill=PROCEDURE_FILL,
                alignment=RIGHT_ALIGN, number_format=NUMBER_FORMAT,
            )
        worksheet.row_dimensions[sub_row].height = 18

    # ---- Accounts Flagged (Yes): one merged cell + array formula per block ---
    if len(dataframe):
        for item in comparisons:
            col = item.yes_list_column
            if not col:
                continue
            flag_range = (
                f"{item.flag_column}{first_row}:{item.flag_column}{last_data_row}"
            )
            cell = worksheet[f"{col}{first_row}"]
            cell.value = ArrayFormula(
                f"{col}{first_row}",
                f'=_xlfn.TEXTJOIN(CHAR(10),TRUE,IF({flag_range}="{YES_VALUE}",'
                f'$B${first_row}:$B${last_data_row},""))',
            )
            cell.font = NORMAL_FONT
            cell.border = THIN_BORDER
            cell.alignment = Alignment(
                wrap_text=True, vertical="top", horizontal="left"
            )
            worksheet.merge_cells(f"{col}{first_row}:{col}{last_data_row}")

    # ---- grand total row ------------------------------------------------------
    put(
        worksheet, f"B{total_row}", config.total_label,
        font=BOLD_FONT, border=TOTAL_BORDER, alignment=LEFT_ALIGN,
    )

    for column in config.role_to_excel_column.values():
        value = sum_formula(column, detail_rows) if detail_rows else 0
        put(
            worksheet, f"{column}{total_row}", value,
            font=BOLD_FONT, border=TOTAL_BORDER,
            alignment=RIGHT_ALIGN, number_format=NUMBER_FORMAT,
        )

    write_variance_cells(
        worksheet,
        variance_formulas(total_row, config, comparisons),
        comparisons,
        BOLD_FONT,
        TOTAL_BORDER,
    )

    for item in comparisons:
        if item.yes_list_column:
            put(
                worksheet, f"{item.yes_list_column}{total_row}",
                None, font=BOLD_FONT, border=TOTAL_BORDER,
                alignment=CENTER_ALIGN,
            )

    put(
        worksheet, f"{config.tickmark_column}{total_row}",
        None, font=BOLD_FONT, border=TOTAL_BORDER,
        alignment=CENTER_ALIGN,
    )

    # ---- borders, filter (first section only), conditional formatting --------
    for row in worksheet.iter_rows(
        min_row=first_row,
        max_row=total_row,
        min_col=2,
        max_col=config.max_data_column,
    ):
        if row[0].row in subtotal_rows or row[0].row in spacer_rows:
            continue
        for cell in row:
            if cell.column not in config.spacer_columns and cell.border == Border():
                cell.border = THIN_BORDER

    if not stacked:  # one auto-filter per sheet: QTD / first section only
        worksheet.auto_filter.ref = f"B{header_row}:{config.tickmark_column}{total_row}"
    apply_conditional_formatting(worksheet, comparisons, first_row, total_row)

    return total_row

# ============================================================================
# WORKBOOK ORCHESTRATION
# ============================================================================

def load_template(path: str | Path):
    return cp.openpyxl.read(str(path))


def save_template(workbook, path: str | Path) -> None:
    cp.openpyxl.write(workbook, str(path), register=True)


def merge_is_sheets(workbook) -> None:
    """Template has separate QTD / YTD IS sheets. Keep one."""
    old_qtd, old_ytd = "2) Income Statement QTD", "3) Income Statement YTD"
    if IS_SHEET not in workbook.sheetnames and old_qtd in workbook.sheetnames:
        workbook[old_qtd].title = IS_SHEET
    if old_ytd in workbook.sheetnames:
        del workbook[old_ytd]


def run(
    template_path: str | Path,
    output_directory: str | Path,
    sources: dict[str, Any],
    groupings: dict[str, Any],
) -> None:
    _selfcheck()
    configs = build_sheet_configs()
    workbook = load_template(template_path)
    merge_is_sheets(workbook)

    missing_sheets = [
        config.output_sheet
        for config in configs
        if config.output_sheet not in workbook.sheetnames
    ]
    if missing_sheets:
        raise KeyError(
            f"Missing required template worksheets: {missing_sheets}"
        )

    summaries = []
    end_rows: dict[str, int] = {}   # sheet -> last total row written (for stacking)

    for config in configs:
        print(f"\nPreparing {config.sheet_id}...")

        grouping = read_grouping(
            groupings[config.grouping_sheet],
            GROUPING_NAMES[config.grouping_sheet],
        )
        dataframe, display_roles, raw_roles, raw_df = prepare_data(
            config, sources, grouping
        )
        comparisons = (
            active_blocks(config, raw_roles)
            if config.classifier == "bs"
            else list(config.comparison_blocks)
        )

        end_rows[config.output_sheet] = write_summary_sheet(
            workbook[config.output_sheet],
            config,
            dataframe,
            display_roles,
            comparisons,
            grouping,
            below=end_rows.get(config.output_sheet),
            banner=SECTION_BANNERS.get(config.sheet_id),
        )

        render_legal_entity_sheets(
            workbook,
            config,
            dataframe,
            display_roles,
            raw_roles,
            raw_df,
            comparisons,
        )

        summaries.append({
            "sheet": config.output_sheet,
            "rows": len(dataframe),
            "comparisons": [item.merge_range for item in comparisons],
            "periods": display_roles,
        })

    try:
        workbook.calculation.fullCalcOnLoad = True
        workbook.calculation.forceFullCalc = True
    except AttributeError:
        pass

    output_path = Path(output_directory)
    output_path.mkdir(parents=True, exist_ok=True)
    output_file = output_path / OUTPUT_FILE_NAME
    save_template(workbook, output_file)

    print("\nAll sheets written successfully.")
    print(f"Output: {output_file}")
    for summary in summaries:
        print(f"{summary['sheet']}: {summary['rows']} accounts")
        print(f"Comparisons: {summary['comparisons']}")
        print(f"Periods: {summary['periods']}")


def main() -> None:
    # Runtime inputs remain external; this script only processes them.
    runtime = globals()
    required_names = (
        "TEMPLATE_PATH", "OUTPUT_DIRECTORY", *GROUPING_NAMES.values(), *INPUT_NAMES
    )
    missing = [name for name in required_names if runtime.get(name) is None]

    if missing:
        raise RuntimeError(
            "Define these runtime inputs before calling main(): "
            + ", ".join(missing)
        )

    run(
        template_path=runtime["TEMPLATE_PATH"],
        output_directory=runtime["OUTPUT_DIRECTORY"],
        sources={
            "TB_Final_BS": runtime["TB_Final_BS"],
            "TB_Final_IS_YTD": runtime["TB_Final_IS_YTD"],
            "TB_Final_QTD": runtime["TB_Final_QTD"],
        },
        groupings={key: runtime[name] for key, name in GROUPING_NAMES.items()},
    )


if __name__ == "__main__":
    main()
