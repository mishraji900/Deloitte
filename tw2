from decimal import Decimal, InvalidOperation


# GREY_MARKER: sentinel string written into a Spark cell wherever the source Excel
# cell was blue-flagged. It is how "this was a manual override" survives the trip
# through Spark (which cannot carry font color). Produced by replace_spark_cells;
# consumed by every downstream grey/deemed-significant check.
GREY_MARKER = "__grey__"


def is_grey_marker(value) -> bool:
    """
    WHAT: True if `value` is the grey/blue-override sentinel (case-insensitive).
    CALLED BY: to_decimal, to_excel_number, and each section's grey checks
               (aliased later as s3a_is_grey_marker, _is_grey).
    """
    # HOW IT WORKS: guard first (isinstance) so non-strings short-circuit and never
    # hit the string methods. strip() removes surrounding whitespace, casefold() does
    # an aggressive lowercase for a case-insensitive compare against the sentinel.
    return isinstance(value, str) and value.strip().casefold() == GREY_MARKER


def to_decimal(value):
    """
    WHAT: Universal READ parser — turn any raw cell value into a Decimal (or None).
          Handles ints/floats/Decimals, Spark Row values, "$1,234", "12.5%",
          "(500)" negatives, "-"/em-dash blanks, NaN, and the grey marker.
    CALLED BY: virtually every section. Aliased later as _to_decimal, s3a_to_decimal, _to_dec.
    OUTPUT FLOW: its Decimal result feeds all arithmetic (mean/median/ratios) and
          every "is this numeric / non-zero?" decision.
    """
    # EARLY REJECTS: None, actual booleans (True/False would otherwise coerce to 1/0),
    # and the grey override sentinel all mean "no usable number here" -> None.
    if value is None or isinstance(value, bool) or is_grey_marker(value):
        return None
    # Already a Decimal: keep it, but drop non-finite values (Infinity / NaN) as None.
    if isinstance(value, Decimal):
        return value if value.is_finite() else None

    # Fast path for genuine numeric types.
    # Accepts int/float directly, plus anything float-castable (e.g. numpy scalars,
    # Spark numeric types) via the __float__ protocol — avoids the slower text parse below.
    if isinstance(value, (int, float)) or hasattr(value, "__float__"):
        try:
            numeric_value = float(value)
        except (ValueError, TypeError, OverflowError):
            # Anything that claims to be float-able but fails is treated as "not numeric".
            numeric_value = None
        if numeric_value is not None:
            if numeric_value != numeric_value:   # NaN check (NaN != NaN)
                return None
            # Round to 10 dp to kill float binary-representation noise, then go through
            # str() so Decimal is built from the clean decimal text (not the noisy binary float).
            decimal_value = Decimal(str(round(numeric_value, 10)))
            return decimal_value if decimal_value.is_finite() else None

    # Text path for "$1,234.56", "12.5%", "(500)" etc.
    # NOTE: percent handling here only STRIPS the sign — "12.5%" becomes Decimal(12.5),
    # it is NOT divided by 100. Anything below is best-effort cleanup of formatted text.
    try:
        text = str(value).replace(",", "").replace("$", "").strip()  # drop thousands separators + currency symbol
        if text.endswith("%"):
            text = text[:-1].strip()                                 # trailing percent sign removed
        if text.startswith("(") and text.endswith(")"):     # accounting negative
            text = "-" + text[1:-1]                                  # "(500)" -> "-500"
        if text in {"", "-", "\u2014", GREY_MARKER}:          # blank / dash / marker -> None
            return None
        decimal_value = Decimal(text)                                # final parse attempt
        return decimal_value if decimal_value.is_finite() else None
    except (InvalidOperation, ValueError, TypeError):
        # Un-parseable text (letters, stray symbols, etc.) falls through to None.
        return None


def to_excel_number(value):
    """
    WHAT: WRITE-side counterpart to to_decimal — normalise a value for writing into
          an openpyxl cell (Decimal->float, grey marker->None, else passthrough).
    CALLED BY: Section 3 (aliased _num) and Section 3b when placing CY/PY values.
    """
    # None and the grey sentinel both become an empty/blank cell (None) on write.
    if value is None:
        return None
    if is_grey_marker(value):
        return None
    # openpyxl stores plain floats cleanly; Decimal is converted so Excel sees a real number.
    if isinstance(value, Decimal):
        return float(value)
    # Non-Decimal, non-marker values (str, int, float, etc.) are written through unchanged.
    return value


def normalize_text(value) -> str:
    """
    WHAT: Whitespace-collapsed, case-folded key used for ACCOUNT-NAME matching.
    CALLED BY: account lookups in Sections 3/3a/3b (aliased s3a_normalize, _norm).
    OUTPUT FLOW: becomes dict keys that join CY<->PY and cross-reference Tab-2 rows.
    """
    # Missing name -> empty key (still a valid, comparable dict key).
    if value is None:
        return ""
    # HOW IT WORKS (inside-out): replace non-breaking spaces (\u00a0) with normal spaces,
    # strip the ends, split() on any run of whitespace into tokens, then " ".join back —
    # this collapses tabs/newlines/double-spaces into single spaces. casefold() makes the
    # key case-insensitive so "Cash & Equivalents" and "cash & equivalents" match.
    return " ".join(str(value).replace("\u00a0", " ").strip().split()).casefold()

