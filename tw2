def write_sheet1_summary(
    ws,
    df: pd.DataFrame,
    acct_group: str,
) -> dict:
    """Write the Sheet 1 summary, comparison, and materiality tables."""

    layout = layout_config()
    detail_layout = layout["sheet1_detail"]
    data_cfg = data_config()

    apply_white_background(
        ws,
        n_rows=len(df) + 100,
        n_cols=layout["background"]["sheet1_columns"],
    )

    ws.sheet_properties.outlinePr = Outline(
        summaryBelow=True,
        summaryRight=False,
    )

    write_sheet_header(ws, acct_group, "summary")

    header_row = detail_layout["header_row"]
    label_column = detail_layout["label_column"]
    balance_start_column = detail_layout["balance_start_column"]
    fluctuation_start_column = detail_layout["fluctuation_start_column"]

    for index, column_name in enumerate(balance_columns()):
        write_cell(
            ws,
            header_row,
            balance_start_column + index,
            column_name,
            font=HDR_FONT,
            align=RIGHT,
        )

    for index, column_name in enumerate(fluctuation_columns()):
        write_cell(
            ws,
            header_row,
            fluctuation_start_column + index,
            column_name,
            font=HDR_FONT,
            align=RIGHT,
        )

    row = detail_layout["first_data_row"]
    group_totals = {}

    group_column = data_cfg["group_column"]
    account_column = data_cfg["account_column"]

    # Preserve the source order while processing each reporting group.
    for group_name, df_group in df.groupby(group_column, sort=False):
        write_cell(
            ws,
            row,
            label_column,
            group_name,
            font=BOLD,
            align=LEFT,
        )

        row += 1
        first_detail_row = row

        for _, source_row in df_group.iterrows():
            write_cell(
                ws,
                row,
                label_column,
                source_row[account_column],
                font=NORMAL,
                align=LEFT,
            )

            for index, column_name in enumerate(balance_columns()):
                write_cell(
                    ws,
                    row,
                    balance_start_column + index,
                    source_row[column_name],
                    font=NORMAL,
                    fmt=REPORT_CONFIG["formatting"]["million_format"],
                    align=RIGHT,
                )

            for index, column_name in enumerate(fluctuation_columns()):
                write_cell(
                    ws,
                    row,
                    fluctuation_start_column + index,
                    source_row[column_name],
                    font=NORMAL,
                    fmt=REPORT_CONFIG["formatting"]["million_format"],
                    align=RIGHT,
                )

            row += 1

        last_detail_row = row - 1

        # Aggregate every numeric source column to create the group subtotal.
        subtotals = {
            column_name: df_group[column_name].sum()
            for column_name in numeric_columns()
        }

        group_totals[group_name] = subtotals

        write_cell(
            ws,
            row,
            label_column,
            f"Total {group_name}",
            font=BOLD,
            border=THIN_TB,
            align=LEFT,
        )

        for index, column_name in enumerate(balance_columns()):
            write_cell(
                ws,
                row,
                balance_start_column + index,
                subtotals[column_name],
                font=BOLD,
                border=THIN_TB,
                fmt=REPORT_CONFIG["formatting"]["million_format"],
                align=RIGHT,
            )

        for index, column_name in enumerate(fluctuation_columns()):
            write_cell(
                ws,
                row,
                fluctuation_start_column + index,
                subtotals[column_name],
                font=BOLD,
                border=THIN_TB,
                fmt=REPORT_CONFIG["formatting"]["million_format"],
                align=RIGHT,
            )

        row += 1

        detail_count = last_detail_row - first_detail_row + 1
        collapse_threshold = data_cfg["group_collapse_threshold"]
        visible_rows = data_cfg["visible_detail_rows"]

        # Hide excess account detail while leaving the configured number visible.
        if detail_count > collapse_threshold:
            for detail_row in range(
                first_detail_row,
                min(first_detail_row + visible_rows, last_detail_row + 1),
            ):
                ws.row_dimensions[detail_row].outline_level = 0
                ws.row_dimensions[detail_row].hidden = False

            for detail_row in range(
                first_detail_row + visible_rows,
                last_detail_row + 1,
            ):
                ws.row_dimensions[detail_row].outline_level = 1
                ws.row_dimensions[detail_row].hidden = True

    # Aggregate the complete filtered dataset for the account-group grand total.
    grand_totals = {
        column_name: df[column_name].sum()
        for column_name in numeric_columns()
    }

    write_cell(
        ws,
        row,
        label_column,
        f"Total {acct_group}",
        font=BOLD,
        border=MED_TB,
        align=LEFT,
    )

    for index, column_name in enumerate(balance_columns()):
        write_cell(
            ws,
            row,
            balance_start_column + index,
            grand_totals[column_name],
            font=BOLD,
            border=MED_TB,
