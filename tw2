        pf = [c for c in front if c in df.columns]
        return df.select(*(pf + [c for c in df.columns if c not in pf])).pandas_api()

    cp.pandas.to_excel(dataframes=[prep(d) for d in sheets.values()], sheet_names=list(sheets.keys()), path=path)
