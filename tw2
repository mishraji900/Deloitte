@dataclass
class RowDef:
    """
    row_key   – unique id; Rx rows reference others by this key.
    row_type  – SIGMA | RX | PY | SUBTITLE | BLANK | TOTAL
    codes     – grouping codes to sum for SIGMA rows (e.g. ["D","E"])
    label     – text shown in the References column
    rx_terms  – [(row_key_or_single_code, sign)] for RX / TOTAL rows
    bold      – bold the label text
    py_ref    – annotation shown in Grouping Code col for PY rows
    """
    row_key:  str
    row_type: str
    codes:    list[str]            = field(default_factory=list)
    label:    str                  = ""
    rx_terms: list[tuple[str,int]] = field(default_factory=list)
    bold:     bool                 = False
    py_ref:   str                  = ""


@dataclass
class TableDef:
    """
    title       – centred header band text
    col_variant – "4col" (YTD+QTD) or "2col" (YTD only)
    rows        – ordered list of RowDef
    """
    title:       str
    col_variant: str          # "4col" | "2col"
    rows:        list[RowDef]


