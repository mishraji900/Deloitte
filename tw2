# 9-H  Sub-table writer  (FN9 / FN10 / FN12 internal mini-tables)
#      Replaces the simple SUBTITLE row with a full re-header band
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class SubTableDef:
    """
    A mini repeating header block inside a parent table section.
    rows       – RowDef list belonging to this sub-block
    col_variant– inherited from parent table
    """
    rows:        list[RowDef]
    col_variant: str


def _write_sub_header(ws, row: int, col_variant: str):
    """
    Mini re-header block: two rows consumed.
    Row 0 = column labels  (Grouping Code spans B+C)
    Row 1 = source tags    (Tab 1 / Rx)
    """
    hdr_row = row
    tag_row = row + 1
    ws.row_dimensions[hdr_row].height = 22
    ws.row_dimensions[tag_row].height = 14

    def _hdr(start_c, end_c, text, red=False):
        if start_c != end_c:
            ws.merge_cells(
                start_row=hdr_row, start_column=start_c,
                end_row=hdr_row,   end_column=end_c,
            )
        c = ws.cell(row=hdr_row, column=start_c, value=text)
        c.font      = FONT_HDR_RED if red else FONT_HDR_BLACK
        c.fill      = FILL_LIGHT_GREY
        c.alignment = ALIGN_CTR_WRAP
        _apply_range_border(ws, hdr_row, start_c, hdr_row, end_c)

    def _tag(col, text, red=False):
        c = ws.cell(row=tag_row, column=col, value=text)
        c.font      = FONT_HDR_RED if red else FONT_HDR_BLACK
        c.fill      = FILL_LIGHT_GREY
        c.alignment = ALIGN_CTR
        _apply_range_border(ws, tag_row, col, tag_row, col)

    # FIX Issue 1: "Grouping code" spans B+C in sub-headers too
    _hdr(S3_COL_SYMBOL, S3_COL_CODE, "Grouping code")
    _hdr(S3_COL_REF,    S3_COL_REF,  "Reference")
    _hdr(S3_COL_YTD_BAL, S3_COL_YTD_BAL,
         "YTD 3/31/26\nBalances (in millions)")
    _hdr(S3_COL_YTD_RND, S3_COL_YTD_RND,
         "Rounded\n(In millions)", red=True)

    _tag(S3_COL_YTD_BAL, "Tab 1")
    _tag(S3_COL_YTD_RND, "Rx", red=True)

    if col_variant == "4col":
        _hdr(S3_COL_QTD_BAL, S3_COL_QTD_BAL,
             "QTD 3/31/26\nBalances (in millions)")
        _hdr(S3_COL_QTD_RND, S3_COL_QTD_RND,
             "QTD Rounded\n(In millions)", red=True)
        _tag(S3_COL_QTD_BAL, "Tab 1 & Tab 2")
        _tag(S3_COL_QTD_RND, "Rx", red=True)



