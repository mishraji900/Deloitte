def read_tab12(workbook, sheet_name, with_calc):
    ws = workbook[sheet_name]
    header_row, start_col = coordinate_to_tuple(TABLE_ANCHOR_CELL)
    end_row = last_data_row(ws)
    headers, end_col = {}, start_col
    for c in range(start_col, ws.max_column + 1):
        v = ws.cell(row=header_row, column=c).value
        if v is not None:
            headers[normalize_text(v)] = c
            end_col = c
    acct_c = headers.get(normalize_text(ACCOUNT_COLUMN))
    cons_c = headers.get(normalize_text(CONSOLIDATED_COLUMN))
    unt_c = headers.get(normalize_text(UNTESTED_COLUMN))
    ent_c = [headers[normalize_text(c)] for c in T12_ENTITY_COLS if normalize_text(c) in headers]
    calc_c = {c: headers[normalize_text(c)] for c in CALCULATED_COLUMNS if normalize_text(c) in headers} if with_calc else {}
    detail_labels = {normalize_text(ENTITY_PERCENT_DETAIL_LABEL), normalize_text(ENTITY_MULTIPLE_DETAIL_LABEL)}
    grey_tail, blue_tail = GREYED_OUT_FONT_COLOR[-6:], BLUE_FONT_COLOR[-6:]

    out = {"tally": {"count": 0, "consolidated": ZERO, "untested": ZERO, "entity": ZERO},
           "greyed": 0, "detail": 0, "leaks": 0, "blue": 0, "sequence": [],
           "formulas": {c: 0 for c in calc_c}, "entity_cols_found": len(ent_c)}
    if acct_c is None or cons_c is None or unt_c is None:
        return out   # header problem -> every check below will FAIL

    for r in range(header_row + 1, end_row + 1):
        acct = ws.cell(row=r, column=acct_c)
        label = normalize_text(acct.value)
        if label in detail_labels:
            out["detail"] += 1
            continue
        if font_rgb(acct).endswith(grey_tail):   # greyed-out account font = excluded row
            out["greyed"] += 1
            out["sequence"].append(("greyed", label))
            out["leaks"] += sum(1 for c in range(start_col, end_col + 1)
                                if c != acct_c and ws.cell(row=r, column=c).value is not None)
            continue
        out["sequence"].append(("visible", label))
        t = out["tally"]
        t["count"] += 1
        t["consolidated"] += dec(ws.cell(row=r, column=cons_c).value)
        t["untested"] += dec(ws.cell(row=r, column=unt_c).value)
        t["entity"] += sum((dec(ws.cell(row=r, column=c).value) for c in ent_c), ZERO)
        out["blue"] += sum(1 for c in range(start_col, end_col + 1)
                           if font_rgb(ws.cell(row=r, column=c)).endswith(blue_tail))
        for name, c in calc_c.items():
            if has_formula(ws.cell(row=r, column=c).value): out["formulas"][name] += 1
    return out

def read_tab3(workbook):
