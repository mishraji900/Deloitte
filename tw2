def dec(value):
    return to_decimal(value) or ZERO

def has_name(value):
    return value is not None and str(value).strip() != ""

def has_formula(value):
    return isinstance(value, ArrayFormula) or (isinstance(value, str) and value.startswith("="))

def font_rgb(cell):
    rgb = getattr(cell.font.color, "rgb", None) if cell.font is not None else None
    return rgb.upper() if isinstance(rgb, str) else ""

def last_data_row(ws):
    ref = ws.auto_filter.ref
    return range_boundaries(ref)[3] if ref else ws.max_row

def merged_aware_value(ws, coordinate):
    for merged_range in ws.merged_cells.ranges:
        if coordinate in merged_range:
            coordinate = merged_range.coord.split(":", 1)[0]
            break
    return ws[coordinate].value

def tally(rows, entity_cols):
    t = {"count": 0, "consolidated": ZERO, "untested": ZERO, "entity": ZERO}
    for r in rows:
        t["count"] += 1
        t["consolidated"] += dec(r.get(CONSOLIDATED_COLUMN))
        t["untested"] += dec(r.get(UNTESTED_COLUMN))
        t["entity"] += sum((dec(r.get(c)) for c in entity_cols), ZERO)
    return t

def add_t(a, b):
    return {k: a[k] + b[k] for k in a}

def cnt_sum(rows):
    return len(rows), sum((dec(r.get(UNTESTED_COLUMN)) for r in rows), ZERO)

def sequence_mismatches(expected, written):
    n = max(len(expected), len(written))
    return sum(1 for i in range(n)
               if (expected[i] if i < len(expected) else None) != (written[i] if i < len(written) else None))

