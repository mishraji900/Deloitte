    tickmark_column: str
    materiality_label_column: str
    materiality_value_column: str
    procedure_merge_range: str
    column_widths: dict[str, int]
    classifier: str
    all_comparison_blocks: tuple[ComparisonBlock, ...] | None = None

    def __post_init__(self) -> None:
        # If no separate block list is supplied, use all comparison blocks.
        if self.all_comparison_blocks is None:
            self.all_comparison_blocks = self.comparison_blocks


def block(
    merge_range: str,
    dollar_column: str,
    percent_column: str,
    flag_column: str,
    current_role: str,
    comparison_role: str,
    yes_list_column: str = "",  
) -> ComparisonBlock:
    return ComparisonBlock(
        merge_range,
        dollar_column,
        percent_column,
        flag_column,
        current_role,
        comparison_role,
        yes_list_column,
    )


