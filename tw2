            workbook,
            config,
            dataframe,
            display_roles,
            raw_roles,
            raw_df,
            comparisons,
        )

        summaries.append({
            "sheet": config.output_sheet,
            "rows": len(dataframe),
            "comparisons": [item.merge_range for item in comparisons],
            "periods": display_roles,
