def value_column_for_side(value_side: str) -> int:
    """Return the worksheet column for the current or prior chart value."""
    table_layout = layout_config()["comparison_table"]

    value_columns = {
        "current": table_layout["current_column"],
        "prior": table_layout["prior_column"],
    }

    if value_side not in value_columns:
        raise KeyError(
            f"Chart value must be 'current' or 'prior', not '{value_side}'."
        )

    return value_columns[value_side]


def period_id_for_table_side(
    table_cfg: dict,
    value_side: str,
) -> str:
    """Return the configured period ID for a table's current or prior value."""
    key = f"{value_side}_period"

    if key not in table_cfg:
        raise KeyError(
            f"Table configuration does not contain '{key}'."
        )

    return table_cfg[key]


def build_pie_chart(
    ws,
    title: str,
    start_row: int,
    end_row: int,
    value_column: int,
    pie_cfg: dict,
) -> PieChart:
    """Build a pie chart from a dynamically identified table range."""

    chart = PieChart()
    chart.title = title
    chart.width = pie_cfg.get("width", 12)
    chart.height = pie_cfg.get("height", 10)

    data_labels = DataLabelList()
    data_labels.showPercent = True
    data_labels.showVal = False
    data_labels.showCatName = False
    data_labels.showSerName = False
    data_labels.showLegendKey = False
    data_labels.showLeaderLines = False
    data_labels.numFmt = NumFmt(
        formatCode="0%",
        sourceLinked=False,
    )
    data_labels.position = "ctr"

    chart.dataLabels = data_labels

    chart.legend = Legend()
    chart.legend.position = pie_cfg.get("legend_position", "r")
    chart.legend.overlay = False

    # Build the pie-series data reference from the table's selected value column.
    data = Reference(
        ws,
        min_col=value_column,
        min_row=start_row,
        max_row=end_row,
    )

    # Build the category reference from the table's group-label column.
    categories = Reference(
        ws,
        min_col=layout_config()["comparison_table"]["label_column"],
        min_row=start_row,
        max_row=end_row,
    )

    chart.add_data(
        data,
        titles_from_data=False,
    )

    chart.set_categories(categories)

    if chart.series:
        series = chart.series[0]
        approved_colors = REPORT_CONFIG["formatting"]["approved_colors"]

        # Calculate the number of pie slices from the dynamically captured table rows.
        number_of_slices = end_row - start_row + 1

        for index in range(number_of_slices):
            point = DataPoint(idx=index)

            # Cycle through the approved palette when slices exceed the color count.
            point.graphicalProperties.solidFill = (
                approved_colors[index % len(approved_colors)]
            )

            series.dPt.append(point)

    return chart


def build_bar_chart(
    ws,
    table_ranges: dict,
    bar_cfg: dict,
) -> BarChart:
    """Build a clustered bar chart from configured comparison-table ranges."""

    chart = BarChart()

    chart.type = "col"
    chart.grouping = "clustered"
    chart.width = bar_cfg.get("width", 25)
    chart.height = bar_cfg.get("height", 15)
    chart.gapWidth = bar_cfg.get("gap_width", 219)
    chart.overlap = bar_cfg.get("overlap", -100)

    chart.legend = Legend()
    chart.legend.position = bar_cfg.get("legend_position", "b")
    chart.legend.overlay = False

    chart.y_axis.title = None
    chart.y_axis.numFmt = bar_cfg.get(
        "y_axis_number_format",
        "#,##0.0",
    )
    chart.y_axis.majorGridlines = ChartLines()
    chart.y_axis.scaling.min = bar_cfg.get("y_axis_min", 0)
    chart.y_axis.scaling.max = bar_cfg.get("y_axis_max", 600)
    chart.y_axis.majorUnit = bar_cfg.get("y_axis_major_unit", 100)

    chart.x_axis.title = None
    chart.x_axis.tickLblPos = "high"
    chart.x_axis.noMultiLvlLbl = 0

    sheet2_tables = REPORT_CONFIG["sheet2"]["tables"]
    table_layout = layout_config()["comparison_table"]

    category_table_id = bar_cfg["category_table"]
    category_range = table_ranges[category_table_id]

    # Use the category table's dynamically captured group rows as chart categories.
    categories = Reference(
        ws,
        min_col=table_layout["label_column"],
        min_row=category_range["start_row"],
        max_row=category_range["end_row"],
    )

    for series_cfg in bar_cfg["series"]:
        table_id = series_cfg["table"]
        value_side = series_cfg["value"]

        table_cfg = sheet2_tables[table_id]
        table_range = table_ranges[table_id]

        # Build each series from the configured current or prior value column.
        data = Reference(
            ws,
            min_col=value_column_for_side(value_side),
            min_row=table_range["start_row"],
            max_row=table_range["end_row"],
        )

        chart.add_data(
            data,
            titles_from_data=False,
        )

        series = chart.series[-1]

        # Resolve the logical period so the chart legend uses the correct display label.
        period_id = period_id_for_table_side(
            table_cfg,
            value_side,
        )

        series.title = SeriesLabel(
            v=period_label(
                period_id,
                "chart",
            )
        )

        data_labels = DataLabelList()
        data_labels.showVal = True
        data_labels.showCatName = False
        data_labels.showSerName = False
        data_labels.showLegendKey = False
        data_labels.position = "outEnd"
        data_labels.numFmt = NumFmt(
            formatCode=bar_cfg.get(
                "data_label_format",
                "#,##0.00",
            ),
            sourceLinked=False,
        )

        series.dLbls = data_labels

        color = series_cfg.get("color")

        if color:
            # Apply the configured color to both the bar fill and outline.
            series.graphicalProperties.solidFill = color
            series.graphicalProperties.line.solidFill = color

    chart.set_categories(categories)

    return chart


