from pyspark.sql import functions as F
from pyspark.sql.window import Window


def add_row_id(df, row_id_col="row_id"):
    if row_id_col in df.columns:
        raise ValueError(
            f"Column '{row_id_col}' already exists."
        )

    temp_order_col = "__temporary_row_order__"

    while temp_order_col in df.columns:
        temp_order_col = f"_{temp_order_col}"

    df_with_order = df.withColumn(
        temp_order_col,
        F.monotonically_increasing_id()
    )

    row_number_window = Window.orderBy(
        F.col(temp_order_col)
    )

    return (
        df_with_order
        .withColumn(
            row_id_col,
            F.row_number()
            .over(row_number_window)
            .cast("long")
        )
        .drop(temp_order_col)
    )


