from collections import Counter

DQ_PATH = f"{OUTPUT_DIRECTORY}/dq_validation.xlsx"
HDR_ROW, FIRST_COL, TOL = 12, 2, Decimal("0.01")   # table anchor B12, same as writer
DETAIL_LABELS = {ENTITY_PERCENT_DETAIL_LABEL, ENTITY_MULTIPLE_DETAIL_LABEL}
RECON_COLS = [c for c in GL_NUMERIC_COLUMNS_CY if c != PERCENTAGE_COLUMN_NAME]   # % col is rewritten as fraction, skip

raw_cy = records_from(raw_tb_CY)   # exact frame the Tab 1/2 writer consumed (not the greyed copy)

def status(*checks): return "OK" if all(checks) else "DIFF"

def tally(recs, cols):
    # row count + per-column Decimal sums (None / grey / blank -> 0)
    return {"Row count": len(recs),
            **{c: sum((to_decimal(r.get(c)) or Decimal(0) for r in recs), Decimal(0)) for c in cols}}

def read_written(sheet):
    # Read the saved workbook back. Tag each row grey/not by Consolidated cell fill.
    wb = cp.openpyxl.read(OUTPUT_PATH, data_only=False)
    try:
        rows = list(wb[sheet].iter_rows(min_row=HDR_ROW, min_col=FIRST_COL))
    finally:
        wb.close()
    hdr = [c.value for c in rows[0]]
    ci = hdr.index("Consolidated")
    out = []
    for r in rows[1:]:
        rec = dict(zip(hdr, (c.value for c in r)))
        if rec.get("Account") in (None, ""): continue
        rec["_grey"] = r[ci].fill.fgColor.rgb == GREY_OUT_FILL
        out.append(rec)
    return out

RECON_HDR = ["Metric", "Raw", "Excluded (grey)", "Included (Raw - Excl)", "Written (visible)", "Diff (Incl - Written)",
             "Written in grey rows (count = Excl, values = 0)", "Status"]

def recon(sheet, detail_per_row):
    # detail_per_row: 2 for Tab 1 (% + multiple rows per visible account), 0 for Tab 2
    w = read_written(sheet)
    vis = [r for r in w if r["Account"] not in DETAIL_LABELS and not r["_grey"]]
    gry = [r for r in w if r["_grey"]]
    n_det = len(w) - len(vis) - len(gry)
    R, W, G = tally(raw_cy, RECON_COLS), tally(vis, RECON_COLS), tally(gry, RECON_COLS)
    X = tally([r for r in raw_cy if not is_non_grey_cy_record(r)], RECON_COLS)   # independent visibility rule

    rows = [RECON_HDR]
    for k in R:
        inc = R[k] - X[k]
        diff = inc - W[k]
        expect_grey = X[k] if k == "Row count" else 0
        rows.append([k, R[k], X[k], inc, W[k], diff, G[k], status(abs(diff) < TOL, abs(G[k] - expect_grey) < TOL)])
    exp_det = detail_per_row * (R["Row count"] - X["Row count"])
    rows.append(["Detail rows", None, None, exp_det, n_det, n_det - exp_det, None, status(n_det == exp_det)])
    return rows

def dq(recs, label, blue_cells):
    # (check, count, must_be_zero) -> OK/REVIEW, or INFO when nonzero is expected
    accts = [str(r.get("Account") or "").strip() for r in recs]
    dup = sum(v > 1 for v in Counter(a for a in accts if a).values())
    checks = [("Blank Account rows", accts.count(""), True),
              ("Null Consolidated", sum(to_decimal(r.get("Consolidated")) is None for r in recs), True),
              ("Null Untested Balance", sum(to_decimal(r.get("Untested Balance")) is None for r in recs), True),
              ("Duplicate account names (handled by occurrence #)", dup, False),
              ("Blue (manual override) cells", blue_cells, False)]
    return [[label, n, v, ("OK" if v == 0 else "REVIEW") if must0 else "INFO"] for n, v, must0 in checks]

# --- join checks: join lines/totals must tie back to the greyed CY/PY frames ---
cy_account_records = [r for r in cy_records if is_present(get_field(r, "Account"))]
join_checks = [["Check", "Source", "Join", "Diff", "Status"]]
for name, src, jn in (
    ("CY lines: accounts vs join", len(cy_account_records), common_line_count + cy_only_line_count),
    ("PY lines: accounts vs join", len(py_account_records), common_line_count + py_only_line_count),
    ("CY Untested total", sum_field(cy_account_records, "Untested Balance"), cy_untested_total),
    ("PY Untested total", sum_field(py_account_records, "Untested Balance"), py_untested_total),
):
    join_checks.append([name, src, jn, src - jn, status(abs(src - jn) < TOL)])

# --- write separate file ---
dq_wb = Workbook()
ws = dq_wb.active
ws.title = "DQ Summary"
ws["A1"], ws["A1"].font = "Data Validation & DQ Report", title_font

write_block(ws, 3, [["Dataset", "Check", "Count", "Status"]]
            + dq(raw_cy, "Raw CY", len(spark_column_row_pairs_cy))
            + dq(records_from(raw_tb_PY), "Raw PY", len(spark_column_row_pairs_py)))
ws["A15"], ws["A15"].font = "Full Outer Join Tie-out", section_font
write_block(ws, 16, join_checks)
ws["A23"], ws["A23"].font = "Full Outer Join Line Breakup", section_font
write_block(ws, 24, [["Full outer-join lines", "Common CY/PY", "PY only", "CY only"],
                     [full_join_count, common_line_count, py_only_line_count, cy_only_line_count]])

recon_tabs = {"Tab1 Recon": recon(QUANTITATIVE_SHEET, 2), "Tab2 Recon": recon(QUALITATIVE_SHEET, 0)}
for title, rows in recon_tabs.items():
    sheet = dq_wb.create_sheet(title)
    sheet["A1"], sheet["A1"].font = f"{title}: Raw vs Excluded vs Written", title_font
    write_block(sheet, 3, rows)
    sheet.freeze_panes = "B4"

fj = dq_wb.create_sheet("Full Outer Join")
fj_rows = [["Account CY", "CY Untested", "Account PY", "PY Untested", "Match Category", "CY Greyed", "CY Row ID", "PY Row ID"]]
for r in residual_records:
    has_cy, has_py = is_present(get_field(r, ACCOUNT_CY_COLUMN)), is_present(get_field(r, ACCOUNT_PY_COLUMN))
    fj_rows.append([get_field(r, ACCOUNT_CY_COLUMN), to_decimal(get_field(r, CY_BALANCE_COLUMN)),
                    get_field(r, ACCOUNT_PY_COLUMN), to_decimal(get_field(r, PY_BALANCE_COLUMN)),
                    "Common CY/PY" if has_cy and has_py else "CY only" if has_cy else "PY only",
                    get_field(r, "CY_Greyed"), get_field(r, "CY_Row_ID"), get_field(r, "PY_Row_ID")])
write_block(fj, 3, fj_rows)
fj.freeze_panes = "A4"

for sheet in dq_wb.worksheets:
    sheet.sheet_view.showGridLines = False
    sheet.column_dimensions["A"].width = 52
    for col in "BCDEFGH": sheet.column_dimensions[col].width = 24

cp.openpyxl.write(dq_wb, DQ_PATH, register=True)

n_bad = sum(row[-1] == "DIFF" for rows in [*recon_tabs.values(), join_checks] for row in rows[1:])
print(f"DQ file written: {DQ_PATH} | DIFF rows: {n_bad}")

