# ---------- HELPERS ----------
def bt(c): return F.col("`" + c.replace("`", "``") + "`")

_cache = {}
def prep(label, sheets=None):
    """Raw Excel -> slim df: __A account, __G group, __S sheet, __V row net,
    __ok has acct#, __GV group non-blank, __R raw row order.
    Also returns unlisted non-zero numeric cols."""
    k = (label, sheets)
    if k in _cache: return _cache[k]
    s = SRC[label]
    raw = (read_excel(s["path"], sheet_name=list(sheets or s["sheets"]), header=s["header"],
                      naming_convention="neutral", trim=True)
           .withColumn("row_id", F.monotonically_increasing_id()))
    net = reduce(lambda a, b: a + b, [F.coalesce(bt(c).cast("double"), F.lit(0.0)) for c in s["cols"]])

    if s["kind"] == "links":
        w, acct = Window.orderBy("row_id").rowsBetween(Window.unboundedPreceding, 0), F.col("Linked TB Account #")
        d = (raw.withColumn("__ok", acct.isNotNull() & (acct != ""))
                .withColumn("__A", F.upper(F.concat_ws(": ", F.split(acct, r"\.").getItem(0), F.col("Account"))))
                .withColumn("__G", F.last(F.when(~F.col("__ok"), F.col("Account")), ignorenulls=True).over(w))
                .withColumn("__S", F.when(F.col("__sheet__") == BS_SHEET, "BS").otherwise("IS")))
    else:
        d = (raw.withColumn("__ok", F.lit(True)).withColumn("__A", F.upper(bt(s["key"])))
                .withColumn("__G", F.lit("-")).withColumn("__S", F.lit("IS")))

    d = (d.withColumn("__GV", F.col("__G").isNotNull() & (F.trim(F.col("__G")) != ""))
          .withColumn("__V", net)
          .withColumn("__R", F.col("row_id")))

    extra = [c for c in raw.columns if c not in s["cols"] and c not in META and c != s.get("key")]
    ex = {}
    if extra:
        r = d.filter("__ok").agg(*[F.expr("sum(try_cast(`%s` as double))" % c.replace("`", "``")).alias(f"c{i}")
                                   for i, c in enumerate(extra)]).first()
        ex = {c: r[i] for i, c in enumerate(extra) if r[i]}
    _cache[k] = (d.select("__A", "__G", "__S", "__V", "__ok", "__GV", "__R"), ex)
    return _cache[k]

def fin_sum(key, lab):
    """Final parquet -> (Total Amount, sum of entity cols) for period lab."""
    df, tc = FIN[key], f"Total Amount_{lab}"
    ent = [c for c in df.columns if c.endswith(f"_{lab}") and not c.startswith(("Total Amount_", "row_count_"))]
    r = df.agg(F.sum(bt(tc)), *[F.sum(bt(c)) for c in ent]).first()
    return float(r[0] or 0.0), float(sum(x or 0.0 for x in r[1:]))

def recon(label, sheets=None):
    """Raw -> NoAcct -> NoGroup -> Included. Rows + amount per sheet. Diff must be 0.
    Excluded tab is expected to hold NoAcct + NoGroup rows (zero / blank rows included)."""
    d, _ = prep(label, sheets)
    ok, gv, v = F.col("__ok"), F.col("__GV"), F.col("__V")
    buckets = {"Raw": F.lit(True), "NoAcct": ~ok, "NoGroup": ok & ~gv, "Included": ok & gv,
               "Excl_Zero": ~(ok & gv) & (v == 0)}            # informational: zero/blank rows inside Excluded
    aggs = []
    for k, c in buckets.items():
        aggs += [F.sum(F.when(c, 1).otherwise(0)).alias(f"{k}_Rows"),
                 F.sum(F.when(c, v).otherwise(0.0)).alias(f"{k}_Amt")]
    p = d.groupBy("__S").agg(*aggs).toPandas().rename(columns={"__S": "Sheet"})
    p.insert(0, "File", label)
    p["Diff_Rows"] = p.Raw_Rows - p.NoAcct_Rows - p.NoGroup_Rows - p.Included_Rows
    p["Diff_Amt"]  = (p.Raw_Amt - p.NoAcct_Amt - p.NoGroup_Amt - p.Included_Amt).round(2)
    p["Excl_Expected_Rows"] = p.NoAcct_Rows + p.NoGroup_Rows
    p["Excl_NonZero_Rows"]  = p.Excl_Expected_Rows - p.Excl_Zero_Rows
    return p.drop(columns=["Excl_Zero_Amt"])                   # zero rows sum to 0 by definition

def excluded(label, sheets=None):
    """Every row that did not land in Included, including blank / zero-value rows."""
    d, _ = prep(label, sheets)
    seq      = F.row_number().over(Window.partitionBy("__S").orderBy("__R"))   # position within raw sheet
    reason   = F.when(~F.col("__ok"), "No Account #").otherwise("No Group")
    row_type = F.when(F.col("__V") == 0, "Zero / Blank").otherwise("Non-zero")
    return (d.withColumn("__N", seq)
             .filter(~(F.col("__ok") & F.col("__GV")))
             .orderBy("__S", "__N")
             .select(F.lit(label).alias("File"), F.col("__S").alias("Sheet"),
                     F.col("__A").alias("Account"), F.col("__G").alias("Group"),
                     reason.alias("Reason"), row_type.alias("Row_Type"),
                     F.col("__V").alias("Amount"), F.col("__N").alias("Raw_Row_Seq"))
             .toPandas())

def add_excl_check(summary, excl):
    """Attach actual Excluded-tab row count / amount and compare to the recon expectation."""
    g = (excl.groupby(["File", "Sheet"])
             .agg(Excluded_Sheet_Rows=("Amount", "size"), Excluded_Sheet_Amt=("Amount", "sum"))
             .reset_index())
    out = summary.merge(g, on=["File", "Sheet"], how="left")
    out["Excluded_Sheet_Rows"] = out.Excluded_Sheet_Rows.fillna(0).astype(int)
    out["Excluded_Sheet_Amt"]  = out.Excluded_Sheet_Amt.fillna(0.0)
    out["Excl_Count_Diff"] = out.Excluded_Sheet_Rows - out.Excl_Expected_Rows                     # must be 0
    out["Excl_Amt_Diff"]   = (out.Excluded_Sheet_Amt - (out.NoAcct_Amt + out.NoGroup_Amt)).round(2)  # must be 0
    return out

def ssum(df, col): return float(df.agg(F.coalesce(F.sum(col), F.lit(0.0))).first()[0])

# =====================================================================
# PART 1: YTD  (raw -> included -> final BS / IS parquet)
# =====================================================================
ytd_excl = pd.concat([excluded(l) for l in YTD_LABELS], ignore_index=True)

ytd = pd.concat([recon(l) for l in YTD_LABELS], ignore_index=True)
fs = [fin_sum(r.Sheet, r.File) for r in ytd.itertuples()]
ytd["Final_Amt"]            = [x[0] for x in fs]
ytd["Final_minus_Included"] = (ytd.Final_Amt - ytd.Included_Amt).round(2)
ytd["Entity_minus_Total"]   = [round(x[1] - x[0], 2) for x in fs]
ytd = add_excl_check(ytd, ytd_excl)
ytd["Status"] = np.where((ytd.Diff_Rows == 0) & (ytd.Diff_Amt.abs() <= TOL)
                         & (ytd.Final_minus_Included.abs() <= TOL) & (ytd.Entity_minus_Total.abs() <= TOL)
                         & (ytd.Excl_Count_Diff == 0) & (ytd.Excl_Amt_Diff.abs() <= TOL),
                         "PASS", "FAIL")

# =====================================================================
# PART 2: QTD
#   2a raw -> included for every raw file QTD touches
#   2b (CY included - matched PY) vs final QTD parquet
# =====================================================================
qtd_excl  = pd.concat([excluded(l, s) for l, s in QTD_FILES.items()], ignore_index=True)

qtd_files = pd.concat([recon(l, s) for l, s in QTD_FILES.items()], ignore_index=True)
qtd_files = add_excl_check(qtd_files, qtd_excl)
qtd_files["Status"] = np.where((qtd_files.Diff_Rows == 0) & (qtd_files.Diff_Amt.abs() <= TOL)
                               & (qtd_files.Excl_Count_Diff == 0) & (qtd_files.Excl_Amt_Diff.abs() <= TOL),
                               "PASS", "FAIL")

rows = []
for cur, pri in QTD_PAIRS.items():
    c, _ = prep(cur, QTD_SHEETS)
    p, _ = prep(pri, QTD_SHEETS if SRC[pri]["kind"] == "links" else None)
    cy   = c.filter(F.col("__ok") & F.col("__GV"))
    pa   = p.filter("__ok").groupBy("__A").agg(F.sum("__V").alias("d"))
    unm  = pa.join(c.filter("__ok").select("__A").distinct(), "__A", "left_anti")      # PY acct not in CY
    dup  = cy.groupBy("__A").agg(F.countDistinct("__G").alias("g")).filter("g > 1").count()
    cy_amt  = ssum(cy, "__V")
    matched = ssum(pa.join(cy.select("__A").distinct(), "__A", "left_semi"), "d")
    ft, fe  = fin_sum("QTD", cur)
    rows.append({"CY": cur, "PY": pri, "CY_Included": cy_amt, "PY_Matched": matched,
                 "Expected": cy_amt - matched, "Final": ft,
                 "Final_minus_Expected": round(ft - (cy_amt - matched), 2),
                 "Entity_minus_Total": round(fe - ft, 2),
                 "PY_Unmatched_Keys": unm.count(), "PY_Unmatched_Amt": ssum(unm, "d"),
                 "CY_Dup_Accts": dup})
qtd_tie = pd.DataFrame(rows)
qtd_tie["Status"] = np.where((qtd_tie.Final_minus_Expected.abs() <= TOL) & (qtd_tie.Entity_minus_Total.abs() <= TOL)
                             & (qtd_tie.CY_Dup_Accts == 0), "PASS", "FAIL")

# =====================================================================
# UNLISTED COLUMNS (numeric cols in raw, not in entity list)
# =====================================================================
unl = pd.DataFrame([{"File": l, "Sheets": str(s) if s else "default", "Unlisted_Cols": len(ex),
                     "Unlisted_Total": sum(ex.values()), "Names": ", ".join(ex)[:500]}
                    for l, s in {**{x: None for x in YTD_LABELS}, **QTD_FILES}.items()
                    for ex in [prep(l, s)[1]]])
unl["Status"] = np.where(unl.Unlisted_Cols > 0, "WARN", "PASS")

# =====================================================================
# OUTPUT
# =====================================================================
write_excel(data={"P1_YTD": ytd, "P1_YTD_Excluded": ytd_excl,
                  "P2a_QTD_Files": qtd_files, "P2b_QTD_TieOut": qtd_tie, "P2_QTD_Excluded": qtd_excl,
                  "Unlisted_Cols": unl}, path=VALID_XLSX)

for name, t in [("P1 YTD", ytd), ("P2a QTD raw files", qtd_files), ("P2b QTD tie-out", qtd_tie), ("Unlisted", unl)]:
    print(f"{name}: {t.Status.value_counts().to_dict()}")
