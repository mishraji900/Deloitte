            worksheet.merge_cells(f"{col}{first_row}:{col}{last_data_row}")

    # â”€â”€ Grand total row (detail rows only, no double count) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
