    sheet_id: str
    output_sheet: str
    subtitle: str
    title_label: str
    total_label: str
    source_key: str
    raw_amount_columns: tuple[str, ...]
    role_to_excel_column: dict[str, str]
    comparison_blocks: tuple[ComparisonBlock, ...]
    legal_entity_sheet_names: dict[tuple[str, str], str]
    materiality_dollar_anchor: str
    materiality_percent_anchor: str
