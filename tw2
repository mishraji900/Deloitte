import unicodedata

_INVISIBLE = dict.fromkeys(map(ord, "\u200b\u200c\u200d\u2060\ufeff\u00ad"), None)


def _norm_2(value: Any) -> str:
    """Match key: NFKC, drop invisibles, casefold, keep letters/digits only.
    'Common Stock' == 'Common  Stock' == 'Common-Stock' == 'Gains / Losses'."""
    text = unicodedata.normalize("NFKC", str(value)).translate(_INVISIBLE)
    return re.sub(r"[\W_]+", "", text.casefold())


_norm = _norm_2  # apply_grouping uses the same key


def adopt_orphans(grouping):
    """Subtotal that is nobody's child -> parent its neighbouring subtotals share.
    e.g. Equity Investment Gain/Loss sits between FX and Gains/Losses (both under
    Earnings Before Taxes), so it joins Earnings Before Taxes."""
    out, parent = list(grouping), {}
    for t, g in grouping:
        if t and _norm_2(g) != _norm_2(t):
            parent.setdefault(_norm_2(g), t)
    runs = [t for t, _ in groupby(grouping, key=lambda x: x[0])]
    for i in range(1, len(runs) - 1):
        t = runs[i]
        a = parent.get(_norm_2(runs[i - 1]))
        if t and _norm_2(t) not in parent and a and a == parent.get(_norm_2(runs[i + 1])):
            last = max(k for k, (p, _) in enumerate(out) if p == a)
            out.insert(last + 1, (a, t))
            parent[_norm_2(t)] = a
            print(f"Adopted orphan total {t!r} -> {a!r}")
    return tuple(out)


def read_grouping(source: Any, name: str) -> tuple[tuple[str, str], ...]:
    """(Grouping Total, Group) from first two columns, row order kept. Other cols ignored.
    Orphan subtotals are adopted by their neighbours' parent."""
    df = convert_to_pandas(source, name).iloc[:, :2]
    return adopt_orphans(tuple(
        (str(total).strip() if pd.notna(total) else "", str(group).strip())
        for total, group in df.itertuples(index=False, name=None)
        if pd.notna(group) and str(group).strip()
    ))


def apply_grouping(df: pd.DataFrame, grouping) -> pd.DataFrame:
    """Order rows like grouping file. Unlisted groups go last."""
    inf = float("inf")
    pos: dict[str, int] = {}
    for i, (_, group) in enumerate(grouping):
        pos.setdefault(_norm(group), i)
    key = df[ACCOUNT_GROUP_COLUMN].map(lambda s: pos.get(_norm(s), inf))
    unlisted = df.loc[key == inf, ACCOUNT_GROUP_COLUMN].tolist()
    if unlisted:
        print(f"Not in grouping file (appended last): {unlisted}")
    return (
        df.assign(_pos=key)
        .sort_values("_pos", kind="stable")
        .drop(columns="_pos")
        .reset_index(drop=True)
    )


def sum_formula(column: str, rows: list[int]) -> str:
    runs: list[list[int]] = []
    for row in sorted(rows):
        if runs and row == runs[-1][1] + 1:
            runs[-1][1] = row
        else:
            runs.append([row, row])
    return "=SUM(" + ",".join(
        f"{column}{a}:{column}{b}" if a != b else f"{column}{a}"
        for a, b in runs
    ) + ")"


def plan_rows(dataframe, first_row, grouping):
    """-> (sheet row per df row, [(total_row, label, member_rows)], grand_total_row).
    A Groups entry can be a TB account, a Grouping Total (computed row), or both.
    Both parts are handled independently. Totals can nest to any depth."""
    idx: dict[str, list[int]] = {}
    for i, name in enumerate(dataframe[ACCOUNT_GROUP_COLUMN]):
        idx.setdefault(_norm_2(name), []).append(i)
    labels = {_norm_2(t) for t, _ in grouping if t}

    detail_rows = [0] * len(dataframe)
    placed, blocks, row = set(), [], first_row

    for total, items in groupby(grouping, key=lambda x: x[0]):
        t_norm, own, kids = _norm_2(total), [], []
        for _, g in items:
            n = _norm_2(g)
            for i in idx.get(n, []):                     # 1) actual TB account
                if i not in placed:
                    detail_rows[i] = row
                    placed.add(i)
                    own.append(row)
                    row += 1
            if n in labels and n != t_norm and n not in kids:   # 2) grouping total
                kids.append(n)
        if total and (own or kids):
            blocks.append((row, total, own, kids))
            row += 2                                     # total row + blank row

    for i in range(len(dataframe)):                      # groups not in grouping file
        if i not in placed:
            detail_rows[i] = row
            row += 1

    names = [_norm_2(label) for _, label, _, _ in blocks]
    repeated = sorted({n for n in names if names.count(n) > 1})
    if repeated:
        print(f"WARNING Grouping Total split into separate runs (keep rows together): {repeated}")

    where = {_norm_2(label): r for r, label, _, _ in blocks}
    unresolved = sorted({k for *_, kids in blocks for k in kids if k not in where})
    if unresolved:
        print(f"WARNING subtotal references with no rows (skipped in parent): {unresolved}")

    totals = [
        (r, label, list(dict.fromkeys(own + [where[k] for k in kids if k in where])))
        for r, label, own, kids in blocks
    ]
    return detail_rows, totals, row


def _selfcheck() -> None:
    # subtotal inside subtotal
    grouping = [("T1", "A"), ("T1", "B"), ("T1", "C"), ("T2", "D"), ("T2", "T1")]
    df = pd.DataFrame({ACCOUNT_GROUP_COLUMN: ["A", "B", "C", "D", "E"]})
    rows, totals, grand = plan_rows(df, 14, grouping)
    assert rows == [14, 15, 16, 19, 22] and grand == 23
    assert totals == [(17, "T1", [14, 15, 16]), (20, "T2", [19, 17])]
    assert sum_formula("C", [19, 17]) == "=SUM(C17,C19)"
    assert sum_formula("C", [14, 15, 17, 18, 20]) == "=SUM(C14:C15,C17:C18,C20)"

    # equity side: three levels, self-named rows, repeated child
    grouping = [
        ("OCI", "Pension"), ("Treasury Stock", "Treasury Stock"), ("APIC", "APIC"),
        ("Total Equity", "OCI"), ("Total Equity", "Treasury Stock"),
        ("Total Equity", "APIC"), ("Total Equity", "Common Stock"),
        ("Total Equity", "OCI"),
        ("TL", "Payable"),
        ("TLSE", "Total Equity"), ("TLSE", "TL"),
    ]
    df = pd.DataFrame({ACCOUNT_GROUP_COLUMN:
                       ["Pension", "Treasury Stock", "APIC", "Common Stock", "Payable"]})
    rows, totals, grand = plan_rows(df, 14, grouping)
    assert rows == [14, 17, 20, 23, 26] and grand == 31
    assert totals == [
        (15, "OCI", [14]), (18, "Treasury Stock", [17]), (21, "APIC", [20]),
        (24, "Total Equity", [23, 15, 18, 21]),
        (27, "TL", [26]), (29, "TLSE", [24, 27]),
    ]

    # name is BOTH a TB account and a grouping total: account row AND subtotal both roll up
    for parent in ([("P", "X"), ("P", "B")], [("P", "X"), ("P", "X"), ("P", "B")]):
        grouping = [("X", "A")] + parent
        df = pd.DataFrame({ACCOUNT_GROUP_COLUMN: ["A", "X", "B"]})
        rows, totals, grand = plan_rows(df, 14, grouping)
        assert rows == [14, 17, 18] and grand == 21
        assert totals == [(15, "X", [14]), (19, "P", [17, 18, 15])]

    # NEW: punctuation / spacing / case never break a match
    assert _norm_2("Gains / Losses  / Impairments") == _norm_2("gains/losses/impairments")
    assert _norm_2("Common Stock") == _norm_2("COMMON-STOCK")

    # NEW: orphan subtotal between two siblings is adopted by their parent
    g = (("FX", "FX"), ("EQ", "EQ"), ("G", "G"), ("EBT", "FX"), ("EBT", "G"))
    assert ("EBT", "EQ") in adopt_orphans(g)
    df = pd.DataFrame({ACCOUNT_GROUP_COLUMN: ["FX", "EQ", "G"]})
    _, totals, _ = plan_rows(df, 14, adopt_orphans(g))
    assert [t for t in totals if t[1] == "EBT"][0][2] == [14, 17, 20] or len(
        [t for t in totals if t[1] == "EBT"][0][2]) == 3
