        row,
        2,
        row,
        9,
        REPORT_CONFIG["sheet1"]["year_end_update_title"],
        font=BOLD_11,
        border=MED_BOX,
        align=CENTER,
    )

    # Advance the shared row pointer so all following tables start below the heading.
    row += 2

    row = write_materiality_box(ws, row)

    comparison_cfg = REPORT_CONFIG["sheet1"]["comparison_table"]

    write_cell(
        ws,
        row,
        2,
        comparison_cfg["title"],
        font=BOLD_ITALIC,
        align=LEFT,
    )

    row += 2

    # The comparison-table function returns the next available dynamic row.
    row, _, _ = write_comparison_table(
        ws=ws,
        row=row,
        group_totals=group_totals,
        table_cfg=comparison_cfg,
        acct_group=acct_group,
    )

    # The materiality table begins after the comparison table's returned row.
    row = write_materiality_multiple_table(
        ws=ws,
        row=row,
        group_totals=group_totals,
        table_cfg=REPORT_CONFIG["sheet1"]["materiality_multiple"],
        acct_group=acct_group,
    )

    return group_totals


