    "P4_invalid_pk", "row_id", stage_path=STAGE_PATH_P4,
)
p4_base = materialize_df(
    p4_input.filter(F.col("p4_primary_key").isNotNull()),
    "P4_base", "p4_primary_key", stage_path=STAGE_PATH_P4,
)

debug_count("P4 valid PK",   p4_base)
debug_count("P4 invalid PK", p4_invalid_pk)

print("\n  [PROFILE] PK failure breakdown")
display(p4_invalid_pk.select(
    F.sum(
        F.when(F.col("company_desc_clean").isNull() | (F.col("company_desc_clean") == ""), 1)
         .otherwise(0)
    ).alias("missing_company_desc"),
    F.sum(
        F.when(F.col("vendor_num_clean").isNull() | (F.col("vendor_num_clean") == ""), 1)
         .otherwise(0)
    ).alias("missing_vendor_num"),
    F.sum(
        F.when(
            (F.col("company_desc_clean").isNull() | (F.col("company_desc_clean") == ""))
            & (F.col("vendor_num_clean").isNull()  | (F.col("vendor_num_clean") == "")),
            1
        ).otherwise(0)
    ).alias("missing_both"),
))

print("\n[P4-S2] Building sales / credit side tables...")

p4_sales  = materialize_df(make_sales(p4_base,  "p4_primary_key"), "P4_sales",  stage_path=STAGE_PATH_P4)
p4_credit = materialize_df(make_credit(p4_base, "p4_primary_key"), "P4_credit", stage_path=STAGE_PATH_P4)

debug_count("P4 sales",  p4_sales)
debug_count("P4 credit", p4_credit)

print(f"\n[P4-S3] Cross-joining within PK; tolerance = {P4_TOLERANCE}...")

_tol = F.lit(P4_TOLERANCE).cast(DECIMAL_TYPE)

# amount_net here (not amount_diff — a different name than the P1/P2/P3
# match helpers use) is what Cell 8's _exact_cancel check reads off `oto`
# by row_id to decide AA_EXACT_MATCH_* vs AA_APPROX_MATCH.
p4_candidates = (
    p4_sales.alias("s")
    .join(p4_credit.alias("c"), on="primary_key", how="inner")
    .withColumn("amount_net", F.abs(F.col("s.sales_amt") + F.col("c.credit_amt")))
    .filter(F.col("amount_net") <= _tol)
    .select(
        "primary_key",
        F.col("s.sales_row_id"),  F.col("c.credit_row_id"),
        F.col("s.sales_amt"),     F.col("c.credit_amt"),     F.col("amount_net"),
        F.col("s.sales_eff_dt"),  F.col("c.credit_eff_dt"),
        F.col("s.sales_month"),   F.col("c.credit_month"),
        F.col("s.sales_ref"),     F.col("c.credit_ref"),
    )
)
p4_candidates = materialize_df(p4_candidates, "P4_candidates", stage_path=STAGE_PATH_P4)
debug_count("P4 candidates (within tolerance)", p4_candidates)

print("\n[P4-S4] Classifying one-to-many vs one-to-one...")

# credit_count_per_sale / sales_count_per_credit: how many candidates each
# side has. is_one_to_many is true if EITHER side has more than one
# candidate — a many-to-one is still ambiguous from the "one" side's
# perspective, so it's treated the same as a genuine many-to-many.
sales_match_cts = (
    p4_candidates
    .groupBy("sales_row_id")
    .agg(F.countDistinct("credit_row_id").alias("credit_count_per_sale"))
)
credit_match_cts = (
    p4_candidates
    .groupBy("credit_row_id")
    .agg(F.countDistinct("sales_row_id").alias("sales_count_per_credit"))
)

p4_classified = (
    p4_candidates
    .join(sales_match_cts,  on="sales_row_id",  how="left")
    .join(credit_match_cts, on="credit_row_id", how="left")
    .withColumn("is_one_to_many",
        (F.col("credit_count_per_sale") > 1) | (F.col("sales_count_per_credit") > 1))
)
p4_classified = materialize_df(p4_classified, "P4_classified", stage_path=STAGE_PATH_P4)

print("\n[P4-S5] Building ONE_TO_MANY dataset...")

otm_ids = (
    p4_classified.filter(F.col("is_one_to_many"))
    .select(F.col("sales_row_id").alias("row_id"))
    .unionByName(
        p4_classified.filter(F.col("is_one_to_many"))
        .select(F.col("credit_row_id").alias("row_id"))
    )
    .distinct()
)

P4_ONE_TO_MANY = materialize_df(
    p4_base.join(otm_ids, on="row_id", how="inner")
           .withColumn("match_type", F.lit("ONE_TO_MANY")),
    "P4_ONE_TO_MANY", stage_path=STAGE_PATH_P4,
)
debug_count("P4_ONE_TO_MANY", P4_ONE_TO_MANY)

print("\n[P4-S6] Building DATE_SYNC / DATE_UNSYNC datasets...")

# oto = "one-to-one" — the unambiguous leftover after ONE_TO_MANY rows are
# pulled out. date_sync = True means the normal chronological order (sales
# invoice dated before its credit memo); False means the credit memo's
# effective date is actually earlier than the sales invoice it's paired
# with (DATE_UNSYNC) — still within tolerance, just an unusual date order
# worth calling out separately in the AA Comment.
# NOTE: `oto` is reused directly by Cell 8 (assign_aa_comment's oto_df
# argument) to look up each pair's exact amount_net — not just a
# throwaway intermediate for this cell.
oto = (
    p4_classified.filter(~F.col("is_one_to_many"))
    .withColumn("date_sync", F.col("sales_eff_dt") < F.col("credit_eff_dt"))
)
oto = materialize_df(oto, "P4_oto", stage_path=STAGE_PATH_P4)


def _ids_for_flag(oto_df, flag_val):
    flt = oto_df.filter(F.col("date_sync") == flag_val)
    return (
        flt.select(F.col("sales_row_id").alias("row_id"))
           .unionByName(flt.select(F.col("credit_row_id").alias("row_id")))
           .distinct()
    )


sync_ids   = _ids_for_flag(oto, True)
unsync_ids = _ids_for_flag(oto, False)

P4_DATE_SYNC = materialize_df(
    p4_base.join(sync_ids, on="row_id", how="inner")
           .withColumn("match_type", F.lit("ONE_TO_ONE_DATE_SYNC")),
    "P4_DATE_SYNC", stage_path=STAGE_PATH_P4,
)
P4_DATE_UNSYNC = materialize_df(
    p4_base.join(unsync_ids, on="row_id", how="inner")
           .withColumn("match_type", F.lit("ONE_TO_ONE_DATE_UNSYNC")),
    "P4_DATE_UNSYNC", stage_path=STAGE_PATH_P4,
)

debug_count("P4_DATE_SYNC",   P4_DATE_SYNC)
debug_count("P4_DATE_UNSYNC", P4_DATE_UNSYNC)

print("\n[P4-S7] Building NO_MATCH_FOUND...")

matched_ids_all = (
    otm_ids
