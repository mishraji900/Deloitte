def load_template(path: str | Path):
    return cp.openpyxl.read(str(path))


def save_template(workbook, path: str | Path) -> None:
    cp.openpyxl.write(workbook, str(path), register=True)


def run(
    template_path: str | Path,
    output_directory: str | Path,
    sources: dict[str, Any],
    groupings: dict[str, Any],
) -> None:
    _selfcheck()
    configs = build_sheet_configs()
    workbook = load_template(template_path)

    # Match template sheet names ignoring stray spaces / punctuation.
    actual = {_norm(name): name for name in workbook.sheetnames}
    for config in configs:
        found = actual.get(_norm(config.output_sheet))
        if found is None:
            raise KeyError(
                f"Template sheet '{config.output_sheet}' not found. "
                f"Template has: {[repr(s) for s in workbook.sheetnames]}"
            )
        config.output_sheet = found

    summaries = []
    total_rows: dict[str, int] = {}   # sheet -> total row of last section written

    for config in configs:
        print(f"\nPreparing {config.sheet_id}...")

        grouping = read_grouping(
            groupings[config.grouping_sheet],
            GROUPING_NAMES[config.grouping_sheet],
        )
        dataframe, display_roles, raw_roles, raw_df = prepare_data(
            config, sources, grouping
        )
        comparisons = (
            active_blocks(config, raw_roles)
            if config.classifier == "bs"
            else list(config.comparison_blocks)
        )

        # First section on a sheet: below=None. Later sections stack under it.
        total_rows[config.output_sheet] = write_summary_sheet(
            workbook[config.output_sheet],
            config,
            dataframe,
            display_roles,
            comparisons,
            grouping,
            below=total_rows.get(config.output_sheet),
            banner=SECTION_BANNERS.get(config.sheet_id),
        )

        render_legal_entity_sheets(
            workbook,
            config,
            dataframe,
            display_roles,
            raw_roles,
            raw_df,
            comparisons,
        )

        summaries.append({
            "sheet": config.output_sheet,
            "rows": len(dataframe),
            "comparisons": [item.merge_range for item in comparisons],
            "periods": display_roles,
        })

    # QTD spacer columns (F, K) are data columns in YTD: widen so no ####.
    is_sheet = workbook[configs[1].output_sheet]
    for col in range(3, 24):
        is_sheet.column_dimensions[get_column_letter(col)].width = 16

    try:
        workbook.calculation.fullCalcOnLoad = True
        workbook.calculation.forceFullCalc = True
    except AttributeError:
        pass

    output_path = Path(output_directory)
    output_path.mkdir(parents=True, exist_ok=True)
    output_file = output_path / OUTPUT_FILE_NAME
    save_template(workbook, output_file)

    print("\nAll sheets written successfully.")
    print(f"Output: {output_file}")
    for summary in summaries:
        print(f"{summary['sheet']}: {summary['rows']} accounts")
        print(f"Comparisons: {summary['comparisons']}")
        print(f"Periods: {summary['periods']}")


def main() -> None:
    # Runtime inputs remain external; this script only processes them.
    runtime = globals()
    required_names = (
        "TEMPLATE_PATH", "OUTPUT_DIRECTORY", *GROUPING_NAMES.values(), *INPUT_NAMES
    )
    missing = [name for name in required_names if runtime.get(name) is None]

    if missing:
        raise RuntimeError(
            "Define these runtime inputs before calling main(): "
            + ", ".join(missing)
        )

    run(
        template_path=runtime["TEMPLATE_PATH"],
        output_directory=runtime["OUTPUT_DIRECTORY"],
        sources={
            "TB_Final_BS": runtime["TB_Final_BS"],
            "TB_Final_IS_YTD": runtime["TB_Final_IS_YTD"],
            "TB_Final_QTD": runtime["TB_Final_QTD"],
        },
        groupings={key: runtime[name] for key, name in GROUPING_NAMES.items()},
    )


if __name__ == "__main__":
    main()

