TABLES = [
    ("RAW - Excel vs Parquet snapshot",
     ["Period", "Raw_Rows", "Raw_Total", "Parquet_Rows", "Parquet_Total"]),
    ("FILTERED OUT - no Account",
     ["Period", "NoAcct_Rows", "NoAcct_Total"]),
    ("KEPT - after Account filter",
