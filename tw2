def get_source_dataframe(
    df_full: pd.DataFrame | None = None,
) -> pd.DataFrame:
    """Return the source data from an argument or the configured TB_Final object."""

    if df_full is not None:
        return df_full

    # Retrieve TB_Final from the runtime when no dataframe was passed explicitly.
    tb_final = globals().get("TB_Final")

    if tb_final is None:
        raise RuntimeError(
            "No dataframe was supplied and TB_Final was not found. "
            "Pass df_full to run(df_full), or provide TB_Final."
        )

    # Convert managed Spark-style data into pandas before report processing.
    if hasattr(tb_final, "toPandas"):
        return tb_final.toPandas()

    if isinstance(tb_final, pd.DataFrame):
        return tb_final.copy()

    raise TypeError(
        "TB_Final must be a pandas DataFrame or expose toPandas()."
    )


def run(
    df_full: pd.DataFrame | None = None,
) -> None:
    """Generate one risk-assessment workbook for each configured account group."""

    # Validate all period, table, chart, and source-column references before processing.
    validate_config()

    print("=" * 70)
    print("Preparing source data...")

    # Resolve the source once so every account group uses the same input dataset.
    source_df = get_source_dataframe(df_full)

    print("=" * 70)

    account_groups = data_config()["account_groups"]
    template_path = workbook_config()["template_path"]
    template_sheets = workbook_config()["template_sheets"]

    # Process each configured account group independently.
    for acct_group in account_groups:
        print(f"\nProcessing: '{acct_group}'")

        try:
            # Filter and standardize the source data for the current account group.
            df = prepare_data(
                df_full=source_df,
                acct_group_value=acct_group,
            )

            # Load a fresh template so each account group receives an independent workbook.
            wb = load_template_workbook(template_path)

            # Create account-group-specific copies of the summary and analysis templates.
            ws_summary = copy_sheet_from_template(
                wb,
                template_sheets["summary"],
                make_sheet_name(acct_group, "Sum"),
            )

            ws_analysis = copy_sheet_from_template(
                wb,
                template_sheets["analysis"],
                make_sheet_name(acct_group, "Ana"),
            )

            # Preserve a separate tickmarks worksheet for the generated workbook.
            copy_sheet_from_template(
                wb,
                template_sheets["tickmarks"],
                make_sheet_name(acct_group, "Tick"),
            )

            # Build Sheet 1 first because it returns the group totals used by Sheet 2.
            group_totals = write_sheet1_summary(
                ws=ws_summary,
                df=df,
                acct_group=acct_group,
            )

            # Build Sheet 2 using the group totals calculated on Sheet 1.
            write_sheet2_analysis(
                ws=ws_analysis,
                group_totals=group_totals,
                acct_group=acct_group,
            )

            if workbook_config()["delete_template_sheets"]:
                # Remove only the original template tabs after copied report tabs are complete.
                for template_sheet_name in template_sheets.values():
                    if template_sheet_name in wb.sheetnames:
                        del wb[template_sheet_name]

            output_path = make_output_path(acct_group)

            # Save the completed workbook to the account-group-specific output path.
            save_output_workbook(
                wb=wb,
                output_path=output_path,
            )

            print(f"SUCCEEDED: {acct_group}")
            print(f"Output: {output_path}")

        except Exception as exc:
            # Continue processing remaining account groups if one group fails.
            print(f"FAILED on '{acct_group}': {exc}")


run()


