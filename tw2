def bt(c): return F.col("`" + c.replace("`", "``") + "`")

@lru_cache(None)
def prep(label, sheets=None):
    """Raw file -> slim df (__A account, __G group, __S sheet, __V net total, __ok has acct#, __GV group valid)."""
    s = SRC[label]
    raw = (read_excel(s["path"], sheet_name=list(sheets or s["sheets"]), header=s["header"],
                      naming_convention="neutral", trim=True)
           .withColumn("row_id", F.monotonically_increasing_id()))
    net = sum((F.coalesce(bt(c).cast("double"), F.lit(0.0)) for c in s["cols"]), F.lit(0.0))
    if s["kind"] == "links":
        w, acct = Window.orderBy("row_id").rowsBetween(Window.unboundedPreceding, 0), F.col("Linked TB Account #")
        d = (raw.withColumn("__ok", acct.isNotNull() & (acct != ""))
                .withColumn("__A", F.upper(F.concat_ws(": ", F.split(acct, r"\.").getItem(0), F.col("Account"))))
                .withColumn("__G", F.last(F.when(~F.col("__ok"), F.col("Account")), ignorenulls=True).over(w))
                .withColumn("__S", F.when(F.col("__sheet__") == BS_SHEET, F.lit("BS")).otherwise(F.lit("IS"))))
    else:
        d = (raw.withColumn("__ok", F.lit(True)).withColumn("__A", F.upper(bt(s["key"])))
                .withColumn("__G", F.lit("-")).withColumn("__S", F.lit("IS")))
    d = (d.withColumn("__GV", F.col("__G").isNotNull() & (F.trim(F.col("__G")) != ""))
          .withColumn("__V", net))
    # raw numeric cols NOT in the net-total list (nonzero only)
    extra = [c for c in raw.columns if c not in s["cols"] and c not in META and c != s.get("key")]
    ex = {}
    if extra:
        r = d.filter(F.col("__ok")).agg(*[
            F.expr("sum(try_cast(`%s` as double))" % c.replace("`", "``")).alias(f"c{i}")
            for i, c in enumerate(extra)]).first()
        ex = {c: r[i] for i, c in enumerate(extra) if r[i]}
    return d.select("__A", "__G", "__S", "__V", "__ok", "__GV").cache(), ex

def stats(d, unit):
    ok, gv, v = F.col("__ok"), F.col("__GV"), F.col("__V")
    inc = ok & gv
    n = lambda c: F.sum(F.when(c, 1).otherwise(0))
    t = lambda c: F.sum(F.when(c, v).otherwise(0.0))
    units = n(inc) if unit == "rows" else F.countDistinct(F.when(inc, F.concat_ws("||", "__A", "__G", "__S")))
    return d.groupBy("__S").agg(
        F.count("*").alias("raw_rows"), F.sum(v).alias("raw_total"),
        n(~ok).alias("filt_rows"), t(~ok).alias("filt_total"),
        n(ok & ~gv).alias("nogrp_rows"), t(ok & ~gv).alias("nogrp_total"),
        n(inc).alias("inc_rows"), t(inc).alias("inc_total"),
        units.alias("exp_units")).toPandas()

def final_side(df, lab):
    tc, cc = f"{TOT}_{lab}", f"{CNT}_{lab}"
    if tc not in df.columns or cc not in df.columns:
        return (float("nan"),) * 3
    ent = [c for c in df.columns if c.endswith(f"_{lab}") and c not in (tc, cc)]
    r = df.agg(F.sum(bt(tc)), F.sum(bt(cc)), *[F.sum(bt(c)) for c in ent]).first()
    return (r[0] or 0.0, int(r[1] or 0), sum((x or 0.0) for x in r[2:]))

def fsum(df, c): return float(df.agg(F.coalesce(F.sum(c), F.lit(0.0))).first()[0])

def mk(stage, lab, sh, s, fin, ex, exp_total, extra=None):
    extra = extra or {}
    ft, fu, fe = fin
    bad = (pd.isna(ft) or abs(ft - exp_total) > TOL or fu != int(s["exp_units"])
           or abs(fe - ft) > TOL or extra.get("CY_Dup_Accts", 0) > 0)
    return {"Stage": stage, "Period": lab, "Sheet": sh,
            "Raw_Rows": int(s["raw_rows"]), "Raw_Total": s["raw_total"],
            "NoAcct_Rows": int(s["filt_rows"]), "NoAcct_Total": s["filt_total"],
            "NoGroup_Rows": int(s["nogrp_rows"]), "NoGroup_Total": s["nogrp_total"],
            "Included_Rows": int(s["inc_rows"]), "Included_Total": s["inc_total"],
            **extra,
            "Expected_Units": int(s["exp_units"]), "Final_Units": fu,
            "Expected_Total": exp_total, "Final_Total": ft, "Diff_Total": ft - exp_total,
            "Final_EntitySum_minus_Total": fe - ft,
            "Unlisted_Cols": len(ex), "Unlisted_Total": sum(ex.values()), "Unlisted_Names": ", ".join(ex)[:500],
            "Status": "FAIL" if bad else ("WARN" if ex else "PASS")}

summary, detail = [], []
def det(stage, lab, df, reason, v="__V"):
    cs = df.columns
    p = df.filter(F.col(v) != 0).select(
        F.col("__A").alias("Account"),
        (F.col("__G") if "__G" in cs else F.lit(None).cast("string")).alias("Group"),
        (F.col("__S") if "__S" in cs else F.lit(None).cast("string")).alias("Sheet"),
        F.col(v).alias("Value")).toPandas()
    if len(p):
        p.insert(0, "Reason", reason); p.insert(0, "Period", lab); p.insert(0, "Stage", stage)
        detail.append(p)

FIN = {k: read(Path(OUTPUT_DIRECTORY) / v) for k, v in FINAL_FILES.items()}
ok_, cin = F.col("__ok"), F.col("__ok") & F.col("__GV")

# ---- YTD: raw -> final BS / IS parquet ----
for lab in YTD_LABELS:
    d, ex = prep(lab)
    st = stats(d, "rows").set_index("__S").reindex(["BS", "IS"]).fillna(0)
    for sh in ("BS", "IS"):
        s = st.loc[sh]
        summary.append(mk("YTD", lab, sh, s, final_side(FIN[sh], lab), ex, s["inc_total"]))
    det("YTD", lab, d.filter(~ok_), "NO ACCT# - filtered out")
    det("YTD", lab, d.filter(~cin & ok_), "NO GROUP - dropped by join")

# ---- QTD: (cur YTD - prior YTD, matched on Account) -> final QTD parquet ----
def qprep(lab): return prep(lab, QTD_SHEETS if SRC[lab]["kind"] == "links" else None)

for cur, pri in QTD_PAIRS.items():
    c, ex_c = qprep(cur); p, ex_p = qprep(pri)
    s = stats(c, "accts").drop(columns="__S").sum()
    pa     = p.filter(ok_).groupBy("__A").agg(F.sum("__V").alias("__D"))            # prior per account
    ca_all = c.filter(ok_).select("__A").distinct()
    ca_in  = c.filter(cin).select("__A").distinct()
    ded    = fsum(pa.join(ca_in, "__A", "left_semi"), "__D")                        # each prior acct deducted once
    un     = pa.join(ca_all, "__A", "left_anti")                                    # prior acct not in CY -> never deducted
    cyo    = c.filter(cin).join(pa.select("__A"), "__A", "left_anti")               # CY acct with no prior -> full YTD kept
    da     = c.filter(cin).groupBy("__A").agg(F.countDistinct("__G").alias("g")).filter("g > 1").select("__A")
    extra = {"Prior_Matched_Total": ded,
             "Prior_Unmatched_Keys": un.count(), "Prior_Unmatched_Total": fsum(un, "__D"),
             "CY_NoPrior_Keys": cyo.select("__A").distinct().count(), "CY_NoPrior_Total": fsum(cyo, "__V"),
             "CY_Dup_Accts": da.count()}
    ex = {**ex_c, **{"PRIOR " + k: v for k, v in ex_p.items()}}
    summary.append(mk("QTD", cur, "ALL", s, final_side(FIN["QTD"], cur), ex, s["inc_total"] - ded, extra))
    det("QTD", cur, c.filter(~ok_), "NO ACCT# - filtered out")
    det("QTD", cur, c.filter(~cin & ok_), "NO GROUP - dropped by join")
    det("QTD", cur, un, "PRIOR ACCT NOT IN CY - not deducted", v="__D")
    det("QTD", cur, c.filter(cin).join(da, "__A", "left_semi"), "CY ACCT IN >1 GROUP - deducted per group row")

# ---- write excel via cp.openpyxl ----
summary_pd = pd.DataFrame(summary)
detail_pd = (pd.concat(detail, ignore_index=True) if detail
             else pd.DataFrame(columns=["Stage", "Period", "Reason", "Account", "Group", "Sheet", "Value"]))
wb = Workbook(); wb.remove(wb.active)
for name, pdf in [("Summary", summary_pd), ("Excluded_Detail", detail_pd)]:
    ws = wb.create_sheet(name)
    ws.append(list(pdf.columns))
    for r in pdf.astype(object).where(pdf.notna(), None).itertuples(index=False):
        ws.append(list(r))
    for c in ws[1]: c.font = Font(bold=True)
    ws.freeze_panes = "A2"
cp.openpyxl.write(wb, VALID_XLSX, register=True)

