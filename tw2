# ---------- helpers ----------
def hold(df):
    """Serverless: no cache/persist. Run plan once, keep result as in-memory df."""
    p = df.toPandas()
    return spark.createDataFrame(p.astype(object).where(p.notna(), None), schema=df.schema)


def bt(c):
    return F.col("`" + c.replace("`", "``") + "`")


def num(c):
    """Mirror pipeline: strip $, trim whitespace, safe cast to double."""
    return F.expr(
        "try_cast(regexp_replace(trim(cast(`%s` as string)), '[$]', '') as double)"
        % c.replace("`", "``")
    )


def prep(df, s, full):
    """
    Mirror pipeline: rename/drop -> slim df.
    Columns:
        A = Account
        I = row_id
        V = net total (sum of all non-EXCLUDE cols)
        B = BR015 consolidated col (standalone, for reference only)
    """
    ex = {}
    if full:
        zs = [c for c in s["drop"] if c in df.columns]
        if zs:
            r = df.agg(*[F.sum(num(c)).alias(f"c{i}") for i, c in enumerate(zs)]).first()
            ex["dropped"] = {c: r[i] for i, c in enumerate(zs) if r[i]}
    for a, b in s["rename"].items():
        df = df.withColumnRenamed(a, b)
    df   = df.drop(*s["drop"])
    vals = [c for c in df.columns if c not in EXCLUDE]
    if full:
        r = df.agg(*[F.sum(
            F.when(bt(c).isNotNull() & (F.trim(bt(c).cast("string")) != "") & num(c).isNull(), 1)
             .otherwise(0)).alias(f"c{i}") for i, c in enumerate(vals)]).first()
        ex["bad"] = {c: r[i] for i, c in enumerate(vals) if r[i]}
    net = sum((F.coalesce(num(c), F.lit(0.0)) for c in vals), F.lit(0.0))
    k   = df.select(
        F.col(ACCT).alias("A"),
        F.col("row_id").alias("I"),
        net.alias("V"),
        F.coalesce(num(CONSOL), F.lit(0.0)).alias("B"),
    )
    return hold(k), ex


def excel_tb(wb, name):
    """
    Rows + total on a Trial Balance tab (BS + IS tables).
    Skips known subtotal rows so ex_rows matches tab_rows from the DataFrame.
    """
    ws, on, col, n, tot = wb[name], False, None, 0, 0.0
    for r in ws.iter_rows(values_only=True):
        b = r[1] if len(r) > 1 else None
        if isinstance(b, str) and b.strip().upper() in ("BALANCE SHEET", "INCOME STATEMENT"):
            h   = [str(x).strip() if x is not None else "" for x in r]
            col = h.index(TOT_HDR) if TOT_HDR in h else None
            on  = True
            continue
        if on and b not in (None, ""):
            if isinstance(b, str) and b.strip().lower() in SUBTOTAL_PATTERNS:
                continue
            n  += 1
            v   = r[col] if col is not None and col < len(r) else None
            tot += float(v) if isinstance(v, (int, float)) else 0.0
    return n, tot


def _fill(c):
    return PatternFill("solid", fgColor=c)


def block(ws, r, title, cols, rows):
    """Title bar + header + banded rows starting at row r. Returns next free row."""
    n = len(cols)
    if n > 1:
        ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=n)
    for j in range(1, n + 1):
        ws.cell(r, j).fill = _fill(NAVY)
    ws.cell(r, 1, title).font = Font(bold=True, color="FFFFFF")
    for j, c in enumerate(cols, 1):
        h = ws.cell(r + 1, j, c)
        h.font, h.fill = Font(bold=True, color="FFFFFF"), _fill(BLUE)
        h.alignment   = Alignment(horizontal="center", vertical="center")
    for i, row in enumerate(rows):
        for j, c in enumerate(cols, 1):
            v = row.get(c)
            if isinstance(v, np.generic): v = v.item()
            if isinstance(v, float) and v != v: v = None             # NaN -> blank
            cell = ws.cell(r + 2 + i, j, v)
            if i % 2 == 0: cell.fill = _fill(BAND)
            if isinstance(v, bool): pass
            elif isinstance(v, int) and c != "RowId": cell.number_format = "#,##0"
            elif isinstance(v, float):                cell.number_format = ACC
            if c == "Status" and v in STATUS_FILL:
                cell.fill, cell.font = _fill(STATUS_FILL[v]), Font(bold=True)
    return r + len(rows) + 3


def records(pdf):
    return pdf.astype(object).where(pdf.notna(), None).to_dict("records")


def collect_check(sheet_key, period, sdf, col_map):
    """
    Pull rows from a Spark DF and append them to CHECK_DETAIL[sheet_key].
    col_map: dict {output_col_name: spark_col_expr_or_col_name}
    """
    exprs = [F.col(v).alias(k) if isinstance(v, str) else v.alias(k)
             for k, v in col_map.items()]
    pdf   = sdf.select(*exprs).toPandas()
    if pdf.empty:
        return
    pdf.insert(0, "Period", period)
    CHECK_DETAIL[sheet_key].extend(records(pdf))


def detail_sheet(wb, sheet_key, title, cols, rows):
    """Write one check-detail sheet; skip silently if no rows."""
    if not rows:
        return
    ws = wb.create_sheet(sheet_key[:31])
    ws.sheet_view.showGridLines = False
    block(ws, 1, title, cols, rows)
    ws.column_dimensions["A"].width = 14
    ws.column_dimensions["B"].width = 45
    for j in range(3, len(cols) + 1):
        ws.column_dimensions[get_column_letter(j)].width = 22
    ws.freeze_panes = "A3"


