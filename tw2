def _write_s3_data_row(
    ws, row_num: int, row_def: RowDef,
    ytd_val, qtd_val,
    col_variant: str,
):
    ws.row_dimensions[row_num].height = 15
    is_rx    = row_def.row_type in (RX, TOTAL)
    lbl_font = (make_font(BLACK, size=10, bold=True)
                if row_def.bold else FONT_BODY)

    # ── B: symbol ─────────────────────────────────────────────────────────────
    sym = {SIGMA: "\u03A3", RX: "Rx", TOTAL: ""}.get(row_def.row_type, "")
    c_sym = ws.cell(row=row_num, column=S3_COL_SYMBOL, value=sym)
    c_sym.font      = FONT_SYM_RED if is_rx else FONT_SYM_BLUE
    c_sym.fill      = FILL_WHITE
    c_sym.alignment = ALIGN_CTR
    _apply_range_border(ws, row_num, S3_COL_SYMBOL, row_num, S3_COL_SYMBOL,
                        style="thin")

    # ── C: grouping code ──────────────────────────────────────────────────────
    code_display = "+".join(row_def.codes) if row_def.codes else ""
    c_code = ws.cell(row=row_num, column=S3_COL_CODE, value=code_display)
    c_code.font      = FONT_BLUE_BOLD if code_display else FONT_BODY
    c_code.fill      = FILL_WHITE
    c_code.alignment = ALIGN_CTR
    _apply_range_border(ws, row_num, S3_COL_CODE, row_num, S3_COL_CODE,
                        style="thin")

    # ── D: label ──────────────────────────────────────────────────────────────
    c_lbl = ws.cell(row=row_num, column=S3_COL_REF, value=row_def.label)
    c_lbl.font      = lbl_font
    c_lbl.fill      = FILL_WHITE
    c_lbl.alignment = ALIGN_LEFT
    _apply_range_border(ws, row_num, S3_COL_REF, row_num, S3_COL_REF,
                        style="thin")

    # ── value helper ──────────────────────────────────────────────────────────
    def _val_cell(col, val, rounded=False):
        c = ws.cell(row=row_num, column=col)
        if val is not None:
            c.value = float(round(val / MILLION, 1)) if rounded else float(val)
        c.font         = lbl_font
        c.fill         = GREEN_FILL if rounded else FILL_WHITE
        c.alignment    = ALIGN_RIGHT
        c.number_format = ROUNDED_FMT if rounded else MONEY_FMT
        _apply_range_border(ws, row_num, col, row_num, col, style="thin")

    _val_cell(S3_COL_YTD_BAL, ytd_val, rounded=False)
    _val_cell(S3_COL_YTD_RND, ytd_val, rounded=True)

    if col_variant == "4col":
        _val_cell(S3_COL_QTD_BAL, qtd_val, rounded=False)
        _val_cell(S3_COL_QTD_RND, qtd_val, rounded=True)



