def _tot(cols):
    exprs = [F.coalesce(F.col(c).cast("double"), F.lit(0.0)) for c in cols]
    return reduce(lambda a, b: a + b, exprs)


def _scalar(df, expr):
    return float(df.agg(F.coalesce(F.sum(expr), F.lit(0.0))).first()[0])


