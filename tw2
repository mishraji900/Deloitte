def make_output_path(acct_group: str) -> str:
    """Create the output workbook path for an account group."""
    output_dir = workbook_config()["output_directory"]

    # Remove filename-unsafe characters and normalize spaces for the output filename.
    clean_name = re.sub(r"[^\w\s-]", "", acct_group).strip()
    clean_name = re.sub(r"\s+", "_", clean_name).strip("_")

    os.makedirs(output_dir, exist_ok=True)

    return os.path.join(
        output_dir,
        f"Risk_Assessment_{clean_name}.xlsx",
    )


def make_sheet_name(acct_group: str, suffix: str) -> str:
    """Create an Excel-safe worksheet name within Excel's 31-character limit."""
    # Remove characters that Excel does not permit in worksheet names.
    clean_name = re.sub(r"[\[\]:*?/\\]", "", acct_group).strip()

    # Reserve space for the separator and suffix before truncating the account group.
    max_name_length = 31 - len(suffix) - 1

    return f"{clean_name[:max_name_length]}-{suffix}"


def copy_sheet_from_template(wb, template_name: str, new_name: str):
    """Copy a template worksheet and assign it a new name."""
    if template_name not in wb.sheetnames:
        raise KeyError(
            f"Template worksheet '{template_name}' was not found. "
            f"Available sheets: {wb.sheetnames}"
        )

    if new_name in wb.sheetnames:
        return wb[new_name]

    new_ws = wb.copy_worksheet(wb[template_name])
    new_ws.title = new_name
    return new_ws


def load_template_workbook(template_path: str):
    """Load a workbook using the managed cp.openpyxl interface."""
    return cp.openpyxl.read(template_path)


def save_output_workbook(wb, output_path: str) -> None:
    """Save a workbook through the managed environment or standard openpyxl."""
    cp.openpyxl.write(wb, output_path, register=True)
    return


