from openpyxl import Workbook
from openpyxl.styles import Border, Side, Font, Alignment, PatternFill

COMPANIES = [
    "Dealerweb LLC", "Institutional Cash Distributors LLC", "Tradeweb Direct LLC",
    "Tradeweb Europe Limited", "Tradeweb LLC", "Tradeweb Markets LLC", "TW SEF",
]
DISPLAY_SUMMARIES = True

SUMMARY_DATASETS = {
    "Same Quarter Match": P1_ALL_MATCHED,
    "Previous Quarter Match": P2_ALL_MATCHED.filter(is_current_period),
    "Same PK Lag > 2 Month Match": P3_ALL_MATCHED.filter(is_current_period),
    "Unmatched": P4_ALL_UNMATCHED_COMMENTED.filter(is_current_period),
}

# Key = output group, value = account descriptions rolled into it. Unlisted accounts get their own group.
ACCOUNT_GROUPS = {
    "Commissions": ["Commissions - Fixed", "Commissions - Variable"],
    "Contra Revenue": ["Contra Revenue - Subscription Fees - Fixed",
                       "Contra Revenue Commissions - Tech Credits - Variable",
                       "Contra Revenue Commissions - Variable"],
    "Other Revenue": ["Other Revenue - Fixed", "Other Revenue - Fixed - LSEG", "Other Revenue - Variable"],
    "Subscription Fees": ["Subscription Fees - Fixed", "Subscription Fees - Fixed - LSEG",
                          "Subscription Fees - Variable"],
    "Transaction Fees": ["Transaction Fees - Fixed", "Transaction Fees - Variable"],
}


def _normalize_text(value):
    if value is None:
        return ""
    return re.sub(r"\s+", " ", str(value).strip().replace("–", "-").replace("—", "-")).upper()


GROUP_LOOKUP = {_normalize_text(m): g for g, ms in ACCOUNT_GROUPS.items() for m in ms}


def _group_name_for_account(account_desc):
    return GROUP_LOOKUP.get(_normalize_text(account_desc), account_desc.strip() if account_desc else "Unmapped")


def _safe_sheet_name(name: str) -> str:
    cleaned = re.sub(r"[\[\]\:\*\?\/\\]", "_", str(name)).strip()
    return cleaned[:31] if cleaned else "Sheet"


def _with_je_category(df):
    if "JE Category" in df.columns:
        return df.withColumn("JE Category", F.when(F.trim(F.col("JE Category")) == "", F.lit("Blank"))
                             .otherwise(F.coalesce(F.trim(F.col("JE Category")), F.lit("Blank"))))
    return df.withColumn("JE Category", F.lit("Unspecified"))


# ONE aggregation job per dataset (was ~200 collect() jobs). Amounts parsed with to_decimal_clean so
# accounting-style "(123.45)" is not silently dropped.
_aggs = []
for _name, _df in SUMMARY_DATASETS.items():
    _aggs.append(
        _with_je_category(_df)
        .withColumn("_co", F.upper(F.trim(F.col("Company Description"))))
        .withColumn("_acct", F.trim(F.col("Account Description")))
        .groupBy("_co", "_acct", "JE Category")
        .agg(F.count("primary_key").alias("cnt"),
             F.sum(to_decimal_clean("Entered Dr")).cast("double").alias("dr"),
             F.sum(to_decimal_clean("Entered CR")).cast("double").alias("cr"),
             F.sum(to_decimal_clean("Net Entered")).cast("double").alias("net"))
        .withColumn("sheet", F.lit(_name)))
AGG = union_non_null(*_aggs).toPandas()
AGG[["dr", "cr", "net"]] = AGG[["dr", "cr", "net"]].fillna(0.0)
AGG["cnt"] = AGG["cnt"].fillna(0).astype(int)

SUMMARY_COLS = ["Sheet Name / Section", "JE Category", "Count", "Entered Dr", "Entered CR", "Net Entered"]


def build_company_summary(company_desc: str):
    """Rows: [Sheet Name / Section, JE Category, Count, Entered Dr, Entered CR, Net Entered]."""
    comp = AGG[AGG["_co"] == company_desc.strip().upper()]
    accts = sorted({a for a in comp["_acct"].dropna() if a.strip()})
    grouped = {}
    for a in accts:
        grouped.setdefault(_group_name_for_account(a), []).append(a)
    order = (["Total"] + [g for g in ACCOUNT_GROUPS if g in grouped]
             + sorted(g for g in grouped if g not in ACCOUNT_GROUPS))

    rows = []
    for grp in order:
        rows.append([f"Account Grouping: {grp}", None, None, None, None, None])
        rows.append(["Sheet Name", "JE Category", "Count", "Entered Dr", "Entered CR", "Net Entered"])
        g_tot = [0, 0.0, 0.0, 0.0]
        members = None if grp == "Total" else grouped[grp]
        for sheet in SUMMARY_DATASETS:
            sub = comp[comp["sheet"] == sheet]
            if members is not None:
                sub = sub[sub["_acct"].isin(members)]
            by_je = sub.groupby("JE Category", sort=True)[["cnt", "dr", "cr", "net"]].sum()
            s_tot = [0, 0.0, 0.0, 0.0]
            if len(by_je):
                first = True
                for je, r in by_je.iterrows():
                    vals = [int(r["cnt"]), float(r["dr"]), float(r["cr"]), float(r["net"])]
                    s_tot = [a + b for a, b in zip(s_tot, vals)]
                    rows.append([sheet if first else "", je] + vals)
                    first = False
            else:
                rows.append([sheet, "No Data", 0, 0.0, 0.0, 0.0])
            g_tot = [a + b for a, b in zip(g_tot, s_tot)]
            rows.append([f"{sheet} Total", ""] + s_tot)
        rows.append(["Group Total", ""] + g_tot)
        rows.append([None] * 6)
    if rows and all(v is None for v in rows[-1]):
        rows.pop()
    return rows


def _rows_to_display_df(rows):
    schema = T.StructType([T.StructField(n, T.StringType()) for n in SUMMARY_COLS])
    return spark.createDataFrame([[None if v is None else str(v) for v in r] for r in rows], schema)


def _apply_summary_format(ws, company_desc, rows):
    thin, double = Side(border_style="thin", color="000000"), Side(border_style="double", color="000000")
    title_font = Font(name="Calibri", sz=11, bold=True)
    header_font = Font(name="Calibri", sz=9, bold=True, color="00FFFFFF")
    section_font = Font(name="Calibri", sz=9, bold=True)
    cell_font = Font(name="Calibri", sz=9)
    subtotal_font = Font(name="Calibri", sz=9, bold=True)
    header_fill = PatternFill("solid", fgColor="00000000")
    subtotal_fill = PatternFill("solid", fgColor="00D9E1F2")
    left_alignment = Alignment(wrap_text=False, vertical="center")
    center_alignment = Alignment(wrap_text=True, vertical="center", horizontal="center")
    cell_alignment = Alignment(wrap_text=True, vertical="center")
    border_thin = Border(top=thin, left=thin, right=thin, bottom=thin)
    border_subtotal = Border(top=thin, left=thin, right=thin, bottom=double)
    CNT_FMT, USD_FMT = "#,##0;-#,##0", "$ #,##0.00;$ (#,##0.00)"

    ws.sheet_view.showGridLines = False
    ws.sheet_view.zoomScale = 100
    ws.sheet_format.defaultRowHeight = 12
    for col, width in zip("ABCDEFG", [2.4, 28, 24, 12, 16, 16, 16]):
        ws.column_dimensions[col].width = width

    ws["B2"] = f"Account Description Summary - {CURRENT_FY} {CURRENT_QUARTER}"
    ws["B3"] = company_desc
    for ref in ("B2", "B3"):
        ws[ref].font, ws[ref].alignment = title_font, left_alignment

    def numfmt(cell, col_idx):
        if col_idx == 4:
            cell.number_format = CNT_FMT
        elif col_idx >= 5:
            cell.number_format = USD_FMT

    for idx, row_values in enumerate(rows):
        r = 7 + idx
        first = row_values[0]
        for ci, v in enumerate(row_values, start=2):
            c = ws.cell(row=r, column=ci, value=v)
            c.font, c.alignment = cell_font, cell_alignment
        if first is None:
            continue
        for ci in range(2, 8):
            c = ws.cell(row=r, column=ci)
            if isinstance(first, str) and first.startswith("Account Grouping:"):
                c.font, c.alignment = section_font, left_alignment
            elif first == "Sheet Name":
                c.font, c.fill, c.alignment, c.border = header_font, header_fill, center_alignment, border_thin
            elif isinstance(first, str) and first.endswith(" Total") and first != "Group Total":
                c.font, c.fill, c.border = subtotal_font, subtotal_fill, border_subtotal
                c.alignment = cell_alignment if ci > 2 else left_alignment
                numfmt(c, ci)
            elif first == "Group Total":
                c.font, c.fill, c.border = header_font, header_fill, border_subtotal
                c.alignment = center_alignment if ci > 2 else left_alignment
                numfmt(c, ci)
            else:
                c.font, c.border = cell_font, border_thin
                numfmt(c, ci)


def write_summary_workbook(path: str, show_displays: bool = False):
    wb = Workbook()
    wb.remove(wb.active)
    for company in COMPANIES:
        ws = wb.create_sheet(_safe_sheet_name(company.replace("Tradeweb ", "TW ").replace(" ", "")))
        rows = build_company_summary(company)
        _apply_summary_format(ws, company, rows)
        if show_displays:
            print(f"\nSummary for: {company}")
            display(_rows_to_display_df(rows))
    if "cp" in globals() and hasattr(cp, "openpyxl"):
        cp.openpyxl.write(wb, path, register=True)
    else:
        wb.save(path)
    if show_displays:
        display(spark.createDataFrame([(path,)], ["Workbook Path"]))


write_summary_workbook(f"{output_path_et}/Account_Description_Summary - {CURRENT_FY} {CURRENT_QUARTER}.xlsx",
                       show_displays=DISPLAY_SUMMARIES)

