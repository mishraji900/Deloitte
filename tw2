# ── 1F. Table building blocks (rarely edited) + the tables themselves ─────────
@dataclass
class Row:
    kind:   str            # sigma | calc | total | subtitle | blank | sub_header | py
    key:    str = ""       # unique id, other rows use it in formulas
    label:  str = ""       # text in "References" column
    codes:  str = ""       # sigma only: grouping codes to add, e.g. "D+E"
    formula: str = ""      # calc/total only: e.g. "rev - tot_opex"
    bold:   bool = False
    py_ref: str = ""       # py only: text shown in the code column


def sigma(key, codes, label):
    """Value = sum of these grouping codes, straight from the trial balance."""
    return Row("sigma", key, label, codes=codes)

def calc(key, label, formula, bold=True):
    """Value = Excel formula over other row keys. Shows an 'Rx' symbol."""
    return Row("calc", key, label, formula=formula, bold=bold)

def total(key, label, formula):
    """Same as calc but with no symbol (a visual 'Total' line)."""
    return Row("total", key, label, formula=formula, bold=True)

def py(label, ref):        return Row("py", label=label, py_ref=ref)   # manual entry
def subtitle(label):       return Row("subtitle", label=label)         # grey band
def blank():               return Row("blank")                          # small gap
def sub_header():          return Row("sub_header")                     # repeat column headers


