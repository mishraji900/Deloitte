def write_materiality_multiple_table(
    ws,
    row: int,
    group_totals: dict,
    table_cfg: dict,
    acct_group: str,
) -> int:
    """Write a materiality-multiple table and return its next available row."""

    formatting = REPORT_CONFIG["formatting"]

    # Convert materiality from dollars to millions to match table values.
    materiality_millions = materiality_config()["materiality"] / 1e6

    if materiality_millions == 0:
        raise ValueError("Materiality cannot be zero.")

    start_column = 2
    label_column = start_column
    period_start_column = start_column + 1

    periods = table_cfg["periods"]
    label_key = table_cfg["label_key"]

    write_cell(
        ws,
        row,
        label_column,
        table_cfg["title"],
        font=BOLD_ITALIC,
        align=LEFT,
    )

    row += 2

    headers = [
        table_cfg["row_label"],
        *[
            period_label(period_id, label_key)
            for period_id in periods
        ],
    ]

    include_commentary = table_cfg.get("include_commentary", False)

    if include_commentary:
        headers.append(table_cfg.get("commentary_label", "Commentary"))

    for index, header in enumerate(headers):
        write_cell(
            ws,
            row,
            start_column + index,
            header,
            font=HDR_FONT,
            border=THIN_ALL,
            align=LEFT if index == 0 else CENTER,
        )

    row += 1
    data_start_row = row

    # Resolve each logical period to its source-data column once for reuse.
    period_columns = {
        period_id: period_column(period_id)
        for period_id in periods
    }

    if table_cfg.get("include_total", False):
        total_values = []

        for period_id in periods:
            source_column = period_columns[period_id]

            # Aggregate the selected source column across all reporting groups.
            period_total = sum(
                totals.get(source_column, 0.0)
                for totals in group_totals.values()
            )

            # Convert the aggregated dollar value to millions.
            period_total_millions = period_total / 1e6

            # Express the period total as a multiple of materiality.
            total_value = period_total_millions / materiality_millions

            total_values.append(total_value)

        write_cell(
            ws,
            row,
            label_column,
            table_cfg.get(
                "total_label_template",
                "Total {acct_group}",
            ).format(acct_group=acct_group),
            font=BOLD,
            border=THIN_ALL,
            align=LEFT,
        )

        for index, value in enumerate(total_values):
            write_cell(
                ws,
                row,
                period_start_column + index,
                value,
                font=BOLD,
                border=THIN_ALL,
                fmt=formatting["million_format"],
                align=RIGHT,
            )

        if include_commentary:
            write_cell(
                ws,
                row,
                period_start_column + len(periods),
                None,
                font=BOLD,
                border=THIN_ALL,
                align=LEFT_WRAP,
            )

        row += 1

    for group_name, totals in group_totals.items():
        write_cell(
            ws,
            row,
            label_column,
            group_name,
            font=NORMAL,
            border=THIN_ALL,
            align=LEFT,
        )

        for index, period_id in enumerate(periods):
            source_column = period_columns[period_id]

            # Retrieve the group's source balance for the selected period.
            period_value = totals.get(source_column, 0.0)

            # Convert the balance from dollars to millions.
            period_value_millions = period_value / 1e6

            # Divide by materiality in millions to calculate the multiple.
            value = period_value_millions / materiality_millions

            write_cell(
                ws,
                row,
                period_start_column + index,
                value,
                font=NORMAL,
                border=THIN_ALL,
                fmt=formatting["million_format"],
                align=RIGHT,
            )

        if include_commentary:
            write_cell(
                ws,
                row,
                period_start_column + len(periods),
                None,
                font=NORMAL,
                border=THIN_ALL,
                align=LEFT_WRAP,
            )

        row += 1

    if include_commentary and row > data_start_row:
        commentary_column = period_start_column + len(periods)

        # Merge the commentary area vertically across the table's data rows.
        write_merged_box(
            ws,
            data_start_row,
            commentary_column,
            row - 1,
            commentary_column,
            "",
            font=NORMAL,
            border=THIN_ALL,
            align=LEFT_WRAP,
        )

    # Leave a blank spacer before the next dynamically positioned section.
    return row + 2


