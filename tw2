# 9-J  Updated _write_s3_table  — handles SUB_HDR rows
#      Replaces the version defined in 9-F above
# ══════════════════════════════════════════════════════════════════════════════

def _write_s3_table(                              # noqa: F811
    ws, table: TableDef, start_row: int,
    ytd_lookup: dict, qtd_lookup: dict,
) -> int:
    last_col = S3_COL_LAST_4 if table.col_variant == "4col" else S3_COL_LAST_2

    # ── note-only table (FN 1) ────────────────────────────────────────────────
    if table.col_variant == "note":
        return _write_note_only_table(ws, start_row, table.title, S3_COL_LAST_2)

    # ── title band ────────────────────────────────────────────────────────────
    _write_s3_title_banner(ws, start_row, table.title, last_col)

    # ── column header + source-tag rows ──────────────────────────────────────
    _write_s3_col_headers(ws, start_row + 1, table.col_variant)
    _write_s3_source_tags(ws, start_row + 2, table.col_variant)

    cur_row  = start_row + 3
    computed: dict[str, Decimal | None] = {}

    for row_def in table.rows:

        # ── blank spacer ──────────────────────────────────────────────────────
        if row_def.row_type == BLANK:
            ws.row_dimensions[cur_row].height = 6
            cur_row += 1
            continue

        # ── italic subtitle band ──────────────────────────────────────────────
        if row_def.row_type == SUBTITLE:
            ws.row_dimensions[cur_row].height = 14
            c = ws.cell(row=cur_row, column=S3_COL_REF, value=row_def.label)
            _s3_apply(c, font=ITALIC_BOLD, fill=FILL_LIGHT_GREY,
                      border=BORDER_HAIR, align=ALIGN_LEFT)
            cur_row += 1
            continue

        # ── sub-table re-header (two rows: header + source tag) ───────────────
        if row_def.row_type == SUB_HDR:
            _write_sub_header(ws, cur_row, table.col_variant)
            cur_row += 2   # consumes two rows
            continue

        # ── PY manual-entry row ───────────────────────────────────────────────
        if row_def.row_type == PY:
            _write_s3_py_row(ws, cur_row, row_def, table.col_variant)
            cur_row += 1
            continue

        # ── SIGMA / RX / TOTAL data row ───────────────────────────────────────
        ytd_val = _resolve(row_def, ytd_lookup, computed)
        qtd_val = (_resolve(row_def, qtd_lookup, computed)
                   if table.col_variant == "4col" else None)

        computed[row_def.row_key] = ytd_val

        _write_s3_data_row(
            ws, cur_row, row_def, ytd_val, qtd_val, table.col_variant
        )
        cur_row += 1

    return cur_row + 2   # two-row gap after every table
