    )

    entity_columns = s3a_find_entity_columns(
        updated_raw_tb_CY=updated_raw_tb_CY,
        row_id_col=row_id_col,
    )

    input_materiality_value = s3a_to_decimal(
        materiality
    )

    if input_materiality_value in {
        None,
        Decimal("0"),
    }:
        raise ValueError(
            "MATERIALITY must be non-zero."
        )

    # â”€â”€ Write THRESHOLD_VALUE into C7 so every in-sheet formula
    #    that references $C$7 always resolves against the correct
    #    value, regardless of what was previously in the cell.
    mat_coord = MATERIALITY_CELL.replace("$", "")          # â†’ "C7"
    worksheet[mat_coord].value = float(input_materiality_value)
    
    formula_materiality_value = (
        s3a_get_sheet_materiality(
            worksheet=worksheet,
            fallback_value=input_materiality_value,
        )
    )

    tab2_row_lookup = s3a_build_tab2_row_lookup(
        template
    )

    blue_exact_pairs, blue_normalized_pairs = (
        s3a_build_blue_pair_lookups(
            spark_column_row_pairs_cy=(
                spark_column_row_pairs_cy
            ),
            row_id_col=row_id_col,
        )
    )

    header_row, start_column = coordinate_to_tuple(
        ANCHOR_CELL
    )

    if start_column != 2:
        raise ValueError(
            "Sheet 3a must start in column B."
        )

    last_entity_column = (
        start_column + len(entity_columns)
    )
    total_column = last_entity_column + 1
    tab2_column = total_column + 1
    output_end_column = tab2_column + 1
    difference_column = output_end_column

    source_max_column = worksheet.max_column

    required_end_row = (
        header_row
        + max(len(residual_rows), 1)
        * BLOCK_HEIGHT
        - 1
    )

    if required_end_row > worksheet.max_row:
        worksheet.insert_rows(
            worksheet.max_row + 1,
            amount=required_end_row - worksheet.max_row,
        )

    s3a_clear_existing_values(
        worksheet=worksheet,
        start_row=header_row,
        start_column=start_column,
        end_row=max(
            worksheet.max_row,
            required_end_row,
        ),
        end_column=max(
            worksheet.max_column,
            output_end_column,
        ),
    )

    s3a_clear_conditional_formatting(
        worksheet
    )

    all_investigate_coordinates = []

    for index, residual_row in enumerate(
        residual_rows
    ):
        block_start_row = (
            header_row + index * BLOCK_HEIGHT
        )

        s3a_copy_block_style(
            worksheet=worksheet,
            source_start_row=header_row,
            target_start_row=block_start_row,
            start_column=start_column,
            end_column=output_end_column,
            source_max_column=source_max_column,
        )

        investigate_coordinates = s3a_write_block(
            worksheet=worksheet,
            block_start_row=block_start_row,
            record=residual_row["record"],
            account_column=account_column,
            source_row_id=residual_row["row_id"],
            entity_columns=entity_columns,
            blue_exact_pairs=blue_exact_pairs,
            blue_normalized_pairs=blue_normalized_pairs,
            tab2_row_lookup=tab2_row_lookup,
        )

        all_investigate_coordinates.extend(
            investigate_coordinates
        )

        s3a_wipe_spacer_rows(
            worksheet=worksheet,
            spacer_start_row=(
                block_start_row + DATA_ROWS
            ),
            start_column=start_column,
            end_column=difference_column,
        )

    s3a_apply_all_investigate_colors(
        worksheet=worksheet,
        investigate_coordinates=(
            all_investigate_coordinates
        ),
    )

    try:
        template.calculation.fullCalcOnLoad = True
        template.calculation.forceFullCalc = True
        template.calculation.calcMode = "auto"
    except AttributeError:
        pass

    missing_tab2_accounts = [
        residual_row["Account_CY"]
        for residual_row in residual_rows
        if s3a_normalize_account(
            residual_row["Account_CY"]
        ) not in tab2_row_lookup
    ]

    return {
        "entity_columns": entity_columns,
        "blocks_written": len(residual_rows),
        "tab2_accounts_found": len(tab2_row_lookup),
        "missing_tab2_accounts": missing_tab2_accounts,
        "accounts": [
            residual_row["Account_CY"]
            for residual_row in residual_rows
        ],
        "materiality_used": formula_materiality_value,
    }


# ================================================================
