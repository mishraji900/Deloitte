        f":{last_col_l}{ROW_SUB_HEADER}"
    )

    # â”€â”€ 7. Data rows â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    for e_idx, (entity, source) in enumerate(combined_entities):
        data_row = ROW_DATA_START + e_idx
        row_fill = _fill(_PY_ONLY) if source == "py_only" else _fill(_WHT)

        # Col B â€” Legal Entity label
        ec           = ws.cell(row=data_row, column=COL_ENTITY)
        ec.value     = str(entity).strip()
        ec.font      = _font_data()
        ec.fill      = row_fill
        ec.border    = _border()
        ec.alignment = _align("left")

        for a_idx, rec in enumerate(tab3b_rows):
            acct_key = _norm(
                str(rec.get("Account_CY") or rec.get("Account_PY") or "")
            )
            cs = COL_DATA_START + a_idx * N_SUB

            cy_rec = cy_lookup.get(acct_key, {})
            py_rec = py_lookup.get(acct_key, {})

            raw_cy = None if source == "py_only" else cy_rec.get(entity)
            raw_py = py_rec.get(entity)

            is_cy_grey = _is_grey(raw_cy)
            is_py_grey = _is_grey(raw_py)

            cy_val = None if is_cy_grey else _to_dec(raw_cy)
            py_val = None if is_py_grey else _to_dec(raw_py)

            cy_c  = ws.cell(row=data_row, column=cs)
            py_c  = ws.cell(row=data_row, column=cs + 1)
            dif_c = ws.cell(row=data_row, column=cs + 2)
            pct_c = ws.cell(row=data_row, column=cs + 3)
            inv_c = ws.cell(row=data_row, column=cs + 4)

            # Default style for all 5 sub-cells
            for cell in (cy_c, py_c, dif_c, pct_c, inv_c):
                cell.font   = _font_data()
                cell.fill   = row_fill
                cell.border = _border()

            # â”€â”€ RULE: CY grey â†’ all 5 cells greyed â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            if is_cy_grey:
                _write_grey_cell(cy_c)
                _write_grey_cell(py_c)
                _write_grey_cell(dif_c)
                _write_grey_cell(pct_c)
                _write_grey_cell(inv_c)
                continue

            # â”€â”€ CY balance â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            cy_c.value         = float(cy_val) if cy_val is not None else None
            cy_c.number_format = MONEY_FMT if cy_val is not None else "General"
            cy_c.alignment     = _align("right")

            # â”€â”€ RULE: PY grey â†’ PY + downstream greyed â”€â”€â”€â”€â”€â”€â”€â”€
            if is_py_grey:
                _write_grey_cell(py_c)
                _write_grey_cell(dif_c)
                _write_grey_cell(pct_c)
                _write_grey_cell(inv_c)
                continue

            # â”€â”€ PY balance â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            py_c.value         = float(py_val) if py_val is not None else None
            py_c.number_format = MONEY_FMT if py_val is not None else "General"
            py_c.alignment     = _align("right")

            cy_addr  = cy_c.coordinate
            py_addr  = py_c.coordinate
            dif_addr = dif_c.coordinate
            pct_addr = pct_c.coordinate

            # â”€â”€ Difference ($) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            dif_c.value = (
                f'=IF(ISNUMBER({cy_addr}),'
                f'IF(ISNUMBER({py_addr}),{cy_addr}-{py_addr},{cy_addr}),'
                f'IF(ISNUMBER({py_addr}),0-{py_addr},""))'
            )
            dif_c.number_format = MONEY_FMT
            dif_c.alignment     = _align("right")

            # â”€â”€ Difference (%) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            pct_c.value = (
                f'=IFERROR(IF(AND(ISNUMBER({cy_addr}),{cy_addr}<>0),'
                f'{dif_addr}/{cy_addr},'
                f'IF(ISNUMBER({py_addr}),1,0)),0)'
            )
            pct_c.number_format = PCT_FMT
            pct_c.alignment     = _align("right")

            # â”€â”€ Investigate? â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            inv_c.value = (
                f'=IFERROR(IF(AND(ABS({dif_addr})>{THRESHOLD_REF},'
                f'ABS({pct_addr})>0.15),"Yes","No"),"")'
            )
            inv_c.alignment = _align("center")

    # â”€â”€ 8. Conditional formatting â€” Investigate? column â”€â”€â”€â”€â”€â”€â”€
    last_data_row = ROW_DATA_START + len(combined_entities) - 1
    for a_idx in range(len(tab3b_rows)):
        inv_l = get_column_letter(COL_DATA_START + a_idx * N_SUB + 4)
        rng   = f"{inv_l}{ROW_DATA_START}:{inv_l}{last_data_row}"
        ws.conditional_formatting.add(
            rng,
            FormulaRule(
                formula    = [f'{inv_l}{ROW_DATA_START}="Yes"'],
                fill       = PatternFill(fill_type="solid", fgColor=_RED_FILL),
                stopIfTrue = True,
            ),
        )
        ws.conditional_formatting.add(
            rng,
            FormulaRule(
                formula    = [f'{inv_l}{ROW_DATA_START}="No"'],
                fill       = PatternFill(fill_type="solid", fgColor=_GRN_FILL),
                stopIfTrue = True,
            ),
        )

    # â”€â”€ 9. Column widths + freeze panes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    ws.column_dimensions[get_column_letter(COL_ENTITY)].width = 28
    for a_idx in range(len(tab3b_rows)):
        for s, w in enumerate([14, 14, 15, 13, 13]):
            ws.column_dimensions[
                get_column_letter(COL_DATA_START + a_idx * N_SUB + s)
            ].width = w

    ws.freeze_panes = ws.cell(row=ROW_DATA_START, column=COL_DATA_START)

    # â”€â”€ Summary â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    names = [
        str(r.get("Account_CY") or r.get("Account_PY") or "").strip()
        for r in tab3b_rows
    ]
    print(f"[3b] Accounts written  : {len(tab3b_rows)} â†’ {names}")
    print(
        f"[3b] Total entity rows : {len(combined_entities)} "
        f"(CY: {len(cy_entity_cols)}, PY-only appended: {py_only_count})"
    )

    return {
        "sheet"               : SHEET_3B,
        "tab3b_accounts"      : names,
        "accounts_written"    : len(tab3b_rows),
        "entity_rows_cy"      : len(cy_entity_cols),
        "entity_rows_py_only" : py_only_count,
        "entity_rows_total"   : len(combined_entities),
    }


