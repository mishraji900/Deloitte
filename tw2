    lbl_font = (make_font(BLACK, size=10, bold=True)
                if row_def.bold else FONT_BODY)

    # B  – symbol
    sym = {SIGMA: "Σ", RX: "Rx", TOTAL: ""}.get(row_def.row_type, "")
    c_sym = ws.cell(row=row_num, column=S4_COL_SYMBOL, value=sym)
    c_sym.font      = FONT_SYM_RED if is_rx else FONT_SYM_BLUE
    c_sym.fill      = FILL_WHITE
    c_sym.alignment = ALIGN_CTR
    _apply_range_border(ws, row_num, S4_COL_SYMBOL, row_num, S4_COL_SYMBOL,
                        style="thin")

    # C  – grouping code
    code_display = "+".join(row_def.codes) if row_def.codes else ""
    c_code = ws.cell(row=row_num, column=S4_COL_CODE, value=code_display)
    c_code.font      = FONT_BLUE_BOLD if code_display else FONT_BODY
    c_code.fill      = FILL_WHITE
    c_code.alignment = ALIGN_CTR
    _apply_range_border(ws, row_num, S4_COL_CODE, row_num, S4_COL_CODE,
                        style="thin")

    # D  – label
    c_ref = ws.cell(row=row_num, column=S4_COL_REF, value=row_def.label)
    c_ref.font      = lbl_font
    c_ref.fill      = FILL_WHITE
    c_ref.alignment = ALIGN_LEFT
    _apply_range_border(ws, row_num, S4_COL_REF, row_num, S4_COL_REF,
                        style="thin")

    # E  – thin spacer (no value, no border)
    ws.cell(row=row_num, column=5).fill = FILL_WHITE

    # F  – raw balance  (dollar format)
    if val is not None:
        c_bal = ws.cell(row=row_num, column=S4_COL_BAL,
                        value=float(val))
        c_bal.number_format = '_($* #,##0.00_);_($* (#,##0.00);_($* "-"??_);_(@_)'
    else:
        c_bal = ws.cell(row=row_num, column=S4_COL_BAL, value=None)
    c_bal.font      = FONT_BODY
    c_bal.fill      = FILL_WHITE
    c_bal.alignment = ALIGN_RIGHT
    _apply_range_border(ws, row_num, S4_COL_BAL, row_num, S4_COL_BAL,
                        style="thin")

    # G  – rounded value (millions, 1 dp)  – green fill
    if val is not None:
        rounded = float(val / MILLION)
        c_rnd = ws.cell(row=row_num, column=S4_COL_RND, value=rounded)
        c_rnd.number_format = ROUNDED_FMT
    else:
        c_rnd = ws.cell(row=row_num, column=S4_COL_RND, value=None)
    c_rnd.font      = make_font(BLACK, size=10, bold=is_rx)
    c_rnd.fill      = GREEN_FILL
    c_rnd.alignment = ALIGN_RIGHT
    _apply_range_border(ws, row_num, S4_COL_RND, row_num, S4_COL_RND,
                        style="thin")


# ------------------------------------------------------------------------------
# 10-E  Side mini-table: [1] Allowance for doubtful accounts  (code BK)
#        Positioned starting at row 11 (aligns with the first AP data row),
#        columns I–N.  Uses the TB_12312025 (prior period) ytd balance for BK.
# ------------------------------------------------------------------------------

def _write_s4_side_table(ws, bk_val: Decimal | None, start_row: int) -> None:
    
    # Row caption "[1] Allowance for doubtful accounts:"
    caption_row = start_row
    ws.row_dimensions[caption_row].height = 14
    c_cap = ws.cell(row=caption_row, column=S4_SIDE_START,
                    value="[1] Allowance for doubtful accounts:")
    c_cap.font      = make_font(BLACK, size=10, bold=True)
    c_cap.fill      = FILL_WHITE
    c_cap.alignment = ALIGN_LEFT
    ws.merge_cells(start_row=caption_row, start_column=S4_SIDE_START,
                   end_row=caption_row,   end_column=S4_SIDE_LAST)

    # Header row
    hdr_row = start_row + 1
    ws.row_dimensions[hdr_row].height = 28

    def _hdr(col, text, red=False, merge_end=None):
        r, c_ = hdr_row, col
        c = ws.cell(row=r, column=c_, value=text)
        c.font      = FONT_HDR_RED if red else FONT_HDR_BLACK
        c.fill      = FILL_LIGHT_GREY
        c.alignment = Alignment(horizontal="center", vertical="center",
                                wrap_text=True)
        end_col = merge_end if merge_end else col
        if merge_end and merge_end != col:
            ws.merge_cells(start_row=r, start_column=col,
                           end_row=r,   end_column=merge_end)
        _apply_range_border(ws, r, col, r, end_col)

    _hdr(S4_SIDE_START, "Grouping Code", merge_end=S4_SIDE_CODE)
    _hdr(S4_SIDE_REF,   "References")
    _hdr(S4_SIDE_BAL,   "YTD 12/31/25\nBalances\n(In Millions)")
    _hdr(S4_SIDE_RND,   "Rounded\n(In Millions)", red=True)

    # Data row
    data_row = start_row + 2
    ws.row_dimensions[data_row].height = 15

    # Grouping Code "BK" — merged symbol+code cols
    ws.merge_cells(start_row=data_row, start_column=S4_SIDE_START,
                   end_row=data_row,   end_column=S4_SIDE_CODE)
    c_bk = ws.cell(row=data_row, column=S4_SIDE_START, value="BK")
    c_bk.font      = FONT_BLUE_BOLD
    c_bk.fill      = FILL_WHITE
    c_bk.alignment = ALIGN_CTR
    _apply_range_border(ws, data_row, S4_SIDE_START, data_row, S4_SIDE_CODE)

    # Reference label
    c_ref = ws.cell(row=data_row, column=S4_SIDE_REF,
                    value="Allowance for doubtful accounts")
    c_ref.font      = FONT_BODY
    c_ref.fill      = FILL_WHITE
    c_ref.alignment = ALIGN_LEFT
    _apply_range_border(ws, data_row, S4_SIDE_REF, data_row, S4_SIDE_REF)

    # Raw balance
    if bk_val is not None:
        c_bal = ws.cell(row=data_row, column=S4_SIDE_BAL,
                        value=float(bk_val))
        c_bal.number_format = '_($* #,##0.00_);_($* (#,##0.00);_($* "-"??_);_(@_)'
    else:
        c_bal = ws.cell(row=data_row, column=S4_SIDE_BAL, value=None)
    c_bal.font      = FONT_BODY
    c_bal.fill      = FILL_WHITE
    c_bal.alignment = ALIGN_RIGHT
    _apply_range_border(ws, data_row, S4_SIDE_BAL, data_row, S4_SIDE_BAL)

    # Rounded (green fill)
    if bk_val is not None:
        rounded = float(bk_val / MILLION)
        c_rnd = ws.cell(row=data_row, column=S4_SIDE_RND, value=rounded)
        c_rnd.number_format = ROUNDED_FMT
    else:
        c_rnd = ws.cell(row=data_row, column=S4_SIDE_RND, value=None)
    c_rnd.font      = FONT_BODY
    c_rnd.fill      = GREEN_FILL
    c_rnd.alignment = ALIGN_RIGHT
    _apply_range_border(ws, data_row, S4_SIDE_RND, data_row, S4_SIDE_RND)


# ------------------------------------------------------------------------------
# 10-F  Check-digit row writer
#        "check digit should be zero" = TLSE_rounded_raw − TLSE_rounded_in_millions
#        Per the image it appears 2 rows below the TLSE data line, in col F only.
# ------------------------------------------------------------------------------

def _write_s4_check_digit(
    ws,
    row_num: int,
    ta_val:   Decimal | None,   # Total assets  (raw $)
    tlse_val: Decimal | None,   # Total liabilities and stockholders' equity (raw $)
) -> None:
    """
    Row layout (mirrors the screenshot):

      col D–F  (merged)  │ italic blue  "check digit should be zero"
      col G              │ whole-dollar diff = Total assets − Total L&SE
                         │ positive→ plain number, negative→ (parentheses)
                         │ NO green fill on this row — white background

    The value is intentionally left in raw dollars (not millions) so that a
    non-zero result shows the exact dollar discrepancy between TB assets and
    TB liabilities+equity, making it easy to investigate.
    """
    ws.row_dimensions[row_num].height = 15

    # ── Label: cols D–F merged, italic blue centred ──────────────────────────
    ws.merge_cells(
        start_row=row_num, start_column=S4_COL_REF,
        end_row=row_num,   end_column=S4_COL_BAL,
    )
    c_lbl = ws.cell(
        row=row_num, column=S4_COL_REF,
        value="check digit should be zero",
    )
    c_lbl.font      = Font(name="Calibri", size=10, italic=True,
                           color="FF0070C0")   # blue italic — matches screenshot
    c_lbl.fill      = FILL_WHITE
    c_lbl.alignment = ALIGN_CTR
    # thin outer border on the merged label cell
    _apply_range_border(ws, row_num, S4_COL_REF, row_num, S4_COL_BAL,
                        style="thin")

    # ── Value: col G  (white fill — NOT green on check-digit row) ────────────
    if ta_val is not None and tlse_val is not None:
        # raw dollar difference — keeps full precision
        check = float(ta_val - tlse_val)
    else:
        check = None

    c_chk = ws.cell(row=row_num, column=S4_COL_RND, value=check)
    c_chk.font          = Font(name="Calibri", size=10, bold=False,
                               color="FF000000")
    c_chk.fill          = FILL_WHITE                 # white, not green
    c_chk.alignment     = ALIGN_RIGHT
    c_chk.number_format = '#,##0;(#,##0)'            # whole number, negatives in ()
    _apply_range_border(ws, row_num, S4_COL_RND, row_num, S4_COL_RND,
                        style="thin")


# ------------------------------------------------------------------------------
# 10-G  Main Sheet-4 builder
# ------------------------------------------------------------------------------

S4_SHEET_NAME = "4) Balance Sheet Tieout"

def build_sheet4(wb: Workbook, ytd_df, prev_df) -> None:
    """
    Creates / overwrites the '4) Balance Sheet Tieout' worksheet.

    Parameters
    ----------
    wb       – openpyxl Workbook
    ytd_df   – TB_03312026  (3/31/2026 balances — balance-sheet point-in-time)
    prev_df  – TB_12312025  (used ONLY to fetch BK = allowance for doubtful accts)
    """
    # -- create or replace sheet -----------------------------------------------
    if S4_SHEET_NAME in wb.sheetnames:
        del wb[S4_SHEET_NAME]
    ws = wb.create_sheet(title=S4_SHEET_NAME)
    ws.sheet_view.showGridLines = False

    # -- column widths ---------------------------------------------------------
    col_widths = {
        1:  2,   # A  spacer
        2:  6,   # B  symbol
        3:  10,  # C  grouping code
        4:  46,  # D  references  (wide)
        5:  2,   # E  thin gap
        6:  20,  # F  3/31/26 balance
        7:  14,  # G  rounded  – green
        8:  3,   # H  gap before side table
        9:  6,   # I  side symbol
        10: 10,  # J  side code
        11: 36,  # K  side reference label
        12: 2,   # L  thin gap
        13: 18,  # M  side YTD balance
        14: 14,  # N  side rounded – green
    }
    for col_idx, width in col_widths.items():
        ws.column_dimensions[get_column_letter(col_idx)].width = width

    # -- page header rows 1–3 -------------------------------------------------
    headers = [
        ("Broadridge Financial Solutions, Inc.", 11, True),
        ("Q3\u201926 10-Q Tie Out",              11, True),
        ("3/31/2026",                            10, False),
    ]
    for r, (text, sz, bold) in enumerate(headers, start=1):
        ws.row_dimensions[r].height = 16
        c = ws.cell(row=r, column=S4_COL_SYMBOL, value=text)
        _s3_apply(c,
                  font=make_font(BLACK, size=sz, bold=bold),
                  fill=FILL_WHITE,
                  border=BORDER_NONE,
                  align=ALIGN_LEFT)

    # -- row 4: thin spacer ---------------------------------------------------
    ws.row_dimensions[4].height = 6

    # -- row 5: note box  (single row, cols B–G) ------------------------------
    ws.row_dimensions[5].height = 16
    note_text = (
        "Note: This tab is prepared by D&T to tie out the balance sheet "
        "within the Form 10-Q maintained at"
    )
    ws.merge_cells(start_row=5, start_column=S4_COL_SYMBOL,
                   end_row=5,   end_column=S4_COL_LAST)
    c_note = ws.cell(row=5, column=S4_COL_SYMBOL, value=note_text)
    _s3_apply(c_note,
              font=make_font(BLACK, size=10, bold=False),
              fill=FILL_WHITE,
              border=BORDER_STD,
              align=ALIGN_LEFT)

    # -- rows 6–6: spacer before table ----------------------------------------
    ws.row_dimensions[6].height = 6

    # -- row 7: table title band ----------------------------------------------
    TABLE_FIRST_ROW = 7
    _write_s3_title_banner(ws, TABLE_FIRST_ROW,
                           BS4_TABLE.title, S4_COL_LAST)

    # -- row 8: column headers ------------------------------------------------
    _write_s4_col_headers(ws, TABLE_FIRST_ROW + 1)

    # -- row 9: source tags ---------------------------------------------------
    _write_s4_source_tags(ws, TABLE_FIRST_ROW + 2)

    # -- build lookups  (Sheet 4 uses YTD 3/31/26 for main table) -------------
    ytd_lookup, _qtd_unused = _build_lookups(ytd_df, prev_df)
    prev_lookup, _          = _build_lookups(prev_df, prev_df)   # prev only for BK

    # -- data rows start at row 10 --------------------------------------------
    cur_row  = TABLE_FIRST_ROW + 3          # row 10
    computed: dict[str, Decimal | None] = {}

    # track the absolute Excel row where the first non-blank data row lands
    # (used to anchor the side table at the same vertical position)
    first_data_excel_row: int | None = None

    for row_def in BS4_TABLE.rows:

        # blank spacer
        if row_def.row_type == BLANK:
            ws.row_dimensions[cur_row].height = 6
            cur_row += 1
            continue

        # italic subtitle band
        if row_def.row_type == SUBTITLE:
            ws.row_dimensions[cur_row].height = 14
            c = ws.cell(row=cur_row, column=S4_COL_REF, value=row_def.label)
            _s3_apply(c,
                      font=ITALIC_BOLD,
                      fill=FILL_LIGHT_GREY,
                      border=BORDER_HAIR,
                      align=ALIGN_LEFT)
            # extend the subtitle band across all main-table cols
            for col in range(S4_COL_SYMBOL, S4_COL_LAST + 1):
                if col != S4_COL_REF:
                    cc = ws.cell(row=cur_row, column=col)
                    cc.fill   = FILL_LIGHT_GREY
                    cc.border = BORDER_HAIR
            cur_row += 1
            continue

        # resolve value
        val = _resolve(row_def, ytd_lookup, computed)
        computed[row_def.row_key] = val

        # record the first real data row (for side-table anchor)
        if first_data_excel_row is None:
            first_data_excel_row = cur_row

        _write_s4_data_row(ws, cur_row, row_def, val)
        cur_row += 1

    # -- "Total liabilities and stockholders' equity" is the last TOTAL row ---
    ta_val   = computed.get("bs4_ta")     # Total assets
    tlse_val = computed.get("bs4_tlse")   # Total liabilities and stockholders' equity

    cur_row += 1                          # row 47 → blank spacer
    ws.row_dimensions[cur_row].height = 6
    cur_row += 1                          # row 49 → check-digit row
    _write_s4_check_digit(ws, cur_row, ta_val, tlse_val)

    # -- side mini-table  ([1] Allowance for doubtful accounts) ---------------
    # Anchor it at the row where "Cash and cash equivalents" (AP) appears.
    # From the image that is row 11 (title at 10, side-hdr at 11, data at 12).
    # We derive it from first_data_excel_row (the first AP data row).
    if first_data_excel_row is not None:
        side_start = first_data_excel_row - 1   # one row above first data → caption
    else:
        side_start = TABLE_FIRST_ROW + 3

    # BK is sourced from TB_12312025 (prior year / prior period balance)
    bk_val = prev_lookup.get("BK", Decimal(0))
    _write_s4_side_table(ws, bk_val, side_start)

    # -- freeze panes below header section ------------------------------------
    ws.freeze_panes = ws.cell(row=TABLE_FIRST_ROW + 3, column=S4_COL_REF)


