def _normalise_column_name(value):
    return str(value).strip().casefold()


def _unique_texts(items):
    result = []
    seen = set()

    for item in items or []:
        text = str(item).strip()

        if text and text not in seen:
            result.append(text)
            seen.add(text)

    return result


def _require_column(source_columns, name):
    target = _normalise_column_name(name)

    for column in source_columns:
        if _normalise_column_name(column) == target:
            return column

    raise KeyError(f"Required column not found: {name!r}")


def _to_decimal(value):
    if value is None or isinstance(value, bool):
        return None

    if isinstance(value, Decimal):
        return value

    try:
        text = str(value).replace(",", "").strip()

        if text.endswith("%"):
            text = text[:-1].strip()

        return Decimal(text)

    except (InvalidOperation, ValueError):
        return None


def _to_excel_percentage(value):
    number = _to_decimal(value)

    if number is None:
        return None

    return number / Decimal("100") if abs(number) > 1 else number


def _is_nonzero(value):
    number = _to_decimal(value)
    return number is not None and number != 0


def _is_no(value):
    return str(value).strip().casefold() == "no"


def _median_decimal(values):
    if not values:
        return None

    ordered = sorted(values)
    middle = len(ordered) // 2

    if len(ordered) % 2:
        return ordered[middle]

    return (
        ordered[middle - 1] + ordered[middle]
    ) / Decimal("2")


def _number_format(column_label):
    normalized = _normalise_column_name(column_label)

    if normalized in {
        "% of consolidated balance",
        "% of the total balance",
    }:
        return "0.00%"

    if normalized in {
        "times of materiality",
        "multiple of materiality balance",
    }:
        return "0.00"

    return "#,##0;(#,##0)"


def _find_residual_entity_columns(
    source_columns,
    calculated_columns=(),
):
    calculated_keys = {
        _normalise_column_name(column)
        for column in calculated_columns
    }

    test_column = _require_column(
        source_columns,
        "Test consolidated amount",
    )

    test_index = source_columns.index(test_column)
    entity_columns = []

    for column in source_columns[test_index + 1:]:
        normalized = _normalise_column_name(column)

        if normalized in calculated_keys:
            continue

        if normalized in {"elimination", "row_id"}:
            continue

        entity_columns.append(column)

    if not entity_columns:
        raise ValueError(
            "No legal-entity columns were found after "
            "'Test consolidated amount'."
        )

    return entity_columns


def _arrange_output_columns(
    source_columns,
    calculated_columns,
):
    calculated_columns = _unique_texts(calculated_columns)

    if not calculated_columns:
        return list(source_columns)

    calculated_keys = {
        _normalise_column_name(column)
        for column in calculated_columns
    }

    source_without_calculated = [
        column
        for column in source_columns
        if _normalise_column_name(column) not in calculated_keys
    ]

    test_column = _require_column(
        source_without_calculated,
        "Test consolidated amount",
    )

    insert_position = (
        source_without_calculated.index(test_column) + 1
    )

    return (
        source_without_calculated[:insert_position]
        + calculated_columns
        + source_without_calculated[insert_position:]
    )


def set_materiality(
    template,
    value,
    target_sheet=QUANTITATIVE_SHEET,
    cell="C10",
):
    worksheet = template[target_sheet]

    for merged_range in worksheet.merged_cells.ranges:
        if cell in merged_range:
            cell = merged_range.coord.split(":", 1)[0]
            break

    target = worksheet[cell]
    target.value = int(value)
    target.number_format = "[$$-en-US]#,##0"


def _clear_existing_table(
    worksheet,
    header_row,
    start_column,
):
    for row in worksheet.iter_rows(
        min_row=header_row,
        max_row=worksheet.max_row,
        min_col=start_column,
        max_col=worksheet.max_column,
    ):
        for cell in row:
            if not isinstance(cell, MergedCell):
                cell.value = None


def _source_records(
    raw_tb_CY,
    source_columns,
    row_id_col="row_id",
):
    selected_columns = list(source_columns) + [row_id_col]

    for row in raw_tb_CY.select(*selected_columns).collect():
        record = row.asDict(recursive=True)

        yield {
            **{
                column: record.get(column)
                for column in source_columns
            },
            row_id_col: record.get(row_id_col),
        }


