def normalize_text(text):
    if text is None:
        return ""
    return str(text).strip().lower()

def records_from(dataframe):
    if hasattr(dataframe, "toPandas"):
        return dataframe.toPandas().to_dict(orient="records")
    if hasattr(dataframe, "to_dict"):
        return dataframe.to_dict(orient="records")
    if isinstance(dataframe, list):
        return dataframe
    raise TypeError(f"Unsupported type for records_from: {type(dataframe)}")

def dataframe_columns(dataframe):
    if hasattr(dataframe, "columns"):
        return list(dataframe.columns)
    records = records_from(dataframe)
    return list(records[0].keys()) if records else []

def to_decimal(value):
    if value is None:
        return None
    s = str(value).strip().replace(",", "")
    if s in ("", "-", "—"):
        return None
    try:
        return Decimal(s)
    except InvalidOperation:
        return None

def make_font(color, name="Calibri", size=10, bold=False, underline=None):
    return Font(name=name, size=size, bold=bold, color=color, underline=underline)

def make_fill(color):
    return PatternFill(fill_type="solid", fgColor=color)

def make_border(color="FF000000", style="thin"):
    side = Side(style=style, color=color)
    return Border(left=side, right=side, top=side, bottom=side)

def make_alignment(horizontal="center", vertical="center", wrap=False):
    return Alignment(horizontal=horizontal, vertical=vertical, wrap_text=wrap)

def find_entity_columns(columns, anchor, excludes=(), row_id_col="row_id"):
    cols      = list(columns)
    excl_keys = {normalize_text(e) for e in excludes} | {normalize_text(row_id_col)}
    anchor_idx = next(
        (i for i, c in enumerate(cols) if normalize_text(c) == normalize_text(anchor)),
        None,
    )
    if anchor_idx is None:
        raise KeyError(f"Anchor column not found: {anchor!r}")
    result = [c for c in cols[anchor_idx + 1:] if normalize_text(c) not in excl_keys]
    if not result:
        raise ValueError(f"No entity columns found after {anchor!r}")
    return result

