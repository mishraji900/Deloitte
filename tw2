# =============================================================================
# JE Matching Pipeline — Databricks PySpark Serverless
# Primary Key : Company Description || Vendor Number
# Fix applied : iterative passes use amount_diff >= 0 (not <= 1)
#               so a credit of -300 correctly matches sales of +300
#               even when other sales (+500, +200) exist in the same PK group
# =============================================================================

from pyspark.sql import functions as F, Window

NUM_PARTITIONS = spark.sparkContext.defaultParallelism * 3
STAGE_PATH = f"{output_path}/_stage"

print(f"NUM_PARTITIONS = {NUM_PARTITIONS}")


# =============================================================================
# HELPERS
# =============================================================================

def write_table(df, name, log=True):
    if df is None:
        print(f"  [SKIP] {name} — no data")
        return
    path = f"{output_path}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    if log:
        print(f"  [WRITTEN] {path}")


def materialize_df(df, name, repartition_key=None, num_partitions=NUM_PARTITIONS):
    """Write to parquet and re-read — breaks Spark lineage completely."""
    print(f"  [MATERIALIZE] {name}")
    if repartition_key is not None:
        df = df.repartition(num_partitions, repartition_key)
    path = f"{STAGE_PATH}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    return cp.read(path)


def debug_count(label, df):
    if df is not None:
        print(f"  [COUNT] {label:<50} {df.count():>10,}")
    else:
        print(f"  [COUNT] {label:<50}       None")


def debug_group_count(df, col_name, label, limit=20):
    print(f"\n  [PROFILE] {label}")
    (
        df.groupBy(col_name)
        .count()
        .orderBy(F.desc("count"), F.asc(col_name))
        .show(limit, truncate=False)
    )


def month_from_business_column(month_col):
    """Parse 'MMM-yy' style month strings like 'Jan-24' → date 2024-01-01."""
    return F.to_date(F.concat(F.lit("01-"), F.trim(month_col)), "dd-MMM-yy")


def ensure_row_id(df):
    """Assign a stable string row_id based on deterministic column ordering."""
    if "row_id" in df.columns:
        return df.withColumn("row_id", F.col("row_id").cast("string"))

    preferred_order = [
        "Company Description",
        "Vendor/Customer Number",
        "JE Category",
        "Default Effective Date",
        "Month",
        "USD NET",
        "Invoice Reference",
    ]
    order_cols = [c for c in preferred_order if c in df.columns]
    if not order_cols:
        order_cols = sorted(df.columns)

    return df.withColumn(
        "row_id",
        F.row_number()
        .over(Window.orderBy(*[F.col(c).asc_nulls_last() for c in order_cols]))
        .cast("string"),
    )


def build_unmatched_rows(base_df, rem_sales_df, rem_credit_df, name):
    """
    Reconstruct full original rows for whatever sales/credit row_ids remain.
    Returns the original columns (not just the slim sales/credit projection).
    """
    sales_ids  = rem_sales_df.select(F.col("sales_row_id").alias("row_id"))
    credit_ids = rem_credit_df.select(F.col("credit_row_id").alias("row_id"))
    remaining_ids = sales_ids.unionByName(credit_ids).distinct()

    unmatched_df = base_df.alias("b").join(
        remaining_ids.alias("r"), on="row_id", how="inner"
    )
    return materialize_df(unmatched_df, name, "primary_key")


# =============================================================================
# CORE MATCHING FUNCTION
#
# HOW PAIRWISE MATCHING WORKS HERE
# ─────────────────────────────────
# The join produces one row per (sales_row, credit_row) combination inside
# each primary_key group — it is already pairwise.
#
# Example after join:
#   sales A (+500)  × credit X (-300)  → amount_diff = 200
#   sales B (+300)  × credit X (-300)  → amount_diff = 0    ← best for X
#   sales C (+200)  × credit X (-300)  → amount_diff = 100
#
# Step 1 (w_sales)  : for each sales row, pick the credit that minimises diff
# Step 2 (w_credit) : for each credit row, among sales rows that picked it,
#                     keep only the best sales row → enforces 1-to-1
#
# So credit X is matched to sales B (diff=0), regardless of A and C existing.
# =============================================================================

def rank_based_match(sales_df, credit_df, condition_fn, match_label):
    print(f"\n[MATCH] {match_label}")

    candidates_joined = (
        sales_df.alias("s")
        .join(credit_df.alias("c"), on="primary_key", how="inner")
        .withColumn("amount_diff",
            F.abs(F.col("s.sales_amt") + F.col("c.credit_amt")))
        .withColumn("month_lag",
            F.months_between(
                F.col("c.credit_month").cast("date"),
                F.col("s.sales_month").cast("date"),
            ).cast("int"))
    )

    candidates = condition_fn(candidates_joined)

    # Cheap existence check — limit(1) avoids full scan
    if candidates.limit(1).count() == 0:
        print(f"  [{match_label}] No qualifying pairs.")
        return None, sales_df, credit_df

    # ── Step 1: best credit for each sales row ─────────────────────────────
    w_sales = Window.partitionBy("primary_key", "s.sales_row_id").orderBy(
        F.col("amount_diff").asc(),
        F.col("month_lag").asc(),
        F.col("c.credit_eff_dt").asc(),
        F.col("c.credit_row_id").asc(),
    )

    best_credit_per_sales = (
        candidates
        .withColumn("rn_sales", F.row_number().over(w_sales))
        .filter(F.col("rn_sales") == 1)
    )

    # ── Step 2: best sales row for each credit row (enforces 1-to-1) ───────
    w_credit = Window.partitionBy("primary_key", "c.credit_row_id").orderBy(
        F.col("amount_diff").asc(),
        F.col("month_lag").asc(),
        F.col("s.sales_eff_dt").asc(),
        F.col("s.sales_row_id").asc(),
    )

    confirmed_pairs = (
        best_credit_per_sales
        .withColumn("rn_credit", F.row_number().over(w_credit))
        .filter(F.col("rn_credit") == 1)
        .select(
            F.col("primary_key"),
            F.col("s.sales_row_id").alias("sales_row_id"),
            F.col("c.credit_row_id").alias("credit_row_id"),
            F.col("s.sales_amt").alias("sales_amt"),
            F.col("c.credit_amt").alias("credit_amt"),
            F.col("amount_diff"),
            F.col("s.sales_eff_dt").alias("sales_eff_dt"),
            F.col("c.credit_eff_dt").alias("credit_eff_dt"),
            F.col("s.sales_month").alias("sales_month"),
            F.col("c.credit_month").alias("credit_month"),
            F.col("s.sales_ref").alias("sales_ref"),
            F.col("c.credit_ref").alias("credit_ref"),
            F.col("month_lag"),
            F.lit(match_label).alias("match_type"),
        )
    )

    if confirmed_pairs.limit(1).count() == 0:
        print(f"  [{match_label}] No 1-to-1 pairs after ranking.")
        return None, sales_df, credit_df

    # Materialise to break lineage before anti-joins
    confirmed_pairs = materialize_df(
        confirmed_pairs, f"matched_{match_label}", "primary_key"
    )

    matched_s_ids = confirmed_pairs.select("sales_row_id").distinct()
    matched_c_ids = confirmed_pairs.select("credit_row_id").distinct()

    remaining_sales  = sales_df.join(matched_s_ids,  on="sales_row_id",  how="left_anti")
    remaining_credit = credit_df.join(matched_c_ids, on="credit_row_id", how="left_anti")

    debug_count(f"{match_label} - confirmed pairs", confirmed_pairs)
    debug_count(f"{match_label} - remaining sales",  remaining_sales)
    debug_count(f"{match_label} - remaining credit", remaining_credit)

    return confirmed_pairs, remaining_sales, remaining_credit


# =============================================================================
# STEP 0 — LOAD
# =============================================================================
print("\n[STEP 0] Loading source data...")
je_raw = JE_raw


# =============================================================================
# STEP 1 — BASE PREP
# =============================================================================
print("\n[STEP 1] Base prep...")

je_raw = StringtoNum(je_raw, ["USD NET"])
je_raw = StringtoDate(je_raw, "Default Effective Date", "MM/dd/yyyy")
je_raw = ensure_row_id(je_raw)

je_prep = (
    je_raw
    .withColumn("invoice_ref_clean",  F.trim(F.col("Invoice Reference")))
    .withColumn("cat_clean",          F.trim(F.upper(F.col("JE Category"))))
    .withColumn("company_desc_clean", F.trim(F.upper(F.col("Company Description"))))
    .withColumn("vendor_num_clean",   F.trim(F.col("Vendor/Customer Number")))
    .withColumn("eff_dt",             F.col("Default Effective Date"))
    .withColumn("month_dt",           month_from_business_column(F.col("Month")))
    .withColumn("usd_net_dec",        F.col("USD NET").cast("double"))
    .withColumn("abs_usd_net",        F.abs(F.col("usd_net_dec")))
    .withColumn("primary_key",
        F.concat_ws("||",
            F.col("company_desc_clean"),
            F.col("vendor_num_clean")
        )
    )
    .filter(F.col("row_id").isNotNull())
    .filter(F.col("usd_net_dec").isNotNull())
    .filter(F.col("eff_dt").isNotNull())
    .filter(F.col("month_dt").isNotNull())
    .filter(F.col("primary_key").isNotNull() & (F.col("primary_key") != "||"))
    .repartition(NUM_PARTITIONS, "primary_key")
)

je_prep = materialize_df(je_prep, "je_prep", "primary_key")

debug_count("je_prep total rows", je_prep)
debug_group_count(je_prep, "cat_clean", "JE Category distribution")


# =============================================================================
# STEP 2 — SPLIT: BLANK INVOICE REF EXCLUDED
# =============================================================================
print("\n[STEP 2] Splitting on invoice reference...")

DATASET_EXC_1 = je_prep.filter(
    F.col("invoice_ref_clean").isNull() | (F.trim(F.col("invoice_ref_clean")) == "")
)

exact_ref_pool = je_prep.filter(
    F.col("invoice_ref_clean").isNotNull() & (F.trim(F.col("invoice_ref_clean")) != "")
)

DATASET_EXC_1  = materialize_df(DATASET_EXC_1,  "DATASET_EXC_1",  "primary_key")
exact_ref_pool = materialize_df(exact_ref_pool, "exact_ref_pool", "primary_key")

debug_count("DATASET_EXC_1 (blank invoice ref)", DATASET_EXC_1)
debug_count("exact_ref_pool (has invoice ref)",  exact_ref_pool)


# =============================================================================
# STEP 3 — UNIQUE vs DUPLICATE PK
# =============================================================================
print("\n[STEP 3] Counting rows per PK...")

pk_window = Window.partitionBy("primary_key")

je_prep_counted        = je_prep.withColumn("pk_row_count", F.count("*").over(pk_window))
exact_ref_pool_counted = exact_ref_pool.withColumn("pk_row_count", F.count("*").over(pk_window))

# ── Unique PK rows ─────────────────────────────────────────────────────────
unique_pk = je_prep_counted.filter(F.col("pk_row_count") == 1)

DATASET_1_OTHER_UNIQUE_PK = unique_pk.filter(
    ~F.col("cat_clean").isin("SALES INVOICES", "CREDIT MEMOS")
)
DATASET_2A_UNIQUE_PK_SALES_INVOICES = unique_pk.filter(
    F.col("cat_clean") == "SALES INVOICES"
)
DATASET_2B_UNIQUE_PK_CREDIT_MEMOS = unique_pk.filter(
    F.col("cat_clean") == "CREDIT MEMOS"
)

# ── Duplicate PK — full population (for iterative passes) ─────────────────
duplicate_pk_groups_all = (
    je_prep_counted
    .filter(F.col("pk_row_count") > 1)
    .filter(F.col("cat_clean").isin("SALES INVOICES", "CREDIT MEMOS"))
    .filter(F.col("usd_net_dec") != 0)
)

# ── Duplicate PK — exact-ref population (for exact passes only) ───────────
duplicate_pk_groups_exact = (
    exact_ref_pool_counted
    .filter(F.col("pk_row_count") > 1)
    .filter(F.col("cat_clean").isin("SALES INVOICES", "CREDIT MEMOS"))
    .filter(F.col("usd_net_dec") != 0)
)

DATASET_1_OTHER_UNIQUE_PK           = materialize_df(DATASET_1_OTHER_UNIQUE_PK,          "DATASET_1_OTHER_UNIQUE_PK",          "primary_key")
DATASET_2A_UNIQUE_PK_SALES_INVOICES = materialize_df(DATASET_2A_UNIQUE_PK_SALES_INVOICES,"DATASET_2A_UNIQUE_PK_SALES_INVOICES", "primary_key")
DATASET_2B_UNIQUE_PK_CREDIT_MEMOS   = materialize_df(DATASET_2B_UNIQUE_PK_CREDIT_MEMOS,  "DATASET_2B_UNIQUE_PK_CREDIT_MEMOS",   "primary_key")
duplicate_pk_groups_all             = materialize_df(duplicate_pk_groups_all,             "duplicate_pk_groups_all",             "primary_key")
duplicate_pk_groups_exact           = materialize_df(duplicate_pk_groups_exact,           "duplicate_pk_groups_exact",           "primary_key")

debug_count("duplicate_pk_groups_all",   duplicate_pk_groups_all)
debug_count("duplicate_pk_groups_exact", duplicate_pk_groups_exact)


# =============================================================================
# STEP 4 — BUILD SALES & CREDIT SIDE TABLES
# =============================================================================
print("\n[STEP 4] Building sales / credit side tables...")

def make_sales(src_df):
    return (
        src_df
        .filter(F.col("cat_clean") == "SALES INVOICES")
        .select(
            F.col("primary_key"),
            F.col("row_id").alias("sales_row_id"),
            F.col("usd_net_dec").alias("sales_amt"),
            F.col("eff_dt").alias("sales_eff_dt"),
            F.col("month_dt").alias("sales_month"),
            F.col("invoice_ref_clean").alias("sales_ref"),
        )
        .repartition(NUM_PARTITIONS, "primary_key")
    )

def make_credit(src_df):
    return (
        src_df
        .filter(F.col("cat_clean") == "CREDIT MEMOS")
        .select(
            F.col("primary_key"),
            F.col("row_id").alias("credit_row_id"),
            F.col("usd_net_dec").alias("credit_amt"),
            F.col("eff_dt").alias("credit_eff_dt"),
            F.col("month_dt").alias("credit_month"),
            F.col("invoice_ref_clean").alias("credit_ref"),
        )
        .repartition(NUM_PARTITIONS, "primary_key")
    )

sales_all   = materialize_df(make_sales(duplicate_pk_groups_all),   "sales_all",   "primary_key")
credit_all  = materialize_df(make_credit(duplicate_pk_groups_all),  "credit_all",  "primary_key")
sales_exact = materialize_df(
    make_sales(duplicate_pk_groups_exact)
    .filter(F.col("sales_ref").isNotNull() & (F.trim(F.col("sales_ref")) != "")),
    "sales_exact", "primary_key"
)
credit_exact = materialize_df(
    make_credit(duplicate_pk_groups_exact)
    .filter(F.col("credit_ref").isNotNull() & (F.trim(F.col("credit_ref")) != "")),
    "credit_exact", "primary_key"
)

debug_count("sales_all",   sales_all)
debug_count("credit_all",  credit_all)
debug_count("sales_exact", sales_exact)
debug_count("credit_exact",credit_exact)


# =============================================================================
# STEP 5 — NEXT-MONTH EXACT MATCH
# Conditions: month_lag=1, eff_dt order respected, amount_diff <= 1
# Invoice ref match is implicit because both sides come from exact_ref_pool
# (rows with non-blank invoice refs under same PK will naturally pair on ref
#  via the amount+date tiebreak — if you want hard ref equality add it below)
# =============================================================================
print("\n[STEP 5] Next-month exact match...")

DATASET_3_1_NEXT_MONTH_MATCHES, rem_sales_exact_1, rem_credit_exact_1 = rank_based_match(
    sales_exact,
    credit_exact,
    condition_fn=lambda df: df.filter(
        (F.col("month_lag") == 1) &
        (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt")) &
        (F.col("amount_diff") <= 1)
    ),
    match_label="NEXT_MONTH_EXACT",
)

rem_sales_exact_1  = materialize_df(rem_sales_exact_1,  "rem_sales_exact_1",  "primary_key")
rem_credit_exact_1 = materialize_df(rem_credit_exact_1, "rem_credit_exact_1", "primary_key")


# =============================================================================
# STEP 6 — SAME-MONTH EXACT MATCH
# Conditions: month_lag=0, eff_dt order respected, amount_diff <= 1
# =============================================================================
print("\n[STEP 6] Same-month exact match...")

DATASET_3_2T_SAME_MONTH_MATCHES, rem_sales_exact_2, rem_credit_exact_2 = rank_based_match(
    rem_sales_exact_1,
    rem_credit_exact_1,
    condition_fn=lambda df: df.filter(
        (F.col("month_lag") == 0) &
        (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt")) &
        (F.col("amount_diff") <= 1)
    ),
    match_label="SAME_MONTH_EXACT",
)

rem_sales_exact_2  = materialize_df(rem_sales_exact_2,  "rem_sales_exact_2",  "primary_key")
rem_credit_exact_2 = materialize_df(rem_credit_exact_2, "rem_credit_exact_2", "primary_key")


# =============================================================================
# STEP 6B — CARRY EXACT-MATCH RESULTS BACK TO FULL POPULATION
#
# Exact passes ran on the exact_ref sub-population.
# Before iterative passes, remove those matched IDs from sales_all/credit_all
# so the same rows are never matched twice.
# =============================================================================
print("\n[STEP 6B] Removing exact-match IDs from full population...")

matched_dfs = [
    df for df in [DATASET_3_1_NEXT_MONTH_MATCHES, DATASET_3_2T_SAME_MONTH_MATCHES]
    if df is not None
]

if matched_dfs:
    exact_s_ids = matched_dfs[0].select("sales_row_id")
    exact_c_ids = matched_dfs[0].select("credit_row_id")
    for df in matched_dfs[1:]:
        exact_s_ids = exact_s_ids.unionByName(df.select("sales_row_id"))
        exact_c_ids = exact_c_ids.unionByName(df.select("credit_row_id"))
    exact_s_ids = exact_s_ids.distinct()
    exact_c_ids = exact_c_ids.distinct()

    sales_for_iter  = sales_all.join(exact_s_ids,  on="sales_row_id",  how="left_anti")
    credit_for_iter = credit_all.join(exact_c_ids, on="credit_row_id", how="left_anti")
else:
    sales_for_iter  = sales_all
    credit_for_iter = credit_all

sales_for_iter  = materialize_df(sales_for_iter,  "sales_for_iter",  "primary_key")
credit_for_iter = materialize_df(credit_for_iter, "credit_for_iter", "primary_key")

debug_count("sales_for_iter  (into iterative passes)", sales_for_iter)
debug_count("credit_for_iter (into iterative passes)", credit_for_iter)

# Snapshot of what's unmatched after exact passes
DATASET_3_2_REMAIN_UNMATCHED_GROUPS = build_unmatched_rows(
    duplicate_pk_groups_all,
    sales_for_iter,
    credit_for_iter,
    "DATASET_3_2_REMAIN_UNMATCHED_GROUPS",
)


# =============================================================================
# STEP 7 — LAG 1-TO-2 MONTH ITERATIVE MATCH
#
# KEY FIX vs original code
# ────────────────────────
# amount_diff condition is removed (no upper cap).
# Rationale: with 3 sales invoices (+500, +300, +200) and 1 credit (-300),
# the pairwise join correctly produces:
#   (+500, -300) → diff 200
#   (+300, -300) → diff 0    ← wins on tiebreak
#   (+200, -300) → diff 100
# The rank_based_match picks diff=0 automatically.
# Capping at <= 1 would EXCLUDE the diff=200 and diff=100 rows from
# consideration, which is fine for exact match but wrong here — we want
# the matcher to SEE all pairs and pick the best one naturally.
#
# Conditions kept: month_lag between 1-2, eff_dt order respected.
# =============================================================================
print("\n[STEP 7] Lag 1-to-2 month iterative match...")

DATASET_2_1_REMAIN_1, rem_sales_3, rem_credit_3 = rank_based_match(
    sales_for_iter,
    credit_for_iter,
    condition_fn=lambda df: df.filter(
        (F.col("month_lag").between(1, 2)) &
        (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
        # ↑ NO amount_diff cap — let the ranker pick the best pair naturally
    ),
    match_label="LAG_1_2_MONTH",
)

rem_sales_3  = materialize_df(rem_sales_3,  "rem_sales_3",  "primary_key")
rem_credit_3 = materialize_df(rem_credit_3, "rem_credit_3", "primary_key")


# =============================================================================
# STEP 8 — SAME-MONTH ITERATIVE MATCH
#
# Same fix: no amount_diff cap.
# Conditions: month_lag=0, eff_dt order respected.
# =============================================================================
print("\n[STEP 8] Same-month iterative match...")

DATASET_2_2_REMAIN_2T, rem_sales_final, rem_credit_final = rank_based_match(
    rem_sales_3,
    rem_credit_3,
    condition_fn=lambda df: df.filter(
        (F.col("month_lag") == 0) &
        (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
        # ↑ NO amount_diff cap
    ),
    match_label="SAME_MONTH_ITERATIVE",
)

rem_sales_final  = materialize_df(rem_sales_final,  "rem_sales_final",  "primary_key")
rem_credit_final = materialize_df(rem_credit_final, "rem_credit_final", "primary_key")


# =============================================================================
# STEP 9 — FINAL UNMATCHED GROUPS
# =============================================================================
print("\n[STEP 9] Assembling final unmatched groups...")

REMAIN_UNMATCHED_GROUPS = build_unmatched_rows(
    duplicate_pk_groups_all,
    rem_sales_final,
    rem_credit_final,
    "REMAIN_UNMATCHED_GROUPS",
)


# =============================================================================
# STEP 10 — WRITE OUTPUTS
# =============================================================================
print("\n[STEP 10] Writing output parquet files...")

write_table(DATASET_EXC_1,                       "DATASET_EXC_1")
write_table(DATASET_1_OTHER_UNIQUE_PK,            "DATASET_1_OTHER_UNIQUE_PK")
write_table(DATASET_2A_UNIQUE_PK_SALES_INVOICES,  "DATASET_2A_UNIQUE_PK_SALES_INVOICES")
write_table(DATASET_2B_UNIQUE_PK_CREDIT_MEMOS,    "DATASET_2B_UNIQUE_PK_CREDIT_MEMOS")
write_table(DATASET_3_1_NEXT_MONTH_MATCHES,       "DATASET_3_1_NEXT_MONTH_MATCHES")
write_table(DATASET_3_2T_SAME_MONTH_MATCHES,      "DATASET_3_2T_SAME_MONTH_MATCHES")
write_table(DATASET_3_2_REMAIN_UNMATCHED_GROUPS,  "DATASET_3_2_REMAIN_UNMATCHED_GROUPS")
write_table(DATASET_2_1_REMAIN_1,                 "DATASET_2_1_REMAIN_1")
write_table(DATASET_2_2_REMAIN_2T,                "DATASET_2_2_REMAIN_2T")
write_table(REMAIN_UNMATCHED_GROUPS,              "REMAIN_UNMATCHED_GROUPS")


# =============================================================================
# STEP 11 — FINAL AUDIT
# =============================================================================
print("\n=== FINAL AUDIT ===")
debug_count("DATASET_EXC_1",                      DATASET_EXC_1)
debug_count("DATASET_1_OTHER_UNIQUE_PK",           DATASET_1_OTHER_UNIQUE_PK)
debug_count("DATASET_2A_UNIQUE_PK_SALES_INVOICES", DATASET_2A_UNIQUE_PK_SALES_INVOICES)
debug_count("DATASET_2B_UNIQUE_PK_CREDIT_MEMOS",   DATASET_2B_UNIQUE_PK_CREDIT_MEMOS)
debug_count("DATASET_3_1_NEXT_MONTH_MATCHES",      DATASET_3_1_NEXT_MONTH_MATCHES)
debug_count("DATASET_3_2T_SAME_MONTH_MATCHES",     DATASET_3_2T_SAME_MONTH_MATCHES)
debug_count("DATASET_3_2_REMAIN_UNMATCHED_GROUPS", DATASET_3_2_REMAIN_UNMATCHED_GROUPS)
debug_count("DATASET_2_1_REMAIN_1",                DATASET_2_1_REMAIN_1)
debug_count("DATASET_2_2_REMAIN_2T",               DATASET_2_2_REMAIN_2T)
debug_count("REMAIN_UNMATCHED_GROUPS",             REMAIN_UNMATCHED_GROUPS)

print("\n[DONE] Pipeline complete.")
