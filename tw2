def write_cell(
    cell,
    value: Any = None,
    font=None,
    fill=None,
    border=None,
    alignment=None,
    number_format: str | None = None,
) -> None:
    cell.value = value
    if font is not None:
        cell.font = font
    if fill is not None:
        cell.fill = fill
    if border is not None:
        cell.border = border
    if alignment is not None:
        cell.alignment = alignment
    if number_format is not None:
        cell.number_format = number_format


def put(
    worksheet,
    reference: str,
    value: Any = None,
    **style,
) -> None:
    write_cell(worksheet[reference], value, **style)


def put_rc(
    worksheet,
    row: int,
    column: int,
    value: Any = None,
    **style,
) -> None:
    write_cell(worksheet.cell(row=row, column=column), value, **style)


def variance_formulas(
    row: int,
    config: SheetConfig,
    comparisons: list[ComparisonBlock],
) -> dict[str, str]:
    current_column = config.role_to_excel_column["current"]
    formulas = {}

    for comparison in comparisons:
        comparison_column = config.role_to_excel_column[
            comparison.comparison_role
        ]
        dollar = comparison.dollar_column
        percent = comparison.percent_column
        flag = comparison.flag_column

        formulas[f"{dollar}{row}"] = (
            f"={current_column}{row}-{comparison_column}{row}"
        )
        formulas[f"{percent}{row}"] = (
            f"=IFERROR({dollar}{row}/{comparison_column}{row},0)"
        )
        formulas[f"{flag}{row}"] = (
            f'=IF(AND(ABS({dollar}{row})>{config.materiality_dollar_anchor},'
            f'ABS({percent}{row})>{config.materiality_percent_anchor}),'
            f'"{YES_VALUE}","{NO_VALUE}")'
        )

    return formulas


def write_variance_cells(
    worksheet,
    formulas: dict[str, str],
    comparisons: list[ComparisonBlock],
    font,
    border=None,
) -> None:
    percent_columns = {item.percent_column for item in comparisons}
    flag_columns = {item.flag_column for item in comparisons}

    for reference, formula in formulas.items():
        column = re.sub(r"\d", "", reference)
        put(
            worksheet,
            reference,
            formula,
            font=font,
            border=border,
            alignment=CENTER_ALIGN if column in flag_columns else RIGHT_ALIGN,
            number_format=(
                PERCENT_FORMAT if column in percent_columns else NUMBER_FORMAT
            ),
        )


def apply_conditional_formatting(
    worksheet,
    comparisons: list[ComparisonBlock],
    first_row: int,
    last_row: int,
) -> None:
    worksheet.conditional_formatting._cf_rules = {}

    for comparison in comparisons:
        for row in range(first_row, last_row + 1):
            reference = f"{comparison.flag_column}{row}"
            formula = f'{absolute_coordinate(reference)}="{YES_VALUE}"'
            rule = FormulaRule(formula=[formula], stopIfTrue=True)
            rule.dxf = YES_FILL
            rule.priority = 1
            worksheet.conditional_formatting.add(reference, rule)


def write_summary_sheet(
    worksheet,
    config: SheetConfig,
    dataframe: pd.DataFrame,
    display_roles: dict[str, str],
    comparisons: list[ComparisonBlock],
) -> None:
