# If an account description is not found here, it will appear as its own group.
ACCOUNT_GROUPS = {
    "Commissions": [
        "Commissions - Fixed",
        "Commissions - Variable",
    ],
    "Contra Revenue": [
        "Contra Revenue - Subscription Fees - Fixed",
        "Contra Revenue Commissions - Tech Credits - Variable",
        "Contra Revenue Commissions - Variable",
    ],
    "Other Revenue": [
        "Other Revenue - Fixed",
        "Other Revenue - Fixed - LSEG",
        "Other Revenue - Variable",
    ],
    "Subscription Fees": [
        "Subscription Fees - Fixed",
        "Subscription Fees - Fixed - LSEG",
        "Subscription Fees - Variable",
    ],
    "Transaction Fees": [
        "Transaction Fees - Fixed",
        "Transaction Fees - Variable",
    ],
}


def _normalize_text(value):
    """
    Normalize text so account description matching is more reliable.

    Why this exists:
    - Source data may contain inconsistent spacing
    - Hyphen characters may vary (regular hyphen vs en/em dash)
    - Case may vary

    Output:
    - None -> ""
    - trims leading/trailing spaces
    - standardizes dash characters
    - compresses multiple spaces to one
    - uppercases final value for case-insensitive matching
    """
    if value is None:
        return ""

    value = str(value).strip()
    value = value.replace("–", "-").replace("—", "-")
    value = re.sub(r"\s+", " ", value)
    return value.upper()


def _union_non_null(*dfs):
    """
    Union only the DataFrames that actually exist.

    Why this exists:
    - Some inputs may be None depending on prior processing
    - We want a safe helper to union an arbitrary number of datasets

    Behavior:
    - If all inputs are None, returns an empty Spark DataFrame with a minimal schema
    - Otherwise unions all valid DataFrames by column name
    """
    valid_dfs = [df for df in dfs if df is not None]

    if not valid_dfs:
        return spark.createDataFrame([], "Account Description string")

    return reduce(lambda a, b: a.unionByName(b, allowMissingColumns=True), valid_dfs)


def _build_group_lookup():
    """
    Flatten ACCOUNT_GROUPS into a reverse lookup dictionary.

    Example:
    ACCOUNT_GROUPS = {
        "Commissions": ["Commissions - Fixed", "Commissions - Variable"]
    }

    Becomes:
    {
        "COMMISSIONS - FIXED": "Commissions",
        "COMMISSIONS - VARIABLE": "Commissions"
    }

    This allows fast mapping from raw account description -> group name.
    """
    lookup = {}

    for group_name, members in ACCOUNT_GROUPS.items():
        for member in members:
            lookup[_normalize_text(member)] = group_name

    return lookup


# Precompute the reverse lookup once so it can be reused efficiently.
GROUP_LOOKUP = _build_group_lookup()


def _group_name_for_account(account_desc):
    """
    Return the output group name for a given account description.

    Logic:
    - Normalize the incoming account description
    - If it matches a configured group member, return the group name
    - Otherwise return the original account description as its own group
    - If blank / None, return 'Unmapped'
    """
    normalized = _normalize_text(account_desc)
    return GROUP_LOOKUP.get(normalized, account_desc.strip() if account_desc else "Unmapped")


def _safe_sheet_name(name: str) -> str:
    """
    Convert a string into a valid Excel worksheet name.

    Excel restrictions:
    - Disallows characters like []:*?/\
    - Limits worksheet names to 31 characters

    This helper:
    - Replaces invalid characters with underscores
    - Trims whitespace
    - Truncates to 31 characters
    - Falls back to 'Sheet' if name becomes empty
    """
    cleaned = re.sub(r"[\[\]\:\*\?\/\\]", "_", str(name)).strip()
    return cleaned[:31] if cleaned else "Sheet"


def _with_je_category(df):
    """
    Ensure the DataFrame has a usable 'JE Category' column.

    Why this exists:
    - Some rows may have blank JE Category values
    - Some datasets may not include the column at all

    Rules:
    - If JE Category exists:
        * blank string -> 'Blank'
        * null -> 'Blank'
        * otherwise trimmed original value
    - If column does not exist:
        * create it with value 'Unspecified'
    """
    if "JE Category" in df.columns:
        return df.withColumn(
            "JE Category",
            F.when(F.trim(F.col("JE Category")) == "", F.lit("Blank"))
             .otherwise(F.coalesce(F.trim(F.col("JE Category")), F.lit("Blank")))
        )

    return df.withColumn("JE Category", F.lit("Unspecified"))


def build_company_summary(company_desc: str):
    """
    Build the full row-level summary structure for one company.

    Output:
    A list of rows, where each row is a 6-element list matching:
        [Sheet Name / Section, JE Category, Count, Entered Dr, Entered CR, Net Entered]

    Major steps:
    1) Filter each source dataset for the target company
    2) Standardize JE Category
    3) Collect distinct account descriptions across all datasets
    4) Map each account description to a configured group (or its own group)
    5) Create a 'Total' section plus group-specific sections
    6) For each section and source dataset:
         - aggregate by JE Category
         - append detail rows
         - append sheet totals
    7) Append overall group totals
    """
    # Normalize company key for case-insensitive exact matching.
    company_key = company_desc.strip().upper()

    # Build a per-company version of each summary dataset.
    # Each dataset is filtered down to only rows for the selected company,
    # and JE Category values are standardized.
    per_company = {
        sheet_name: _with_je_category(
            df.filter(F.upper(F.trim(F.col("Company Description"))) == F.lit(company_key))
        )
        for sheet_name, df in SUMMARY_DATASETS.items()
    }

    # Collect all distinct account descriptions for this company
    # across every summary dataset.
    #
    # This is used to determine:
    #   - which account groups are present
    #   - which unmapped account descriptions need their own section
    acct_values = (
        _union_non_null(
            *[
                df.select(F.trim(F.col("Account Description")).alias("Account Description"))
                for df in per_company.values()
            ]
        )
        .filter(F.col("Account Description").isNotNull())
        .filter(F.trim(F.col("Account Description")) != "")
        .distinct()
        .orderBy("Account Description")
        .collect()
    )

    raw_accounts = [r["Account Description"] for r in acct_values]

    # Organize raw account descriptions into output groups.
    #
    # Example output:
    # {
    #   "Commissions": ["Commissions - Fixed", "Commissions - Variable"],
    #   "Other Revenue - Special": ["Other Revenue - Special"]   <-- unmapped own group
    # }
    grouped_accounts = {}
    for acct in raw_accounts:
        grp = _group_name_for_account(acct)
        grouped_accounts.setdefault(grp, []).append(acct)

    # Determine display order for sections:
    #   1) Total always first
    #   2) Configured groups in the order defined in ACCOUNT_GROUPS
    #   3) Any unmapped groups sorted alphabetically
    ordered_group_names = ["Total"]

    for configured_group in ACCOUNT_GROUPS.keys():
        if configured_group in grouped_accounts:
            ordered_group_names.append(configured_group)

    for grp in sorted(grouped_accounts.keys()):
        if grp not in ACCOUNT_GROUPS:
            ordered_group_names.append(grp)

    rows = []

    # Build the summary rows section by section.
    for grp in ordered_group_names:
        # Section header row
        rows.append([f"Account Grouping: {grp}", None, None, None, None, None])

        # Column header row
        rows.append(["Sheet Name", "JE Category", "Count", "Entered Dr", "Entered CR", "Net Entered"])

        # Running totals for the whole group section
        group_total_cnt = 0
        group_total_dr = 0.0
        group_total_cr = 0.0
        group_total_net = 0.0

        # For Total section, include all accounts.
        # For specific groups, only include that group's member accounts.
        group_members = None if grp == "Total" else grouped_accounts.get(grp, [])

        # Loop through each summary dataset bucket
        # (Same Quarter Match, Previous Quarter Match, Same PK Lag>2, etc.)
        for sheet_name, df in per_company.items():
            # Filter to only the accounts in the current group, unless we are on Total.
            sub = df if grp == "Total" else df.filter(F.trim(F.col("Account Description")).isin(group_members))

            # Aggregate by JE Category within this source dataset / group combination.
            je_summary = (
                sub.groupBy("JE Category")
                .agg(
                    F.count("primary_key").alias("cnt"),
                    F.sum("Entered Dr").alias("dr"),
                    F.sum("Entered CR").alias("cr"),
                    F.sum("Net Entered").alias("net"),
                )
                .orderBy("JE Category")
                .collect()
            )

            # Running totals for the current source dataset row block
            sheet_total_cnt = 0
            sheet_total_dr = 0.0
            sheet_total_cr = 0.0
            sheet_total_net = 0.0

            if je_summary:
                # Write one row per JE Category.
                # Only the first detail row shows the sheet_name to visually group rows.
                first_row = True

                for r in je_summary:
                    cnt = int(r["cnt"] or 0)
                    dr = float(r["dr"]) if r["dr"] is not None else 0.0
                    cr = float(r["cr"]) if r["cr"] is not None else 0.0
                    net = float(r["net"]) if r["net"] is not None else 0.0

                    # Accumulate sheet-level totals
                    sheet_total_cnt += cnt
                    sheet_total_dr += dr
                    sheet_total_cr += cr
                    sheet_total_net += net

                    # Append JE Category detail row
                    rows.append([
                        sheet_name if first_row else "",
                        r["JE Category"],
                        cnt,
                        dr,
                        cr,
                        net,
                    ])
                    first_row = False
            else:
                # If no rows exist for this section/dataset combination,
                # still output a placeholder line so the report structure stays consistent.
                rows.append([sheet_name, "No Data", 0, 0.0, 0.0, 0.0])

            # Add sheet totals into group totals
            group_total_cnt += sheet_total_cnt
            group_total_dr += sheet_total_dr
            group_total_cr += sheet_total_cr
            group_total_net += sheet_total_net

            # Append source dataset subtotal row
            rows.append([
                f"{sheet_name} Total",
                "",
                sheet_total_cnt,
                sheet_total_dr,
                sheet_total_cr,
                sheet_total_net,
            ])

        # Append the full section total row after all datasets are processed
        rows.append([
            "Group Total",
            "",
            group_total_cnt,
            group_total_dr,
            group_total_cr,
            group_total_net,
        ])

        # Spacer row between sections
        rows.append([None, None, None, None, None, None])

    # Remove trailing blank spacer row at the very end, if present.
    if rows and all(v is None for v in rows[-1]):
        rows.pop()

    return rows


def _rows_to_display_df(rows):
    """
    Convert the Python list-of-lists summary output into a Spark DataFrame
    for notebook display.

    This is only for display convenience and does not affect the Excel output.
    """
    schema = [
        "Sheet Name / Section",
        "JE Category",
        "Count",
        "Entered Dr",
        "Entered CR",
        "Net Entered",
    ]
    return spark.createDataFrame(rows, schema=schema)


def display_company_summary(company_desc: str):
    """
    Build and display a single company's summary inside the notebook.

    Returns:
    - the raw row list, which can also be reused elsewhere
    """
    rows = build_company_summary(company_desc)
    display_df = _rows_to_display_df(rows)
    display(display_df)
    return rows


def _apply_summary_format(ws, company_desc, rows):
    """
    Apply all Excel formatting and write summary rows onto a worksheet.

    Responsibilities:
    - define fonts, fills, borders, alignment
    - set worksheet layout (gridlines, zoom, row height, column widths)
    - write title and company name
    - write all summary rows
    - format section headers, column headers, subtotals, and totals
    - apply number formats for count and currency columns
    """
    # Border styles used across the report
    thin = Side(border_style="thin", color="000000")
    double = Side(border_style="double", color="000000")

    # Fonts
    title_font = Font(name="Calibri", sz=11, bold=True)
    header_font = Font(name="Calibri", sz=9, bold=True, color="00FFFFFF")
    section_font = Font(name="Calibri", sz=9, bold=True)
    cell_font = Font(name="Calibri", sz=9)
    subtotal_font = Font(name="Calibri", sz=9, bold=True)

    # Fill colors
    header_fill = PatternFill("solid", fgColor="00000000")
    subtotal_fill = PatternFill("solid", fgColor="00D9E1F2")

    # Cell alignments
    left_alignment = Alignment(wrap_text=False, vertical="center")
    center_alignment = Alignment(wrap_text=True, vertical="center", horizontal="center")
    cell_alignment = Alignment(wrap_text=True, vertical="center")

    # Border presets
    border_thin = Border(top=thin, left=thin, right=thin, bottom=thin)
    border_subtotal = Border(top=thin, left=thin, right=thin, bottom=double)
    border_header = Border(top=thin, left=thin, right=thin, bottom=thin)

    # Worksheet display settings
    ws.sheet_view.showGridLines = False
    ws.sheet_view.zoomScale = 100
    ws.sheet_format.defaultRowHeight = 12

    # Column widths
    # Column A is intentionally narrow as a left margin.
    ws.column_dimensions["A"].width = 2.4
    ws.column_dimensions["B"].width = 28
    ws.column_dimensions["C"].width = 24
    ws.column_dimensions["D"].width = 12
    ws.column_dimensions["E"].width = 16
    ws.column_dimensions["F"].width = 16
    ws.column_dimensions["G"].width = 16

    # Report title block
    ws["B2"] = f"Account Description Summary - {CURRENT_FY} {CURRENT_QUARTER}"
    ws["B3"] = company_desc
    ws["B2"].font = title_font
    ws["B3"].font = title_font
    ws["B2"].alignment = left_alignment
    ws["B3"].alignment = left_alignment

    # First output row for the summary body
    start_row = 7

    # Write each row and then apply row-type-specific formatting
    for idx, row_values in enumerate(rows):
        excel_row = start_row + idx
        first_value = row_values[0]

        # Write all 6 values into Excel columns B:G
        for col_idx, value in enumerate(row_values, start=2):
            cell = ws.cell(row=excel_row, column=col_idx, value=value)
            cell.font = cell_font
            cell.alignment = cell_alignment

        # Spacer row: leave as-is
        if first_value is None:
            continue

        # Section header row such as "Account Grouping: Total"
        if isinstance(first_value, str) and first_value.startswith("Account Grouping:"):
            for col_idx in range(2, 8):
                cell = ws.cell(row=excel_row, column=col_idx)
                cell.font = section_font
                cell.alignment = left_alignment
            continue

        # Column header row
        if first_value == "Sheet Name":
            for col_idx in range(2, 8):
                cell = ws.cell(row=excel_row, column=col_idx)
                cell.font = header_font
                cell.fill = header_fill
                cell.alignment = center_alignment
                cell.border = border_header
            continue

        # Per-dataset subtotal rows like "Same Quarter Match Total"
        if isinstance(first_value, str) and first_value.endswith(" Total") and first_value != "Group Total":
            for col_idx in range(2, 8):
                cell = ws.cell(row=excel_row, column=col_idx)
                cell.font = subtotal_font
                cell.fill = subtotal_fill
                cell.border = border_subtotal
                cell.alignment = cell_alignment if col_idx > 2 else left_alignment

                # Column D = Count
                if col_idx == 4:
                    cell.number_format = "#,##0;-#,##0"
                # Columns E:G = currency fields
                elif col_idx >= 5:
                    cell.number_format = "$ #,##0.00;$ (#,##0.00)"
            continue

        # Group total row at the end of each section
        if first_value == "Group Total":
            for col_idx in range(2, 8):
                cell = ws.cell(row=excel_row, column=col_idx)
                cell.font = header_font
                cell.fill = header_fill
                cell.alignment = center_alignment if col_idx > 2 else left_alignment
                cell.border = border_subtotal

                # Column D = Count
                if col_idx == 4:
                    cell.number_format = "#,##0;-#,##0"
                # Columns E:G = currency fields
                elif col_idx >= 5:
                    cell.number_format = "$ #,##0.00;$ (#,##0.00)"
            continue

        # Regular detail rows
        for col_idx in range(2, 8):
            cell = ws.cell(row=excel_row, column=col_idx)
            cell.font = cell_font
            cell.border = border_thin

            # Column D = Count
            if col_idx == 4:
                cell.number_format = "#,##0;-#,##0"
            # Columns E:G = currency fields
            elif col_idx >= 5:
                cell.number_format = "$ #,##0.00;$ (#,##0.00)"


def write_summary_workbook(path: str, show_displays: bool = False):
    """
    Create the final Excel workbook and save it to the provided path.

    Steps:
    - Create a new workbook
    - Remove the default blank sheet
    - Create one worksheet per company
    - Build summary rows for that company
    - Apply report formatting
    - Save using cp.openpyxl if available, otherwise wb.save()

    Parameters:
    - path: output file path
    - show_displays: if True, also display notebook summaries for each company
    """
    wb = Workbook()

    # Remove the default empty worksheet created by openpyxl
    wb.remove(wb.active)

    for company in COMPANIES:
        # Create a shorter worksheet tab name to fit Excel limits
        tab_name = _safe_sheet_name(company.replace("Tradeweb ", "TW ").replace(" ", ""))
        ws = wb.create_sheet(tab_name)

        # Build row-based summary for this company
        rows = build_company_summary(company)

        # Write and format the worksheet contents
        _apply_summary_format(ws, company, rows)

        # Optional notebook display for validation / review
        if show_displays:
            print(f"\nDisplaying summary for: {company}")
            display(_rows_to_display_df(rows))

    # Save workbook using the platform helper if present,
    # otherwise use openpyxl directly.
    if "cp" in globals() and hasattr(cp, "openpyxl"):
        cp.openpyxl.write(wb, path, register=True)
    else:
        wb.save(path)

    # Optional confirmation display
    if show_displays:
        display(spark.createDataFrame([(path,)], ["Workbook Path"]))


# Build the final output file path using current FY / quarter naming.
output_file = f"{output_path_et}/Account_Description_Summary - {CURRENT_FY} {CURRENT_QUARTER}.xlsx"

# Generate and save the workbook.
write_summary_workbook(output_file, show_displays=DISPLAY_SUMMARIES)


