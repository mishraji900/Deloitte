def write_cell(
    ws,
    row: int,
    col: int,
    value: Any = None,
    font=None,
    border=None,
    fmt: str | None = None,
    align=None,
    fill=None,
):
    """Write a value to a cell and apply any supplied formatting."""
    cell = ws.cell(row=row, column=col, value=value)

    if font is not None:
        cell.font = font

    if border is not None:
        cell.border = border

    if fmt is not None:
        cell.number_format = fmt

    if align is not None:
        cell.alignment = align

    if fill is not None:
        cell.fill = fill

    return cell


def write_merged_box(
    ws,
    r1: int,
    c1: int,
    r2: int,
    c2: int,
    value: Any,
    font,
    border,
    align,
    fill=None,
):
    """Merge a cell range, write its value, and apply box formatting."""
    ws.merge_cells(
        start_row=r1,
        start_column=c1,
        end_row=r2,
        end_column=c2,
    )

    write_cell(
        ws,
        r1,
        c1,
        value,
        font=font,
        align=align,
        fill=fill,
    )

    for row in range(r1, r2 + 1):
        for col in range(c1, c2 + 1):
            ws.cell(row=row, column=col).border = border

            if fill is not None:
                ws.cell(row=row, column=col).fill = fill


def apply_white_background(ws, n_rows: int, n_cols: int) -> None:
    """Apply a white fill to the configured worksheet area."""
    for row in range(1, n_rows + 1):
        for col in range(1, n_cols + 1):
            ws.cell(row=row, column=col).fill = WHITE_FILL


def parse_anchor(anchor: str) -> tuple[str, int]:
    """Split an Excel anchor into column letters and row number."""
    # Convert the anchor to a consistent format before validation.
    match = re.fullmatch(r"([A-Z]+)(\d+)", anchor.upper())

    if not match:
        raise ValueError(f"Invalid worksheet anchor: '{anchor}'.")

    return match.group(1), int(match.group(2))


def offset_anchor_rows(anchor: str, row_offset: int) -> str:
    """Move an Excel anchor vertically by the specified row offset."""
    column_letters, row_number = parse_anchor(anchor)

    # Preserve the column and apply the offset only to the row number.
    return f"{column_letters}{row_number + row_offset}"


