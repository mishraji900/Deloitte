from pyspark.sql import functions as F


def subtract_matching_columns(
    dataset1,
    dataset2,
    calculation_cols,
    match_col="Account",
):
    if match_col not in dataset1.columns:
        raise KeyError(f"{match_col!r} is missing from dataset1")

    if match_col not in dataset2.columns:
        raise KeyError(f"{match_col!r} is missing from dataset2")

    missing_cols = [
        col_name
        for col_name in calculation_cols
        if col_name not in dataset1.columns
    ]

    if missing_cols:
        raise KeyError(
            f"Calculation columns missing from dataset1: {missing_cols}"
        )

    matching_cols = [
        col_name
        for col_name in calculation_cols
        if col_name in dataset2.columns
    ]

    if not matching_cols:
        return dataset1

    deduction_names = {
        col_name: f"__deduction_{index}"
        for index, col_name in enumerate(matching_cols)
    }

    deductions = dataset2.select(
        F.col(match_col).alias("__match_key"),
        *[
            F.coalesce(
                F.col(col_name).cast("double"),
                F.lit(0.0),
            ).alias(deduction_names[col_name])
            for col_name in matching_cols
        ],
    )

    deductions = deductions.groupBy("__match_key").agg(
        *[
            F.sum(F.col(deduction_names[col_name])).alias(
                deduction_names[col_name]
            )
            for col_name in matching_cols
        ]
    )

    left = dataset1.alias("left")
    right = deductions.alias("right")

    joined = left.join(
        right,
        left[match_col].eqNullSafe(right["__match_key"]),
        "left",
    )

    output_columns = []

    for col_name in dataset1.columns:
        if col_name in matching_cols:
            deduction = F.coalesce(
                right[deduction_names[col_name]],
                F.lit(0.0),
            )

            output_columns.append(
                (
                    left[col_name].cast("double") - deduction
                ).alias(col_name)
            )
        else:
            output_columns.append(left[col_name].alias(col_name))

    return joined.select(*output_columns)

