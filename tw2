def _font_grey():
    return Font(name="Calibri", size=10, bold=False, color=_GREY_FONT)


# ============================================================
# DATA HELPERS
# ============================================================
def _to_dec(val):
    if val in (None, ""):
        return None
    try:
        return Decimal(str(val).replace(",", ""))
    except InvalidOperation:
        return None

def _is_grey(val):
    return (
        isinstance(val, str)
        and val.strip().lower() == GREY_MARKER.lower()
    )

def _get_records(df):
    if hasattr(df, "collect"):
        return [r.asDict(recursive=True) for r in df.collect()]
    if hasattr(df, "to_dict"):
        return df.to_dict(orient="records")
    return [dict(r) for r in df]

def _get_columns(df):
    if hasattr(df, "columns"):
        return list(df.columns)
    records = _get_records(df)
    return list(records[0].keys()) if records else []

def _norm(val):
    return str(val).strip().lower() if val not in (None, "") else ""


# ============================================================
# UNMERGE â€” remove all merged ranges from row 9 downward
# ============================================================
def _unmerge_from_row9(ws):
    to_remove = []
    for rng in list(ws.merged_cells.ranges):
        _, min_row, _, max_row = range_boundaries(str(rng))
        if max_row >= ROW_ACCT_HEADER:
            to_remove.append(str(rng))
    for ref in to_remove:
        ws.unmerge_cells(ref)


# ============================================================
# CLEAR â€” wipe all content and style from row 9 downward
# ============================================================
def _clear_from_row9(ws):
    for row in ws.iter_rows(min_row=ROW_ACCT_HEADER, max_row=ws.max_row):
        for cell in row:
            if isinstance(cell, MergedCell):
                continue
            cell.value         = None
            cell.font          = _font_data()
            cell.fill          = _fill(_WHT)
            cell.border        = _no_border()
            cell.number_format = "General"
            cell.alignment     = Alignment()


# ============================================================
# FILTER â€” Tab 3b criterion {b}
# ============================================================
def _filter_tab3b(residual_cy_py, threshold_value):
    thresh  = _to_dec(threshold_value)
    results = []
    for rec in _get_records(residual_cy_py):
        cy   = _to_dec(rec.get("Untested_Balance_CY")) or Decimal("0")
        py   = _to_dec(rec.get("Untested_Balance_PY")) or Decimal("0")
        diff = cy - py
        pct  = (diff / cy) if cy != Decimal("0") else None
        if (
            thresh is not None
            and abs(diff) > thresh
            and pct is not None
            and abs(pct) > Decimal("0.15")
        ):
            results.append(rec)
    return results


# ============================================================
# ACCOUNT LOOKUPS
# ============================================================
def _build_lookup(records, account_col):
    lookup = {}
    for rec in records:
        key = _norm(rec.get(account_col, ""))
        if key:
            lookup[key] = rec
    return lookup


# ============================================================
# ENTITY COLUMN EXTRACTION
# "row_id" is added to _SKIP_COLS so it is excluded at source
# and never appears as a legal entity row in the sheet.
# ============================================================
_SKIP_COLS = {
    "account",
    "test consolidated amount",
    "% of consolidated balance",
    "untested balance",
    "reference id",
    "significance",
    "consolidated",
    "row_id",               # â† excluded: must never appear as a legal entity row
}

def _get_entity_columns(df, account_col):
    after = False
    ents  = []
    for c in _get_columns(df):
        if _norm(c) == _norm(account_col):
            after = True
            continue
        if after and _norm(c) not in _SKIP_COLS:
            ents.append(c)
    return ents


# ============================================================
# COMBINED ENTITY LIST
# ============================================================
def _build_combined_entities(cy_entity_cols, py_entity_cols):
    cy_normed = {_norm(e): e for e in cy_entity_cols}
    combined  = [(e, "cy") for e in cy_entity_cols]
    for py_ent in py_entity_cols:
        if _norm(py_ent) not in cy_normed:
            combined.append((py_ent, "py_only"))
            print(f"[3b] PY-only entity added: '{py_ent}'")
    return combined


# ============================================================
