from functools import reduce
import re

from pyspark.sql import Window
from pyspark.sql import functions as F


def _col(column_name):
    escaped_name = column_name.replace("`", "``")
    return F.col(f"`{escaped_name}`")


def _strip_plural(token): 
    safe_endings = ("ss", "us", "is", "as", "ous")

    if len(token) <= 2 or not token.endswith("s"):
        return token

    if token.endswith(safe_endings):
        return token

    return token[:-1]


def account_key(value):
    if value is None:
        return ""

    text = str(value).casefold().strip()
    text = text.replace("'", "").replace("\u2019", "")
    text = text.replace("&", " and ")
    text = re.sub(r"[-\u2013\u2014]", " ", text)
    text = re.sub(r"\bvalutaion\b", "valuation", text)
    text = re.sub(r"\bvalutations\b", "valuation", text)
    text = re.sub(r"[^a-z0-9 ]+", " ", text)
    text = re.sub(r"\s+", " ", text).strip()

    tokens = sorted(text.split())
    tokens = [_strip_plural(token) for token in tokens]

    return " ".join(tokens)


def spark_account_key(column_name, alias_map=None):
    step = F.lower(F.trim(_col(column_name).cast("string")))

    step = F.regexp_replace(step, r"['\u2019]", "")
    step = F.regexp_replace(step, r"&", " and ")
    step = F.regexp_replace(step, r"[-\u2013\u2014]", " ")
    step = F.regexp_replace(
        step,
        r"(?i)\bvalutaions?\b",
        "valuation",
    )
    step = F.regexp_replace(step, r"[^a-z0-9 ]+", " ")
    step = F.trim(F.regexp_replace(step, r"\s+", " "))

    tokens = F.array_sort(F.split(step, " "))

    tokens_singular = F.transform(
        tokens,
        lambda token: F.when(
            (F.length(token) > 2)
            & token.endswith("s")
            & (~token.endswith("ss"))
            & (~token.endswith("us"))
            & (~token.endswith("is"))
            & (~token.endswith("as"))
            & (~token.endswith("ous")),
            F.regexp_replace(token, "s$", ""),
        ).otherwise(token),
    )

    normalized_key = F.concat_ws(" ", tokens_singular)

    if alias_map:
        mapping_expression = F.create_map(
            *[
                item
                for source_key, target_key in alias_map.items()
                for item in (
                    F.lit(source_key),
                    F.lit(target_key),
                )
            ]
        )

        normalized_key = F.coalesce(
            mapping_expression[normalized_key],
            normalized_key,
        )

    return normalized_key


def _spark_account_is_valid(column_name):
    source = _col(column_name)

    return (
        source.isNotNull()
        & (F.trim(source.cast("string")) != F.lit(""))
    )


def _collect_account_keys(dataframe, account_column):
    return [
        row["account_value"]
        for row in (
            dataframe
            .select(
                _col(account_column)
                .cast("string")
                .alias("account_value")
            )
            .filter(
                _col(account_column).isNotNull()
                & (
                    F.trim(
                        _col(account_column).cast("string")
                    )
                    != ""
                )
            )
            .distinct()
            .collect()
        )
    ]


def _build_fuzzy_alias_map(canonical_keys, comparison_keys):
    canonical_by_normalized_key = {}

    for key in canonical_keys:
        normalized = account_key(key)

        if normalized and normalized not in canonical_by_normalized_key:
            canonical_by_normalized_key[normalized] = normalized

    alias_map = {}

    for key in set(comparison_keys):
        normalized = account_key(key)

        if normalized in canonical_by_normalized_key:
            alias_map[normalized] = canonical_by_normalized_key[
                normalized
            ]

    return alias_map


def _build_manual_alias_map(
    manual_mapping,
    canonical_column="Account CY",
    comparison_column="Account PY",
):
    if manual_mapping is None:
        return {}

    required_columns = {
        canonical_column,
        comparison_column,
    }

    missing_columns = required_columns - set(
        manual_mapping.columns
    )

    if missing_columns:
        raise KeyError(
            f"Manual mapping is missing columns: "
            f"{sorted(missing_columns)}"
        )

    rows = (
        manual_mapping
        .select(
            F.trim(
                _col(canonical_column).cast("string")
            ).alias("__canonical_account"),
            F.trim(
                _col(comparison_column).cast("string")
            ).alias("__comparison_account"),
        )
        .filter(
            F.col("__canonical_account").isNotNull()
            & (F.col("__canonical_account") != "")
            & F.col("__comparison_account").isNotNull()
            & (F.col("__comparison_account") != "")
        )
        .distinct()
        .collect()
    )

    alias_map = {}

    for row in rows:
        comparison_key = account_key(
            row["__comparison_account"]
        )
        canonical_key = account_key(
            row["__canonical_account"]
        )

        if comparison_key and canonical_key:
            if comparison_key != canonical_key:
                alias_map[comparison_key] = canonical_key

    return alias_map


def _add_account_occurrence_number(
    dataframe,
    account_column,
    row_id_column,
    alias_map,
):
    if account_column not in dataframe.columns:
        raise KeyError(
            f"{account_column!r} is missing from the DataFrame"
        )

    if row_id_column not in dataframe.columns:
        raise KeyError(
            f"{row_id_column!r} is missing from the DataFrame"
        )

    prepared = (
        dataframe
        .filter(_spark_account_is_valid(account_column))
        .withColumn(
            "__account_key",
            spark_account_key(
                account_column,
                alias_map,
            ),
        )
        .withColumn(
            "__row_id",
            _col(row_id_column).cast("long"),
        )
        .withColumn(
            "__source_tiebreaker",
            F.monotonically_increasing_id(),
        )
    )

    occurrence_window = (
        Window
        .partitionBy("__account_key")
        .orderBy(
            F.col("__row_id").asc_nulls_last(),
            F.col("__source_tiebreaker").asc(),
        )
    )

    return prepared.withColumn(
        "__account_occurrence",
        F.row_number().over(occurrence_window),
    )


def _prepare_dataframe(
    dataframe,
    source_suffix,
    account_column,
    sheet_column,
    row_id_column,
    alias_map,
):
    prepared = _add_account_occurrence_number(
        dataframe=dataframe,
        account_column=account_column,
        row_id_column=row_id_column,
        alias_map=alias_map,
    )

    value_columns = [
        column_name
        for column_name in dataframe.columns
        if column_name not in {
            account_column,
            sheet_column,
        }
    ]

    if sheet_column in dataframe.columns:
        source_sheet = _col(sheet_column)
    else:
        source_sheet = F.lit(str(source_suffix))

    return prepared.select(
        "__account_key",
        "__account_occurrence",
        _col(account_column).alias(
            f"__account_name_{source_suffix}"
        ),
        source_sheet.alias(
            f"__sheet_{source_suffix}"
        ),
        *[
            _col(column_name).alias(
                f"{column_name}_{source_suffix}"
            )
            for column_name in value_columns
        ],
    )


def full_outer_join_all(
    dataframes,
    account_column="Account Grouping",
    sheet_column="__sheet__",
    row_id_column="row_id",
    manual_mapping=None,
    manual_canonical_column="Account CY",
    manual_comparison_column="Account PY",
):
    if not dataframes:
        raise ValueError(
            "dataframes must contain at least one DataFrame"
        )

    suffixes = [
        str(source_suffix)
        for source_suffix, _ in dataframes
    ]

    if len(suffixes) != len(set(suffixes)):
        raise ValueError(
            "Each DataFrame must have a unique suffix"
        )

    # Confirm the input columns before joining.
    for suffix, dataframe in dataframes:
        print(f"{suffix} input columns: {dataframe.columns}")

    canonical_dataframe = dataframes[0][1]

    canonical_keys = _collect_account_keys(
        canonical_dataframe,
        account_column,
    )

    comparison_keys = []

    for _, dataframe in dataframes[1:]:
        comparison_keys.extend(
            _collect_account_keys(
                dataframe,
                account_column,
            )
        )

    alias_map = _build_fuzzy_alias_map(
        canonical_keys=canonical_keys,
        comparison_keys=comparison_keys,
    )

    if manual_mapping is not None:
        alias_map.update(
            _build_manual_alias_map(
                manual_mapping=manual_mapping,
                canonical_column=manual_canonical_column,
                comparison_column=manual_comparison_column,
            )
        )

    prepared_dataframes = [
        _prepare_dataframe(
            dataframe=dataframe,
            source_suffix=str(source_suffix),
            account_column=account_column,
            sheet_column=sheet_column,
            row_id_column=row_id_column,
            alias_map=alias_map,
        )
        for source_suffix, dataframe in dataframes
    ]

    result = prepared_dataframes[0]

    for right_dataframe in prepared_dataframes[1:]:
        result = result.join(
            right_dataframe,
            on=[
                "__account_key",
                "__account_occurrence",
            ],
            how="full_outer",
        )

    account_name_columns = [
        f"__account_name_{suffix}"
        for suffix in suffixes
    ]

    sheet_name_columns = [
        f"__sheet_{suffix}"
        for suffix in suffixes
    ]

    output_columns = []

    for source_suffix, dataframe in dataframes:
        source_value_columns = [
            column_name
            for column_name in dataframe.columns
            if column_name not in {
                account_column,
                sheet_column,
            }
        ]

        for column_name in source_value_columns:
            output_name = (
                f"{column_name}_{source_suffix}"
            )

            if output_name not in output_columns:
                output_columns.append(output_name)

    print(f"Output value columns: {output_columns}")

    if not output_columns:
        raise ValueError(
            "No non-key columns were found. "
            "Check the input DataFrame schemas."
        )

    final_columns = [
        F.coalesce(
            *[
                _col(column_name)
                for column_name in account_name_columns
            ]
        ).alias(account_column),
        F.coalesce(
            *[
                _col(column_name)
                for column_name in sheet_name_columns
            ]
        ).alias(sheet_column),
    ]

    final_columns.extend(
        _col(column_name)
        for column_name in output_columns
    )

    return result.select(*final_columns)


