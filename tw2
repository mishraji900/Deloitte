# SECTION 6 — Table writer (unchanged)
# ══════════════════════════════════════════════════════════════════════════════

def _write_table(ws, section_label, records, print_cols, entity_cols, start_row):
    main_cols = [c for c in print_cols
                 if normalize_text(c) not in _POST_NORMS
                 or _POST_NORMS[normalize_text(c)][2]]
    side_cols = [c for c in print_cols
                 if normalize_text(c) in _POST_NORMS
                 and not _POST_NORMS[normalize_text(c)][2]]

    header_row     = start_row
    data_row_start = start_row + 1
    n_main         = len(main_cols)

    ws.row_dimensions[header_row].height = 55

    ws.merge_cells(
        start_row=header_row, start_column=COL_ACCOUNT,
        end_row=header_row,   end_column=COL_ACCOUNT,
    )
    acct_cell = ws.cell(row=header_row, column=COL_ACCOUNT,
                        value=section_label.upper())
    acct_cell.font = Font(name="Calibri", size=11, bold=True,
                          underline="single", color=BLACK)
    acct_cell.fill, acct_cell.border, acct_cell.alignment = (
        FILL_LIGHT_BLUE, BORDER_STD, ALIGN_LEFT_BOT
    )

    for i, col in enumerate(main_cols):
        if i == 0:
            continue
        n_col = normalize_text(col)
        c     = ws.cell(row=header_row, column=_xl(i))
        label = _POST_NORMS[n_col][1] if n_col in _POST_NORMS else col
        c.value, c.font, c.fill, c.border, c.alignment = (
            label, FONT_HDR_BLACK, FILL_LIGHT_BLUE, BORDER_STD, ALIGN_CTR_WRAP
        )

    last_main_ws_col = _xl(n_main - 1)
    ws.auto_filter.ref = (
        f"{get_column_letter(_xl(0))}{header_row}:"
        f"{get_column_letter(last_main_ws_col)}{header_row}"
    )

    side_start_col = last_main_ws_col + SIDE_TABLE_GAP + 1
    for j, col in enumerate(side_cols):
        n_col = normalize_text(col)
        c     = ws.cell(row=header_row, column=side_start_col + j)
        meta  = _POST_NORMS.get(n_col)
        label = meta[1] if meta else col
        fnt   = FONT_HDR_RED if (meta and meta[3]) else FONT_HDR_BLACK
        c.value, c.font, c.fill, c.border, c.alignment = (
            label, fnt, FILL_LIGHT_BLUE, BORDER_STD, ALIGN_CTR_WRAP
        )

    data_row = data_row_start
    for rec in records:
        ws.row_dimensions[data_row].height = 15

        for i, col in enumerate(main_cols):
            raw = rec.get(col)
            c   = ws.cell(row=data_row, column=_xl(i))
            if i == 0:
                c.value, c.font, c.fill, c.border, c.alignment = (
                    raw, FONT_BODY, FILL_WHITE, BORDER_HAIR, ALIGN_LEFT
                )
            else:
                c.value, c.font, c.fill, c.border, c.alignment = (
                    float(raw) if raw is not None else None,
                    FONT_BODY, FILL_WHITE, BORDER_HAIR, ALIGN_RIGHT,
                )
                c.number_format = MONEY_FMT

        for j, col in enumerate(side_cols):
            raw   = rec.get(col)
            c     = ws.cell(row=data_row, column=side_start_col + j)
            n_col = normalize_text(col)
            if n_col in TEXT_POST_COLS:
                display = str(raw).strip() if raw is not None else ""
                c.value, c.font, c.fill, c.border, c.alignment = (
                    display if display else None,
                    FONT_BODY_RED_BOLD, FILL_WHITE, BORDER_HAIR, ALIGN_CTR,
                )
            else:
                c.value, c.font, c.fill, c.border, c.alignment = (
                    float(raw) if raw is not None else None,
                    FONT_BODY, FILL_WHITE, BORDER_HAIR, ALIGN_RIGHT,
                )
                c.number_format = MONEY_FMT

        data_row += 1

    return data_row + 2

