def s3a_write_block(
    worksheet, block_start_row, record, account_column, source_row_id,
    entity_columns, blue_exact_pairs, blue_normalized_pairs, tab2_row_lookup,
):
    """Write one account's 3-row block: entity headers, balances (or 'Deemed significant' for blue/grey cells), and Investigate? formulas."""
    # Each account gets a small 3-row block:
    #   row 1 = headers (entity names + Total/Tab2/Difference)
    #   row 2 = the balances themselves
    #   row 3 = the "Investigate?" answers
    header_row = block_start_row
    balance_row = block_start_row + 1
    investigate_row = block_start_row + 2

    # Work out which columns hold the entities, then the three summary columns after them.
    entity_start_column = 3
    entity_end_column = entity_start_column + len(entity_columns) - 1
    total_column = entity_end_column + 1
    tab2_column = total_column + 1
    difference_column = tab2_column + 1

    investigate_coordinates = []

    # Top-left "Account" header cell.
    account_header = worksheet.cell(row=header_row, column=2)
    account_header.value = "Account"
    account_header.font = _header_font()
    account_header.alignment = _header_align()
    account_header.fill = _white_fill()
    account_header.border = _full_border()

    account_value = record.get(account_column)

    if account_value in {None, ""}:
        # Header-only pass (used to draw the very first, empty template row).
        # When there's no account name, we only lay down the header labels (entities + the
        # three summary columns) and stop — nothing else to write.
        for index, entity_column in enumerate(entity_columns, start=entity_start_column):
            header_cell = worksheet.cell(row=header_row, column=index)
            header_cell.value = str(entity_column).strip()
            header_cell.font = _header_font()
            header_cell.alignment = _header_align()
            header_cell.fill = _white_fill()
            header_cell.border = _full_border()

        for column, label in ((total_column, TOTAL_HEADER), (tab2_column, TAB_2_TOTAL_HEADER), (difference_column, DIFFERENCE_HEADER)):
            header_cell = worksheet.cell(row=header_row, column=column)
            header_cell.value = label
            header_cell.font = _header_font()
            header_cell.alignment = _header_align()
            header_cell.fill = _white_fill()
            header_cell.border = _full_border()

        return investigate_coordinates

    # The account name itself, on the balance row, far-left.
    account_cell = worksheet.cell(row=balance_row, column=2)
    account_cell.value = account_value
    account_cell.font = _black_font()
    account_cell.alignment = _left_align()
    account_cell.fill = _white_fill()
    account_cell.border = _full_border()

    # The "Investigate?" label sits on the investigate row, far-left.
    investigate_label = worksheet.cell(row=investigate_row, column=2)
    investigate_label.value = "Investigate?"
    investigate_label.font = _black_font()
    investigate_label.alignment = _right_align()
    investigate_label.fill = _white_fill()
    investigate_label.border = _full_border()

    # Now fill in one column per entity: its name (header), its balance, and its Investigate? formula.
    for entity_index, entity_column in enumerate(entity_columns, start=entity_start_column):
        header_cell = worksheet.cell(row=header_row, column=entity_index)
        header_cell.value = str(entity_column).strip()
        header_cell.font = _header_font()
        header_cell.alignment = _header_align()
        header_cell.fill = _white_fill()
        header_cell.border = _full_border()

        balance_cell = worksheet.cell(row=balance_row, column=entity_index)
        investigate_cell = worksheet.cell(row=investigate_row, column=entity_index)

        # Read this entity's value and work out what kind of value it is.
        source_value = record.get(entity_column)
        grey_marker = s3a_is_grey_marker(source_value)                 # was it greyed out earlier?
        numeric_value = None if grey_marker else s3a_to_decimal(source_value)

        is_blue = s3a_is_blue_cell(entity_column, source_row_id, blue_exact_pairs, blue_normalized_pairs)

        balance_cell.fill = _white_fill()
        balance_cell.border = _full_border()

        if grey_marker or is_blue:
            # Grey or blue cells don't show a number — they show "Deemed significant" in blue.
            balance_cell.value = DEEMED_SIGNIFICANT
            balance_cell.font = _blue_font()
            balance_cell.alignment = _center_align()
            balance_cell.number_format = "General"
        elif numeric_value is not None:
            # A normal number: store it and format it as money.
            balance_cell.value = float(numeric_value)
            balance_cell.font = _black_font()
            balance_cell.alignment = _right_align()
            balance_cell.number_format = MONEY_FORMAT
        else:
            # Anything else (non-numeric text): keep it as-is, plain formatting.
            balance_cell.value = source_value
            balance_cell.font = _black_font()
            balance_cell.alignment = _right_align()
            balance_cell.number_format = "General"

        balance_coordinate = balance_cell.coordinate

        # The "Investigate?" cell is an Excel formula (recalculated live), which reads:
        #   - if the balance says "Deemed significant" -> "No" (nothing to check)
        #   - if the balance is blank or not a number   -> "" (leave blank)
        #   - if the balance is below the threshold      -> "No"
        #   - otherwise                                  -> "Investigate"
        investigate_cell.value = (
            f'=IF(OR({balance_coordinate}="{DEEMED_SIGNIFICANT}",'
            f'{balance_coordinate}="{FORMULA_DEEMED_SIGNIFICANT}"),"No",'
            f'IF(OR({balance_coordinate}="",NOT(ISNUMBER({balance_coordinate}))),"",'
            f'IF(ABS({balance_coordinate})<{THRESHOLD_CELL},"No","Investigate")))'
        )
        investigate_cell.font = _black_font()
        investigate_cell.alignment = _center_align()
        investigate_cell.border = _full_border()
        investigate_cell.number_format = "General"
        investigate_cell.fill = _no_fill()

        # Remember this cell's location so we can colour it green/red afterwards.
        investigate_coordinates.append(investigate_cell.coordinate)

    # Write the three summary header labels (Total / Total as per Tab 2 / Difference).
    for column, label in ((total_column, TOTAL_HEADER), (tab2_column, TAB_2_TOTAL_HEADER), (difference_column, DIFFERENCE_HEADER)):
        header_cell = worksheet.cell(row=header_row, column=column)
        header_cell.value = label
        header_cell.font = _header_font()
        header_cell.alignment = _header_align()
        header_cell.fill = _white_fill()
        header_cell.border = _full_border()

    # "Total" = the sum of all the entity balances in this block (a live Excel SUM formula).
    total_cell = worksheet.cell(row=balance_row, column=total_column)
    first_coordinate = worksheet.cell(row=balance_row, column=entity_start_column).coordinate
    last_coordinate = worksheet.cell(row=balance_row, column=entity_end_column).coordinate

    total_cell.value = f"=SUM({first_coordinate}:{last_coordinate})"
    total_cell.font = _black_font()
    total_cell.alignment = _right_align()
    total_cell.fill = _white_fill()
    total_cell.border = _full_border()
    total_cell.number_format = MONEY_FORMAT

    # Look up where this account sits on Tab 2 so we can pull its official total.
    account_key = s3a_normalize_account(account_value)
    tab2_row = tab2_row_lookup.get(account_key)

    tab2_cell = worksheet.cell(row=balance_row, column=tab2_column)
    tab2_cell.font = _black_font()
    tab2_cell.alignment = _right_align()
    tab2_cell.fill = _white_fill()
    tab2_cell.border = _full_border()
    tab2_cell.number_format = MONEY_FORMAT

    if tab2_row is None:
        # Account isn't on Tab 2 — show a dash instead of a linked value.
        tab2_cell.value = "-"
        tab2_cell.number_format = "General"
    else:
        # Otherwise link straight to that account's total cell on Tab 2 (a live reference).
        tab2_cell.value = f"={quote_sheetname(TAB_2_SHEET)}!${TAB_2_TOTAL_COLUMN}${tab2_row}"

    difference_cell = worksheet.cell(row=balance_row, column=difference_column)
    difference_cell.font = _black_font()
    difference_cell.alignment = _right_align()
    difference_cell.fill = _white_fill()
    difference_cell.border = _full_border()
    difference_cell.number_format = MONEY_FORMAT

    if tab2_row is None:
        # No Tab 2 match -> no difference to show.
        difference_cell.value = "-"
        difference_cell.number_format = "General"
    else:
        # "Difference" = our Total minus Tab 2's total, but:
        #   - if either side isn't a number, show a dash
        #   - if the rounded difference is zero, show a dash (i.e. treat as "they match")
        #   - otherwise show the actual difference
        difference_cell.value = (
            f'=IF(OR(NOT(ISNUMBER({total_cell.coordinate})),NOT(ISNUMBER({tab2_cell.coordinate}))),"-",'
            f'IF(ROUND({total_cell.coordinate}-{tab2_cell.coordinate},0)=0,"-",'
            f'{total_cell.coordinate}-{tab2_cell.coordinate}))'
        )

    # The investigate row under the three summary columns stays blank but keeps the box styling.
    for column in (total_column, tab2_column, difference_column):
        summary_cell = worksheet.cell(row=investigate_row, column=column)
        summary_cell.value = None
        summary_cell.font = _black_font()
        summary_cell.alignment = _center_align()
        summary_cell.fill = _white_fill()
        summary_cell.border = _full_border()

    return investigate_coordinates


