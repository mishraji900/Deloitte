def entity_columns_for_date(columns: list[str], suffix: str) -> list[str]:
    return [
        column for column in columns
        if str(column).endswith(f"_{suffix}")
        and not str(column).startswith(ENTITY_SKIP_PREFIXES)
    ]


def strip_date_suffix(column: str, suffix: str) -> str:
    return column[:-(len(suffix) + 1)].rstrip("_").strip()


def identify_flagged_accounts(
    dataframe: pd.DataFrame,
    display_roles: dict[str, str],
    role_a: str,
    role_b: str,
) -> list[str]:
    current = pd.to_numeric(
        dataframe[display_roles[role_a]], errors="coerce"
    ).fillna(0)
    comparison = pd.to_numeric(
        dataframe[display_roles[role_b]], errors="coerce"
    ).fillna(0)

    dollar_change = current - comparison
    percent_change = dollar_change.div(
        comparison.replace(0, float("nan"))
    ).fillna(0)

    flagged = (
        dollar_change.abs().gt(THRESHOLD_DOLLARS)
        & percent_change.abs().gt(THRESHOLD_PERCENT)
    )
    return dataframe.loc[flagged, ACCOUNT_GROUP_COLUMN].tolist()


def build_legal_entity_dataframe(
    raw_df: pd.DataFrame,
    flagged_accounts: list[str],
    raw_current_column: str,
    raw_comparison_column: str,
) -> pd.DataFrame:
    current_suffix = raw_current_column.split("_")[-1]
    comparison_suffix = raw_comparison_column.split("_")[-1]

    current_entity_columns = entity_columns_for_date(
        list(raw_df.columns), current_suffix
    )
    comparison_entity_columns = entity_columns_for_date(
        list(raw_df.columns), comparison_suffix
    )

    current_labels = {
        strip_date_suffix(column, current_suffix): column
        for column in current_entity_columns
    }
    comparison_labels = {
        strip_date_suffix(column, comparison_suffix): column
        for column in comparison_entity_columns
    }

    entity_labels = sorted(
        set(current_labels) | set(comparison_labels),
        key=str.lower,
    )

    filtered = raw_df[
        raw_df[ACCOUNT_GROUP_COLUMN].isin(flagged_accounts)
    ].copy()

    all_entity_columns = current_entity_columns + comparison_entity_columns
    for column in all_entity_columns:
        if column in filtered.columns:
            filtered[column] = pd.to_numeric(
                filtered[column], errors="coerce"
            ).fillna(0)

    available_columns = [
        column for column in all_entity_columns
        if column in filtered.columns
    ]

    grouped = (
        filtered.groupby(ACCOUNT_GROUP_COLUMN, sort=False)[available_columns]
        .sum()
    )

    rows = []
    for entity in entity_labels:
        row = {"entity_label": entity}
        has_value = False

        for account in flagged_accounts:
            if account not in grouped.index:
                current_value = comparison_value = 0.0
            else:
                current_column = current_labels.get(entity)
                comparison_column = comparison_labels.get(entity)
                current_value = (
                    float(grouped.loc[account, current_column])
                    if current_column in grouped.columns else 0.0
                )
                comparison_value = (
                    float(grouped.loc[account, comparison_column])
                    if comparison_column in grouped.columns else 0.0
                )

            dollar_change = current_value - comparison_value
            percent_change = (
                dollar_change / comparison_value
                if comparison_value != 0 else 0.0
            )

            row[f"{account}__current"] = current_value
            row[f"{account}__comparison"] = comparison_value
            row[f"{account}__dollar"] = dollar_change
            row[f"{account}__percent"] = percent_change

            has_value |= current_value != 0 or comparison_value != 0

        if has_value:
            rows.append(row)

    return pd.DataFrame(rows)


