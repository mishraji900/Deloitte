def s3a_copy_block_style(
    worksheet,
    source_start_row,
    target_start_row,
    start_column,
    end_column,
    source_max_column,
):
    for row_offset in range(DATA_ROWS):
        source_row = source_start_row + row_offset
        target_row = target_start_row + row_offset

        worksheet.row_dimensions[target_row].height = (
            worksheet.row_dimensions[source_row].height
        )

        for column in range(
            start_column,
            end_column + 1,
        ):
            source_cell = worksheet.cell(
                row=source_row,
                column=min(column, source_max_column),
            )
            target_cell = worksheet.cell(
                row=target_row,
                column=column,
            )

            if not isinstance(target_cell, MergedCell):
                style_args = (
                    source_cell._style
                    if source_cell._style is not None
                    else _DEFAULT_STYLE
                )
                target_cell._style = StyleArray(
                    style_args
                )


def s3a_wipe_spacer_rows(
