def run_pipeline(src, cols, steps, pfx, year_flag, equal_guard=False):
    """Classify -> pair -> split. Writes exactly 2 parquet files: {pfx}_CLASSIFIED and {pfx}_PAIRED."""
    t = base_tag(src, cols)

    blank = F.col("invoice_ref_clean").isNull() | (F.trim(F.col("invoice_ref_clean")) == "")
    is_si = F.col("cat_clean") == "SALES INVOICES"
    is_cm = F.col("cat_clean") == "CREDIT MEMOS"
    zero = F.col("entered_net_dec") == EXACT_ZERO
    # invalid rows get a singleton window partition (no skew on null keys)
    w = Window.partitionBy(F.coalesce(F.col("primary_key"), F.col("row_id")))
    working = F.col("is_valid_row") & ~blank
    t = t.withColumn("pk_row_count", F.sum(F.when(working, 1).otherwise(0)).over(w))

    one, many = F.col("pk_row_count") == 1, F.col("pk_row_count") > 1
    t = t.withColumn("bucket",
        F.when(~F.col("is_valid_row"), "INVALID")
         .when(blank, "EXC_1")
         .when(one & ~(is_si | is_cm), "UNIQUE_OTHER")
         .when(one & is_si, "UNIQUE_SALES")
         .when(one & is_cm, "UNIQUE_CREDITS")
         .when(many & (~(is_si | is_cm) | zero), "DUP_OTHER_OR_ZERO")
         .otherwise("DUP_SI_CM"))

    if equal_guard:  # PK groups with unequal sales/credit counts skip matching
        in_pool = F.col("bucket") == "DUP_SI_CM"
        n_s = F.sum(F.when(in_pool & is_si, 1).otherwise(0)).over(w)
        n_c = F.sum(F.when(in_pool & is_cm, 1).otherwise(0)).over(w)
        t = t.withColumn("bucket", F.when(in_pool & (n_s != n_c), "DUP_UNEQUAL_COUNT").otherwise(F.col("bucket")))

    t = t.drop("is_valid_row", "valid_company_desc", "valid_vendor_num")
    C = save(t, f"{pfx}_CLASSIFIED")
    b = lambda k: C.filter(F.col("bucket") == k)

    pool = b("DUP_SI_CM")
    slim = (pool.select("primary_key", F.col("row_id").alias("rid"), F.col("cat_clean").alias("cat"),
                        F.col("entered_net_dec").alias("amt"), F.col("eff_dt").alias("eff"),
                        F.col("month_dt").alias("mon"), F.col("Year Flag").alias("yf"))
                .groupBy("primary_key")
                .applyInPandas(make_pairer(steps, CURRENT_FY), PAIR_SCHEMA))
    side = lambda k: slim.select(F.col(k).alias("row_id"), "pair_id", "match_type",
                                 F.col("year_pair_flag").alias("Year Pair Flag"))
    paired = save(pool.join(side("sales_row_id").unionByName(side("credit_row_id")), "row_id", "left"),
                  f"{pfx}_PAIRED")

    matched = paired.filter(F.col("pair_id").isNotNull())
    if not year_flag:
        matched = matched.drop("Year Pair Flag")
    rest = paired.filter(F.col("pair_id").isNull()).drop("pair_id", "match_type", "Year Pair Flag")

    return {
        "invalid": b("INVALID"), "exc1": b("EXC_1"),
        "dup_other": b("DUP_OTHER_OR_ZERO"), "unique_other": b("UNIQUE_OTHER"),
        "matched": matched,
        "unmatched": union_non_null(b("UNIQUE_SALES"), b("UNIQUE_CREDITS"), b("DUP_UNEQUAL_COUNT"), rest),
    }

