def block(
    merge_range: str,
    dollar_column: str,
    percent_column: str,
    flag_column: str,
    current_role: str,
    comparison_role: str,
    yes_list_column: str = "",
) -> ComparisonBlock:
    return ComparisonBlock(
        merge_range,
        dollar_column,
        percent_column,
        flag_column,
        current_role,
        comparison_role,
        yes_list_column,
    )


