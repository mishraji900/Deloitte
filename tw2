        row_id_col=row_id_col,
    )

    account_column = _require_column(
        source_columns,
        "Account",
    )
    percentage_column = _require_column(
        source_columns,
        "% of consolidated balance",
    )
    test_column = _require_column(
        source_columns,
        "Test consolidated amount",
    )

    entity_columns = []
    consolidated_column = None
    untested_column = None

    if calculated_columns:
        if materiality is None:
            materiality = MATERIALITY

        entity_columns = _find_residual_entity_columns(
            source_columns,
            calculated_columns,
        )

        consolidated_column = _require_column(
            source_columns,
            "Consolidated",
        )
        untested_column = _require_column(
