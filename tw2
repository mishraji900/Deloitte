def append_raw_tb_cy_to_sheet(template, raw_tb_CY, spark_column_row_pairs_cy, target_sheet,
                              anchor_cell=TABLE_ANCHOR_CELL, calculated_columns=None,
                              clear_existing=True, materiality=None, row_id_col="row_id"):
    """
    WHAT: the Section-2 entry point. Writes raw_tb_CY into `target_sheet` at `anchor_cell`.
          - Visible rows: non-zero % AND Test == 'No' (blue cells shown in BLUE_FONT_COLOR).
          - All other rows: greyed out (account name only; rest blanked).
          - QUANTITATIVE only: inserts the six calculated columns + two detail sub-rows
            per visible account, and boxes each account as a 3-row package.
    CALLED BY: the run block below (once for Quant, once for Qual).
    INPUTS FROM: raw_tb_CY (PRE-grey frame), spark_column_row_pairs_cy (blue pairs), MATERIALITY.
    OUTPUT FLOW: mutates `template`; returns a small summary dict + prints diagnostics.
    """
    # Basic checks: the sheet must exist and the data must have a row label column.
    if target_sheet not in template.sheetnames:
        raise ValueError(f"Worksheet not found: {target_sheet!r}")
    if row_id_col not in raw_tb_CY.columns:
        raise ValueError(f"Missing row ID column: {row_id_col!r}")

    worksheet = template[target_sheet]
    source_columns = [c for c in raw_tb_CY.columns if c != row_id_col]   # row_id: matching only, never written

    # Decide which calculated columns apply: use the standard six by default, but the
    # Qualitative sheet gets none (it's a plain table).
    if calculated_columns is None:
        calculated_columns = CALCULATED_COLUMNS
    calculated_columns = _unique_texts(calculated_columns)
    if target_sheet != QUANTITATIVE_SHEET:   # Qualitative sheet gets NO calculated columns
        calculated_columns = []

    # Work out the final column order and note which columns are the calculated ones.
    output_columns = _arrange_output_columns(source_columns, calculated_columns)
    calculated_keys = {_normalise_column_name(c) for c in calculated_columns}

    # Validate + index the CY blue pairs for this frame.
    blue_pair_keys = _build_existing_cy_pair_lookup(
        spark_column_row_pairs_cy, raw_tb_CY, row_id_col=row_id_col)

    # Find the exact names of the key business columns we rely on.
    account_column = _require_column(source_columns, "Account")
    percentage_column = _require_column(source_columns, "% of consolidated balance")
    test_column = _require_column(source_columns, "Test consolidated amount")

    # These extra columns are only needed when we're doing the full analysis (Quantitative sheet).
