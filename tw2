def _build_existing_cy_pair_lookup(spark_column_row_pairs_cy, raw_tb_CY, row_id_col="row_id"):
    """
    WHAT: validate the CY blue pairs and return them as a set of (column, int row_id)
          for O(1) membership checks.
    CALLED BY: append_raw_tb_cy_to_sheet (produces blue_pair_keys).
    OUTPUT FLOW: blue_pair_keys is used to (a) exclude blue entities from residual stats,
                 and (b) render blue-font cells.
    """
    # Take the list of blue (manual-override) cell locations, check each one is valid, and
    # put them into a set. A set lets us later ask "is this cell blue?" instantly.
    if not spark_column_row_pairs_cy:
        raise ValueError("spark_column_row_pairs_cy is empty.")
    source_columns = [c for c in raw_tb_CY.columns if c != row_id_col]
    source_column_set = set(source_columns)
    exact_pairs = set()
    for position, pair in enumerate(spark_column_row_pairs_cy, start=1):
        # Each entry must be a two-item (column, row) pair — anything else is a mistake.
        if not isinstance(pair, (tuple, list)) or len(pair) != 2:
            raise ValueError(f"Invalid CY pair at position {position}: {pair!r}")
        column_name, row_id = pair
        # The row label column can never be a blue target.
        if column_name == row_id_col:
            raise ValueError(f"row_id cannot be a blue-cell target: {pair!r}")
        # The named column has to actually exist in the data.
        if column_name not in source_column_set:
            raise ValueError(f"CY column does not exist: {column_name!r}")
        # The row number must be a real whole number of at least 1 (and not a True/False).
        if isinstance(row_id, bool) or not isinstance(row_id, Integral) or int(row_id) < 1:
            raise ValueError(f"Invalid CY row_id: {pair!r}")
        exact_pairs.add((column_name, int(row_id)))
    return exact_pairs


def _calculate_analysis_values(record, source_row_id, entity_columns, blue_pair_keys,
                               materiality, consolidated_column, untested_column):
    """
    WHAT: compute the six D&T analysis metrics for ONE account row. "Residual balances"
          EXCLUDES entity columns that were blue-flagged for this row (manual overrides).
    CALLED BY: append_raw_tb_cy_to_sheet (Quantitative sheet only).
    OUTPUT FLOW: returns a dict {calculated_column_label: value} written into those columns.
    """
    # Materiality is the yardstick we divide by, so it must be present and not zero.
    materiality_value = _to_decimal(materiality)
    if materiality_value in (None, Decimal("0")):
        raise ValueError("MATERIALITY must be a non-zero numeric value.")

    # Gather the "residual" entity balances for this account: go through each legal-entity
    # column, but SKIP any that were blue-flagged for this row (those are manual overrides
    # we don't want in the automatic stats), and ignore blanks and zeros.
    residual_balances = [
        balance
        for column in entity_columns
        if (column, source_row_id) not in blue_pair_keys       # skip blue-flagged entities
        for balance in [_to_decimal(record.get(column))]
        if balance not in (None, Decimal("0"))
    ]

    # Work out the average, middle value, and largest of those balances (if any exist).
    mean_value = median_value = highest_balance = None
    if residual_balances:
        mean_value = sum(residual_balances) / Decimal(len(residual_balances))
        median_value = _median_decimal(residual_balances)
        highest_balance = max(residual_balances)

    untested_balance = _to_decimal(record.get(untested_column))
    consolidated_balance = _to_decimal(record.get(consolidated_column))

    # The three ratio metrics, each guarded so we never divide by nothing/zero:
    #  - how many times materiality the untested balance is
    times_of_materiality = (untested_balance / materiality_value
                            if untested_balance is not None else None)
    #  - the biggest single entity balance as a share of the consolidated total
    percentage_of_total = (highest_balance / consolidated_balance
                           if highest_balance is not None
                           and consolidated_balance not in (None, Decimal("0")) else None)
    #  - the biggest single entity balance measured against materiality
    multiple_of_materiality = (highest_balance / materiality_value
                               if highest_balance is not None else None)

    # Hand back all six numbers labelled by their column names.
    return {
        "Times of materiality": times_of_materiality,
        "Mean": mean_value,
        "Median": median_value,
        "Highest balance in a residual entity": highest_balance,
        "% of the total balance": percentage_of_total,
        "Multiple of materiality balance": multiple_of_materiality,
    }


def _unmerge_intersecting_ranges(worksheet, row_number, start_column, end_column):
    """
    WHAT: unmerge any merged range that intersects the given row/column span, so headers
          can be re-merged cleanly on a re-run.
    CALLED BY: _write_table_headers and _write_analysis_headers.
    """
    # Before we re-join header cells, split apart any existing joined cells that overlap
    # the area we're about to work on — otherwise re-merging can fail or misbehave.
    for merged_range in list(worksheet.merged_cells.ranges):
        if (merged_range.min_row <= row_number <= merged_range.max_row
                and merged_range.min_col <= end_column
                and merged_range.max_col >= start_column):
            worksheet.unmerge_cells(merged_range.coord)


def _apply_header_style(cell, fill, border, font, alignment):
    """WHAT: apply the standard header look to one cell.
    CALLED BY: _write_table_headers and _write_analysis_headers."""
    # Give one header cell the standard look: background, border, text style, and alignment.
    cell.fill = fill
    cell.border = border
    cell.font = font
    cell.alignment = alignment
    cell.number_format = "General"


def _write_table_headers(worksheet, header_row, start_column, output_columns,
                         fill, border, font, alignment):
    """
    WHAT: write the main column-header row (one cell per output column).
    CALLED BY: append_raw_tb_cy_to_sheet.
    """
    # Write the row of column titles, one title per column, and style each one.
    end_column = start_column + len(output_columns) - 1
    _unmerge_intersecting_ranges(worksheet, header_row, start_column, end_column)
    for index, column_label in enumerate(output_columns):
        cell = worksheet.cell(row=header_row, column=start_column + index)
        cell.value = column_label
        _apply_header_style(cell, fill, border, font, alignment)


def _write_analysis_headers(worksheet, header_row, start_column, output_columns,
                            calculated_columns, fill, border, font, alignment):
    """
    WHAT: draw the two merged banner rows ABOVE the calculated columns:
          "D&T analysis" (spanning all calculated columns) and
          "Highest balance in a residual entities" (spanning the HIGHEST_BALANCE_GROUP).
    CALLED BY: append_raw_tb_cy_to_sheet (Quantitative sheet only; no-op if no calc cols).
    """
    # This draws the two title bars that sit ABOVE the six calculated columns:
    # a wide "D&T analysis" bar over all six, and a narrower "Highest balance..." bar over
    # the three highest-balance columns. If there are no calculated columns, there's nothing to do.
    if not calculated_columns:
        return
    calculated_keys = {_normalise_column_name(c) for c in calculated_columns}
    # Work out which column positions the calculated columns and the highest-balance group occupy.
    calculated_indices = [i for i, c in enumerate(output_columns)
                          if _normalise_column_name(c) in calculated_keys]
    highest_indices = [i for i, c in enumerate(output_columns)
                       if _normalise_column_name(c) in HIGHEST_BALANCE_GROUP]
    if not calculated_indices or not highest_indices:
        raise ValueError("Calculated header columns were not found.")

    # Turn those positions into actual first/last column numbers for each bar.
    analysis_start = start_column + min(calculated_indices)
    analysis_end = start_column + max(calculated_indices)
    highest_start = start_column + min(highest_indices)
    highest_end = start_column + max(highest_indices)

    top_row = header_row - 2       # "D&T analysis" banner row
    subgroup_row = header_row - 1  # "Highest balance..." banner row

    # Clear + restyle both banner rows across the analysis span before merging.
    # (Empty and re-style the cells first so the merge starts from a clean, consistent state.)
    for row_number in (top_row, subgroup_row):
        _unmerge_intersecting_ranges(worksheet, row_number, analysis_start, analysis_end)
        for column_number in range(analysis_start, analysis_end + 1):
            cell = worksheet.cell(row=row_number, column=column_number)
            cell.value = None
            _apply_header_style(cell, fill, border, font, alignment)

    # Join the top row into one wide cell and label it "D&T analysis".
    worksheet.merge_cells(start_row=top_row, start_column=analysis_start,
                          end_row=top_row, end_column=analysis_end)
    dt_header = worksheet.cell(row=top_row, column=analysis_start)
    dt_header.value = "D&T analysis"
    _apply_header_style(dt_header, fill, border, font, alignment)

    # Join the second row across just the highest-balance columns and label it.
    worksheet.merge_cells(start_row=subgroup_row, start_column=highest_start,
                          end_row=subgroup_row, end_column=highest_end)
    highest_header = worksheet.cell(row=subgroup_row, column=highest_start)
    highest_header.value = "Highest balance in a residual entities"
    _apply_header_style(highest_header, fill, border, font, alignment)


def _write_detail_row(worksheet, row_number, start_column, output_columns, account_column,
                      entity_columns, record, consolidated_column, materiality, label,
                      calculation_type, white_fill, body_border, body_font):
    """
    WHAT: write ONE 'X at each legal entity' sub-row beneath a visible account:
          - calculation_type='percentage' -> entity balance / consolidated (0.00%)
          - calculation_type='multiple'   -> entity balance / materiality   (0.00)
          The account-name cell instead holds the descriptive `label`.
    CALLED BY: append_raw_tb_cy_to_sheet (Quantitative sheet only; twice per visible account).
    """
    # This writes one extra "breakdown" row under an account. For each legal-entity column
    # it fills in either a percentage or a multiple; the account-name cell holds a description.
    materiality_value = _to_decimal(materiality)
    consolidated_value = _to_decimal(record.get(consolidated_column))
    value_alignment = make_alignment("right", "center")
    label_alignment = make_alignment("right", "center")

    for index, column_label in enumerate(output_columns):
        # Start each cell blank with the standard body look.
        cell = worksheet.cell(row=row_number, column=start_column + index)
        cell.value = None
        cell.fill = white_fill
        cell.border = body_border
        cell.font = body_font
        cell.alignment = value_alignment
        cell.number_format = "General"

        if column_label == account_column:           # put the descriptive label here
            cell.value = label
            cell.alignment = label_alignment
            continue
        if column_label not in entity_columns:        # only entity columns carry a value
            continue

        # Get this entity's balance; if there's nothing here, leave the cell blank.
        balance = _to_decimal(record.get(column_label))
        if balance is None:
            continue
        if calculation_type == "percentage":
            # entity balance as a share of the consolidated total — skip if total is missing/zero
            if consolidated_value in (None, Decimal("0")):
                continue
            cell.value = balance / consolidated_value
            cell.number_format = "0.00%"
        else:                                          # "multiple"
            # entity balance measured against materiality
            cell.value = balance / materiality_value
            cell.number_format = "0.00"


def _apply_package_borders(worksheet, package_start_row, package_end_row, start_column, end_column):
    """
    WHAT: draw a solid black outline around each account's 3-row "package" (data row +
          two detail rows), with light-gray gridlines inside.
    CALLED BY: append_raw_tb_cy_to_sheet (Quantitative sheet only, after all rows written).
    """
    # Draw a box around a whole account "package": a bold black line on the outside edges
    # and faint grey lines between the cells inside. We decide, per cell, whether each of its
    # four sides is on the outer edge (black) or inside (light grey).
    black_side = Side(style="thin", color=BLACK)
    light_side = Side(style="thin", color=PACKAGE_LIGHT_GRAY)
    for row_number in range(package_start_row, package_end_row + 1):
        for column_number in range(start_column, end_column + 1):
            cell = worksheet.cell(row=row_number, column=column_number)
            cell.border = Border(
                left=black_side if column_number == start_column else light_side,
                right=black_side if column_number == end_column else light_side,
                top=black_side if row_number == package_start_row else light_side,
                bottom=black_side if row_number == package_end_row else light_side,
            )


