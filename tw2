def write_row(worksheet, row_number, values, header=False, body_fill=None):
    fill = body_fill or WHITE_BODY_FILL
    for column_number, raw_value in enumerate(values, start=1):
        value = excel_value(raw_value)
        cell  = worksheet.cell(row=row_number, column=column_number, value=value)
        cell.border = table_border
        if header:
            cell.fill      = copy(BLACK_HEADER_FILL)
            cell.font      = header_font
            cell.alignment = center_alignment
        else:
            cell.fill = copy(fill)
            cell.font = body_font
            cell.alignment = (
                right_alignment
                if isinstance(value, (int, float)) and not isinstance(value, bool)
                else left_alignment
            )
        if isinstance(value, int) and not isinstance(value, bool):
            cell.number_format = COUNT_FORMAT
        elif isinstance(value, float):
            cell.number_format = MONEY_FORMAT


