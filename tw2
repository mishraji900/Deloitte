                    data_start_row + records_written - 1,
                )
            )

    end_column = start_column + len(output_columns) - 1

    if target_sheet == QUANTITATIVE_SHEET:
        for package_start, package_end in package_ranges:
            _apply_package_borders(
                worksheet=worksheet,
                package_start_row=package_start,
