def write_cell(
    cell,
    value: Any = None,
    font=None,
    fill=None,
    border=None,
    alignment=None,
    number_format: str | None = None,
) -> None:
    cell.value = value
    if font is not None:
        cell.font = font
    if fill is not None:
        cell.fill = fill
    if border is not None:
        cell.border = border
    if alignment is not None:
        cell.alignment = alignment
    if number_format is not None:
        cell.number_format = number_format


def put(
    worksheet,
    reference: str,
    value: Any = None,
    **style,
) -> None:
    write_cell(worksheet[reference], value, **style)


def put_rc(
    worksheet,
    row: int,
    column: int,
    value: Any = None,
    **style,
) -> None:
    write_cell(worksheet.cell(row=row, column=column), value, **style)


def drop_merge(worksheet, merged_range) -> None:
    """unmerge_cells raises KeyError on overlapping template merges.
    Remove the range, pop leftover placeholder cells, never raise."""
    worksheet.merged_cells.remove(merged_range)
    first = (merged_range.min_row, merged_range.min_col)
    for row in range(merged_range.min_row, merged_range.max_row + 1):
        for col in range(merged_range.min_col, merged_range.max_col + 1):
            if (row, col) != first:
                worksheet._cells.pop((row, col), None)


def variance_formulas(
    row: int,
    config: SheetConfig,
    comparisons: list[ComparisonBlock],
) -> dict[str, str]:
    current_column = config.role_to_excel_column["current"]
    formulas = {}

    for comparison in comparisons:
        comparison_column = config.role_to_excel_column[
            comparison.comparison_role
        ]
        dollar = comparison.dollar_column
        percent = comparison.percent_column
        flag = comparison.flag_column

        formulas[f"{dollar}{row}"] = (
            f"={current_column}{row}-{comparison_column}{row}"
        )
        formulas[f"{percent}{row}"] = (
            f"=IFERROR({dollar}{row}/{comparison_column}{row},0)"
        )
        formulas[f"{flag}{row}"] = (
            f'=IF(AND(ABS({dollar}{row})>{config.materiality_dollar_anchor},'
            f'ABS({percent}{row})>{config.materiality_percent_anchor}),'
            f'"{YES_VALUE}","{NO_VALUE}")'
        )

    return formulas


def write_variance_cells(
    worksheet,
    formulas: dict[str, str],
    comparisons: list[ComparisonBlock],
    font,
    border=None,
) -> None:
    percent_columns = {item.percent_column for item in comparisons}
    flag_columns = {item.flag_column for item in comparisons}

    for reference, formula in formulas.items():
        column = re.sub(r"\d", "", reference)
        put(
            worksheet,
            reference,
            formula,
            font=font,
            border=border,
            alignment=CENTER_ALIGN if column in flag_columns else RIGHT_ALIGN,
            number_format=(
                PERCENT_FORMAT if column in percent_columns else NUMBER_FORMAT
            ),
        )


def apply_conditional_formatting(
    worksheet,
    comparisons: list[ComparisonBlock],
    first_row: int,
    last_row: int,
) -> None:
    # No reset here: stacked sections share one sheet. write_summary_sheet resets once.
    for comparison in comparisons:
        for row in range(first_row, last_row + 1):
            reference = f"{comparison.flag_column}{row}"
            formula = f'{absolute_coordinate(reference)}="{YES_VALUE}"'
            rule = FormulaRule(formula=[formula], stopIfTrue=True)
            rule.dxf = YES_FILL
            rule.priority = 1
            worksheet.conditional_formatting.add(reference, rule)


def shift_range(rng: str, top: int) -> str:
    """'B6:M8' -> same columns, first row = top, height kept."""
    left, right = rng.split(":")
    row_a, row_b = (int(re.sub(r"\D", "", part)) for part in (left, right))
    col_a, col_b = (re.sub(r"\d+", "", part) for part in (left, right))
    return f"{col_a}{top}:{col_b}{top + row_b - row_a}"


def put_banner(worksheet, row: int, text: str, last_column: int) -> None:
    for column in range(2, last_column + 1):
        put_rc(
            worksheet, row, column, text if column == 2 else None,
            font=SECTION_FONT, fill=SECTION_FILL, alignment=LEFT_ALIGN,
        )
    worksheet.row_dimensions[row].height = 20


def write_summary_sheet(
    worksheet,
    config: SheetConfig,
    dataframe: pd.DataFrame,
    display_roles: dict[str, str],
    comparisons: list[ComparisonBlock],
    grouping,
    below: int | None = None,
    banner: str | None = None,
) -> int:
    """Write one analytics section. below=None -> first section on the sheet
    (clears sheet, writes title + materiality). below=row -> stacked under that
    row, reusing the sheet's materiality cells. Returns the section's total row."""
    stacked = below is not None

    if stacked:
        banner_row = below + YTD_GAP_ROWS
        procedure_row = banner_row + 2
        block_row = procedure_row + 4
    else:
        banner_row = 9
        procedure_row = 6
        block_row = SUMMARY_BLOCK_ROW
    header_row = block_row + 1
    first_row = header_row + 1 if stacked else config.first_data_row

    # ---- first section only: wipe template, title, shared materiality -------
    if not stacked:
        for merged_range in list(worksheet.merged_cells.ranges):
            if (
                merged_range.min_row == block_row
                or merged_range.max_row >= first_row
                or (
                    merged_range.max_row >= procedure_row
                    and merged_range.min_row <= procedure_row + 2
                )
            ):
                drop_merge(worksheet, merged_range)

        for row in worksheet.iter_rows(
            min_row=first_row,
            max_row=max(worksheet.max_row, first_row),
            min_col=2,
            max_col=config.max_data_column,
        ):
            for cell in row:
                cell.value = None

        for row in (block_row, header_row):
            for column in range(2, config.max_data_column + 1):
                worksheet.cell(row=row, column=column).value = None

        worksheet.sheet_view.showGridLines = False
        worksheet.conditional_formatting._cf_rules = {}
        for row in range(2, 5):
            for column in range(3, 10):  # C:I
                worksheet.cell(row=row, column=column).value = None

        put(worksheet, "B1", CLIENT_NAME, font=BOLD_FONT)
        put(worksheet, "B2", config.subtitle, font=BOLD_FONT)
        put(worksheet, "B3", PERIOD_LABEL, font=BOLD_FONT)

        put(worksheet, f"{config.materiality_label_column}2",
            "Materiality", font=BOLD_FONT)
        put(worksheet, f"{config.materiality_label_column}3",
            "Threshold (in $)", font=BOLD_FONT)
        put(worksheet, f"{config.materiality_label_column}4",
            "Threshold (in %)", font=BOLD_FONT)
        put(worksheet, f"{config.materiality_value_column}2",
            MATERIALITY, font=BOLD_FONT, fill=RED_HIGHLIGHT_FILL,
            number_format=NUMBER_FORMAT)
        put(worksheet, f"{config.materiality_value_column}3",
            THRESHOLD_DOLLARS, font=BOLD_FONT, fill=RED_HIGHLIGHT_FILL,
            number_format=NUMBER_FORMAT)
        put(worksheet, f"{config.materiality_value_column}4",
            THRESHOLD_PERCENT, font=BOLD_FONT, fill=RED_HIGHLIGHT_FILL,
            number_format=PERCENT_FORMAT)

    # ---- section indicator ----------------------------------------------------
    if banner:
        put_banner(worksheet, banner_row, banner, BANNER_LAST_COLUMN)
    if stacked:
        target = f"'{worksheet.title}'!B{banner_row}"
        put(worksheet, "B4", f'=HYPERLINK("#{target}","Jump to YTD section >>")',
            font=LINK_FONT)

    # ---- procedure box --------------------------------------------------------
    put(
        worksheet, f"B{procedure_row}", PROCEDURE_TEXT,
        font=NORMAL_FONT, fill=PROCEDURE_FILL, alignment=LEFT_WRAP,
    )
    worksheet.merge_cells(shift_range(config.procedure_merge_range, procedure_row))

    # ---- column headers -------------------------------------------------------
    put(
        worksheet, f"B{header_row}",
        "Account Description",
        font=HEADER_FONT, fill=HEADER_FILL,
        border=THIN_BORDER, alignment=CENTER_WRAP,
    )
    for role, col in config.role_to_excel_column.items():
        put(
            worksheet, f"{col}{header_row}",
            f"{config.header_prefix}{display_roles[role]}",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )

    for item in comparisons:
        put(
            worksheet, f"{item.dollar_column}{block_row}",
            f"{config.header_prefix}{display_roles[item.current_role]} vs "
            f"{config.header_prefix}{display_roles[item.comparison_role]}",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        worksheet.merge_cells(shift_range(item.merge_range, block_row))

        put(
            worksheet, f"{item.dollar_column}{header_row}",
            "$ Variance",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        put(
            worksheet, f"{item.percent_column}{header_row}",
            "% Variance",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        put(
            worksheet, f"{item.flag_column}{header_row}",
            "Further explain at\nLE level?",
            font=HEADER_FONT, fill=HEADER_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )
        if item.yes_list_column:
            put(
                worksheet, f"{item.yes_list_column}{header_row}",
                "Accounts Flagged\n(Yes)",
                font=HEADER_FONT, fill=YES_HEADER_FILL,
                border=THIN_BORDER, alignment=CENTER_WRAP,
            )

    put(
        worksheet, f"{config.tickmark_column}{header_row}",
        "Tickmark",
        font=HEADER_FONT, fill=HEADER_FILL,
        border=THIN_BORDER, alignment=CENTER_WRAP,
    )

    worksheet.row_dimensions[block_row].height = 30
    worksheet.row_dimensions[header_row].height = 42

    # ---- detail rows ----------------------------------------------------------
    detail_rows, totals, total_row = plan_rows(dataframe, first_row, grouping)
    last_data_row = total_row - 1

    for row_number, (_, source_row) in zip(detail_rows, dataframe.iterrows()):
        put(
            worksheet, f"B{row_number}",
            source_row[ACCOUNT_GROUP_COLUMN],
            font=NORMAL_FONT, alignment=LEFT_ALIGN,
        )

        for role, column in config.role_to_excel_column.items():
            put(
                worksheet,
                f"{column}{row_number}",
                float(source_row[display_roles[role]]),
                font=NORMAL_FONT,
                alignment=RIGHT_ALIGN,
                number_format=NUMBER_FORMAT,
            )

        write_variance_cells(
            worksheet,
            variance_formulas(row_number, config, comparisons),
            comparisons,
            NORMAL_FONT,
        )

        put(
            worksheet, f"{config.tickmark_column}{row_number}",
            None, font=RED_BOLD_FONT, alignment=CENTER_ALIGN,
        )
        worksheet.row_dimensions[row_number].height = 18

    # ---- group total rows -----------------------------------------------------
    skip_cols = config.spacer_columns | {
        column_index_from_string(item.yes_list_column)
        for item in comparisons if item.yes_list_column
    }
    subtotal_rows = {sub_row for sub_row, _, _ in totals}
    spacer_rows = {sub_row + 1 for sub_row in subtotal_rows}

    for sub_row, label, members in totals:
        for col in range(2, config.max_data_column + 1):
            if col not in skip_cols:
                worksheet.cell(row=sub_row, column=col).border = SUBTOTAL_BORDER
        put(
            worksheet, f"B{sub_row}", label,
            font=BOLD_FONT, fill=PROCEDURE_FILL, alignment=LEFT_ALIGN,
        )
        for column in config.role_to_excel_column.values():
            put(
                worksheet, f"{column}{sub_row}",
                sum_formula(column, members) if members else 0,
                font=BOLD_FONT, fill=PROCEDURE_FILL,
                alignment=RIGHT_ALIGN, number_format=NUMBER_FORMAT,
            )
        worksheet.row_dimensions[sub_row].height = 18

    # ---- Accounts Flagged (Yes): one merged cell + array formula per block ---
    if len(dataframe):
        for item in comparisons:
            col = item.yes_list_column
            if not col:
                continue
            flag_range = (
                f"{item.flag_column}{first_row}:{item.flag_column}{last_data_row}"
            )
            cell = worksheet[f"{col}{first_row}"]
            cell.value = ArrayFormula(
                f"{col}{first_row}",
                f'=_xlfn.TEXTJOIN(CHAR(10),TRUE,IF({flag_range}="{YES_VALUE}",'
                f'$B${first_row}:$B${last_data_row},""))',
            )
            cell.font = NORMAL_FONT
            cell.border = THIN_BORDER
            cell.alignment = Alignment(
                wrap_text=True, vertical="top", horizontal="left"
            )
            worksheet.merge_cells(f"{col}{first_row}:{col}{last_data_row}")

    # ---- grand total row ------------------------------------------------------
    put(
        worksheet, f"B{total_row}", config.total_label,
        font=BOLD_FONT, border=TOTAL_BORDER, alignment=LEFT_ALIGN,
    )

    for column in config.role_to_excel_column.values():
        value = sum_formula(column, detail_rows) if detail_rows else 0
        put(
            worksheet, f"{column}{total_row}", value,
            font=BOLD_FONT, border=TOTAL_BORDER,
            alignment=RIGHT_ALIGN, number_format=NUMBER_FORMAT,
        )

    write_variance_cells(
        worksheet,
        variance_formulas(total_row, config, comparisons),
        comparisons,
        BOLD_FONT,
        TOTAL_BORDER,
    )

    for item in comparisons:
        if item.yes_list_column:
            put(
                worksheet, f"{item.yes_list_column}{total_row}",
                None, font=BOLD_FONT, border=TOTAL_BORDER,
                alignment=CENTER_ALIGN,
            )

    put(
        worksheet, f"{config.tickmark_column}{total_row}",
        None, font=BOLD_FONT, border=TOTAL_BORDER,
        alignment=CENTER_ALIGN,
    )

    # ---- borders, filter (first section only), conditional formatting --------
    for row in worksheet.iter_rows(
        min_row=first_row,
        max_row=total_row,
        min_col=2,
        max_col=config.max_data_column,
    ):
        if row[0].row in subtotal_rows or row[0].row in spacer_rows:
            continue
        for cell in row:
            if cell.column not in config.spacer_columns and cell.border == Border():
                cell.border = THIN_BORDER

    if not stacked:  # one auto-filter per sheet: QTD / first section only
        worksheet.auto_filter.ref = f"B{header_row}:{config.tickmark_column}{total_row}"
    apply_conditional_formatting(worksheet, comparisons, first_row, total_row)

    return total_row


