import re


TARGET_SHEETS = ("Balance Sheet", "Income Statement")   # the two sheets stacked into one Spark frame.
CELL_PATTERN = re.compile(r"^\$?([A-Za-z]+)\$?(\d+)$")   # parse "AC12" / "$AC$12" -> ("AC","12").


def excel_column_index(excel_column):
    """
    WHAT: convert an Excel column letter ('AC') to a 0-based index.
    CALLED BY: create_appended_spark_column_row_pairs, to map a blue cell's Excel
               column letter onto the matching Spark column position.
    """
    # Excel names columns A, B ... Z, then AA, AB ... — like counting, but with letters.
    # This turns those letters into a number so we can find the column's position.
    # We start counting from A=1 (not 0), then subtract 1 at the end because the first
    # column should be position 0 in a normal list.
    index = 0
    for letter in excel_column.upper():
        index = index * 26 + ord(letter) - ord("A") + 1
    return index - 1


def normalize_sheet_names(sheet_names):
    """
    WHAT: coerce a single name / iterable of names into a set of stripped names.
    CALLED BY: get_blue_amounts and get_dynamic_sheet_row_counts (to validate/filter sheets).
    """
    # Nothing passed in means "don't filter — look at all sheets".
    if sheet_names is None:
        return None
    # If someone passed one name as plain text, treat it as a single sheet.
    if isinstance(sheet_names, str):
        return {sheet_names.strip()}
    # Otherwise it's a list of names — clean up the spaces around each and drop duplicates.
    return {str(name).strip() for name in sheet_names}


def get_blue_amounts(excel_path, sheet_names, excel_data_start_row=4):
    """
    WHAT: scan the workbook and return every BLUE-FONT cell, each tagged with a
          LOCAL 1-based row_id (Excel row 4 -> row_id 1). Opens the file twice:
          once data_only=True (cached values) and once data_only=False (formulas + font).
    CALLED BY: locate_blue_cell_pairs.
    OUTPUT FLOW: the returned list of dicts -> create_appended_spark_column_row_pairs.
    """
    # We open the same file two ways because each way gives us something different:
    #  - the first shows the final NUMBER Excel worked out for each cell,
    #  - the second shows the original FORMULA plus the cell's colour/styling.
    # We look up the number in the first and the colour in the second, cell by cell.
    values_workbook = cp.openpyxl.read(excel_path, data_only=True)     # cached results
    formulas_workbook = cp.openpyxl.read(excel_path, data_only=False)  # formulas + styling

    selected_sheet_names = normalize_sheet_names(sheet_names)
    blue_amounts = []

    def get_font_rgb(cell):
        # Find out the exact colour of the text in this cell, written as a colour code
        # like "0000FF". If the colour isn't stored in that simple form, we give back nothing.
        color = cell.font.color
        if color is None:
            return None
        if color.type == "rgb" and color.rgb:
            # The colour code sometimes has extra characters in front — we keep the last 6,
            # which are the actual red/green/blue part, and make them all capitals.
            return str(color.rgb).replace("#", "")[-6:].upper()
        return None

    def is_blue_font(cell):
        # Decide whether the text "looks blue". We don't check for one exact blue —
        # instead we check that the blue part is strong AND clearly stronger than the
        # red and green parts. That way different shades of blue all still count.
        rgb = get_font_rgb(cell)
        if rgb is None:
            return False
        # The colour code holds red, green, and blue as three pairs of characters.
        # We read each pair back into a normal number (0 to 255).
        red = int(rgb[0:2], 16); green = int(rgb[2:4], 16); blue = int(rgb[4:6], 16)
        # "Blue enough" = blue is fairly high and beats red by 25% and green by 10%.
        return blue >= 100 and blue > red * 1.25 and blue > green * 1.10

    try:
        # If specific sheet names were requested, make sure they actually exist in the file.
        # If any are missing, stop with a clear error instead of silently skipping them.
        available_sheet_names = {ws.title for ws in formulas_workbook.worksheets}
        if selected_sheet_names is not None:
            missing_sheets = selected_sheet_names - available_sheet_names
            if missing_sheets:
                raise ValueError(f"Worksheet(s) not found: {sorted(missing_sheets)}")

        # Go through the requested sheets one at a time.
        for formula_worksheet in formulas_workbook.worksheets:
            sheet_name = formula_worksheet.title
            if selected_sheet_names is not None and sheet_name not in selected_sheet_names:
                continue
            value_worksheet = values_workbook[sheet_name]      # the same sheet in the "numbers" copy

            # Look at every cell in this sheet, going row by row.
            for row in formula_worksheet.iter_rows(min_row=1, max_row=formula_worksheet.max_row):
                for formula_cell in row:
                    # Grab the number for this exact cell position from the "numbers" copy.
                    value_cell = value_worksheet[formula_cell.coordinate]
                    cached_value = value_cell.value
                    formula_or_value = formula_cell.value
                    # If the cell is empty in both copies, there's nothing to record — move on.
                    if cached_value is None and formula_or_value is None:
                        continue
                    if not is_blue_font(formula_cell):          # we only care about blue cells
                        continue
                    # Use the worked-out number if we have one; otherwise fall back to the formula/text.
                    amount = cached_value if cached_value is not None else formula_or_value
                    # Turn the real Excel row number into a simple count that starts at 1 on the
                    # first data row (row 4 in Excel becomes row 1 here).
                    local_row_id = formula_cell.row - excel_data_start_row + 1   # 1-based within sheet
                    if local_row_id < 1:                         # anything above the data (headers) is ignored
                        continue
                    # Save everything we know about this blue cell as one record.
                    blue_amounts.append({
                        "sheet_name": sheet_name,
                        "cell_address": formula_cell.coordinate,
                        "amount": amount,
                        "font_rgb": get_font_rgb(formula_cell),
                        "is_blue": True,
                        "row_id": local_row_id,
                    })
    finally:
        # Always close both files, even if something above went wrong.
        values_workbook.close()
        formulas_workbook.close()

    return blue_amounts


def get_dynamic_sheet_row_counts(excel_path, sheet_names=TARGET_SHEETS,
                                 excel_data_start_row=4, max_data_column=None):
    """
    WHAT: count populated data rows per worksheet.
    CALLED BY: locate_blue_cell_pairs.
    OUTPUT FLOW: dict {sheet_name: row_count} -> create_appended_spark_column_row_pairs,
                 which uses it to convert a LOCAL row_id into a GLOBAL row_id.
    """
    workbook = cp.openpyxl.read(excel_path, data_only=False)
    selected_sheet_names = normalize_sheet_names(sheet_names)
    sheet_row_counts = {}
    try:
        # Same check as before — the sheets asked for must really be in the file.
        available_sheet_names = {ws.title for ws in workbook.worksheets}
        if selected_sheet_names is not None:
            missing_sheets = selected_sheet_names - available_sheet_names
            if missing_sheets:
                raise ValueError(f"Worksheet(s) not found: {sorted(missing_sheets)}")

        for worksheet in workbook.worksheets:
            sheet_name = worksheet.title
            if selected_sheet_names is not None and sheet_name not in selected_sheet_names:
                continue
            # If the sheet doesn't even reach the first data row, it has no data rows at all.
            if worksheet.max_row < excel_data_start_row:
                sheet_row_counts[sheet_name] = 0
                continue
            # We can limit how many columns across we look at (to save time); otherwise we
            # look across the full width of the used area.
            scan_to_column = (worksheet.max_column if max_data_column is None
                              else min(max_data_column, worksheet.max_column))
            # Starting from the first data row, find the LAST row that still has something in it.
            # Heads up: this measures how far down the data reaches, so if there are empty rows
            # in the MIDDLE, they still get counted as part of the range.
            last_data_row = excel_data_start_row - 1
            for row in worksheet.iter_rows(min_row=excel_data_start_row, max_row=worksheet.max_row,
                                           min_col=1, max_col=scan_to_column):
                if any(cell.value is not None for cell in row):
                    last_data_row = row[0].row               # remember this row's Excel number
            # Turn "last used Excel row" into a simple count of data rows for this sheet.
            sheet_row_counts[sheet_name] = max(0, last_data_row - excel_data_start_row + 1)
    finally:
        workbook.close()
    return sheet_row_counts


def create_appended_spark_column_row_pairs(blue_amounts, spark_columns,
                                           sheet_row_counts, sheet_order=TARGET_SHEETS):
    """
    WHAT: convert blue cells (LOCAL row_id + Excel address) into unique
          (spark_column_name, GLOBAL row_id) pairs. GLOBAL row_id accounts for the
          sheets being appended in sheet_order (Balance Sheet rows come first).
    INPUTS FROM: get_blue_amounts (blue_amounts), the DataFrame's .columns (spark_columns),
                 get_dynamic_sheet_row_counts (sheet_row_counts).
    CALLED BY: locate_blue_cell_pairs.
    OUTPUT FLOW: the returned pair list becomes spark_column_row_pairs_cy/_py,
                 later consumed by replace_spark_cells and Section 2's blue styling.
    """
    spark_columns = list(spark_columns)
    sheet_order = tuple(sheet_order)

    # Every sheet we plan to stack together must have a known row count. Without it we
    # can't work out the combined row numbers, so we stop early with a clear error.
    missing_counts = {s for s in sheet_order if s not in sheet_row_counts}
    if missing_counts:
        raise ValueError(f"Missing dynamic row counts for: {sorted(missing_counts)}")

    # Because the sheets are stacked one after another, we work out where each sheet
    # "begins" in the combined list. The first sheet starts at 0; the next sheet starts
    # right after all of the first sheet's rows, and so on.
    sheet_offsets = {}
    current_offset = 0
    for sheet_name in sheet_order:
        sheet_offsets[sheet_name] = current_offset
        current_offset += sheet_row_counts[sheet_name]

    pairs = []
    seen_pairs = set()                                          # used to avoid adding the same pair twice
    missing_excel_columns = set()                              # collect any columns we couldn't match, to warn once

    for item in blue_amounts:
        # A few safety checks: only keep real blue cells, from a known sheet, with a row number.
        if item.get("is_blue") is not True:
            continue
        sheet_name = item.get("sheet_name")
        local_row_id = item.get("row_id")
        if sheet_name not in sheet_offsets or local_row_id is None:
            continue
        local_row_id = int(local_row_id)
        # The row number has to sit within the rows we actually counted for that sheet.
        if not (1 <= local_row_id <= sheet_row_counts[sheet_name]):
            continue
        # Read the saved cell address (like "$AC$12") again, just to pull out the column letters.
        match = CELL_PATTERN.fullmatch(str(item.get("cell_address", "")).strip().upper())
        if not match:
            continue
        excel_column = match.group(1)
        column_index = excel_column_index(excel_column)        # letters -> position number
        # If the Excel column is further right than any column we have in Spark, we can't
        # match it — note it down and skip it.
        if column_index >= len(spark_columns):
            missing_excel_columns.add(excel_column)
            continue
        column_name = spark_columns[column_index]              # position number -> Spark column name
        # Add the sheet's starting point to the local row number to get the combined row number.
        row_id = sheet_offsets[sheet_name] + local_row_id      # per-sheet number -> combined number
        pair = (column_name, row_id)
        # Only keep this column+row pair the first time we see it.
        if pair not in seen_pairs:
            pairs.append(pair)
            seen_pairs.add(pair)

    # Show one tidy warning listing any columns we had to skip, instead of many messages.
    if missing_excel_columns:
        print("Skipped Excel columns without matching Spark columns: "
              + ", ".join(sorted(missing_excel_columns)))
    return pairs

