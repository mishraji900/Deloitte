def s3a_build_blue_pair_lookups(
    spark_column_row_pairs_cy,
    row_id_col=ROW_ID_COLUMN_NAME,
):
    exact_pairs = set()
    normalized_pairs = set()
    row_id_key = s3a_normalize(row_id_col)

    for pair in spark_column_row_pairs_cy or []:
        try:
            column_name, source_row_id = pair
        except (TypeError, ValueError):
            continue

        if column_name is None:
            continue

        if s3a_normalize(column_name) == row_id_key:
            continue

        try:
            source_row_id = int(source_row_id)
        except (ValueError, TypeError):
            continue

        if source_row_id < 1:
            continue

        column_name = str(column_name).strip()

        exact_pairs.add(
            (column_name, source_row_id)
        )

        normalized_pairs.add(
            (s3a_normalize(column_name), source_row_id)
        )

    return exact_pairs, normalized_pairs


def s3a_is_blue_cell(
    entity_column,
    source_row_id,
    blue_exact_pairs,
    blue_normalized_pairs,
):
    try:
        source_row_id = int(source_row_id)
    except (ValueError, TypeError):
        return False

    return (
        (
            str(entity_column).strip(),
            source_row_id,
        )
        in blue_exact_pairs
        or (
            s3a_normalize(entity_column),
            source_row_id,
        )
        in blue_normalized_pairs
    )


