def _build_existing_cy_pair_lookup(
    spark_column_row_pairs_cy,
    raw_tb_CY,
    row_id_col="row_id",
):
    if not spark_column_row_pairs_cy:
        raise ValueError(
            "spark_column_row_pairs_cy is empty."
        )

    source_columns = [
        column
        for column in raw_tb_CY.columns
        if column != row_id_col
    ]

    source_column_set = set(source_columns)
    exact_pairs = set()

    for position, pair in enumerate(
        spark_column_row_pairs_cy,
        start=1,
    ):
        if not isinstance(pair, (tuple, list)) or len(pair) != 2:
            raise ValueError(
                f"Invalid CY pair at position {position}: {pair!r}"
            )

        column_name, row_id = pair

        if column_name == row_id_col:
            raise ValueError(
                f"row_id cannot be a blue-cell target: {pair!r}"
            )

        if column_name not in source_column_set:
            raise ValueError(
                f"CY column does not exist: {column_name!r}"
            )

        if (
            isinstance(row_id, bool)
            or not isinstance(row_id, Integral)
            or int(row_id) < 1
        ):
            raise ValueError(
                f"Invalid CY row_id: {pair!r}"
            )

        exact_pairs.add((column_name, int(row_id)))

    return exact_pairs


def _calculate_analysis_values(
    record,
    source_row_id,
    entity_columns,
    blue_pair_keys,
    materiality,
    consolidated_column,
    untested_column,
):
    materiality_value = _to_decimal(materiality)

    if materiality_value in (None, Decimal("0")):
        raise ValueError(
            "MATERIALITY must be a non-zero numeric value."
        )

    residual_balances = [
        balance
        for column in entity_columns
        if (column, source_row_id) not in blue_pair_keys
        for balance in [_to_decimal(record.get(column))]
        if balance not in (None, Decimal("0"))
    ]

    mean_value = None
    median_value = None
    highest_balance = None

    if residual_balances:
        mean_value = (
            sum(residual_balances)
            / Decimal(len(residual_balances))
        )
        median_value = _median_decimal(residual_balances)
        highest_balance = max(residual_balances)

    untested_balance = _to_decimal(
        record.get(untested_column)
    )
    consolidated_balance = _to_decimal(
        record.get(consolidated_column)
    )

    times_of_materiality = None

    if untested_balance is not None:
        times_of_materiality = (
            untested_balance / materiality_value
        )

    percentage_of_total = None

    if (
        highest_balance is not None
        and consolidated_balance not in (None, Decimal("0"))
    ):
        percentage_of_total = (
            highest_balance / consolidated_balance
        )

    multiple_of_materiality = None

    if highest_balance is not None:
        multiple_of_materiality = (
            highest_balance / materiality_value
        )

    return {
        "Times of materiality": times_of_materiality,
        "Mean": mean_value,
        "Median": median_value,
        "Highest balance in a residual entity": highest_balance,
        "% of the total balance": percentage_of_total,
        "Multiple of materiality balance": multiple_of_materiality,
    }


def _unmerge_intersecting_ranges(
    worksheet,
    row_number,
    start_column,
    end_column,
):
    for merged_range in list(worksheet.merged_cells.ranges):
        if (
            merged_range.min_row <= row_number <= merged_range.max_row
            and merged_range.min_col <= end_column
            and merged_range.max_col >= start_column
        ):
            worksheet.unmerge_cells(merged_range.coord)


def _apply_header_style(cell, fill, border, font, alignment):
    cell.fill = fill
    cell.border = border
    cell.font = font
    cell.alignment = alignment
    cell.number_format = "General"


def _write_table_headers(
    worksheet,
    header_row,
    start_column,
    output_columns,
    fill,
    border,
    font,
    alignment,
):
    end_column = start_column + len(output_columns) - 1

    _unmerge_intersecting_ranges(
        worksheet,
        header_row,
        start_column,
        end_column,
    )

    for index, column_label in enumerate(output_columns):
        cell = worksheet.cell(
            row=header_row,
            column=start_column + index,
        )
        cell.value = column_label
        _apply_header_style(
            cell,
            fill,
            border,
            font,
            alignment,
        )


def _write_analysis_headers(
    worksheet,
    header_row,
    start_column,
    output_columns,
    calculated_columns,
    fill,
    border,
    font,
    alignment,
):
    if not calculated_columns:
        return

    calculated_keys = {
        _normalise_column_name(column)
        for column in calculated_columns
    }

    calculated_indices = [
        index
        for index, column in enumerate(output_columns)
        if _normalise_column_name(column) in calculated_keys
    ]

    highest_indices = [
        index
        for index, column in enumerate(output_columns)
        if _normalise_column_name(column) in HIGHEST_BALANCE_GROUP
    ]

    if not calculated_indices or not highest_indices:
        raise ValueError(
            "Calculated header columns were not found."
        )

    analysis_start = start_column + min(calculated_indices)
    analysis_end = start_column + max(calculated_indices)
    highest_start = start_column + min(highest_indices)
    highest_end = start_column + max(highest_indices)

    top_row = header_row - 2
    subgroup_row = header_row - 1

    for row_number in (top_row, subgroup_row):
        _unmerge_intersecting_ranges(
            worksheet,
            row_number,
            analysis_start,
            analysis_end,
        )

        for column_number in range(
            analysis_start,
            analysis_end + 1,
        ):
            cell = worksheet.cell(
                row=row_number,
                column=column_number,
            )
            cell.value = None
            _apply_header_style(
                cell,
                fill,
                border,
                font,
                alignment,
            )

    worksheet.merge_cells(
        start_row=top_row,
        start_column=analysis_start,
        end_row=top_row,
        end_column=analysis_end,
    )

    dt_header = worksheet.cell(
        row=top_row,
        column=analysis_start,
    )
    dt_header.value = "D&T analysis"
    _apply_header_style(
        dt_header,
        fill,
        border,
        font,
        alignment,
    )

    worksheet.merge_cells(
        start_row=subgroup_row,
        start_column=highest_start,
        end_row=subgroup_row,
        end_column=highest_end,
    )

    highest_header = worksheet.cell(
        row=subgroup_row,
        column=highest_start,
    )
    highest_header.value = (
        "Highest balance in a residual entities"
    )
    _apply_header_style(
        highest_header,
        fill,
        border,
        font,
        alignment,
    )


def _write_detail_row(
    worksheet,
    row_number,
    start_column,
    output_columns,
    account_column,
    entity_columns,
    record,
    consolidated_column,
    materiality,
    label,
    calculation_type,
    white_fill,
    body_border,
    body_font,
):
    materiality_value = _to_decimal(materiality)
    consolidated_value = _to_decimal(
        record.get(consolidated_column)
    )

    value_alignment = Alignment(
        horizontal="right",
        vertical="center",
    )

    label_alignment = Alignment(
        horizontal="right",
        vertical="center",
    )

    for index, column_label in enumerate(output_columns):
        cell = worksheet.cell(
            row=row_number,
            column=start_column + index,
        )

        cell.value = None
        cell.fill = white_fill
        cell.border = body_border
        cell.font = body_font
        cell.alignment = value_alignment
        cell.number_format = "General"

        if column_label == account_column:
            cell.value = label
            cell.alignment = label_alignment
            continue

        if column_label not in entity_columns:
            continue

        balance = _to_decimal(record.get(column_label))

        if balance is None:
            continue

        if calculation_type == "percentage":
            if consolidated_value in (None, Decimal("0")):
                continue

            cell.value = balance / consolidated_value
            cell.number_format = "0.00%"
        else:
            cell.value = balance / materiality_value
            cell.number_format = "0.00"


def _apply_package_borders(
    worksheet,
    package_start_row,
    package_end_row,
    start_column,
    end_column,
):
    black_side = Side(style="thin", color=BLACK)
    light_side = Side(
        style="thin",
        color=PACKAGE_LIGHT_GRAY,
    )

    for row_number in range(
        package_start_row,
        package_end_row + 1,
    ):
        for column_number in range(
            start_column,
            end_column + 1,
        ):
            cell = worksheet.cell(
                row=row_number,
                column=column_number,
            )

            cell.border = Border(
                left=(
                    black_side
                    if column_number == start_column
                    else light_side
                ),
                right=(
                    black_side
                    if column_number == end_column
                    else light_side
                ),
                top=(
                    black_side
                    if row_number == package_start_row
                    else light_side
                ),
                bottom=(
                    black_side
                    if row_number == package_end_row
                    else light_side
                ),
            )


def append_raw_tb_cy_to_sheet(
