def s3a_normalize(value):
    if value is None:
        return ""

    return " ".join(
        str(value).replace("\u00a0", " ").strip().split()
    ).casefold()


def s3a_is_grey_marker(value):
    return s3a_normalize(value) == GREY_MARKER


def s3a_to_decimal(value):
    if (
        value is None
        or isinstance(value, bool)
        or s3a_is_grey_marker(value)
    ):
        return None

    if isinstance(value, Decimal):
        return value if value.is_finite() else None

    try:
        if isinstance(value, (int, float)) or hasattr(
            value,
            "__float__",
        ):
            numeric_value = float(value)

            if numeric_value != numeric_value:
                return None

            decimal_value = Decimal(
                str(round(numeric_value, 10))
            )

            return (
                decimal_value
                if decimal_value.is_finite()
                else None
            )

    except (ValueError, TypeError, OverflowError):
        pass

    try:
        text = (
            str(value)
            .replace(",", "")
            .replace("$", "")
            .strip()
        )

        if text.endswith("%"):
            text = text[:-1].strip()

        if text.startswith("(") and text.endswith(")"):
            text = "-" + text[1:-1]

        if text in {"", "-", "â€”", GREY_MARKER}:
            return None

        decimal_value = Decimal(text)

        return (
            decimal_value
            if decimal_value.is_finite()
            else None
        )

    except (InvalidOperation, ValueError, TypeError):
        return None


def s3a_require_column(source_columns, requested_name):
    requested_key = s3a_normalize(requested_name)

    for column_name in source_columns:
        if s3a_normalize(column_name) == requested_key:
            return column_name

    raise KeyError(
        f"Required dataframe column not found: "
        f"{requested_name!r}. Available columns: "
        f"{source_columns}"
    )


def s3a_get_records(dataframe):
    if hasattr(dataframe, "collect"):
        return [
            row.asDict(recursive=True)
            for row in dataframe.collect()
        ]

    if hasattr(dataframe, "to_dict"):
        return dataframe.to_dict(orient="records")

    records = []

    for row in dataframe:
        records.append(
            row.asDict(recursive=True)
            if hasattr(row, "asDict")
            else dict(row)
        )

    return records


def s3a_normalize_account(value):
    return s3a_normalize(value)


def s3a_get_sheet_materiality(worksheet, fallback_value):
    coordinate = MATERIALITY_CELL.replace("$", "")
    sheet_value = s3a_to_decimal(
        worksheet[coordinate].value
    )

    if sheet_value in {None, Decimal("0")}:
        return fallback_value

    return sheet_value


