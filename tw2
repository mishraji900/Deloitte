    collect_check("WARN_No_Account", lab,
                  k.filter(~ka).filter(F.col("V") != 0),
                  {"RowId": "I", "Value": "V"})

    # â”€â”€ parquet snapshot â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    try:
        pk, _       = prep(cp.read(s["parquet"]), s, False)
        pr          = pk.agg(F.count("*"), F.sum("V")).first()
        pq_rows, pq_tot = pr[0], pr[1] or 0.0
        pq_ok       = True
    except Exception as e:
        print(f"[{lab}] parquet read failed:", e)
        pq_rows = pq_tot = None
        pq_ok   = False
        CHECK_DETAIL["WARN_Unavailable"].append(
            {"Period": lab, "Source": "Parquet", "Error_Note": str(e)})

    # â”€â”€ FAIL: parquet vs raw mismatch â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    if pq_ok:
        pq_mismatch = pq_rows != raw_rows or abs(pq_tot - raw_tot) > TOL
        if pq_mismatch:
            for metric, raw_v, pq_v in [
                ("Row Count", raw_rows, pq_rows),
                ("Net Total",  raw_tot,  pq_tot),
            ]:
                CHECK_DETAIL["FAIL_Parquet_Mismatch"].append({
                    "Period": lab, "Metric": metric,
                    "Raw_Value": raw_v, "Parquet_Value": pq_v,
                    "Delta": (raw_v - pq_v) if isinstance(raw_v, (int, float)) else None,
                })
    else:
        pq_mismatch = False

    # â”€â”€ final df â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    f = hold(s["final"].select(
        F.col(ACCT).alias("A"),
        F.col("row_id").alias("I"),
        F.col(TOT).cast("double").alias("V"),
        F.col(CODE).alias("C"),
    ))

    nocode = F.col("C").isNull() | (F.trim(F.col("C")) == "")
    bs_id  = f.filter(F.lower(F.col("A")) == BS_MARKER).agg(F.min("I")).first()[0]

    if bs_id is None:
        print(f"[{lab}] WARNING: BS_MARKER not found in final df â€” 'pre' filter set to False.")
        pre = F.lit(False)
        tab = ~F.lower(F.col("A")).isin(BS_MARKER, IS_MARKER)
    else:
        pre = F.col("I") < bs_id
        tab = (F.col("I") > bs_id) & ~F.lower(F.col("A")).isin(BS_MARKER, IS_MARKER)

    fr = [x or 0 for x in f.agg(
        F.count("*"),
        F.sum("V"),
        F.sum(F.when(nocode, 1).otherwise(0)),
        F.sum(F.when(nocode, F.col("V")).otherwise(0.0)),
        F.sum(F.when(pre, 1).otherwise(0)),
        F.sum(F.when(pre, F.col("V")).otherwise(0.0)),
        F.sum(F.when(tab, 1).otherwise(0)),
        F.sum(F.when(tab, F.col("V")).otherwise(0.0)),
    ).first()]
    f_rows, f_tot, nc_rows, nc_tot, pre_rows, pre_tot, tab_rows, tab_tot = fr

    # â”€â”€ FAIL: final vs kept mismatch â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    final_row_mismatch   = f_rows != kept_rows
    final_total_mismatch = abs(f_tot - kept_tot) > TOL
    if final_row_mismatch or final_total_mismatch:
        for metric, kept_v, final_v in [
            ("Row Count", kept_rows, f_rows),
            ("Net Total",  kept_tot, f_tot),
        ]:
            delta = final_v - kept_v if isinstance(final_v, (int, float)) else None
            if (abs(delta) > TOL if isinstance(delta, float) else delta != 0):
                CHECK_DETAIL["FAIL_Final_vs_Kept"].append({
                    "Period": lab, "Metric": metric,
                    "Kept_Value": kept_v, "Final_Value": final_v, "Delta": delta,
                })

    # â”€â”€ code coverage â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    cc  = (f.filter(~nocode)
            .groupBy("C").agg(F.sum("V").alias("v"))
            .toPandas().set_index("C")["v"])
    cov[lab]          = cc
    un                = cc[~cc.index.isin(USED)]
    cfg_missing_codes = USED - set(cc.index)
    cfg_missing       = len(cfg_missing_codes)

    # â”€â”€ WARN: no grouping code â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    collect_check("WARN_No_Code", lab,
                  f.filter(nocode).filter(F.col("V") != 0),
                  {"RowId": "I", "Account": "A", "Value": "V"})

    # â”€â”€ WARN: above BS marker â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    collect_check("WARN_Above_BS", lab,
                  f.filter(pre).filter(F.col("V") != 0),
                  {"RowId": "I", "Account": "A", "Value": "V"})

    # â”€â”€ WARN: unused grouping codes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    for code, amount in un.items():
        CHECK_DETAIL["WARN_Unused_Codes"].append(
            {"Period": lab, "Grouping_Code": code, "Amount": float(amount)})

    # â”€â”€ WARN: config codes missing from data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    for code in sorted(cfg_missing_codes):
        CHECK_DETAIL["WARN_Missing_Codes"].append(
            {"Period": lab, "Grouping_Code": code})

    # â”€â”€ mapping diagnostics â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    kacc       = k.filter(ka).select(F.col("A").alias(ACCT)).distinct()
    fan_accts  = mdup.withColumnRenamed("A", ACCT).join(kacc, ACCT, "left_semi").count()
    map_unused = mcnt.select(ACCT).join(kacc, ACCT, "left_anti").count()

    # â”€â”€ WARN: mapping duplicates â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    if fan_accts:
        dup_rows = (
            k.filter(ka)
             .join(mdup, k["A"] == mdup["A"], "inner")
             .select(
                 k["A"].alias("Account"),
                 k["I"].alias("RowId"),
                 k["V"].alias("Row_Value"),
                 mdup["n"].alias("Mapping_Count"),
                 (k["V"] * (mdup["n"] - 1)).alias("Inflated_By"),
             )
        )
        collect_check("WARN_Map_Duplicates", lab, dup_rows,
                      {"Account": "Account", "Mapping_Count": "Mapping_Count",
                       "Row_Value": "Row_Value", "Inflated_By": "Inflated_By"})

    # â”€â”€ WARN: bad cells â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    for col_name, cnt in ex.get("bad", {}).items():
        if cnt:
            CHECK_DETAIL["WARN_Bad_Cells"].append(
                {"Period": lab, "Column": col_name, "Bad_Cell_Count": int(cnt)})

    # â”€â”€ WARN: dropped non-zero columns â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    for col_name, total in ex.get("dropped", {}).items():
        CHECK_DETAIL["WARN_Dropped_Cols"].append(
            {"Period": lab, "Column": col_name, "Nonzero_Sum": float(total)})

    # â”€â”€ excel read-back â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    if xwb is not None and s["tab"] in xwb.sheetnames:
        ex_rows, ex_tot = excel_tb(xwb, s["tab"])
        ex_ok = True
    else:
        ex_rows = ex_tot = None
        ex_ok   = False
        CHECK_DETAIL["WARN_Unavailable"].append(
            {"Period": lab, "Source": "Excel TB tab",
             "Error_Note": f"Tab '{s['tab']}' not found"})

    # â”€â”€ FAIL: excel mismatch â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    ex_mismatch = ex_ok and (ex_rows != tab_rows or abs(ex_tot - tab_tot) > TOL)
    if ex_mismatch:
        for metric, df_v, xl_v in [
            ("Row Count", tab_rows, ex_rows),
            ("Net Total",  tab_tot, ex_tot),
        ]:
            CHECK_DETAIL["FAIL_Excel_Mismatch"].append({
                "Period": lab, "Metric": metric,
                "DF_Value": df_v, "Excel_Value": xl_v,
                "Delta": (xl_v - df_v) if isinstance(xl_v, (int, float)) else None,
            })

    # â”€â”€ legacy combined detail (Excluded_Detail sheet) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    for reason, sdf, vcol in [
        ("NO ACCT - filtered out",   k.filter(~ka),              "V"),
        ("NO CODE - not in tie-out", f.filter(nocode),            "V"),
        ("ABOVE BS MARKER",          f.filter(pre),               "V"),
        ("MAP DUP - inflated amount",
         k.filter(ka).join(mdup, "A")
          .withColumn("D", F.col("V") * (F.col("n") - 1)),        "D"),
    ]:
        p = (sdf.filter(F.col(vcol) != 0)
                .select(F.col("I").cast("long").alias("RowId"),
                        F.col("A").alias("Account"),
                        F.col(vcol).alias("Value"))
                .toPandas())
        if len(p):
            p.insert(0, "Reason", reason)
            p.insert(0, "Period", lab)
            detail.append(p)

    # â”€â”€ status flags â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    bad  = (pq_mismatch
            or final_row_mismatch or final_total_mismatch
            or ex_mismatch)

    warn = (nc_rows
            or ex.get("bad") or ex.get("dropped")
            or len(un) or cfg_missing
            or pre_rows
            or not pq_ok or not ex_ok)

    diff_excel_total = (ex_tot - tab_tot) if ex_ok else None

    summary.append({
        "Period"               : lab,
        "Raw_Rows"             : int(raw_rows),
        "Raw_Total"            : raw_tot,
        "Parquet_Rows"         : pq_rows,
        "Parquet_Total"        : pq_tot,
        "NoAcct_Rows"          : int(na_rows),
        "NoAcct_Total"         : na_tot,
        "Kept_Rows"            : int(kept_rows),
        "Kept_Total"           : kept_tot,
        "Final_Rows"           : int(f_rows),
        "Final_Total"          : f_tot,
        "Diff_Rows"            : int(f_rows - kept_rows),
        "Diff_Total"           : f_tot - kept_tot,
        "Fanout_Map_Accts"     : fan_accts,
        "Map_Unused_Accts"     : map_unused,
        "NoCode_Rows"          : int(nc_rows),
        "NoCode_Total"         : nc_tot,
        "Unused_Code_Count"    : len(un),
        "Unused_Code_Total"    : float(un.sum()),
        "Config_Codes_Missing" : cfg_missing,
        "PreBS_Rows"           : int(pre_rows),
        "PreBS_Total"          : pre_tot,
        "Expected_Excel_Rows"  : int(tab_rows),
        "Excel_Rows"           : ex_rows,
        "Expected_Excel_Total" : tab_tot,
        "Excel_Total"          : ex_tot,
        "Diff_Excel_Total"     : diff_excel_total,
        "Bad_Cells"            : int(sum(ex.get("bad", {}).values())),
        "Bad_Cols"             : ", ".join(ex.get("bad", {})),
        "Dropped_Nonzero_Cols" : ", ".join(ex.get("dropped", {})),
        "Status"               : "FAIL" if bad else ("WARN" if warn else "PASS"),
    })


