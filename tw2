def _write_note_only_table(ws, row: int, text: str, last_col: int) -> int:
    """FN 1 – title banner + empty merged note box."""
    _write_s3_title_banner(ws, row, text, last_col)

    note_start = row + 1
    note_end   = row + 3
    for r in range(note_start, note_end + 1):
        ws.row_dimensions[r].height = 14

    ws.merge_cells(
        start_row=note_start, start_column=S3_COL_SYMBOL,
        end_row=note_end,     end_column=last_col,
    )
    c = ws.cell(row=note_start, column=S3_COL_SYMBOL)
    c.fill      = FILL_WHITE
    c.alignment = ALIGN_LEFT_TOP

    # FIX Issue 2: border on every cell of the note box merge
    _apply_range_border(ws, note_start, S3_COL_SYMBOL, note_end, last_col)

    return note_end + 2

