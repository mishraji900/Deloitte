def _get_records(df):
    # Turn any supported table into a plain list of row dictionaries (same three-case
    # approach as Section 3a: Spark, then pandas, then anything iterable).
    if hasattr(df, "collect"):
        return [r.asDict(recursive=True) for r in df.collect()]
    if hasattr(df, "to_dict"):
        return df.to_dict(orient="records")
    return [dict(r) for r in df]


def _get_columns(df):
    # Get the list of column names. If the object doesn't expose them directly,
    # fall back to reading the keys off the first row.
    if hasattr(df, "columns"):
        return list(df.columns)
    records = _get_records(df)
    return list(records[0].keys()) if records else []


def _unmerge_from_row9(ws):
    """Remove every merged range from row 9 downward so the previous run's account blocks don't linger."""
    # Find all merged (joined) cell ranges that reach into row 9 or below and split them
    # apart, so a fresh run isn't fighting with leftover merges from the last run.
    to_remove = []
    for rng in list(ws.merged_cells.ranges):
        _, min_row, _, max_row = range_boundaries(str(rng))
        if max_row >= ROW_ACCT_HEADER:
            to_remove.append(str(rng))
    for ref in to_remove:
        ws.unmerge_cells(ref)


def _clear_from_row9(ws):
    """Wipe all content and style from row 9 downward."""
    # Reset every cell from row 9 down to blank, plain styling — a clean canvas to rebuild on.
    for row in ws.iter_rows(min_row=ROW_ACCT_HEADER, max_row=ws.max_row):
        for cell in row:
            if isinstance(cell, MergedCell):
                continue
            cell.value = None
            cell.font = _font_data()
            cell.fill = _fill(_WHT)
            cell.border = _no_border()
            cell.number_format = "General"
            cell.alignment = Alignment()


def _filter_tab3b(residual_cy_py, threshold_value):
    """Tab-3b criterion {b}: |CY-PY| > threshold and |difference/CY| > 15%."""
    # Decide which accounts belong on this sheet. The test ("criterion {b}") is: the year-on-year
    # change must be big BOTH in dollars (bigger than the threshold) AND in percentage terms
    # (more than the percentage threshold). Only accounts meeting both are kept.
    thresh = _to_dec(threshold_value)
    pct_thresh = _to_dec(THRESHOLD_PERCENTAGE)

    # If either threshold isn't usable, we can't judge anything — return nothing.
    if thresh is None or pct_thresh is None:
        return []

    results = []

    for rec in _get_records(residual_cy_py):
        # Skip rows already marked as greyed out on the CY side.
        if rec.get("CY_Greyed"):
            continue

        cy = _to_dec(rec.get("Untested_Balance_CY"))
        py = _to_dec(rec.get("Untested_Balance_PY"))

        # Match: if either CY or PY is null, perform no calculation.
        # (Need both years present to compare them.)
        if cy is None or py is None:
            continue

        diff = cy - py
        # Percentage change vs CY, guarding against divide-by-zero.
        pct = (diff / cy) if cy != Decimal("0") else None

        # Keep only if BOTH the dollar change and the percentage change clear their thresholds.
        if (
            abs(diff) > thresh
            and pct is not None
            and abs(pct) > pct_thresh
        ):
            results.append(rec)

    return results


def _build_lookup(records, account_col):
    # Build an "account name -> its record" directory for instant lookups later.
    lookup = {}
    for rec in records:
        key = _py_account_key(rec.get(account_col, ""))
        if key:
            lookup[key] = rec
    return lookup

# row_id is excluded here so it never appears as a legal-entity row.
# (These are the business/system columns we never treat as a legal entity.)
_SKIP_COLS = {
    "account", "test consolidated amount", "% of consolidated balance",
    "untested balance", "reference id", "significance", "consolidated", "row_id",
}


def _get_entity_columns(df, account_col):
    # The legal-entity columns are everything that comes AFTER the Account column,
    # minus the known business/system columns in _SKIP_COLS.
    after = False
    ents = []
    for c in _get_columns(df):
        if _norm(c) == _norm(account_col):
            after = True            # once we pass Account, start collecting
            continue
        if after and _norm(c) not in _SKIP_COLS:
            ents.append(c)
    return ents


def _build_combined_entities(cy_entity_cols, py_entity_cols):
    """CY entities first, then any PY-only entities appended (and flagged as 'py_only')."""
    # We want one row per legal entity. Start with all the current-year entities, then add
    # any that only exist in the prior year (tagged "py_only" so we can shade those rows).
    cy_normed = {_norm(e): e for e in cy_entity_cols}
    combined = [(e, "cy") for e in cy_entity_cols]

    for py_ent in py_entity_cols:
        if _norm(py_ent) not in cy_normed:
            combined.append((py_ent, "py_only"))
            print(f"[3b] PY-only entity added: '{py_ent}'")

    return combined


def _write_row9_header(ws, col_start, col_end, acct_name):
