def drop_row_id_pairs(column_row_pairs):
    """
    WHAT: remove any (column, row_id) pair that accidentally targets the row_id column.
    CALLED BY: the two cleanup lines below.
    OUTPUT FLOW: cleaned pair list -> replace_spark_cells.
    """
    # Keep every pair EXCEPT ones pointing at the "row_id" column. That column is our
    # row label, so we must never overwrite it — this quietly filters those out.
    return [(c, r) for c, r in column_row_pairs if c != "row_id"]


# Clean the pair lists BEFORE using them to overwrite cells.
# Run both the current-year (CY) and prior-year (PY) lists through the filter above
# so neither one can accidentally change the row label column.
