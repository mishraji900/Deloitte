def convert_to_pandas(source: Any, source_name: str) -> pd.DataFrame:
    if hasattr(source, "toPandas"):
        return source.toPandas()
    if isinstance(source, pd.DataFrame):
        return source.copy()
    raise TypeError(f"{source_name} must be a pandas or Spark DataFrame.")


def parse_date(column_name: str) -> date:
    return datetime.strptime(str(column_name)[-8:], DATE_FORMAT).date()


def subtract_months(value: date, months: int) -> date:
    total_months = value.year * 12 + value.month - 1 - months
    year, month = divmod(total_months, 12)
    month += 1
    return date(year, month, min(value.day, calendar.monthrange(year, month)[1]))


def closest_date(target: date, dated_columns: dict[str, date]) -> str:
    return min(
        dated_columns,
        key=lambda column: abs((dated_columns[column] - target).days),
    )


def most_recent_fiscal_year_end(
    dated_columns: dict[str, date],
    current_date: date,
) -> str | None:
    month, day = FISCAL_YEAR_END
    candidates = {
        column: value
        for column, value in dated_columns.items()
        if value.month == month and value.day == day and value < current_date
    }
    return max(candidates, key=candidates.get) if candidates else None


def log_classification(
    label: str,
    roles: dict[str, str],
    dated: dict[str, date],
    target_quarter: date | None = None,
    target_pyq: date | None = None,
    pyq_delta: int | None = None,
    used_fallback: bool = False,
) -> None:
    role_labels = {
        "current": "Current quarter",
        "prior_year_end": "Prior year-end",
        "prior_quarter": "Prior quarter",
        "prior_year_same_qtr": "PY same quarter",
    }

    print(f"\n--- {label} period classification ---")
    for role, column in roles.items():
        note = ""
        if role == "prior_quarter" and target_quarter:
            note = f" | target: {target_quarter}"
        if role == "prior_year_same_qtr" and pyq_delta is not None:
            note += f" | target: {target_pyq} | delta: {pyq_delta} days"
            if used_fallback:
                note += " | fallback used"
        print(f"{role_labels.get(role, role)}: {column} [{dated[column]}]{note}")
    print("------------------------------------\n")


def classify_bs_periods(raw_columns: list[str]) -> dict[str, str]:
    dated = {column: parse_date(column) for column in raw_columns}
    current_column = max(dated, key=dated.get)
    current_date = dated[current_column]
    others = {c: d for c, d in dated.items() if c != current_column}

    if not others:
        raise ValueError("BS needs at least two date columns.")

    prior_year_end = most_recent_fiscal_year_end(others, current_date)
    if prior_year_end is None:
        prior_year_end = closest_date(
            date(current_date.year - 1, *FISCAL_YEAR_END),
            others,
        )

    prior_quarter_target = subtract_months(current_date, 3)
    prior_quarter = closest_date(prior_quarter_target, others)

    pyq_target = subtract_months(current_date, 12)
    best_pyq = closest_date(pyq_target, others)
    pyq_delta = abs((dated[best_pyq] - pyq_target).days)
    prior_year_same_qtr = (
        prior_year_end if pyq_delta > PY_MATCH_DAYS else best_pyq
    )

    roles = {
        "current": current_column,
        "prior_year_end": prior_year_end,
        "prior_quarter": prior_quarter,
        "prior_year_same_qtr": prior_year_same_qtr,
    }
    log_classification(
        "BS", roles, dated, prior_quarter_target,
        pyq_target, pyq_delta, pyq_delta > PY_MATCH_DAYS,
    )
    return roles


def classify_is_periods(
    raw_columns: list[str],
) -> tuple[dict[str, str], list[str]]:
    dated = {column: parse_date(column) for column in raw_columns}
    current_column = max(dated, key=dated.get)
    current_date = dated[current_column]
    others = {c: d for c, d in dated.items() if c != current_column}

    if not others:
        raise ValueError("IS needs at least two date columns.")

    pyq_target = subtract_months(current_date, 12)
    best_pyq = closest_date(pyq_target, others)
    pyq_delta = abs((dated[best_pyq] - pyq_target).days)

    if pyq_delta <= PY_MATCH_DAYS:
        prior_year_same_qtr = best_pyq
    else:
        prior_year_same_qtr = most_recent_fiscal_year_end(
            others, current_date
        ) or closest_date(date(current_date.year - 1, *FISCAL_YEAR_END), others)

    roles = {
        "current": current_column,
        "prior_year_same_qtr": prior_year_same_qtr,
    }
    discarded = [column for column in others if column != prior_year_same_qtr]
    log_classification(
        "IS", roles, dated, target_pyq=pyq_target,
        pyq_delta=pyq_delta, used_fallback=pyq_delta > PY_MATCH_DAYS,
    )
    return roles, discarded


def classify_is_qtd_periods(
    raw_columns: list[str],
) -> tuple[dict[str, str], list[str]]:
    dated = {column: parse_date(column) for column in raw_columns}
    current_column = max(dated, key=dated.get)
    current_date = dated[current_column]
    others = {c: d for c, d in dated.items() if c != current_column}

    if len(others) < 2:
        raise ValueError("IS QTD needs at least three date columns.")

    prior_quarter_target = subtract_months(current_date, 3)
    prior_quarter = closest_date(prior_quarter_target, others)

    pyq_target = subtract_months(current_date, 12)
    pyq_pool = {c: d for c, d in others.items() if c != prior_quarter}
    pyq_pool = pyq_pool or others

    best_pyq = closest_date(pyq_target, pyq_pool)
    pyq_delta = abs((dated[best_pyq] - pyq_target).days)

    if pyq_delta <= PY_MATCH_DAYS:
        prior_year_same_qtr = best_pyq
    else:
        prior_year_same_qtr = (
            most_recent_fiscal_year_end(pyq_pool, current_date)
            or closest_date(date(current_date.year - 1, *FISCAL_YEAR_END), pyq_pool)
        )

    roles = {
        "current": current_column,
        "prior_quarter": prior_quarter,
        "prior_year_same_qtr": prior_year_same_qtr,
    }
    discarded = [column for column in raw_columns if column not in roles.values()]
    log_classification(
        "IS QTD", roles, dated, prior_quarter_target,
        pyq_target, pyq_delta, pyq_delta > PY_MATCH_DAYS,
    )
    return roles, discarded


