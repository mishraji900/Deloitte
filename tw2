def _write_table(ws, title, pdf, start_row, status_col=None):
    """Write a titled table into ws starting at start_row. Returns next free row."""
    cols = list(pdf.columns)
    n_cols = len(cols)

    # Title row â€” merged across all columns
    ws.merge_cells(start_row=start_row, start_column=1,
                   end_row=start_row,   end_column=n_cols)
    title_cell = ws.cell(row=start_row, column=1, value=title)
    title_cell.font      = TITLE_FONT
    title_cell.fill      = TITLE_FILL
    title_cell.alignment = Alignment(horizontal="left", vertical="center")
    ws.row_dimensions[start_row].height = 18

    # Header row
    hdr_row = start_row + 1
    for ci, col in enumerate(cols, 1):
        c = ws.cell(row=hdr_row, column=ci, value=col)
        c.font = HEADER_FONT
        c.fill = HEADER_FILL

    # Data rows
    for ri, row in enumerate(pdf.itertuples(index=False), 1):
        data_row = hdr_row + ri
        fill = ALT_FILL if ri % 2 == 0 else None
        for ci, val in enumerate(row, 1):
            c = ws.cell(row=data_row, column=ci, value=val)
            if fill:
                c.fill = fill
            # PASS / FAIL colouring on status column
            if status_col and cols[ci - 1] == status_col:
                if val == "PASS":
                    c.fill = PASS_FILL
                    c.font = Font(bold=True, color="276221")
                elif "FAIL" in str(val):
                    c.fill = FAIL_FILL
                    c.font = Font(bold=True, color="9C0006")

    # Auto-fit column widths
    for ci, col in enumerate(cols, 1):
        max_len = max(
            len(str(col)),
            *(len(str(r)) for r in pdf[col].astype(str))
        )
        ws.column_dimensions[get_column_letter(ci)].width = min(max_len + 4, 40)

    return hdr_row + len(pdf) + GAP                      # next table starts here


