ZERO = Decimal(0)

# ── 2A. Data helpers ──────────────────────────────────────────────────────────
def norm(text):
    return "" if text is None else str(text).strip().lower()


def records_from(df):
    """Spark / pandas / list -> list of dicts."""
    if hasattr(df, "toPandas"):
        return df.toPandas().to_dict(orient="records")
    if hasattr(df, "to_dict"):
        return df.to_dict(orient="records")
    if isinstance(df, list):
        return df
    raise TypeError(f"Unsupported dataframe type: {type(df)}")


def column_names(df):
    if hasattr(df, "columns"):
        return list(df.columns)
    rows = records_from(df)
    return list(rows[0]) if rows else []


def to_decimal(value):
    if value is None:
        return None
    s = str(value).strip().replace(",", "")
    if s in ("", "-", "\u2014"):
        return None
    try:
        return Decimal(s)
    except InvalidOperation:
        return None


def sum_by_code(df):
    """{grouping code: total balance}"""
    result = {}
    for rec in records_from(df):
        code = str(rec.get(GROUP_CODE_COL, "")).strip()
        val = to_decimal(rec.get(TOTAL_COL))
        if code and val is not None:
            result[code] = result.get(code, ZERO) + val
    return result


def load_lookups(current_df, prior_df):
    """Read each dataframe once. ytd = current, prior = prior, qtd = current - prior."""
    ytd, prior = sum_by_code(current_df), sum_by_code(prior_df)
    qtd = {c: ytd.get(c, ZERO) - prior.get(c, ZERO) for c in ytd.keys() | prior.keys()}
    return {"ytd": ytd, "qtd": qtd, "prior": prior}


TERM = re.compile(r"([+-]?)\s*(\w+)")      # one "+ name" / "- name" piece of a formula


def sigma_value(row, lookup):
    """Sum of the row's grouping codes."""
    return sum((lookup.get(c, ZERO) for c in row.codes.split("+")), ZERO)


def excel_formula(formula, col, rows, lookup):
    """
    'cor + sga - tax' -> '=F12+F13-F19'   (col = column letter, rows = {key: row number}).
    A name that is not a row key is treated as a grouping code and inserted as a number.
    """
    parts = []
    for sign, name in TERM.findall(formula):
        ref = f"{col}{rows[name]}" if name in rows else str(lookup.get(name, ZERO))
        parts.append(("-" if sign == "-" else "+") + ref)
    return "=" + "".join(parts).lstrip("+")


# ── 2B. Excel drawing helpers ─────────────────────────────────────────────────
def outline(ws, r1, c1, r2, c2, style="thin", color=BLACK):
    """Draw a box around a range (works for merged ranges too)."""
    edge, none = Side(style=style, color=color), Side(style=None)
    for r in range(r1, r2 + 1):
        for c in range(c1, c2 + 1):
            ws.cell(row=r, column=c).border = Border(
                left=edge if c == c1 else none, right=edge if c == c2 else none,
                top=edge if r == r1 else none,  bottom=edge if r == r2 else none)


def put(ws, row, col, value=None, *, font=FONT_BODY, fill=FILL_WHITE,
        align=ALIGN_CENTER, fmt=None, end_row=None, end_col=None,
        border=("thin", BLACK)):
    """
    Write ONE styled cell. Every cell in the workbook goes through here.
    end_row / end_col -> merge the block. border=(style, color) or None.
    """
    end_row, end_col = end_row or row, end_col or col
    if (end_row, end_col) != (row, col):
        ws.merge_cells(start_row=row, start_column=col,
                       end_row=end_row, end_column=end_col)
    cell = ws.cell(row=row, column=col, value=value)
    cell.font, cell.fill, cell.alignment = font, fill, align
    if fmt:
        cell.number_format = fmt
    if border:
        outline(ws, row, col, end_row, end_col, *border)
    return cell


def money(raw):
    return None if raw is None else float(raw)


# ── 2C. Trial Balance tabs ────────────────────────────────────────────────────
def tb_sheet_name(as_of_text):
    """'As Of Period: 9-26 (3/31/2026)' -> 'Trial Balance 9-26'"""
    m = re.search(r":\s*([\w\-]+)", as_of_text)
    return f"{TB_SHEET_PREFIX} {m.group(1).strip() if m else as_of_text}"


def get_columns(df):
    """Returns (entity column names, main post columns, side post columns)."""
    cols = column_names(df)
    names = [norm(c) for c in cols]
    if norm(ACCOUNT_COL) not in names:
        raise KeyError(f"Column not found: {ACCOUNT_COL!r}")

    skip = {norm(p.name) for p in POST_COLS} | {norm(ROW_ID_COL)}
    entity = [c for c in cols[names.index(norm(ACCOUNT_COL)) + 1:]
              if norm(c) not in skip]
    if not entity:
        raise ValueError(f"No entity columns found after {ACCOUNT_COL!r}")
    entity_names = [norm(c) for c in entity]
    if norm(LAST_ENTITY_COL) in entity_names:
        entity = entity[: entity_names.index(norm(LAST_ENTITY_COL)) + 1]

    actual = {norm(c): c for c in cols}
    post = [(actual[norm(p.name)], p) for p in POST_COLS if norm(p.name) in actual]
    return (entity,
            [x for x in post if x[1].in_main],
            [x for x in post if not x[1].in_main])


def split_bs_is(df):
    """Split rows into (balance sheet rows, income statement rows)."""
    rows = sorted(records_from(df), key=lambda r: int(r.get(ROW_ID_COL, 0)))
    names = [norm(r.get(ACCOUNT_COL)) for r in rows]
    if BS_MARKER not in names:
        raise ValueError(f"Marker row not found: Account == {BS_MARKER!r}")

    bs_at = names.index(BS_MARKER)
    is_at = names.index(IS_MARKER) if IS_MARKER in names else None
    bs = rows[bs_at + 1: is_at if is_at is not None else len(rows)]
    is_ = rows[is_at + 1:] if is_at is not None else []

    keep = lambda r: norm(r.get(ACCOUNT_COL)) not in (BS_MARKER, IS_MARKER)
    return list(filter(keep, bs)), list(filter(keep, is_))


def write_tb_table(ws, title, records, entity, main_posts, side_posts, start):
    """One table (Balance Sheet or Income Statement). Returns next free row."""
    ws.row_dimensions[start].height = TB_HEADER_HEIGHT

    # main table: account + entity columns + main post columns
    main = [(c, c) for c in entity] + [(c, p.header) for c, p in main_posts]
    put(ws, start, COL_ACCOUNT, title.upper(), font=FONT_SECTION,
        fill=FILL_BLUE, align=ALIGN_LEFT_BOTTOM)
    for i, (_, header) in enumerate(main, start=1):
        put(ws, start, COL_ACCOUNT + i, header, font=FONT_HDR,
            fill=FILL_BLUE, align=ALIGN_CENTER_WRAP)

    last_col = COL_ACCOUNT + len(main)
    ws.auto_filter.ref = (f"{get_column_letter(COL_ACCOUNT)}{start}:"
                          f"{get_column_letter(last_col)}{start}")

    # side table: to the right, after a gap
    side_start = last_col + TB_SIDE_GAP + 1
    for j, (_, p) in enumerate(side_posts):
        put(ws, start, side_start + j, p.header,
            font=FONT_HDR_RED if p.is_code else FONT_HDR,
            fill=FILL_BLUE, align=ALIGN_CENTER_WRAP)

    # data rows
    r = start + 1
    for rec in records:
        ws.row_dimensions[r].height = H_ROW
        put(ws, r, COL_ACCOUNT, rec.get(ACCOUNT_COL), align=ALIGN_LEFT)
        for i, (key, _) in enumerate(main, start=1):
            put(ws, r, COL_ACCOUNT + i, money(rec.get(key)),
                align=ALIGN_RIGHT, fmt=MONEY_FMT)
        for j, (key, p) in enumerate(side_posts):
            raw = rec.get(key)
            if p.is_code:
                put(ws, r, side_start + j, (str(raw).strip() if raw is not None else "") or None,
                    font=FONT_RED_BOLD)
            else:
                put(ws, r, side_start + j, money(raw), align=ALIGN_RIGHT, fmt=MONEY_FMT)
        r += 1
    return r + 2


def build_tb_sheet(ws, df, as_of_text):
    ws.sheet_view.showGridLines = False
    entity, main_posts, side_posts = get_columns(df)
    n_cols = 1 + len(entity) + len(main_posts) + len(side_posts)

    # column widths
    ws.column_dimensions["A"].width = TB_COL_WIDTHS["spacer"]
    ws.column_dimensions[get_column_letter(COL_ACCOUNT)].width = TB_COL_WIDTHS["account"]
    for c in range(COL_ACCOUNT + 1, n_cols + 2):
        ws.column_dimensions[get_column_letter(c)].width = TB_COL_WIDTHS["other"]
    ws.freeze_panes = f"{get_column_letter(COL_ACCOUNT + 1)}{TB_FIRST_TABLE_ROW}"

    # banner rows
    for r, (text, size, bold, green) in enumerate(TB_BANNERS, start=1):
        ws.row_dimensions[r].height = H_BAND
        put(ws, r, COL_ACCOUNT, text.format(as_of=as_of_text),
            font=make_font(size=size, bold=bold),
            border=("medium", GREEN) if green else None)
    ws.row_dimensions[len(TB_BANNERS) + 1].height = H_SPACER

    # note box
    (r1, r2), (c1, c2) = TB_NOTE_ROWS, TB_NOTE_COLS
    ws.row_dimensions[r1].height = TB_NOTE_TOP_HEIGHT
    for r in range(r1 + 1, r2 + 1):
        ws.row_dimensions[r].height = H_ROW
    put(ws, r1, c1, TB_NOTE_TEXT, fill=FILL_GREY, align=ALIGN_LEFT_TOP,
        end_row=r2, end_col=c2)

    # tables
    bs_rows, is_rows = split_bs_is(df)
    nxt = write_tb_table(ws, TB_SECTION_BS, bs_rows, entity, main_posts,
                         side_posts, TB_FIRST_TABLE_ROW)
    if is_rows:
        write_tb_table(ws, TB_SECTION_IS, is_rows, entity, main_posts,
                       side_posts, nxt)


# ── 2D. Tie-out tabs ──────────────────────────────────────────────────────────
def write_header(ws, r, C, labels, has_qtd, height, tags=True):
    """Column header row (+ 'Tab 1' / 'Rx' tag row under it). Uses rows r, r+1."""
    ws.row_dimensions[r].height = height
    ws.row_dimensions[r + 1].height = H_SMALL
    put(ws, r, C.symbol, labels["code"], font=FONT_HDR, fill=FILL_GREY,
        align=ALIGN_CENTER_WRAP, end_col=C.code)
    put(ws, r, C.ref, labels["ref"], font=FONT_HDR, fill=FILL_GREY,
        align=ALIGN_CENTER_WRAP)
    for attr, tag, red in AMOUNT_COLUMNS[: 4 if has_qtd else 2]:
        font = FONT_HDR_RED if red else FONT_HDR
        put(ws, r, getattr(C, attr), labels[attr], font=font, fill=FILL_GREY,
            align=ALIGN_CENTER_WRAP)
        if tags:
            put(ws, r + 1, getattr(C, attr), tag, font=font, fill=FILL_GREY)


def write_amounts(ws, r, C, bal_attr, rnd_attr, val, font, fmt):
    """Raw-dollar cell + green rounded-in-millions cell. val = number or '=formula'."""
    bal_col, rnd_col = getattr(C, bal_attr), getattr(C, rnd_attr)
    if isinstance(val, str):                                   # Excel formula
        rounded = f"=ROUND({get_column_letter(bal_col)}{r}/{MILLION},{ROUND_DIGITS})"
    else:
        rounded = None if val is None else float(round(val / MILLION, ROUND_DIGITS))
        val = money(val)
    put(ws, r, bal_col, val, font=font, align=ALIGN_RIGHT, fmt=fmt)
    put(ws, r, rnd_col, rounded, font=font, fill=FILL_GREEN,
        align=ALIGN_RIGHT, fmt=ROUNDED_FMT)


def write_data_row(ws, r, C, row, ytd, qtd, fmt):
    ws.row_dimensions[r].height = H_ROW
    is_calc = row.kind in ("calc", "total")
    font = FONT_BOLD if row.bold else FONT_BODY
    symbol = {"sigma": "\u03A3", "calc": "Rx"}.get(row.kind)

    put(ws, r, C.symbol, symbol, font=FONT_SYM_RED if is_calc else FONT_SYM_BLUE)
    put(ws, r, C.code, row.codes or None, font=FONT_CODE)
    put(ws, r, C.ref, row.label, font=font, align=ALIGN_LEFT)
    write_amounts(ws, r, C, "bal", "rnd", ytd, font, fmt)      # ytd / qtd: number or '=formula'
    if qtd is not None:
        write_amounts(ws, r, C, "qbal", "qrnd", qtd, font, fmt)


def write_py_row(ws, r, C, row, fmt):
    """Prior-year row: user types the numbers into the red boxes."""
    ws.row_dimensions[r].height = H_ROW
    put(ws, r, C.symbol, "PY", font=FONT_SYM_RED)
    put(ws, r, C.code, row.py_ref, font=FONT_PY_REF, align=ALIGN_CENTER_WRAP)
    put(ws, r, C.ref, row.label, align=ALIGN_LEFT, border=("thin", GREEN))
    put(ws, r, C.bal, align=ALIGN_RIGHT, fmt=fmt, border=("medium", RED))
    put(ws, r, C.rnd, fill=FILL_GREEN, align=ALIGN_RIGHT, fmt=ROUNDED_FMT,
        border=("medium", RED))


def write_table(ws, spec, table, row, look, rows):
    """Draw one table starting at `row`. `rows` = {row key: Excel row number}. Returns the next free row."""
    C = MAIN_COLS
    last = C.qrnd if table.has_qtd else C.rnd
    ws.row_dimensions[row].height = H_BAND
    put(ws, row, C.symbol, table.title, font=FONT_BOLD, fill=FILL_GREY, end_col=last)

    if table.note_only:                                   # empty box to type in
        for r in range(row + 1, row + 4):
            ws.row_dimensions[r].height = H_SMALL
        put(ws, row + 1, C.symbol, align=ALIGN_LEFT_TOP, end_row=row + 3, end_col=C.rnd)
        return row + 4

    write_header(ws, row + 1, C, spec.labels, table.has_qtd, spec.header_height)
    periods = ("ytd", "qtd") if table.has_qtd else ("ytd",)
    r = row + 3

    for rw in table.rows:
        if rw.kind == "blank":
            ws.row_dimensions[r].height = H_SPACER
        elif rw.kind == "subtitle":
            ws.row_dimensions[r].height = H_SMALL
            for col in range(C.symbol, last + 1):
                put(ws, r, col, rw.label if col == C.ref else None,
                    font=FONT_ITALIC, fill=FILL_GREY, align=ALIGN_LEFT)
        elif rw.kind == "sub_header":
            write_header(ws, r, C, spec.sub_labels or spec.labels,
                         table.has_qtd, H_SUBHDR)
            r += 1                                        # header uses two rows
        elif rw.kind == "py":
            write_py_row(ws, r, C, rw, spec.balance_fmt)
        else:                                             # sigma / calc / total
            rows[rw.key] = r
            vals = {}
            for p, attr in zip(periods, ("bal", "qbal")):
                if rw.kind == "sigma":
                    vals[p] = sigma_value(rw, look[p])         # number from the TB
                else:                                          # Excel formula
                    col = get_column_letter(getattr(C, attr))
                    vals[p] = excel_formula(rw.formula, col, rows, look[p])
            write_data_row(ws, r, C, rw, vals["ytd"], vals.get("qtd"),
                           spec.balance_fmt)
        r += 1
    return r


def write_side_table(ws, spec, look):
    side = spec.side
    S, r = SIDE_COLS, side.start_row
    ws.row_dimensions[r].height = H_SMALL
    put(ws, r, S.symbol, side.caption, font=FONT_BOLD, align=ALIGN_LEFT,
        end_col=S.rnd, border=None)
    write_header(ws, r + 1, S, side.labels, False, spec.header_height, tags=False)
    value = look[side.source].get(side.code, ZERO)
    write_data_row(ws, r + 2, S, sigma("side", side.code, side.label),
                   value, None, spec.balance_fmt)


def write_check_digit(ws, r, spec, look, rows):
    C = MAIN_COLS
    ws.row_dimensions[r].height = H_ROW
    put(ws, r, C.ref, spec.check.label, font=FONT_CHECK, end_col=C.bal)
    formula = excel_formula(spec.check.formula, get_column_letter(C.bal), rows, look["ytd"])
    put(ws, r, C.rnd, formula, align=ALIGN_RIGHT, fmt=CHECK_FMT)


def build_tieout_sheet(wb, spec, look):
    if spec.name in wb.sheetnames:
        del wb[spec.name]
    ws = wb.create_sheet(spec.name)
    ws.sheet_view.showGridLines = False
    for col, width in spec.col_widths.items():
        ws.column_dimensions[get_column_letter(col)].width = width
    ws.freeze_panes = spec.freeze

    # rows 1-3 title lines, row 4 spacer, row 5 intro band, then spacers
    for r, (text, size, bold) in enumerate(spec.header_lines, start=1):
        ws.row_dimensions[r].height = H_TITLE_LINE
        put(ws, r, MAIN_COLS.symbol, text, font=make_font(size=size, bold=bold),
            align=ALIGN_LEFT, border=None)
    ws.row_dimensions[4].height = H_SPACER
    ws.row_dimensions[5].height = H_TITLE_LINE
    put(ws, 5, MAIN_COLS.symbol, spec.intro_text, fill=spec.intro_fill,
        align=ALIGN_LEFT, end_col=MAIN_COLS.rnd)
    for r in range(6, spec.first_table_row):
        ws.row_dimensions[r].height = H_SPACER

    # tables. `rows` remembers where each row landed so formulas can point at it.
    rows = {}
    row = spec.first_table_row
    for table in spec.tables:
        end = write_table(ws, spec, table, row, look, rows)
        row = end + TABLE_GAP_ROWS

    if spec.check:
        ws.row_dimensions[end + 1].height = H_SPACER
        write_check_digit(ws, end + 2, spec, look, rows)
    if spec.side:
        write_side_table(ws, spec, look)


# ── 2E. Orchestrator ──────────────────────────────────────────────────────────
def build_workbook():
    wb = Workbook()
    for i, (df, as_of_text) in enumerate(TB_SHEETS):
        ws = wb.active if i == 0 else wb.create_sheet()
        ws.title = tb_sheet_name(as_of_text)
        build_tb_sheet(ws, df, as_of_text)

    look = load_lookups(CURRENT_TB, PRIOR_TB)      # dataframes read once here
    for spec in TIEOUT_SHEETS:
        build_tieout_sheet(wb, spec, look)
    return wb


def selfcheck():
    """Fails fast if formula building or tab naming breaks."""
    assert excel_formula("a - b + c", "F", {"a": 11, "b": 12}, {"c": Decimal(3)}) == "=F11-F12+3"
    assert excel_formula("a + b", "G", {"a": 5, "b": 6}, {}) == "=G5+G6"
    assert tb_sheet_name("As Of Period: 9-26 (3/31/2026)") == "Trial Balance 9-26"
    keys = [r.key for t in SHEET_3.tables for r in t.rows if r.key]
    assert len(keys) == len(set(keys)), "duplicate row keys in SHEET_3"


# ── Run ───────────────────────────────────────────────────────────────────────
selfcheck()
workbook = build_workbook()

cp.openpyxl.write(workbook, OUTPUT_FILE, register=True)
