def _apply_investigate_colors(
    worksheet,
    column_letters,
    non_grey_rows,
):
    """
    Green when the result is No.
    Red for every other result.

    Blank results are intentionally not excluded.
    """
    for row_number in non_grey_rows:
        for key in ("inv1", "inv2"):
            cell_reference = (
                f"{column_letters[key]}{row_number}"
            )
            cell = worksheet[cell_reference]

            if (
                isinstance(cell.value, str)
                and not cell.value.startswith("=")
            ):
                cell.fill = (
                    GREEN_FILL
                    if cell.value.strip().casefold() == "no"
                    else RED_FILL
                )
            else:
                cell.fill = WHITE_FILL

            no_formula = (
                f'IFERROR('
                f'UPPER(TRIM({cell_reference}))="NO",'
                f'FALSE)'
            )

            green_rule = FormulaRule(
                formula=[no_formula],
                fill=GREEN_FILL,
                stopIfTrue=True,
            )

            red_rule = FormulaRule(
                formula=[
                    f"NOT({no_formula})"
                ],
                fill=RED_FILL,
                stopIfTrue=True,
            )

            worksheet.conditional_formatting.add(
                cell_reference,
                green_rule,
            )

            worksheet.conditional_formatting.add(
                cell_reference,
                red_rule,
            )


