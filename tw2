SRC = {   # label = suffix in final parquet cols | cols = columns summed into net total | kind: links (group ffill) / plain (key col only)
    "03312026": dict(path=excel_path_03312026, sheets=["Balance Sheet TB Links", "Income Statement TB Links"],
