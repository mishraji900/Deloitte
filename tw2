excluded_columns = {"Account", "__sheet__", "row_id", "Grouping Code"}

def to_numeric(column_name):
    c = F.regexp_replace(F.trim(F.col(column_name).cast("string")), r"\$", "")
    return c.cast("double").alias(column_name)

def add_totals(df):
    numeric_cols = [c for c in df.columns if c not in excluded_columns]      # includes BR015
    sum_cols     = [c for c in numeric_cols if c != "BR015"]                 # BR015 = check, not input
    df = df.select(*[to_numeric(c) if c in numeric_cols else F.col(c) for c in df.columns])
    total = sum((F.coalesce(F.col(c), F.lit(0.0)) for c in sum_cols), F.lit(0.0))
    return (df.withColumn("Total Consolidated Balances", total)
              .withColumn("D&T Check", F.col("BR015") - F.col("Total Consolidated Balances"))
              .withColumn("Total Consolidated Balances (Rounded in millions)",
                          F.round(F.col("Total Consolidated Balances") / F.lit(1_000_000), 2)))

TB_03312026 = add_totals(TB_03312026)
TB_12312025 = add_totals(TB_12312025)
