def _resolve_residual_analytic_sheet(
    template,
    hint=RESIDUAL_ANALYTIC_SHEET_HINT,
):
    """
    Finds the Residual Analytic worksheet using a case-insensitive substring.
    """

    target = hint.strip().casefold()

    matches = [
        sheet_name
        for sheet_name in template.sheetnames
        if target in sheet_name.strip().casefold()
    ]

    if len(matches) == 1:
        return matches[0]

    if len(matches) > 1:
        raise ValueError(
            f"Multiple sheets match {hint!r}: {matches}"
        )

    raise ValueError(
        f"No sheet matching {hint!r}. "
        f"Available: {template.sheetnames}"
    )


