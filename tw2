# DBTITLE 1,Utility Function AA Comment Logic
# ── AA Comment logic ─────────────────────────────────────────────────────────

# assign_aa_comment(): the final labeling pass, run once in Cell 8 against
# every row that survived all of Pipeline 4 still unmatched. Writes two new
# columns — "AA Comment" (client-facing explanation, values are the
# AA_* constants defined in Cell 1) and "AA Rule" (which specific branch
# produced that comment — an internal audit trail, not shown to the
# client). Both columns are filled via a chain of
# ".withColumn(..., F.when(<col>.isNull() & <condition>, ...).otherwise(<col>))"
# steps — "first match wins": once a row's AA Comment is set by an earlier
# rule in the chain, every later rule's isNull() guard skips it.
#
# RECTIFIED (Problem 2 fix): Rule Group 3's vendor-level stats used to be
# computed and joined on vendor_num_clean ALONE. That is the wrong grain —
# the same Vendor/Customer Number can legitimately exist under multiple
# different companies (Company Description), and matching only ever
# happens within a single company+vendor combination (primary_key /
# p4_primary_key both include company). A vendor number with Sales
# Invoices under Company A but ONLY Credit Memos under Company B would,
# under the old vendor-only grain, incorrectly see Company B's credit rows
# as "this vendor has sales invoices somewhere" and fall through to the
# AA_CLIENT_CONFIRM catch-all instead of AA_ONLY_CREDITS — a false
# negative. Fix: vendor_stats is now grouped by (company_desc_clean,
# vendor_num_clean) and joined back on that SAME composite key, so Rule
# Group 3 only ever looks at the exact company+vendor combination the
# unmatched row itself belongs to.
#
# RULE PRIORITY (first match wins, top to bottom):
#   Group 1  — match_type == ONE_TO_MANY              -> AA_ONE_TO_MANY
#              (this row was one of several tolerance-match candidates in
#              Pipeline 4 — ambiguous, so it's flagged rather than picked)
#   Group 2a — match_type == ONE_TO_ONE_DATE_SYNC      -> AA_EXACT_MATCH_SYNC
#              if the pair's net amount is exactly zero (looked up via
#              oto_df, Pipeline 4's classified one-to-one candidates),
#              else AA_APPROX_MATCH (within P4_TOLERANCE but not exact)
#   Group 2b — match_type == ONE_TO_ONE_DATE_UNSYNC    -> mirrors 2a but
#              for the case where the credit memo's date is BEFORE the
#              sales invoice's (AA_EXACT_MATCH_UNSYNC / AA_APPROX_MATCH)
#   Group 3  — match_type == NO_MATCH_FOUND AND cat_clean == CREDIT MEMOS
#              (Sales Invoices that reach NO_MATCH_FOUND get no AA Comment
#              at all — this whole group only labels unmatched credits),
#              evaluated at the COMPANY+VENDOR composite-key grain:
#                P1: company+vendor combo has zero Sales Invoices anywhere
#                    in raw_df -> AA_ONLY_CREDITS (nothing this credit
#                    could ever match, for THIS company+vendor)
#                P2: company+vendor combo has exactly 1 distinct
#                    (company, vendor, amount) credit combination in
#                    raw_df -> AA_SINGLE_CREDIT_COMBO
#                P3: |amount| <= small_amt_threshold -> AA_SMALL_AMOUNT
#                P4: catch-all, everything else -> AA_CLIENT_CONFIRM
#
# raw_df here is the FULL raw dataset (current + carry-forward, via
# raw_for_stats in Cell 8) — vendor-level stats (does this company+vendor
# combo have any sales invoices at all? how many distinct credit
# combinations?) need to be computed against everything the combo ever
# did, not just the narrow slice of rows that happened to reach Pipeline 4
# unmatched.
def assign_aa_comment(df, raw_df, oto_df=None,
                      small_amt_threshold: float = SMALL_AMT_MAX):
    if "abs_entered_dec" not in df.columns:
        df = df.withColumn("abs_entered_dec", F.abs(to_decimal_clean("Net Entered")))
    if "eff_dt" not in df.columns:
        df = df.withColumn("eff_dt", to_date_clean("Default Effective Date"))
    if "vendor_num_clean" not in df.columns:
        df = df.withColumn("vendor_num_clean",
                           F.trim(F.col("Vendor/Customer Number").cast("string")))
    if "company_desc_clean" not in df.columns:
        df = df.withColumn("company_desc_clean",
                           F.trim(F.upper(F.col("Company Description"))))
    if "entered_net_dec" not in df.columns:
        df = df.withColumn("entered_net_dec", to_decimal_clean("Net Entered"))
    if "cat_clean" not in df.columns:
        df = df.withColumn("cat_clean", F.trim(F.upper(F.col("JE Category"))))

    otm_expr      = F.col("match_type") == "ONE_TO_MANY"
    sync_expr     = F.col("match_type") == "ONE_TO_ONE_DATE_SYNC"
    unsync_expr   = F.col("match_type") == "ONE_TO_ONE_DATE_UNSYNC"
    no_match_expr = F.col("match_type") == "NO_MATCH_FOUND"

    _no_match_cm  = no_match_expr & (F.col("cat_clean") == "CREDIT MEMOS")

    # _exact_cancel: was this row part of a Pipeline-4 pair whose net
    # amount was EXACTLY zero (not just within tolerance)? oto_df is P4's
    # classified one-to-one candidates (both sync and unsync); this row's
    # own amount_net is looked up by row_id regardless of which side
    # (sales or credit) it was.
    if oto_df is not None:
        oto_lookup = (
            oto_df.select(
                F.col("sales_row_id").alias("row_id"),
                F.col("amount_net").cast(DECIMAL_TYPE).alias("_pair_net_abs"),
            ).unionByName(
                oto_df.select(
                    F.col("credit_row_id").alias("row_id"),
                    F.col("amount_net").cast(DECIMAL_TYPE).alias("_pair_net_abs"),
                )
            ).distinct()
        )
        df = df.join(oto_lookup, on="row_id", how="left")
        _exact_cancel = (
            F.col("_pair_net_abs").isNotNull()
            & (F.col("_pair_net_abs") == EXACT_ZERO)
        )
    else:
        df = df.withColumn("_pair_net_abs", F.lit(None).cast(DECIMAL_TYPE))
        _exact_cancel = F.lit(False)

    # ── Rule Group 1: ONE_TO_MANY ────────────────────────────────────────────
    df = df.withColumn("AA Comment",
        F.when(otm_expr, F.lit(AA_ONE_TO_MANY))
         .otherwise(F.lit(None).cast("string"))
    ).withColumn("AA Rule",
        F.when(otm_expr, F.lit("Rule1_OTM"))
         .otherwise(F.lit(None).cast("string"))
    )

    # ── Rule Group 2a: DATE_SYNC — exact or approx ──────────────────────────
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull() & sync_expr & _exact_cancel,
            F.lit(AA_EXACT_MATCH_SYNC),
        ).when(
            F.col("AA Comment").isNull() & sync_expr,
            F.lit(AA_APPROX_MATCH),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(F.col("AA Rule").isNull() & sync_expr & _exact_cancel,
               F.lit("Rule2a_DateSync_ExactMatch"))
         .when(F.col("AA Rule").isNull() & sync_expr,
               F.lit("Rule2a_DateSync_ApproxMatch"))
         .otherwise(F.col("AA Rule"))
    )

    # ── Rule Group 2b: DATE_UNSYNC — exact or approx ────────────────────────
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull() & unsync_expr & _exact_cancel,
            F.lit(AA_EXACT_MATCH_UNSYNC),
        ).when(
            F.col("AA Comment").isNull() & unsync_expr,
            F.lit(AA_APPROX_MATCH),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(F.col("AA Rule").isNull() & unsync_expr & _exact_cancel,
               F.lit("Rule2b_DateUnsync_ExactMatch"))
         .when(F.col("AA Rule").isNull() & unsync_expr,
               F.lit("Rule2b_DateUnsync_ApproxMatch"))
         .otherwise(F.col("AA Rule"))
    )

    # ── Rule Group 3: NO_MATCH_FOUND — COMPANY+VENDOR composite-key stats ──
    # vendor_stats: per-(company, vendor) counts computed against the FULL
    # raw dataset (raw_df), not just the unmatched slice — this is
    # deliberate, see function docstring above. Three counts: distinct
    # Sales Invoice references, distinct Credit Memo references, and
    # distinct (company, vendor, amount) credit-memo combinations — all
    # scoped to the exact company+vendor combo, which is the composite-key
    # fix for Problem 2.
    vendor_stats = (
        raw_df
        .withColumn("_co_clean", F.trim(F.upper(F.col("Company Description"))))
        .withColumn("_vn_clean", F.trim(F.col("Vendor/Customer Number").cast("string")))
        .withColumn("_cat",      F.trim(F.upper(F.col("JE Category"))))
        .groupBy("_co_clean", "_vn_clean")
        .agg(
            F.countDistinct(
                F.when(F.col("_cat") == "SALES INVOICES", F.col("Invoice Reference"))
            ).alias("sales_inv_count"),
            F.countDistinct(
                F.when(F.col("_cat") == "CREDIT MEMOS", F.col("Invoice Reference"))
            ).alias("credit_memo_count"),
            F.countDistinct(
                F.when(F.col("_cat") == "CREDIT MEMOS",
                       F.concat_ws("|",
                           F.col("Company Description"),
                           F.col("Vendor/Customer Number"),
                           F.col("Net Entered"),
                       ))
            ).alias("credit_combinations"),
        )
    )

    # [AA-AUDIT] Composite-key stats table size — sanity-check that this is
    # genuinely a finer grain than a vendor-only groupBy would have been
    # (more rows than distinct vendor_num_clean alone whenever a vendor
    # number is shared across >1 company).
    debug_count(
        "[AA Rule Group 3] Distinct Company+Vendor combinations (composite key stats)",
        vendor_stats,
    )

    df = (
        df.join(
            vendor_stats
                .withColumnRenamed("_co_clean", "_co_join")
                .withColumnRenamed("_vn_clean", "_vn_join"),
            (df["company_desc_clean"] == F.col("_co_join"))
            & (df["vendor_num_clean"] == F.col("_vn_join")),
            "left",
        )
        .drop("_co_join", "_vn_join")
    )

    # Priority 1 — company+vendor combo has ONLY credit memos, zero sales
    # invoices at all (composite-key grain).
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull()
            & _no_match_cm
            & (F.col("sales_inv_count") == 0)
            & (F.col("credit_memo_count") > 0),
            F.lit(AA_ONLY_CREDITS),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(
            F.col("AA Rule").isNull() & _no_match_cm
            & (F.col("sales_inv_count") == 0) & (F.col("credit_memo_count") > 0),
            F.lit("Rule3P1_OnlyCredits_CompanyVendor"),
        ).otherwise(F.col("AA Rule"))
    )

    # Priority 2 — company+vendor combo has exactly ONE unique credit-memo
    # combination (composite-key grain).
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull()
            & _no_match_cm
            & (F.col("credit_combinations") == 1),
            F.lit(AA_SINGLE_CREDIT_COMBO),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(
            F.col("AA Rule").isNull() & _no_match_cm
            & (F.col("credit_combinations") == 1),
            F.lit("Rule3P2_SingleCreditCombo_CompanyVendor"),
        ).otherwise(F.col("AA Rule"))
    )

    # Priority 3 — small absolute amount (<= small_amt_threshold, default 5).
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull()
            & _no_match_cm
            & F.col("abs_entered_dec").isNotNull()
            & (F.col("abs_entered_dec") <= F.lit(small_amt_threshold).cast(DECIMAL_TYPE)),
            F.lit(AA_SMALL_AMOUNT),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(
            F.col("AA Rule").isNull() & _no_match_cm
            & (F.col("abs_entered_dec") <= F.lit(small_amt_threshold).cast(DECIMAL_TYPE)),
            F.lit(f"Rule3P3_SmallAmt_le{small_amt_threshold}"),
        ).otherwise(F.col("AA Rule"))
    )

    # Priority 4 — catch-all: any remaining unmatched Credit Memo that
    # didn't hit P1/P2/P3 above. Genuinely unexplained; needs a human.
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull() & _no_match_cm,
            F.lit(AA_CLIENT_CONFIRM),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(
            F.col("AA Rule").isNull() & _no_match_cm,
            F.lit("Rule3P4_ClientConfirm"),
        ).otherwise(F.col("AA Rule"))
    )

    return df.drop("_pair_net_abs", "sales_inv_count", "credit_memo_count", "credit_combinations")


# ── Match-step config ────────────────────────────────────────────────────────

# MATCH_STEPS: the ordered list of rules run_match_pipeline() feeds through
# exhaustive_match(), one at a time, each pass working on whatever the
# PREVIOUS step's remainder is. Order matters — once a row is matched by an
# earlier step it's gone before a later step ever sees it, so the earlier
# steps are the more specific/preferred matches. Used by Pipeline 1 and
# Pipeline 2 (month lag capped at 2):
#   NEXT_MONTH_EXACT  — credit memo posted exactly 1 business-month after
#                        its sales invoice, sales date <= credit date,
#                        amounts exactly cancel. The "normal" case: invoice
#                        one month, credit memo issued the next.
#   SAME_MONTH_EXACT  — same business month, sales date <= credit date,
#                        exact cancel. Invoice and its credit memo booked
#                        in the same period.
#   LAG_1_2_MONTH     — up to a 2-month gap (covers NEXT_MONTH_EXACT's
#                        1-month case plus a 2-month case), sales date <=
#                        credit date, exact cancel. A deliberately looser
#                        net that still requires an exact amount match —
#                        this is what actually needs the "exhaustive"
#                        repetition inside exhaustive_match(): a wider
#                        month window means more sales/credit rows are
#                        each other's candidate, so the mutual-best-match
#                        ranking in rank_based_match() settles the
#                        unambiguous pairs first and leaves rows that only
#                        become unambiguous after that removal for the
#                        next iteration.
# (A fourth, SAME_MONTH_ITERATIVE, existed in an earlier version of this
# list with a condition byte-for-byte identical to SAME_MONTH_EXACT above —
# removed as a no-op: the "iterative" part of matching already happens
# inside exhaustive_match()'s own loop, so a second step re-running the
# identical rule against SAME_MONTH_EXACT's already-exhausted remainder
# only ever finds zero further pairs.)
MATCH_STEPS = [
    (
        "NEXT_MONTH_EXACT",
        lambda df: df.filter(
            (F.col("month_lag") == 1)
            & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
            & (F.col("amount_diff") == EXACT_ZERO)
        ),
    ),
    (
        "SAME_MONTH_EXACT",
        lambda df: df.filter(
            (F.col("month_lag") == 0)
            & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
            & (F.col("amount_diff") == EXACT_ZERO)
        ),
    ),
    (
        "LAG_1_2_MONTH",
        lambda df: df.filter(
            F.col("month_lag").between(1, 2)
            & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
            & (F.col("amount_diff") == EXACT_ZERO)
        ),
    ),
]

# LAG_GT_2_STEPS: NEW (Problem 1) — used ONLY by Pipeline 3 (Cell 6).
# Same amount-exact, sales-before-credit matching rule as MATCH_STEPS, but
# for the leftover case MATCH_STEPS never covers: month_lag STRICTLY
# GREATER than 2. Kept as its own list (rather than folded into
# MATCH_STEPS) because it must run against P2's leftovers specifically,
# never against P1/P2's own inputs — a > 2 month gap should only be
# accepted after the tighter 0/1/2-month rules have both had first crack.
LAG_GT_2_STEPS = [
    (
        "LAG_GT_2_MONTH",
        lambda df: df.filter(
            (F.col("month_lag") > 2)
            & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
            & (F.col("amount_diff") == EXACT_ZERO)
        ),
    ),
]

# run_match_pipeline(): drives a given step list (MATCH_STEPS or
# LAG_GT_2_STEPS) through exhaustive_match() in order, threading each
# step's remaining sales/credit frames into the next. Returns the list of
# (match_label, resolved_df) pairs (one per step — some may be None if
# that step matched nothing) plus whatever's left over after every step
# has run, for the caller to build an "unmatched" dataset from.
def run_match_pipeline(sales_df, credit_df, base_df,
                       steps: list, stage_path: str,
                       has_year_flag: bool = False):
    resolved_datasets = []
    cur_s, cur_c = sales_df, credit_df

    for match_label, condition_fn in steps:
        resolved, cur_s, cur_c = exhaustive_match(
            cur_s, cur_c, condition_fn, match_label,
            base_df, stage_path=stage_path, has_year_flag=has_year_flag,
        )
        resolved_datasets.append((match_label, resolved))

    return resolved_datasets, cur_s, cur_c

