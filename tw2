    """Write a carrying-value comparison table and return its next available row."""

    formatting = REPORT_CONFIG["formatting"]
    table_layout = layout_config()["comparison_table"]

    # Convert configured numeric columns into Excel letters for formula construction.
    cur_col = get_column_letter(table_layout["current_column"])
    pri_col = get_column_letter(table_layout["prior_column"])
    fluc_amt_col = get_column_letter(
        table_layout["fluctuation_amount_column"]
    )
    fluc_pct_col = get_column_letter(
        table_layout["fluctuation_percent_column"]
    )

    current_period_id = table_cfg["current_period"]
    prior_period_id = table_cfg["prior_period"]

    current_period = period_config(current_period_id)
    prior_period = period_config(prior_period_id)

    current_column = current_period["column"]
    prior_column = prior_period["column"]

    label_key = table_cfg["label_key"]
    current_label = period_label(current_period_id, label_key)
    prior_label = period_label(prior_period_id, label_key)

    title = table_cfg["title"].format(acct_group=acct_group)

    if table_cfg.get("title_already_written") is not True:
