def write_residual_analytic_sheet(
    template,
    residual_df,
    sheet_name=None,
    anchor_cell=RESIDUAL_ANALYTIC_ANCHOR_CELL,
):
    """
    Writes CY and PY accounts in separate columns.

    Common accounts:
        BALANCE SHEET CY | BALANCE SHEET PY
        Cash             | Cash

    CY-only accounts:
        BALANCE SHEET CY | BALANCE SHEET PY
        Inventory        |

    PY-only accounts:
        BALANCE SHEET CY | BALANCE SHEET PY
                         | Investments
    """

    if sheet_name is None:
        sheet_name = _resolve_residual_analytic_sheet(
            template
        )

    residual_rows = residual_df.collect()
    worksheet = template[sheet_name]

    header_row, start_column = coordinate_to_tuple(
        anchor_cell
    )

    label_row = header_row + 1
    first_data_row = header_row + 2

    _clear_existing_table(
        worksheet,
        header_row,
        start_column,
    )

    _clear_conditional_formatting(worksheet)
    worksheet.auto_filter.ref = None

    column_letters = {
        key: get_column_letter(start_column + index)
        for index, key in enumerate(KEYS)
    }

    worksheet.row_dimensions[header_row].height = 42

    # Header row.
    for offset, header in enumerate(
        RESIDUAL_ANALYTIC_HEADERS
    ):
        cell = worksheet.cell(
            row=header_row,
            column=start_column + offset,
            value=header,
        )
        cell.fill = HEADER_FILL
        cell.font = HEADER_FONT
        cell.alignment = HEADER_ALIGN
        cell.border = FULL_BORDER

    # Column widths.
    for key, width in COLUMN_WIDTHS.items():
        worksheet.column_dimensions[
            column_letters[key]
        ].width = width

    # Sub-label row.
    for key in KEYS:
        worksheet[
            f"{column_letters[key]}{label_row}"
        ].fill = WHITE_FILL

    cy_label = worksheet[
        f"{column_letters['cy']}{label_row}"
    ]
    cy_label.value = "Tab 2"
    cy_label.font = RED_BOLD
    cy_label.alignment = CTR_ALIGN

    py_label = worksheet[
        f"{column_letters['py']}{label_row}"
    ]
    py_label.value = "PY Omnia Export Reference"
    py_label.font = RED_BOLD
    py_label.alignment = CTR_ALIGN

    investigate_label = worksheet[
        f"{column_letters['inv1']}{label_row}"
    ]
    investigate_label.value = "{b}"
    investigate_label.font = RED_BOLD
    investigate_label.alignment = CTR_ALIGN

    non_grey_rows = []
    grey_rows = []

    for index, record in enumerate(residual_rows):
        row_number = first_data_row + index

        account_cy = record["Account_CY"]
        account_py = record["Account_PY"]
        cy_greyed = bool(record["CY_Greyed"])

        cy_column = column_letters["cy"]
        py_column = column_letters["py"]
        diff_column = column_letters["diff"]
        pct_column = column_letters["pct"]
        threshold_column = column_letters["thr"]
        investigate_column = column_letters["inv1"]
        tm1_column = column_letters["tm1"]
        tom_column = column_letters["tom"]
        investigate2_column = column_letters["inv2"]
        tm2_column = column_letters["tm2"]

        cy_account_column = column_letters["acct_cy"]
        py_account_column = column_letters["acct_py"]

        # ------------------------------------------------------------------
        # Grey rows
        # ------------------------------------------------------------------

        if cy_greyed:
            grey_rows.append(row_number)

            for key in KEYS:
                worksheet[
                    f"{column_letters[key]}{row_number}"
                ].value = None

            cy_account_cell = worksheet[
                f"{cy_account_column}{row_number}"
            ]
            cy_account_cell.value = account_cy
            _style_data_cell(
                cy_account_cell,
                "acct_cy",
                grey=False,
            )

            py_account_cell = worksheet[
                f"{py_account_column}{row_number}"
            ]
            py_account_cell.value = account_py
            _style_data_cell(
                py_account_cell,
                "acct_py",
                grey=False,
            )

            _style_data_row(
                worksheet,
                row_number,
                column_letters,
                grey=True,
            )

            continue

        # ------------------------------------------------------------------
        # Non-grey rows
        # ------------------------------------------------------------------

        non_grey_rows.append(row_number)

        worksheet[
            f"{cy_account_column}{row_number}"
        ].value = account_cy

        worksheet[
            f"{py_account_column}{row_number}"
        ].value = account_py

        worksheet[
            f"{cy_column}{row_number}"
        ].value = _num(record["Untested_Balance_CY"])

        worksheet[
            f"{py_column}{row_number}"
        ].value = _num(record["Untested_Balance_PY"])

        # Difference ($).
        worksheet[
            f"{diff_column}{row_number}"
        ] = (
            f'=IF(OR({cy_column}{row_number}="",'
            f'{py_column}{row_number}=""),"",{cy_column}{row_number}'
            f'-{py_column}{row_number})'
        )

        # Difference (%).
        worksheet[
            f"{pct_column}{row_number}"
        ] = (
            f'=IF(OR({cy_column}{row_number}="",'
            f'{py_column}{row_number}="",{py_column}{row_number}=0),'
            f'"",{diff_column}{row_number}/{cy_column}{row_number})'
        )

        # Threshold.
        worksheet[
            f"{threshold_column}{row_number}"
        ] = (
            f'=IF({cy_column}{row_number}="","",{THRESHOLD_VALUE})'
        )

        # First Investigate = Yes when absolute difference exceeds threshold.
        worksheet[
            f"{investigate_column}{row_number}"
        ] = (
            f'=IF('
            f'OR({diff_column}{row_number}="",'
            f'{threshold_column}{row_number}="",'
            f'{pct_column}{row_number}=""),'
            f'"",'
            f'IF('
            f'AND(ABS({diff_column}{row_number})>{threshold_column}{row_number},'
            f'ABS({pct_column}{row_number})>{THRESHOLD_PERCENTAGE}),'
            f'"Yes","No"))'
        )

        # First T/M pointer.
        worksheet[
            f"{tm1_column}{row_number}"
        ] = (
            f'=IF('
            f'{investigate_column}{row_number}="Yes",'
            f'"Tab 3b","")'
        )

        # Times of materiality.
        worksheet[
            f"{tom_column}{row_number}"
        ] = (
            f'=IF('
            f'OR({cy_column}{row_number}="",'
            f'{MATERIALITY_CELL}=0,'
            f'{MATERIALITY_CELL}=""),'
            f'"",'
            f'{cy_column}{row_number}/{MATERIALITY_CELL})'
        )

        # Second Investigate = Yes when absolute T/M exceeds 1.
        worksheet[
            f"{investigate2_column}{row_number}"
        ] = (
            f'=IF('
            f'{tom_column}{row_number}="",'
            f'"",'
            f'IF('
            f'ABS({tom_column}{row_number})>1,'
            f'"Yes","No"))'
        )

        # Second T/M pointer.
        worksheet[
            f"{tm2_column}{row_number}"
        ] = (
            f'=IF('
            f'{investigate2_column}{row_number}="Yes",'
            f'"Tab 3a","")'
        )

        _style_data_row(
            worksheet,
            row_number,
            column_letters,
            grey=False,
        )

        _apply_number_formats(
            worksheet,
            row_number,
            column_letters,
        )

    # --------------------------------------------------------------------------
    # Finishing
    # --------------------------------------------------------------------------

    if residual_rows:
        last_data_row = (
            first_data_row
            + len(residual_rows)
            - 1
        )

        _apply_investigate_colors(
            worksheet,
            column_letters,
            non_grey_rows,
        )

        worksheet.auto_filter.ref = (
            f"{column_letters['acct_cy']}{header_row}:"
            f"{column_letters['tm2']}{last_data_row}"
        )
    else:
        last_data_row = first_data_row - 1

    worksheet.freeze_panes = worksheet.cell(
        row=first_data_row,
        column=start_column,
    )

    worksheet.sheet_view.showGridLines = False

    # Force Excel to recalculate formulas when opened.
    try:
        template.calculation.fullCalcOnLoad = True
        template.calculation.forceFullCalc = True
        template.calculation.calcMode = "auto"
    except AttributeError:
        pass

    return {
        "sheet": sheet_name,
        "rows_written": len(residual_rows),
        "greyed_rows": len(grey_rows),
        "formula_rows": len(non_grey_rows),
        "header_row": header_row,
        "label_row": label_row,
        "first_data_row": first_data_row,
        "last_data_row": last_data_row,
        "anchor": anchor_cell,
        "columns": {
            "cy_account": column_letters["acct_cy"],
            "py_account": column_letters["acct_py"],
            "cy_balance": column_letters["cy"],
            "py_balance": column_letters["py"],
        },
    }


