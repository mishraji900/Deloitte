@dataclass
class ComparisonBlock:
    merge_range: str
    dollar_column: str
    percent_column: str
    flag_column: str
    current_role: str
    comparison_role: str
    yes_list_column: str = ""


@dataclass
class SheetConfig:
    sheet_id: str
    output_sheet: str
    subtitle: str
    title_label: str
    total_label: str
    source_key: str
    raw_amount_columns: tuple[str, ...]
    role_to_excel_column: dict[str, str]
    comparison_blocks: tuple[ComparisonBlock, ...]
    legal_entity_sheet_names: dict[tuple[str, str], str]
    materiality_dollar_anchor: str
    materiality_percent_anchor: str
    first_data_row: int
    max_data_column: int
    spacer_columns: set[int]
    tickmark_column: str
    materiality_label_column: str
    materiality_value_column: str
    procedure_merge_range: str
    column_widths: dict[str, int]
    classifier: str
    all_comparison_blocks: tuple[ComparisonBlock, ...] | None = None
    grouping_sheet: str = ""          # sheet name in grouping file: "BS" or "IS"
    header_prefix: str = ""           # e.g. "QTD " / "YTD " in column headers

    def __post_init__(self) -> None:
        # If no separate block list is supplied, use all comparison blocks.
        if self.all_comparison_blocks is None:
            self.all_comparison_blocks = self.comparison_blocks


def block(
    merge_range: str,
    dollar_column: str,
    percent_column: str,
    flag_column: str,
    current_role: str,
    comparison_role: str,
    yes_list_column: str = "",
) -> ComparisonBlock:
    return ComparisonBlock(
        merge_range,
        dollar_column,
        percent_column,
        flag_column,
        current_role,
        comparison_role,
        yes_list_column,
    )


