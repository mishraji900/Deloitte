def write_residual_analytic_sheet(
    template,
    residual_df,
    sheet_name=None,
    anchor_cell=RESIDUAL_ANALYTIC_ANCHOR_CELL,
):
    if sheet_name is None:
        sheet_name = _resolve_residual_analytic_sheet(
            template
        )

    residual_rows = residual_df.collect()
    worksheet = template[sheet_name]

    header_row, start_column = coordinate_to_tuple(
        anchor_cell
    )

    label_row = header_row + 1
    first_data_row = header_row + 2

    _clear_existing_table(
        worksheet=worksheet,
        header_row=header_row,
        start_column=start_column,
    )

    _clear_conditional_formatting(worksheet)
    worksheet.auto_filter.ref = None

    column_letters = {
        key: get_column_letter(
            start_column + index
        )
        for index, key in enumerate(KEYS)
    }

    worksheet.row_dimensions[header_row].height = 42

    for offset, header in enumerate(
        RESIDUAL_ANALYTIC_HEADERS
    ):
        cell = worksheet.cell(
            row=header_row,
            column=start_column + offset,
            value=header,
        )
        cell.fill = HEADER_FILL
        cell.font = HEADER_FONT
        cell.alignment = HEADER_ALIGN
        cell.border = FULL_BORDER

    for key, width in COLUMN_WIDTHS.items():
        worksheet.column_dimensions[
            column_letters[key]
        ].width = width

    for key in KEYS:
        worksheet[
            f"{column_letters[key]}{label_row}"
        ].fill = WHITE_FILL

    cy_label = worksheet[
        f"{column_letters['cy']}{label_row}"
    ]
    cy_label.value = "Tab 2"
    cy_label.font = RED_BOLD
    cy_label.alignment = CTR_ALIGN

    py_label = worksheet[
        f"{column_letters['py']}{label_row}"
    ]
    py_label.value = "PY Omnia Export Reference"
    py_label.font = RED_BOLD
    py_label.alignment = CTR_ALIGN

    investigate_label = worksheet[
        f"{column_letters['inv1']}{label_row}"
    ]
    investigate_label.value = "{b}"
    investigate_label.font = RED_BOLD
    investigate_label.alignment = CTR_ALIGN

    non_grey_rows = []
    grey_rows = []

    for index, record in enumerate(residual_rows):
        row_number = first_data_row + index

        account_cy = record["Account_CY"]
        account_py = record["Account_PY"]

        account = (
            account_cy
            if account_cy is not None
            else account_py
        )

        cy_greyed = bool(record["CY_Greyed"])

        cy_column = column_letters["cy"]
        py_column = column_letters["py"]
        diff_column = column_letters["diff"]
        pct_column = column_letters["pct"]
        threshold_column = column_letters["thr"]
        investigate_column = column_letters["inv1"]
        tm1_column = column_letters["tm1"]
        tom_column = column_letters["tom"]
        investigate2_column = column_letters["inv2"]
        tm2_column = column_letters["tm2"]

        if cy_greyed:
            grey_rows.append(row_number)

            # Clear only CY and calculated fields.
            # Preserve BALANCE SHEET and PY values.
            for key in KEYS:
                worksheet[
                    f"{column_letters[key]}{row_number}"
                ].value = None

            account_cell = worksheet[
                f"{column_letters['acct']}{row_number}"
            ]
            account_cell.value = account
            _style_data_cell(
                cell=account_cell,
                key="acct",
                grey=False,
            )

            py_cell = worksheet[
                f"{py_column}{row_number}"
            ]
            py_cell.value = _num(
                record["Untested_Balance_PY"]
            )
            _style_data_cell(
                cell=py_cell,
                key="py",
                grey=False,
            )
            py_cell.number_format = (
                MONEY_FMT
                if py_cell.value is not None
                else "General"
            )

            for key in (
                "cy",
                "diff",
                "pct",
                "thr",
                "inv1",
                "tm1",
                "tom",
                "inv2",
                "tm2",
