from pyspark.sql import functions as F
from pyspark.sql.window import Window


def add_row_id(df, row_id_col="row_id"):
    """
    WHAT: attach a STABLE, 1-based row_id reflecting the frame's current row order.
          This id is the anchor that links blue-cell coordinates to data rows and
          (later) lines up CY<->PY rows.
    CALLED BY: raw_tb_CY / raw_tb_PY construction (just below).
    OUTPUT FLOW: the row_id column is read by replace_spark_cells and by Sections 2/3/3a.
    """
    if row_id_col in df.columns:
        raise ValueError(f"Column '{row_id_col}' already exists.")
    temp_order_col = "__temporary_row_order__"
    while temp_order_col in df.columns:
