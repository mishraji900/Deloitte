                    cell.font = body_font

                if selected_blue:
                    blue_pairs_skipped_grey.add(blue_key)

                continue

            if is_calculated:
                cell.value = analysis_values.get(column_label)
            else:
                cell.value = record.get(column_label)

                if normalized == _normalise_column_name(
                    percentage_column
                ):
                    cell.value = _to_excel_percentage(cell.value)

            cell.fill = white_fill
            cell.border = body_border
            cell.font = body_font
            cell.alignment = body_alignment

