def _build_manual_alias_map(manual_mapping) -> dict[str, str]:
    """Builds {Account PY → Account CY} alias map from manual_mapping DataFrame."""
    rows = (
        manual_mapping
        .select(
            F.trim(F.col("`Account CY`").cast("string")).alias("acct_cy"),
            F.trim(F.col("`Account PY`").cast("string")).alias("acct_py"),
        )
        .filter(
            F.col("acct_cy").isNotNull() & (F.col("acct_cy") != "") &
            F.col("acct_py").isNotNull() & (F.col("acct_py") != "")
        )
        .distinct()
        .collect()
    )
    # ← _py_account_key used (not _norm) to match the key format used by _build_lookup
    return {
        _py_account_key(row["acct_py"]): _py_account_key(row["acct_cy"])
        for row in rows
        if _py_account_key(row["acct_py"]) != _py_account_key(row["acct_cy"])
    }

def build_residual_join(
    updated_raw_tb_CY,
    updated_raw_tb_PY,
    manual_mapping=None, 
):
    """
    Full-outer-joins CY and PY by normalized account and occurrence number.

    This preserves:
    - common accounts on the same row;
    - CY-only accounts with a blank PY account;
    - PY-only accounts with a blank CY account.
    """

    # ── Step 1: collect rich keys from both sides ──────────────────────
    cy_rich_keys = _collect_account_rich_keys(updated_raw_tb_CY, ACCOUNT_COLUMN)
    py_rich_keys = _collect_account_rich_keys(updated_raw_tb_PY, ACCOUNT_COLUMN)

    # ── Step 2: deterministic alias map ───────────────────────────────
    alias_map = _build_fuzzy_alias_map(
        cy_keys=cy_rich_keys,
        py_keys=py_rich_keys,                        # ← line 1: add optional param
    )
    if manual_mapping is not None:               # ← line 2: build manual map
        alias_map.update(_build_manual_alias_map(manual_mapping))  # ← line 3: extend

    if alias_map:
        print(
            f"[build_residual_join] Auto-detected {len(alias_map)} "
            f"normalized account-name alias(es):"
        )
        for py_k, cy_k in sorted(alias_map.items()):
            print(f"  PY  '{py_k}'  →  CY  '{cy_k}'")
    else:
        print("[build_residual_join] No normalized aliases detected.")

    cy_greyed = (_spark_test_is_not_exact_no(updated_raw_tb_CY, TEST_COLUMN))

    cy_source = (
        _add_account_occurrence_number(
            dataframe=updated_raw_tb_CY,
            account_column=ACCOUNT_COLUMN,
            alias_map=alias_map,
        )
        .select(
            F.col(f"`{ACCOUNT_COLUMN}`").alias("Account_CY"),
            F.col("_account_key"),
            F.col("_account_occurrence"),
            F.col("_row_id").alias("CY_Row_ID"),
            _spark_numeric_or_null(
                UNTESTED_COLUMN
            ).alias("Untested_Balance_CY"),
            cy_greyed.alias("CY_Greyed"),
        )
    )

    py_source = (
        _add_account_occurrence_number(
            dataframe=updated_raw_tb_PY,
            account_column=ACCOUNT_COLUMN,
            alias_map=alias_map,
        )
        .select(
            F.col(f"`{ACCOUNT_COLUMN}`").alias("Account_PY"),
            F.col("_account_key"),
            F.col("_account_occurrence"),
            F.col("_row_id").alias("PY_Row_ID"),
            _spark_numeric_or_null(
                UNTESTED_COLUMN
            ).alias("Untested_Balance_PY"),
        )
    )

    cy = cy_source.alias("cy")
    py = py_source.alias("py")

    join_condition = (
        (F.col("cy._account_key") == F.col("py._account_key"))
        & (
            F.col("cy._account_occurrence")
            == F.col("py._account_occurrence")
        )
    )

    joined = cy.join(
        py,
        join_condition,
        how="full_outer",
    )

    result = joined.select(
        F.col("cy.Account_CY").alias("Account_CY"),
        F.col("cy.Untested_Balance_CY").alias(
            "Untested_Balance_CY"
        ),
        F.col("py.Account_PY").alias("Account_PY"),
        F.col("py.Untested_Balance_PY").alias(
            "Untested_Balance_PY"
        ),
        F.when(
            F.col("cy.Account_CY").isNull(),
            F.lit(True),
        )
        .otherwise(
            F.coalesce(
                F.col("cy.CY_Greyed"),
                F.lit(True),
            )
        )
        .alias("CY_Greyed"),
        F.col("cy.CY_Row_ID").alias("CY_Row_ID"),
        F.col("py.PY_Row_ID").alias("PY_Row_ID"),
        F.coalesce(
            F.col("cy.CY_Row_ID"),
            F.col("py.PY_Row_ID"),
        ).alias("_sort_row_id"),
        F.coalesce(
            F.col("cy._account_occurrence"),
            F.col("py._account_occurrence"),
        ).alias("_sort_occurrence"),
        F.coalesce(
            F.col("cy.Account_CY"),
            F.col("py.Account_PY"),
        ).alias("_sort_account"),
    )

    return (
        result
        .orderBy(
            F.col("_sort_row_id").asc_nulls_last(),
            F.col("_sort_occurrence").asc_nulls_last(),
            F.col("_sort_account").asc_nulls_last(),
        )
        .drop(
            "_sort_row_id",
            "_sort_occurrence",
            "_sort_account",
        )
    )


