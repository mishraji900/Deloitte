# ── Shared utilities ────────────────────────────────────────────────────────

def normalize_field_name(value):
    return re.sub(r"[^a-z0-9]+", " ", str(value).casefold()).strip()


def to_records(data):
    if data is None:
        return []
    if hasattr(data, "collect"):
        return [row.asDict(recursive=True) for row in data.collect()]
    if hasattr(data, "to_dict"):
        return [dict(row) for row in data.to_dict(orient="records")]
    records = []
    for row in data:
        if hasattr(row, "asDict"):
            records.append(row.asDict(recursive=True))
        else:
            records.append(dict(row))
    return records


def add_source_positions(records):
    return [
        {**record, "__source_position__": position}
        for position, record in enumerate(records, start=1)
    ]


def get_value(record, *field_names):
    expected_names = {normalize_field_name(n) for n in field_names}
    for actual_name, value in record.items():
        if normalize_field_name(actual_name) in expected_names:
            return value
    return None


def to_decimal(value):
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, Decimal):
        return value if value.is_finite() else None
    if isinstance(value, (int, float)):
        try:
            numeric_value = float(value)
            if not math.isfinite(numeric_value):
                return None
            return Decimal(str(numeric_value))
        except (TypeError, ValueError, OverflowError):
            return None
    try:
        parsed_helper = globals().get("_to_dec")
        if parsed_helper is not None:
            parsed_value = parsed_helper(value)
            if parsed_value is not None:
                parsed_decimal = Decimal(str(parsed_value))
                if parsed_decimal.is_finite():
                    return parsed_decimal
    except Exception:
        pass
    try:
        text = str(value).strip()
        if text.casefold() in NULL_VALUES:
            return None
        text = (
            text.replace("$", "").replace(",", "").replace("%", "").strip()
        )
        if text.startswith("(") and text.endswith(")"):
            text = "-" + text[1:-1]
        parsed_decimal = Decimal(text)
        return parsed_decimal if parsed_decimal.is_finite() else None
    except (InvalidOperation, TypeError, ValueError):
        return None


def present(value):
    if value is None:
        return False
    return str(value).strip().casefold() not in NULL_VALUES


# ── account_name_key: single normalization function used symmetrically
# for both CY and PY account sets — same rule as _py_account_key in Sheet 3b.
def account_name_key(value):
    if not present(value):
        return None
    text = str(value).casefold().strip()
    text = text.replace("&", " and ")
    text = re.sub(r"\bvalutaion\b", "valuation", text)
    text = re.sub(r"[^a-z0-9]+", " ", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def get_statement_type(record, position, balance_sheet_line_count):
    for field_name in ("__sheet__", "sheet_name", "sheet", "statement", "statement_type"):
        value = get_value(record, field_name)
        if value is None:
            continue
        text = str(value).casefold()
        if "balance" in text:
            return "BS"
        if "income" in text or "statement" in text:
            return "IS"
    source_position = record.get("__source_position__", position)
    try:
        source_position = int(source_position)
    except (TypeError, ValueError):
        source_position = position
    return "BS" if source_position <= balance_sheet_line_count else "IS"


def source_summary(records, label, balance_sheet_line_count):
    summary = {
        "stage": label,
        "bs_count": 0, "bs_consolidated": Decimal("0"), "bs_untested": Decimal("0"),
        "is_count": 0, "is_consolidated": Decimal("0"), "is_untested": Decimal("0"),
    }
    for position, record in enumerate(records, start=1):
        statement = get_statement_type(record, position, balance_sheet_line_count)
        consolidated = to_decimal(
            get_value(record, CONSOLIDATED_COLUMN, "Consolidated Balance", "Consolidated Total")
        ) or Decimal("0")
        untested = to_decimal(
            get_value(record, UNTESTED_COLUMN, "Untested", "Untested Total")
        ) or Decimal("0")
        prefix = "bs" if statement == "BS" else "is"
        summary[f"{prefix}_count"]        += 1
        summary[f"{prefix}_consolidated"] += consolidated
        summary[f"{prefix}_untested"]     += untested
    summary["net_count"]        = summary["bs_count"]        + summary["is_count"]
    summary["net_consolidated"] = summary["bs_consolidated"] + summary["is_consolidated"]
    summary["net_untested"]     = summary["bs_untested"]     + summary["is_untested"]
    return summary


def is_non_grey_cy_record(record):
