def _xl(data_idx):
    return data_idx + COL_ACCOUNT

def _write_banner(ws, row, text, font, border=None, height=18):
    ws.row_dimensions[row].height = height
    c = ws.cell(row=row, column=COL_ACCOUNT, value=text)
    c.font, c.fill, c.border, c.alignment = (
        font, FILL_WHITE, border or BORDER_NONE, ALIGN_CTR
    )
    return c

def _write_note_box(ws):
    ws.row_dimensions[ROW_NOTE_START].height = 40
    for r in range(ROW_NOTE_START + 1, ROW_NOTE_END + 1):
        ws.row_dimensions[r].height = 15
    ws.merge_cells(
        start_row=ROW_NOTE_START, start_column=NOTE_COL_START,
        end_row=ROW_NOTE_END,     end_column=NOTE_COL_END,
    )
    c = ws.cell(row=ROW_NOTE_START, column=NOTE_COL_START,
                value="Note:  Fill The Notes As Required.")
    c.font, c.fill, c.border, c.alignment = (
        FONT_NOTE, FILL_LIGHT_GREY, BORDER_STD, ALIGN_LEFT_TOP
    )

