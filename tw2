        bar_chart = build_bar_chart(
            ws=ws,
            table_ranges=table_ranges,
            bar_cfg=bar_cfg,
        )

        # Offset the chart below its title using the configured number of rows.
        chart_anchor = offset_anchor_rows(
            title_anchor,
            bar_cfg.get("chart_offset_rows", 2),
