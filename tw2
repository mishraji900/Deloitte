S3_SHEET_NAME = "3) IS Tie Out"

def build_sheet3(wb: Workbook, ytd_df, prev_df):
    """
    Creates / overwrites the '3) 10-Q Tie Out Q3' sheet.

    Parameters
    ----------
    wb       – openpyxl Workbook (already contains sheets 1 & 2)
    ytd_df   – TB_03312026
    prev_df  – TB_12312025  (used for QTD = YTD − prior)
    """
    # ── create or replace sheet ───────────────────────────────────────────────
    if S3_SHEET_NAME in wb.sheetnames:
        del wb[S3_SHEET_NAME]
    ws = wb.create_sheet(title=S3_SHEET_NAME)
    ws.sheet_view.showGridLines = False

    # ── column widths ─────────────────────────────────────────────────────────
    col_widths = {
        1: 2,    # A  spacer
        2: 6,    # B  symbol (Σ / Rx / PY)
        3: 18,   # C  grouping code
        4: 48,   # D  references  (wide)
        5: 3,    # E  thin gap
        6: 20,   # F  YTD balance
        7: 16,   # G  YTD rounded   ← green
        8: 20,   # H  QTD balance
        9: 16,   # I  QTD rounded   ← green
    }
    for col_idx, width in col_widths.items():
        ws.column_dimensions[get_column_letter(col_idx)].width = width

    # ── page header rows 1-3 ─────────────────────────────────────────────────
    headers = [
        ("Broadridge Financial Solutions, Inc.", 11, True),
        ("Q3\u201926 10-Q Tie Out",              11, True),
        ("3/31/2026",                            10, False),
    ]
    for r, (text, sz, bold) in enumerate(headers, start=1):
        ws.row_dimensions[r].height = 16
        c = ws.cell(row=r, column=S3_COL_SYMBOL, value=text)
        _s3_apply(c,
                  font=make_font(BLACK, size=sz, bold=bold),
                  fill=FILL_WHITE,
                  border=BORDER_NONE,
                  align=ALIGN_LEFT)

    # ── row 4: thin spacer ────────────────────────────────────────────────────
    ws.row_dimensions[4].height = 6

    # ── row 5: "Introduction and Procedures" band ─────────────────────────────
    # FIX: end_column uses S3_COL_LAST_2 (col 7) not S3_COL_LAST_4 (col 9)
    #      so columns 8-9 are never merged and stay as normal cells.
    ws.row_dimensions[5].height = 16
    ws.merge_cells(
        start_row=5, start_column=S3_COL_SYMBOL,
        end_row=5,   end_column=S3_COL_LAST_2,      # ← FIX 1: was S3_COL_LAST_4
    )
    c = ws.cell(row=5, column=S3_COL_SYMBOL,
                value="Introduction and Procedures")
    _s3_apply(c,
              font=make_font(BLACK, size=10, bold=False),
              fill=FILL_LIGHT_GREY,
              border=BORDER_STD,
              align=ALIGN_LEFT)

    # ── rows 6-7: spacers before first table ──────────────────────────────────
    ws.row_dimensions[6].height = 6
    ws.row_dimensions[7].height = 6

    # ── build lookups ────────────────────────────────────────────────────────
    ytd_lookup, qtd_lookup = _build_lookups(ytd_df, prev_df)

    # ── render every TableDef in order ───────────────────────────────────────
    cur_row = 8
    for table in TABLE_DEFS:
        cur_row = _write_s3_table(
            ws, table, cur_row, ytd_lookup, qtd_lookup
        )

    # ── freeze panes ─────────────────────────────────────────────────────────
    # FIX 2: use a plain string coordinate — never ws.cell() on a merged range.
    # Row 11 = first data row (row 8 title + row 9 header + row 10 tag + row 11 data).
    # Column D (S3_COL_REF = 4) keeps the label column visible while scrolling right.
    ws.freeze_panes = f"{get_column_letter(S3_COL_REF)}11"   # ← FIX 2

    return ws


