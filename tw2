# buckets above (e.g. a row with a valid p4_primary_key but zero
# within-tolerance candidates on the other side at all).
p4_no_match = materialize_df(
    p4_base.join(matched_ids_all, on="row_id", how="left_anti")
           .withColumn("match_type", F.lit("NO_MATCH_FOUND")),
    "P4_no_match", stage_path=STAGE_PATH_P4,
)

# P4_NO_MATCH_FOUND = p4_no_match UNION p4_invalid_pk (rows that couldn't
# even form a p4_primary_key) — both are "this row has no match", just for
# different reasons, and both feed Cell 8's assign_aa_comment() the same
# way as NO_MATCH_FOUND rows.
P4_NO_MATCH_FOUND = materialize_df(
    union_non_null(
        p4_no_match,
        p4_invalid_pk.withColumn("match_type", F.lit("NO_MATCH_FOUND")),
    ),
    "P4_NO_MATCH_FOUND", stage_path=STAGE_PATH_P4,
)
debug_count("P4_NO_MATCH_FOUND", P4_NO_MATCH_FOUND)

print("\n[P4-S8] === PIPELINE 4 AUDIT ===")

# Explicit row-conservation assertion — every p4_input row must land in
