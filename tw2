def _spark_account_is_valid(column_name):
    """
    Returns True for non-null and non-empty account values.
    """

    source = F.col(f"`{column_name}`")
    source_text = _spark_text(column_name)

    return (
        source.isNotNull()
        & (source_text != F.lit(""))
    )


def _spark_numeric_or_null(column_name):
    """
    Cleans and converts balance values to double.
    Blank values and the grey marker become null.
    """

    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))
    source_lower = F.lower(source_text)

    cleaned_text = F.regexp_replace(
        F.regexp_replace(source_text, ",", ""),
        "%",
        "",
    )

    return F.when(
        source.isNull()
        | (source_text == F.lit(""))
        | (source_lower == F.lit(NULL_MARKER)),
        F.lit(None).cast("double"),
    ).otherwise(
        cleaned_text.cast("double")
    )


def _spark_percentage_is_invalid(dataframe, column_name):
    """
    Identifies blank, nonnumeric, or zero percentage values.

    Returns F.lit(False) when the column does not exist in the dataframe
    schema — avoids UNRESOLVED_COLUMN errors when the column is absent.
    """

    actual_columns = [c.lower() for c in dataframe.columns]
    if column_name.lower() not in actual_columns:
        print(
            f"[_spark_percentage_is_invalid] Column '{column_name}' not found "
            f"in schema {dataframe.columns} — defaulting CY_Greyed to False."
        )
        return F.lit(False)

    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))

    cleaned_text = F.regexp_replace(
        F.regexp_replace(source_text, ",", ""),
        "%",
        "",
    )

    numeric_value = cleaned_text.cast("double")

    return (
        source.isNull()
        | (source_text == F.lit(""))
        | numeric_value.isNull()
        | F.isnan(numeric_value)
        | (numeric_value == F.lit(0))
    )


def _spark_test_is_not_exact_no(dataframe, column_name):
    """
    Identifies rows where Test consolidated amount is not exactly 'no'.

    Returns F.lit(False) when the column does not exist in the dataframe
    schema — avoids UNRESOLVED_COLUMN errors when the column is absent.
    """

    actual_columns = [c.lower() for c in dataframe.columns]
    if column_name.lower() not in actual_columns:
        print(
            f"[_spark_test_is_not_exact_no] Column '{column_name}' not found "
            f"in schema {dataframe.columns} — defaulting CY_Greyed to False."
        )
        return F.lit(False)

    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))

    return (
        source.isNull()
        | (F.lower(source_text) != F.lit("no"))
    )


def _find_row_id_column(dataframe):
    """
    Locates row_id without relying on its capitalization.
    """

    for column_name in dataframe.columns:
        if str(column_name).strip().casefold() == ROW_ID_COLUMN:
            return column_name

    raise KeyError(
        f"Required column {ROW_ID_COLUMN!r} was not found. "
        f"Available columns: {dataframe.columns}"
    )


def _add_account_occurrence_number(
    dataframe,
    account_column,
    alias_map,
):
    """
    Numbers repeated account names within each dataset.

    Matching is based on normalized account name plus occurrence number.
    For example, the first CY Cash matches the first PY Cash.
    """

    row_id_column = _find_row_id_column(dataframe)

    source = (
        dataframe
        .filter(
            _spark_account_is_valid(account_column)
        )
        .withColumn(
            "_account_key",
            _spark_account_key_aliased(account_column, alias_map),
        )
        .withColumn(
            "_row_id",
            F.col(f"`{row_id_column}`").cast("long"),
        )
        .withColumn(
            "_source_tiebreaker",
            F.monotonically_increasing_id(),
        )
    )

    occurrence_window = (
        Window
        .partitionBy("_account_key")
        .orderBy(
            F.col("_row_id").asc_nulls_last(),
            F.col("_source_tiebreaker").asc(),
        )
    )

    return source.withColumn(
        "_account_occurrence",
        F.row_number().over(occurrence_window),
    )


