print("PIPELINE 4 - tolerance matching, key = company+vendor")

p4 = (base_tag(P3["unmatched"], PIPE2_RAW_COLUMNS)
      .drop("is_valid_row", "valid_company_desc", "valid_vendor_num")
      .withColumn("p4_primary_key", F.concat_ws("_", F.col("company_desc_clean"), F.col("vendor_num_clean"))))

_s = (p4.filter(F.col("cat_clean") == "SALES INVOICES")
        .select("p4_primary_key", F.col("row_id").alias("sales_row_id"),
                F.col("entered_net_dec").alias("sales_amt"), F.col("eff_dt").alias("sales_eff")))
_c = (p4.filter(F.col("cat_clean") == "CREDIT MEMOS")
        .select("p4_primary_key", F.col("row_id").alias("credit_row_id"),
                F.col("entered_net_dec").alias("credit_amt"), F.col("eff_dt").alias("credit_eff")))

cand = (_s.join(_c, "p4_primary_key")
          .withColumn("net", F.abs(F.col("sales_amt") + F.col("credit_amt")))
          .filter(F.col("net") <= F.lit(P4_TOLERANCE).cast(DECIMAL_TYPE)))

# candidate pairs are distinct, so count(*) over a row's window == its number of candidates
w_s, w_c = Window.partitionBy("sales_row_id"), Window.partitionBy("credit_row_id")
cls = (cand
       .withColumn("otm", (F.count("*").over(w_s) > 1) | (F.count("*").over(w_c) > 1))
       .withColumn("sync", F.col("sales_eff") <= F.col("credit_eff")))  # <= : same-day pair is NOT "credit before sales"

_side = lambda k: cls.select(F.col(k).alias("row_id"), "otm", "sync", "net")
roles = (_side("sales_row_id").unionByName(_side("credit_row_id"))
         .groupBy("row_id")
         .agg(F.max("otm").alias("otm"), F.max("sync").alias("sync"),
              F.min(F.when(~F.col("otm"), F.col("net"))).alias("_pair_net_abs")))

# every p4 row exactly once (left join on deduped roles) -> row conservation by construction
P4_ALL_UNMATCHED = (p4.join(roles, "row_id", "left")
    .withColumn("match_type",
        F.when(F.col("otm"), "ONE_TO_MANY")
         .when(F.col("sync") == True, "ONE_TO_ONE_DATE_SYNC")    # noqa: E712 (Spark column compare)
         .when(F.col("sync") == False, "ONE_TO_ONE_DATE_UNSYNC")  # noqa: E712
