def _spark_text(column_name):
    return F.trim(
        F.col(f"`{column_name}`").cast("string")
    )


def _spark_account_key(column_name):
    return F.regexp_replace(
        F.lower(_spark_text(column_name)),
        r"\s+",
        " ",
    )


def _spark_account_is_valid(column_name):
    source = F.col(f"`{column_name}`")
    source_text = _spark_text(column_name)

    return (
        source.isNotNull()
        & (source_text != F.lit(""))
    )


def _spark_numeric_or_null(column_name):
    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))
    source_lower = F.lower(source_text)

    cleaned_text = F.regexp_replace(
        source_text,
        ",",
        "",
    )

    cleaned_text = F.regexp_replace(
        cleaned_text,
        "%",
        "",
    )

    return F.when(
        source.isNull()
        | (source_text == F.lit(""))
        | (source_lower == F.lit(NULL_MARKER)),
        F.lit(None).cast("double"),
    ).otherwise(
        cleaned_text.cast("double")
    )


def _spark_percentage_is_invalid(column_name):
    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))

    cleaned_text = F.regexp_replace(
        source_text,
        ",",
        "",
    )

    cleaned_text = F.regexp_replace(
        cleaned_text,
        "%",
        "",
    )

    numeric_value = cleaned_text.cast("double")

    return (
        source.isNull()
        | (source_text == F.lit(""))
        | numeric_value.isNull()
        | F.isnan(numeric_value)
        | (numeric_value == F.lit(0))
    )


def _spark_test_is_not_exact_no(column_name):
    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))

    return (
        source.isNull()
        | (F.lower(source_text) != F.lit("no"))
    )


def _find_row_id_column(dataframe):
    for column_name in dataframe.columns:
        if (
            str(column_name).strip().casefold()
            == ROW_ID_COLUMN
        ):
            return column_name

    raise KeyError(
        f"Required column {ROW_ID_COLUMN!r} was not found. "
        f"Available columns: {dataframe.columns}"
    )


def _add_account_occurrence_number(
    dataframe,
    account_column,
):
    """
    Retains every source row without aggregation.

    Repeated balance sheets are numbered separately within
    each dataset using row_id order.
    """
    row_id_column = _find_row_id_column(dataframe)

    source = (
        dataframe
        .filter(
            _spark_account_is_valid(account_column)
        )
        .withColumn(
            "_account_key",
            _spark_account_key(account_column),
        )
        .withColumn(
            "_row_id",
            F.col(
                f"`{row_id_column}`"
            ).cast("long"),
        )
        .withColumn(
            "_source_tiebreaker",
            F.monotonically_increasing_id(),
        )
    )

    occurrence_window = (
        Window
        .partitionBy("_account_key")
        .orderBy(
            F.col("_row_id").asc_nulls_last(),
            F.col("_source_tiebreaker").asc(),
        )
    )

    return source.withColumn(
        "_account_occurrence",
        F.row_number().over(occurrence_window),
    )


# ================================================================
# Build residual join without aggregation
# ================================================================

def build_residual_join(
    updated_raw_tb_CY,
    updated_raw_tb_PY,
):
    cy_greyed = (
        _spark_percentage_is_invalid(
            PERCENTAGE_COLUMN
        )
        | _spark_test_is_not_exact_no(
            TEST_COLUMN
        )
    )

    cy_source = (
        _add_account_occurrence_number(
            dataframe=updated_raw_tb_CY,
            account_column=ACCOUNT_COLUMN,
        )
        .select(
            F.col(
                f"`{ACCOUNT_COLUMN}`"
            ).alias("Account_CY"),
            F.col("_account_key"),
            F.col("_account_occurrence"),
            F.col("_row_id").alias("CY_Row_ID"),
            _spark_numeric_or_null(
                UNTESTED_COLUMN
            ).alias("Untested_Balance_CY"),
            cy_greyed.alias("CY_Greyed"),
        )
    )

    py_source = (
        _add_account_occurrence_number(
            dataframe=updated_raw_tb_PY,
            account_column=ACCOUNT_COLUMN,
        )
        .select(
            F.col(
                f"`{ACCOUNT_COLUMN}`"
            ).alias("Account_PY"),
            F.col("_account_key"),
            F.col("_account_occurrence"),
            F.col("_row_id").alias("PY_Row_ID"),
            _spark_numeric_or_null(
                UNTESTED_COLUMN
            ).alias("Untested_Balance_PY"),
        )
    )

    cy = cy_source.alias("cy")
    py = py_source.alias("py")

    join_condition = (
        (
            F.col("cy._account_key")
            == F.col("py._account_key")
        )
        & (
            F.col("cy._account_occurrence")
            == F.col("py._account_occurrence")
        )
    )

    joined = cy.join(
        py,
        join_condition,
        how="full_outer",
    )

    result = joined.select(
        F.col("cy.Account_CY").alias("Account_CY"),
        F.col(
            "cy.Untested_Balance_CY"
        ).alias("Untested_Balance_CY"),
        F.col("py.Account_PY").alias("Account_PY"),
        F.col(
            "py.Untested_Balance_PY"
        ).alias("Untested_Balance_PY"),
        F.when(
            F.col("cy.Account_CY").isNull(),
            F.lit(True),
        )
        .otherwise(
            F.coalesce(
                F.col("cy.CY_Greyed"),
                F.lit(True),
            )
        )
        .alias("CY_Greyed"),
        F.col("cy.CY_Row_ID").alias("CY_Row_ID"),
        F.col("py.PY_Row_ID").alias("PY_Row_ID"),
        F.coalesce(
            F.col("cy.CY_Row_ID"),
            F.col("py.PY_Row_ID"),
        ).alias("_sort_row_id"),
        F.coalesce(
            F.col("cy._account_occurrence"),
            F.col("py._account_occurrence"),
        ).alias("_sort_occurrence"),
        F.coalesce(
            F.col("cy.Account_CY"),
            F.col("py.Account_PY"),
        ).alias("_sort_account"),
    )

    return (
        result
        .orderBy(
            F.col("_sort_row_id").asc_nulls_last(),
            F.col("_sort_occurrence").asc_nulls_last(),
            F.col("_sort_account").asc_nulls_last(),
        )
        .drop(
            "_sort_row_id",
            "_sort_occurrence",
            "_sort_account",
        )
    )


def _num(value):
    if value is None:
        return None

    if (
        isinstance(value, str)
        and value.strip().casefold() == NULL_MARKER
    ):
        return None

    if isinstance(value, Decimal):
        return float(value)

    return value


