def _get_print_columns(spark_df):
    all_cols   = dataframe_columns(spark_df)
    post_names = {normalize_text(m[0]) for m in POST_COL_META}

    entity_cols = find_entity_columns(
        all_cols,
        anchor=ACCOUNT_COL,
        excludes=[m[0] for m in POST_COL_META] + [ROW_ID_COL],
        row_id_col=ROW_ID_COL,
    )
    last_norm = normalize_text(LAST_ENTITY_COL)
    if last_norm in {normalize_text(c) for c in entity_cols}:
        last_idx    = next(i for i, c in enumerate(entity_cols)
                           if normalize_text(c) == last_norm)
        entity_cols = entity_cols[: last_idx + 1]

    post_cols = [c for c in all_cols if normalize_text(c) in post_names]
    post_cols = sorted(post_cols, key=lambda c: next(
        i for i, m in enumerate(POST_COL_META)
        if normalize_text(m[0]) == normalize_text(c)
    ))
    return entity_cols, post_cols, [ACCOUNT_COL] + entity_cols + post_cols

