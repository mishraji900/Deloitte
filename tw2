# 9-C  Lookup builder
# ══════════════════════════════════════════════════════════════════════════════

def _build_lookups(ytd_df, qtd_prev_df) -> tuple[dict, dict]:
    """
    Returns:
        ytd_lookup  – {grp_code: Decimal}  from TB_03312026
        qtd_lookup  – {grp_code: Decimal}  TB_03312026 minus TB_12312025
    """
    GRP  = "Grouping Code"
    TCOL = "Total Consolidated Balances"

    def _sum_by_code(df) -> dict:
        result: dict[str, Decimal] = {}
        for rec in records_from(df):
            code = str(rec.get(GRP, "")).strip()
            val  = to_decimal(rec.get(TCOL))
            if not code or val is None:
                continue
            result[code] = result.get(code, Decimal(0)) + val
        return result

    ytd_raw  = _sum_by_code(ytd_df)
    prev_raw = _sum_by_code(qtd_prev_df)

    all_codes = set(ytd_raw) | set(prev_raw)
    qtd_lookup = {
        c: ytd_raw.get(c, Decimal(0)) - prev_raw.get(c, Decimal(0))
        for c in all_codes
    }
    return ytd_raw, qtd_lookup


# ══════════════════════════════════════════════════════════════════════════════
# 9-D  Value resolver
# ══════════════════════════════════════════════════════════════════════════════

def _resolve(
    row: RowDef,
    lookup: dict,
    computed: dict,
) -> Decimal | None:
    """
    SIGMA → sum codes from lookup.
    RX / TOTAL → sum rx_terms; each term is a row_key in `computed`
                 or a single grouping code in `lookup`.
    PY / SUBTITLE / BLANK → None (no auto value).
    """
    if row.row_type == SIGMA:
        total = Decimal(0)
        for code in row.codes:
            total += lookup.get(code, Decimal(0))
        return total

    if row.row_type in (RX, TOTAL):
        total = Decimal(0)
        for key, sign in row.rx_terms:
            if key in computed:
                v = computed[key]
            elif key in lookup:
                v = lookup[key]
            else:
                v = Decimal(0)
            total += Decimal(sign) * (v if v is not None else Decimal(0))
        return total

    return None


