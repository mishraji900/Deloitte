def union_non_null(*dfs):
    valid = [d for d in dfs if d is not None]
    if not valid:
        return None
    out = valid[0]
    for d in valid[1:]:
        out = out.unionByName(d, allowMissingColumns=True)
    return out


def to_decimal_clean(col_name: str, precision: int = 38, scale: int = 6):
    c = F.regexp_replace(F.trim(F.col(col_name).cast("string")), ",", "")
    c = F.when(c.rlike(r"^\(.*\)$"), F.concat(F.lit("-"), F.regexp_replace(c, r"[()]", ""))).otherwise(c)
    c = F.when(c == "", None).otherwise(c)
    return c.cast(T.DecimalType(precision, scale))


def month_from_business_column(month_col):
    raw = F.trim(month_col.cast("string"))
    return F.coalesce(
        F.to_date(raw, "dd-MMM-yy"), F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yyyy"),
        F.to_date(raw, "MM/dd/yyyy"), F.to_date(raw, "yyyy-MM-dd"), F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )


def ensure_required_columns(df, required_cols: list):
    for c in required_cols:
        if c not in df.columns:
            df = df.withColumn(c, F.lit(None).cast("string"))
    df = df.withColumn("Company Description",
                       F.coalesce(F.col("Company Description").cast("string"), F.col("Company").cast("string")))
    return df.select(*required_cols)


def base_tag(df, required_cols: list):
    """Conform to schema, derive clean helper columns, primary_key and is_valid_row. row_id is never regenerated."""
    df = ensure_required_columns(df, required_cols)
    return (
        df
        .withColumn("row_id", F.col("row_id").cast("string"))
        .withColumn("invoice_ref_clean", F.trim(F.col("Invoice Reference")))
        .withColumn("cat_clean", F.trim(F.upper(F.col("JE Category"))))
        .withColumn("company_desc_clean", F.trim(F.upper(F.col("Company Description"))))
        .withColumn("vendor_num_clean", F.trim(F.col("Vendor/Customer Number").cast("string")))
        .withColumn("eff_dt", to_date_clean("Default Effective Date"))
        .withColumn("Default Effective Date", F.col("eff_dt"))
        .withColumn("Source Quarter", F.concat(F.lit("Q"), F.quarter(F.col("eff_dt")).cast("string")))
        .withColumn("Year Flag", F.concat(F.lit("FY"), F.date_format(F.col("eff_dt"), "yy")))
        .withColumn("month_dt", month_from_business_column(F.col("Month")))
        .withColumn("entered_net_dec", to_decimal_clean("Net Entered"))
        .withColumn("abs_entered_dec", F.abs(F.col("entered_net_dec")))
        .withColumn("abs_entered_key", F.col("abs_entered_dec").cast("string"))
        .withColumn("valid_company_desc", F.col("company_desc_clean").isNotNull() & (F.col("company_desc_clean") != ""))
        .withColumn("valid_vendor_num", F.col("vendor_num_clean").isNotNull() & (F.col("vendor_num_clean") != ""))
        .withColumn("primary_key", F.when(
            F.col("valid_company_desc") & F.col("valid_vendor_num") & F.col("abs_entered_dec").isNotNull(),
            F.concat_ws("_", F.col("company_desc_clean"), F.col("vendor_num_clean"), F.col("abs_entered_key"))))
        .withColumn("is_valid_row",
                    F.col("row_id").isNotNull() & F.col("entered_net_dec").isNotNull() & F.col("eff_dt").isNotNull()
                    & F.col("month_dt").isNotNull() & F.col("primary_key").isNotNull())
    )


# ---- pairing: one pass, per primary_key group, pure python ----------------------------------
# Rule for every step: sales + credit == 0, sales_eff_dt <= credit_eff_dt, month lag accepted by the step.
# Steps run in order; each step walks ALL candidates sorted by (lag, credit date, ids) and takes a pair
# only if both rows are still free. No second pass needed: freeing rows never creates new candidates.
# ponytail: O(sales x credits) per key; a hot key with thousands of same-amount rows is one slow task.
MATCH_STEPS = [
    ("NEXT_MONTH_EXACT", lambda lag: lag == 1),
    ("SAME_MONTH_EXACT", lambda lag: lag == 0),
    ("LAG_1_2_MONTH", lambda lag: 1 <= lag <= 2),
]
LAG_GT_2_STEPS = [("LAG_GT_2_MONTH", lambda lag: lag > 2)]

PAIR_COLS = ["primary_key", "sales_row_id", "credit_row_id", "match_type", "pair_id", "year_pair_flag"]
PAIR_SCHEMA = ", ".join(f"{c} string" for c in PAIR_COLS)


def make_pairer(steps, cur_fy):
    def pair(pdf):
        import pandas as pd
        S = pdf[pdf["cat"] == "SALES INVOICES"]
        C = pdf[pdf["cat"] == "CREDIT MEMOS"]
        used, out = set(), []
        for label, lag_ok in steps:
            cand = []
            for s in S.itertuples():
                if s.rid in used:
                    continue
                for c in C.itertuples():
                    if c.rid in used or s.amt + c.amt != 0 or s.eff > c.eff:
                        continue
                    lag = (c.mon.year - s.mon.year) * 12 + c.mon.month - s.mon.month
                    if lag_ok(lag):
                        cand.append((lag, c.eff, c.rid, s.eff, s.rid, s.yf, c.yf))
            cand.sort()
            for lag, ceff, crid, seff, srid, syf, cyf in cand:
                if srid in used or crid in used:
                    continue
                used.update((srid, crid))
                flag = (("CY" if syf == cur_fy else "PY") + " Sales Inv with "
                        + ("CY" if cyf == cur_fy else "PY") + " Credit Memo")
                out.append((pdf["primary_key"].iat[0], srid, crid, label, f"{label}_{srid}_{crid}", flag))
        return pd.DataFrame(out, columns=PAIR_COLS)
    return pair


