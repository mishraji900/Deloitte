def data_config() -> dict:
    """Return the central data configuration."""
    return REPORT_CONFIG["data"]


def workbook_config() -> dict:
    """Return workbook paths, sheet names, and template settings."""
    return REPORT_CONFIG["workbook"]


def materiality_config() -> dict:
    """Return configured materiality values and reporting date."""
    return REPORT_CONFIG["materiality"]


def layout_config() -> dict:
    """Return fixed worksheet layout settings."""
    return REPORT_CONFIG["layout"]


def period_config(period_id: str) -> dict:
    """Return configuration for a logical reporting period."""
    periods = REPORT_CONFIG["periods"]

    if period_id not in periods:
        raise KeyError(f"Unknown reporting period key: '{period_id}'.")

    return periods[period_id]


def period_column(period_id: str) -> str:
    """Return the source-data column for a logical reporting period."""
    return period_config(period_id)["column"]


def period_label(period_id: str, label_key: str) -> str:
    """Return the display label for a period and report component."""
    cfg = period_config(period_id)
    labels = cfg.get("labels", {})
    return labels.get(label_key, cfg["column"])


def balance_columns() -> list[str]:
    """Return configured balance columns."""
    return list(data_config()["balance_columns"])


def fluctuation_columns() -> list[str]:
    """Return configured fluctuation columns."""
    return list(data_config()["fluctuation_columns"])


def numeric_columns() -> list[str]:
    """Return all source columns that require numeric conversion."""
    return balance_columns() + fluctuation_columns()


def validate_config() -> None:
    """Validate data, period, table, and chart references before processing."""
    data_cfg = data_config()
    periods = REPORT_CONFIG["periods"]

    for required_key in [
        "account_group_column",
        "group_column",
        "account_column",
        "balance_columns",
        "fluctuation_columns",
    ]:
        if required_key not in data_cfg:
            raise KeyError(f"Missing data configuration: {required_key}")

    for period_id, period in periods.items():
        if not period.get("column"):
            raise ValueError(f"Period '{period_id}' has no source column.")

    all_tables = {
        "sheet1.comparison_table": REPORT_CONFIG["sheet1"]["comparison_table"],
        "sheet1.materiality_multiple": REPORT_CONFIG["sheet1"][
            "materiality_multiple"
        ],
    }

    for table_id, table_cfg in REPORT_CONFIG["sheet2"]["tables"].items():
        all_tables[f"sheet2.{table_id}"] = table_cfg

    all_tables["sheet2.materiality_multiple"] = REPORT_CONFIG["sheet2"][
        "materiality_multiple"
    ]

    for table_name, table_cfg in all_tables.items():
        if "current_period" in table_cfg:
            for key in ["current_period", "prior_period"]:
                period_id = table_cfg[key]

                if period_id not in periods:
                    raise KeyError(
                        f"{table_name} references missing period '{period_id}'."
                    )

        for period_id in table_cfg.get("periods", []):
            if period_id not in periods:
                raise KeyError(
                    f"{table_name} references missing period '{period_id}'."
                )

    chart_cfg = REPORT_CONFIG["sheet2"]["charts"]

    for source in chart_cfg.get("pie", {}).get("sources", []):
        if source["table"] not in REPORT_CONFIG["sheet2"]["tables"]:
            raise KeyError(f"Pie chart references unknown table: {source['table']}")

    for series in chart_cfg.get("bar", {}).get("series", []):
        if series["table"] not in REPORT_CONFIG["sheet2"]["tables"]:
            raise KeyError(f"Bar chart references unknown table: {series['table']}")


