def _clear_existing_table(
    worksheet,
    header_row,
    start_column,
):
    end_column = start_column + len(KEYS) - 1

    for row in worksheet.iter_rows(
        min_row=header_row,
        max_row=worksheet.max_row,
        min_col=start_column,
        max_col=end_column,
    ):
        for cell in row:
            if not isinstance(cell, MergedCell):
                cell.value = None
                cell.fill = WHITE_FILL


def _clear_conditional_formatting(worksheet):
    try:
        worksheet.conditional_formatting._cf_rules.clear()
    except AttributeError:
        pass


def _resolve_residual_analytic_sheet(
    template,
    hint=RESIDUAL_ANALYTIC_SHEET_HINT,
):
    target = hint.strip().casefold()

    matches = [
        sheet_name
        for sheet_name in template.sheetnames
        if target in sheet_name.strip().casefold()
    ]

    if len(matches) == 1:
        return matches[0]

    if len(matches) > 1:
        raise ValueError(
            f"Multiple sheets match {hint!r}: {matches}"
        )

    raise ValueError(
        f"No sheet matching {hint!r}. "
        f"Available: {template.sheetnames}"
    )


def _style_data_cell(
    cell,
    key,
    grey=False,
):
    cell.fill = GREY_FILL if grey else WHITE_FILL
    cell.border = FULL_BORDER

    if grey:
        cell.font = GREY_FONT
    else:
        cell.font = (
            RED_BOLD
            if key in RED_KEYS
            else BLACK_FONT
        )

    if key == "acct":
        cell.alignment = LEFT_ALIGN
    elif key in {"inv1", "tm1", "inv2", "tm2"}:
        cell.alignment = CTR_ALIGN
    else:
        cell.alignment = NUM_ALIGN


def _style_data_row(
