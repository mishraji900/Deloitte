# ── Minimal SheetConfig: only what actually changes per period ────────────────
@dataclass
class SheetConfig:
    dataset:     Any   # Spark / Pandas DataFrame or list[dict]
    as_of_text:  str   # e.g. "As Of Period: 9-26 (3/31/2026)"
                       # sheet_name is auto-derived from this string

    @property
    def sheet_name(self) -> str:
        """
        Extracts the period code from as_of_text and builds the tab label.
        "As Of Period: 9-26 (3/31/2026)"  →  "TB TieOut 9-26"
        "As Of Period: 6-26 (12/31/2025)" →  "TB TieOut 6-26"
        Falls back to the full as_of_text if no period code is found.
        """
        match = re.search(r":\s*([\w\-]+)", self.as_of_text)
        period_code = match.group(1).strip() if match else self.as_of_text
        return f"Trial Balance {period_code}"


