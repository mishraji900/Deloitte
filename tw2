print("\n[STEP 0] Loading source data...")
je_raw = JE_raw


# =============================================================================
# STEP 1 — BASE PREP
# =============================================================================
print("\n[STEP 1] Base prep...")

je_raw = StringtoNum(je_raw, ["USD NET"])
je_raw = StringtoDate(je_raw, "Default Effective Date", "MM/dd/yyyy")
je_raw = ensure_row_id(je_raw)

je_prep = (
    je_raw
    .withColumn("invoice_ref_clean",  F.trim(F.col("Invoice Reference")))
    .withColumn("cat_clean",          F.trim(F.upper(F.col("JE Category"))))
    .withColumn("company_desc_clean", F.trim(F.upper(F.col("Company Description"))))
    .withColumn("vendor_num_clean",   F.trim(F.col("Vendor/Customer Number")))
    .withColumn("eff_dt",             F.col("Default Effective Date"))
    .withColumn("month_dt",           month_from_business_column(F.col("Month")))
    .withColumn("usd_net_dec",        F.col("USD NET").cast("double"))
    .withColumn("abs_usd_net",        F.abs(F.col("usd_net_dec")))
    .withColumn("primary_key",
        F.concat_ws("||",
            F.col("company_desc_clean"),
            F.col("vendor_num_clean")
        )
    )
    .filter(F.col("row_id").isNotNull())
    .filter(F.col("usd_net_dec").isNotNull())
    .filter(F.col("eff_dt").isNotNull())
    .filter(F.col("month_dt").isNotNull())
    .filter(F.col("primary_key").isNotNull() & (F.col("primary_key") != "||"))
    .repartition(NUM_PARTITIONS, "primary_key")
)

je_prep = materialize_df(je_prep, "je_prep", "primary_key")

debug_count("je_prep total rows", je_prep)
debug_group_count(je_prep, "cat_clean", "JE Category distribution")


# =============================================================================
# STEP 2 — SPLIT: BLANK INVOICE REF EXCLUDED
# =============================================================================
print("\n[STEP 2] Splitting on invoice reference...")

DATASET_EXC_1 = je_prep.filter(
    F.col("invoice_ref_clean").isNull() | (F.trim(F.col("invoice_ref_clean")) == "")
)

exact_ref_pool = je_prep.filter(
    F.col("invoice_ref_clean").isNotNull() & (F.trim(F.col("invoice_ref_clean")) != "")
)

DATASET_EXC_1  = materialize_df(DATASET_EXC_1,  "DATASET_EXC_1",  "primary_key")
exact_ref_pool = materialize_df(exact_ref_pool, "exact_ref_pool", "primary_key")

debug_count("DATASET_EXC_1 (blank invoice ref)", DATASET_EXC_1)
debug_count("exact_ref_pool (has invoice ref)",  exact_ref_pool)


# =============================================================================
# STEP 3 — UNIQUE vs DUPLICATE PK
# =============================================================================
print("\n[STEP 3] Counting rows per PK...")

pk_window = Window.partitionBy("primary_key")

je_prep_counted        = je_prep.withColumn("pk_row_count", F.count("*").over(pk_window))
exact_ref_pool_counted = exact_ref_pool.withColumn("pk_row_count", F.count("*").over(pk_window))

# ── Unique PK rows ──────────────────────────────────────────────────────────
unique_pk = je_prep_counted.filter(F.col("pk_row_count") == 1)

DATASET_1_OTHER_UNIQUE_PK            = unique_pk.filter(
    ~F.col("cat_clean").isin("SALES INVOICES", "CREDIT MEMOS")
)
DATASET_2A_UNIQUE_PK_SALES_INVOICES  = unique_pk.filter(F.col("cat_clean") == "SALES INVOICES")
DATASET_2B_UNIQUE_PK_CREDIT_MEMOS    = unique_pk.filter(F.col("cat_clean") == "CREDIT MEMOS")

# ── Duplicate PK — full population (for iterative passes) ──────────────────
duplicate_pk_groups_all = (
    je_prep_counted
    .filter(F.col("pk_row_count") > 1)
    .filter(F.col("cat_clean").isin("SALES INVOICES", "CREDIT MEMOS"))
    .filter(F.col("usd_net_dec") != 0)
)

# ── Duplicate PK — exact-ref population (for exact passes only) ────────────
duplicate_pk_groups_exact = (
    exact_ref_pool_counted
    .filter(F.col("pk_row_count") > 1)
    .filter(F.col("cat_clean").isin("SALES INVOICES", "CREDIT MEMOS"))
    .filter(F.col("usd_net_dec") != 0)
)

DATASET_1_OTHER_UNIQUE_PK           = materialize_df(DATASET_1_OTHER_UNIQUE_PK,           "DATASET_1_OTHER_UNIQUE_PK",           "primary_key")
DATASET_2A_UNIQUE_PK_SALES_INVOICES = materialize_df(DATASET_2A_UNIQUE_PK_SALES_INVOICES,  "DATASET_2A_UNIQUE_PK_SALES_INVOICES",  "primary_key")
DATASET_2B_UNIQUE_PK_CREDIT_MEMOS   = materialize_df(DATASET_2B_UNIQUE_PK_CREDIT_MEMOS,    "DATASET_2B_UNIQUE_PK_CREDIT_MEMOS",    "primary_key")
duplicate_pk_groups_all             = materialize_df(duplicate_pk_groups_all,              "duplicate_pk_groups_all",              "primary_key")
duplicate_pk_groups_exact           = materialize_df(duplicate_pk_groups_exact,            "duplicate_pk_groups_exact",            "primary_key")

debug_count("duplicate_pk_groups_all",   duplicate_pk_groups_all)
debug_count("duplicate_pk_groups_exact", duplicate_pk_groups_exact)


# =============================================================================
# STEP 4 — BUILD SALES & CREDIT SIDE TABLES
# =============================================================================
print("\n[STEP 4] Building sales / credit side tables...")

def make_sales(src_df):
    return (
        src_df
        .filter(F.col("cat_clean") == "SALES INVOICES")
        .select(
            F.col("primary_key"),
            F.col("row_id").alias("sales_row_id"),
            F.col("usd_net_dec").alias("sales_amt"),
            F.col("eff_dt").alias("sales_eff_dt"),
            F.col("month_dt").alias("sales_month"),
            F.col("invoice_ref_clean").alias("sales_ref"),
        )
        .repartition(NUM_PARTITIONS, "primary_key")
    )

def make_credit(src_df):
    return (
        src_df
        .filter(F.col("cat_clean") == "CREDIT MEMOS")
        .select(
            F.col("primary_key"),
            F.col("row_id").alias("credit_row_id"),
            F.col("usd_net_dec").alias("credit_amt"),
            F.col("eff_dt").alias("credit_eff_dt"),
            F.col("month_dt").alias("credit_month"),
            F.col("invoice_ref_clean").alias("credit_ref"),
        )
        .repartition(NUM_PARTITIONS, "primary_key")
    )

sales_all   = materialize_df(make_sales(duplicate_pk_groups_all),   "sales_all",   "primary_key")
credit_all  = materialize_df(make_credit(duplicate_pk_groups_all),  "credit_all",  "primary_key")
sales_exact = materialize_df(
    make_sales(duplicate_pk_groups_exact)
    .filter(F.col("sales_ref").isNotNull() & (F.trim(F.col("sales_ref")) != "")),
    "sales_exact", "primary_key"
)
credit_exact = materialize_df(
    make_credit(duplicate_pk_groups_exact)
    .filter(F.col("credit_ref").isNotNull() & (F.trim(F.col("credit_ref")) != "")),
    "credit_exact", "primary_key"
)

debug_count("sales_all",    sales_all)
debug_count("credit_all",   credit_all)
debug_count("sales_exact",  sales_exact)
debug_count("credit_exact", credit_exact)


# =============================================================================
# STEP 5 — NEXT-MONTH EXACT MATCH  (exhaustive loop)
#
# Conditions : month_lag = 1, eff_dt order respected, amount_diff <= 1
# Loops until no new pairs are found within these conditions.
# =============================================================================
print("\n[STEP 5] Next-month exact match (exhaustive)...")

DATASET_3_1_NEXT_MONTH_MATCHES, rem_sales_exact_1, rem_credit_exact_1 = exhaustive_match(
    sales_exact,
    credit_exact,
    condition_fn=lambda df: df.filter(
        (F.col("month_lag") == 1) &
        (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt")) &
        (F.col("amount_diff") <= 1)
    ),
    match_label="NEXT_MONTH_EXACT",
)

rem_sales_exact_1  = materialize_df(rem_sales_exact_1,  "rem_sales_exact_1",  "primary_key")
rem_credit_exact_1 = materialize_df(rem_credit_exact_1, "rem_credit_exact_1", "primary_key")


# =============================================================================
# STEP 6 — SAME-MONTH EXACT MATCH  (exhaustive loop)
#
# Conditions : month_lag = 0, eff_dt order respected, amount_diff <= 1
# =============================================================================
print("\n[STEP 6] Same-month exact match (exhaustive)...")

DATASET_3_2T_SAME_MONTH_MATCHES, rem_sales_exact_2, rem_credit_exact_2 = exhaustive_match(
    rem_sales_exact_1,
    rem_credit_exact_1,
    condition_fn=lambda df: df.filter(
        (F.col("month_lag") == 0) &
        (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt")) &
        (F.col("amount_diff") <= 1)
    ),
    match_label="SAME_MONTH_EXACT",
)

rem_sales_exact_2  = materialize_df(rem_sales_exact_2,  "rem_sales_exact_2",  "primary_key")
rem_credit_exact_2 = materialize_df(rem_credit_exact_2, "rem_credit_exact_2", "primary_key")


# =============================================================================
# STEP 6B — CARRY EXACT-MATCH RESULTS BACK TO FULL POPULATION
#
# Exact passes ran on the exact_ref sub-population.
# Remove those matched IDs from sales_all / credit_all before iterative passes
# so the same rows are never matched twice.
# =============================================================================
print("\n[STEP 6B] Removing exact-match IDs from full population...")

matched_dfs = [
    df for df in [DATASET_3_1_NEXT_MONTH_MATCHES, DATASET_3_2T_SAME_MONTH_MATCHES]
    if df is not None
]

if matched_dfs:
    exact_s_ids = matched_dfs[0].select("sales_row_id")
    exact_c_ids = matched_dfs[0].select("credit_row_id")
    for df in matched_dfs[1:]:
        exact_s_ids = exact_s_ids.unionByName(df.select("sales_row_id"))
        exact_c_ids = exact_c_ids.unionByName(df.select("credit_row_id"))
    exact_s_ids = exact_s_ids.distinct()
    exact_c_ids = exact_c_ids.distinct()

    sales_for_iter  = sales_all.join(exact_s_ids, on="sales_row_id",  how="left_anti")
    credit_for_iter = credit_all.join(exact_c_ids, on="credit_row_id", how="left_anti")
else:
    sales_for_iter  = sales_all
    credit_for_iter = credit_all

sales_for_iter  = materialize_df(sales_for_iter,  "sales_for_iter",  "primary_key")
credit_for_iter = materialize_df(credit_for_iter, "credit_for_iter", "primary_key")

debug_count("sales_for_iter  (into iterative passes)", sales_for_iter)
debug_count("credit_for_iter (into iterative passes)", credit_for_iter)

# Snapshot of unmatched after exact passes
DATASET_3_2_REMAIN_UNMATCHED_GROUPS = build_unmatched_rows(
    duplicate_pk_groups_all,
    sales_for_iter,
    credit_for_iter,
    "DATASET_3_2_REMAIN_UNMATCHED_GROUPS",
)


# =============================================================================
# STEP 7 — LAG 1-TO-2 MONTH ITERATIVE MATCH  (exhaustive loop)
#
# No amount_diff cap — ranker picks the best pair naturally.
# Conditions : month_lag between 1-2, eff_dt order respected.
# =============================================================================
print("\n[STEP 7] Lag 1-to-2 month iterative match (exhaustive)...")

DATASET_2_1_REMAIN_1, rem_sales_3, rem_credit_3 = exhaustive_match(
    sales_for_iter,
    credit_for_iter,
    condition_fn=lambda df: df.filter(
        (F.col("month_lag").between(1, 2)) &
        (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
        # No amount_diff cap — let the ranker pick the best pair naturally
    ),
    match_label="LAG_1_2_MONTH",
)

rem_sales_3  = materialize_df(rem_sales_3,  "rem_sales_3",  "primary_key")
rem_credit_3 = materialize_df(rem_credit_3, "rem_credit_3", "primary_key")


# =============================================================================
# STEP 8 — SAME-MONTH ITERATIVE MATCH  (exhaustive loop)
#
# No amount_diff cap.
# Conditions : month_lag = 0, eff_dt order respected.
# =============================================================================
print("\n[STEP 8] Same-month iterative match (exhaustive)...")

DATASET_2_2_REMAIN_2T, rem_sales_final, rem_credit_final = exhaustive_match(
    rem_sales_3,
    rem_credit_3,
    condition_fn=lambda df: df.filter(
        (F.col("month_lag") == 0) &
        (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
        # No amount_diff cap
    ),
    match_label="SAME_MONTH_ITERATIVE",
)

rem_sales_final  = materialize_df(rem_sales_final,  "rem_sales_final",  "primary_key")
rem_credit_final = materialize_df(rem_credit_final, "rem_credit_final", "primary_key")


# =============================================================================
