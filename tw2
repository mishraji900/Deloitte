def entity_columns_for_date(columns: list[str], suffix: str) -> list[str]:
    return [
        column for column in columns
        if str(column).endswith(f"_{suffix}")
        and not str(column).startswith(ENTITY_SKIP_PREFIXES)
    ]


def strip_date_suffix(column: str, suffix: str) -> str:
    return column[:-(len(suffix) + 1)].rstrip("_").strip()


def identify_flagged_accounts(
    dataframe: pd.DataFrame,
    display_roles: dict[str, str],
    role_a: str,
    role_b: str,
) -> list[str]:
    current = pd.to_numeric(
        dataframe[display_roles[role_a]], errors="coerce"
    ).fillna(0)
    comparison = pd.to_numeric(
        dataframe[display_roles[role_b]], errors="coerce"
    ).fillna(0)

    dollar_change = current - comparison
    percent_change = dollar_change.div(
        comparison.replace(0, float("nan"))
    ).fillna(0)

    flagged = (
        dollar_change.abs().gt(THRESHOLD_DOLLARS)
        & percent_change.abs().gt(THRESHOLD_PERCENT)
    )
    return dataframe.loc[flagged, ACCOUNT_GROUP_COLUMN].tolist()


def build_legal_entity_dataframe(
    raw_df: pd.DataFrame,
    flagged_accounts: list[str],
    raw_current_column: str,
    raw_comparison_column: str,
) -> pd.DataFrame:
    current_suffix = raw_current_column.split("_")[-1]
    comparison_suffix = raw_comparison_column.split("_")[-1]

    current_entity_columns = entity_columns_for_date(
        list(raw_df.columns), current_suffix
    )
    comparison_entity_columns = entity_columns_for_date(
        list(raw_df.columns), comparison_suffix
    )

    current_labels = {
        strip_date_suffix(column, current_suffix): column
        for column in current_entity_columns
    }
    comparison_labels = {
        strip_date_suffix(column, comparison_suffix): column
        for column in comparison_entity_columns
    }

    entity_labels = sorted(
        set(current_labels) | set(comparison_labels),
        key=str.lower,
    )

    filtered = raw_df[
        raw_df[ACCOUNT_GROUP_COLUMN].isin(flagged_accounts)
    ].copy()

    all_entity_columns = current_entity_columns + comparison_entity_columns
    for column in all_entity_columns:
        if column in filtered.columns:
            filtered[column] = pd.to_numeric(
                filtered[column], errors="coerce"
            ).fillna(0)

    available_columns = [
        column for column in all_entity_columns
        if column in filtered.columns
    ]

    grouped = (
        filtered.groupby(ACCOUNT_GROUP_COLUMN, sort=False)[available_columns]
        .sum()
    )

    rows = []
    for entity in entity_labels:
        row = {"entity_label": entity}
        has_value = False

        for account in flagged_accounts:
            if account not in grouped.index:
                current_value = comparison_value = 0.0
            else:
                current_column = current_labels.get(entity)
                comparison_column = comparison_labels.get(entity)
                current_value = (
                    float(grouped.loc[account, current_column])
                    if current_column in grouped.columns else 0.0
                )
                comparison_value = (
                    float(grouped.loc[account, comparison_column])
                    if comparison_column in grouped.columns else 0.0
                )

            dollar_change = current_value - comparison_value
            percent_change = (
                dollar_change / comparison_value
                if comparison_value != 0 else 0.0
            )

            row[f"{account}__current"] = current_value
            row[f"{account}__comparison"] = comparison_value
            row[f"{account}__dollar"] = dollar_change
            row[f"{account}__percent"] = percent_change

            has_value |= current_value != 0 or comparison_value != 0

        if has_value:
            rows.append(row)

    return pd.DataFrame(rows)


def write_legal_entity_sheet(
    workbook,
    sheet_name: str,
    config: SheetConfig,
    role_a: str,
    role_b: str,
    display_roles: dict[str, str],
    flagged_accounts: list[str],
    legal_entity_df: pd.DataFrame,
) -> None:
    if sheet_name in workbook.sheetnames:
        del workbook[sheet_name]

    worksheet = workbook.create_sheet(title=sheet_name)
    worksheet.sheet_view.showGridLines = False

    if not flagged_accounts or legal_entity_df.empty:
        put(
            worksheet, "B1",
            "No accounts exceeded materiality threshold for this comparison.",
            font=BOLD_FONT,
        )
        return

    date_a = display_roles[role_a]
    date_b = display_roles[role_b]
    account_count = len(flagged_accounts)
    data_count = len(legal_entity_df)

    # Build five columns for every flagged account.
    account_start_columns = []
    cursor = LE_FIRST_DATA_COLUMN

    for index in range(account_count):
        account_start_columns.append(cursor)
        for offset, width in enumerate((14, 14, 14, 11, 12)):
            worksheet.column_dimensions[
                get_column_letter(cursor + offset)
            ].width = width
        cursor += LE_COLUMNS_PER_ACCOUNT

        if index < account_count - 1:
            worksheet.column_dimensions[
                get_column_letter(cursor)
            ].width = LE_SPACER_WIDTH
            cursor += 1

    last_column = cursor - 1
    worksheet.column_dimensions["A"].width = 2
    worksheet.column_dimensions["B"].width = 45

    # Title and threshold details.
    worksheet.merge_cells(
        start_row=LE_TITLE_ROW, start_column=2,
        end_row=LE_TITLE_ROW, end_column=last_column,
    )
    put_rc(
        worksheet, LE_TITLE_ROW, 2,
        f"{config.title_label} â€” Legal Entity Drill-Down",
        font=LE_TITLE_FONT, alignment=LEFT_WRAP,
    )

    worksheet.merge_cells(
        start_row=LE_SUBTITLE_ROW, start_column=2,
        end_row=LE_SUBTITLE_ROW, end_column=last_column,
    )
    put_rc(
        worksheet, LE_SUBTITLE_ROW, 2,
        f"Comparison: {date_a} (Current) vs. {date_b} | "
        f"Flagged accounts: {account_count} | "
        f"Threshold: ${THRESHOLD_DOLLARS:,.0f} and "
        f"{THRESHOLD_PERCENT:.0%}",
        font=NORMAL_FONT, alignment=LEFT_WRAP,
    )

    put_rc(worksheet, 4, 2, "Materiality:", font=BOLD_FONT)
    put_rc(worksheet, 4, 3, MATERIALITY,
           font=BOLD_FONT, number_format=NUMBER_FORMAT)
    put_rc(worksheet, 4, 4, "Threshold ($):", font=BOLD_FONT)
    put_rc(worksheet, 4, 5, THRESHOLD_DOLLARS,
           font=BOLD_FONT, number_format=NUMBER_FORMAT)
    put_rc(worksheet, 4, 6, "Threshold (%):", font=BOLD_FONT)
    put_rc(worksheet, 4, 7, THRESHOLD_PERCENT,
           font=BOLD_FONT, number_format=PERCENT_FORMAT)
    put_rc(
        worksheet, LE_FLAG_COUNT_ROW, 2,
        f"Accounts exceeding threshold: {account_count}",
        font=BOLD_FONT, alignment=LEFT_WRAP,
    )

    # Header rows.
    worksheet.merge_cells(
        start_row=LE_ACCOUNT_HEADER_ROW, start_column=2,
        end_row=LE_SUB_HEADER_ROW, end_column=2,
    )
    put_rc(
        worksheet, LE_ACCOUNT_HEADER_ROW, 2,
        "Legal Entity", font=HEADER_FONT, fill=HEADER_FILL,
        border=THIN_BORDER, alignment=CENTER_WRAP,
    )

    for index, account in enumerate(flagged_accounts):
        start_column = account_start_columns[index]
        end_column = start_column + LE_COLUMNS_PER_ACCOUNT - 1
        worksheet.merge_cells(
            start_row=LE_ACCOUNT_HEADER_ROW,
            start_column=start_column,
            end_row=LE_ACCOUNT_HEADER_ROW,
            end_column=end_column,
        )
        put_rc(
            worksheet, LE_ACCOUNT_HEADER_ROW, start_column,
            account, font=HEADER_FONT, fill=LE_ACCOUNT_FILL,
            border=THIN_BORDER, alignment=CENTER_WRAP,
        )

        for column in range(start_column + 1, end_column + 1):
            worksheet.cell(
                row=LE_ACCOUNT_HEADER_ROW, column=column
            ).fill = LE_ACCOUNT_FILL
            worksheet.cell(
                row=LE_ACCOUNT_HEADER_ROW, column=column
            ).border = THIN_BORDER

        headers = (
            date_a, date_b, "$ Change", "% Change", "Investigate"
        )
        for offset, header in enumerate(headers):
            put_rc(
                worksheet, LE_SUB_HEADER_ROW, start_column + offset,
                header, font=HEADER_FONT, fill=HEADER_FILL,
                border=THIN_BORDER, alignment=CENTER_WRAP,
            )

    # Data rows.
    for row_offset, (_, source_row) in enumerate(
        legal_entity_df.iterrows(), LE_DATA_START_ROW
    ):
        put_rc(
            worksheet, row_offset, 2, source_row["entity_label"],
            font=NORMAL_FONT, border=THIN_BORDER, alignment=LEFT_WRAP,
        )

        for index, account in enumerate(flagged_accounts):
            start_column = account_start_columns[index]
            current = source_row[f"{account}__current"]
            comparison = source_row[f"{account}__comparison"]
            dollar = source_row[f"{account}__dollar"]
            percent = source_row[f"{account}__percent"]

            values = (current, comparison, dollar, percent)
            formats = (
                NUMBER_FORMAT, NUMBER_FORMAT,
                NUMBER_FORMAT, PERCENT_FORMAT,
            )

            for offset, (value, number_format) in enumerate(
                zip(values, formats)
            ):
                put_rc(
                    worksheet, row_offset, start_column + offset,
                    value, font=NORMAL_FONT, border=THIN_BORDER,
                    alignment=RIGHT_ALIGN, number_format=number_format,
                )

            dollar_reference = (
                f"{get_column_letter(start_column + 2)}{row_offset}"
            )
            percent_reference = (
                f"{get_column_letter(start_column + 3)}{row_offset}"
            )
            investigate_formula = (
                f'=IF(AND(ABS({dollar_reference})>'
                f'{LE_DOLLAR_THRESHOLD_CELL},ABS({percent_reference})>'
                f'{LE_PERCENT_THRESHOLD_CELL}),'
                f'"{YES_VALUE}","{NO_VALUE}")'
            )
            put_rc(
                worksheet, row_offset, start_column + 4,
                investigate_formula, font=NORMAL_FONT,
                border=THIN_BORDER, alignment=CENTER_ALIGN,
            )

    total_row = LE_DATA_START_ROW + data_count
    put_rc(
        worksheet, total_row, 2, TOTAL_LABEL,
        font=BOLD_FONT, border=TOTAL_BORDER, alignment=LEFT_WRAP,
    )

    for index in range(account_count):
        start_column = account_start_columns[index]
        for offset in range(LE_COLUMNS_PER_ACCOUNT):
            column = get_column_letter(start_column + offset)
            if offset == 4:
                value = None
                number_format = None
            else:
                value = (
                    f"=SUM({column}{LE_DATA_START_ROW}:{column}{total_row - 1})"
                )
                number_format = PERCENT_FORMAT if offset == 3 else NUMBER_FORMAT

            put_rc(
                worksheet, total_row, start_column + offset,
                value, font=BOLD_FONT, border=TOTAL_BORDER,
                alignment=RIGHT_ALIGN, number_format=number_format,
            )

    # Highlight Investigate cells marked Yes.
    worksheet.conditional_formatting._cf_rules = {}
    for start_column in account_start_columns:
        investigate_column = get_column_letter(start_column + 4)
        for row in range(LE_DATA_START_ROW, total_row):
            reference = f"{investigate_column}{row}"
            rule = FormulaRule(
                formula=[f'{absolute_coordinate(reference)}="{YES_VALUE}"'],
                stopIfTrue=True,
            )
            rule.dxf = YES_FILL
            rule.priority = 1
            worksheet.conditional_formatting.add(reference, rule)

    # worksheet.freeze_panes = worksheet.cell(
    #     row=LE_DATA_START_ROW, column=LE_FIRST_DATA_COLUMN
    # )


def render_legal_entity_sheets(
    workbook,
    config: SheetConfig,
    dataframe: pd.DataFrame,
    display_roles: dict[str, str],
    raw_roles: dict[str, str],
    raw_df: pd.DataFrame,
    comparisons: list[ComparisonBlock],
) -> None:
    for comparison in comparisons:
        sheet_name = config.legal_entity_sheet_names.get(
            (comparison.current_role, comparison.comparison_role)
        )
        if not sheet_name:
            continue

        flagged_accounts = identify_flagged_accounts(
            dataframe,
            display_roles,
            comparison.current_role,
            comparison.comparison_role,
        )

        if flagged_accounts:
            legal_entity_df = build_legal_entity_dataframe(
                raw_df,
                flagged_accounts,
                raw_roles[comparison.current_role],
                raw_roles[comparison.comparison_role],
            )
        else:
            legal_entity_df = pd.DataFrame()

        write_legal_entity_sheet(
            workbook,
            sheet_name,
            config,
            comparison.current_role,
            comparison.comparison_role,
            display_roles,
            flagged_accounts,
            legal_entity_df,
        )





