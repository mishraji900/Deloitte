def _s3_apply(c, value=None, font=None, fill=None,
              border=None, align=None, num_fmt=None):
    if value  is not None: c.value         = value
    if font   is not None: c.font          = font
    if fill   is not None: c.fill          = fill
    if border is not None: c.border        = border
    if align  is not None: c.alignment     = align
    if num_fmt is not None: c.number_format = num_fmt
def _apply_range_border(
    ws,
    start_row: int, start_col: int,
    end_row:   int, end_col:   int,
    style: str = "thin",
    color: str = BLACK,
):
    """
    Apply a full outer-box border to every cell in a merged (or plain) range.

    openpyxl only stores borders on the physical anchor cell of a merge.
    For a range wider than one column we must also write the RIGHT side on
    the last-column cells, the BOTTOM side on the last-row cells, etc.
    This helper visits every cell and assigns only the sides that belong on
    that particular edge, leaving interior sides as None so they don't
    bleed through.
    """
    edge  = Side(style=style, color=color)
    blank = Side(style=None)

    for r in range(start_row, end_row + 1):
        for c in range(start_col, end_col + 1):
            left   = edge  if c == start_col else blank
            right  = edge  if c == end_col   else blank
            top    = edge  if r == start_row else blank
            bottom = edge  if r == end_row   else blank

            # ws.cell() returns the anchor cell even for MergedCell coords
            cell        = ws.cell(row=r, column=c)
            cell.border = Border(
                left=left, right=right, top=top, bottom=bottom
            )


def _apply_range_border_custom(
    ws,
    start_row: int, start_col: int,
    end_row:   int, end_col:   int,
    border: Border,
):
    """
    Stamp an already-built Border object on every cell in the range,
    overwriting whatever was there.  Use this when you need a non-uniform
    border (e.g. medium red box for PY cells).
    """
    for r in range(start_row, end_row + 1):
        for c in range(start_col, end_col + 1):
            ws.cell(row=r, column=c).border = border

def _write_s3_title_banner(ws, row: int, text: str, last_col: int):
    """Merged grey title band spanning S3_COL_SYMBOL → last_col."""
    ws.row_dimensions[row].height = 18

    ws.merge_cells(
        start_row=row, start_column=S3_COL_SYMBOL,
        end_row=row,   end_column=last_col,
    )
    c = ws.cell(row=row, column=S3_COL_SYMBOL, value=text)
    c.font      = make_font(BLACK, size=10, bold=True)
    c.fill      = GREY_TITLE
    c.alignment = ALIGN_CTR

    # FIX Issue 2: stamp border on every cell in the merged range
    _apply_range_border(ws, row, S3_COL_SYMBOL, row, last_col)


def _write_s3_col_headers(ws, row: int, col_variant: str):
    """
    Header row: 'Grouping Code' spans B+C (merged), then References, then
    value columns.  Each cell gets a complete outer border via the range helper.
    """
    ws.row_dimensions[row].height = 30

    def _hdr(start_c, end_c, text, red=False):
        """Write a header cell, merge if start_c != end_c, apply full border."""
        if start_c != end_c:
            ws.merge_cells(
                start_row=row, start_column=start_c,
                end_row=row,   end_column=end_c,
            )
        c = ws.cell(row=row, column=start_c, value=text)
        c.font      = FONT_HDR_RED if red else FONT_HDR_BLACK
        c.fill      = FILL_LIGHT_GREY
        c.alignment = ALIGN_CTR_WRAP
        # FIX Issue 2: border covers the whole merged span
        _apply_range_border(ws, row, start_c, row, end_c)

    # FIX Issue 1: "Grouping Code" merges columns B (S3_COL_SYMBOL=2)
    #              and C (S3_COL_CODE=3)
    _hdr(S3_COL_SYMBOL, S3_COL_CODE, "Grouping Code")
    _hdr(S3_COL_REF,    S3_COL_REF,  "References")
    _hdr(S3_COL_YTD_BAL, S3_COL_YTD_BAL,
         "YTD 3/31/26\nBalances (in millions)")
    _hdr(S3_COL_YTD_RND, S3_COL_YTD_RND,
         "YTD 3/31/26\nRounded (in millions)", red=True)

    if col_variant == "4col":
        _hdr(S3_COL_QTD_BAL, S3_COL_QTD_BAL,
             "QTD 3/31/26\nBalances (in millions)")
        _hdr(S3_COL_QTD_RND, S3_COL_QTD_RND,
             "QTD 3/31/26\nRounded (in millions)", red=True)


