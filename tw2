    ("STATUS",
     ["Period", "Status"]),
]
NAVY, BLUE, BAND = "1F3864", "0070C0", "DDEBF7"            # title bar / header / banded row
ACC = '_($* #,##0.00_);_($* (#,##0.00);_($* "-"??_);_(@_)'
STATUS_FILL = {"PASS": "C6EFCE", "WARN": "FFEB9C", "FAIL": "FFC7CE"}
# ---------------------------------------------

def hold(df):
    """Serverless: no cache/persist. Run plan once, keep result as in-memory df (also freezes row_id)."""
    p = df.toPandas()
    return spark.createDataFrame(p.astype(object).where(p.notna(), None), schema=df.schema)

def bt(c): return F.col("`" + c.replace("`", "``") + "`")
def num(c):   # same cleaning as pipeline ($ stripped), safe cast
    return F.expr("try_cast(regexp_replace(trim(cast(`%s` as string)), '[$]', '') as double)" % c.replace("`", "``"))

def prep(df, s, full):
    """Mirror pipeline: rename/drop -> slim df (A account, I row_id, V net total, B consolidated col)."""
    ex = {}
    if full:                                   # dropped cols that still hold values
        zs = [c for c in s["drop"] if c in df.columns]
        if zs:
            r = df.agg(*[F.sum(num(c)).alias(f"c{i}") for i, c in enumerate(zs)]).first()
            ex["dropped"] = {c: r[i] for i, c in enumerate(zs) if r[i]}
    for a, b in s["rename"].items():
        df = df.withColumnRenamed(a, b)
    df = df.drop(*s["drop"])
    vals = [c for c in df.columns if c not in EXCLUDE]
    if full:                                   # non-empty cells failing numeric parse -> silently 0 in net total
        r = df.agg(*[F.sum(F.when(bt(c).isNotNull() & (F.trim(bt(c).cast("string")) != "") & num(c).isNull(),
                                  1).otherwise(0)).alias(f"c{i}") for i, c in enumerate(vals)]).first()
        ex["bad"] = {c: r[i] for i, c in enumerate(vals) if r[i]}
    net = sum((F.coalesce(num(c), F.lit(0.0)) for c in vals), F.lit(0.0))
    k = df.select(F.col(ACCT).alias("A"), F.col("row_id").alias("I"), net.alias("V"),
                  F.coalesce(num(CONSOL), F.lit(0.0)).alias("B"))
    return hold(k), ex

def det(lab, reason, df, v="V"):
    p = (df.filter(F.col(v) != 0)
           .select(F.col("I").cast("long").alias("RowId"), F.col("A").alias("Account"), F.col(v).alias("Value"))
           .toPandas())
    if len(p):
        p.insert(0, "Reason", reason); p.insert(0, "Period", lab); detail.append(p)

def excel_tb(wb, name):
    """rows + total on a Trial Balance tab (BS + IS tables)."""
    ws, on, col, n, tot = wb[name], False, None, 0, 0.0
    for r in ws.iter_rows(values_only=True):
        b = r[1] if len(r) > 1 else None
        if isinstance(b, str) and b.strip().upper() in ("BALANCE SHEET", "INCOME STATEMENT"):
            h = [str(x).strip() if x is not None else "" for x in r]
            col, on = (h.index(TOT_HDR) if TOT_HDR in h else None), True
            continue
        if on and b not in (None, ""):
            n += 1
            v = r[col] if col is not None and col < len(r) else None
            tot += float(v) if isinstance(v, (int, float)) else 0.0
    return n, tot

# ---------- excel writer: one stacked table per block ----------
def _fill(c): return PatternFill("solid", fgColor=c)

def block(ws, r, title, cols, rows):
    """Title bar + header + banded rows starting at row r. Returns next free row (one blank row gap)."""
    n = len(cols)
    if n > 1:
        ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=n)
    for j in range(1, n + 1):
        ws.cell(r, j).fill = _fill(NAVY)
    ws.cell(r, 1, title).font = Font(bold=True, color="FFFFFF")
    for j, c in enumerate(cols, 1):
        h = ws.cell(r + 1, j, c)
        h.font, h.fill = Font(bold=True, color="FFFFFF"), _fill(BLUE)
        h.alignment = Alignment(horizontal="center", vertical="center")
    for i, row in enumerate(rows):
        for j, c in enumerate(cols, 1):
            v = row.get(c)
            if isinstance(v, np.generic): v = v.item()
            if isinstance(v, float) and v != v: v = None                 # NaN -> blank
            cell = ws.cell(r + 2 + i, j, v)
            if i % 2 == 0: cell.fill = _fill(BAND)
            if isinstance(v, bool): pass
            elif isinstance(v, int) and c != "RowId": cell.number_format = "#,##0"
            elif isinstance(v, float): cell.number_format = ACC
            if c == "Status" and v in STATUS_FILL:
                cell.fill, cell.font = _fill(STATUS_FILL[v]), Font(bold=True)
    return r + len(rows) + 3

def records(pdf):
    return pdf.astype(object).where(pdf.notna(), None).to_dict("records")

nan = float("nan")
LABS = list(SRC)
USED = ({c.strip() for sp in TIEOUT_SHEETS for t in sp.tables for r in t.rows if r.kind == "sigma" for c in r.codes.split("+")}
        | {sp.side.code for sp in TIEOUT_SHEETS if sp.side})          # codes the tie-out tabs actually read

m = hold(read_excel(MAP["path"], sheet_name=[MAP["sheet"]], header=MAP["header"],
                    naming_convention="neutral", trim=True).select(ACCT, CODE))
mcnt = m.filter(F.col(ACCT).isNotNull()).groupBy(ACCT).agg(F.count("*").alias("n"))
mdup = mcnt.filter("n > 1").withColumnRenamed(ACCT, "A")

try:
    xwb = cp.openpyxl.read(TIEOUT_XLSX)
except Exception as e:
    xwb = None; print("Excel read-back failed:", e)

summary, detail, cov = [], [], {}
for lab, s in SRC.items():
    raw = hold(read_excel(s["path"], sheet_name=[s["sheet"]], header=s["header"],
                          naming_convention="neutral", trim=True)
               .withColumn("row_id", F.monotonically_increasing_id()))
    k, ex = prep(raw, s, True)
    ka = F.col("A").isNotNull()
    dt = F.abs(F.col("B") - F.col("V"))
    r = [x or 0 for x in k.agg(
        F.count("*"), F.sum("V"),
        F.sum(F.when(~ka, 1).otherwise(0)), F.sum(F.when(~ka, F.col("V")).otherwise(0.0)),
        F.sum(F.when(ka & (dt > TOL), 1).otherwise(0)), F.sum(F.when(ka, dt).otherwise(0.0))).first()]
    raw_rows, raw_tot, na_rows, na_tot, dt_rows, dt_abs = r
    kept_rows, kept_tot = raw_rows - na_rows, raw_tot - na_tot

    # parquet snapshot vs fresh raw (stale snapshot check)
    try:
        pk, _ = prep(cp.read(s["parquet"]), s, False)
        pr = pk.agg(F.count("*"), F.sum("V")).first(); pq_rows, pq_tot = pr[0], pr[1] or 0.0
    except Exception as e:
        print(f"[{lab}] parquet read failed:", e); pq_rows = pq_tot = nan

    # final df (after mapping join)
    f = hold(s["final"].select(F.col(ACCT).alias("A"), F.col("row_id").alias("I"),
                               F.col(TOT).cast("double").alias("V"), F.col(CODE).alias("C")))
    nocode = F.col("C").isNull() | (F.trim(F.col("C")) == "")
    bs_id = f.filter(F.lower(F.col("A")) == BS_MARKER).agg(F.min("I")).first()[0]
    bs_id = -1 if bs_id is None else bs_id
    pre = F.col("I") < bs_id                                                  # rows above BS marker: not on TB tab
    tab = (F.col("I") > bs_id) & ~F.lower(F.col("A")).isin(BS_MARKER, IS_MARKER)   # rows that land on TB tab
    fr = [x or 0 for x in f.agg(
        F.count("*"), F.sum("V"),
        F.sum(F.when(nocode, 1).otherwise(0)), F.sum(F.when(nocode, F.col("V")).otherwise(0.0)),
        F.sum(F.when(pre, 1).otherwise(0)), F.sum(F.when(pre, F.col("V")).otherwise(0.0)),
        F.sum(F.when(tab, 1).otherwise(0)), F.sum(F.when(tab, F.col("V")).otherwise(0.0))).first()]
    f_rows, f_tot, nc_rows, nc_tot, pre_rows, pre_tot, tab_rows, tab_tot = fr

    # tie-out code coverage
    cc = f.filter(~nocode).groupBy("C").agg(F.sum("V").alias("v")).toPandas().set_index("C")["v"]
    cov[lab] = cc
    un = cc[~cc.index.isin(USED)]
    cfg_missing = len(USED - set(cc.index))

    # mapping diagnostics
    kacc = k.filter(ka).select(F.col("A").alias(ACCT)).distinct()
    fan_accts = mdup.withColumnRenamed("A", ACCT).join(kacc, ACCT, "left_semi").count()
    map_unused = mcnt.select(ACCT).join(kacc, ACCT, "left_anti").count()

    # excel read-back
    ex_rows, ex_tot = (excel_tb(xwb, s["tab"]) if xwb is not None and s["tab"] in xwb.sheetnames else (nan, nan))

    bad = ((not pd.isna(pq_rows) and (pq_rows != raw_rows or abs(pq_tot - raw_tot) > TOL))   # stale parquet
           or f_rows != kept_rows or abs(f_tot - kept_tot) > TOL                              # join fan-out / loss
           or (not pd.isna(ex_rows) and (ex_rows != tab_rows or abs(ex_tot - tab_tot) > TOL)))  # excel != df
    warn = (nc_rows or dt_rows or ex["bad"] or ex.get("dropped") or len(un) or cfg_missing or pre_rows
            or pd.isna(pq_rows) or pd.isna(ex_rows))
    summary.append({
        "Period": lab, "Raw_Rows": int(raw_rows), "Raw_Total": raw_tot,
        "NoAcct_Rows": int(na_rows), "NoAcct_Total": na_tot,
        "Kept_Rows": int(kept_rows), "Kept_Total": kept_tot,
        "Parquet_Rows": pq_rows, "Parquet_Total": pq_tot,
        "Final_Rows": int(f_rows), "Final_Total": f_tot,
        "Diff_Rows": int(f_rows - kept_rows), "Diff_Total": f_tot - kept_tot,
        "Fanout_Map_Accts": fan_accts, "Map_Unused_Accts": map_unused,
        "NoCode_Rows": int(nc_rows), "NoCode_Total": nc_tot,
        "Unused_Code_Count": len(un), "Unused_Code_Total": float(un.sum()), "Config_Codes_Missing": cfg_missing,
        "PreBS_Rows": int(pre_rows), "PreBS_Total": pre_tot,
        "Expected_Excel_Rows": int(tab_rows), "Excel_Rows": ex_rows,
        "Expected_Excel_Total": tab_tot, "Excel_Total": ex_tot, "Diff_Excel_Total": ex_tot - tab_tot,
        "DT_Nonzero_Rows": int(dt_rows), "DT_Abs_Total": dt_abs,
        "Bad_Cells": int(sum(ex["bad"].values())), "Bad_Cols": ", ".join(ex["bad"])[:500],
        "Dropped_Nonzero_Cols": ", ".join(ex.get("dropped", {}))[:500],
        "Status": "FAIL" if bad else ("WARN" if warn else "PASS")})

    det(lab, "NO ACCT - filtered out", k.filter(~ka))
    det(lab, "D&T CHECK <> 0 (consol col - sum of entity cols)",
        k.filter(ka & (dt > TOL)).withColumn("D", F.col("B") - F.col("V")), v="D")
    det(lab, "NO CODE - on TB tab, not in tie-out", f.filter(nocode))
    det(lab, "ABOVE BS MARKER - not on TB tab", f.filter(pre))
    det(lab, "MAP DUP - extra amount counted by join",
        k.filter(ka).join(mdup, "A").withColumn("D", F.col("V") * (F.col("n") - 1)), v="D")

# ---- code coverage frame ----
cov_pd = pd.DataFrame(cov).fillna(0.0)
cov_pd = cov_pd.reindex(cov_pd.index.union(list(USED))).fillna(0.0).sort_index()
if len(LABS) > 1:
    cov_pd[f"QTD_{LABS[0]}"] = cov_pd[LABS[0]] - cov_pd[LABS[1]]
cov_pd["Used_In_TieOut"] = cov_pd.index.isin(USED)
cov_pd = cov_pd.rename_axis("Grouping Code").reset_index()
cov_pd.columns = [str(c) for c in cov_pd.columns]

detail_pd = (pd.concat(detail, ignore_index=True) if detail
             else pd.DataFrame(columns=["Period", "Reason", "RowId", "Account", "Value"]))

# ---- write excel via cp.openpyxl ----
wb = Workbook()

ws = wb.active; ws.title = "Summary"; ws.sheet_view.showGridLines = False
r = 1
for title, cols in TABLES:                       # separate stacked table per entry, same sheet
    r = block(ws, r, title, cols, summary)
ws.column_dimensions["A"].width = 14
for c in "BCDEFGH": ws.column_dimensions[c].width = 24

ws2 = wb.create_sheet("Excluded_Detail"); ws2.sheet_view.showGridLines = False
block(ws2, 1, "EXCLUDED / FLAGGED ROWS", list(detail_pd.columns), records(detail_pd))
for c, w in zip("ABCDE", (12, 50, 14, 45, 22)): ws2.column_dimensions[c].width = w
ws2.freeze_panes = "A3"

ws3 = wb.create_sheet("Code_Coverage"); ws3.sheet_view.showGridLines = False
block(ws3, 1, "GROUPING CODE COVERAGE - used by tie-out tabs?", list(cov_pd.columns), records(cov_pd))
ws3.column_dimensions["A"].width = 16
for j in range(2, len(cov_pd.columns) + 1):
    ws3.column_dimensions[chr(64 + j)].width = 22
ws3.freeze_panes = "A3"

cp.openpyxl.write(wb, VALID_XLSX, register=True)

display(spark.createDataFrame(pd.DataFrame(summary).astype(str)))
