def s3a_build_blue_pair_lookups(spark_column_row_pairs_cy, row_id_col=ROW_ID_COLUMN_NAME):
    """Return (exact, normalized) sets of (column, row_id) blue-cell pairs for fast membership checks."""
    # Build two versions of the blue-cell list so we can match them either way later:
    #  - "exact": the column name as-is (just trimmed)
    #  - "normalized": the cleaned-up (lowercase, no-space) column name
    # Having both means a small difference in capitalisation won't cause a miss.
    exact_pairs = set()
    normalized_pairs = set()
    row_id_key = s3a_normalize(row_id_col)

    for pair in spark_column_row_pairs_cy or []:
        # Each entry should be a (column, row) pair; skip anything that isn't shaped that way.
        try:
            column_name, source_row_id = pair
        except (TypeError, ValueError):
            continue

        # Skip blanks and the row-label column (never a valid blue target).
        if column_name is None:
            continue
        if s3a_normalize(column_name) == row_id_key:
            continue

        # The row number must be a whole number; skip if it can't be read as one.
        try:
            source_row_id = int(source_row_id)
        except (ValueError, TypeError):
            continue

        # Row numbers start at 1.
        if source_row_id < 1:
            continue

        # Save the pair in both forms.
        column_name = str(column_name).strip()
        exact_pairs.add((column_name, source_row_id))
        normalized_pairs.add((s3a_normalize(column_name), source_row_id))

    return exact_pairs, normalized_pairs


def s3a_is_blue_cell(entity_column, source_row_id, blue_exact_pairs, blue_normalized_pairs):
    # Answer the question: "is this particular cell a blue (manual-override) one?"
    # We try the exact-name match first, then fall back to the cleaned-up name match.
    try:
        source_row_id = int(source_row_id)
    except (ValueError, TypeError):
        return False

    return (
        (str(entity_column).strip(), source_row_id) in blue_exact_pairs
        or (s3a_normalize(entity_column), source_row_id) in blue_normalized_pairs
    )


def s3a_build_residual_rows(updated_raw_tb_CY, materiality, row_id_col=ROW_ID_COLUMN_NAME):
    """Accounts qualifying for Sheet 3a: visible (non-zero %, Test == 'No') AND |Untested Balance| > materiality."""
    # Materiality is our comparison yardstick, so it must be a real, non-zero number.
    materiality_value = s3a_to_decimal(materiality)
    if materiality_value in {None, Decimal("0")}:
        raise ValueError("MATERIALITY must be a non-zero number.")

    source_columns = list(updated_raw_tb_CY.columns)
    records = s3a_get_records(updated_raw_tb_CY)

    # Resolve the real names of all the columns we need to read.
    row_id_column = s3a_require_column(source_columns, row_id_col)
    account_column = s3a_require_column(source_columns, ACCOUNT_COLUMN_NAME)
    percentage_column = s3a_require_column(source_columns, PERCENTAGE_COLUMN_NAME)
    test_column = s3a_require_column(source_columns, TEST_COLUMN_NAME)
    untested_column = s3a_require_column(source_columns, UNTESTED_COLUMN_NAME)

    residual_rows = []

    # Go through every row and keep only the accounts that qualify for this sheet.
    for record in records:
        raw_row_id = record.get(row_id_column)
        # The row label must be a valid whole number.
        try:
            source_row_id = int(raw_row_id)
        except (ValueError, TypeError):
            raise ValueError(f"Invalid {row_id_col}: {raw_row_id!r}")

        if source_row_id < 1:
            raise ValueError(f"{row_id_col} must be positive.")

        # Skip rows with no account name.
        account_name = record.get(account_column)
        if s3a_normalize(account_name) == "":
            continue

        # Skip rows whose percentage is missing or zero.
        percentage_value = s3a_to_decimal(record.get(percentage_column))
        if percentage_value in {None, Decimal("0")}:
            continue

        # Keep only rows marked "no" for testing.
        if s3a_normalize(record.get(test_column)) != "no":
            continue

        # Skip rows with no untested balance.
        untested_value = s3a_to_decimal(record.get(untested_column))
        if untested_value is None:
            continue

        # The core test for this sheet: keep the row only if the untested balance is MORE
        # than one times materiality (i.e. big enough to matter). "<= 1" means skip it.
        if abs(untested_value / materiality_value) <= Decimal("1"):
            continue

        # This account qualifies — remember its name, row number, and full data.
        residual_rows.append({
            "Account_CY": account_name,
            "row_id": source_row_id,
            "record": record,
        })

    # Put the qualifying accounts in row-number order for a stable, predictable layout.
    residual_rows.sort(key=lambda row: row["row_id"])
    return residual_rows


def s3a_build_tab2_row_lookup(template):
    """Map normalized account name -> row number in the Tab 2 sheet, for the Total/Difference cross-check."""
    # Build a quick "account name -> which row it's on in Tab 2" directory, so later we can
    # instantly find each account's total on Tab 2 to cross-check against.
    if TAB_2_SHEET not in template.sheetnames:
        raise ValueError(f"Worksheet {TAB_2_SHEET!r} not found. Available: {template.sheetnames}")

    worksheet = template[TAB_2_SHEET]
    lookup = {}

    # Walk down column B, reading the account name on each row. Keep the FIRST row we see for
    # each name (so if a name repeats, the earliest one wins).
    for row_number in range(1, worksheet.max_row + 1):
        account_key = s3a_normalize_account(worksheet.cell(row=row_number, column=2).value)
        if account_key and account_key not in lookup:
            lookup[account_key] = row_number

    return lookup


# ---- Worksheet helpers ----

def s3a_clear_existing_values(worksheet, start_row, start_column, end_row, end_column):
    # Empty out the cells in a rectangle so a re-run starts clean. Leaves merged cells alone
    # (you can't safely blank a merged cell except at its corner).
    for row in worksheet.iter_rows(min_row=start_row, max_row=end_row, min_col=start_column, max_col=end_column):
        for cell in row:
            if not isinstance(cell, MergedCell):
                cell.value = None


def s3a_clear_conditional_formatting(worksheet):
    # Remove any existing colour-rules (the red/green highlighting) so re-runs don't stack up
    # duplicate rules. If the sheet has none, quietly do nothing.
    try:
        worksheet.conditional_formatting._cf_rules.clear()
    except AttributeError:
        pass


def s3a_copy_block_style(worksheet, source_start_row, target_start_row, start_column, end_column, source_max_column):
    """Copy the row-9 template's cell styles down into a fresh 3a block, without touching values."""
    # Each account block should look like the pre-made template block. This copies just the
    # LOOK (styling and row heights) from the template rows down onto the new block's rows,
    # without copying any values.
    for row_offset in range(DATA_ROWS):
        source_row = source_start_row + row_offset
        target_row = target_start_row + row_offset
        # Match the row height too.
        worksheet.row_dimensions[target_row].height = worksheet.row_dimensions[source_row].height

        for column in range(start_column, end_column + 1):
            # If the target is wider than the template, reuse the template's last column style.
            source_cell = worksheet.cell(row=source_row, column=min(column, source_max_column))
            target_cell = worksheet.cell(row=target_row, column=column)

            if not isinstance(target_cell, MergedCell):
                # Copy the style; if the source has none, fall back to the blank default.
                style_args = source_cell._style if source_cell._style is not None else _DEFAULT_STYLE
                target_cell._style = StyleArray(style_args)


def s3a_wipe_spacer_rows(worksheet, spacer_start_row, start_column, end_column):
    # The two blank "spacer" rows between account blocks should be completely plain. This
    # fully resets them: no value, no fill, no border, default font/alignment/format.
    for spacer_row in (spacer_start_row, spacer_start_row + 1):
        for column in range(start_column, end_column + 1):
            cell = worksheet.cell(row=spacer_row, column=column)
            if not isinstance(cell, MergedCell):
                cell.value = None
                cell.fill = _no_fill()
                cell.border = _no_border()
                cell.font = Font()
                cell.alignment = Alignment()
                cell.number_format = "General"


def s3a_apply_all_investigate_colors(worksheet, investigate_coordinates):
    # Add Excel colour-rules to every "Investigate?" cell: turn it green when it says "No"
    # and red when it says anything else. This colouring happens live inside Excel based on
    # the cell's value, rather than being baked in here.
    for coordinate in investigate_coordinates:
        abs_coord = absolute_coordinate(coordinate)

        # Red when the cell is NOT "No". stopIfTrue means once this matches, don't also apply green.
        red_rule = FormulaRule(formula=[f'{abs_coord}<>"No"'], stopIfTrue=True)
        red_rule.dxf = DifferentialStyle(fill=PatternFill(start_color=RED_FILL_COLOR, end_color=RED_FILL_COLOR, fill_type="solid"))
        red_rule.priority = 1

        # Green when the cell IS "No".
        green_rule = FormulaRule(formula=[f'{abs_coord}="No"'], stopIfTrue=True)
        green_rule.dxf = DifferentialStyle(fill=PatternFill(start_color=GREEN_FILL_COLOR, end_color=GREEN_FILL_COLOR, fill_type="solid"))
        green_rule.priority = 2

        worksheet.conditional_formatting.add(coordinate, red_rule)
        worksheet.conditional_formatting.add(coordinate, green_rule)


