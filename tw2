RED_FILL_COLOR = "FFFFCBCB"          # red highlight (used for a "mismatch / attention" result).

_DEFAULT_STYLE = [0] * 9             # a blank style slot layout (nine zeros) used later as a starting point.

# Shared parsing utilities, kept under their original section-local
# names so every call site below is unchanged.
# (Just local nicknames for the shared text/number helpers, so this section reads consistently.)
s3a_normalize = normalize_text
s3a_is_grey_marker = is_grey_marker
s3a_to_decimal = to_decimal


# --- Tiny "style factory" helpers: each returns one ready-made look (font/fill/border/alignment). ---
# They exist so the code below can just call e.g. _blue_font() instead of rebuilding the style each time.

def _black_font():
    return make_font(BLACK)


def _blue_font():
    return make_font(BLUE)


def _header_font():
    # Bold black text for header cells.
    return make_font(BLACK, bold=True)


def _header_align():
    # Header text wraps onto multiple lines if it's long.
    return make_alignment(wrap=True)


def _left_align():
    return make_alignment("left")


def _right_align():
    return make_alignment("right")


def _center_align():
    return make_alignment("center")


def _white_fill():
    return make_fill(WHITE)


def _no_fill():
    # An empty fill = no background colour.
    return PatternFill()


def _green_fill():
    return make_fill(GREEN_FILL_COLOR)


def _red_fill():
    return make_fill(RED_FILL_COLOR)


def _full_border():
    # A full box border in black on all four sides.
    return make_border(BLACK)


def _no_border():
    # No border at all.
    return Border()


def s3a_require_column(source_columns, requested_name):
    # Find a column by name, ignoring capitals/spaces, and return its real name.
    # If it isn't there, stop with a clear error that also lists what columns DO exist.
    requested_key = s3a_normalize(requested_name)
    for column_name in source_columns:
        if s3a_normalize(column_name) == requested_key:
            return column_name
    raise KeyError(
        f"Required dataframe column not found: {requested_name!r}. "
        f"Available columns: {source_columns}"
    )


def s3a_get_records(dataframe):
    # Turn whatever kind of table we're given into a plain list of row dictionaries,
    # so the rest of the code can treat every source the same way.
    # It handles three cases in order:
    if hasattr(dataframe, "collect"):
        #  1) a Spark DataFrame — pull the rows in and convert each to a dict.
        return [row.asDict(recursive=True) for row in dataframe.collect()]
    if hasattr(dataframe, "to_dict"):
        #  2) a pandas DataFrame — ask it directly for a list of row dicts.
        return dataframe.to_dict(orient="records")

    #  3) anything else we can loop over — convert each row as best we can.
    records = []
    for row in dataframe:
        records.append(row.asDict(recursive=True) if hasattr(row, "asDict") else dict(row))
    return records


def s3a_normalize_account(value):
    # Just the standard text clean-up, but named for account values so intent is clear.
    return s3a_normalize(value)


def s3a_get_sheet_materiality(worksheet, fallback_value):
    # Read the materiality figure straight from the sheet's fixed cell (C6).
    # The "$" signs are only there for Excel's absolute-reference style, so strip them
    # to get a normal cell address. If that cell is empty or zero, use the value passed in instead.
    coordinate = MATERIALITY_CELL.replace("$", "")
    sheet_value = s3a_to_decimal(worksheet[coordinate].value)

    if sheet_value in {None, Decimal("0")}:
        return fallback_value
    return sheet_value


def s3a_find_entity_columns(updated_raw_tb_CY, row_id_col=ROW_ID_COLUMN_NAME):
    """Every column after 'Test consolidated amount' that isn't a system/eliminations column."""
    # Same idea as Section 2's entity finder: the individual legal-entity columns live to the
    # RIGHT of "Test consolidated amount". Start just after it and keep everything, except a
    # known list of business/system columns we never want to treat as an entity.
    source_columns = [c for c in updated_raw_tb_CY.columns if s3a_normalize(c) != s3a_normalize(row_id_col)]
    test_column = s3a_require_column(source_columns, TEST_COLUMN_NAME)
    test_index = source_columns.index(test_column)

    # The set of names to leave out: the main business columns plus internal/system ones.
    excluded = {
        s3a_normalize(ACCOUNT_COLUMN_NAME), s3a_normalize(PERCENTAGE_COLUMN_NAME),
        s3a_normalize(TEST_COLUMN_NAME), s3a_normalize(UNTESTED_COLUMN_NAME),
        s3a_normalize(row_id_col), "eliminations", "topside",
        "reclassifications", "__sheet__",
    }

    # Keep only the columns after the test column that aren't in the exclude list.
    entity_columns = [c for c in source_columns[test_index + 1:] if s3a_normalize(c) not in excluded]

    # If we found none, the layout isn't what we expect — stop rather than continue with nothing.
    if not entity_columns:
        raise ValueError(f"No entity/item columns found after {TEST_COLUMN_NAME!r}.")

    return entity_columns


