def s3a_find_entity_columns(
    updated_raw_tb_CY,
    row_id_col=ROW_ID_COLUMN_NAME,
):
    source_columns = [
        column
        for column in updated_raw_tb_CY.columns
        if s3a_normalize(column)
        != s3a_normalize(row_id_col)
    ]

    test_column = s3a_require_column(
        source_columns,
        TEST_COLUMN_NAME,
    )

    test_index = source_columns.index(test_column)

    excluded = {
        s3a_normalize(ACCOUNT_COLUMN_NAME),
        s3a_normalize(PERCENTAGE_COLUMN_NAME),
        s3a_normalize(TEST_COLUMN_NAME),
        s3a_normalize(UNTESTED_COLUMN_NAME),
        s3a_normalize(row_id_col),
        "elimination",
        "eliminations",
        "topside",
        "reclassifications",
        "__sheet__",
    }

    entity_columns = [
        column
        for column in source_columns[test_index + 1:]
        if s3a_normalize(column) not in excluded
    ]

    if not entity_columns:
        raise ValueError(
            f"No entity/item columns found after "
            f"{TEST_COLUMN_NAME!r}."
        )

    return entity_columns


