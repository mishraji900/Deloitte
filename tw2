# ============ VALIDATION: TB TIE-OUT ============
import numpy as np, pandas as pd
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill
from openpyxl.utils import get_column_letter

# ---------- CONFIG ----------
TOL         = 1
VALID_XLSX  = f"{OUTPUT_DIRECTORY}/TB_TieOut_Validation.xlsx"
TIEOUT_XLSX = OUTPUT_FILE
ACCT, CODE, TOT, CONSOL = "Account", "Grouping Code", "Total Consolidated Balances", "BR015"
EXCLUDE     = {"Account", "__sheet__", "row_id", "Grouping Code"}
BS_MARKER, IS_MARKER = "balance sheet", "income statement"
SUBTOTALS   = {"total assets", "total liabilities", "net income", "total equity",
               "total liabilities and equity", "total revenue", "total expenses"}
MAP = dict(path=Mapping_excel_path, sheet="Sheet1", header=0)

SRC = {
    "03312026": dict(path=tb_excel_path, sheet="TB Report - LE Close USD", header=0,
                     rename={"__UNNAMED__0": "Account", "__UNNAMED__123": "Elimination"}, drop=[],
                     parquet=f"{OUTPUT_DIRECTORY}/TB_03312026.parquet",
                     final=TB_03312026, tab="Trial Balance 9-26"),
    "12312025": dict(path=tb_excel_path, sheet="Dec TB Report - LE Close USD", header=0,
                     rename={"__UNNAMED__1": "Account", "__UNNAMED__110": "Elimination"},
                     drop=["__UNNAMED__0", "__UNNAMED__112"],
                     parquet=f"{OUTPUT_DIRECTORY}/TB_12312025.parquet",
                     final=TB_12312025, tab="Trial Balance 6-26"),
}
CY, PY = list(SRC)

USED = ({c.strip() for sp in TIEOUT_SHEETS for t in sp.tables for r in t.rows
         if r.kind == "sigma" for c in r.codes.split("+")}
        | {sp.side.code for sp in TIEOUT_SHEETS if sp.side})

# ---------- HELPERS ----------
def bt(c): return F.col("`" + c.replace("`", "``") + "`")

def num(c):   # mirrors pipeline to_numeric: strip $, trim, safe cast
    return F.expr("try_cast(regexp_replace(trim(cast(`%s` as string)), '[$]', '') as double)"
                  % c.replace("`", "``"))

def slim(df, s, full=False):
    """Raw/parquet -> pandas: A account, I row_id, V = sum of entity cols (BR015 excluded),
    B = BR015. Spark only here; everything after is pandas."""
    bad, dropped = {}, {}
    if full:
        zs = [c for c in s["drop"] if c in df.columns]
        if zs:
            r = df.agg(*[F.sum(F.abs(num(c))).alias(f"c{i}") for i, c in enumerate(zs)]).first()
            dropped = {c: r[i] for i, c in enumerate(zs) if r[i]}
    for a, b in s["rename"].items():
        df = df.withColumnRenamed(a, b)
    df = df.drop(*s["drop"])
    vals = [c for c in df.columns if c not in EXCLUDE and c != CONSOL]       # summed columns
    if full:
        chk = vals + [CONSOL]                                                # parse-check BR015 too
        r = df.agg(*[F.sum(F.when(bt(c).isNotNull() & (F.trim(bt(c).cast("string")) != "")
                                  & num(c).isNull(), 1).otherwise(0)).alias(f"c{i}")
                     for i, c in enumerate(chk)]).first()
        bad = {c: r[i] for i, c in enumerate(chk) if r[i]}
    net = sum((F.coalesce(num(c), F.lit(0.0)) for c in vals), F.lit(0.0))
    return (df.select(F.col(ACCT).alias("A"), F.col("row_id").alias("I"), net.alias("V"),
                      F.coalesce(num(CONSOL), F.lit(0.0)).alias("B")).toPandas(), bad, dropped)

def excel_tb(wb, name):
    """Rows + total on a Trial Balance tab (BS + IS tables), subtotal rows skipped."""
    on, col, n, tot = False, None, 0, 0.0
    for r in wb[name].iter_rows(values_only=True):
        b = r[1] if len(r) > 1 else None
        if isinstance(b, str) and b.strip().upper() in ("BALANCE SHEET", "INCOME STATEMENT"):
            h = [str(x).strip() if x is not None else "" for x in r]
            col, on = (h.index(TOT) if TOT in h else None), True
            continue
        if on and b not in (None, ""):
            if isinstance(b, str) and b.strip().lower() in SUBTOTALS: continue
            n += 1
            v = r[col] if col is not None and col < len(r) else None
            tot += float(v) if isinstance(v, (int, float)) else 0.0
    return n, tot

HDR  = PatternFill("solid", fgColor="1F3864")
FILL = {k: PatternFill("solid", fgColor=v) for k, v in
        {"PASS": "C6EFCE", "WARN": "FFEB9C", "FAIL": "FFC7CE"}.items()}

def put(ws, r, title, df):
    """Title + header + rows at row r. Returns next free row."""
    ws.cell(r, 1, title).font = Font(bold=True, size=11)
    if df.empty:
        ws.cell(r + 1, 1, "none")
        return r + 4
    for j, c in enumerate(df.columns, 1):
        h = ws.cell(r + 1, j, str(c)); h.font = Font(bold=True, color="FFFFFF"); h.fill = HDR
    clean = df.astype(object).where(df.notna(), None)
    for i, row in enumerate(clean.itertuples(index=False), r + 2):
        for j, v in enumerate(row, 1):
            if isinstance(v, np.generic): v = v.item()
            cell = ws.cell(i, j, v)
            if isinstance(v, float): cell.number_format = "#,##0.00;(#,##0.00);-"
            if isinstance(v, str) and v in FILL: cell.fill = FILL[v]
    return r + len(df) + 4

def widths(ws):
    ws.column_dimensions["A"].width = 30
    for j in range(2, 16): ws.column_dimensions[get_column_letter(j)].width = 20

# ---------- MAPPING (once) ----------
m = (read_excel(MAP["path"], sheet_name=[MAP["sheet"]], header=MAP["header"],
                naming_convention="neutral", trim=True).select(ACCT, CODE).toPandas().dropna(subset=[ACCT]))
first_code = lambda s: next((x for x in s if pd.notna(x) and str(x).strip()), None)
mg = (m.groupby(ACCT).agg(n=(CODE, "size"), nd=(CODE, "nunique"), code=(CODE, first_code))
        .reset_index().rename(columns={ACCT: "A"}))      # n = times mapped, code = first non-blank code

try:
    xwb = cp.openpyxl.read(TIEOUT_XLSX)
except Exception as e:
    xwb = None; print("Excel read-back failed:", e)

# ---------- MAIN LOOP ----------
wf, p1a, p1b, p2chk, p2, issues, excl, p4, dts = {}, [], [], [], [], [], [], [], []

for lab, s in SRC.items():
    raw = (read_excel(s["path"], sheet_name=[s["sheet"]], header=s["header"],
                      naming_convention="neutral", trim=True)
           .withColumn("row_id", F.monotonically_increasing_id()))
    k, bad, dropped = slim(raw, s, True)
    try:
        pq = slim(cp.read(s["parquet"]), s)[0]
    except Exception as e:
        pq = None; print(f"[{lab}] parquet read failed:", e)
    f = s["final"].select(F.col(ACCT).alias("A"), F.col("row_id").alias("I"),
                          F.col(TOT).cast("double").alias("V"), F.col(CODE).alias("C"),
                          F.col(CONSOL).cast("double").alias("B")).toPandas()

    # ---- P1: waterfall (raw side; mapping deduped so each raw row counted once)
    k   = k.merge(mg[["A", "n", "nd", "code"]], on="A", how="left")
    na  = k.A.isna()
    nc  = ~na & k.code.isna()
    inc = ~na & k.code.notna()
    nz  = k.V != 0
    cnt = lambda mask: (int(mask.sum()), float(k.V[mask].sum()))
    R, NA, NC, INC = (len(k), float(k.V.sum())), cnt(na), cnt(nc), cnt(inc)
    DIF = (R[0] - NA[0] - NC[0] - INC[0], round(R[1] - NA[1] - NC[1] - INC[1], 2))
    wf[lab] = [R, NA, NC, INC, DIF]

    # ---- P1: final df tie. Final must equal Kept + fanout from duplicate mapping rows
    kk  = k[~na]
    ext = kk.n.fillna(1) - 1
    kept_rows, kept_amt = len(kk), float(kk.V.sum())
    fan_rows,  fan_amt  = int(ext.sum()), float((kk.V * ext).sum())
    fin_rows,  fin_amt  = len(f), float(f.V.sum())
    d_rows, d_amt = fin_rows - kept_rows - fan_rows, round(fin_amt - kept_amt - fan_amt, 2)
    pq_dr = None if pq is None else len(pq) - len(k)
    pq_da = None if pq is None else round(float(pq.V.sum() - k.V.sum()), 2)
    p1a.append({"Period": lab, "Kept_Rows": kept_rows, "Fan_Rows": fan_rows, "Final_Rows": fin_rows,
                "Diff_Rows": d_rows, "Kept_Amt": kept_amt, "Fan_Amt": fan_amt, "Final_Amt": fin_amt,
                "Diff_Amt": d_amt, "Parquet_Rows_Diff": pq_dr, "Parquet_Amt_Diff": pq_da})

    # ---- P1: D&T check. BR015 (source total) vs recomputed entity sum
    dt  = (kk.B - kk.V).round(2)
    off = dt.abs() > TOL
    dt_diff = round(float(kk.B.sum() - kk.V.sum()), 2)
    dts.append({"Period": lab, "BR015_Amt": float(kk.B.sum()), "Total_Amt": float(kk.V.sum()),
                "Diff": dt_diff, "Rows_Off": int(off.sum()),
                "Status": "FAIL" if abs(dt_diff) > TOL else ("WARN" if off.any() else "PASS")})

    # ---- P1: excluded rows (non-zero only)
    ex = pd.concat([k[na & nz].assign(Reason="NO_ACCT"), k[nc & nz].assign(Reason="NO_CODE")])
    excl.append(pd.DataFrame({"Period": lab, "Reason": ex.Reason, "RowId": ex.I, "Account": ex.A, "Value": ex.V}))
    excl.append(pd.DataFrame({"Period": lab, "Reason": "DT_DIFF", "RowId": kk.I[off],
                              "Account": kk.A[off], "Value": dt[off]}))

    # ---- P2: code coverage, raw side vs final side
    code_ok = f.C.notna() & (f.C.astype(str).str.strip() != "")
    rc  = k[inc].groupby("code").V.agg(Rows_Raw="size", Amt_Raw="sum")
    fc  = f[code_ok].groupby("C").V.agg(Rows_Final="size", Amt_Final="sum")
    idx = rc.index.union(fc.index).union(list(USED))
    c = rc.join(fc, how="outer").reindex(idx).fillna(0).rename_axis("Code").reset_index()
    c[["Rows_Raw", "Rows_Final"]] = c[["Rows_Raw", "Rows_Final"]].astype(int)
    c["Used"] = c.Code.isin(USED)
    def flag(r):
        o = []
        if not r.Used and abs(r.Amt_Final) > TOL: o.append("UNUSED")
        if abs(r.Amt_Final - r.Amt_Raw) > TOL:    o.append("FANOUT")
        if r.Used and r.Rows_Final == 0:          o.append("MISSING_IN_DATA")
        return ",".join(o)
    c["Flag"] = c.apply(flag, axis=1)
    c.insert(0, "Period", lab)
    p2.append(c)
    code_diff = round(float(c.Amt_Raw.sum()) - INC[1], 2)
    p2chk.append({"Period": lab, "Sum_Raw_by_Code": float(c.Amt_Raw.sum()),
                  "Included_Amt": INC[1], "Diff": code_diff})

    # ---- P2: mapping issues
    dup = kk[kk.n > 1]
    issues += [
        pd.DataFrame({"Period": lab, "Issue": "DUP_MAP", "Account": dup.A, "Value": dup.V * (dup.n - 1),
                      "Detail": "mapped " + dup.n.astype(int).astype(str) + "x, codes=" + dup.nd.astype(int).astype(str)}),
        pd.DataFrame({"Period": lab, "Issue": "MAP_UNUSED", "Account": mg.A[~mg.A.isin(kk.A)],
                      "Value": None, "Detail": "in mapping, not in TB"}),
    ]

    # ---- P4: excel read-back
    low    = f.A.str.lower()
    mk     = low.isin([BS_MARKER, IS_MARKER])
    has_bs = (low == BS_MARKER).any()
    bs_id  = f.I[low == BS_MARKER].min() if has_bs else None
    pre    = (f.I < bs_id) if has_bs else pd.Series(False, index=f.index)
    tab    = (~mk & (f.I > bs_id)) if has_bs else ~mk
    t_rows, t_amt = int(tab.sum()), float(f.V[tab].sum())
    if xwb is not None and s["tab"] in xwb.sheetnames:
        x_rows, x_amt = excel_tb(xwb, s["tab"])
        xs = "FAIL" if (x_rows != t_rows or abs(x_amt - t_amt) > TOL) else "PASS"
    else:
        x_rows = x_amt = None; xs = "WARN"
    p4.append({"Period": lab, "Tab": s["tab"], "PreBS_Rows": int(pre.sum()), "PreBS_Amt": float(f.V[pre].sum()),
               "DF_Rows": t_rows, "Excel_Rows": x_rows, "DF_Amt": t_amt, "Excel_Amt": x_amt,
               "Diff_Rows": None if x_rows is None else x_rows - t_rows,
               "Diff_Amt": None if x_rows is None else round(x_amt - t_amt, 2), "Status": xs})

    # ---- P1: checks + status
    fail = (DIF[0] != 0 or abs(DIF[1]) > TOL or d_rows != 0 or abs(d_amt) > TOL or fan_rows > 0
            or abs(code_diff) > TOL or (pq is not None and (pq_dr != 0 or abs(pq_da) > TOL))
            or xs == "FAIL" or dts[-1]["Status"] == "FAIL")
    pre_nz = int((f.V[pre] != 0).sum())
    nc_nz  = int((nc & nz).sum())
    warn = bool(nc_nz or bad or dropped or pre_nz or pq is None or xs == "WARN"
                or dts[-1]["Status"] == "WARN"
                or c.Flag.str.contains("UNUSED|MISSING").any())
    p1b.append({"Period": lab, "Bad_Cells": int(sum(bad.values())), "Bad_Cols": ", ".join(bad),
                "Dropped_NonZero_Cols": ", ".join(dropped), "NoCode_NonZero_Rows": nc_nz,
                "PreBS_NonZero_Rows": pre_nz, "Fanout_Rows": fan_rows,
                "Unused_Codes": int(c.Flag.str.contains("UNUSED").sum()),
                "Missing_Codes": int(c.Flag.str.contains("MISSING").sum()),
                "DT_Check": dts[-1]["Status"], "Excel_Check": xs,
                "Status": "FAIL" if fail else ("WARN" if warn else "PASS")})

# ---------- P1 waterfall table ----------
wf_pd = pd.DataFrame({"Step": ["Raw", "Filtered - no Account", "No Grouping Code", "Included", "Diff (must be 0)"]})
for lab, v in wf.items():
    wf_pd[f"{lab}_Rows"] = [x[0] for x in v]
    wf_pd[f"{lab}_Amt"]  = [x[1] for x in v]

# ---------- P3: QTD by grouping code ----------
codes_pd = pd.concat(p2, ignore_index=True)
a, b = [codes_pd[codes_pd.Period == x].set_index("Code") for x in (CY, PY)]
q = pd.DataFrame(index=a.index.union(b.index))
for nm, d in (("CY", a), ("PY", b)):
    q[f"{nm}_Rows"], q[f"{nm}_Amt"], q[f"{nm}_Raw"] = d.Rows_Final, d.Amt_Final, d.Amt_Raw
q = q.fillna(0)
q["QTD"], q["QTD_Raw"] = q.CY_Amt - q.PY_Amt, q.CY_Raw - q.PY_Raw
q["Diff"] = (q.QTD - q.QTD_Raw).round(2)
q["Used"] = q.index.isin(USED)
q = q.rename_axis("Code").reset_index()
def qflag(r):
    o = []
    if not r.Used and abs(r.CY_Amt) + abs(r.PY_Amt) > TOL: o.append("UNUSED")
    if r.CY_Rows == 0 and r.PY_Rows == 0:                  o.append("MISSING_IN_DATA")
    elif r.CY_Rows == 0 or r.PY_Rows == 0:                 o.append("ONE_SIDED")
    if abs(r.Diff) > TOL:                                  o.append("FANOUT")
    return ",".join(o)
q["Flag"] = q.apply(qflag, axis=1)
q = q[["Code", "Used", "CY_Rows", "PY_Rows", "CY_Amt", "PY_Amt", "QTD", "QTD_Raw", "Diff", "Flag"]]

chk = pd.DataFrame([
    {"Check": "Sum QTD_Raw by code vs P1 Included (CY - PY)",
     "Value": q.QTD_Raw.sum(), "Expected": wf[CY][3][1] - wf[PY][3][1]},
    {"Check": "Sum QTD (final df) vs QTD_Raw  [non-zero = mapping fanout]",
     "Value": q.QTD.sum(), "Expected": q.QTD_Raw.sum()},
    {"Check": "INFO: QTD of rows with no code (outside tie-out)",
     "Value": wf[CY][2][1] - wf[PY][2][1], "Expected": None},
])
chk["Diff"]   = (chk.Value - chk.Expected).round(2)
chk["Status"] = np.where(chk.Expected.isna(), "INFO", np.where(chk.Diff.abs() <= TOL, "PASS", "FAIL"))

# ---------- WRITE ----------
wb = Workbook()
ws = wb.active; ws.title = "P1_YTD"; ws.sheet_view.showGridLines = False
r = put(ws, 1, "1. YTD WATERFALL - raw -> filtered -> no code -> included (Diff must be 0)", wf_pd)
r = put(ws, r, "2. FINAL DF TIE - Final = Kept + mapping fanout (Diff must be 0)", pd.DataFrame(p1a))
r = put(ws, r, "3. D&T CHECK - BR015 vs Total Consolidated Balances (Diff must be 0)", pd.DataFrame(dts))
r = put(ws, r, "4. CHECKS + STATUS", pd.DataFrame(p1b))
put(ws, r, "5. EXCLUDED ROWS (non-zero only, incl. DT_DIFF)", pd.concat(excl, ignore_index=True))
widths(ws)

ws = wb.create_sheet("P2_Codes"); ws.sheet_view.showGridLines = False
r = put(ws, 1, "1. SUM BY CODE vs INCLUDED (Diff must be 0)", pd.DataFrame(p2chk))
r = put(ws, r, "2. CODE COVERAGE per period",
        codes_pd[["Period", "Code", "Used", "Rows_Raw", "Amt_Raw", "Rows_Final", "Amt_Final", "Flag"]]
        .sort_values(["Period", "Code"]))
put(ws, r, "3. MAPPING ISSUES", pd.concat(issues, ignore_index=True))
widths(ws)

ws = wb.create_sheet("P3_QTD_Codes"); ws.sheet_view.showGridLines = False
r = put(ws, 1, f"1. QTD BY GROUPING CODE  (QTD = {CY} - {PY})", q)
put(ws, r, "2. QTD CHECKS", chk)
widths(ws)

ws = wb.create_sheet("P4_Excel"); ws.sheet_view.showGridLines = False
put(ws, 1, "TB TAB READ-BACK - Excel vs final DataFrame", pd.DataFrame(p4))
widths(ws)

cp.openpyxl.write(wb, VALID_XLSX, register=True)

print(pd.DataFrame(p1b)[["Period", "DT_Check", "Excel_Check", "Status"]].to_string(index=False))
