def clean_df(df):
    """
    The function performs the following operations on the DataFrame:
    1) Replace dot (.) with underscore (_) in all field names
    2) Removes the leading and trailing spaces from all field names
    3) Removes the leading and trailing spaces from all field values
    """
    new_columns = [
        F.trim(F.expr(f"`{c}`")).alias(c.replace(".", "_").strip()) for c in df.columns
    ]
    return df.select(new_columns)

