def write_comparison_table(
    ws,
    row: int,
    group_totals: dict,
    table_cfg: dict,
    acct_group: str,
) -> tuple[int, int, int]:
    """Write a carrying-value comparison table and return its next available row."""

    formatting = REPORT_CONFIG["formatting"]
    table_layout = layout_config()["comparison_table"]

    # Convert configured numeric columns into Excel letters for formula construction.
    cur_col = get_column_letter(table_layout["current_column"])
    pri_col = get_column_letter(table_layout["prior_column"])
    fluc_amt_col = get_column_letter(
        table_layout["fluctuation_amount_column"]
    )
    fluc_pct_col = get_column_letter(
        table_layout["fluctuation_percent_column"]
    )

    current_period_id = table_cfg["current_period"]
    prior_period_id = table_cfg["prior_period"]

    current_period = period_config(current_period_id)
    prior_period = period_config(prior_period_id)

    current_column = current_period["column"]
    prior_column = prior_period["column"]

    label_key = table_cfg["label_key"]
    current_label = period_label(current_period_id, label_key)
    prior_label = period_label(prior_period_id, label_key)

    title = table_cfg["title"].format(acct_group=acct_group)

    if table_cfg.get("title_already_written") is not True:
        write_cell(
            ws,
            row,
            table_layout["label_column"],
            title,
            font=BOLD_ITALIC,
            align=LEFT,
        )

        row += 2

    write_cell(
        ws,
        row,
        table_layout["label_column"],
        None,
        border=MED_BOX,
    )

    write_merged_box(
        ws,
        row,
        table_layout["carrying_value_start_column"],
        row,
        table_layout["carrying_value_end_column"],
        "Carrying Value",
        font=BOLD,
        border=MED_BOX,
        align=CENTER,
    )

    write_merged_box(
        ws,
        row,
        table_layout["fluctuation_start_column"],
        row,
        table_layout["fluctuation_end_column"],
        "Fluctuation",
        font=BOLD,
        border=MED_BOX,
        align=CENTER,
    )

    row += 1

    headers = [
        table_cfg["row_label"],
        current_label,
        prior_label,
        "$",
        "%",
    ]

    header_columns = [
        table_layout["label_column"],
        table_layout["current_column"],
        table_layout["prior_column"],
        table_layout["fluctuation_amount_column"],
        table_layout["fluctuation_percent_column"],
    ]

    for column, header in zip(header_columns, headers):
        write_cell(
            ws,
            row,
            column,
            header,
            font=HDR_FONT,
            border=THIN_ALL,
            align=LEFT if column == table_layout["label_column"] else CENTER,
        )

    row += 1
    group_row_start = row

    for group_name, totals in group_totals.items():
        # Convert source values from dollars to millions for display.
        current_value = totals.get(current_column, 0.0) / 1e6
        prior_value = totals.get(prior_column, 0.0) / 1e6

        write_cell(
            ws,
            row,
            table_layout["label_column"],
            group_name,
            font=NORMAL,
            border=THIN_ALL,
            align=LEFT,
        )

        write_cell(
            ws,
            row,
            table_layout["current_column"],
            current_value,
            font=NORMAL,
            border=THIN_ALL,
            fmt=formatting["million_format"],
            align=RIGHT,
        )

        write_cell(
            ws,
            row,
            table_layout["prior_column"],
            prior_value,
            font=NORMAL,
            border=THIN_ALL,
            fmt=formatting["million_format"],
            align=RIGHT,
        )

        # Calculate dollar fluctuation as current carrying value minus prior carrying value.
        write_cell(
            ws,
            row,
            table_layout["fluctuation_amount_column"],
            f"={cur_col}{row}-{pri_col}{row}",
            font=NORMAL,
            border=THIN_ALL,
            fmt=formatting["million_format"],
            align=RIGHT,
        )

        # Calculate percentage fluctuation as dollar fluctuation divided by prior value.
        write_cell(
            ws,
            row,
            table_layout["fluctuation_percent_column"],
            f'=IFERROR({fluc_amt_col}{row}/{pri_col}{row},"")',
            font=NORMAL,
            border=THIN_ALL,
            fmt=formatting["percent_format"],
            align=RIGHT,
        )

        row += 1

    group_row_end = row - 1
    total_acct_group_row = row

    write_cell(
        ws,
        row,
        table_layout["label_column"],
        f"      Total {acct_group}",
        font=BOLD,
        border=THIN_ALL,
        align=LEFT,
    )

    # Sum the group-level current values to calculate the account-group total.
    write_cell(
        ws,
        row,
        table_layout["current_column"],
        f"=SUM({cur_col}{group_row_start}:{cur_col}{group_row_end})",
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["million_format"],
        align=RIGHT,
    )

    # Sum the group-level prior values to calculate the account-group total.
    write_cell(
        ws,
        row,
        table_layout["prior_column"],
        f"=SUM({pri_col}{group_row_start}:{pri_col}{group_row_end})",
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["million_format"],
        align=RIGHT,
    )

    # Calculate total-dollar fluctuation from the total current and prior values.
    write_cell(
        ws,
        row,
        table_layout["fluctuation_amount_column"],
        f"={cur_col}{row}-{pri_col}{row}",
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["million_format"],
        align=RIGHT,
    )

    # Calculate total percentage fluctuation using the total prior value as denominator.
    write_cell(
        ws,
        row,
        table_layout["fluctuation_percent_column"],
        f'=IFERROR({fluc_amt_col}{row}/{pri_col}{row},"")',
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["percent_two_decimal_format"],
        align=RIGHT,
    )

    row += 1
    total_row = row

    write_cell(
        ws,
        row,
        table_layout["label_column"],
        "Total",
        font=BOLD,
        border=THIN_ALL,
        align=LEFT,
    )

    write_cell(
        ws,
        row,
        table_layout["current_column"],
        None,
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["million_format"],
        align=RIGHT,
    )

    write_cell(
        ws,
        row,
        table_layout["prior_column"],
        None,
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["million_format"],
        align=RIGHT,
    )

    # Calculate the total-row dollar fluctuation after the user enters current and prior values.
    write_cell(
        ws,
        row,
        table_layout["fluctuation_amount_column"],
        f'=IFERROR({cur_col}{row}-{pri_col}{row},"")',
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["million_format"],
        align=RIGHT,
    )

    # Calculate the total-row percentage fluctuation using the entered prior value.
    write_cell(
        ws,
        row,
        table_layout["fluctuation_percent_column"],
        f'=IFERROR({fluc_amt_col}{row}/{pri_col}{row},"")',
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["percent_two_decimal_format"],
        align=RIGHT,
    )

    row += 1

    write_cell(
        ws,
        row,
        table_layout["label_column"],
        "%",
        font=BOLD,
        border=THIN_ALL,
        align=LEFT,
    )

    # Calculate the account-group current percentage of the manually entered total.
    write_cell(
        ws,
        row,
        table_layout["current_column"],
        f'=IFERROR({cur_col}{total_acct_group_row}/{cur_col}{total_row},"")',
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["percent_two_decimal_format"],
        align=CENTER,
    )

    # Calculate the account-group prior percentage of the manually entered total.
    write_cell(
        ws,
        row,
        table_layout["prior_column"],
        f'=IFERROR({pri_col}{total_acct_group_row}/{pri_col}{total_row},"")',
        font=BOLD,
        border=THIN_ALL,
        fmt=formatting["percent_two_decimal_format"],
        align=CENTER,
    )

    write_cell(
        ws,
        row,
        table_layout["fluctuation_amount_column"],
        None,
        font=BOLD,
        border=THIN_ALL,
        align=CENTER,
    )

    write_cell(
        ws,
        row,
        table_layout["fluctuation_percent_column"],
        None,
        font=BOLD,
        border=THIN_ALL,
        align=CENTER,
    )

    # Return the next available row and the group-data range used by chart logic.
    return row + 2, group_row_start, group_row_end


