DEBUG_BLUE_SELECTIONS = True        # toggles the diagnostic print near the end.

# The six D&T columns inserted on the QUANTITATIVE sheet (order matters).
CALCULATED_COLUMNS = [
    "Times of materiality",
    "Mean",
    "Median",
    "Highest balance in a residual entity",
    "% of the total balance",
    "Multiple of materiality balance",
]

# Sub-group of calculated columns that sit under the "Highest balance..." banner.
HIGHEST_BALANCE_GROUP = {
    "highest balance in a residual entity",
    "% of the total balance",
    "multiple of materiality balance",
}

# Labels for the two per-account detail sub-rows on the Quantitative sheet.
ENTITY_PERCENT_DETAIL_LABEL = "% of the total balance at each legal entity"
ENTITY_MULTIPLE_DETAIL_LABEL = "Multiple of materiality balance at each legal entity"


# ---- small local helpers (column lookup / decimal math) ---------------------

def _normalise_column_name(value):
    """WHAT: case-folded, stripped column key. CALLED BY: all column-matching helpers below."""
    # Turn a column name into a "plain" version — no surrounding spaces, all lowercase —
    # so we can compare names without worrying about capitals or stray spaces.
    return str(value).strip().casefold()


def _unique_texts(items):
    """WHAT: de-duplicate a list of strings preserving order (drops blanks).
    CALLED BY: _arrange_output_columns and append_raw_tb_cy_to_sheet (calculated_columns)."""
    # Keep each name only once, in the order it first appears, and skip empty ones.
    result = []
    seen = set()                                   # remembers what we've already kept
    for item in items or []:
        text = str(item).strip()
        if text and text not in seen:
            result.append(text)
            seen.add(text)
    return result


def _require_column(source_columns, name):
    """
    WHAT: case-insensitive lookup returning the ACTUAL column name; raises if absent.
    CALLED BY: _find_residual_entity_columns, _arrange_output_columns, and
               append_raw_tb_cy_to_sheet (to resolve Account / % / Test / Consolidated / Untested).
    """
    # Find a column by name while ignoring capitals/spaces, and give back its REAL name
    # (the exact spelling used in the data). If it isn't there at all, stop with an error.
    target = _normalise_column_name(name)
    for column in source_columns:
        if _normalise_column_name(column) == target:
            return column
    raise KeyError(f"Required column not found: {name!r}")


# to_decimal (SHARED UTILITIES) already covers this section's parsing needs, so it
# is reused directly under the section-local name _to_decimal.
# (Just a shortcut name so the rest of this file can call the shared number parser.)
_to_decimal = to_decimal


def _to_excel_percentage(value):
    """
    WHAT: convert a percentage into Excel's 0..1 fraction. Divides by 100 ONLY when the
          source looks like '15' (|value| > 1) rather than already-fractional '0.15'.
    CALLED BY: append_raw_tb_cy_to_sheet when writing the "% of consolidated balance" cell.
    """
    # Excel stores percentages as fractions (15% is really 0.15). This works out whether
    # the incoming value is written the "15" way or the "0.15" way, and converts only when
    # needed. Rule of thumb: if it's bigger than 1 it's probably "15", so divide by 100.
    number = _to_decimal(value)
    if number is None:
        return None
    return number / Decimal("100") if abs(number) > 1 else number


def _is_nonzero(value):
    """WHAT: True if value parses to a non-zero number.
    CALLED BY: append_raw_tb_cy_to_sheet — half of the 'keep row visible' test."""
    # True only when the value is a real number that isn't zero.
    number = _to_decimal(value)
    return number is not None and number != 0


def _is_no(value):
    """WHAT: True if value is exactly 'no' (case-insensitive).
    CALLED BY: append_raw_tb_cy_to_sheet — the other half of 'keep row visible'."""
    # True when the cell literally says "no" (in any capitalisation).
    return str(value).strip().casefold() == "no"


def _median_decimal(values):
    """WHAT: median of a list of Decimals (None if empty).
    CALLED BY: _calculate_analysis_values (the 'Median' metric)."""
    # The median is the "middle" value once the numbers are sorted.
    if not values:
        return None
    ordered = sorted(values)
    middle = len(ordered) // 2
    if len(ordered) % 2:                           # odd count -> there's a single middle value
        return ordered[middle]
    # even count -> no single middle, so average the two middle values
    return (ordered[middle - 1] + ordered[middle]) / Decimal("2")


def _number_format(column_label):
    """
    WHAT: pick the Excel number format for a given column label
          (percent / 2-decimal multiple / thousands-with-negatives).
    CALLED BY: append_raw_tb_cy_to_sheet when styling a numeric body cell.
    """
    # Choose how a number should LOOK in Excel based on which column it's in:
    #  - percentage columns show as "12.34%"
    #  - "times/multiple" columns show two decimals like "1.25"
    #  - everything else shows with thousands separators, negatives in brackets.
    normalized = _normalise_column_name(column_label)
    if normalized in {"% of consolidated balance", "% of the total balance"}:
        return "0.00%"
    if normalized in {"times of materiality", "multiple of materiality balance"}:
        return "0.00"
    return "#,##0;(#,##0)"


def _find_residual_entity_columns(source_columns, calculated_columns=()):
    """
    WHAT: identify the legal-entity balance columns = every column AFTER
          'Test consolidated amount' that is NOT a calculated/system column.
    CALLED BY: append_raw_tb_cy_to_sheet (only when calculated_columns are in play)
               and _calculate_analysis_values (via entity_columns) / _write_detail_row.
    OUTPUT FLOW: the entity_columns list drives residual stats and the detail sub-rows.
    """
    # The individual legal-entity money columns all sit to the RIGHT of "Test consolidated
    # amount". So we start just after that column and collect everything, while skipping any
    # columns we added ourselves (the six calculated ones) and internal bookkeeping columns.
    calculated_keys = {_normalise_column_name(c) for c in calculated_columns}
    test_column = _require_column(source_columns, "Test consolidated amount")
    test_index = source_columns.index(test_column)
    entity_columns = []
    for column in source_columns[test_index + 1:]:
        normalized = _normalise_column_name(column)
        if normalized in calculated_keys:      # skip the six D&T columns
            continue
        if normalized in {"row_id"}:   # skip system columns
            continue
        entity_columns.append(column)
    # If nothing was found, the layout isn't what we expect — stop rather than guess.
    if not entity_columns:
        raise ValueError("No legal-entity columns were found after 'Test consolidated amount'.")
    return entity_columns


def _arrange_output_columns(source_columns, calculated_columns):
    """
    WHAT: produce the final column order = source columns with the calculated columns
          inserted immediately AFTER 'Test consolidated amount'.
    CALLED BY: append_raw_tb_cy_to_sheet.
    OUTPUT FLOW: output_columns drives header writing and per-cell column iteration.
    """
    # Decide the final left-to-right column order for the sheet. The six calculated columns
    # get slotted in right after "Test consolidated amount".
    calculated_columns = _unique_texts(calculated_columns)
    if not calculated_columns:
        return list(source_columns)          # Qualitative sheet: no insertion.
    calculated_keys = {_normalise_column_name(c) for c in calculated_columns}
    # First take out any copies of the calculated columns that are already present, so we
    # don't end up with duplicates after inserting them.
    source_without_calculated = [c for c in source_columns
                                 if _normalise_column_name(c) not in calculated_keys]
    # Find where "Test consolidated amount" sits, then insert the calculated columns just after it.
    test_column = _require_column(source_without_calculated, "Test consolidated amount")
    insert_position = source_without_calculated.index(test_column) + 1
    return (source_without_calculated[:insert_position]
            + calculated_columns
            + source_without_calculated[insert_position:])


def set_materiality(template, value, target_sheet=QUANTITATIVE_SHEET, cell="C10"):
    """
    WHAT: write the materiality figure into the template's summary cell (handles the case
          where the target cell is inside a merged range by writing to its top-left anchor).
    CALLED BY: the main run block (once, before append_raw_tb_cy_to_sheet).
    """
    worksheet = template[target_sheet]
    # If the target cell is part of a group of merged (joined) cells, you can only write to
    # the top-left cell of that group — so find that corner and use it instead.
    for merged_range in worksheet.merged_cells.ranges:
        if cell in merged_range:
            cell = merged_range.coord.split(":", 1)[0]   # write to top-left of the merge
            break
    target = worksheet[cell]
    target.value = int(value)                            # store the number
    target.number_format = "[$$-en-US]#,##0"             # show it as US dollars with commas


def _clear_existing_table(worksheet, header_row, start_column):
    """
    WHAT: blank every non-merged cell from the header row down / anchor column right,
          so a re-run starts clean.
    CALLED BY: append_raw_tb_cy_to_sheet (when clear_existing=True).
    NOTE: this name is REDEFINED in Section 3 with different behaviour — last def wins,
          but by then Section 2 has already executed, so no conflict at runtime.
    """
    # Wipe out the old table area before writing a new one, so leftovers from a previous run
    # don't stick around. We only empty normal cells and leave merged ones alone (writing to
    # a merged cell other than its corner would error).
    for row in worksheet.iter_rows(min_row=header_row, max_row=worksheet.max_row,
                                   min_col=start_column, max_col=worksheet.max_column):
        for cell in row:
            if not isinstance(cell, MergedCell):
                cell.value = None


def _source_records(raw_tb_CY, source_columns, row_id_col="row_id"):
    """
    WHAT: stream each Spark row as a plain dict keyed by source_columns + row_id.
    CALLED BY: append_raw_tb_cy_to_sheet's main loop.
    OUTPUT FLOW: each `record` dict feeds visibility tests, _calculate_analysis_values,
                 and per-cell writes.
    """
    # Pull the data out of Spark and hand it back one row at a time as a simple dictionary
    # (column name -> value), which is much easier to work with when writing to Excel.
    # collect() is what actually pulls all the rows into memory here.
    selected_columns = list(source_columns) + [row_id_col]
    for row in raw_tb_CY.select(*selected_columns).collect():
        record = row.asDict(recursive=True)
        # Rebuild the dict so it only contains the columns we asked for, plus the row label.
        yield {**{c: record.get(c) for c in source_columns}, row_id_col: record.get(row_id_col)}

