def replace_spark_cells(df: DataFrame, column_row_pairs: Iterable[Tuple[str, int]],
                        row_id_col: str = "row_id", replacement: str = GREY_MARKER) -> DataFrame:
    """
    WHAT: overwrite selected cells (matched by column name + row_id) with `replacement`
          (the GREY_MARKER). Groups targets by column, then does one withColumn per column.
    INPUTS FROM: raw_tb_CY/_PY (df) and spark_column_row_pairs_cy/_py (column_row_pairs).
    CALLED BY: the two calls below.
    OUTPUT FLOW: returns updated_raw_tb_CY / updated_raw_tb_PY -> Sections 3/3a/3b.
    """
    # We identify rows by the values in the row_id column, so that column has to exist.
    if row_id_col not in df.columns:
        raise ValueError(f"Missing row ID column: {row_id_col}")

    # Build a lookup that says, for each column, which row numbers need to be overwritten.
    # Using a set per column means the same row can't be listed twice by accident.
    targets = defaultdict(set)   # column_name -> {row_ids to overwrite}
    for column_name, row_id in column_row_pairs:
        # The column being targeted must actually be in the table.
        if column_name not in df.columns:
            raise ValueError(f"Column not found: {column_name}")
        # Extra safety: never allow the row label column itself to be a target.
        if column_name == row_id_col:
            raise ValueError(f"Cannot replace the row ID column: {row_id_col}")
        # A missing row number can't be matched to anything.
        if row_id is None:
            raise ValueError(f"Invalid row_id for column: {column_name}")
        row_id = int(row_id)
        # Row numbers start at 1, so anything below that is invalid.
        if row_id < 1:
            raise ValueError(f"Invalid row_id: {row_id}")
        # Record this row number under its column.
        targets[column_name].add(row_id)

    # Work on a copy we keep updating; we rebuild one column at a time.
    result = df
    for column_name, row_ids in targets.items():
        original = result[column_name]
        # The marker we write in is text. If this column isn't already text (say it holds
        # numbers), we switch the whole column to text first so the marker fits without error.
        if not isinstance(df.schema[column_name].dataType, StringType):
            original = original.cast("string")
        # Rebuild the column: for the rows we're targeting, put the marker in; for every
        # other row, keep whatever was there before. isin(...) checks "is this row one we want".
        result = result.withColumn(
            column_name,
            F.when(result[row_id_col].isin(sorted(row_ids)), F.lit(replacement)).otherwise(original),
        )
    return result


