def drop_row_id_pairs(column_row_pairs):
    """Filter out any (column, row_id) pair that accidentally targets the row_id column itself."""
    return [
        (column_name, row_id)
        for column_name, row_id in column_row_pairs
        if column_name != "row_id"
    ]


