import re

TARGET_SHEETS = ("Balance Sheet", "Income Statement")
CELL_PATTERN = re.compile(r"^\$?([A-Za-z]+)\$?(\d+)$")

def excel_column_index(excel_column):
    """Convert an Excel column letter (e.g. 'AC') into a 0-based index."""
    index = 0
    for letter in excel_column.upper():
        index = index * 26 + ord(letter) - ord("A") + 1
    return index - 1


def normalize_sheet_names(sheet_names):
    """Coerce a single sheet name or an iterable of names into a set of stripped names."""
    if sheet_names is None:
        return None
    if isinstance(sheet_names, str):
        return {sheet_names.strip()}
    return {str(name).strip() for name in sheet_names}


def get_blue_amounts(
    excel_path,
    sheet_names,
    excel_data_start_row=4,
):
    """
    Return blue-font cells, including a local 1-based row_id.

    The local row_id is relative to each worksheet:
    Excel row 4 -> row_id 1
    Excel row 5 -> row_id 2
    """
    values_workbook = cp.openpyxl.read(
        excel_path,
        data_only=True,
    )

    formulas_workbook = cp.openpyxl.read(
        excel_path,
        data_only=False,
    )

    selected_sheet_names = normalize_sheet_names(sheet_names)
    blue_amounts = []

    def get_font_rgb(cell):
        color = cell.font.color
        if color is None:
            return None
        if color.type == "rgb" and color.rgb:
            return str(color.rgb).replace("#", "")[-6:].upper()
        return None

    def is_blue_font(cell):
        rgb = get_font_rgb(cell)
        if rgb is None:
            return False
        red = int(rgb[0:2], 16)
        green = int(rgb[2:4], 16)
        blue = int(rgb[4:6], 16)
        return (
            blue >= 100
            and blue > red * 1.25
            and blue > green * 1.10
        )

    try:
        available_sheet_names = {
            worksheet.title
            for worksheet in formulas_workbook.worksheets
        }

        if selected_sheet_names is not None:
            missing_sheets = selected_sheet_names - available_sheet_names
            if missing_sheets:
                raise ValueError(
                    f"Worksheet(s) not found: {sorted(missing_sheets)}"
                )

        for formula_worksheet in formulas_workbook.worksheets:
            sheet_name = formula_worksheet.title

            if (
                selected_sheet_names is not None
                and sheet_name not in selected_sheet_names
            ):
                continue

            value_worksheet = values_workbook[sheet_name]

            for row in formula_worksheet.iter_rows(
                min_row=1,
                max_row=formula_worksheet.max_row,
            ):
                for formula_cell in row:
                    value_cell = value_worksheet[formula_cell.coordinate]

                    cached_value = value_cell.value
                    formula_or_value = formula_cell.value

                    if cached_value is None and formula_or_value is None:
                        continue

                    if not is_blue_font(formula_cell):
                        continue

                    amount = (
                        cached_value
                        if cached_value is not None
                        else formula_or_value
                    )

                    local_row_id = (
                        formula_cell.row - excel_data_start_row + 1
                    )

                    if local_row_id < 1:
                        continue

                    blue_amounts.append(
                        {
                            "sheet_name": sheet_name,
                            "cell_address": formula_cell.coordinate,
                            "amount": amount,
                            "font_rgb": get_font_rgb(formula_cell),
                            "is_blue": True,
                            "row_id": local_row_id,
                        }
                    )

    finally:
        values_workbook.close()
        formulas_workbook.close()

    return blue_amounts


def get_dynamic_sheet_row_counts(
    excel_path,
    sheet_names=TARGET_SHEETS,
    excel_data_start_row=4,
    max_data_column=None,
):
    """Return the number of populated data rows per worksheet."""
    workbook = cp.openpyxl.read(
        excel_path,
        data_only=False,
    )

    selected_sheet_names = normalize_sheet_names(sheet_names)
    sheet_row_counts = {}

    try:
        available_sheet_names = {
            worksheet.title
            for worksheet in workbook.worksheets
        }

        if selected_sheet_names is not None:
            missing_sheets = selected_sheet_names - available_sheet_names
            if missing_sheets:
                raise ValueError(
                    f"Worksheet(s) not found: {sorted(missing_sheets)}"
                )

        for worksheet in workbook.worksheets:
            sheet_name = worksheet.title

            if (
                selected_sheet_names is not None
                and sheet_name not in selected_sheet_names
            ):
                continue

            if worksheet.max_row < excel_data_start_row:
                sheet_row_counts[sheet_name] = 0
                continue

            scan_to_column = (
                worksheet.max_column
                if max_data_column is None
                else min(max_data_column, worksheet.max_column)
            )

            last_data_row = excel_data_start_row - 1

            for row in worksheet.iter_rows(
                min_row=excel_data_start_row,
                max_row=worksheet.max_row,
                min_col=1,
                max_col=scan_to_column,
            ):
                if any(cell.value is not None for cell in row):
                    last_data_row = row[0].row

            sheet_row_counts[sheet_name] = max(
                0,
                last_data_row - excel_data_start_row + 1,
            )

    finally:
        workbook.close()

    return sheet_row_counts


def create_appended_spark_column_row_pairs(
    blue_amounts,
    spark_columns,
    sheet_row_counts,
    sheet_order=TARGET_SHEETS,
):
    """
    Return unique (Spark column name, global row_id) pairs.

    row_id is 1-based across the combined DataFrame, with worksheets
    appended in sheet_order.
    """
    spark_columns = list(spark_columns)
    sheet_order = tuple(sheet_order)

    missing_counts = {
        sheet_name
        for sheet_name in sheet_order
        if sheet_name not in sheet_row_counts
    }

    if missing_counts:
        raise ValueError(
            f"Missing dynamic row counts for: {sorted(missing_counts)}"
        )

    sheet_offsets = {}
    current_offset = 0

    for sheet_name in sheet_order:
        sheet_offsets[sheet_name] = current_offset
        current_offset += sheet_row_counts[sheet_name]

    pairs = []
    seen_pairs = set()
    missing_excel_columns = set()

    for item in blue_amounts:
        if item.get("is_blue") is not True:
            continue

        sheet_name = item.get("sheet_name")
        local_row_id = item.get("row_id")

        if sheet_name not in sheet_offsets or local_row_id is None:
            continue

        local_row_id = int(local_row_id)

        if not (1 <= local_row_id <= sheet_row_counts[sheet_name]):
            continue

        match = CELL_PATTERN.fullmatch(
            str(item.get("cell_address", "")).strip().upper()
        )

        if not match:
            continue

        excel_column = match.group(1)
        column_index = excel_column_index(excel_column)

        if column_index >= len(spark_columns):
            missing_excel_columns.add(excel_column)
            continue

        column_name = spark_columns[column_index]
        row_id = sheet_offsets[sheet_name] + local_row_id

        pair = (column_name, row_id)

        if pair not in seen_pairs:
            pairs.append(pair)
            seen_pairs.add(pair)

    if missing_excel_columns:
        print(
            "Skipped Excel columns without matching Spark columns: "
            + ", ".join(sorted(missing_excel_columns))
        )

    return pairs


