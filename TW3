            df_group = prepare_data(df_full, acct_group)
            
            import openpyxl
            wb = openpyxl.load_workbook(TEMPLATE_PATH)
            
            # --- SHEET 1: SUMMARY ---
            s1_name = _make_sheet_name(acct_group, "Sum")
            ws1 = _copy_sheet_from_template(wb, TEMPLATE_SHEET_SUMMARY, s1_name)
            
            apply_white_background(ws1, df_group)
            _enable_outline(ws1)
            
            write_sheet_header(ws1, acct_group)
            write_header_row(ws1, df_group)
            
            current_row = _START_ROW
            group_totals = OrderedDict()
            
            # Write groupings
            for group_name, group_data in df_group.groupby(GROUP_COL):
                current_row, subtotals = _s1_write_group(ws1, group_data, current_row, group_name)
                group_totals[group_name] = subtotals
                
            current_row = _s1_write_grand_total(ws1, df_group, current_row, acct_group)
            current_row = _s1_write_year_end_box(ws1, current_row)
            current_row = write_materiality_box(ws1, current_row, TABLE_CONFIG)
            current_row = write_s1_table1(ws1, current_row, group_totals, TABLE_CONFIG, acct_group)
            
            
            # --- SHEET 2: ANALYSIS ---
            s2_name = _make_sheet_name(acct_group, "Ana")
            ws2 = _copy_sheet_from_template(wb, TEMPLATE_SHEET_ANALYSIS, s2_name)
            
            apply_white_background_s2(ws2, n_rows=250)
            
            # Sheet 2 Layout setup
            write_sheet_header(ws2, acct_group)
            s2_current_row = _START_ROW + 24 # Offset to drop past initial header boxes/commentary areas as per template
            
            s2_current_row = write_materiality_box(ws2, s2_current_row, SHEET2_CONFIG)
            
            wc(ws2, s2_current_row + 1, _S2_B, "Figures in $ M", font=ITALIC, align=LEFT)
            s2_current_row += 3
            
            s2_current_row = write_s2_table1_and_charts(ws2, s2_current_row, group_totals, SHEET2_CONFIG, acct_group)
            
            
            # --- CLEANUP AND SAVE ---
            if DELETE_TEMPLATE_SHEETS:
                for t_sheet in [TEMPLATE_SHEET_SUMMARY, TEMPLATE_SHEET_ANALYSIS, TEMPLATE_SHEET_TICKMARKS]:
                    if t_sheet in wb.sheetnames:
                        del wb[t_sheet]
                        
            out_path = _make_output_path(acct_group)
            wb.save(out_path)
            print(f"[{acct_group}] Successfully saved to: {out_path}")
            
        except Exception as e:
            print(f"[{acct_group}] Error processing: {str(e)}")

# Execute
main()
