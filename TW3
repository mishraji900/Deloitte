    "p3_primary_key"
)

p3_credit = materialize_df(
    p3_base
    .filter(F.col("cat_clean") == "CREDIT MEMOS")
    .select(
        F.col("p3_primary_key"),
        F.col("row_id").alias("credit_row_id"),
