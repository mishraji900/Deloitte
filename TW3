_ILLEGAL = re.compile(r'[\[\]\:\?\*\/\\\\]')

def _make_sheet_name(acct_group: str, suffix: str) -> str:
    clean    = _ILLEGAL.sub('', acct_group).strip()
    max_base = 31 - len(suffix) - 1
    return f"{clean[:max_base]}-{suffix}"

def _copy_sheet_from_template(wb, template_sheet_name: str, new_name: str):
    if new_name in wb.sheetnames:
        print(f"Sheet '{new_name}' already exists - reusing")
        return wb[new_name]
    
    if template_sheet_name not in wb.sheetnames:
        raise KeyError(
            f"Template sheet '{template_sheet_name}' not found. "
            f"Available: {wb.sheetnames}"
        )
        
    source_ws    = wb[template_sheet_name]
    new_ws       = wb.copy_worksheet(source_ws)
    new_ws.title = new_name
    print(f"Copied '{template_sheet_name}' -> '{new_name}'")
    return new_ws

# =============================================================================
# CELL WRITER HELPER
# =============================================================================
def _apply_border_to_merge(ws, row: int, col_start: int, col_end: int, border):
    """stamp border on every cell in a merged row range (anchor + non-anchors)."""
    for col in range(col_start, col_end + 1):
        ws.cell(row=row, column=col).border = border

def wc(ws, row, col, value=None, font=None, border=None, fmt=None, align=None, fill=None):
    cell = ws.cell(row=row, column=col, value=value)
    if font:   cell.font          = font
    if border: cell.border        = border
    if fmt:    cell.number_format = fmt
    if align:  cell.alignment     = align
    if fill:   cell.fill          = fill
    return cell

def safe_merge(ws, r1, c1, r2, c2):
    ws.merge_cells(start_row=r1, start_column=c1, end_row=r2, end_column=c2)

