def write_composition_pie_charts(ws, first_data_row: int, last_data_row: int, 
                                 label_col: int, cur_val_col: int, pri_val_col: int, 
                                 cur_label: str, pri_label: str, 
                                 anchor_chart1: str, anchor_chart2: str):
    
    cats = Reference(ws, min_col=label_col, min_row=first_data_row, max_row=last_data_row)
    
    # Figure 1: Current Period Composition
    pie1 = PieChart()
    pie1.title = f"Figure 1: Cash - Composition - {cur_label}"
    data1 = Reference(ws, min_col=cur_val_col, min_row=first_data_row, max_row=last_data_row)
    pie1.add_data(data1, titles_from_data=False)
    pie1.set_categories(cats)
    pie1.dataLabels = DataLabelList()
    pie1.dataLabels.showPercent = True
    pie1.legend.position = "b"
    pie1.width, pie1.height = 13.5, 7
    
    # Figure 2: Prior Period Composition
    pie2 = PieChart()
    pie2.title = f"Figure 2: Cash - Composition - {pri_label}"
    data2 = Reference(ws, min_col=pri_val_col, min_row=first_data_row, max_row=last_data_row)
    pie2.add_data(data2, titles_from_data=False)
    pie2.set_categories(cats)
    pie2.dataLabels = DataLabelList()
    pie2.dataLabels.showPercent = True
    pie2.legend.position = "b"
    pie2.width, pie2.height = 13.5, 7

    ws.add_chart(pie1, anchor_chart1)
    ws.add_chart(pie2, anchor_chart2)


