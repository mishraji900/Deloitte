# ============================================================

# ------------------------------------------------------------
# STEP P3-0: PREP â€” Derive all required columns on input data
# REMAIN_UNMATCHED_GROUPS already carries these from Pipeline 1.
# This block is a safety re-derivation in case Pipeline 2 is
# ever run independently from raw source data.
# ------------------------------------------------------------
print("\n[STEP P3-0] Preparing derived columns on input data...")

def prepare_pipe2_input(df):
    """
    Derives all columns Pipeline 2 depends on from raw source fields.
    Idempotent â€” safe to call even if columns already exist.
    Uses the same helper functions as Pipeline 1.
    """

    # â”€â”€ Row identity â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    df = ensure_row_id(df)              # row_id: SHA-256 of all RAW_COLUMNS

    # â”€â”€ Cleaned text fields â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    df = df.withColumn(
        "company_desc_clean",           # Source: "Company Description"
        F.upper(F.trim(F.col("Company Description")))
    )
    df = df.withColumn(
        "vendor_num_clean",             # Source: "Vendor/Customer Number"
        F.trim(F.col("Vendor/Customer Number").cast("string"))
    )
    df = df.withColumn(
        "invoice_ref_clean",            # Source: "Invoice Reference"
        F.trim(F.col("Invoice Reference"))
    )

    # â”€â”€ Standardised category â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    # Pipeline 2 hard-filters on "SALES INVOICES" and "CREDIT MEMOS".
    # Values must match exactly â€” Pipeline 1 passes them through as-is
    # from trim+upper, so "SALES INVOICES" / "CREDIT MEMOS" are expected.
    df = df.withColumn(
        "cat_clean",                    # Source: "JE Category"
        F.trim(F.upper(F.col("JE Category")))
    )

    # â”€â”€ Numeric amount â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    df = df.withColumn(
        "entered_net_dec",              # Source: "Net Entered"
        to_decimal_clean("Net Entered") # handles commas, parentheses, blanks
    )

    # â”€â”€ Date fields â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    df = df.withColumn(
        "eff_dt",                       # Source: "Default Effective Date"
        to_date_clean("Default Effective Date")  # tries 5 format patterns
    ).withColumn("Default Effective Date", F.col("eff_dt"))
    df = df.withColumn(
        "month_dt",                     # Source: "Month"
        month_from_business_column(F.col("Month"))  # handles "Jan-25" style
    )

    return df


# Apply only if running Pipeline 2 standalone from raw source.
# If REMAIN_UNMATCHED_GROUPS comes from Pipeline 1, these columns
# are already present and this is a no-op in practice.
JE_raw_pipe_3 = prepare_pipe2_input(all_unmatched_1_pipe2)

debug_count("JE_raw_pipe_3 (prepared input)", JE_raw_pipe_3)


# ------------------------------------------------------------
# STEP P3-1: Rebuild PK â€” COMPANY_DESC + VENDOR_NUM (no amount)
# This is the ONLY column Pipeline 2 adds that Pipeline 1 never had.
# Pipeline 1 PK = company_desc + vendor_num + abs_amount
# Pipeline 2 PK = company_desc + vendor_num  (looser â€” intentional)
# ------------------------------------------------------------
print("\n[STEP P3-1] Rebuilding PK on REMAIN_UNMATCHED_GROUPS...")

p3_base = (
    JE_raw_pipe_3
    .withColumn(
        "p3_primary_key",               # NEW â€” only column P3 adds
        F.when(
            F.col("company_desc_clean").isNotNull()
            & (F.col("company_desc_clean") != "")
            & F.col("vendor_num_clean").isNotNull()
            & (F.col("vendor_num_clean") != ""),
            F.concat_ws("_",
                F.col("company_desc_clean"),
                F.col("vendor_num_clean")
            )
        )
        # No .otherwise() â†’ NULL if either field is missing
        # NULL rows are caught below and sent to NO_MATCH_FOUND
    )
)

# Rows where PK cannot be built â†’ straight to NO_MATCH_FOUND
p3_invalid_pk = materialize_df(
    p3_base.filter(F.col("p3_primary_key").isNull()),
    "p3_invalid_pk",
    "row_id"
)

p3_base = materialize_df(
    p3_base.filter(F.col("p3_primary_key").isNotNull()),
    "p3_base",
    "p3_primary_key"
)

debug_count("p3_base (valid new PK)", p3_base)
debug_count("p3_invalid_pk (no new PK â†’ NO_MATCH_FOUND)", p3_invalid_pk)

# â”€â”€ Quick null profile on the 22K invalid PK rows â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Tells you exactly which field is causing the PK failure.
print("\n  [PROFILE] PK failure breakdown on p3_invalid_pk")
p3_invalid_pk.select(
    F.sum(F.when(F.col("company_desc_clean").isNull() | (F.col("company_desc_clean") == ""), 1).otherwise(0)).alias("missing_company_desc"),
    F.sum(F.when(F.col("vendor_num_clean").isNull()   | (F.col("vendor_num_clean")   == ""), 1).otherwise(0)).alias("missing_vendor_num"),
    F.sum(
        F.when(
            (F.col("company_desc_clean").isNull() | (F.col("company_desc_clean") == ""))
            & (F.col("vendor_num_clean").isNull()   | (F.col("vendor_num_clean")   == "")),
            1
        ).otherwise(0)
    ).alias("missing_both"),
).show(truncate=False)

# ------------------------------------------------------------
# STEP P3-2: Build Sales and Credit side tables (new PK)
# ------------------------------------------------------------
print("\n[STEP P3-2] Building sales / credit side tables with new PK...")

p3_sales = materialize_df(
    p3_base
    .filter(F.col("cat_clean") == "SALES INVOICES")
    .select(
        F.col("p3_primary_key"),
        F.col("row_id").alias("sales_row_id"),
        F.col("entered_net_dec").alias("sales_amt"),
        F.col("eff_dt").alias("sales_eff_dt"),
        F.col("month_dt").alias("sales_month"),
        F.col("invoice_ref_clean").alias("sales_ref"),
    )
    .repartition(NUM_PARTITIONS, "p3_primary_key"),
