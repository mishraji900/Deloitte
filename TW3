        if c not in df.columns:
            df = df.withColumn(c, F.lit(None).cast("string"))

    df = df.withColumn(
        "Company Description",
        F.coalesce(
            F.col("Company Description").cast("string"),
            F.col("Company").cast("string")
        )
    )
    return df.select(*REQUIRED_COLUMNS)

def to_decimal_clean(col_name, precision=38, scale=6):
    cleaned = F.trim(F.col(col_name).cast("string"))
    cleaned = F.regexp_replace(cleaned, ",", "")
    cleaned = F.when(
        cleaned.rlike(r"^\(.*\)$"),
        F.concat(F.lit("-"), F.regexp_replace(cleaned, r"[()]", "")),
    ).otherwise(cleaned)
    cleaned = F.when(cleaned == "", None).otherwise(cleaned)
    return cleaned.cast(T.DecimalType(precision, scale))

def to_date_clean(col_name):
    raw = F.trim(F.col(col_name).cast("string"))
    return F.coalesce(
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "M/d/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
    )

def month_from_business_column(month_col):
    raw = F.trim(month_col.cast("string"))
    return F.coalesce(
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yyyy"),
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
    )

def ensure_row_id(df):
    if "row_id" in df.columns:
        return df.withColumn("row_id", F.col("row_id").cast("string"))

    preferred_order = [
        "Company Description",
        "Vendor/Customer Number",
        "JE Category",
        "Default Effective Date",
        "Month",
        "Net Entered",
        "Invoice Reference",
        "JE Batch Id",
        "JE Line Number",
    ]
    order_cols = [c for c in preferred_order if c in df.columns]
    if not order_cols:
        order_cols = sorted(df.columns)

    return df.withColumn(
        "row_id",
        F.row_number().over(
            Window.orderBy(*[F.col(c).asc_nulls_last() for c in order_cols])
        ).cast("string"),
    )

def union_non_null(*dfs):
    valid = [df for df in dfs if df is not None]
    if not valid:
        return None
    out = valid[0]
    for df in valid[1:]:
        out = out.unionByName(df, True)
    return out

def build_unmatched_rows(base_df, rem_sales_df, rem_credit_df, name):
    sales_ids = rem_sales_df.select(F.col("sales_row_id").alias("row_id"))
    credit_ids = rem_credit_df.select(F.col("credit_row_id").alias("row_id"))
    remaining_ids = sales_ids.unionByName(credit_ids).distinct()
    unmatched_df = base_df.alias("b").join(remaining_ids.alias("r"), on="row_id", how="inner")
    return materialize_df(unmatched_df, name, "primary_key")

def resolve_to_original(pairs_df, base_df, match_label, stage_name):
    if pairs_df is None:
        return None

    w_pair = Window.orderBy(
        F.col("primary_key").asc(),
        F.col("sales_row_id").asc(),
        F.col("credit_row_id").asc(),
    )

    pairs_with_id = (
        pairs_df.withColumn(
            "pair_id",
            F.concat(F.lit(f"{match_label}_"), F.row_number().over(w_pair).cast("string")),
        )
        .select("pair_id", "sales_row_id", "credit_row_id", "match_type")
    )

    sales_side = (
        pairs_with_id.join(
            base_df.alias("orig"),
            pairs_with_id["sales_row_id"] == F.col("orig.row_id"),
            "inner",
        )
        .drop("sales_row_id", "credit_row_id")
    )

    credit_side = (
        pairs_with_id.join(
            base_df.alias("orig"),
            pairs_with_id["credit_row_id"] == F.col("orig.row_id"),
            "inner",
        )
        .drop("sales_row_id", "credit_row_id")
    )

    resolved = sales_side.unionByName(credit_side)
    return materialize_df(resolved, stage_name, "primary_key")

def rank_based_match(sales_df, credit_df, condition_fn, match_label):
    candidates_joined = (
        sales_df.alias("s")
        .join(credit_df.alias("c"), on="primary_key", how="inner")
        .withColumn("amount_diff", F.abs(F.col("s.sales_amt") + F.col("c.credit_amt")))
        .withColumn(
            "month_lag",
            F.months_between(
                F.col("c.credit_month").cast("date"),
                F.col("s.sales_month").cast("date"),
            ).cast("int"),
        )
    )

    candidates = condition_fn(candidates_joined)

    if candidates.limit(1).count() == 0:
        return None, sales_df, credit_df

    w_sales = Window.partitionBy("primary_key", "s.sales_row_id").orderBy(
        F.col("amount_diff").asc(),
        F.col("month_lag").asc(),
        F.col("c.credit_eff_dt").asc(),
        F.col("c.credit_row_id").asc(),
    )

    best_credit_per_sales = (
        candidates.withColumn("rn_sales", F.row_number().over(w_sales))
        .filter(F.col("rn_sales") == 1)
    )

    w_credit = Window.partitionBy("primary_key", "c.credit_row_id").orderBy(
        F.col("amount_diff").asc(),
        F.col("month_lag").asc(),
        F.col("s.sales_eff_dt").asc(),
        F.col("s.sales_row_id").asc(),
    )

    confirmed_pairs = (
        best_credit_per_sales.withColumn("rn_credit", F.row_number().over(w_credit))
        .filter(F.col("rn_credit") == 1)
        .select(
            F.col("primary_key"),
            F.col("s.sales_row_id").alias("sales_row_id"),
            F.col("c.credit_row_id").alias("credit_row_id"),
            F.col("s.sales_amt").alias("sales_amt"),
            F.col("c.credit_amt").alias("credit_amt"),
            F.col("amount_diff"),
            F.col("s.sales_eff_dt").alias("sales_eff_dt"),
            F.col("c.credit_eff_dt").alias("credit_eff_dt"),
            F.col("s.sales_month").alias("sales_month"),
            F.col("c.credit_month").alias("credit_month"),
            F.col("s.sales_ref").alias("sales_ref"),
            F.col("c.credit_ref").alias("credit_ref"),
            F.col("month_lag"),
            F.lit(match_label).alias("match_type"),
        )
    )

    if confirmed_pairs.limit(1).count() == 0:
        return None, sales_df, credit_df

    confirmed_pairs = materialize_df(
        confirmed_pairs, f"matched_{match_label}_iter", "primary_key"
    )

    matched_s_ids = confirmed_pairs.select("sales_row_id").distinct()
    matched_c_ids = confirmed_pairs.select("credit_row_id").distinct()

    remaining_sales = materialize_df(
        sales_df.join(matched_s_ids, on="sales_row_id", how="left_anti"),
        f"rem_s_{match_label}_iter",
        "primary_key",
    )
    remaining_credit = materialize_df(
        credit_df.join(matched_c_ids, on="credit_row_id", how="left_anti"),
        f"rem_c_{match_label}_iter",
        "primary_key",
    )

    return confirmed_pairs, remaining_sales, remaining_credit

def exhaustive_match(sales_df, credit_df, condition_fn, match_label, base_df):
    print(f"\n[EXHAUSTIVE MATCH] {match_label}")

    accumulated_pairs = []
    current_sales = sales_df
    current_credit = credit_df
    iteration = 0

    while True:
        iteration += 1
        iter_label = f"{match_label}_i{iteration}"
        print(f"  [{match_label}] Iteration {iteration} ...")

        pairs, rem_sales, rem_credit = rank_based_match(
            current_sales, current_credit, condition_fn, iter_label
        )

        if pairs is None:
            print(f"  [{match_label}] No pairs at iteration {iteration}. Exiting loop.")
            break

        pair_count = pairs.count()
        print(f"  [{match_label}] Iteration {iteration}: {pair_count:,} pairs found.")

        if pair_count == 0:
            break

        pairs = pairs.withColumn("match_type", F.lit(match_label))
        pairs = materialize_df(pairs, f"pairs_{iter_label}", "primary_key")

        accumulated_pairs.append(pairs)
        current_sales = rem_sales
        current_credit = rem_credit

    if not accumulated_pairs:
        print(f"  [{match_label}] Total pairs: 0")
        return None, sales_df, credit_df

    slim_all = accumulated_pairs[0]
    for p in accumulated_pairs[1:]:
        slim_all = slim_all.unionByName(p)

    slim_all = materialize_df(slim_all, f"SLIM_PAIRS_{match_label}", "primary_key")

    total_pairs = slim_all.count()
    print(f"  [{match_label}] Total pairs across {iteration - 1} iteration(s): {total_pairs:,}")

    resolved = resolve_to_original(slim_all, base_df, match_label, f"RESOLVED_{match_label}")
    total_rows = resolved.count()

    print(f"  [{match_label}] Resolved original rows (pairs x 2): {total_rows:,}")
    print(f"  [{match_label}] Remaining sales : {current_sales.count():,}")
    print(f"  [{match_label}] Remaining credit: {current_credit.count():,}")

    return resolved, current_sales, current_credit

