)

debug_count("p3_sales", p3_sales)
debug_count("p3_credit", p3_credit)

# ------------------------------------------------------------
# STEP P3-3: Cross-join candidates within PK + apply tolerance
# ------------------------------------------------------------
print("\n[STEP P3-3] Cross-joining and applying |sale + credit| <= 100 tolerance...")

TOLERANCE = F.lit(100).cast(DECIMAL_TYPE)

p3_candidates = (
    p3_sales.alias("s")
    .join(p3_credit.alias("c"), on="p3_primary_key", how="inner")
    .withColumn(
        "amount_net",
        F.abs(F.col("s.sales_amt") + F.col("c.credit_amt"))
    )
    .filter(F.col("amount_net") <= TOLERANCE)
    .select(
        F.col("p3_primary_key"),
        F.col("s.sales_row_id"),
        F.col("c.credit_row_id"),
        F.col("s.sales_amt"),
        F.col("c.credit_amt"),
        F.col("amount_net"),
        F.col("s.sales_eff_dt"),
        F.col("c.credit_eff_dt"),
        F.col("s.sales_month"),
        F.col("c.credit_month"),
        F.col("s.sales_ref"),
        F.col("c.credit_ref"),
    )
)

p3_candidates = materialize_df(p3_candidates, "p3_candidates", "p3_primary_key")
debug_count("p3_candidates (within tolerance)", p3_candidates)

# ------------------------------------------------------------
# STEP P3-4: Detect one-to-many vs one-to-one
# Logic:
#   - Count distinct credit matches per sales_row_id
#   - Count distinct sales matches per credit_row_id
#   - If either count > 1 for any row in a pair â†’ ONE_TO_MANY
#   - If both counts == 1 â†’ ONE_TO_ONE â†’ check dates
# ------------------------------------------------------------
print("\n[STEP P3-4] Classifying one-to-many vs one-to-one...")

# How many credits match each sale?
sales_match_counts = (
    p3_candidates
    .groupBy("sales_row_id")
    .agg(F.countDistinct("credit_row_id").alias("credit_count_per_sale"))
)

# How many sales match each credit?
credit_match_counts = (
    p3_candidates
    .groupBy("credit_row_id")
    .agg(F.countDistinct("sales_row_id").alias("sales_count_per_credit"))
)

# Join counts back onto candidates
p3_candidates_classified = (
    p3_candidates
    .join(sales_match_counts, on="sales_row_id", how="left")
    .join(credit_match_counts, on="credit_row_id", how="left")
    .withColumn(
        "is_one_to_many",
        (F.col("credit_count_per_sale") > 1) | (F.col("sales_count_per_credit") > 1)
    )
)

p3_candidates_classified = materialize_df(
    p3_candidates_classified,
    "p3_candidates_classified",
    "p3_primary_key"
)

# ------------------------------------------------------------
# STEP P3-5: ONE-TO-MANY â€” collect all original rows
# ------------------------------------------------------------
print("\n[STEP P3-5] Building DATASET_ONE_TO_MANY...")

otm_pairs = (
    p3_candidates_classified
    .filter(F.col("is_one_to_many"))
    .select(
        F.col("sales_row_id"),
        F.col("credit_row_id"),
        F.col("p3_primary_key"),
        F.col("amount_net"),
        F.col("sales_amt"),
        F.col("credit_amt"),
        F.col("credit_count_per_sale"),
        F.col("sales_count_per_credit"),
    )
)

# Collect all distinct row_ids involved in one-to-many
otm_sales_ids = otm_pairs.select(
    F.col("sales_row_id").alias("row_id")
)
otm_credit_ids = otm_pairs.select(
    F.col("credit_row_id").alias("row_id")
)
otm_all_ids = otm_sales_ids.unionByName(otm_credit_ids).distinct()

DATASET_ONE_TO_MANY = materialize_df(
    p3_base.join(otm_all_ids, on="row_id", how="inner")
    .withColumn("match_type", F.lit("ONE_TO_MANY")),
    "DATASET_ONE_TO_MANY",
    "p3_primary_key"
)

debug_count("DATASET_ONE_TO_MANY", DATASET_ONE_TO_MANY)

# ------------------------------------------------------------
# STEP P3-6: ONE-TO-ONE â€” split by date sync
# A row that appears in one-to-many is excluded here
# ------------------------------------------------------------
print("\n[STEP P3-6] Building date-sync / date-unsync datasets...")

oto_pairs = (
    p3_candidates_classified
    .filter(~F.col("is_one_to_many"))
    .withColumn(
        "date_sync",
        F.col("sales_eff_dt") < F.col("credit_eff_dt")
    )
    .select(
        F.col("p3_primary_key"),
        F.col("sales_row_id"),
        F.col("credit_row_id"),
        F.col("sales_amt"),
        F.col("credit_amt"),
        F.col("amount_net"),
        F.col("sales_eff_dt"),
        F.col("credit_eff_dt"),
        F.col("date_sync"),
    )
)

oto_pairs = materialize_df(oto_pairs, "oto_pairs", "p3_primary_key")

# --- DATE SYNC (sale_date < credit_date) ---
oto_sync_ids = (
    oto_pairs
    .filter(F.col("date_sync"))
    .select(F.col("sales_row_id").alias("row_id"))
    .unionByName(
        oto_pairs.filter(F.col("date_sync"))
        .select(F.col("credit_row_id").alias("row_id"))
    )
    .distinct()
)

DATASET_1_1_DATE_SYNC = materialize_df(
    p3_base.join(oto_sync_ids, on="row_id", how="inner")
    .withColumn("match_type", F.lit("ONE_TO_ONE_DATE_SYNC")),
    "DATASET_1_1_DATE_SYNC",
    "p3_primary_key"
)

# --- DATE UNSYNC (sale_date >= credit_date) ---
oto_unsync_ids = (
    oto_pairs
    .filter(~F.col("date_sync"))
    .select(F.col("sales_row_id").alias("row_id"))
    .unionByName(
        oto_pairs.filter(~F.col("date_sync"))
        .select(F.col("credit_row_id").alias("row_id"))
    )
    .distinct()
)

DATASET_1_1_DATE_UNSYNC = materialize_df(
    p3_base.join(oto_unsync_ids, on="row_id", how="inner")
    .withColumn("match_type", F.lit("ONE_TO_ONE_DATE_UNSYNC")),
    "DATASET_1_1_DATE_UNSYNC",
    "p3_primary_key"
)

debug_count("DATASET_1_1_DATE_SYNC", DATASET_1_1_DATE_SYNC)
debug_count("DATASET_1_1_DATE_UNSYNC", DATASET_1_1_DATE_UNSYNC)

# ------------------------------------------------------------
# STEP P3-7: NO_MATCH_FOUND
# Any row in p3_base not in OTM, DATE_SYNC, DATE_UNSYNC
# + rows that had no valid new PK (p3_invalid_pk)
# ------------------------------------------------------------
print("\n[STEP P3-7] Building DATASET_NO_MATCH_FOUND...")

matched_ids = (
    otm_all_ids
    .unionByName(oto_sync_ids)
    .unionByName(oto_unsync_ids)
    .distinct()
)

p3_no_match = materialize_df(
    p3_base.join(matched_ids, on="row_id", how="left_anti")
    .withColumn("match_type", F.lit("NO_MATCH_FOUND")),
    "p3_no_match",
    "p3_primary_key"
)

DATASET_NO_MATCH_FOUND = materialize_df(
    union_non_null(p3_no_match, p3_invalid_pk.withColumn("match_type", F.lit("NO_MATCH_FOUND"))),
    "DATASET_NO_MATCH_FOUND",
    "row_id"
)

debug_count("DATASET_NO_MATCH_FOUND", DATASET_NO_MATCH_FOUND)

# ------------------------------------------------------------
# STEP P3-8: AUDIT â€” row count conservation check
# ------------------------------------------------------------
print("\n=== Pipeline 2 AUDIT ===")

# Capture counts once â€” avoids re-triggering plan serialization
cnt_in        = JE_raw_pipe_3.count()
cnt_otm       = DATASET_ONE_TO_MANY.count()
cnt_sync      = DATASET_1_1_DATE_SYNC.count()
cnt_unsync    = DATASET_1_1_DATE_UNSYNC.count()
cnt_no_match  = DATASET_NO_MATCH_FOUND.count()

total_in  = cnt_in
total_out = cnt_otm + cnt_sync + cnt_unsync + cnt_no_match

print(f"\n  {'Dataset':<45} {'Count':>10}")
print(f"  {'-'*55}")
print(f"  {'INPUT  â€” JE_raw_pipe_3':<45} {total_in:>10,}")
print(f"  {'OUTPUT â€” DATASET_ONE_TO_MANY':<45} {cnt_otm:>10,}")
print(f"  {'OUTPUT â€” DATASET_1_1_DATE_SYNC':<45} {cnt_sync:>10,}")
print(f"  {'OUTPUT â€” DATASET_1_1_DATE_UNSYNC':<45} {cnt_unsync:>10,}")
print(f"  {'OUTPUT â€” DATASET_NO_MATCH_FOUND':<45} {cnt_no_match:>10,}")
print(f"  {'-'*55}")
print(f"\n  [AUDIT] Total IN  : {total_in:>10,}")
print(f"  [AUDIT] Total OUT : {total_out:>10,}")
print(f"  [AUDIT] Diff      : {total_in - total_out:>10,}  â† should be 0")

assert total_in == total_out, (
    f"Row count mismatch! IN={total_in:,}  OUT={total_out:,}  "
    f"DIFF={total_in - total_out:,}"
)
# ------------------------------------------------------------
# STEP P3-9: WRITE OUTPUTS
# ------------------------------------------------------------
print("\n[STEP P3-9] Writing Pipeline 2 outputs...")

write_table(DATASET_ONE_TO_MANY,     "P3_DATASET_ONE_TO_MANY")
write_table(DATASET_1_1_DATE_SYNC,   "P3_DATASET_1_1_DATE_SYNC")
write_table(DATASET_1_1_DATE_UNSYNC, "P3_DATASET_1_1_DATE_UNSYNC")
write_table(DATASET_NO_MATCH_FOUND,  "P3_DATASET_NO_MATCH_FOUND")

