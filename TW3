def append_raw_tb_cy_to_sheet(
    template, raw_tb_CY, spark_column_row_pairs_cy, target_sheet,
    anchor_cell=TABLE_ANCHOR_CELL, calculated_columns=None, clear_existing=True,
    materiality=None, row_id_col="row_id",
):
    """
    Write raw_tb_CY into `target_sheet` starting at `anchor_cell`.

    - Rows that are non-zero % and 'Test consolidated amount' == 'No'
      are written normally (blue cells shown in BLUE_FONT_COLOR).
    - Every other row is greyed out (account name only, rest blanked).
    - On QUANTITATIVE_SHEET only, each visible account also gets two
      "detail" sub-rows (% of total / multiple of materiality per
      entity) and D&T's calculated columns are inserted.
    """
    if target_sheet not in template.sheetnames:
        raise ValueError(f"Worksheet not found: {target_sheet!r}")

    if row_id_col not in raw_tb_CY.columns:
        raise ValueError(f"Missing row ID column: {row_id_col!r}")

    worksheet = template[target_sheet]

    # row_id is used for matching only and is not written to Excel.
    source_columns = [c for c in raw_tb_CY.columns if c != row_id_col]

    if calculated_columns is None:
        calculated_columns = CALCULATED_COLUMNS
    calculated_columns = _unique_texts(calculated_columns)

    if target_sheet != QUANTITATIVE_SHEET:
        calculated_columns = []

    output_columns = _arrange_output_columns(source_columns, calculated_columns)
    calculated_keys = {_normalise_column_name(c) for c in calculated_columns}

    blue_pair_keys = _build_existing_cy_pair_lookup(
        spark_column_row_pairs_cy, raw_tb_CY, row_id_col=row_id_col,
    )

    account_column = _require_column(source_columns, "Account")
    percentage_column = _require_column(source_columns, "% of consolidated balance")
    test_column = _require_column(source_columns, "Test consolidated amount")

    entity_columns = []
    consolidated_column = None
    untested_column = None

    if calculated_columns:
        if materiality is None:
            materiality = MATERIALITY

        entity_columns = _find_residual_entity_columns(source_columns, calculated_columns)
        consolidated_column = _require_column(source_columns, "Consolidated")
        untested_column = _require_column(source_columns, "Untested Balance")

    header_row, start_column = coordinate_to_tuple(anchor_cell)

    if clear_existing:
        _clear_existing_table(worksheet, header_row, start_column)

    # ---- Style palette for this sheet, built from the shared factories ----
    header_fill = make_fill(WHITE)
    white_fill = make_fill(WHITE)
    grey_fill = make_fill(GREY_OUT_FILL)

    body_border = make_border(BLACK)
    header_border = make_border(BLACK)
    no_border = Border()

    header_font = make_font(BLACK, name="Arial", size=9, bold=True)
    body_font = make_font(BLACK, name="Arial", size=9)
    greyed_out_font = make_font(GREYED_OUT_FONT_COLOR, name="Arial", size=9)
    blue_font = make_font(BLUE_FONT_COLOR, name="Arial", size=9)

    header_alignment = make_alignment("center", "center", wrap=True)
    # NOTE: body_alignment only sets vertical="center" in the original code
    # (horizontal defaults to openpyxl's "general") — kept as plain
    # Alignment() rather than make_alignment() so that default isn't changed.
    body_alignment = Alignment(vertical="center")

    _write_table_headers(
        worksheet, header_row, start_column, output_columns,
        header_fill, header_border, header_font, header_alignment,
    )

    _write_analysis_headers(
        worksheet, header_row, start_column, output_columns, calculated_columns,
        header_fill, header_border, header_font, header_alignment,
    )

    account_output_index = output_columns.index(account_column)
    data_start_row = header_row + 1
    records_written = 0
    detail_rows_written = 0
    package_ranges = []

    blue_pairs_applied = set()
    blue_pairs_skipped_grey = set()
    blue_pairs_encountered = set()

    for record in _source_records(raw_tb_CY, source_columns, row_id_col=row_id_col):
        source_row_id = record[row_id_col]
        if source_row_id is None:
            raise ValueError("raw_tb_CY contains a null row_id.")
        source_row_id = int(source_row_id)

        keep_row_visible = (
            _is_nonzero(record.get(percentage_column))
            and _is_no(record.get(test_column))
        )

        analysis_values = {}
        if calculated_columns:
            analysis_values = _calculate_analysis_values(
                record=record, source_row_id=source_row_id,
                entity_columns=entity_columns, blue_pair_keys=blue_pair_keys,
                materiality=materiality, consolidated_column=consolidated_column,
                untested_column=untested_column,
            )

        package_start_row = data_start_row + records_written

        for index, column_label in enumerate(output_columns):
            cell = worksheet.cell(row=package_start_row, column=start_column + index)

            normalized = _normalise_column_name(column_label)
            is_account_cell = index == account_output_index
            is_calculated = normalized in calculated_keys

            blue_key = (column_label, source_row_id)
            selected_blue = blue_key in blue_pair_keys

            if selected_blue:
                blue_pairs_encountered.add(blue_key)

            if not keep_row_visible:
                cell.alignment = body_alignment
                cell.number_format = "General"
                cell.border = no_border

                if is_account_cell:
                    cell.value = record.get(account_column)
                    cell.fill = PatternFill(fill_type=None)
                    cell.font = greyed_out_font
                else:
                    cell.value = None
                    cell.fill = grey_fill
                    cell.font = body_font

                if selected_blue:
                    blue_pairs_skipped_grey.add(blue_key)

                continue

            if is_calculated:
                cell.value = analysis_values.get(column_label)
            else:
                cell.value = record.get(column_label)
                if normalized == _normalise_column_name(percentage_column):
                    cell.value = _to_excel_percentage(cell.value)

            cell.fill = white_fill
            cell.border = body_border
            cell.font = body_font
            cell.alignment = body_alignment

            if cell.value not in (None, "") and _to_decimal(cell.value) is not None:
                cell.number_format = _number_format(column_label)
            else:
                cell.number_format = "General"

            if selected_blue and not is_calculated:
                cell.font = blue_font
                blue_pairs_applied.add(blue_key)

        records_written += 1

        if target_sheet == QUANTITATIVE_SHEET and keep_row_visible:
            percentage_row = data_start_row + records_written
            _write_detail_row(
                worksheet=worksheet, row_number=percentage_row, start_column=start_column,
                output_columns=output_columns, account_column=account_column,
                entity_columns=entity_columns, record=record,
                consolidated_column=consolidated_column, materiality=materiality,
                label=ENTITY_PERCENT_DETAIL_LABEL, calculation_type="percentage",
                white_fill=white_fill, body_border=body_border, body_font=body_font,
            )
            records_written += 1
            detail_rows_written += 1

            multiple_row = data_start_row + records_written
            _write_detail_row(
                worksheet=worksheet, row_number=multiple_row, start_column=start_column,
                output_columns=output_columns, account_column=account_column,
                entity_columns=entity_columns, record=record,
                consolidated_column=consolidated_column, materiality=materiality,
                label=ENTITY_MULTIPLE_DETAIL_LABEL, calculation_type="multiple",
                white_fill=white_fill, body_border=body_border, body_font=body_font,
            )
            records_written += 1
            detail_rows_written += 1

            package_ranges.append((package_start_row, data_start_row + records_written - 1))

    end_column = start_column + len(output_columns) - 1

    if target_sheet == QUANTITATIVE_SHEET:
        for package_start, package_end in package_ranges:
            _apply_package_borders(
                worksheet=worksheet, package_start_row=package_start,
                package_end_row=package_end, start_column=start_column, end_column=end_column,
            )

    data_end_row = data_start_row + records_written - 1 if records_written else header_row

    worksheet.auto_filter.ref = (
        f"{get_column_letter(start_column)}{header_row}:"
        f"{get_column_letter(end_column)}{data_end_row}"
    )
    worksheet.freeze_panes = f"{get_column_letter(start_column)}{data_start_row}"
    worksheet.row_dimensions[header_row].height = 32
    worksheet.sheet_view.showGridLines = False

    not_encountered = blue_pair_keys - blue_pairs_encountered

    print(f"[{target_sheet}] Detail rows:", detail_rows_written)
    print(f"[{target_sheet}] Blue cells applied:", len(blue_pairs_applied))
    print(f"[{target_sheet}] Greyed blue pairs:", len(blue_pairs_skipped_grey))
    print(f"[{target_sheet}] CY pairs not encountered:", len(not_encountered))

    return {
        "sheet": target_sheet,
        "output_columns": output_columns,
        "entity_columns": entity_columns,
        "detail_rows_written": detail_rows_written,
        "blue_cells_applied": len(blue_pairs_applied),
        "not_encountered": len(not_encountered),
    }


