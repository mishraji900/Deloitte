def s3a_build_blue_pair_lookups(spark_column_row_pairs_cy, row_id_col=ROW_ID_COLUMN_NAME):
    """Return (exact, normalized) sets of (column, row_id) blue-cell pairs for fast membership checks."""
    exact_pairs = set()
    normalized_pairs = set()
    row_id_key = s3a_normalize(row_id_col)

    for pair in spark_column_row_pairs_cy or []:
        try:
            column_name, source_row_id = pair
        except (TypeError, ValueError):
            continue

        if column_name is None:
            continue
        if s3a_normalize(column_name) == row_id_key:
            continue

        try:
            source_row_id = int(source_row_id)
        except (ValueError, TypeError):
            continue

        if source_row_id < 1:
            continue

        column_name = str(column_name).strip()
        exact_pairs.add((column_name, source_row_id))
        normalized_pairs.add((s3a_normalize(column_name), source_row_id))

    return exact_pairs, normalized_pairs


def s3a_is_blue_cell(entity_column, source_row_id, blue_exact_pairs, blue_normalized_pairs):
    try:
        source_row_id = int(source_row_id)
    except (ValueError, TypeError):
        return False

    return (
        (str(entity_column).strip(), source_row_id) in blue_exact_pairs
        or (s3a_normalize(entity_column), source_row_id) in blue_normalized_pairs
    )


def s3a_build_residual_rows(updated_raw_tb_CY, materiality, row_id_col=ROW_ID_COLUMN_NAME):
    """Accounts qualifying for Sheet 3a: visible (non-zero %, Test == 'No') AND |Untested Balance| > materiality."""
    materiality_value = s3a_to_decimal(materiality)
    if materiality_value in {None, Decimal("0")}:
        raise ValueError("MATERIALITY must be a non-zero number.")

    source_columns = list(updated_raw_tb_CY.columns)
    records = s3a_get_records(updated_raw_tb_CY)

    row_id_column = s3a_require_column(source_columns, row_id_col)
    account_column = s3a_require_column(source_columns, ACCOUNT_COLUMN_NAME)
    percentage_column = s3a_require_column(source_columns, PERCENTAGE_COLUMN_NAME)
    test_column = s3a_require_column(source_columns, TEST_COLUMN_NAME)
    untested_column = s3a_require_column(source_columns, UNTESTED_COLUMN_NAME)

    residual_rows = []

    for record in records:
        raw_row_id = record.get(row_id_column)
        try:
            source_row_id = int(raw_row_id)
        except (ValueError, TypeError):
            raise ValueError(f"Invalid {row_id_col}: {raw_row_id!r}")

        if source_row_id < 1:
            raise ValueError(f"{row_id_col} must be positive.")

        account_name = record.get(account_column)
        if s3a_normalize(account_name) == "":
            continue

        percentage_value = s3a_to_decimal(record.get(percentage_column))
        if percentage_value in {None, Decimal("0")}:
            continue

        if s3a_normalize(record.get(test_column)) != "no":
            continue

        untested_value = s3a_to_decimal(record.get(untested_column))
        if untested_value is None:
            continue

        if abs(untested_value / materiality_value) <= Decimal("1"):
            continue

        residual_rows.append({
            "Account_CY": account_name,
            "row_id": source_row_id,
            "record": record,
        })

    residual_rows.sort(key=lambda row: row["row_id"])
    return residual_rows


def s3a_build_tab2_row_lookup(template):
    """Map normalized account name -> row number in the Tab 2 sheet, for the Total/Difference cross-check."""
    if TAB_2_SHEET not in template.sheetnames:
        raise ValueError(f"Worksheet {TAB_2_SHEET!r} not found. Available: {template.sheetnames}")

    worksheet = template[TAB_2_SHEET]
    lookup = {}

    for row_number in range(1, worksheet.max_row + 1):
        account_key = s3a_normalize_account(worksheet.cell(row=row_number, column=2).value)
        if account_key and account_key not in lookup:
            lookup[account_key] = row_number

    return lookup


