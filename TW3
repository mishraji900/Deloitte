# =============================================================================
def write_s1_table1(ws, row: int, group_totals: "OrderedDict[str, dict]", cfg: dict, acct_group_val: str) -> int:
    B, C, D, E, F = 2, 3, 4, 5, 6
    col_cur = cfg["col_current"]
    col_pri = cfg["col_prior"]
    
    wc(ws, row, B, f"Table 1: {acct_group_val} Summary", font=BOLD, align=LEFT)
    row += 1
    
    # "Carrying value / Fluctuation" header row
    wc(ws, row, B, None, border=MED_BOX)
    
    safe_merge(ws, row, C, row, D)
    wc(ws, row, C, "Carrying Value", font=BOLD, border=MED_BOX, align=CENTER)
    _apply_border_to_merge(ws, row, C, D, MED_BOX)
    
    safe_merge(ws, row, E, row, F)
    wc(ws, row, E, "Fluctuation", font=BOLD, border=MED_BOX, align=CENTER)
    _apply_border_to_merge(ws, row, E, F, MED_BOX)
    row += 1
    
    # Sub-header row (column labels)
    for col_idx, label in [
        (B, "Type of currencies"),
        (C, cfg["label_current"]),
        (D, cfg["label_prior"]),
        (E, "$"),
        (F, "%")
    ]:
        wc(ws, row, col_idx, label, font=HDR_FONT, border=THIN_ALL, align=LEFT if col_idx == B else CENTER)
    row += 1
    
    # Data rows
    grand_cur = 0.0
    grand_pri = 0.0
    
    for group_name, totals in group_totals.items():
        cur_val = totals.get(col_cur, 0.0)
        pri_val = totals.get(col_pri, 0.0)
        fluct_abs = cur_val - pri_val
        fluct_pct = (fluct_abs / pri_val) if pri_val != 0 else 0.0
        
        grand_cur += cur_val
        grand_pri += pri_val
        
        wc(ws, row, B, group_name, font=NORMAL, border=THIN_ALL, align=LEFT)
        wc(ws, row, C, cur_val, font=NORMAL, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
        wc(ws, row, D, pri_val, font=NORMAL, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
        wc(ws, row, E, fluct_abs, font=NORMAL, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
        wc(ws, row, F, fluct_pct, font=NORMAL, border=THIN_ALL, fmt=PCT_FMT, align=RIGHT)
        row += 1
        
    # Total row
    g_fluct_abs = grand_cur - grand_pri
    g_fluct_pct = (g_fluct_abs / grand_pri) if grand_pri != 0 else 0.0
    
    wc(ws, row, B, f"Total {acct_group_val}", font=BOLD, border=THIN_ALL, align=LEFT)
    wc(ws, row, C, grand_cur, font=BOLD, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
    wc(ws, row, D, grand_pri, font=BOLD, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
    wc(ws, row, E, g_fluct_abs, font=BOLD, border=THIN_ALL, fmt=MILLION_FMT, align=RIGHT)
    wc(ws, row, F, g_fluct_pct, font=BOLD, border=THIN_ALL, fmt=PCT_FMT, align=RIGHT)
    
    return row + 2


