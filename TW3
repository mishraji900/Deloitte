# =====================================================================
# SECTION 9 — "3b. Residual Analytic by entity" sheet
# =====================================================================
# For every account meeting the Tab-3b criterion ({b}: |diff| >
# threshold AND |diff%| > 15%), write a per-entity CY/PY/Difference
# block, unioning CY entities with any PY-only entities that no
# longer exist in the CY workbook.
# =====================================================================

from openpyxl.utils import get_column_letter as _s3b_get_column_letter, range_boundaries

SHEET_3B = "3b. Residual Analytic by entity"

ROW_ACCT_HEADER = 9
ROW_SUB_HEADER = 10
ROW_SOURCE_LABEL = 11
ROW_DATA_START = 12

COL_ENTITY = 2
COL_DATA_START = 3

SUB_COLS = ["CY balances", "PY balance", "Difference ($)", "Difference (%)", "Investigate?"]
SRC_LBLS = ["Tab 2", "XXXXX", "Rx", "Rx", "{b}"]
N_SUB = 5

THRESHOLD_REF = "$C$7"

_WHT = "FFFFFFFF"
_NAVY = "FF1F3864"
_ACCT_HDR = "FF8EA9DB"
_BLK = "FF000000"
_RED_FONT = "FFFF0000"
_RED_FILL = "FFFFCBCB"
_GRN_FILL = "FFC6EFCE"
_PY_ONLY = "FFFFFDE7"
_GREY_FILL = "FFD9D9D9"
_GREY_FONT = "FF808080"

MONEY_FMT = '#,##0;(#,##0);"-"'
PCT_FMT = "0%"


# ---- Style helpers ----

def _side():
    return Side(style="thin", color=_BLK)


def _border():
    return make_border(_BLK)


def _no_border():
    return Border()


def _fill(hex_color):
    return make_fill(hex_color)


def _align(h="center", v="center", wrap=False):
    return make_alignment(h, v, wrap=wrap)


def _font_hdr(color=_WHT):
    return make_font(color, bold=True)


def _font_src():
    return make_font(_RED_FONT, size=9, bold=True)


def _font_data():
    return make_font(_BLK)


def _font_grey():
    return make_font(_GREY_FONT)


# ---- Data helpers ----
# `_to_dec` / `_is_grey` / `_norm` reuse the SHARED UTILITIES parsers.
# The original `_to_dec` here didn't strip "$" or "%" or handle
# parenthesised negatives, but `to_decimal` is a strict superset of
# what it did, so nothing downstream changes behaviour.

_to_dec = to_decimal
_is_grey = is_grey_marker
_norm = normalize_text


def _get_records(df):
    if hasattr(df, "collect"):
        return [r.asDict(recursive=True) for r in df.collect()]
    if hasattr(df, "to_dict"):
        return df.to_dict(orient="records")
    return [dict(r) for r in df]


def _get_columns(df):
    if hasattr(df, "columns"):
        return list(df.columns)
    records = _get_records(df)
    return list(records[0].keys()) if records else []


def _unmerge_from_row9(ws):
    """Remove every merged range from row 9 downward so the previous run's account blocks don't linger."""
    to_remove = []
    for rng in list(ws.merged_cells.ranges):
        _, min_row, _, max_row = range_boundaries(str(rng))
        if max_row >= ROW_ACCT_HEADER:
            to_remove.append(str(rng))
    for ref in to_remove:
        ws.unmerge_cells(ref)


def _clear_from_row9(ws):
    """Wipe all content and style from row 9 downward."""
    for row in ws.iter_rows(min_row=ROW_ACCT_HEADER, max_row=ws.max_row):
        for cell in row:
            if isinstance(cell, MergedCell):
                continue
            cell.value = None
            cell.font = _font_data()
            cell.fill = _fill(_WHT)
            cell.border = _no_border()
            cell.number_format = "General"
            cell.alignment = Alignment()


def _filter_tab3b(residual_cy_py, threshold_value):
    """Tab-3b criterion {b}: |CY-PY| > threshold AND |(CY-PY)/CY| > 15%."""
    thresh = _to_dec(threshold_value)
    results = []

    for rec in _get_records(residual_cy_py):
        cy = _to_dec(rec.get("Untested_Balance_CY")) or Decimal("0")
        py = _to_dec(rec.get("Untested_Balance_PY")) or Decimal("0")
        diff = cy - py
        pct = (diff / cy) if cy != Decimal("0") else None

        if (
            thresh is not None
            and abs(diff) > thresh
            and pct is not None
            and abs(pct) > Decimal("0.15")
        ):
            results.append(rec)

    return results


def _build_lookup(records, account_col):
    lookup = {}
    for rec in records:
        key = _norm(rec.get(account_col, ""))
        if key:
            lookup[key] = rec
    return lookup


# row_id is excluded here so it never appears as a legal-entity row.
_SKIP_COLS = {
    "account", "test consolidated amount", "% of consolidated balance",
    "untested balance", "reference id", "significance", "consolidated", "row_id",
}


def _get_entity_columns(df, account_col):
    after = False
    ents = []
    for c in _get_columns(df):
        if _norm(c) == _norm(account_col):
            after = True
            continue
        if after and _norm(c) not in _SKIP_COLS:
            ents.append(c)
    return ents


def _build_combined_entities(cy_entity_cols, py_entity_cols):
    """CY entities first, then any PY-only entities appended (and flagged as 'py_only')."""
    cy_normed = {_norm(e): e for e in cy_entity_cols}
    combined = [(e, "cy") for e in cy_entity_cols]

    for py_ent in py_entity_cols:
        if _norm(py_ent) not in cy_normed:
            combined.append((py_ent, "py_only"))
            print(f"[3b] PY-only entity added: '{py_ent}'")

    return combined


def _write_row9_header(ws, col_start, col_end, acct_name):
    col_s_l = _s3b_get_column_letter(col_start)
    col_e_l = _s3b_get_column_letter(col_end)
    ws.merge_cells(f"{col_s_l}{ROW_ACCT_HEADER}:{col_e_l}{ROW_ACCT_HEADER}")

    anchor = ws.cell(row=ROW_ACCT_HEADER, column=col_start)
    anchor.value = acct_name
    anchor.font = _font_hdr(color=_BLK)
    anchor.fill = _fill(_ACCT_HDR)
    anchor.border = _border()
    anchor.alignment = _align("center", wrap=True)

    for c in range(col_start + 1, col_end + 1):
        try:
            mc = ws.cell(row=ROW_ACCT_HEADER, column=c)
            if not isinstance(mc, MergedCell):
                mc.fill = _fill(_ACCT_HDR)
                mc.border = _border()
        except Exception:
            pass


def _write_grey_cell(cell):
    """Empty the cell and apply grey styling (used for CY-grey or PY-grey pairs)."""
    cell.value = None
    cell.fill = _fill(_GREY_FILL)
    cell.font = _font_grey()
    cell.number_format = "General"
    cell.alignment = _align("center")
    cell.border = _border()


# COMMAND ----------

def populate_sheet_3b(
    template, updated_raw_tb_CY, updated_raw_tb_PY, residual_cy_py,
    threshold_value, account_col="Account", py_account_col=None,
):
    """Write the Tab-3b filtered accounts into Sheet 3b, one column-group per account, one row per legal entity."""
    if py_account_col is None:
        py_account_col = account_col

    ws = template[SHEET_3B]

    # 1. Filter qualifying accounts.
    tab3b_rows = _filter_tab3b(residual_cy_py, threshold_value)
    if not tab3b_rows:
        print("[3b] No Tab-3b accounts found - sheet not written.")
        return {"tab3b_accounts": [], "accounts_written": 0, "entity_rows_total": 0}

    # 2. Collect records from updated DataFrames.
    cy_records = _get_records(updated_raw_tb_CY)
    py_records = _get_records(updated_raw_tb_PY)

    # 3. Entity lists + lookups (row_id excluded via _SKIP_COLS).
    cy_entity_cols = _get_entity_columns(updated_raw_tb_CY, account_col)
    py_entity_cols = _get_entity_columns(updated_raw_tb_PY, py_account_col)

    cy_lookup = _build_lookup(cy_records, account_col)
    py_lookup = _build_lookup(py_records, py_account_col)

    combined_entities = _build_combined_entities(cy_entity_cols, py_entity_cols)

    py_only_count = sum(1 for _, s in combined_entities if s == "py_only")
    print(f"[3b] CY entities   : {len(cy_entity_cols)}")
    print(f"[3b] PY entities   : {len(py_entity_cols)}")
    print(f"[3b] Combined rows : {len(combined_entities)} ({py_only_count} PY-only appended)")
    print(f"[3b] Tab-3b accts  : {len(tab3b_rows)}")

    # 4. Unmerge + clear rows 9+.
    _unmerge_from_row9(ws)
    _clear_from_row9(ws)

    # 5. Col B header cells.
    b9 = ws.cell(row=ROW_ACCT_HEADER, column=COL_ENTITY)
    b9.fill = _fill(_ACCT_HDR)
    b9.border = _border()

    b10 = ws.cell(row=ROW_SUB_HEADER, column=COL_ENTITY)
    b10.value = "Legal Entity"
    b10.font = _font_hdr(color=_WHT)
    b10.fill = _fill(_NAVY)
    b10.border = _border()
    b10.alignment = _align("center", wrap=True)

    b11 = ws.cell(row=ROW_SOURCE_LABEL, column=COL_ENTITY)
    b11.fill = _fill(_WHT)
    b11.border = _border()

    # 6. Per-account header blocks (rows 9 / 10 / 11).
    for a_idx, rec in enumerate(tab3b_rows):
        acct_name = str(rec.get("Account_CY") or rec.get("Account_PY") or "").strip()
        cs = COL_DATA_START + a_idx * N_SUB
        ce = cs + N_SUB - 1

        _write_row9_header(ws, cs, ce, acct_name)

        for s, label in enumerate(SUB_COLS):
            sh = ws.cell(row=ROW_SUB_HEADER, column=cs + s)
            sh.value = label
            sh.font = _font_hdr(color=_WHT)
            sh.fill = _fill(_NAVY)
            sh.border = _border()
            sh.alignment = _align("center", wrap=True)

        for s, src in enumerate(SRC_LBLS):
            sl = ws.cell(row=ROW_SOURCE_LABEL, column=cs + s)
            sl.value = src
            sl.font = _font_src()
            sl.fill = _fill(_WHT)
            sl.border = _border()
            sl.alignment = _align("center")

    # Autofilter.
    last_col_l = _s3b_get_column_letter(COL_DATA_START + len(tab3b_rows) * N_SUB - 1)
    ws.auto_filter.ref = (
        f"{_s3b_get_column_letter(COL_ENTITY)}{ROW_SUB_HEADER}:{last_col_l}{ROW_SUB_HEADER}"
    )

    # 7. Data rows.
    for e_idx, (entity, source) in enumerate(combined_entities):
        data_row = ROW_DATA_START + e_idx
        row_fill = _fill(_PY_ONLY) if source == "py_only" else _fill(_WHT)

        ec = ws.cell(row=data_row, column=COL_ENTITY)
        ec.value = str(entity).strip()
        ec.font = _font_data()
        ec.fill = row_fill
        ec.border = _border()
        ec.alignment = _align("left")

        for a_idx, rec in enumerate(tab3b_rows):
            acct_key = _norm(str(rec.get("Account_CY") or rec.get("Account_PY") or ""))
            cs = COL_DATA_START + a_idx * N_SUB

            cy_rec = cy_lookup.get(acct_key, {})
            py_rec = py_lookup.get(acct_key, {})

            raw_cy = None if source == "py_only" else cy_rec.get(entity)
            raw_py = py_rec.get(entity)

            is_cy_grey = _is_grey(raw_cy)
            is_py_grey = _is_grey(raw_py)

            cy_val = None if is_cy_grey else _to_dec(raw_cy)
            py_val = None if is_py_grey else _to_dec(raw_py)

            cy_c = ws.cell(row=data_row, column=cs)
            py_c = ws.cell(row=data_row, column=cs + 1)
            dif_c = ws.cell(row=data_row, column=cs + 2)
            pct_c = ws.cell(row=data_row, column=cs + 3)
            inv_c = ws.cell(row=data_row, column=cs + 4)

            for cell in (cy_c, py_c, dif_c, pct_c, inv_c):
                cell.font = _font_data()
                cell.fill = row_fill
                cell.border = _border()

            # RULE: CY grey -> all 5 cells greyed.
            if is_cy_grey:
                _write_grey_cell(cy_c)
                _write_grey_cell(py_c)
                _write_grey_cell(dif_c)
                _write_grey_cell(pct_c)
                _write_grey_cell(inv_c)
                continue

            cy_c.value = float(cy_val) if cy_val is not None else None
            cy_c.number_format = MONEY_FMT if cy_val is not None else "General"
            cy_c.alignment = _align("right")

            # RULE: PY grey -> PY + downstream greyed.
            if is_py_grey:
                _write_grey_cell(py_c)
                _write_grey_cell(dif_c)
                _write_grey_cell(pct_c)
                _write_grey_cell(inv_c)
                continue

            py_c.value = float(py_val) if py_val is not None else None
            py_c.number_format = MONEY_FMT if py_val is not None else "General"
            py_c.alignment = _align("right")

            cy_addr = cy_c.coordinate
            py_addr = py_c.coordinate
            dif_addr = dif_c.coordinate
            pct_addr = pct_c.coordinate

            dif_c.value = (
                f'=IF(ISNUMBER({cy_addr}),IF(ISNUMBER({py_addr}),{cy_addr}-{py_addr},{cy_addr}),'
                f'IF(ISNUMBER({py_addr}),0-{py_addr},""))'
            )
            dif_c.number_format = MONEY_FMT
            dif_c.alignment = _align("right")

            pct_c.value = (
                f'=IFERROR(IF(AND(ISNUMBER({cy_addr}),{cy_addr}<>0),{dif_addr}/{cy_addr},'
                f'IF(ISNUMBER({py_addr}),1,0)),0)'
            )
            pct_c.number_format = PCT_FMT
            pct_c.alignment = _align("right")

            inv_c.value = (
                f'=IFERROR(IF(AND(ABS({dif_addr})>{THRESHOLD_REF},ABS({pct_addr})>0.15),"Yes","No"),"")'
            )
            inv_c.alignment = _align("center")

    # 8. Conditional formatting - Investigate? column.
    last_data_row = ROW_DATA_START + len(combined_entities) - 1
    for a_idx in range(len(tab3b_rows)):
        inv_l = _s3b_get_column_letter(COL_DATA_START + a_idx * N_SUB + 4)
        rng = f"{inv_l}{ROW_DATA_START}:{inv_l}{last_data_row}"
        ws.conditional_formatting.add(
            rng, FormulaRule(formula=[f'{inv_l}{ROW_DATA_START}="Yes"'], fill=PatternFill(fill_type="solid", fgColor=_RED_FILL), stopIfTrue=True),
        )
        ws.conditional_formatting.add(
            rng, FormulaRule(formula=[f'{inv_l}{ROW_DATA_START}="No"'], fill=PatternFill(fill_type="solid", fgColor=_GRN_FILL), stopIfTrue=True),
        )

    # 9. Column widths + freeze panes.
    ws.column_dimensions[_s3b_get_column_letter(COL_ENTITY)].width = 28
    for a_idx in range(len(tab3b_rows)):
        for s, w in enumerate([14, 14, 15, 13, 13]):
            ws.column_dimensions[_s3b_get_column_letter(COL_DATA_START + a_idx * N_SUB + s)].width = w

    ws.freeze_panes = ws.cell(row=ROW_DATA_START, column=COL_DATA_START)

    names = [str(r.get("Account_CY") or r.get("Account_PY") or "").strip() for r in tab3b_rows]
    print(f"[3b] Accounts written  : {len(tab3b_rows)} -> {names}")
    print(f"[3b] Total entity rows : {len(combined_entities)} (CY: {len(cy_entity_cols)}, PY-only appended: {py_only_count})")

    return {
        "sheet": SHEET_3B,
        "tab3b_accounts": names,
        "accounts_written": len(tab3b_rows),
        "entity_rows_cy": len(cy_entity_cols),
        "entity_rows_py_only": py_only_count,
        "entity_rows_total": len(combined_entities),
    }


# ---- Run ----

print("[3b] updated_raw_tb_CY columns ->", _get_columns(updated_raw_tb_CY))
print("[3b] updated_raw_tb_PY columns ->", _get_columns(updated_raw_tb_PY))

result_3b = populate_sheet_3b(
    template=template,
    updated_raw_tb_CY=updated_raw_tb_CY,
    updated_raw_tb_PY=updated_raw_tb_PY,
    residual_cy_py=residual_cy_py,
    threshold_value=THRESHOLD_VALUE,
    account_col="Account",
    py_account_col="Account",
)

print(result_3b)

