def safe_for_excel(df):
    drop_cols = [
        "pair_id",
        "pk_row_count",
        "row_id",
        "invoice_ref_clean",
        "cat_clean",
        "company_desc_clean",
        "vendor_num_clean",
        "eff_dt",
        "month_dt",
        "entered_net_dec",
        "abs_entered_dec",
        "abs_entered_key",
    ]

    df = df.drop(*drop_cols)

    front_cols = [
        "primary_key",
        "JE Category",
        "Net Entered",
        "Default Effective Date",

    ]

    remaining_cols = [c for c in df.columns if c not in front_cols]
    return df.select(*(front_cols + remaining_cols)).pandas_api()

    
