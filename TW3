def _write_row(ws, row, label, font, border, values: dict):
    sc = _START_COL
    wc(ws, row, sc, label, font=font, align=LEFT)
    for i, col in enumerate(BAL_COLS):
        wc(ws, row, sc + _BAL_OFF[i], float(values.get(col, 0)), 
           font=font, border=border, fmt=ACCT_FMT, align=RIGHT)
    for i, col in enumerate(FLUCT_COLS):
        wc(ws, row, sc + _FLUCT_OFF[i], float(values.get(col, 0)), 
           font=font, border=border, fmt=ACCT_FMT, align=RIGHT)

