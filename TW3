_PATH_ILLEGAL = re.compile(r'[^\w\s-]')  # keep word chars, spaces, hyphens
_MULTI_SPACE  = re.compile(r'\s+')

def _make_output_path(acct_group: str) -> str:
    clean = _PATH_ILLEGAL.sub('', acct_group)
    clean = _MULTI_SPACE.sub('_', clean.strip())
    clean = clean.strip('_')
    return f"{OUTPUT_DIRECTORY}/Risk_Assessment_{clean}.xlsx"

