def build_residual_join(updated_raw_tb_CY, updated_raw_tb_PY):
    """Full-outer-join CY and PY on (account_key, occurrence_number), sorted for stable output."""
    cy_greyed = (
        _spark_percentage_is_invalid(PERCENTAGE_COLUMN)
        | _spark_test_is_not_exact_no(TEST_COLUMN)
    )

    cy_source = (
        _add_account_occurrence_number(dataframe=updated_raw_tb_CY, account_column=ACCOUNT_COLUMN)
        .select(
            F.col(f"`{ACCOUNT_COLUMN}`").alias("Account_CY"),
            F.col("_account_key"),
            F.col("_account_occurrence"),
            F.col("_row_id").alias("CY_Row_ID"),
            _spark_numeric_or_null(UNTESTED_COLUMN).alias("Untested_Balance_CY"),
            cy_greyed.alias("CY_Greyed"),
        )
    )

    py_source = (
        _add_account_occurrence_number(dataframe=updated_raw_tb_PY, account_column=ACCOUNT_COLUMN)
        .select(
            F.col(f"`{ACCOUNT_COLUMN}`").alias("Account_PY"),
            F.col("_account_key"),
            F.col("_account_occurrence"),
            F.col("_row_id").alias("PY_Row_ID"),
            _spark_numeric_or_null(UNTESTED_COLUMN).alias("Untested_Balance_PY"),
        )
    )

    cy = cy_source.alias("cy")
    py = py_source.alias("py")

    join_condition = (
        (F.col("cy._account_key") == F.col("py._account_key"))
        & (F.col("cy._account_occurrence") == F.col("py._account_occurrence"))
    )

    joined = cy.join(py, join_condition, how="full_outer")

    result = joined.select(
        F.col("cy.Account_CY").alias("Account_CY"),
        F.col("cy.Untested_Balance_CY").alias("Untested_Balance_CY"),
        F.col("py.Account_PY").alias("Account_PY"),
        F.col("py.Untested_Balance_PY").alias("Untested_Balance_PY"),
        F.when(F.col("cy.Account_CY").isNull(), F.lit(True))
         .otherwise(F.coalesce(F.col("cy.CY_Greyed"), F.lit(True)))
         .alias("CY_Greyed"),
        F.col("cy.CY_Row_ID").alias("CY_Row_ID"),
        F.col("py.PY_Row_ID").alias("PY_Row_ID"),
        F.coalesce(F.col("cy.CY_Row_ID"), F.col("py.PY_Row_ID")).alias("_sort_row_id"),
        F.coalesce(F.col("cy._account_occurrence"), F.col("py._account_occurrence")).alias("_sort_occurrence"),
        F.coalesce(F.col("cy.Account_CY"), F.col("py.Account_PY")).alias("_sort_account"),
    )

    return (
        result
        .orderBy(
            F.col("_sort_row_id").asc_nulls_last(),
            F.col("_sort_occurrence").asc_nulls_last(),
            F.col("_sort_account").asc_nulls_last(),
        )
        .drop("_sort_row_id", "_sort_occurrence", "_sort_account")
    )


# `to_excel_number` (SHARED UTILITIES) is exactly what this section's
# original `_num()` did (Decimal -> float, grey marker -> None,
# passthrough otherwise) — reused here under its original short name.
_num = to_excel_number


def _apply_investigate_colors(worksheet, column_letters, non_grey_rows):
    """
    Static fill: green when the cached value is 'No', red for anything else.
    Conditional-formatting rules are added on top so the color also
    recalculates correctly if the formula result changes after Excel
    recalculates (e.g. after MATERIALITY is edited by hand).
    """
    for row_number in non_grey_rows:
        for key in ("inv1", "inv2"):
            cell_reference = f"{column_letters[key]}{row_number}"
            cell = worksheet[cell_reference]

            if isinstance(cell.value, str) and not cell.value.startswith("="):
                cell.fill = GREEN_FILL if cell.value.strip().casefold() == "no" else RED_FILL
            else:
                cell.fill = WHITE_FILL

            no_formula = f'IFERROR(UPPER(TRIM({cell_reference}))="NO",FALSE)'

            worksheet.conditional_formatting.add(
                cell_reference,
                FormulaRule(formula=[no_formula], fill=GREEN_FILL, stopIfTrue=True),
            )
            worksheet.conditional_formatting.add(
                cell_reference,
                FormulaRule(formula=[f"NOT({no_formula})"], fill=RED_FILL, stopIfTrue=True),
            )


def write_residual_analytic_sheet(template, residual_df, sheet_name=None, anchor_cell=RESIDUAL_ANALYTIC_ANCHOR_CELL):
    """Write the CY/PY residual join into the Residual Analytic tab, with live Excel formulas
    for Difference/%/Threshold/Investigate/Times-of-materiality."""
    if sheet_name is None:
        sheet_name = _resolve_residual_analytic_sheet(template)

    residual_rows = residual_df.collect()
    worksheet = template[sheet_name]

    header_row, start_column = coordinate_to_tuple(anchor_cell)
    label_row = header_row + 1
