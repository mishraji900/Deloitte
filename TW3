def apply_white_background(ws, df: pd.DataFrame):
    n_groups       = df[GROUP_COL].nunique()
    estimated_last = _START_ROW + len(df) + (n_groups * 3) + 80
    for r in range(1, estimated_last + 1):
        for c in range(1, _END_COL + 1):
            ws.cell(row=r, column=c).fill = WHITE_FILL
    print(f"White background applied rows 1-{estimated_last}")

def apply_white_background_s2(ws, n_rows: int = 250):
    for r in range(1, n_rows + 1):
        for c in range(1, 30): # Extended specifically to give charts a white backing
            ws.cell(row=r, column=c).fill = WHITE_FILL
    print(f"Sheet 2 white background applied rows 1-{n_rows}")

