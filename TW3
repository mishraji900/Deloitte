# ---- Spark helpers ----

def _spark_text(column_name):
    return F.trim(F.col(f"`{column_name}`").cast("string"))


def _spark_account_key(column_name):
    return F.regexp_replace(F.lower(_spark_text(column_name)), r"\s+", " ")


def _spark_account_is_valid(column_name):
    source = F.col(f"`{column_name}`")
    return source.isNotNull() & (_spark_text(column_name) != F.lit(""))


def _spark_numeric_or_null(column_name):
    """Same cleanup rules as `to_decimal` (strip commas/%, treat the grey marker as null), expressed as a Spark expression."""
    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))
    source_lower = F.lower(source_text)
    cleaned_text = F.regexp_replace(F.regexp_replace(source_text, ",", ""), "%", "")

    return F.when(
        source.isNull() | (source_text == F.lit("")) | (source_lower == F.lit(NULL_MARKER)),
        F.lit(None).cast("double"),
    ).otherwise(cleaned_text.cast("double"))


def _spark_percentage_is_invalid(column_name):
    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))
    cleaned_text = F.regexp_replace(F.regexp_replace(source_text, ",", ""), "%", "")
    numeric_value = cleaned_text.cast("double")

    return (
        source.isNull()
        | (source_text == F.lit(""))
        | numeric_value.isNull()
        | F.isnan(numeric_value)
        | (numeric_value == F.lit(0))
    )


def _spark_test_is_not_exact_no(column_name):
    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))
    return source.isNull() | (F.lower(source_text) != F.lit("no"))


def _find_row_id_column(dataframe):
    for column_name in dataframe.columns:
        if str(column_name).strip().casefold() == ROW_ID_COLUMN:
            return column_name
    raise KeyError(f"Required column {ROW_ID_COLUMN!r} was not found. Available columns: {dataframe.columns}")


def _add_account_occurrence_number(dataframe, account_column):
    """
    Number each occurrence of a repeated account name within a dataset,
    ordered by row_id. Used so CY row 3's "Cash" doesn't get matched to
    PY row 40's "Cash" out of order — matching occurrence-for-occurrence
    instead of just by name.
    """
    row_id_column = _find_row_id_column(dataframe)

    source = (
        dataframe
        .filter(_spark_account_is_valid(account_column))
        .withColumn("_account_key", _spark_account_key(account_column))
        .withColumn("_row_id", F.col(f"`{row_id_column}`").cast("long"))
        .withColumn("_source_tiebreaker", F.monotonically_increasing_id())
    )

    occurrence_window = (
        Window.partitionBy("_account_key")
        .orderBy(F.col("_row_id").asc_nulls_last(), F.col("_source_tiebreaker").asc())
    )

    return source.withColumn("_account_occurrence", F.row_number().over(occurrence_window))


