from decimal import Decimal, InvalidOperation

GREY_MARKER = "__grey__"  # the placeholder string written into cells that were manually blue-flagged


def is_grey_marker(value) -> bool:
    """True if `value` is the (case-insensitive) grey/blue-override placeholder string."""
    return isinstance(value, str) and value.strip().casefold() == GREY_MARKER


def to_decimal(value):
    """
    Best-effort conversion of a raw cell value into a Decimal.

    Returns None for: None, bool, the grey marker, NaN, or anything
    that doesn't parse as a number. Handles Spark/pandas numerics,
    Decimal passthrough, and Excel-style text ("$1,234", "12.5%",
    "(500)" for negative, stray "-" / em-dash placeholders).
    """
    if value is None or isinstance(value, bool) or is_grey_marker(value):
        return None

    if isinstance(value, Decimal):
        return value if value.is_finite() else None

    # Fast path for genuine numeric types (Spark Row values, floats, ints).
    if isinstance(value, (int, float)) or hasattr(value, "__float__"):
        try:
            numeric_value = float(value)
        except (ValueError, TypeError, OverflowError):
            numeric_value = None

        if numeric_value is not None:
            if numeric_value != numeric_value:  # NaN check (NaN != NaN)
                return None
            decimal_value = Decimal(str(round(numeric_value, 10)))
            return decimal_value if decimal_value.is_finite() else None

    # Fall back to text parsing for strings like "$1,234.56", "12.5%", "(500)".
    try:
        text = str(value).replace(",", "").replace("$", "").strip()

        if text.endswith("%"):
            text = text[:-1].strip()

        if text.startswith("(") and text.endswith(")"):
            text = "-" + text[1:-1]

        if text in {"", "-", "\u2014", GREY_MARKER}:  # "-" or an em dash placeholder
            return None

        decimal_value = Decimal(text)
        return decimal_value if decimal_value.is_finite() else None

    except (InvalidOperation, ValueError, TypeError):
        return None


def to_excel_number(value):
    """
    Normalise a value for *writing* into an openpyxl cell: Decimal -> float,
    the grey marker -> None, everything else passed through unchanged.
    (Distinct from `to_decimal`, which is for *reading*/parsing values.)
    """
    if value is None:
        return None
    if is_grey_marker(value):
        return None
    if isinstance(value, Decimal):
        return float(value)
    return value


def normalize_text(value) -> str:
    """Whitespace-collapsed, case-folded string key — used for account-name matching."""
    if value is None:
        return ""
    return " ".join(str(value).replace("\u00a0", " ").strip().split()).casefold()


