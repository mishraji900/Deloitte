def replace_spark_cells(
    df: DataFrame,
    column_row_pairs: Iterable[Tuple[str, int]],
    row_id_col: str = "row_id",
    replacement: str = GREY_MARKER,
) -> DataFrame:
    """Replace selected cells (identified by column name + row_id) using the existing row_id column."""

    if row_id_col not in df.columns:
        raise ValueError(
            f"Missing row ID column: {row_id_col}"
        )

    targets = defaultdict(set)

    for column_name, row_id in column_row_pairs:
        if column_name not in df.columns:
            raise ValueError(
                f"Column not found: {column_name}"
            )

        if column_name == row_id_col:
            raise ValueError(
                f"Cannot replace the row ID column: {row_id_col}"
            )

        if row_id is None:
            raise ValueError(
                f"Invalid row_id for column: {column_name}"
            )

        row_id = int(row_id)

        if row_id < 1:
            raise ValueError(
                f"Invalid row_id: {row_id}"
            )

        targets[column_name].add(row_id)

    result = df

    for column_name, row_ids in targets.items():
        original = result[column_name]

        if not isinstance(
            df.schema[column_name].dataType,
            StringType,
        ):
            original = original.cast("string")

        result = result.withColumn(
            column_name,
            F.when(
                result[row_id_col].isin(sorted(row_ids)),
                F.lit(replacement),
            ).otherwise(original),
        )

    return result


