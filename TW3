def _clear_existing_table(worksheet, header_row, start_column):
    end_column = start_column + len(KEYS) - 1
    for row in worksheet.iter_rows(
        min_row=header_row, max_row=worksheet.max_row,
        min_col=start_column, max_col=end_column,
    ):
        for cell in row:
            if not isinstance(cell, MergedCell):
                cell.value = None
                cell.fill = WHITE_FILL


def _clear_conditional_formatting(worksheet):
    try:
        worksheet.conditional_formatting._cf_rules.clear()
    except AttributeError:
        pass


def _resolve_residual_analytic_sheet(template, hint=RESIDUAL_ANALYTIC_SHEET_HINT):
    """Find the residual-analytic sheet by (case-insensitive) substring, since its exact
    name carries a year-end date suffix that changes ("3. Residual Analytic 6-30-2026")."""
    target = hint.strip().casefold()
    matches = [s for s in template.sheetnames if target in s.strip().casefold()]

    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        raise ValueError(f"Multiple sheets match {hint!r}: {matches}")
    raise ValueError(f"No sheet matching {hint!r}. Available: {template.sheetnames}")


