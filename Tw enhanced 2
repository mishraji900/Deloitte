def write_all_charts(
        ws,
        first_data_row: int,
        last_data_row:  int,
        label_col:      int,
        # Value columns + labels
        cur_val_col:    int,
        cur_label:      str,
        pri1_val_col:   int,
        pri1_label:     str,
        pri2_val_col:   int   = None,
        pri2_label:     str   = None,
        type_val_col:   int   = None,
        type_label:     str   = "Type of accounts",
        # For Fig 3 pie (second pie row) — defaults to cur if omitted
        cur2_val_col:   int   = None,
        cur2_label:     str   = None,
        # Period strings for bar chart title
        cur_period:     str   = "9/30/2025",
        pri1_period:    str   = "6/30/2025",
        pri2_period:    str   = "9/30/2024",
        # Pie anchors
        anchor_fig1:    str   = "B12",
        anchor_fig2:    str   = "L12",
        anchor_fig3:    str   = "B42",
        anchor_fig4:    str   = "L42",
        # Bar anchor — None = auto (2 rows below last_data_row)
        anchor_bar:     str   = None,
        # Sizes
        pie_width:      float = 16,
        pie_height:     float = 12,
        bar_width:      float = 28,   # wide enough to mimic two charts merged
        bar_height:     float = 14,
) -> None:
    """
    Writes all charts to ws:
        Fig 1  Pie  current composition       → anchor_fig1
        Fig 2  Pie  prior-1 composition       → anchor_fig2
        Fig 3  Pie  current (alt) composition → anchor_fig3
        Fig 4  Pie  prior-2 composition       → anchor_fig4
        Bar    ONE combined comparison chart  → anchor_bar (auto if None)
    """
    print(f"\n  📊 Writing charts — {last_data_row - first_data_row + 1} categories ...")

    # ── Figs 1–4: Pie charts ──────────────────────────────────────────────
    write_pie_charts(
        ws             = ws,
        first_data_row = first_data_row,
        last_data_row  = last_data_row,
        label_col      = label_col,
        cur_val_col    = cur_val_col,
        cur_label      = cur_label,
        pri1_val_col   = pri1_val_col,
        pri1_label     = pri1_label,
        cur2_val_col   = cur2_val_col,
        cur2_label     = cur2_label,
        pri2_val_col   = pri2_val_col,
        pri2_label     = pri2_label,
        anchor_fig1    = anchor_fig1,
        anchor_fig2    = anchor_fig2,
        anchor_fig3    = anchor_fig3,
        anchor_fig4    = anchor_fig4,
        chart_width    = pie_width,
        chart_height   = pie_height,
    )

    # ── Single combined bar chart ─────────────────────────────────────────
    write_single_comparison_bar_chart(
        ws             = ws,
        first_data_row = first_data_row,
        last_data_row  = last_data_row,
        label_col      = label_col,
        cur_val_col    = cur_val_col,
        cur_label      = cur_label,
        pri1_val_col   = pri1_val_col,
        pri1_label     = pri1_label,
        pri2_val_col   = pri2_val_col,
        pri2_label     = pri2_label,
        type_val_col   = type_val_col,
        type_label     = type_label,
        chart_title    = (
            f"Cash {cur_period} VS {pri1_period}"
            + (f" VS {pri2_period}" if pri2_val_col else "")
        ),
        anchor         = anchor_bar,   # None = auto-anchor 2 rows below data
        chart_width    = bar_width,
        chart_height   = bar_height,
    )

    print("  ✅ All charts written.\n")

