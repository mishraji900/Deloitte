# DBTITLE 1,Config and Quarter Setup
# =============================================================================
# CELL 2 — DERIVE CURRENT_FY / PRIOR_FY / CURRENT_QUARTER FROM THE DATA
# =============================================================================
# Nothing here is picked by a user or read from output_path. CURRENT_FY is
# the calendar year with the highest max(year(Default Effective Date))
# across JE_raw and (if HAS_CF) JE_raw_2_aligned — i.e. whichever year the
# freshest row in either input belongs to. PRIOR_FY is just CURRENT_FY - 1.
# Neither value is stamped onto rows anywhere; every row's own "Source
# Quarter" / "Year Flag" is computed independently, per row, inside
# base_tag() (Cell 3) from that row's own eff_dt — CURRENT_FY/PRIOR_FY only
# feed the CY/PY label in resolve_to_original() and the output filename.
# =============================================================================

# Collect distinct years out of both inputs (guarded by HAS_CF so this
# still runs correctly if carry-forward is ever absent) into one column,
# then take the max — that's CURRENT_FY. -1 from it is PRIOR_FY.
_years_df = JE_raw.select(F.year(to_date_clean("Default Effective Date")).alias("yr"))
if HAS_CF:
    _years_df = _years_df.unionByName(
        JE_raw_2_aligned.select(F.year(to_date_clean("Default Effective Date")).alias("yr"))
    )

_year_rows = [r["yr"] for r in _years_df.where(F.col("yr").isNotNull()).distinct().collect()]
assert _year_rows, "Could not derive any year from Default Effective Date in the input data."

_max_year = max(_year_rows)
CURRENT_FY = f"FY{str(_max_year)[-2:]}"
PRIOR_FY   = f"FY{str(_max_year - 1)[-2:]}"

# CURRENT_QUARTER: the highest calendar quarter seen within CURRENT_FY,
# in JE_raw only (current-quarter data, not carry-forward) — used
# exclusively to name the final .xlsx file, has no effect on any matching
# or tagging logic.
_cq_rows = (
    JE_raw.withColumn("_yr", F.year(to_date_clean("Default Effective Date")))
          .withColumn("_q",  F.quarter(to_date_clean("Default Effective Date")))
          .where(F.col("_yr") == _max_year)
          .select("_q").distinct().collect()
)
_max_q = max([r["_q"] for r in _cq_rows]) if _cq_rows else 4
CURRENT_QUARTER = f"Q{_max_q}"

print(f"[CONFIG] Current FY (derived): {CURRENT_FY}  |  Prior FY (derived): {PRIOR_FY}")
print(f"[CONFIG] Current Quarter label (derived, for filename only): {CURRENT_QUARTER}")
print(f"[CONFIG] Carry-forward: always assumed present.")

