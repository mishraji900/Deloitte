def ensure_required_columns(df, required_cols: list):
    """Add missing columns as NULL strings; coalesce Company Description; handle Source Quarter."""
    for c in required_cols:
        if c not in df.columns:
            df = df.withColumn(c, F.lit(None).cast("string"))

    df = df.withColumn(
        "Company Description",
        F.coalesce(
            F.col("Company Description").cast("string"),
            F.col("Company").cast("string"),
        )
    )

    if "Source Quarter" in required_cols and "Source Quarter" not in df.columns:
        df = df.withColumn("Source Quarter", F.lit(None).cast("string"))

    return df.select(*required_cols)


def add_source_quarter_col(df, quarter_value: str):
    """Add a literal Source Quarter column to a DataFrame."""
    return df.withColumn("Source Quarter", F.lit(quarter_value))


def ensure_row_id(df):
    """Assign deterministic row_id via row_number over preferred sort key."""
    if "row_id" in df.columns:
        return df.withColumn("row_id", F.col("row_id").cast("string"))
    preferred = [
        "Company Description", "Vendor/Customer Number", "JE Category",
        "Default Effective Date", "Month", "Net Entered",
        "Invoice Reference", "JE Batch Id", "JE Line Number",
    ]
    order_cols = [c for c in preferred if c in df.columns] or sorted(df.columns)
    return df.withColumn(
        "row_id",
        F.row_number()
         .over(Window.orderBy(*[F.col(c).asc_nulls_last() for c in order_cols]))
         .cast("string"),
    )


