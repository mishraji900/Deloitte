def _build_pie(
        ws,
        fig_num:        int,
        title:          str,
        first_data_row: int,
        last_data_row:  int,
        label_col:      int,
        val_col:        int,
        chart_width:    float,
        chart_height:   float,
) -> PieChart:
    """Internal: builds a single pie chart object."""
    num_slices = last_data_row - first_data_row + 1

    chart             = PieChart()
    chart.title       = f"Figure {fig_num}: {title}"
    # ⚠️  chart.style intentionally omitted — setting any value forces
    #     Excel's theme palette and overrides DataPoint solidFill colours.
    chart.dataLabels  = _pie_labels()
    chart.legend      = _legend("r")
    chart.width       = chart_width
    chart.height      = chart_height

    data = Reference(ws, min_col=val_col,   min_row=first_data_row, max_row=last_data_row)
    cats = Reference(ws, min_col=label_col, min_row=first_data_row, max_row=last_data_row)

    chart.add_data(data, titles_from_data=False)
    chart.set_categories(cats)
    _color_pie_slices(chart, num_slices)

    return chart


def write_pie_charts(
        ws,
        first_data_row: int,
        last_data_row:  int,
        label_col:      int,
        # Fig 1 — current period
        cur_val_col:    int,
        cur_label:      str,            # e.g. "Sept 2025"
        # Fig 2 — prior-1 period
        pri1_val_col:   int,
        pri1_label:     str,            # e.g. "June 2025"
        # Fig 3 — current period (second row, same data different grouping or repeat)
        cur2_val_col:   int  = None,    # if None, reuses cur_val_col
        cur2_label:     str  = None,    # if None, reuses cur_label
        # Fig 4 — prior-2 period
        pri2_val_col:   int  = None,
        pri2_label:     str  = None,    # e.g. "Sept 2024"
        # Anchors
        anchor_fig1:    str  = "B12",
        anchor_fig2:    str  = "L12",
        anchor_fig3:    str  = "B42",
        anchor_fig4:    str  = "L42",
        chart_width:    float = 16,
        chart_height:   float = 12,
) -> None:
    """
    Writes four pie charts onto ws:
        Fig 1  current composition            → anchor_fig1 (default B12)
        Fig 2  prior-1 composition            → anchor_fig2 (default L12)
        Fig 3  current composition (row 2)    → anchor_fig3 (default B42)
        Fig 4  prior-2 composition            → anchor_fig4 (default L42)
    """
    # Fall back for optional Fig 3/4 columns
    cur2_val_col = cur2_val_col or cur_val_col
    cur2_label   = cur2_label   or cur_label
    pri2_val_col = pri2_val_col or pri1_val_col
    pri2_label   = pri2_label   or pri1_label

    charts = [
        (1, f"{cur_label} - Composition",  cur_val_col,  anchor_fig1),
        (2, f"{pri1_label} - Composition", pri1_val_col, anchor_fig2),
        (3, f"{cur2_label} - Composition", cur2_val_col, anchor_fig3),
        (4, f"{pri2_label} - Composition", pri2_val_col, anchor_fig4),
    ]

    for fig_num, title, val_col, anchor in charts:
        chart = _build_pie(
            ws             = ws,
            fig_num        = fig_num,
            title          = title,
            first_data_row = first_data_row,
            last_data_row  = last_data_row,
            label_col      = label_col,
            val_col        = val_col,
            chart_width    = chart_width,
            chart_height   = chart_height,
        )
        ws.add_chart(chart, anchor)
        print(f"  ✅ Fig {fig_num} Pie  '{title}' → '{anchor}'")


