def _path_exists(path: str) -> bool:
    try:
        jvm = spark._jvm
        hconf = spark._jsc.hadoopConfiguration()
        jpath = jvm.org.apache.hadoop.fs.Path(path)
        fs = jpath.getFileSystem(hconf)
        return fs.exists(jpath)
    except Exception as e:
        print(f"[WARN] _path_exists unexpected error for {path}: {e}")
        return False


def write_table(df, name: str, log: bool = True, base_path: str = None):
    if df is None:
        print(f"  [SKIP] {name} – no data")
        return
    path = f"{base_path or output_path}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    if log:
        print(f"  [WRITTEN] {path}")


def materialize_df(df, name: str, repartition_key: str = None,
                   stage_path: str = None, num_partitions: int = NUM_PARTITIONS):
    print(f"  [MATERIALIZE] {name}")
    base = stage_path or output_path
    if repartition_key and repartition_key in df.columns:
        df = df.repartition(num_partitions, repartition_key)
    path = f"{base}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    return cp.read(path)


# NOTE: debug_count / debug_group_count / audit_summary are the "major" data
# reporting calls (per user request) — they now render via Databricks
# display() instead of print(), so counts/profiles/audits show as proper
# tables in the notebook output. exhaustive_match()'s internal per-iteration
