def debug_count(label: str, df, width: int = 55):
    """Show a one-row [Metric, Count] table via display() instead of printing text."""
    n = df.count() if df is not None else None
    row_df = spark.createDataFrame([(label, n)], ["Metric", "Count"])
    display(row_df)


def debug_group_count(df, col_name: str, label: str, limit: int = 20):
    """Show a groupBy(col_name).count() breakdown via display() instead of .show()."""
    print(f"\n  [PROFILE] {label}")
    profiled = (
        df.groupBy(col_name)
          .count()
          .orderBy(F.desc("count"), F.asc(col_name))
          .limit(limit)
    )
    display(profiled)


def audit_summary(datasets: dict):
    """Show a [Dataset, Count] table (+ TOTAL row) via display() instead of printing text."""
    rows  = []
    total = 0
    ok    = True
    for label, df in datasets.items():
        if df is None:
            rows.append((label, None))
            ok = False
        else:
            n      = df.count()
            total += n
            rows.append((label, n))
    rows.append(("TOTAL", total))
    summary_df = spark.createDataFrame(rows, ["Dataset", "Count"])
    display(summary_df)
    return ok


def export_to_excel(sheets: dict, path: str):
    _front = ["primary_key", "JE Category", "Net Entered",
              "Default Effective Date", "Source Quarter"]
    _drop  = {
        "pair_id", "pk_row_count", "row_id", "invoice_ref_clean", "cat_clean",
        "company_desc_clean", "vendor_num_clean", "eff_dt", "month_dt",
        "entered_net_dec", "abs_entered_dec", "abs_entered_key",
        "is_valid_row", "valid_company_desc", "valid_vendor_num", "abs_usd_net",
        "p3_primary_key",
    }

    def _prep(df):
        if df is None:
            return None
        df            = df.drop(*[c for c in _drop if c in df.columns])
        present_front = [c for c in _front if c in df.columns]
        rest          = [c for c in df.columns if c not in present_front]
        return df.select(*(present_front + rest)).pandas_api()

    cp.pandas.to_excel(
        dataframes  =[_prep(df) for df in sheets.values()],
        sheet_names =list(sheets.keys()),
        path        =path,
    )
    print(f"  [EXCEL] Written → {path}")


