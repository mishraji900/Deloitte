# ── Colour appliers ───────────────────────────────────────────────────────────

def _color_pie_slices(chart: PieChart, num_slices: int) -> None:
    """
    Assigns APPROVED_COLORS to each pie slice.
    num_slices is passed explicitly — no outer-scope dependency.
    NOTE: chart.style must NOT be set; any non-None value forces Excel's
    built-in theme palette and overrides all DataPoint solidFill values.
    """
    if not chart.series:
        return
    series = chart.series[0]
    for i in range(num_slices):
        pt = DataPoint(idx=i)
        pt.graphicalProperties.solidFill = APPROVED_COLORS[i % len(APPROVED_COLORS)]
        series.dPt.append(pt)


def _color_bar_series(series, hex_color: str) -> None:
    """Solid fill + matching border on a single bar series."""
    series.graphicalProperties.solidFill      = hex_color
    series.graphicalProperties.line.solidFill = hex_color


