# SHEET 1 — TABLE 2: Materiality Multiple
# ══════════════════════════════════════════════════════════════════════════════

def write_s1_table2(ws, row: int, group_totals: "OrderedDict[str, dict]",
                    cfg: dict, acct_group_val: str) -> int:
    B, C, D = _START_COL, _START_COL + 1, _START_COL + 2
    mat     = cfg["materiality"] / 1_000_000

    wc(ws, row, B, "Materiality Multiple", font=BOLD_ITALIC, align=LEFT)
    row += 2

    for col_idx, label in [
        (B, "Type of currencies"),
        (C, cfg["label_current"]),
        (D, cfg["label_prior"]),
    ]:
        wc(ws, row, col_idx, label, font=HDR_FONT, border=THIN_ALL,
           align=LEFT if col_idx == B else CENTER)
    row += 1

    for group_name, totals in group_totals.items():
        cur_val = totals.get(cfg["col_current"], 0.0) / mat
        pri_val = totals.get(cfg["col_prior"],   0.0) / mat

        for col_idx, val, fmt in [
            (B, group_name, None),
            (C, cur_val,    MILLION_FMT),
            (D, pri_val,    MILLION_FMT),
        ]:
            wc(ws, row, col_idx, val, font=NORMAL, border=THIN_ALL,
               fmt=fmt, align=LEFT if col_idx == B else RIGHT)
        row += 1

    print(f"  ✅ Table 2 (S1) written ending at row {row - 1}")
    return row + 1


# ══════════════════════════════════════════════════════════════════════════════
# SHEET 1 — MAIN WRITER
# ══════════════════════════════════════════════════════════════════════════════

def write_sheet1_summary(ws, df: pd.DataFrame,
                         acct_group_val: str) -> "OrderedDict[str, dict]":
    apply_white_background(ws, df)
    _enable_outline(ws)
    write_sheet_header(ws, acct_group_val)
    write_header_row(ws, df)

    current_row  = _START_ROW
    group_totals = OrderedDict()

    for group_name, df_group in df.groupby(GROUP_COL, sort=False):
        current_row, subtotals = _s1_write_group(
            ws, df_group, current_row, group_name
        )
        group_totals[group_name] = subtotals

    current_row = _s1_write_grand_total(ws, df, current_row, acct_group_val)
    current_row = _s1_write_year_end_box(ws, current_row)
    current_row = write_materiality_box(ws, current_row, TABLE_CONFIG)
    current_row = write_s1_table1(ws, current_row, group_totals,
                                  TABLE_CONFIG, acct_group_val)
    current_row = write_s1_table2(ws, current_row, group_totals,
                                  TABLE_CONFIG, acct_group_val)

    print(f"  ✅ Summary sheet fully written — last row: {current_row}")
    print(f"     Groups: {list(group_totals.keys())}")
    return group_totals


