# MAIN PIPELINE
# ══════════════════════════════════════════════════════════════════════════════

def run() -> None:
    """
    Entry point.

    Workflow per account group
    ──────────────────────────
    1.  Convert TB_Final (Spark DataFrame) to pandas once.
    2.  For each account group in Account_Grp_List:
        a. Filter + validate + coerce numerics  (prepare_data)
        b. Load a fresh copy of the template workbook
           (prevents state bleed between iterations).
        c. Copy the three template sheets and rename them:
               <group>-Sum   ← Summary
               <group>-Ana   ← Analysis
               <group>-Tick  ← Tickmarks
        d. Write each sheet via its respective writer function.
        e. Optionally delete the original template sheets.
        f. Save workbook to its own output path.
    3.  Report succeeded / skipped / failed counts.
    """

    # ── 0. Convert Spark → pandas once ───────────────────────────────────────
    print("=" * 70)
    print("  Converting TB_Final from Spark to pandas …")
    try:
        df_full = TB_Final.toPandas()
    except Exception as exc:
        print(f"  ❌ Could not convert TB_Final: {exc}")
        raise

    print(f"  TB_Final shape: {df_full.shape}")
    print("=" * 70)

    # ── 1. Counters ───────────────────────────────────────────────────────────
    succeeded = []
    skipped   = []
    failed    = []

    # ── 2. Main loop ──────────────────────────────────────────────────────────
    for acct_group in Account_Grp_List:
        print(f"\n{'─' * 70}")
        print(f"  ▶  Processing: '{acct_group}'")
        print(f"{'─' * 70}")

        # ── 2a. Filter / validate / coerce ───────────────────────────────────
        try:
            df = prepare_data(df_full, acct_group)
        except ValueError as exc:
            print(f"  ⏭  SKIPPED '{acct_group}': {exc}")
            skipped.append(acct_group)
            continue

        # ── 2b. Load a fresh template for every group ─────────────────────────
        try:
            wb = cp.openpyxl.read(TEMPLATE_PATH)
        except Exception as exc:
            print(f"  ❌ FAILED to load template for '{acct_group}': {exc}")
            failed.append(acct_group)
            continue

        # ── 2c. Resolve sheet names for this group ────────────────────────────
        sum_name  = _make_sheet_name(acct_group, "Sum")
        ana_name  = _make_sheet_name(acct_group, "Ana")
        tick_name = _make_sheet_name(acct_group, "Tick")

        # ── 2d. Copy template sheets ──────────────────────────────────────────
        try:
            ws_summary   = _copy_sheet_from_template(
                wb, TEMPLATE_SHEET_SUMMARY, sum_name
            )
            ws_analysis  = _copy_sheet_from_template(
                wb, TEMPLATE_SHEET_ANALYSIS, ana_name
            )
            ws_tickmarks = _copy_sheet_from_template(
                wb, TEMPLATE_SHEET_TICKMARKS, tick_name
            )
        except KeyError as exc:
            print(f"  ❌ FAILED to copy template sheets "
                  f"for '{acct_group}': {exc}")
            failed.append(acct_group)
            continue

        # ── 2e. Write Sheet 1 — Summary ───────────────────────────────────────
        try:
            group_totals = write_sheet1_summary(
                ws_summary, df, acct_group
            )
        except Exception as exc:
            print(f"  ❌ FAILED writing Sheet 1 for '{acct_group}': {exc}")
            failed.append(acct_group)
            continue

        # ── 2f. Write Sheet 2 — Analysis ──────────────────────────────────────
        try:
            write_sheet2_analysis(
                ws_analysis, group_totals, acct_group
            )
        except Exception as exc:
            print(f"  ❌ FAILED writing Sheet 2 for '{acct_group}': {exc}")
            failed.append(acct_group)
            continue

        # ── 2g. Write Sheet 3 — Tickmarks ─────────────────────────────────────
        try:
            write_sheet3_tickmarks(ws_tickmarks, acct_group)
        except Exception as exc:
            print(f"  ⚠️  WARNING writing Sheet 3 for '{acct_group}': {exc}")
            # Sheet 3 is a stub — non-fatal; do not count as a full failure

        # ── 2h. Optionally delete original template sheets ────────────────────
        if DELETE_TEMPLATE_SHEETS:
            for tmpl_name in [
                TEMPLATE_SHEET_SUMMARY,
                TEMPLATE_SHEET_ANALYSIS,
                TEMPLATE_SHEET_TICKMARKS,
            ]:
                if tmpl_name in wb.sheetnames:
                    del wb[tmpl_name]
                    print(f"  🗑️  Deleted template sheet: '{tmpl_name}'")

        # ── 2i. Save workbook ─────────────────────────────────────────────────
        output_path = _make_output_path(acct_group)
        try:
            cp.openpyxl.write(wb, output_path, register=True)
            print(f"  💾 Saved → {output_path}")
            succeeded.append(acct_group)
        except Exception as exc:
            print(f"  ❌ FAILED to save '{acct_group}': {exc}")
            failed.append(acct_group)

    # ── 3. Final summary ──────────────────────────────────────────────────────
    print(f"\n{'=' * 70}")
    print(f"  ✅  SUCCEEDED : {len(succeeded):>3}  —  {succeeded}")
    print(f"  ⏭   SKIPPED   : {len(skipped):>3}  —  {skipped}")
    print(f"  ❌  FAILED    : {len(failed):>3}  —  {failed}")
    print(f"{'=' * 70}\n")


# ══════════════════════════════════════════════════════════════════════════════
# ENTRY POINT
# ══════════════════════════════════════════════════════════════════════════════

run()
