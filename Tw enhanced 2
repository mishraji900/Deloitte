def _parse_eff_date(df, col_name: str = "Default Effective Date"):
    """Best-effort parse of the raw effective-date string column into DateType."""
    raw = F.trim(F.col(col_name).cast("string"))
    return F.coalesce(
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "M/d/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )

_years_df = JE_raw.select(F.year(_parse_eff_date(JE_raw)).alias("yr"))
if 'JE_raw_2_aligned' in globals() and JE_raw_2_aligned is not None:
    _years_df = _years_df.unionByName(
        JE_raw_2_aligned.select(F.year(_parse_eff_date(JE_raw_2_aligned)).alias("yr"))
    )

_year_rows = [r["yr"] for r in _years_df.where(F.col("yr").isNotNull()).distinct().collect()]
assert _year_rows, "Could not derive any year from Default Effective Date in the input data."

_max_year = max(_year_rows)
CURRENT_FY = str(_max_year)
PRIOR_FY   = str(_max_year - 1)

# CURRENT_QUARTER is now just a display label (max quarter seen within
# CURRENT_FY) — used only for the final output filename, not for tagging.
_cq_rows = (
    JE_raw.withColumn("_yr", F.year(_parse_eff_date(JE_raw)))
          .withColumn("_q",  F.quarter(_parse_eff_date(JE_raw)))
          .where(F.col("_yr") == _max_year)
          .select("_q").distinct().collect()
)
_max_q = max([r["_q"] for r in _cq_rows]) if _cq_rows else 4
CURRENT_QUARTER = f"Q{_max_q}"

