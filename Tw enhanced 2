def _s2_table2_materiality(ws, row: int,
                           group_totals: "OrderedDict[str, dict]",
                           cfg: dict,
                           acct_group_val: str) -> int:
    B, C, D, E, F = _S2_B, _S2_C, _S2_D, _S2_E, _S2_F

    col1 = cfg["t2_col1"]
    col2 = cfg["t2_col2"]
    col3 = cfg["t2_col3"]
    mat  = cfg["materiality"] / 1_000_000

    # ── Title ─────────────────────────────────────────────────────────────────
    wc(ws, row, B, "Table 2: Materiality Multiple", font=BOLD_ITALIC, align=LEFT)
    row += 2

    # ── Header row ────────────────────────────────────────────────────────────
    for col_idx, label in [
        (B, "Type of accounts"),
        (C, cfg["t2_label1"]),
        (D, cfg["t2_label2"]),
        (E, cfg["t2_label3"]),
        (F, "Commentary"),
    ]:
        wc(ws, row, col_idx, label, font=HDR_FONT, border=THIN_ALL,
           align=LEFT if col_idx == B else CENTER)
    row += 1

    data_row_start = row     # used for commentary column vertical merge

    # ── Grand Total row ───────────────────────────────────────────────────────
    grand_c1 = sum(t.get(col1, 0.0) for t in group_totals.values())
    grand_c2 = sum(t.get(col2, 0.0) for t in group_totals.values())
    grand_c3 = sum(t.get(col3, 0.0) for t in group_totals.values())

    for col_idx, val, fmt in [
        (B, f"Total {acct_group_val}", None),
        (C, grand_c1 / mat,            MILLION_FMT),
        (D, grand_c2 / mat,            MILLION_FMT),
        (E, grand_c3 / mat,            MILLION_FMT),
    ]:
        wc(ws, row, col_idx, val, font=BOLD, border=THIN_ALL,
           fmt=fmt, align=LEFT if col_idx == B else RIGHT)
    row += 1

    # ── Group detail rows ─────────────────────────────────────────────────────
    for group_name, totals in group_totals.items():
        v1 = totals.get(col1, 0.0) / mat
        v2 = totals.get(col2, 0.0) / mat
        v3 = totals.get(col3, 0.0) / mat

        for col_idx, val, fmt in [
            (B, group_name, None),
            (C, v1,         MILLION_FMT),
            (D, v2,         MILLION_FMT),
            (E, v3,         MILLION_FMT),
        ]:
            wc(ws, row, col_idx, val, font=NORMAL, border=THIN_ALL,
               fmt=fmt, align=LEFT if col_idx == B else RIGHT)
        row += 1

    data_row_end = row - 1

    # ── Commentary column — single vertical merge ─────────────────────────────
    safe_merge(ws, data_row_start, F, data_row_end, F)
    wc(ws, data_row_start, F, "",
       font=NORMAL, border=THIN_ALL, align=LEFT_WRAP)
    for r in range(data_row_start + 1, data_row_end + 1):
        ws.cell(row=r, column=F).border = THIN_ALL

    print(f"  ✓ Table 2 (S2) written ending at row {data_row_end}")
    return row + 2


