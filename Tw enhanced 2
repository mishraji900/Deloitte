def _detect_quarter_from_string(s: str):
    """Try to extract Qn from path/filename strings."""
    m = re.search(r'Q([1-4])', s, re.IGNORECASE)
    return f"Q{m.group(1)}" if m else None


def _prompt_quarter(widget_name: str, prompt_text: str = "Select Quarter"):
    """
    Register (or reuse) a dropdown widget with plain Q1-Q4 choices.
    - widget_name must be unique per call to avoid Databricks collision errors.
    - defaultValue 'Q1' is always verbatim present in the choices list.
    - try/except makes the cell safe to re-run without detach/reattach.
    """
    try:
        dbutils.widgets.dropdown(
            widget_name,
            "Q1",
            ["Q1", "Q2", "Q3", "Q4"],
            prompt_text,
        )
    except Exception:
        # Widget already registered from a prior run â€” reuse it
        pass
    return dbutils.widgets.get(widget_name)


