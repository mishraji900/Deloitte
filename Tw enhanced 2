BASE_RAW_COLUMNS = [
    "Company Description", "JE Batch Id", "Batch Name", "Batch Created By", "JE Header Name", "User Name", "Month", "Default Effective Date", "Posted Date", "JE Category", "Journal Description", "JE Line Number", "Line Description", "Currency Code", "Je Source", "Ledger", "Account Description", "Invoice Reference", "Journal Line Vendor/Customer", "Vendor/Customer Name", "Vendor PO#", "Vendor/Customer Number", "COA", "Company", "Business", "Location", "Department/Cost Center", "Natural Account", "Product", "Revenue Type", "Intercompany", "Future1", "Future2", "Accounted Dr", "Accounted Cr", "Entered Dr", "Entered CR", "Net Entered", "Net Accounted"
]

# PIPE2_RAW_COLUMNS: same as above, plus "Year Flag" / "Source Quarter" —
# Pipeline 2 and 3 carry these two derived columns through their schema
# contract because base_tag() re-derives (overwrites) them from each row's
# own Default Effective Date every time it runs, on every pipeline. Listing
# them here just means ensure_required_columns() won't null-pad them away
# before base_tag() gets a chance to (re)compute them.
PIPE2_RAW_COLUMNS = BASE_RAW_COLUMNS + ["Year Flag", "Source Quarter"]

# DECIMAL_TYPE / EXACT_ZERO: every dollar amount in the pipeline is cast to
# this DecimalType(38,6) so "sales_amt + credit_amt == 0" comparisons are
# exact (no float rounding drift). EXACT_ZERO is that literal, pre-cast, so
# every "==EXACT_ZERO" check downstream compares like-for-like types.
DECIMAL_TYPE       = T.DecimalType(38, 6)
EXACT_ZERO         = F.lit(0).cast(DECIMAL_TYPE)
SMALL_AMT_MAX      = 5      # AA Rule 3 Priority 3 threshold — see assign_aa_comment()
P3_TOLERANCE       = 100    # Pipeline 3's "up to $100 difference" tolerance-match ceiling
NUM_PARTITIONS     = 400    # repartition width used everywhere a primary_key-keyed shuffle happens

# ---------------- AA Comment rule labels ----------------
# These are the exact strings written into the "AA Comment" column on every
# row that comes out of Pipeline 3 still unmatched (see assign_aa_comment(),
# Cell 3). Client-facing text — changing these changes what appears in the
# final Excel "Unmatched_Items" sheet, not just an internal label.
AA_ONE_TO_MANY          = "One to Many"                                              # Rule Group 1: row was one of several tolerance-match candidates, so it's flagged for manual review instead of auto-picked
AA_EXACT_MATCH_SYNC     = "Exact Match (There is a lag of more than two month)"       # Rule 2a exact: within-tolerance pair where sales predates credit, but by more than the 2-step lag Pipeline 1/2 already covers
AA_EXACT_MATCH_UNSYNC   = "Exact match (Credit memo occures before sales invoice)"    # Rule 2b exact: within-tolerance pair where the credit memo's effective date is actually BEFORE the sales invoice's
AA_APPROX_MATCH         = "Upto $100 Difference"                                     # Rule 2a/2b approx: same two date-order cases as above, but the pair's net amount isn't exactly zero — it's within P3_TOLERANCE
AA_ONLY_CREDITS         = "Only Credit Memos Present"                                 # Rule 3 Priority 1: this vendor has zero Sales Invoices anywhere in the raw data — there is nothing for this credit memo to ever match against
AA_SINGLE_CREDIT_COMBO  = "Single Credit Memo with One Combination"                    # Rule 3 Priority 2: this vendor has exactly one distinct (vendor, amount) credit-memo combination — one memo, so nothing to reconcile against
AA_SMALL_AMOUNT         = "Small Amount"                                              # Rule 3 Priority 3: |amount| <= SMALL_AMT_MAX — immaterial, flagged rather than chased
AA_CLIENT_CONFIRM       = "Client to Confirm"                                         # Rule 3 Priority 4 (catch-all): none of the above — genuinely unexplained, needs a human

# Globals populated by Cell 2 (derived from the data itself — no widgets,
# no output_path parsing, no manual quarter/year selection anywhere).
CURRENT_QUARTER              = None   # display label only (e.g. "Q3"), used solely in the final .xlsx filename
CURRENT_FY                   = None   # e.g. "FY26" — the max calendar year seen in Default Effective Date, across JE_raw + JE_raw_2_aligned
PRIOR_FY                     = None   # CURRENT_FY - 1, e.g. "FY25" — kept for reference; Year Pair Flag logic (resolve_to_original) no longer requires an exact match to this, see Cell 3
STAGE_PATH_P1 = STAGE_PATH_P2 = STAGE_PATH_P3 = None   # per-pipeline scratch/checkpoint directories, set for real in Cell 2


# to_date_clean(): the one and only Default-Effective-Date parser in the
# notebook. Lives here (not in Cell 3, where the rest of the type-cleaning
# helpers live) because Cell 2's year/quarter derivation needs it and Cell 2
# runs before Cell 3. Every date-format variant seen in raw exports is
# tried via coalesce, first match wins: US slash dates, ISO dates, and two
# "dd-MMM-yy(yy)" spellings, plus a timestamp fallback.
def to_date_clean(col_name: str):
    raw = F.trim(F.col(col_name).cast("string"))
    return F.coalesce(
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "M/d/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )


# HAS_CF: true if the prior-year carry-forward frame exists and isn't None.
# Computed exactly once here; every later cell that needs to know "is
# carry-forward data actually available" (Cell 2's year scan, Pipeline 2's
# input build, Cell 7's vendor-stats source) reads this same flag instead
# of re-evaluating the globals() check itself.
HAS_CF = 'JE_raw_2_aligned' in globals() and JE_raw_2_aligned is not None


