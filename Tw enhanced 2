def write_single_comparison_bar_chart(
        ws,
        first_data_row:  int,
        last_data_row:   int,
        label_col:       int,
        # Value columns + display labels — pass None to omit any series
        cur_val_col:     int,
        cur_label:       str,           # e.g. "Carrying Value Sept 2025"
        pri1_val_col:    int,
        pri1_label:      str,           # e.g. "Carrying Value June 2025"
        pri2_val_col:    int   = None,
        pri2_label:      str   = None,  # e.g. "Carrying Value Sept 2024"
        type_val_col:    int   = None,
        type_label:      str   = "Type of accounts",
        # Chart title
        chart_title:     str   = "Cash — Period Comparison",
        # Anchor — computed dynamically if not overridden
        anchor:          str   = None,
        chart_width:     float = 28,    # wider = both old charts merged
        chart_height:    float = 14,
) -> None:
    """
    Writes ONE single clustered bar chart comparing all periods.

    Replaces the old two-chart approach (Fig 3 + Fig 4 side-by-side).
    Series order matches your image legend:
        [yellow] Type of accounts
        [navy]   Carrying Value cur
        [green]  Carrying Value pri-1
        [blue]   Carrying Value pri-2   (omitted if pri2_val_col=None)

    anchor is auto-calculated as 2 rows below last_data_row if not supplied.
    """

    # ── Dynamic anchor: 2 rows below the data table ───────────────────────
    if anchor is None:
        anchor_row = last_data_row + 2
        anchor     = f"B{anchor_row}"

    # ── Build series list ─────────────────────────────────────────────────
    # Order: type → cur → pri1 → pri2
    series_spec: list[tuple[int, str, str]] = []

    if type_val_col is not None:
        series_spec.append((type_val_col, type_label, BAR_COLORS[0]))

    series_spec.append((cur_val_col,  cur_label,  BAR_COLORS[1]))
    series_spec.append((pri1_val_col, pri1_label, BAR_COLORS[2]))

    if pri2_val_col is not None:
        series_spec.append((pri2_val_col, pri2_label, BAR_COLORS[3]))

    # ── Chart shell ───────────────────────────────────────────────────────
    chart                   = BarChart()
    chart.type              = "col"
    chart.grouping          = "clustered"
    chart.title             = chart_title
    chart.y_axis.numFmt     = "#,##0.00"
    chart.y_axis.title      = None
    chart.x_axis.title      = None
    chart.x_axis.tickLblPos = "low"
    chart.width             = chart_width
    chart.height            = chart_height

    # Legend at bottom — matches your image
    lg          = Legend()
    lg.position = "b"
    lg.overlay  = False
    chart.legend = lg

    # ── Categories (X-axis labels) ────────────────────────────────────────
    cats = Reference(
        ws,
        min_col=label_col,
        min_row=first_data_row,
        max_row=last_data_row,
    )

    # ── Add each series ───────────────────────────────────────────────────
    for idx, (val_col, label, hex_color) in enumerate(series_spec):
        data = Reference(
            ws,
            min_col=val_col,
            min_row=first_data_row,
            max_row=last_data_row,
        )
        chart.add_data(data, titles_from_data=False)

        series        = chart.series[idx]
        series.title  = SeriesLabel(v=label)
        series.dLbls  = _bar_labels()
        _color_bar_series(series, hex_color)

    chart.set_categories(cats)

    ws.add_chart(chart, anchor)

    print(
        f"  ✅ Bar chart '{chart_title}' → '{anchor}' "
        f"| {len(series_spec)} series "
        f"| {last_data_row - first_data_row + 1} categories"
    )


