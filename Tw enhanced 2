        "Other_Unique_PKs":    all_unique_other,
        "P1_MATCHED_PAIRS":    P1_ALL_MATCHED,
        "P2_MATCHED_PAIRS":    P2_ALL_MATCHED,
        "Unmatched_Items":     P3_ALL_UNMATCHED_COMMENTED,
    },
    path=f"{output_path_et}/Tradeweb Securities Data Final - {CURRENT_FY} {CURRENT_QUARTER}.xlsx",
)

print("\n[FINAL] === END-TO-END ROW CONSERVATION CHECK ===")

# This is the top-level invariant the whole notebook is built around: every
# row in JE_raw must show up in exactly one of the 7 buckets below. Unlike
# Pipeline 3's internal check (Cell 6, a hard assert), this one is
# informational only — it deliberately doesn't assert, since
# JE_raw_2_aligned rows are legitimately included in some of these totals
# (via Pipeline 2) but total_raw only counts JE_raw, so some intentional
# "surplus" from carry-forward rows is expected and not a bug.
total_raw = JE_raw.count()

dfs = {
    "all_invalid": all_invalid,
    "all_exc_1": all_exc_1,
    "all_dup_other": all_dup_other,
    "all_unique_other": all_unique_other,
    "P1_ALL_MATCHED": P1_ALL_MATCHED,
    "P2_ALL_MATCHED": P2_ALL_MATCHED,
    "P3_ALL_UNMATCHED_COMMENTED": P3_ALL_UNMATCHED_COMMENTED,
}

_conservation_rows = [("Raw rows (JE_raw)", total_raw)]
total_out = 0
for name, df in dfs.items():
    if df is None:
        _conservation_rows.append((name, None))
        continue
    try:
        cnt = df.count()
        _conservation_rows.append((name, cnt))
        total_out += cnt
    except Exception as e:
        print(f"  [ERROR] {name} caused: {e}")
        raise

_conservation_rows.append(("Total out", total_out))
_conservation_rows.append(("Diff (Raw - Total out)", total_raw - total_out))
display(spark.createDataFrame(_conservation_rows, ["Dataset", "Count"]))

print("\n[DONE] All pipelines complete.")

