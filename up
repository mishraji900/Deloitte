def build_unmatched_rows(base_df, rem_sales_df, rem_credit_df, name: str, stage_path: str = None):
    """Purpose: Recovers full original rows for unmatched items."""
    remaining_ids = (
        rem_sales_df.select(F.col("sales_row_id").alias("row_id"))
        .unionByName(rem_credit_df.select(F.col("credit_row_id").alias("row_id")))
        .distinct()
    )
    return materialize_df(base_df.join(remaining_ids, on="row_id", how="inner"), name, "primary_key", stage_path=stage_path)

def resolve_to_original(pairs_df, base_df, match_label: str, stage_name: str, stage_path: str = None, has_year_flag: bool = False):
    """Purpose: Expands Slim pair IDs back to full original rows."""
    if pairs_df is None:
        return None
    w_pair = Window.orderBy(F.col("primary_key").asc(), F.col("sales_row_id").asc(), F.col("credit_row_id").asc())
    pairs_with_id = pairs_df.withColumn("pair_id", F.concat(F.lit(f"{match_label}_"), F.row_number().over(w_pair).cast("string"))).select("pair_id", "sales_row_id", "credit_row_id", "match_type")

    if has_year_flag:
        yf_sales = base_df.select(F.col("row_id").alias("sales_row_id"), F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("sales_year_flag"))
        yf_credit = base_df.select(F.col("row_id").alias("credit_row_id"), F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("credit_year_flag"))
        _sales_cy_py = F.when(F.col("sales_year_flag") == CURRENT_FY, F.lit("CY")).otherwise(F.lit("PY"))
        _credit_cy_py = F.when(F.col("credit_year_flag") == CURRENT_FY, F.lit("CY")).otherwise(F.lit("PY"))
        pairs_with_id = pairs_with_id.join(yf_sales, on="sales_row_id", how="left").join(yf_credit, on="credit_row_id", how="left").withColumn(
            "Year Pair Flag",
            F.when(F.col("sales_year_flag").isNull() | F.col("credit_year_flag").isNull(), F.lit("Unknown"))
            .otherwise(F.concat(_sales_cy_py, F.lit(" Sales Inv with "), _credit_cy_py, F.lit(" Credit Memo")))
        ).select("pair_id", "sales_row_id", "credit_row_id", "match_type", "Year Pair Flag")

    orig_cols = [F.col(f"orig.`{c}`") for c in base_df.columns]
    extra_meta = ["pair_id", "match_type"] + (["Year Pair Flag"] if has_year_flag else [])
    meta_cols = [F.col(c) for c in extra_meta if c not in base_df.columns]

    sales_side = pairs_with_id.join(base_df.alias("orig"), pairs_with_id["sales_row_id"] == F.col("orig.row_id"), "inner").select(*meta_cols, *orig_cols)
    credit_side = pairs_with_id.join(base_df.alias("orig"), pairs_with_id["credit_row_id"] == F.col("orig.row_id"), "inner").select(*meta_cols, *orig_cols)
    return materialize_df(sales_side.unionByName(credit_side), stage_name, "primary_key", stage_path=stage_path)

def _is_last_day_of_month(d: datetime.date) -> bool:
    return d.day == calendar.monthrange(d.year, d.month)[1]

def _spark_months_between_int(d_credit: datetime.date, d_sales: datetime.date) -> int:
    """Purpose: Replicates Spark's months_between EOM and integer rules."""
    if not d_credit or not d_sales:
        return -9999
    month_diff = (d_credit.year - d_sales.year) * 12 + (d_credit.month - d_sales.month)
    if d_credit.day == d_sales.day or (_is_last_day_of_month(d_credit) and _is_last_day_of_month(d_sales)):
        return int(month_diff)
    return int(round(month_diff + (d_credit.day - d_sales.day) / 31.0, 8))

def fast_in_memory_exhaustive_match(sales_df, credit_df, match_label: str, base_df, stage_path: str = None, has_year_flag: bool = False):
    """
    Purpose: Serverless-safe in-memory coordinator matching exact original sequential rank logic.
    Called by: run_match_pipeline() in Pipelines 1, 2, and 3.
    """
    print(f"\n[EXHAUSTIVE MATCH] {match_label} (Exact-Parity In-Memory Coordinator)")
    common_pks = sales_df.select("primary_key").distinct().join(credit_df.select("primary_key").distinct(), on="primary_key", how="inner")
    s_rows = sales_df.join(common_pks, on="primary_key", how="inner").select("primary_key", "sales_row_id", "sales_amt", "sales_eff_dt", "sales_month").dropDuplicates(["sales_row_id"]).collect()
    c_rows = credit_df.join(common_pks, on="primary_key", how="inner").select("primary_key", "credit_row_id", "credit_amt", "credit_eff_dt", "credit_month").dropDuplicates(["credit_row_id"]).collect()

    if not s_rows or not c_rows:
        display_metric(f"[{match_label}] Total pairs", 0)
        return None, sales_df, credit_df

    s_by_pk, c_by_pk = defaultdict(list), defaultdict(list)
    for r in s_rows: s_by_pk[r["primary_key"]].append(r)
    for r in c_rows: c_by_pk[r["primary_key"]].append(r)

    confirmed_pairs = []
    for pk, s_list in s_by_pk.items():
        c_list = c_by_pk.get(pk, [])
        if not c_list: continue
        used_s, used_c = set(), set()
        while True:
            rn_sales_1_survivors = []
            for s in s_list:
                s_id = s["sales_row_id"]
                if s_id in used_s: continue
                s_eff, s_amt, s_mon = s["sales_eff_dt"], s["sales_amt"], s["sales_month"]
                best_s_key, best_candidate = None, None
                for c in c_list:
                    c_id = c["credit_row_id"]
                    if c_id in used_c: continue
                    c_eff = c["credit_eff_dt"]
                    if not s_eff or not c_eff or s_eff > c_eff: continue
                    amt_diff = abs(s_amt + c["credit_amt"])
                    if amt_diff != 0: continue
                    m_lag = _spark_months_between_int(c["credit_month"], s_mon)
                    # Rule: Filter candidate pairs based on active matching step configuration
                    if match_label == "NEXT_MONTH_EXACT" and m_lag != 1: continue
                    elif match_label == "SAME_MONTH_EXACT" and m_lag != 0: continue
                    elif match_label == "LAG_1_2_MONTH" and not (1 <= m_lag <= 2): continue
                    elif match_label == "LAG_GT_2_MONTH" and not (m_lag > 2): continue

                    s_rank_key = (amt_diff, m_lag, c_eff, str(c_id))
                    if best_s_key is None or s_rank_key < best_s_key:
                        best_s_key = s_rank_key
                        best_candidate = (s, c, amt_diff, m_lag)
                if best_candidate: rn_sales_1_survivors.append(best_candidate)

            if not rn_sales_1_survivors: break

            best_for_c = {}
            for s, c, amt_diff, m_lag in rn_sales_1_survivors:
                s_id, c_id, s_eff = s["sales_row_id"], c["credit_row_id"], s["sales_eff_dt"]
                c_rank_key = (amt_diff, m_lag, s_eff, str(s_id))
                if c_id not in best_for_c or c_rank_key < best_for_c[c_id][0]:
                    best_for_c[c_id] = (c_rank_key, s_id)

            new_matches = 0
            for c_id, (_, winning_s_id) in best_for_c.items():
                confirmed_pairs.append((pk, winning_s_id, c_id, match_label))
                used_s.add(winning_s_id)
                used_c.add(c_id)
                new_matches += 1
            if new_matches == 0: break

    total_pairs = len(confirmed_pairs)
    display_metric(f"[{match_label}] Total pairs", total_pairs)
    if total_pairs == 0: return None, sales_df, credit_df

    slim_all = spark.createDataFrame(confirmed_pairs, schema=["primary_key", "sales_row_id", "credit_row_id", "match_type"])
    matched_s_ids = slim_all.select("sales_row_id").distinct()
    matched_c_ids = slim_all.select("credit_row_id").distinct()
    rem_sales = sales_df.join(matched_s_ids, on="sales_row_id", how="left_anti")
    rem_credit = credit_df.join(matched_c_ids, on="credit_row_id", how="left_anti")
    resolved = resolve_to_original(slim_all, base_df, match_label, f"RESOLVED_{match_label}", stage_path, has_year_flag)
    return resolved, rem_sales, rem_credit

MATCH_STEPS = [("NEXT_MONTH_EXACT", None), ("SAME_MONTH_EXACT", None), ("LAG_1_2_MONTH", None)]
LAG_GT_2_STEPS = [("LAG_GT_2_MONTH", None)]

def run_match_pipeline(sales_df, credit_df, base_df, steps: list, stage_path: str, has_year_flag: bool = False):
    """
    Purpose: Iterates through defined match steps sequentially.
    Called by: Pipeline cells 1, 2, and 3.
    """
    resolved_datasets, cur_s, cur_c = [], sales_df, credit_df
    for match_label, _ in steps:
        resolved, cur_s, cur_c = fast_in_memory_exhaustive_match(cur_s, cur_c, match_label, base_df, stage_path=stage_path, has_year_flag=has_year_flag)
        resolved_datasets.append((match_label, resolved))
    return resolved_datasets, cur_s, cur_c

