def write_table(df, name: str, log: bool = True, base_path: str = None):
    if df is None:
        print(f"  [SKIP] {name} – no data")
        return None
    path = f"{base_path or output_path}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    if log:
        print(f"  [WRITTEN] {path}")
    return path


def materialize_df(df, name: str, repartition_key: str = None,
                   stage_path: str = None, num_partitions: int = NUM_PARTITIONS,
                   force_write: bool = False):
    """
    Lightweight pass-through by default on Serverless so intermediate filter
    splits do not waste time and staging storage writing dozens of Parquet files.
    Set force_write=True only when an explicit disk checkpoint is desired.
    """
    if df is None:
        return None
    if repartition_key and repartition_key in df.columns:
        df = df.repartition(num_partitions, repartition_key)
    if force_write:
        print(f"  [MATERIALIZE TO DISK] {name}")
        path = write_table(df, name, log=False, base_path=stage_path)
        return cp.read(path)
    return df


