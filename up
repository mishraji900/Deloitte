    "Transaction Fees": ["Transaction Fees - Fixed", "Transaction Fees - Variable"],
}

def _normalize_text(value):
    if value is None: return ""
    value = str(value).strip().replace("–", "-").replace("—", "-")
    return re.sub(r"\s+", " ", value).upper()

def _union_non_null(*dfs):
    valid_dfs = [df for df in dfs if df is not None]
    if not valid_dfs: return spark.createDataFrame([], "Account Description string")
    return reduce(lambda a, b: a.unionByName(b, allowMissingColumns=True), valid_dfs)

def _build_group_lookup():
    lookup = {}
    for group_name, members in ACCOUNT_GROUPS.items():
        for member in members: lookup[_normalize_text(member)] = group_name
    return lookup

GROUP_LOOKUP = _build_group_lookup()

def _group_name_for_account(account_desc):
    normalized = _normalize_text(account_desc)
    return GROUP_LOOKUP.get(normalized, account_desc.strip() if account_desc else "Unmapped")

def _safe_sheet_name(name: str) -> str:
    cleaned = re.sub(r"[\[\]\:\*\?\/\\]", "_", str(name)).strip()
    return cleaned[:31] if cleaned else "Sheet"

def _with_je_category(df):
    if df is None: return None
    if "JE Category" in df.columns:
        return df.withColumn("JE Category", F.when(F.trim(F.col("JE Category")) == "", F.lit("Blank")).otherwise(F.coalesce(F.trim(F.col("JE Category")), F.lit("Blank"))))
    return df.withColumn("JE Category", F.lit("Unspecified"))

def build_company_summary(company_desc: str):
    company_key = company_desc.strip().upper()
    per_company = {sheet_name: _with_je_category(df.filter(F.upper(F.trim(F.col("Company Description"))) == F.lit(company_key))) if df is not None else None for sheet_name, df in SUMMARY_DATASETS.items()}

    acct_values = (
        _union_non_null(*[df.select(F.trim(F.col("Account Description")).alias("Account Description")) for df in per_company.values() if df is not None])
        .filter(F.col("Account Description").isNotNull())
        .filter(F.trim(F.col("Account Description")) != "")
        .distinct().orderBy("Account Description").collect()
    )

    raw_accounts = [r["Account Description"] for r in acct_values]
    grouped_accounts = {}
    for acct in raw_accounts:
        grp = _group_name_for_account(acct)
        grouped_accounts.setdefault(grp, []).append(acct)

    ordered_group_names = ["Total"] + [g for g in ACCOUNT_GROUPS.keys() if g in grouped_accounts] + sorted([g for g in grouped_accounts.keys() if g not in ACCOUNT_GROUPS])
    rows = []

    for grp in ordered_group_names:
        rows.append([f"Account Grouping: {grp}", None, None, None, None, None])
        rows.append(["Sheet Name", "JE Category", "Count", "Entered Dr", "Entered CR", "Net Entered"])

        group_total_cnt, group_total_dr, group_total_cr, group_total_net = 0, 0.0, 0.0, 0.0
        group_members = None if grp == "Total" else grouped_accounts.get(grp, [])

        for sheet_name, df in per_company.items():
            if df is None:
                rows.append([sheet_name, "No Data", 0, 0.0, 0.0, 0.0])
                rows.append([f"{sheet_name} Total", "", 0, 0.0, 0.0, 0.0])
                continue

            sub = df if grp == "Total" else df.filter(F.trim(F.col("Account Description")).isin(group_members))

            # Bug Fix: to_decimal_clean applied to currency columns before sum prevents comma/parentheses strings from evaluating to null/0.0
            je_summary = (
                sub.groupBy("JE Category")
                .agg(
                    F.count("primary_key").alias("cnt"),
                    F.sum(to_decimal_clean("Entered Dr")).alias("dr"),
                    F.sum(to_decimal_clean("Entered CR")).alias("cr"),
                    F.sum(to_decimal_clean("Net Entered")).alias("net"),
                )
                .orderBy("JE Category").collect()
            )

            sheet_total_cnt, sheet_total_dr, sheet_total_cr, sheet_total_net = 0, 0.0, 0.0, 0.0
            if je_summary:
                first_row = True
                for r in je_summary:
                    cnt = int(r["cnt"] or 0)
                    dr, cr, net = float(r["dr"] or 0.0), float(r["cr"] or 0.0), float(r["net"] or 0.0)
                    sheet_total_cnt += cnt
                    sheet_total_dr += dr
                    sheet_total_cr += cr
                    sheet_total_net += net
                    rows.append([sheet_name if first_row else "", r["JE Category"], cnt, dr, cr, net])
                    first_row = False
            else:
                rows.append([sheet_name, "No Data", 0, 0.0, 0.0, 0.0])

            group_total_cnt += sheet_total_cnt
            group_total_dr += sheet_total_dr
            group_total_cr += sheet_total_cr
            group_total_net += sheet_total_net
            rows.append([f"{sheet_name} Total", "", sheet_total_cnt, sheet_total_dr, sheet_total_cr, sheet_total_net])

        rows.append(["Group Total", "", group_total_cnt, group_total_dr, group_total_cr, group_total_net])
        rows.append([None, None, None, None, None, None])

    if rows and all(v is None for v in rows[-1]): rows.pop()
    return rows

def _rows_to_display_df(rows):
