def build_unmatched_rows(base_df, rem_sales_df, rem_credit_df,
                         name: str, stage_path: str = None):
    remaining_ids = (
        rem_sales_df.select(F.col("sales_row_id").alias("row_id"))
        .unionByName(rem_credit_df.select(F.col("credit_row_id").alias("row_id")))
        .distinct()
    )
    unmatched = base_df.join(remaining_ids, on="row_id", how="inner")
    return materialize_df(unmatched, name, "primary_key", stage_path=stage_path)


def resolve_to_original(pairs_df, base_df, match_label: str,
                        stage_name: str, stage_path: str = None,
                        has_year_flag: bool = False):
    if pairs_df is None:
        return None

    w_pair = Window.orderBy(
        F.col("primary_key").asc(),
        F.col("sales_row_id").asc(),
        F.col("credit_row_id").asc(),
    )

    pairs_with_id = (
        pairs_df
        .withColumn(
            "pair_id",
            F.concat(
                F.lit(f"{match_label}_"),
                F.row_number().over(w_pair).cast("string"),
            ),
        )
        .select("pair_id", "sales_row_id", "credit_row_id", "match_type")
    )

    if has_year_flag:
        yf_sales  = base_df.select(
            F.col("row_id").alias("sales_row_id"),
            F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("sales_year_flag"),
            F.upper(F.trim(F.col("Source Quarter").cast("string"))).alias("sales_quarter_flag"),
        )
        yf_credit = base_df.select(
            F.col("row_id").alias("credit_row_id"),
            F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("credit_year_flag"),
            F.upper(F.trim(F.col("Source Quarter").cast("string"))).alias("credit_quarter_flag"),
        )
        _sales_cy_py  = F.when(F.col("sales_year_flag")  == CURRENT_FY, F.lit("CY")).otherwise(F.lit("PY"))
        _credit_cy_py = F.when(F.col("credit_year_flag") == CURRENT_FY, F.lit("CY")).otherwise(F.lit("PY"))

        pairs_with_id = (
            pairs_with_id
            .join(yf_sales,  on="sales_row_id",  how="left")
            .join(yf_credit, on="credit_row_id", how="left")
            .withColumn(
                "Year Pair Flag",
                F.when(
                    F.col("sales_year_flag").isNull() | F.col("credit_year_flag").isNull(),
                    F.lit("Unknown"),
                ).otherwise(
                    F.concat(_sales_cy_py, F.lit(" Sales Inv with "), _credit_cy_py, F.lit(" Credit Memo"))
                )
            )
            .select("pair_id", "sales_row_id", "credit_row_id", "match_type", "Year Pair Flag")
        )

    orig_cols  = [F.col(f"orig.`{c}`") for c in base_df.columns]
    extra_meta = ["pair_id", "match_type"] + (["Year Pair Flag"] if has_year_flag else [])
    meta_cols  = [F.col(c) for c in extra_meta if c not in base_df.columns]

    sales_side = (
        pairs_with_id
        .join(base_df.alias("orig"),
              pairs_with_id["sales_row_id"] == F.col("orig.row_id"), "inner")
        .select(*meta_cols, *orig_cols)
    )
    credit_side = (
        pairs_with_id
        .join(base_df.alias("orig"),
              pairs_with_id["credit_row_id"] == F.col("orig.row_id"), "inner")
        .select(*meta_cols, *orig_cols)
    )

    resolved = sales_side.unionByName(credit_side)
    return materialize_df(resolved, stage_name, "primary_key", stage_path=stage_path)


def _spark_months_between_int(d_credit: datetime.date, d_sales: datetime.date) -> int:
    """
    Exact Python equivalent of Spark's F.months_between(credit_month, sales_month).cast("int").
    """
    if not d_credit or not d_sales:
        return -9999
    if d_credit.day == d_sales.day:
        return (d_credit.year - d_sales.year) * 12 + (d_credit.month - d_sales.month)
    diff = (d_credit.year - d_sales.year) * 12 + (d_credit.month - d_sales.month) + (d_credit.day - d_sales.day) / 31.0
    return int(diff)


def fast_in_memory_exhaustive_match(sales_df, credit_df, match_label: str,
                                    base_df, stage_path: str = None,
                                    has_year_flag: bool = False):
    """
    Serverless-safe replacement for rank_based_match() + exhaustive_match().
    - Zero dbutils.fs calls
    - Zero intermediate Parquet writes inside the iterative loop
    - Executes the exact same iterative mutual-best-match (rn_sales == 1 AND rn_credit == 1)
      logic in Python driver memory on lightweight row keys, discovering 100% of multi-pass
      pairs in a single step.
    """
    print(f"\n[EXHAUSTIVE MATCH] {match_label} (In-Memory Coordinator)")

    # 1. Narrow to PKs present on both sides to minimize driver collect
    common_pks = (
        sales_df.select("primary_key").distinct()
        .join(credit_df.select("primary_key").distinct(), on="primary_key", how="inner")
    )

    s_rows = (
        sales_df.join(common_pks, on="primary_key", how="inner")
        .select("primary_key", "sales_row_id", "sales_amt", "sales_eff_dt", "sales_month")
        .collect()
    )
    c_rows = (
        credit_df.join(common_pks, on="primary_key", how="inner")
        .select("primary_key", "credit_row_id", "credit_amt", "credit_eff_dt", "credit_month")
        .collect()
    )

    if not s_rows or not c_rows:
        display_metric(f"[{match_label}] Total pairs", 0)
        return None, sales_df, credit_df

    # 2. Group by primary_key in memory
    s_by_pk = defaultdict(list)
    for r in s_rows:
        s_by_pk[r["primary_key"]].append(r)

    c_by_pk = defaultdict(list)
    for r in c_rows:
        c_by_pk[r["primary_key"]].append(r)

    confirmed_pairs = []

    # 3. Exhaustive mutual-best-match loop per PK
    for pk, s_list in s_by_pk.items():
        c_list = c_by_pk.get(pk, [])
        if not c_list:
            continue

        used_s = set()
        used_c = set()

        while True:
            best_for_s = {}
            best_for_c = {}

            for s in s_list:
                s_id = s["sales_row_id"]
                if s_id in used_s:
                    continue
                s_eff = s["sales_eff_dt"]
                s_amt = s["sales_amt"]
                s_mon = s["sales_month"]

                for c in c_list:
                    c_id = c["credit_row_id"]
                    if c_id in used_c:
                        continue
                    c_eff = c["credit_eff_dt"]

                    if s_eff is None or c_eff is None or s_eff > c_eff:
                        continue

                    amt_diff = abs(s_amt + c["credit_amt"])
                    if amt_diff != 0:
                        continue

                    m_lag = _spark_months_between_int(c["credit_month"], s_mon)

                    if match_label == "NEXT_MONTH_EXACT" and m_lag != 1:
                        continue
                    elif match_label == "SAME_MONTH_EXACT" and m_lag != 0:
                        continue
                    elif match_label == "LAG_1_2_MONTH" and not (1 <= m_lag <= 2):
                        continue
                    elif match_label == "LAG_GT_2_MONTH" and not (m_lag > 2):
                        continue

                    # Mirror w_sales and w_credit window ordering exactly
                    s_rank_key = (amt_diff, m_lag, c_eff, c_id)
                    c_rank_key = (amt_diff, m_lag, s_eff, s_id)

                    if s_id not in best_for_s or s_rank_key < best_for_s[s_id][0]:
                        best_for_s[s_id] = (s_rank_key, c_id)
                    if c_id not in best_for_c or c_rank_key < best_for_c[c_id][0]:
                        best_for_c[c_id] = (c_rank_key, s_id)

            new_matches = 0
            for s_id, (_, target_c_id) in best_for_s.items():
                if target_c_id in best_for_c and best_for_c[target_c_id][1] == s_id:
                    confirmed_pairs.append((pk, s_id, target_c_id, match_label))
                    used_s.add(s_id)
                    used_c.add(target_c_id)
                    new_matches += 1

            if new_matches == 0:
                break

    total_pairs = len(confirmed_pairs)
    display_metric(f"[{match_label}] Total pairs", total_pairs)

    if total_pairs == 0:
        return None, sales_df, credit_df

    # 4. Convert confirmed pairs back to a Spark DataFrame
    pairs_schema = T.StructType([
        T.StructField("primary_key",   T.StringType()),
        T.StructField("sales_row_id",  T.StringType()),
        T.StructField("credit_row_id", T.StringType()),
        T.StructField("match_type",    T.StringType()),
    ])
    slim_all = spark.createDataFrame(confirmed_pairs, schema=pairs_schema)

    matched_s_ids = slim_all.select("sales_row_id").distinct()
    matched_c_ids = slim_all.select("credit_row_id").distinct()

    rem_sales  = sales_df.join(matched_s_ids,  on="sales_row_id",  how="left_anti")
    rem_credit = credit_df.join(matched_c_ids, on="credit_row_id", how="left_anti")

    resolved = resolve_to_original(
        slim_all, base_df, match_label,
        f"RESOLVED_{match_label}", stage_path, has_year_flag,
    )

    debug_count(f"[{match_label}] Resolved rows",    resolved)
    debug_count(f"[{match_label}] Remaining sales",  rem_sales)
    debug_count(f"[{match_label}] Remaining credit", rem_credit)

    return resolved, rem_sales, rem_credit

