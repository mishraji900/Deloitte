ACCOUNT_GROUPS = {
    "Commissions": ["Commissions - Fixed", "Commissions - Variable"],
    "Contra Revenue": ["Contra Revenue - Subscription Fees - Fixed", "Contra Revenue Commissions - Tech Credits - Variable", "Contra Revenue Commissions - Variable"],
