def assign_aa_comment(df, raw_df, oto_df=None, small_amt_threshold: float = SMALL_AMT_MAX):
    """
    Purpose: Assigns audit comments explaining why items remain unmatched.
    Called by: Cell 8.
    """
    if "abs_entered_dec" not in df.columns:
        df = df.withColumn("abs_entered_dec", F.abs(to_decimal_clean("Net Entered")))
    if "eff_dt" not in df.columns:
        df = df.withColumn("eff_dt", to_date_clean("Default Effective Date"))
    if "vendor_num_clean" not in df.columns:
        df = df.withColumn("vendor_num_clean", F.trim(F.col("Vendor/Customer Number").cast("string")))
    if "company_desc_clean" not in df.columns:
        df = df.withColumn("company_desc_clean", F.trim(F.upper(F.col("Company Description"))))
    if "entered_net_dec" not in df.columns:
        df = df.withColumn("entered_net_dec", to_decimal_clean("Net Entered"))
    if "cat_clean" not in df.columns:
        df = df.withColumn("cat_clean", F.trim(F.upper(F.col("JE Category"))))

    otm_expr      = F.col("match_type") == "ONE_TO_MANY"
    sync_expr     = F.col("match_type") == "ONE_TO_ONE_DATE_SYNC"
    unsync_expr   = F.col("match_type") == "ONE_TO_ONE_DATE_UNSYNC"
    no_match_expr = F.col("match_type") == "NO_MATCH_FOUND"
    _no_match_cm  = no_match_expr & (F.col("cat_clean") == "CREDIT MEMOS")

    if oto_df is not None:
        oto_lookup = (
            oto_df.select(F.col("sales_row_id").alias("row_id"), F.col("amount_net").cast(DECIMAL_TYPE).alias("_pair_net_abs"))
            .unionByName(oto_df.select(F.col("credit_row_id").alias("row_id"), F.col("amount_net").cast(DECIMAL_TYPE).alias("_pair_net_abs")))
            .distinct()
        )
        df = df.join(oto_lookup, on="row_id", how="left")
        _exact_cancel = F.col("_pair_net_abs").isNotNull() & (F.col("_pair_net_abs") == EXACT_ZERO)
    else:
        df = df.withColumn("_pair_net_abs", F.lit(None).cast(DECIMAL_TYPE))
        _exact_cancel = F.lit(False)

    # Rule Group 1: ONE_TO_MANY
    df = df.withColumn("AA Comment", F.when(otm_expr, F.lit(AA_ONE_TO_MANY)).otherwise(F.lit(None).cast("string"))) \
           .withColumn("AA Rule", F.when(otm_expr, F.lit("Rule1_OTM")).otherwise(F.lit(None).cast("string")))

    # Rule Group 2a: DATE_SYNC
    df = df.withColumn("AA Comment", F.when(F.col("AA Comment").isNull() & sync_expr & _exact_cancel, F.lit(AA_EXACT_MATCH_SYNC))
                                      .when(F.col("AA Comment").isNull() & sync_expr, F.lit(AA_APPROX_MATCH))
                                      .otherwise(F.col("AA Comment"))) \
           .withColumn("AA Rule", F.when(F.col("AA Rule").isNull() & sync_expr & _exact_cancel, F.lit("Rule2a_DateSync_ExactMatch"))
                                  .when(F.col("AA Rule").isNull() & sync_expr, F.lit("Rule2a_DateSync_ApproxMatch"))
                                  .otherwise(F.col("AA Rule")))

    # Rule Group 2b: DATE_UNSYNC
    df = df.withColumn("AA Comment", F.when(F.col("AA Comment").isNull() & unsync_expr & _exact_cancel, F.lit(AA_EXACT_MATCH_UNSYNC))
                                      .when(F.col("AA Comment").isNull() & unsync_expr, F.lit(AA_APPROX_MATCH))
                                      .otherwise(F.col("AA Comment"))) \
           .withColumn("AA Rule", F.when(F.col("AA Rule").isNull() & unsync_expr & _exact_cancel, F.lit("Rule2b_DateUnsync_ExactMatch"))
                                  .when(F.col("AA Rule").isNull() & unsync_expr, F.lit("Rule2b_DateUnsync_ApproxMatch"))
                                  .otherwise(F.col("AA Rule")))

    # Rule Group 3: NO_MATCH_FOUND (Company + Vendor composite key stats)
    vendor_stats = (
        raw_df
        .withColumn("_co_clean", F.trim(F.upper(F.col("Company Description"))))
        .withColumn("_vn_clean", F.trim(F.col("Vendor/Customer Number").cast("string")))
        .withColumn("_cat",      F.trim(F.upper(F.col("JE Category"))))
        .groupBy("_co_clean", "_vn_clean")
        .agg(
            F.countDistinct(F.when(F.col("_cat") == "SALES INVOICES", F.col("Invoice Reference"))).alias("sales_inv_count"),
            F.countDistinct(F.when(F.col("_cat") == "CREDIT MEMOS", F.col("Invoice Reference"))).alias("credit_memo_count"),
        )
    )

    df = df.join(
        vendor_stats.withColumnRenamed("_co_clean", "_co_join").withColumnRenamed("_vn_clean", "_vn_join"),
        (df["company_desc_clean"] == F.col("_co_join")) & (df["vendor_num_clean"] == F.col("_vn_join")),
        "left",
    ).drop("_co_join", "_vn_join")

    # Priority 1: Only Credits present for this Company + Vendor combination
    df = df.withColumn("AA Comment", F.when(F.col("AA Comment").isNull() & _no_match_cm & (F.col("sales_inv_count") == 0) & (F.col("credit_memo_count") > 0), F.lit(AA_ONLY_CREDITS)).otherwise(F.col("AA Comment"))) \
           .withColumn("AA Rule", F.when(F.col("AA Rule").isNull() & _no_match_cm & (F.col("sales_inv_count") == 0) & (F.col("credit_memo_count") > 0), F.lit("Rule3P1_OnlyCredits_CompanyVendor")).otherwise(F.col("AA Rule")))

    # Priority 4: Catch-all client confirmation needed
    df = df.withColumn("AA Comment", F.when(F.col("AA Comment").isNull() & _no_match_cm, F.lit(AA_CLIENT_CONFIRM)).otherwise(F.col("AA Comment"))) \
           .withColumn("AA Rule", F.when(F.col("AA Rule").isNull() & _no_match_cm, F.lit("Rule3P4_ClientConfirm")).otherwise(F.col("AA Rule")))

    return df.drop("_pair_net_abs", "sales_inv_count", "credit_memo_count")

