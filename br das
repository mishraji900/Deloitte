"""
matrix_fs_line_final.py — LOB-as-transaction-grain (business decision locked)
Source: `mayank` (raw GL, already in Spark session)

Decision: LOB confirmed as full audit-test grain. Test unit = 
(journal_number, entity_id, LOB), not (journal_number, entity_id).
mixed_lob_txn_count no longer a gate — it's just reported for traceability.
"""

from pyspark.sql import functions as func
from pyspark.sql.window import Window


# ---------------------------------------------------------------
# STEP 1: BUILD SOURCE DATA
# ---------------------------------------------------------------
def build_source_data(mayank):
    def blank_safe(colname, default):
        c = func.col(colname)
        return func.when(c.isNull() | (func.trim(c) == ''), func.lit(default)).otherwise(c)

    mayank = mayank.withColumn('_row_id', func.monotonically_increasing_id())

    source_data = (
        mayank
        .withColumn('fiscal_year_identifier', func.lit('2026'))
        .withColumn(
            'journal_number',
            func.when(
                func.col('Jrn_Nmbr').isNull() | (func.trim(func.col('Jrn_Nmbr')) == ''),
                func.concat(func.lit('UNSPECIFIED_JRN_'), func.col('_row_id').cast('string'))
            ).otherwise(func.col('Jrn_Nmbr'))
        )
        .withColumn(
            'entity_id',
            func.when(
                func.col('LEGALENTITY').isNull() | (func.trim(func.col('LEGALENTITY')) == ''),
                func.concat(func.lit('UNSPECIFIED_ENTITY_'), func.col('_row_id').cast('string'))
            ).otherwise(func.col('LEGALENTITY'))
        )
        .withColumn('is_standard', blank_safe('MAN_SYS_NEW', 'N'))
        .withColumn('account_number', func.col('Acc'))
        .withColumn('financial_statement_line', func.col('`FS Line`'))
        .withColumn('financial_statement_category', func.col('`FS Category`'))
        .withColumn('user', func.col('WF_APPROVER_NAME'))
        .withColumn('date_posted', func.col('Creation_Date'))
        .withColumn('LOB', blank_safe('LOB', 'UNSPECIFIED'))
        .withColumn(
            'journal_number_entity_id',
            func.concat(func.col('journal_number'), func.lit(':'), func.col('entity_id'))
        )
        # NEW: locked grain key. LOB is now part of transaction identity, not just display.
        .withColumn(
            'journal_number_entity_id_lob',
            func.concat(func.col('journal_number_entity_id'), func.lit(':'), func.col('LOB'))
        )
        .withColumn(
            'Debit_Credit_Indicator',
            func.when(func.col('NET_AMOUNT_AT_REPORTING_CURRENCY') >= 0, 'D').otherwise('C')
        )
        .withColumn(
            'debit_amount',
            func.when(func.col('Debit_Credit_Indicator') == 'D',
                      func.col('NET_AMOUNT_AT_REPORTING_CURRENCY')).otherwise(func.lit(0.0))
        )
        .withColumn(
            'credit_amount',
            func.when(func.col('Debit_Credit_Indicator') == 'C',
                      func.abs(func.col('NET_AMOUNT_AT_REPORTING_CURRENCY'))).otherwise(func.lit(0.0))
        )
        .withColumn('number_of_lines', func.lit(1))
    )
    return source_data


def data_quality_flag_report(mayank):
    def blank_count(colname):
        c = func.col(colname)
        return mayank.filter(c.isNull() | (func.trim(c) == '')).count()

    print("=== RAW DATA QUALITY CHECK ===")
    print(f"Blank/null Jrn_Nmbr    : {blank_count('Jrn_Nmbr')}  (unique placeholder per row)")
    print(f"Blank/null LEGALENTITY : {blank_count('LEGALENTITY')}")
    print(f"Blank/null MAN_SYS_NEW : {blank_count('MAN_SYS_NEW')}")
    print(f"Blank/null LOB         : {blank_count('LOB')}")
    print("Non-zero = source gap, report to data owner. Defaults prevent join corruption, don't fix source.")


# ---------------------------------------------------------------
# STEP 2: COMPOUND SUMMARY — grain now includes LOB (locked)
# ---------------------------------------------------------------
def build_compound_summary(source_data):
    window_spec = Window.partitionBy('journal_number_entity_id_lob', 'fiscal_year_identifier')
    source_data_summary = source_data.withColumn(
        'compound_entries', func.sum('number_of_lines').over(window_spec)
    )
    compound_summary = source_data_summary.groupBy(
        'fiscal_year_identifier', 'journal_number', 'entity_id', 'is_standard', 'LOB',
        'journal_number_entity_id_lob', 'financial_statement_line', 'compound_entries'
    ).agg(
        func.sum('debit_amount').alias('debit_amount'),
        func.sum('credit_amount').alias('credit_amount')
    )
    return compound_summary


# ---------------------------------------------------------------
# STEP 3: MATRIX TABLE — join key is journal_number_entity_id_lob
# ---------------------------------------------------------------
def build_matrix_table(source_data):
    key_cols = ['journal_number_entity_id_lob', 'journal_number', 'entity_id',
                'is_standard', 'fiscal_year_identifier', 'LOB']

    debits = source_data.filter(func.col('Debit_Credit_Indicator') == 'D').groupBy(
        *key_cols, 'financial_statement_line'
    ).agg(
        func.sum('number_of_lines').alias('number_of_lines_debit'),
        func.sum('debit_amount').alias('debit_amount')
    ).withColumnRenamed('financial_statement_line', 'debit_fs_line')

    credits = source_data.filter(func.col('Debit_Credit_Indicator') == 'C').groupBy(
        *key_cols, 'financial_statement_line'
    ).agg(
        func.sum('number_of_lines').alias('number_of_lines_credit'),
        func.sum('credit_amount').alias('credit_amount')
    ).withColumnRenamed('financial_statement_line', 'credit_fs_line')

    summary_key = source_data.groupBy(*key_cols).agg(
        func.sum('number_of_lines').alias('total_lines_per_entry')
    )

    jd = [summary_key.journal_number_entity_id_lob == debits.journal_number_entity_id_lob]
    t1 = summary_key.join(debits, jd, 'outer').select(
        func.coalesce(summary_key.journal_number_entity_id_lob, debits.journal_number_entity_id_lob).alias('journal_number_entity_id_lob'),
        func.coalesce(summary_key.journal_number, debits.journal_number).alias('journal_number'),
        func.coalesce(summary_key.entity_id, debits.entity_id).alias('entity_id'),
        func.coalesce(summary_key.is_standard, debits.is_standard).alias('is_standard'),
        func.coalesce(summary_key.fiscal_year_identifier, debits.fiscal_year_identifier).alias('fiscal_year_identifier'),
        func.coalesce(summary_key.LOB, debits.LOB).alias('LOB'),
        summary_key.total_lines_per_entry,
        debits.debit_fs_line, debits.number_of_lines_debit, debits.debit_amount
    )

    jc = [credits.journal_number_entity_id_lob == t1.journal_number_entity_id_lob]
    matrix_table = t1.join(credits, jc, 'outer').select(
        func.coalesce(t1.journal_number_entity_id_lob, credits.journal_number_entity_id_lob).alias('journal_number_entity_id_lob'),
        func.coalesce(t1.journal_number, credits.journal_number).alias('journal_number'),
        func.coalesce(t1.entity_id, credits.entity_id).alias('entity_id'),
        func.coalesce(t1.is_standard, credits.is_standard).alias('is_standard'),
        func.coalesce(t1.fiscal_year_identifier, credits.fiscal_year_identifier).alias('fiscal_year_identifier'),
        func.coalesce(t1.LOB, credits.LOB).alias('LOB'),
        t1.debit_fs_line, t1.total_lines_per_entry,
        credits.credit_fs_line, t1.number_of_lines_debit, credits.number_of_lines_credit,
        t1.debit_amount, credits.credit_amount
    )

    user_concat = source_data.groupBy(*key_cols).agg(
        func.concat_ws(', ', func.array_sort(func.collect_set('user'))).alias('concat_user_IDs')
    )

    jr = [matrix_table.journal_number_entity_id_lob == user_concat.journal_number_entity_id_lob]
    matrix_table_final = matrix_table.join(user_concat, jr, 'left').select(
        matrix_table['*'], user_concat['concat_user_IDs']
    )
    return matrix_table_final


# ---------------------------------------------------------------
# STEP 4: RECONCILIATION CHECK — mixed_lob_txn_count now informational only
# ---------------------------------------------------------------
def reconciliation_check(source_data, compound_summary, matrix_table_final):
    raw_debit = source_data.agg(func.sum('debit_amount')).collect()[0][0]
    raw_credit = source_data.agg(func.sum('credit_amount')).collect()[0][0]
    comp_debit = compound_summary.agg(func.sum('debit_amount')).collect()[0][0]
    comp_credit = compound_summary.agg(func.sum('credit_amount')).collect()[0][0]
    mat_debit = matrix_table_final.agg(func.sum('debit_amount')).collect()[0][0]
    mat_credit = matrix_table_final.agg(func.sum('credit_amount')).collect()[0][0]

    print(f"RAW      debit={raw_debit} credit={raw_credit}")
    print(f"COMPOUND debit={comp_debit} credit={comp_credit}  (should MATCH raw)")
    print(f"MATRIX   debit={mat_debit} credit={mat_credit}  (fan-out, dedupe in Tableau via FIXED LOD)")

    null_key_count = matrix_table_final.filter(func.col('journal_number_entity_id_lob').isNull()).count()
    print(f"\nMatrix rows with null grain key: {null_key_count} (should be 0)")

    # informational only — decision already made, this is now audit trail not a gate
    mixed_lob_txn_count = source_data.groupBy('journal_number_entity_id').agg(
        func.countDistinct('LOB').alias('distinct_lob_count')
    ).filter(func.col('distinct_lob_count') > 1).count()
    print(f"\n[INFO] Transactions spanning >1 LOB: {mixed_lob_txn_count}")
    print("[INFO] Per business decision, LOB is now full audit-test grain.")
    print("[INFO] Each (journal_number, entity_id, LOB) slice is evaluated as its own unit.")
    print("[INFO] Count above = txns that were split into multiple audit-test rows by this change.")

    print("\nPer-LOB raw vs compound (should match row for row):")
    raw_by_lob = source_data.groupBy('LOB').agg(
        func.sum('debit_amount').alias('raw_debit'),
        func.sum('credit_amount').alias('raw_credit')
    )
    comp_by_lob = compound_summary.groupBy('LOB').agg(
        func.sum('debit_amount').alias('compound_debit'),
        func.sum('credit_amount').alias('compound_credit')
    )
    raw_by_lob.join(comp_by_lob, 'LOB', 'outer').orderBy('LOB').show(truncate=False)


# ---------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------
def main(mayank):
    data_quality_flag_report(mayank)
    source_data = build_source_data(mayank)

    compound_summary = build_compound_summary(source_data)
    matrix_table_final = build_matrix_table(source_data)

    reconciliation_check(source_data, compound_summary, matrix_table_final)

    return compound_summary, matrix_table_final


