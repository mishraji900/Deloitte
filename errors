def to_decimal_clean(col_name: str, precision: int = 38, scale: int = 6):
    """Cast stringâ†’decimal handling commas, parenthetical negatives, blanks."""
    cleaned = F.trim(F.col(col_name).cast("string"))
    cleaned = F.regexp_replace(cleaned, ",", "")
    cleaned = F.when(
        cleaned.rlike(r"^\(.*\)$"),
        F.concat(F.lit("-"), F.regexp_replace(cleaned, r"[()]", "")),
    ).otherwise(cleaned)
    cleaned = F.when(cleaned == "", None).otherwise(cleaned)
    return cleaned.cast(T.DecimalType(precision, scale))


def to_date_clean(col_name: str):
    """Parse date column through multiple format patterns."""
    raw = F.trim(F.col(col_name).cast("string"))
    return F.coalesce(
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "M/d/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )


def month_from_business_column(month_col):
    """Parse 'Month' column which may be 'Jan-25', '01-Jan-25', date string, etc."""
    raw = F.trim(month_col.cast("string"))
    return F.coalesce(
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yyyy"),
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )


