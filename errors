def _detect_quarter_from_string(s: str):
    """Try to extract Qn from path/filename strings."""
    m = re.search(r'Q([1-4])', s, re.IGNORECASE)
    return f"Q{m.group(1)}" if m else None


def _prompt_quarter(widget_name: str, prompt_text: str = "Select Quarter"):
    """
    Create or recreate a quarter dropdown, guaranteeing default 'Q1' is in the choices.
    - Removes any existing widget with the same name first.
    - Then creates a fresh dropdown.
    """
    # Remove the widget if it already exists (ignore error if not present)
    try:
        dbutils.widgets.remove(widget_name)
    except Exception:
        pass

    dbutils.widgets.dropdown(
        widget_name,
        "Q1",
        ["Q1", "Q2", "Q3", "Q4"],
        prompt_text,
    )
    return dbutils.widgets.get(widget_name)


