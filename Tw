def _spark_sum(df, col_name):
    """Helper to safely sum a PySpark column, treating grey markers/nulls as 0."""
    source_text = F.trim(F.col(f"`{col_name}`").cast("string"))
    source_lower = F.lower(source_text)
    cleaned_text = F.regexp_replace(F.regexp_replace(source_text, ",", ""), "%", "")
    
    numeric_col = F.when(
        source_text.isNull() | (source_text == F.lit("")) | (source_lower == F.lit(GREY_MARKER)),
        F.lit(0).cast("double")
    ).otherwise(cleaned_text.cast("double"))
    
    val = df.select(F.sum(numeric_col)).collect()[0][0]
    return val if val is not None else 0


