def add_source_positions(records):
    # Tag each row-dict with its 1-based position in the original list, since some records
    # don't carry an explicit sheet/row identifier.
    return [{**record, "__source_position__": position} for position, record in enumerate(records, start=1)]

def get_statement_type(record, position, balance_sheet_line_count):
    # Decide if a record belongs to "BS" (Balance Sheet) or "IS" (Income Statement): first try
    # an explicit sheet-name-like field; if none found, fall back to position (rows before the
    # known BS line count are BS, the rest are IS).
    for field_name in ("__sheet__", "sheet_name", "sheet", "statement", "statement_type"):
        value = get_field(record, field_name)
        if value is None: continue
        text = str(value).casefold()
        if "balance" in text: return "BS"
        if "income" in text or "statement" in text: return "IS"
    try: source_position = int(record.get("__source_position__", position))
    except (TypeError, ValueError): source_position = position
    return "BS" if source_position <= balance_sheet_line_count else "IS"

def source_summary(records, label, balance_sheet_line_count):
    # Aggregate row counts + Consolidated/Untested dollar totals, split by BS vs IS and also
    # combined ("net"), for one stage of the pipeline (raw CY, raw PY, visible CY rows, etc.).
    summary = {
        "stage": label,
        "bs_count": 0, "bs_consolidated": Decimal("0"), "bs_untested": Decimal("0"),
        "is_count": 0, "is_consolidated": Decimal("0"), "is_untested": Decimal("0"),
    }
    for position, record in enumerate(records, start=1):
        statement = get_statement_type(record, position, balance_sheet_line_count)
        consolidated = to_decimal(get_field(record, CONSOLIDATED_COLUMN, "Consolidated Balance", "Consolidated Total")) or Decimal("0")
        untested = to_decimal(get_field(record, "Untested Balance", "Untested", "Untested Total")) or Decimal("0")
        prefix = "bs" if statement == "BS" else "is"
        summary[f"{prefix}_count"] += 1
        summary[f"{prefix}_consolidated"] += consolidated
        summary[f"{prefix}_untested"] += untested
    summary["net_count"] = summary["bs_count"] + summary["is_count"]
    summary["net_consolidated"] = summary["bs_consolidated"] + summary["is_consolidated"]
    summary["net_untested"] = summary["bs_untested"] + summary["is_untested"]
    return summary

def is_non_grey_cy_record(record):
    # A CY row counts as "visible/active" (i.e. what ends up on Tabs 1 & 2) only if it has an
    # account name, a non-zero % of consolidated balance, and was flagged exactly "no" for testing.
    account = get_field(record, "Account")
    percentage = to_decimal(get_field(record, PERCENTAGE_COLUMN_NAME, "% of consolidated", "Percentage"))
    test_value = str(get_field(record, "Test consolidated amount", "Test Consolidated Amount") or "").strip().casefold()
    return is_present(account) and percentage is not None and percentage != Decimal("0") and test_value == "no"

def sum_field(records, field_name):
    # Decimal-safe sum of one field across a list of records, skipping unparseable/missing values.
    total = Decimal("0")
    for record in records:
        value = to_decimal(get_field(record, field_name))
        if value is not None: total += value
    return total

