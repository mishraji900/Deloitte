def populate_sheet_3a(template, updated_raw_tb_CY, residual_rows, spark_column_row_pairs_cy, materiality, row_id_col=ROW_ID_COLUMN):
    """Top-level driver for Tab 3a: sizes the sheet to fit one 5-row block per qualifying
    account (growing the sheet if needed), writes materiality/threshold cells, then calls
    s3a_write_block() per account."""
    worksheet = template[SHEET_3A]
    source_columns = list(updated_raw_tb_CY.columns)
    account_column = require_column(source_columns, "Account")
    entity_columns = find_entity_columns(source_columns, excludes=["Account", "% of consolidated balance", "Test consolidated amount",
                "Untested Balance", "Eliminations", "TopSide", "Reclassifications", "__sheet__"])

    mat_coord = MATERIALITY_CELL.replace("$", "")
    worksheet[mat_coord].value = float(to_decimal(materiality))
    worksheet["C7"].value = float(THRESHOLD_VALUE)

    tab2_row_lookup = s3a_build_tab2_row_lookup(template)
    blue_exact_pairs, blue_normalized_pairs = s3a_build_blue_pair_lookups(spark_column_row_pairs_cy, row_id_col)
    header_row, start_column = coordinate_to_tuple(ANCHOR_CELL)
    last_entity_column = start_column + len(entity_columns)
    total_column, tab2_column = last_entity_column + 1, last_entity_column + 2
    difference_column = output_end_column = tab2_column + 1
    source_max_column = worksheet.max_column
    required_end_row = header_row + max(len(residual_rows), 1) * BLOCK_HEIGHT - 1

    if required_end_row > worksheet.max_row:
        worksheet.insert_rows(worksheet.max_row + 1, amount=required_end_row - worksheet.max_row)   # grow the sheet if more accounts than the template had rows for

    clear_worksheet_area(worksheet, header_row, start_column, end_row=max(worksheet.max_row, required_end_row), end_column=max(worksheet.max_column, output_end_column))
    clear_conditional_formatting(worksheet)

    all_investigate_coordinates = []
    for index, residual_row in enumerate(residual_rows):
        block_start_row = header_row + index * BLOCK_HEIGHT
        s3a_copy_block_style(worksheet, header_row, block_start_row, start_column, output_end_column, source_max_column)
        investigate_coordinates = s3a_write_block(
            worksheet=worksheet, block_start_row=block_start_row, record=residual_row["record"],
            account_column=account_column, source_row_id=residual_row["row_id"],
            entity_columns=entity_columns, blue_exact_pairs=blue_exact_pairs,
            blue_normalized_pairs=blue_normalized_pairs, tab2_row_lookup=tab2_row_lookup)
        all_investigate_coordinates.extend(investigate_coordinates)
        s3a_wipe_spacer_rows(worksheet, block_start_row + DATA_ROWS, start_column, difference_column)

    s3a_apply_all_investigate_colors(worksheet, all_investigate_coordinates)

    return {"entity_columns": entity_columns, "blocks_written": len(residual_rows)}

