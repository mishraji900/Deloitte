GREY_MARKER = "__grey__"   # sentinel written into cells that were manually overridden ("blue font" in source)

def is_grey_marker(value) -> bool:
    """True if `value` is the grey/blue-override sentinel (case-insensitive)."""
    return isinstance(value, str) and value.strip().casefold() == GREY_MARKER

def to_decimal(value):
    """Safely parse inputs (numbers, accounting strings, percentages) into Decimals, or None."""
    # Handles: real numbers, accounting notation "(123)" -> -123, "$"/","/"%" stripping,
    # and treats blanks/dashes/the grey sentinel as "no value" rather than an error.
    if value is None or isinstance(value, bool) or is_grey_marker(value):
        return None
    if isinstance(value, Decimal):
        return value if value.is_finite() else None

    if isinstance(value, (int, float)) or hasattr(value, "__float__"):
        try:
            numeric_value = float(value)
        except (ValueError, TypeError, OverflowError):
            numeric_value = None
        if numeric_value is not None:
            if numeric_value != numeric_value:   # NaN
                return None
            decimal_value = Decimal(str(round(numeric_value, 10)))
            return decimal_value if decimal_value.is_finite() else None

    try:
        text = str(value).replace(",", "").replace("$", "").strip()
        if text.endswith("%"):
            text = text[:-1].strip()
        if text.startswith("(") and text.endswith(")"):
            text = "-" + text[1:-1]                        # accounting negative "(123)" -> "-123"
        if text in {"", "-", "\u2014", GREY_MARKER}:
            return None
        decimal_value = Decimal(text)
        return decimal_value if decimal_value.is_finite() else None
    except (InvalidOperation, ValueError, TypeError):
        return None

def to_excel_number(value):
    """Write-side counterpart to to_decimal: Decimal -> float, sentinel/None -> blank cell."""
    if value is None or is_grey_marker(value):
        return None
    if isinstance(value, Decimal):
        return float(value)
    return value

def normalize_text(value) -> str:
    """Whitespace-collapsed, case-folded key, used for loose column/value name matching."""
    if value is None:
        return ""
    return " ".join(str(value).replace("\u00a0", " ").strip().split()).casefold()

def is_present(value) -> bool:
    """True if `value` counts as a real value (not blank/None/dash/the grey sentinel)."""
    if value is None:
        return False
    return str(value).strip().casefold() not in {"", "blank", "none", "null", "nan", GREY_MARKER, "-", "\u2014"}

_ACCOUNT_KEY_TYPO_FIXES = [
    # known misspellings seen in source account names, fixed before matching
    (re.compile(r"\bvalutaion\b"), "valuation"),
    (re.compile(r"\bvalutations\b"), "valuation"),
]

_PLURAL_SAFE_ENDINGS = ("ss", "us", "is", "as", "ous")   # words ending these ways aren't plurals (bus/basis/...)

def _strip_plural(token: str) -> str:
    # Naive de-pluralizer used only for account-name matching, not general English.
    if len(token) <= 2 or not token.endswith("s"):
        return token
    if token.endswith(_PLURAL_SAFE_ENDINGS):
        return token
    return token[:-1]

def account_key(value) -> str:
    """Deterministic normalization key for account-name matching (order/typo/plural-insensitive)."""
    # Strips punctuation/apostrophes, fixes known typos, then SORTS tokens and singularizes each —
    # so "Cash and Equivalents" and "Equivalents & Cash" normalize to the same key.
    if not value:
        return ""
    text = str(value).casefold().strip()
    text = text.replace("'", "").replace("\u2019", "")
    text = text.replace("&", " and ")
    text = re.sub(r"[-\u2013\u2014]", " ", text)
    for pattern, replacement in _ACCOUNT_KEY_TYPO_FIXES:
        text = pattern.sub(replacement, text)
    text = re.sub(r"[^a-z0-9 ]+", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    tokens = sorted(text.split())
    tokens = [_strip_plural(t) for t in tokens]
    return " ".join(tokens)

def spark_account_key(column_name: str, alias_map: dict[str, str] | None = None):
    """Spark-expression equivalent of account_key() — same normalization, runs distributed
    across the whole DataFrame instead of row-by-row in Python."""
    step = F.lower(F.trim(F.col(f"`{column_name}`").cast("string")))
    step = F.regexp_replace(step, r"['\u2019]", "")
    step = F.regexp_replace(step, r"&", " and ")
    step = F.regexp_replace(step, r"[-\u2013\u2014]", " ")
    step = F.regexp_replace(step, r"(?i)\bvalutaions?\b", "valuation")
    step = F.regexp_replace(step, r"[^a-z0-9 ]+", " ")
    step = F.trim(F.regexp_replace(step, r"\s+", " "))

    tokens = F.array_sort(F.split(step, " "))
    tokens_singular = F.transform(
        tokens,
        lambda t: F.when(
            (F.length(t) > 2) & t.endswith("s")
            & (~t.endswith("ss")) & (~t.endswith("us")) & (~t.endswith("is"))
            & (~t.endswith("as")) & (~t.endswith("ous")),
            F.regexp_replace(t, "s$", ""),
        ).otherwise(t),
    )
    rich_key = F.concat_ws(" ", tokens_singular)

    if alias_map:
        # optional manual-override lookup: swap the computed key for its canonical alias if one's defined
        map_literal = F.create_map(*[
            item for pair in alias_map.items() for item in (F.lit(pair[0]), F.lit(pair[1]))
        ])
        return F.coalesce(map_literal[rich_key], rich_key)
    return rich_key

def records_from(dataframe):
    """Normalize a Spark DataFrame / pandas DataFrame / plain row-iterable into a list of dicts."""
    if dataframe is None:
        return []
    if hasattr(dataframe, "collect"):
        return [row.asDict(recursive=True) for row in dataframe.collect()]   # Spark: pulls all rows to driver
    if hasattr(dataframe, "to_dict"):
        return dataframe.to_dict(orient="records")
    return [row.asDict(recursive=True) if hasattr(row, "asDict") else dict(row) for row in dataframe]

def dataframe_columns(dataframe):
    """Get column names whether input is a real DataFrame or a plain list of row-dicts."""
    if hasattr(dataframe, "columns"):
        return list(dataframe.columns)
    records = records_from(dataframe)
    return list(records[0].keys()) if records else []

def get_field(record, *field_names):
    """Look up a dict value by any of several accepted spellings of the field name."""
    wanted = {normalize_text(name) for name in field_names}
    for actual_name, value in record.items():
        if normalize_text(actual_name) in wanted:
            return value
    return None

def find_entity_columns(columns, anchor="Test consolidated amount", excludes=(), row_id_col="row_id"):
    """Legal-entity columns = everything positioned AFTER `anchor`, minus excludes/row_id."""
    cols = list(columns)
    excl_keys = {normalize_text(e) for e in excludes} | {normalize_text(row_id_col)}

    anchor_idx = next((i for i, c in enumerate(cols) if normalize_text(c) == normalize_text(anchor)), None)
    if anchor_idx is None:
        raise KeyError(f"Anchor not found: {anchor!r}")

    result = [c for c in cols[anchor_idx + 1:] if normalize_text(c) not in excl_keys]
    if not result:
        raise ValueError(f"No entity columns found after {anchor!r}")
    return result

def require_column(columns, requested_name):
    """Case/whitespace-insensitive column lookup that raises a clear error if missing."""
    target = normalize_text(requested_name)
    for column in columns:
        if normalize_text(column) == target:
            return column
    raise KeyError(f"Required column not found: {requested_name!r}. Available: {columns}")


