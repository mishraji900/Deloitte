def Ctrl_Totals(df, column_names):
    # Before/after control-total row: sum of given columns + row count, to catch silent
    # data loss/mutation mid-pipeline (called with columns=[] just for the row count).
    agg_exprs = [F.sum(F.col(c)).alias(c) for c in column_names]
    return df.agg(*agg_exprs, F.count("*").alias("count"))

