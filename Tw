left_alignment, center_alignment, right_alignment = Alignment(horizontal="left", vertical="center", wrap_text=True), Alignment(horizontal="center", vertical="center", wrap_text=True), Alignment(horizontal="right", vertical="center")
V_MONEY_FORMAT, V_COUNT_FORMAT = '$#,##0.00;($#,##0.00);-', '#,##0'

def excel_value(value):
    # Convert Decimal -> float for openpyxl; leave everything else (str/int/None) unchanged.
    return float(value) if isinstance(value, Decimal) else value

def write_row(worksheet, row_number, values, header=False, body_fill=None):
    # Write one full row of values with consistent table styling: header rows get black
    # fill/white bold text/centered; body rows get white (or a custom section) fill, right-align
    # for numbers, left-align for text, and pick a number format based on the Python type.
    fill = body_fill or WHITE_BODY_FILL
    for column_number, raw_value in enumerate(values, start=1):
        value = excel_value(raw_value)
        cell = worksheet.cell(row=row_number, column=column_number, value=value)
        cell.border = table_border
        if header: cell.fill, cell.font, cell.alignment = copy(BLACK_HEADER_FILL), header_font, center_alignment
        else:
            cell.fill, cell.font = copy(fill), body_font
            cell.alignment = right_alignment if isinstance(value, (int, float)) and not isinstance(value, bool) else left_alignment
        if isinstance(value, int) and not isinstance(value, bool): cell.number_format = V_COUNT_FORMAT
        elif isinstance(value, float): cell.number_format = V_MONEY_FORMAT

def write_block(worksheet, start_row, rows, body_fill=None):
    # Write a mini-table: first row is treated as the header, remaining rows as body.
    for row_offset, values in enumerate(rows):
        write_row(worksheet, start_row + row_offset, values, header=row_offset == 0, body_fill=body_fill)

def add_excel_table(worksheet, table_name, first_row, last_row, last_column):
    # Register a native Excel Table over the given range (enables built-in filter/sort UI),
    # skipped entirely if there's no data (last_row < first_row would be an invalid range).
    if last_row >= first_row:
        worksheet.add_table(Table(displayName=table_name, ref=f"A{first_row}:{last_column}{last_row}"))

