def replace_spark_cells(df: DataFrame, column_row_pairs: Iterable[Tuple[str, int]],
                         row_id_col: str = ROW_ID_COLUMN, replacement: str = GREY_MARKER) -> DataFrame:
    # For every (column, row_id) pair supplied, overwrite that specific cell in the Spark
    # DataFrame with the GREY_MARKER sentinel string (the audit's "manually overridden,
    # don't re-test" flag).
    if row_id_col not in df.columns: raise ValueError(f"Missing row ID column: {row_id_col}")

    targets = defaultdict(set)
    for column_name, row_id in column_row_pairs:
        targets[column_name].add(int(row_id))     # group all target row_ids per column, so we touch each column once

    result = df
    for column_name, row_ids in targets.items():
        original = result[column_name]
        if not isinstance(df.schema[column_name].dataType, StringType):
            original = original.cast("string")     # column must become string-typed to hold the sentinel text
        result = result.withColumn(
            column_name,
            F.when(result[row_id_col].isin(list(row_ids)), F.lit(replacement)).otherwise(original))
            # replace value only on the flagged rows; leave every other row's value (now as string) untouched
    return result

