                                                       fill=PatternFill(fill_type="solid", fgColor="FFC6EFCE"), stopIfTrue=True))

    ws.column_dimensions[get_column_letter(COL_ENTITY)].width = 28
    for a_idx in range(len(tab3b_rows)):
        for s, w in enumerate([14, 14, 15, 13, 13]): ws.column_dimensions[get_column_letter(COL_DATA_START + a_idx * N_SUB + s)].width = w
    ws.freeze_panes = ws.cell(row=ROW_DATA_START, column=COL_DATA_START)

    return {"sheet": SHEET_3B, "accounts_written": len(tab3b_rows)}

