TARGET_SHEETS = ("Balance Sheet", "Income Statement")     # only these source sheets get scanned for blue overrides
CELL_PATTERN = re.compile(r"^\$?([A-Za-z]+)\$?(\d+)$")     # matches "A1", "$B$12" etc.; captures column letters + row number

def excel_column_index(excel_column):
    # Convert Excel column letters ("A", "AB", ...) to a 0-based numeric index, base-26 style.
    index = 0
    for letter in excel_column.upper():
        index = index * 26 + ord(letter) - ord("A") + 1
    return index - 1

def normalize_sheet_names(sheet_names):
    # Accept None (= all sheets), a single sheet name string, or a collection of names,
    # and always return a set of names (or None to mean "no filter").
    if sheet_names is None:
        return None
    if isinstance(sheet_names, str):
        return {sheet_names.strip()}
    return {str(name).strip() for name in sheet_names}

def get_blue_amounts(excel_path, sheet_names, excel_data_start_row=4):
    # Open the workbook twice: once with cached formula RESULTS (data_only=True) and once with
    # the raw FORMULAS (data_only=False), so we can report both the formula and its computed value.
    values_workbook = cp.openpyxl.read(excel_path, data_only=True)
    formulas_workbook = cp.openpyxl.read(excel_path, data_only=False)

    selected_sheet_names = normalize_sheet_names(sheet_names)
    blue_amounts = []

    def get_font_rgb(cell):
        # Extract a cell's font color as a 6-hex-char RGB string, or None if not an RGB color
        # (e.g. theme colors aren't handled here).
        color = cell.font.color
        if color is None: return None
        if color.type == "rgb" and color.rgb:
            return str(color.rgb).replace("#", "")[-6:].upper()
        return None

    def is_blue_font(cell):
        # Heuristic "is this the manual-override blue, not some other color" test:
        # blue channel must be reasonably strong AND clearly dominate red/green.
        rgb = get_font_rgb(cell)
        if rgb is None: return False
        red, green, blue = int(rgb[0:2], 16), int(rgb[2:4], 16), int(rgb[4:6], 16)
        return blue >= 100 and blue > red * 1.25 and blue > green * 1.10

    try:
        available_sheet_names = {ws.title for ws in formulas_workbook.worksheets}
        if selected_sheet_names is not None:
            missing = selected_sheet_names - available_sheet_names
            if missing: raise ValueError(f"Worksheet(s) not found: {sorted(missing)}")

        for formula_worksheet in formulas_workbook.worksheets:
            sheet_name = formula_worksheet.title
            if selected_sheet_names is not None and sheet_name not in selected_sheet_names:
                continue                                    # skip sheets we weren't asked to scan
            value_worksheet = values_workbook[sheet_name]    # same sheet, but from the cached-values workbook

            for row in formula_worksheet.iter_rows(min_row=1, max_row=formula_worksheet.max_row):
                for formula_cell in row:
                    value_cell = value_worksheet[formula_cell.coordinate]   # same coordinate, values workbook
                    cached_value = value_cell.value
                    formula_or_value = formula_cell.value
                    if cached_value is None and formula_or_value is None: continue   # truly empty cell, skip
                    if not is_blue_font(formula_cell): continue                       # not a manual override, skip

                    amount = cached_value if cached_value is not None else formula_or_value   # prefer computed value
                    local_row_id = formula_cell.row - excel_data_start_row + 1                # convert sheet row -> data-relative row id
                    if local_row_id < 1: continue                                              # above the data start row (header), skip

                    blue_amounts.append({
                        "sheet_name": sheet_name,
                        "cell_address": formula_cell.coordinate,
                        "amount": amount,
                        "font_rgb": get_font_rgb(formula_cell),
                        "is_blue": True,
                        "row_id": local_row_id,
                    })
    finally:
        values_workbook.close()             # always release file handles even on error
        formulas_workbook.close()

    return blue_amounts

def get_dynamic_sheet_row_counts(excel_path, sheet_names=TARGET_SHEETS, excel_data_start_row=4, max_data_column=None):
    # For each target sheet, find how many data rows actually have content (scanning down until
    # a fully-blank row), rather than trusting worksheet.max_row (which can overstate due to
    # stray formatting on otherwise-empty rows).
    workbook = cp.openpyxl.read(excel_path, data_only=False)
    selected_sheet_names = normalize_sheet_names(sheet_names)
    sheet_row_counts = {}
    try:
        available_sheet_names = {ws.title for ws in workbook.worksheets}
        if selected_sheet_names is not None:
            missing = selected_sheet_names - available_sheet_names
            if missing: raise ValueError(f"Worksheet(s) not found: {sorted(missing)}")

        for worksheet in workbook.worksheets:
            sheet_name = worksheet.title
            if selected_sheet_names is not None and sheet_name not in selected_sheet_names:
                continue
            if worksheet.max_row < excel_data_start_row:
                sheet_row_counts[sheet_name] = 0            # sheet has no data rows at all
                continue
            scan_to_column = worksheet.max_column if max_data_column is None else min(max_data_column, worksheet.max_column)
            last_data_row = excel_data_start_row - 1          # default: no data rows found yet
            for row in worksheet.iter_rows(min_row=excel_data_start_row, max_row=worksheet.max_row,
                                           min_col=1, max_col=scan_to_column):
                if any(cell.value is not None for cell in row):
                    last_data_row = row[0].row               # track the last row seen with any non-empty cell
            sheet_row_counts[sheet_name] = max(0, last_data_row - excel_data_start_row + 1)
    finally:
        workbook.close()
    return sheet_row_counts

def create_appended_spark_column_row_pairs(blue_amounts, spark_columns, sheet_row_counts, sheet_order=TARGET_SHEETS):
    # Translate raw blue-cell hits (sheet + Excel cell address) into (spark_column_name, global_row_id)
    # pairs, where "global" row_id accounts for Balance Sheet rows being appended before Income
    # Statement rows in the combined Spark frame.
    spark_columns = list(spark_columns)
    sheet_order = tuple(sheet_order)
    missing_counts = {s for s in sheet_order if s not in sheet_row_counts}
    if missing_counts: raise ValueError(f"Missing dynamic row counts for: {sorted(missing_counts)}")

    sheet_offsets, current_offset = {}, 0
    for sheet_name in sheet_order:
        sheet_offsets[sheet_name] = current_offset            # e.g. Income Statement rows start after all BS rows
        current_offset += sheet_row_counts[sheet_name]

    pairs, seen_pairs, missing_excel_columns = [], set(), set()

    for item in blue_amounts:
        if item.get("is_blue") is not True: continue
        sheet_name, local_row_id = item.get("sheet_name"), item.get("row_id")
        if sheet_name not in sheet_offsets or local_row_id is None: continue
        local_row_id = int(local_row_id)
        if not (1 <= local_row_id <= sheet_row_counts[sheet_name]): continue   # ignore rows outside the real data range

        match = CELL_PATTERN.fullmatch(str(item.get("cell_address", "")).strip().upper())
        if not match: continue

        excel_column = match.group(1)
        column_index = excel_column_index(excel_column)
        if column_index >= len(spark_columns):
            missing_excel_columns.add(excel_column)          # Excel column has no counterpart in the Spark frame
            continue

        column_name = spark_columns[column_index]
        row_id = sheet_offsets[sheet_name] + local_row_id      # shift local row id into the combined frame's numbering
        pair = (column_name, row_id)
        if pair not in seen_pairs:                              # de-dup (same cell shouldn't be added twice)
            pairs.append(pair)
            seen_pairs.add(pair)

    if missing_excel_columns:
        print("Skipped Excel columns without matching Spark columns: " + ", ".join(sorted(missing_excel_columns)))
    return pairs

