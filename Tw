def Ctrl_Totals(df, column_names):
    # Build one aggregate row: sum() of each requested column + a row count. Used as a
    # before/after control-total check so data isn't silently dropped/altered mid-pipeline.
    agg_exprs = [F.sum(F.col(c)).alias(c) for c in column_names]
    return df.agg(*agg_exprs, F.count("*").alias("count"))

