def _unique_texts(items):
    # Stringify, strip, and de-dup a list while preserving first-seen order (drop blanks).
    result, seen = [], set()
    for item in items or []:
        text = str(item).strip()
        if text and text not in seen:
            result.append(text)
            seen.add(text)
    return result

def _to_excel_percentage(value):
    """Excel stores % as a 0..1 fraction."""
    number = to_decimal(value)
    if number is None:
        return None
    # Assuming standard behavior where missing % from string makes 15% -> 15.0
    return number / Decimal("100") if abs(number) > 1 else number
    # heuristic: if the source value already looks like "15" (post "%"-strip) it means 15%, so
    # divide by 100; if it's already a small fraction like 0.15, leave it alone.

def _is_nonzero(value):
    # True if the value parses to a Decimal and that Decimal isn't exactly zero.
    number = to_decimal(value)
    return number is not None and number != 0

def _is_no(value):
    # Loose "did the cell literally say No" check, used for the "Test consolidated amount" flag.
    return str(value).strip().casefold() == "no"

def _median_decimal(values):
    # Standard median calc but kept in Decimal precision throughout (no float mixing).
    if not values: return None
    ordered = sorted(values)
    middle = len(ordered) // 2
    if len(ordered) % 2:
        return ordered[middle]                                    # odd count: exact middle element
    return (ordered[middle - 1] + ordered[middle]) / Decimal("2")   # even count: average the two middle elements

def _number_format(column_label):
    # Choose an Excel number format string based on what kind of column this is.
    normalized = normalize_text(column_label)
    if normalized in {"% of consolidated balance", "% of the total balance"}: return "0.00%"
    if normalized in {"times of materiality", "multiple of materiality balance"}: return "0.00"
    return "#,##0;(#,##0)"                                          # default: comma-grouped, parens for negatives

def _arrange_output_columns(source_columns, calculated_columns):
    # Decide final column order for the sheet: keep source columns in place, but splice the
    # CALCULATED_COLUMNS in right after "Test consolidated amount" (so entity balances follow after).
    calculated_columns = _unique_texts(calculated_columns)
    if not calculated_columns: return list(source_columns)
    calculated_keys = {normalize_text(c) for c in calculated_columns}
    source_without_calculated = [c for c in source_columns if normalize_text(c) not in calculated_keys]
    test_column = require_column(source_without_calculated, "Test consolidated amount")
    insert_position = source_without_calculated.index(test_column) + 1
    return source_without_calculated[:insert_position] + calculated_columns + source_without_calculated[insert_position:]

def set_materiality(template, value, target_sheet=QUANTITATIVE_SHEET, cell="C10"):
    # Write the materiality dollar amount into its labeled cell in the template, resolving
    # through any merged-cell range first (Excel only lets you write to the anchor cell of a merge).
    worksheet = template[target_sheet]
    for merged_range in worksheet.merged_cells.ranges:
        if cell in merged_range:
            cell = merged_range.coord.split(":", 1)[0]   # redirect to the merge's top-left anchor cell
            break
    target = worksheet[cell]
    target.value = int(value)
    target.number_format = "[$$-en-US]#,##0"

def _unmerge_intersecting_ranges(worksheet, row_number, start_column, end_column):
    # Before writing fresh header text into a row/column range, remove any pre-existing merged
    # cells overlapping it (otherwise openpyxl would silently fail to set values on non-anchor cells).
    for merged_range in list(worksheet.merged_cells.ranges):
        if (merged_range.min_row <= row_number <= merged_range.max_row
                and merged_range.min_col <= end_column and merged_range.max_col >= start_column):
            worksheet.unmerge_cells(merged_range.coord)

def _apply_header_style(cell, fill, border, font, alignment):
    cell.fill, cell.border, cell.font, cell.alignment = fill, border, font, alignment
    cell.number_format = "General"

def _write_table_headers(worksheet, header_row, start_column, output_columns, fill, border, font, alignment):
    # Write the single-row column header labels across the full output width.
    end_column = start_column + len(output_columns) - 1
    _unmerge_intersecting_ranges(worksheet, header_row, start_column, end_column)
    for index, column_label in enumerate(output_columns):
        cell = worksheet.cell(row=header_row, column=start_column + index)
        cell.value = column_label
        _apply_header_style(cell, fill, border, font, alignment)

def _write_analysis_headers(worksheet, header_row, start_column, output_columns, calculated_columns,
                             fill, border, font, alignment):
    # Add two extra rows ABOVE the column-header row: a "D&T analysis" super-header spanning all
    # calculated columns, and a "Highest balance in a residual entities" sub-header spanning the
    # narrower HIGHEST_BALANCE_GROUP subset — both as merged cells.
    if not calculated_columns: return
    calculated_keys = {normalize_text(c) for c in calculated_columns}
    calculated_indices = [i for i, c in enumerate(output_columns) if normalize_text(c) in calculated_keys]
    highest_indices = [i for i, c in enumerate(output_columns) if normalize_text(c) in HIGHEST_BALANCE_GROUP]

    analysis_start, analysis_end = start_column + min(calculated_indices), start_column + max(calculated_indices)
    highest_start, highest_end = start_column + min(highest_indices), start_column + max(highest_indices)
    top_row, subgroup_row = header_row - 2, header_row - 1

    for row_number in (top_row, subgroup_row):
        _unmerge_intersecting_ranges(worksheet, row_number, analysis_start, analysis_end)
        for column_number in range(analysis_start, analysis_end + 1):
            cell = worksheet.cell(row=row_number, column=column_number)
            cell.value = None
            _apply_header_style(cell, fill, border, font, alignment)     # blank-and-restyle before merging

    worksheet.merge_cells(start_row=top_row, start_column=analysis_start, end_row=top_row, end_column=analysis_end)
    dt_header = worksheet.cell(row=top_row, column=analysis_start)
    dt_header.value = "D&T analysis"
    _apply_header_style(dt_header, fill, border, font, alignment)

    worksheet.merge_cells(start_row=subgroup_row, start_column=highest_start, end_row=subgroup_row, end_column=highest_end)
    highest_header = worksheet.cell(row=subgroup_row, column=highest_start)
    highest_header.value = "Highest balance in a residual entities"
    _apply_header_style(highest_header, fill, border, font, alignment)

def _calculate_analysis_values(record, source_row_id, entity_columns, blue_pair_keys,
                                materiality, consolidated_column, untested_column):
    # Compute the 6 CALCULATED_COLUMNS values for one trial-balance row.
    materiality_value = to_decimal(materiality)
    residual_balances = [
        # Only entity balances that are (a) NOT a manually-overridden ("blue") cell for this row and
        # (b) non-zero, count as "residual" balances for mean/median/highest.
        balance for column in entity_columns
        if (column, source_row_id) not in blue_pair_keys
        for balance in [to_decimal(record.get(column))]
        if balance not in (None, Decimal("0"))
    ]

    mean_value = median_value = highest_balance = None
    if residual_balances:
        mean_value = sum(residual_balances) / Decimal(len(residual_balances))
        median_value = _median_decimal(residual_balances)
        highest_balance = max(residual_balances)

    untested_balance = to_decimal(record.get(untested_column))
    consolidated_balance = to_decimal(record.get(consolidated_column))

    times_of_materiality = untested_balance / materiality_value if untested_balance is not None else None
    percentage_of_total = (highest_balance / consolidated_balance
                            if highest_balance is not None and consolidated_balance not in (None, Decimal("0")) else None)
    multiple_of_materiality = highest_balance / materiality_value if highest_balance is not None else None

    return {
        "Times of materiality": times_of_materiality, "Mean": mean_value, "Median": median_value,
        "Highest balance in a residual entity": highest_balance, "% of the total balance": percentage_of_total,
        "Multiple of materiality balance": multiple_of_materiality,
    }

def _write_detail_row(worksheet, row_number, start_column, output_columns, account_column,
                       entity_columns, record, consolidated_column, materiality, label,
                       calculation_type, white_fill, body_border, body_font):
    # Writes one of the two extra "detail" rows placed under each account row (percentage-of-total
    # or multiple-of-materiality, per-entity), reusing each entity column's cell position.
    materiality_value = to_decimal(materiality)
    consolidated_value = to_decimal(record.get(consolidated_column))
    value_alignment, label_alignment = make_alignment("right", "center"), make_alignment("right", "center")

    for index, column_label in enumerate(output_columns):
        cell = worksheet.cell(row=row_number, column=start_column + index)
        cell.value = None
        cell.fill, cell.border, cell.font, cell.alignment = white_fill, body_border, body_font, value_alignment
        cell.number_format = "General"

        if column_label == account_column:
            cell.value, cell.alignment = label, label_alignment     # put the row's descriptive label under the Account column
            continue
        if column_label not in entity_columns: continue              # only entity columns get a computed value on this row

        balance = to_decimal(record.get(column_label))
        if balance is None: continue
        if calculation_type == "percentage":
            if consolidated_value in (None, Decimal("0")): continue
            cell.value, cell.number_format = balance / consolidated_value, "0.00%"
        else:
            cell.value, cell.number_format = balance / materiality_value, "0.00"

def _apply_package_borders(worksheet, package_start_row, package_end_row, start_column, end_column):
    # Draws a bold black outline around each 3-row "package" (account row + its 2 detail rows),
    # with thin light-grey grid lines inside the package.
    black_side, light_side = Side(style="thin", color=BLACK), Side(style="thin", color="FFE6E6E6")
    for row_number in range(package_start_row, package_end_row + 1):
        for column_number in range(start_column, end_column + 1):
            worksheet.cell(row=row_number, column=column_number).border = Border(
                left=black_side if column_number == start_column else light_side,
                right=black_side if column_number == end_column else light_side,
                top=black_side if row_number == package_start_row else light_side,
                bottom=black_side if row_number == package_end_row else light_side,
            )

def _build_cy_blue_pair_lookup(spark_column_row_pairs_cy, raw_tb_CY, row_id_col=ROW_ID_COLUMN):
    # Convert the CY blue-cell (column, row_id) list into a fast-lookup set of exact (column, int(row_id)) tuples.
    exact_pairs = set()
    for position, pair in enumerate(spark_column_row_pairs_cy or [], start=1):
        column_name, row_id = pair
        exact_pairs.add((column_name, int(row_id)))
    return exact_pairs

def append_raw_tb_cy_to_sheet(template, raw_tb_CY, spark_column_row_pairs_cy, target_sheet,
                               anchor_cell=TABLE_ANCHOR_CELL, calculated_columns=None,
                               clear_existing=True, materiality=None, row_id_col=ROW_ID_COLUMN):
    # Main writer for both the Quantitative and Qualitative sheets: builds the header block,
    # then loops every trial-balance record writing either a full visible row (with optional
    # calculated columns + 2 detail rows, Quantitative only) or a collapsed/greyed row.
    worksheet = template[target_sheet]
    source_columns = [c for c in raw_tb_CY.columns if c != row_id_col]

    calculated_columns = _unique_texts(CALCULATED_COLUMNS if calculated_columns is None else calculated_columns)
    if target_sheet != QUANTITATIVE_SHEET: calculated_columns = []   # Qualitative sheet never gets the calc columns

    output_columns = _arrange_output_columns(source_columns, calculated_columns)
    calculated_keys = {normalize_text(c) for c in calculated_columns}

    blue_pair_keys = _build_cy_blue_pair_lookup(spark_column_row_pairs_cy, raw_tb_CY, row_id_col=row_id_col)
    account_column = require_column(source_columns, "Account")
    percentage_column = require_column(source_columns, PERCENTAGE_COLUMN_NAME)
    test_column = require_column(source_columns, "Test consolidated amount")

    entity_columns, consolidated_column, untested_column = [], None, None
    if calculated_columns:
        materiality = MATERIALITY if materiality is None else materiality
        entity_columns = find_entity_columns(source_columns, excludes=calculated_columns)
        consolidated_column = require_column(source_columns, "Consolidated")
        untested_column = require_column(source_columns, "Untested Balance")

    header_row, start_column = coordinate_to_tuple(anchor_cell)

    if clear_existing:
        end_column = start_column + max(len(output_columns), 1) - 1
        clear_worksheet_area(worksheet, header_row, start_column, end_column=worksheet.max_column)  # wipe any stale content from prior runs

    header_fill = white_fill = make_fill(WHITE)
    grey_fill = make_fill(GREY_OUT_FILL)
    body_border = header_border = make_border(BLACK)
    no_border = Border()
    header_font = make_font(BLACK, name="Arial", size=9, bold=True)
    body_font = make_font(BLACK, name="Arial", size=9)
    greyed_out_font = make_font(GREYED_OUT_FONT_COLOR, name="Arial", size=9)
    blue_font = make_font(BLUE_FONT_COLOR, name="Arial", size=9)
    header_alignment = make_alignment("center", "center", wrap=True)
    body_alignment = Alignment(vertical="center")

    _write_table_headers(worksheet, header_row, start_column, output_columns, header_fill, header_border, header_font, header_alignment)
    _write_analysis_headers(worksheet, header_row, start_column, output_columns, calculated_columns,
                             header_fill, header_border, header_font, header_alignment)

    account_output_index = output_columns.index(account_column)
    data_start_row = header_row + 1
    records_written = detail_rows_written = 0
    package_ranges = []       # remembers (start_row, end_row) of each 3-row account "package" for later border styling

    for record in records_from(raw_tb_CY.select(*(source_columns + [row_id_col]))):
        source_row_id = int(record[row_id_col])
        # a row stays "visible" (residual candidate) only if it has a non-zero % of consolidated
        # balance AND was flagged "No" for full-population testing
        keep_row_visible = _is_nonzero(record.get(percentage_column)) and _is_no(record.get(test_column))

        analysis_values = {}
        if calculated_columns:
            analysis_values = _calculate_analysis_values(
                record=record, source_row_id=source_row_id, entity_columns=entity_columns,
                blue_pair_keys=blue_pair_keys, materiality=materiality,
                consolidated_column=consolidated_column, untested_column=untested_column)

        package_start_row = data_start_row + records_written

        for index, column_label in enumerate(output_columns):
            cell = worksheet.cell(row=package_start_row, column=start_column + index)
            normalized = normalize_text(column_label)
            is_account_cell = index == account_output_index
            is_calculated = normalized in calculated_keys

            blue_key = (column_label, source_row_id)
            selected_blue = blue_key in blue_pair_keys

            if not keep_row_visible:
                # non-residual row: collapse to a single grey row showing only the account name
                cell.alignment, cell.number_format, cell.border = body_alignment, "General", no_border
                if is_account_cell:
                    cell.value = record.get(account_column)
                    cell.fill, cell.font = PatternFill(fill_type=None), greyed_out_font
                else:
                    cell.value, cell.fill, cell.font = None, grey_fill, body_font
                continue

            if is_calculated:
                cell.value = analysis_values.get(column_label)
            else:
                cell.value = record.get(column_label)
                if normalized == normalize_text(percentage_column):
                    cell.value = _to_excel_percentage(cell.value)

            cell.fill, cell.border, cell.font, cell.alignment = white_fill, body_border, body_font, body_alignment
            cell.number_format = _number_format(column_label) if cell.value not in (None, "") and to_decimal(cell.value) is not None else "General"

            if selected_blue and not is_calculated:
                cell.font = blue_font    # re-mark manually-overridden source cells in blue, same as the original workbook

        records_written += 1

        if target_sheet == QUANTITATIVE_SHEET and keep_row_visible:
            # Quantitative sheet: append the 2 per-entity detail rows right under a visible account row
            percentage_row = data_start_row + records_written
            _write_detail_row(worksheet, percentage_row, start_column, output_columns, account_column,
                               entity_columns, record, consolidated_column, materiality,
                               ENTITY_PERCENT_DETAIL_LABEL, "percentage", white_fill, body_border, body_font)
            records_written += 1
            detail_rows_written += 1

            multiple_row = data_start_row + records_written
            _write_detail_row(worksheet, multiple_row, start_column, output_columns, account_column,
                               entity_columns, record, consolidated_column, materiality,
                               ENTITY_MULTIPLE_DETAIL_LABEL, "multiple", white_fill, body_border, body_font)
            records_written += 1
            detail_rows_written += 1

            package_ranges.append((package_start_row, data_start_row + records_written - 1))

    end_column = start_column + len(output_columns) - 1
    if target_sheet == QUANTITATIVE_SHEET:
        for package_start, package_end in package_ranges:
            _apply_package_borders(worksheet, package_start, package_end, start_column, end_column)

    data_end_row = data_start_row + records_written - 1 if records_written else header_row
    worksheet.auto_filter.ref = f"{get_column_letter(start_column)}{header_row}:{get_column_letter(end_column)}{data_end_row}"
    worksheet.freeze_panes = f"{get_column_letter(start_column)}{data_start_row}"     # freeze so header stays visible while scrolling
    worksheet.row_dimensions[header_row].height = 32
    worksheet.sheet_view.showGridLines = False

    return {"sheet": target_sheet, "detail_rows_written": detail_rows_written}

