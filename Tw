        return investigate_coordinates    # nothing more to write for a blank account name; bail early

    account_cell = worksheet.cell(row=balance_row, column=2)
    account_cell.value = account_value
    account_cell.font, account_cell.alignment = S3A_FONT_BLACK, S3A_ALIGN_LEFT
