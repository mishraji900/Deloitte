def s3a_get_sheet_materiality(worksheet, fallback_value):
    # Read materiality directly off the worksheet cell if it's populated and non-zero, else fall back.
    # (Defined but not actually called later in this section — populate_sheet_3a sets the cell itself
    #  from the passed-in `materiality` argument instead.)
    coordinate = MATERIALITY_CELL.replace("$", "")
    sheet_value = to_decimal(worksheet[coordinate].value)
    return fallback_value if sheet_value in {None, Decimal("0")} else sheet_value

def s3a_build_blue_pair_lookups(spark_column_row_pairs_cy, row_id_col=ROW_ID_COLUMN):
    # Build two lookup sets of blue/manually-overridden (column, row_id) pairs: an exact-text set
    # and a normalize_text()'d set, so later matching can fall back to fuzzy column-name comparison.
    exact_pairs, normalized_pairs = set(), set()
    row_id_key = normalize_text(row_id_col)
    for pair in spark_column_row_pairs_cy or []:
        try:
            column_name, source_row_id = pair
            if column_name is None or normalize_text(column_name) == row_id_key: continue
            source_row_id = int(source_row_id)
            if source_row_id < 1: continue
            exact_pairs.add((str(column_name).strip(), source_row_id))
            normalized_pairs.add((normalize_text(column_name), source_row_id))
        except (TypeError, ValueError): continue
    return exact_pairs, normalized_pairs

def s3a_is_blue_cell(entity_column, source_row_id, blue_exact_pairs, blue_normalized_pairs):
    # True if this (entity_column, row) was flagged as a manual override, checking exact match first
    # then the normalized-name fallback.
    try: source_row_id = int(source_row_id)
    except (ValueError, TypeError): return False
    return ((str(entity_column).strip(), source_row_id) in blue_exact_pairs
            or (normalize_text(entity_column), source_row_id) in blue_normalized_pairs)

def s3a_build_residual_rows(updated_raw_tb_CY, materiality, row_id_col=ROW_ID_COLUMN):
    # Select the CY trial-balance rows that actually qualify for the "3a" sheet: has an account
    # name, has a non-zero % of consolidated balance, was flagged "No" for full-population testing,
    # AND its Untested Balance exceeds 1x materiality (i.e. matches Tab 3's "inv2 = Yes" test).
    materiality_value = to_decimal(materiality)
    source_columns = list(updated_raw_tb_CY.columns)
    row_id_column = require_column(source_columns, row_id_col)
    account_column = require_column(source_columns, "Account")
    percentage_column = require_column(source_columns, PERCENTAGE_COLUMN_NAME)
    test_column = require_column(source_columns, "Test consolidated amount")
    untested_column = require_column(source_columns, "Untested Balance")

    residual_rows = []
    for record in records_from(updated_raw_tb_CY):
        source_row_id = int(record.get(row_id_column))
        if normalize_text(record.get(account_column)) == "": continue
        percentage_value = to_decimal(record.get(percentage_column))
        if percentage_value in {None, Decimal("0")}: continue
        if normalize_text(record.get(test_column)) != "no": continue
        untested_value = to_decimal(record.get(untested_column))
        if untested_value is None: continue
        if abs(untested_value / materiality_value) <= Decimal("1"): continue   # skip if not "> 1x materiality"

        residual_rows.append({"Account_CY": record.get(account_column), "row_id": source_row_id, "record": record})
    residual_rows.sort(key=lambda row: row["row_id"])     # preserve original trial-balance row order
    return residual_rows

def s3a_build_tab2_row_lookup(template):
    # Scan the "3. Residual Analytic..." sheet's column B for account names, mapping
    # normalized-account-name -> row number, so 3a can pull each account's Tab-2 total by reference.
    worksheet = template[TAB_2_SHEET]
    lookup = {}
    for row_number in range(1, worksheet.max_row + 1):
        account_key_value = normalize_text(worksheet.cell(row=row_number, column=2).value)
        if account_key_value and account_key_value not in lookup:
            lookup[account_key_value] = row_number   # first occurrence of a given account name wins
    return lookup

def s3a_copy_block_style(worksheet, source_start_row, target_start_row, start_column, end_column, source_max_column):
    # Clone the template's first block's row heights + full per-cell style onto a newly-added block
    # (so every account's block looks visually identical to the template's example block).
    for row_offset in range(DATA_ROWS):
        source_row, target_row = source_start_row + row_offset, target_start_row + row_offset
        worksheet.row_dimensions[target_row].height = worksheet.row_dimensions[source_row].height
        for column in range(start_column, end_column + 1):
            source_cell = worksheet.cell(row=source_row, column=min(column, source_max_column))   # clamp to avoid reading past template's real columns
            target_cell = worksheet.cell(row=target_row, column=column)
            if not isinstance(target_cell, MergedCell):
                style_args = source_cell._style if source_cell._style is not None else _DEFAULT_STYLE
                target_cell._style = StyleArray(style_args)   # fast whole-style copy (font+fill+border+alignment+number_format in one shot)

def s3a_wipe_spacer_rows(worksheet, spacer_start_row, start_column, end_column):
    # Fully reset the two blank "spacer" rows between account blocks (value/style/format all cleared).
    for spacer_row in (spacer_start_row, spacer_start_row + 1):
        for column in range(start_column, end_column + 1):
            cell = worksheet.cell(row=spacer_row, column=column)
            if not isinstance(cell, MergedCell):
                cell.value, cell.fill, cell.border = None, S3A_FILL_NONE, S3A_BORDER_NONE
                cell.font, cell.alignment, cell.number_format = Font(), Alignment(), "General"

def s3a_apply_all_investigate_colors(worksheet, investigate_coordinates):
    # Add conditional-formatting rules to every "Investigate?" formula cell across all blocks:
    # red if the result isn't literally "No", green if it is.
    for coordinate in investigate_coordinates:
        abs_coord = absolute_coordinate(coordinate)
        red_rule = FormulaRule(formula=[f'{abs_coord}<>"No"'], stopIfTrue=True)
        red_rule.dxf = DifferentialStyle(fill=PatternFill(start_color=RED_FILL_COLOR, end_color=RED_FILL_COLOR, fill_type="solid"))
        red_rule.priority = 1
        green_rule = FormulaRule(formula=[f'{abs_coord}="No"'], stopIfTrue=True)
        green_rule.dxf = DifferentialStyle(fill=PatternFill(start_color=GREEN_FILL_COLOR, end_color=GREEN_FILL_COLOR, fill_type="solid"))
        green_rule.priority = 2
        worksheet.conditional_formatting.add(coordinate, red_rule)
        worksheet.conditional_formatting.add(coordinate, green_rule)

def s3a_write_block(worksheet, block_start_row, record, account_column, source_row_id,
                     entity_columns, blue_exact_pairs, blue_normalized_pairs, tab2_row_lookup):
