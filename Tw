GREY_MARKER = "__grey__"   # sentinel string written into cells that were manually overridden (blue font)

def is_grey_marker(value) -> bool:
    """True if `value` is the grey/blue-override sentinel (case-insensitive)."""
    # Must be a str (numbers/None can't match) and equal the sentinel after trim+casefold.
    return isinstance(value, str) and value.strip().casefold() == GREY_MARKER

def to_decimal(value):
    """Safely parse inputs (numbers, accounting strings, percentages) into Decimals."""
    if value is None or isinstance(value, bool) or is_grey_marker(value):
        return None                                    # bool excluded: bool is a subclass of int, would wrongly parse as 0/1
    if isinstance(value, Decimal):
        return value if value.is_finite() else None     # reject NaN/Inf Decimals

    if isinstance(value, (int, float)) or hasattr(value, "__float__"):
        try:
            numeric_value = float(value)                 # normalize numpy/other numeric types via float()
        except (ValueError, TypeError, OverflowError):
            numeric_value = None
        if numeric_value is not None:
            if numeric_value != numeric_value:   # NaN
                return None                              # NaN != NaN is the classic NaN check
            decimal_value = Decimal(str(round(numeric_value, 10)))
            # round via str() first to avoid Decimal inheriting float's binary representation noise
            return decimal_value if decimal_value.is_finite() else None

    try:
        text = str(value).replace(",", "").replace("$", "").strip()   # strip thousands separators/currency sign
        if text.endswith("%"):
            text = text[:-1].strip()                      # drop trailing "%" (value stays same magnitude here)
        if text.startswith("(") and text.endswith(")"):
            text = "-" + text[1:-1]                        # accounting negative notation "(123)" -> "-123"
        if text in {"", "-", "\u2014", GREY_MARKER}:
            return None                                    # blank / bare dash / em-dash / sentinel -> no value
        decimal_value = Decimal(text)
        return decimal_value if decimal_value.is_finite() else None
    except (InvalidOperation, ValueError, TypeError):
        return None                                        # anything unparsable -> treat as missing, not an error

def to_excel_number(value):
    """Write-side counterpart to to_decimal: normalise a value for an openpyxl cell."""
    if value is None or is_grey_marker(value):
        return None                                        # keep cell blank for missing/overridden values
    if isinstance(value, Decimal):
        return float(value)                                 # openpyxl/Excel wants native float, not Decimal
    return value                                            # pass through anything else unchanged (str, int...)

def normalize_text(value) -> str:
    """Whitespace-collapsed, case-folded key, used for simple name matching."""
    if value is None:
        return ""
    # replace non-breaking space with regular space, strip, collapse internal whitespace runs, casefold
    return " ".join(str(value).replace("\u00a0", " ").strip().split()).casefold()

def is_present(value) -> bool:
    """True if `value` is a real value."""
    if value is None:
        return False
    # treat these text forms as "no real value" so blank-looking cells don't count as data
    return str(value).strip().casefold() not in {"", "blank", "none", "null", "nan", GREY_MARKER, "-", "\u2014"}

_ACCOUNT_KEY_TYPO_FIXES = [
    # known misspellings in source account names get normalized before matching
    (re.compile(r"\bvalutaion\b"), "valuation"),
    (re.compile(r"\bvalutations\b"), "valuation"),
]

_PLURAL_SAFE_ENDINGS = ("ss", "us", "is", "as", "ous")  # words ending these ways are NOT plurals (bus, basis, etc.)

def _strip_plural(token: str) -> str:
    # naive de-pluralizer: drop trailing 's' unless token is too short or ends in a safe-ending
    if len(token) <= 2 or not token.endswith("s"):
        return token
    if token.endswith(_PLURAL_SAFE_ENDINGS):
        return token
    return token[:-1]

def account_key(value) -> str:
    """Deterministic normalization key for account-name matching."""
    if not value:
        return ""
    text = str(value).casefold().strip()
    text = text.replace("'", "").replace("\u2019", "")          # drop straight & curly apostrophes
    text = text.replace("&", " and ")                            # normalize ampersand to word
    text = re.sub(r"[-\u2013\u2014]", " ", text)                  # hyphen/en-dash/em-dash -> space
    for pattern, replacement in _ACCOUNT_KEY_TYPO_FIXES:
        text = pattern.sub(replacement, text)                     # fix known typos
    text = re.sub(r"[^a-z0-9 ]+", " ", text)                       # strip remaining punctuation
    text = re.sub(r"\s+", " ", text).strip()                      # collapse whitespace
    tokens = sorted(text.split())                                  # sort tokens so word order doesn't matter
    tokens = [_strip_plural(t) for t in tokens]                     # singularize each token
    return " ".join(tokens)                                         # final order/typo/plural-insensitive key

def spark_account_key(column_name: str, alias_map: dict[str, str] | None = None):
    """Spark-expression equivalent of account_key()."""
    # Mirrors account_key() above but as a chain of Spark Column expressions (runs distributed,
    # not row-by-row in Python) so CY/PY account names can be joined at scale.
    step = F.lower(F.trim(F.col(f"`{column_name}`").cast("string")))
    step = F.regexp_replace(step, r"['\u2019]", "")                 # strip apostrophes
    step = F.regexp_replace(step, r"&", " and ")                    # & -> and
    step = F.regexp_replace(step, r"[-\u2013\u2014]", " ")           # dashes -> space
    step = F.regexp_replace(step, r"(?i)\bvalutaions?\b", "valuation")  # typo fix
    step = F.regexp_replace(step, r"[^a-z0-9 ]+", " ")                # strip punctuation
    step = F.trim(F.regexp_replace(step, r"\s+", " "))                 # collapse whitespace

    tokens = F.array_sort(F.split(step, " "))                          # tokenize + sort (order-insensitive)
    tokens_singular = F.transform(
        tokens,
        # per-token: strip trailing 's' unless too short or a safe-ending word (mirrors _strip_plural)
        lambda t: F.when(
            (F.length(t) > 2) & t.endswith("s")
            & (~t.endswith("ss")) & (~t.endswith("us")) & (~t.endswith("is"))
            & (~t.endswith("as")) & (~t.endswith("ous")),
            F.regexp_replace(t, "s$", ""),
        ).otherwise(t),
    )
    rich_key = F.concat_ws(" ", tokens_singular)                       # rejoin tokens into final key string

    if alias_map:
        # optional manual override: if rich_key matches a known alias, swap it for its canonical form
        map_literal = F.create_map(*[
            item for pair in alias_map.items() for item in (F.lit(pair[0]), F.lit(pair[1]))
        ])
        return F.coalesce(map_literal[rich_key], rich_key)              # use mapped value if present, else raw key
    return rich_key

def records_from(dataframe):
    # Normalizes Spark DataFrame / pandas DataFrame / plain iterable-of-rows into a list of dicts,
    # so downstream code can treat any of these the same way.
    if dataframe is None:
        return []
    if hasattr(dataframe, "collect"):
        return [row.asDict(recursive=True) for row in dataframe.collect()]   # Spark path (pulls to driver)
    if hasattr(dataframe, "to_dict"):
        return dataframe.to_dict(orient="records")                            # pandas path
    return [row.asDict(recursive=True) if hasattr(row, "asDict") else dict(row) for row in dataframe]  # generic fallback

def dataframe_columns(dataframe):
    # Get column names regardless of whether input is a real DataFrame (has .columns) or a plain
    # list of row-dicts (infer from first record's keys).
    if hasattr(dataframe, "columns"):
        return list(dataframe.columns)
    records = records_from(dataframe)
    return list(records[0].keys()) if records else []

def get_field(record, *field_names):
    # Look up a dict value by any of several possible spellings of the field name
    # (case/whitespace-insensitive), since different exports may label the same field differently.
    wanted = {normalize_text(name) for name in field_names}
    for actual_name, value in record.items():
        if normalize_text(actual_name) in wanted:
            return value
    return None

def find_entity_columns(columns, anchor="Test consolidated amount", excludes=(), row_id_col="row_id"):
    # Entity (legal-entity balance) columns are defined positionally: everything AFTER the
    # "Test consolidated amount" column, minus anything explicitly excluded and minus row_id.
    cols = list(columns)
    excl_keys = {normalize_text(e) for e in excludes} | {normalize_text(row_id_col)}

    anchor_idx = next((i for i, c in enumerate(cols) if normalize_text(c) == normalize_text(anchor)), None)
    if anchor_idx is None:
        raise KeyError(f"Anchor not found: {anchor!r}")

    result = [c for c in cols[anchor_idx + 1:] if normalize_text(c) not in excl_keys]
    if not result:
        raise ValueError(f"No entity columns found after {anchor!r}")
    return result

def require_column(columns, requested_name):
    # Case/whitespace-insensitive "find this exact column or blow up with a clear error" helper.
    target = normalize_text(requested_name)
    for column in columns:
        if normalize_text(column) == target:
            return column
    raise KeyError(f"Required column not found: {requested_name!r}. Available: {columns}")


