        if rec.get("CY_Greyed"): continue
        cy, py = to_decimal(rec.get("Untested_Balance_CY")), to_decimal(rec.get("Untested_Balance_PY"))
        if cy is None or py is None: continue
        diff = cy - py
        pct = (diff / cy) if cy != Decimal("0") else None
        if abs(diff) > thresh and pct is not None and abs(pct) > pct_thresh:
            results.append(rec)
    return results

def _build_lookup(records, account_col):
    """normalized-account-name -> full record, first occurrence wins."""
    lookup = {}
    for rec in records:
        key = account_key(rec.get(account_col, ""))
        if key: lookup[key] = rec
    return lookup

def _get_entity_columns_s3b(df, account_col):
    """Entity columns = everything after the account column not in the metadata skip-list
    (a different rule from find_entity_columns' anchor-based approach used elsewhere)."""
    after, entities = False, []
    for c in dataframe_columns(df):
        if normalize_text(c) == normalize_text(account_col): after = True; continue
        if after and normalize_text(c) not in _S3B_SKIP_COLS:
            entities.append(c)
    return entities

def _build_combined_entities(cy_entity_cols, py_entity_cols):
    """Union of CY+PY entity columns: CY ones first (in CY order), then any PY-only entity
    (existed in PY but not CY — e.g. divested/renamed) appended after."""
    cy_normed = {normalize_text(e) for e in cy_entity_cols}
    combined = [(e, "cy") for e in cy_entity_cols]
    for py_ent in py_entity_cols:
        if normalize_text(py_ent) not in cy_normed:
            combined.append((py_ent, "py_only"))
    return combined

def _write_row9_header(ws, col_start, col_end, acct_name):
    """Merge & style the account-name super-header spanning this account's 5 sub-columns."""
    col_s_l, col_e_l = get_column_letter(col_start), get_column_letter(col_end)
    ws.merge_cells(f"{col_s_l}{ROW_ACCT_HEADER}:{col_e_l}{ROW_ACCT_HEADER}")
    anchor = ws.cell(row=ROW_ACCT_HEADER, column=col_start)
    anchor.value = acct_name
    anchor.font, anchor.fill, anchor.border, anchor.alignment = S3B_FONT_HEADER_BLACK, S3B_FILL_ACCT_HDR, S3B_BORDER, make_alignment("center", wrap=True)
    for c in range(col_start + 1, col_end + 1):
        mc = ws.cell(row=ROW_ACCT_HEADER, column=c)
        if not isinstance(mc, MergedCell):
            mc.fill, mc.border = S3B_FILL_ACCT_HDR, S3B_BORDER

def _write_grey_cell(cell):
    """Reset a cell to the standard "no data here" grey styling."""
    cell.value = None
    cell.fill, cell.font, cell.number_format = S3B_FILL_GREY, S3B_FONT_GREY, "General"
    cell.alignment, cell.border = make_alignment("center"), S3B_BORDER

def populate_sheet_3b(template, updated_raw_tb_CY, updated_raw_tb_PY, residual_cy_py, threshold_value, account_col="Account", py_account_col=None):
    """Top-level driver for Tab 3b: for every flagged account (from _filter_tab3b), builds a
    5-column group (CY/PY/Diff$/Diff%/Investigate) and fills one row per legal entity."""
    py_account_col = account_col if py_account_col is None else py_account_col
    ws = template[SHEET_3B]
    ws["C6"].value = float(MATERIALITY)
    ws["C7"].value = float(threshold_value)

    tab3b_rows = _filter_tab3b(residual_cy_py, threshold_value)
    if not tab3b_rows: return {}   # nothing exceeds threshold — leave the sheet untouched beyond row 6/7

    cy_records, py_records = records_from(updated_raw_tb_CY), records_from(updated_raw_tb_PY)
    cy_entity_cols = _get_entity_columns_s3b(updated_raw_tb_CY, account_col)
    py_entity_cols = _get_entity_columns_s3b(updated_raw_tb_PY, py_account_col)
    cy_lookup, py_lookup = _build_lookup(cy_records, account_col), _build_lookup(py_records, py_account_col)
    combined_entities = _build_combined_entities(cy_entity_cols, py_entity_cols)

    _unmerge_from_row9(ws)
    _clear_from_row9(ws)

    b9 = ws.cell(row=ROW_ACCT_HEADER, column=COL_ENTITY)
    b9.fill, b9.border = S3B_FILL_ACCT_HDR, S3B_BORDER
    b10 = ws.cell(row=ROW_SUB_HEADER, column=COL_ENTITY)
    b10.value = "Legal Entity"
    b10.font, b10.fill, b10.border, b10.alignment = S3B_FONT_HEADER, S3B_FILL_NAVY, S3B_BORDER, make_alignment("center", wrap=True)
    b11 = ws.cell(row=ROW_SOURCE_LABEL, column=COL_ENTITY)
    b11.fill, b11.border = S3B_FILL_WHITE, S3B_BORDER

    for a_idx, rec in enumerate(tab3b_rows):
        acct_name = str(rec.get("Account_CY") or rec.get("Account_PY") or "").strip()
        cs = COL_DATA_START + a_idx * N_SUB   # this account's group starts N_SUB columns after the previous one
        ce = cs + N_SUB - 1
        _write_row9_header(ws, cs, ce, acct_name)
        for s, label in enumerate(SUB_COLS):
            sh = ws.cell(row=ROW_SUB_HEADER, column=cs + s)
            sh.value, sh.font, sh.fill, sh.border, sh.alignment = label, S3B_FONT_HEADER, S3B_FILL_NAVY, S3B_BORDER, make_alignment("center", wrap=True)
        for s, src in enumerate(SRC_LBLS):
            sl = ws.cell(row=ROW_SOURCE_LABEL, column=cs + s)
            sl.value, sl.font, sl.fill, sl.border, sl.alignment = src, S3B_FONT_SOURCE, S3B_FILL_WHITE, S3B_BORDER, make_alignment("center")

    last_col_l = get_column_letter(COL_DATA_START + len(tab3b_rows) * N_SUB - 1)
    ws.auto_filter.ref = f"{get_column_letter(COL_ENTITY)}{ROW_SUB_HEADER}:{last_col_l}{ROW_SUB_HEADER}"

    for e_idx, (entity, source) in enumerate(combined_entities):
        data_row = ROW_DATA_START + e_idx
        row_fill = S3B_FILL_PY_ONLY if source == "py_only" else S3B_FILL_WHITE   # flag entities that only existed in PY

        ec = ws.cell(row=data_row, column=COL_ENTITY)
        ec.value = str(entity).strip()
        ec.font, ec.fill, ec.border, ec.alignment = S3B_FONT_DATA, row_fill, S3B_BORDER, make_alignment("left")

        for a_idx, rec in enumerate(tab3b_rows):
            acct_key = account_key(str(rec.get("Account_CY") or rec.get("Account_PY") or ""))
            cs = COL_DATA_START + a_idx * N_SUB

            cy_rec, py_rec = cy_lookup.get(acct_key, {}), py_lookup.get(acct_key, {})
            raw_cy = None if source == "py_only" else cy_rec.get(entity)   # a py_only entity never had a CY balance, by definition
            raw_py = py_rec.get(entity)

            is_cy_grey, is_py_grey = is_grey_marker(raw_cy), is_grey_marker(raw_py)
            cy_val = None if is_cy_grey else to_decimal(raw_cy)
            py_val = None if is_py_grey else to_decimal(raw_py)

            cy_c, py_c = ws.cell(row=data_row, column=cs), ws.cell(row=data_row, column=cs + 1)
            dif_c, pct_c, inv_c = ws.cell(row=data_row, column=cs + 2), ws.cell(row=data_row, column=cs + 3), ws.cell(row=data_row, column=cs + 4)

            for cell in (cy_c, py_c, dif_c, pct_c, inv_c):
                cell.font, cell.fill, cell.border = S3B_FONT_DATA, row_fill, S3B_BORDER

            if is_cy_grey:
                for cell in (cy_c, py_c, dif_c, pct_c, inv_c): _write_grey_cell(cell)   # CY manually overridden -> grey the whole 5-cell row for this account
                continue

            cy_c.value = float(cy_val) if cy_val is not None else None
            cy_c.number_format, cy_c.alignment = MONEY_FMT if cy_val is not None else "General", make_alignment("right")

            if is_py_grey:
                for cell in (py_c, dif_c, pct_c, inv_c): _write_grey_cell(cell)
                continue

            py_c.value = float(py_val) if py_val is not None else None
            py_c.number_format, py_c.alignment = MONEY_FMT if py_val is not None else "General", make_alignment("right")

            cy_addr, py_addr, dif_addr, pct_addr = cy_c.coordinate, py_c.coordinate, dif_c.coordinate, pct_c.coordinate

            # Difference: CY-PY if both numeric; -PY if only PY numeric (CY treated as 0); blank otherwise.
            dif_c.value = (f'=IF(ISNUMBER({cy_addr}),IF(ISNUMBER({py_addr}),{cy_addr}-{py_addr},{cy_addr}),'
                           f'IF(ISNUMBER({py_addr}),0-{py_addr},""))')
            dif_c.number_format, dif_c.alignment = MONEY_FMT, make_alignment("right")

            # % difference relative to CY; if CY isn't usable but PY is, treat as a full 100% swing; else 0.
            pct_c.value = (f'=IFERROR(IF(AND(ISNUMBER({cy_addr}),{cy_addr}<>0),{dif_addr}/{cy_addr},'
                           f'IF(ISNUMBER({py_addr}),1,0)),0)')
            pct_c.number_format, pct_c.alignment = PCT_FMT, make_alignment("right")

            # per-entity Investigate?: Yes only if $ diff exceeds threshold AND % diff exceeds THRESHOLD_PERCENTAGE.
            inv_c.value = f'=IFERROR(IF(AND(ABS({dif_addr})>{THRESHOLD_REF},ABS({pct_addr})>{THRESHOLD_PERCENTAGE}),"Yes","No"),"")'
            inv_c.alignment = make_alignment("center")

    last_data_row = ROW_DATA_START + len(combined_entities) - 1
    for a_idx in range(len(tab3b_rows)):
        inv_l = get_column_letter(COL_DATA_START + a_idx * N_SUB + 4)
        rng = f"{inv_l}{ROW_DATA_START}:{inv_l}{last_data_row}"
        ws.conditional_formatting.add(rng, FormulaRule(formula=[f'{inv_l}{ROW_DATA_START}="Yes"'],
                                                       fill=PatternFill(fill_type="solid", fgColor="FFFFCBCB"), stopIfTrue=True))
        ws.conditional_formatting.add(rng, FormulaRule(formula=[f'{inv_l}{ROW_DATA_START}="No"'],
                                                       fill=PatternFill(fill_type="solid", fgColor="FFC6EFCE"), stopIfTrue=True))

    ws.column_dimensions[get_column_letter(COL_ENTITY)].width = 28
    for a_idx in range(len(tab3b_rows)):
        for s, w in enumerate([14, 14, 15, 13, 13]): ws.column_dimensions[get_column_letter(COL_DATA_START + a_idx * N_SUB + s)].width = w
    ws.freeze_panes = ws.cell(row=ROW_DATA_START, column=COL_DATA_START)

    return {"sheet": SHEET_3B, "accounts_written": len(tab3b_rows)}

# NOTE: ROW_DATA_START is used inside populate_sheet_3b above but only DEFINED here, after the
# function body — works only because the function isn't executed until it's called below (Python
# late-binds globals). Fragile if this section's code is ever reordered.
ROW_DATA_START = 12
COL_DATA_START = 3

populate_sheet_3b(template, updated_raw_tb_CY, updated_raw_tb_PY, residual_cy_py, THRESHOLD_VALUE, account_col="Account", py_account_col="Account")

