    cy_records, py_records = records_from(updated_raw_tb_CY), records_from(updated_raw_tb_PY)
    cy_entity_cols = _get_entity_columns_s3b(updated_raw_tb_CY, account_col)
    py_entity_cols = _get_entity_columns_s3b(updated_raw_tb_PY, py_account_col)
    cy_lookup, py_lookup = _build_lookup(cy_records, account_col), _build_lookup(py_records, py_account_col)
    combined_entities = _build_combined_entities(cy_entity_cols, py_entity_cols)

    _unmerge_from_row9(ws)
    _clear_from_row9(ws)

    b9 = ws.cell(row=ROW_ACCT_HEADER, column=COL_ENTITY)
