            py_val = None if is_py_grey else to_decimal(raw_py)

            cy_c, py_c = ws.cell(row=data_row, column=cs), ws.cell(row=data_row, column=cs + 1)
            dif_c, pct_c, inv_c = ws.cell(row=data_row, column=cs + 2), ws.cell(row=data_row, column=cs + 3), ws.cell(row=data_row, column=cs + 4)

            for cell in (cy_c, py_c, dif_c, pct_c, inv_c):
                cell.font, cell.fill, cell.border = S3B_FONT_DATA, row_fill, S3B_BORDER

            if is_cy_grey:
                for cell in (cy_c, py_c, dif_c, pct_c, inv_c): _write_grey_cell(cell)   # CY manually overridden -> grey out the whole 5-cell row for this account
                continue

            cy_c.value = float(cy_val) if cy_val is not None else None
            cy_c.number_format, cy_c.alignment = MONEY_FMT if cy_val is not None else "General", make_alignment("right")

            if is_py_grey:
                for cell in (py_c, dif_c, pct_c, inv_c): _write_grey_cell(cell)   # PY overridden -> grey everything except the CY value already written
                continue

            py_c.value = float(py_val) if py_val is not None else None
            py_c.number_format, py_c.alignment = MONEY_FMT if py_val is not None else "General", make_alignment("right")

            cy_addr, py_addr, dif_addr, pct_addr = cy_c.coordinate, py_c.coordinate, dif_c.coordinate, pct_c.coordinate

            # Difference: CY-PY if both numeric; -PY if only PY numeric (CY treated as 0); blank otherwise
            dif_c.value = (f'=IF(ISNUMBER({cy_addr}),IF(ISNUMBER({py_addr}),{cy_addr}-{py_addr},{cy_addr}),'
                           f'IF(ISNUMBER({py_addr}),0-{py_addr},""))')
            dif_c.number_format, dif_c.alignment = MONEY_FMT, make_alignment("right")

            # % difference relative to CY; if CY isn't usable but PY is, treat as a full 100% swing; else 0
            pct_c.value = (f'=IFERROR(IF(AND(ISNUMBER({cy_addr}),{cy_addr}<>0),{dif_addr}/{cy_addr},'
                           f'IF(ISNUMBER({py_addr}),1,0)),0)')
            pct_c.number_format, pct_c.alignment = PCT_FMT, make_alignment("right")

            # per-entity investigate flag: Yes only if $ diff exceeds threshold AND % diff exceeds THRESHOLD_PERCENTAGE
            inv_c.value = f'=IFERROR(IF(AND(ABS({dif_addr})>{THRESHOLD_REF},ABS({pct_addr})>{THRESHOLD_PERCENTAGE}),"Yes","No"),"")'
            inv_c.alignment = make_alignment("center")

    last_data_row = ROW_DATA_START + len(combined_entities) - 1
    for a_idx in range(len(tab3b_rows)):
