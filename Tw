def _unmerge_from_row9(ws):
    # Remove any merged ranges that touch row 9 or below, since this whole block gets rebuilt each run.
    for rng in list(ws.merged_cells.ranges):
        _, min_row, _, max_row = range_boundaries(str(rng))
        if max_row >= ROW_ACCT_HEADER:
            ws.unmerge_cells(str(rng))

def _clear_from_row9(ws):
    # Blank out every cell (value/font/fill/border/format/alignment) from row 9 to the bottom of the sheet.
    for row in ws.iter_rows(min_row=ROW_ACCT_HEADER, max_row=ws.max_row):
        for cell in row:
            if isinstance(cell, MergedCell): continue
            cell.value, cell.font, cell.fill = None, S3B_FONT_DATA, S3B_FILL_WHITE
            cell.border, cell.number_format, cell.alignment = Border(), "General", Alignment()

def _filter_tab3b(residual_cy_py, threshold_value):
    # Select which accounts from the CY/PY join actually get a column-group on Tab 3b: not
    # greyed out, both years present, and same $/% movement test as Tab 3's "inv1" flag.
    thresh, pct_thresh = to_decimal(threshold_value), to_decimal(THRESHOLD_PERCENTAGE)
    if thresh is None or pct_thresh is None: return []

    results = []
    for rec in records_from(residual_cy_py):
        if rec.get("CY_Greyed"): continue
        cy, py = to_decimal(rec.get("Untested_Balance_CY")), to_decimal(rec.get("Untested_Balance_PY"))
        if cy is None or py is None: continue
        diff = cy - py
        pct = (diff / cy) if cy != Decimal("0") else None
        if abs(diff) > thresh and pct is not None and abs(pct) > pct_thresh:
            results.append(rec)
    return results

def _build_lookup(records, account_col):
    # dict of normalized-account-name -> full record, first occurrence wins.
    lookup = {}
    for rec in records:
        key = account_key(rec.get(account_col, ""))
        if key: lookup[key] = rec
    return lookup

def _get_entity_columns_s3b(df, account_col):
    # Entity columns here = everything appearing AFTER the account column that isn't in the
    # metadata skip-list (a slightly different rule from find_entity_columns' anchor-based approach).
    after, entities = False, []
    for c in dataframe_columns(df):
        if normalize_text(c) == normalize_text(account_col): after = True; continue
        if after and normalize_text(c) not in _S3B_SKIP_COLS:
            entities.append(c)
    return entities

def _build_combined_entities(cy_entity_cols, py_entity_cols):
    # Union of CY and PY entity columns, tagged "cy" (present in CY, listed first, in CY order)
    # or "py_only" (exists in PY but had no CY counterpart — appended after).
    cy_normed = {normalize_text(e) for e in cy_entity_cols}
    combined = [(e, "cy") for e in cy_entity_cols]
    for py_ent in py_entity_cols:
        if normalize_text(py_ent) not in cy_normed:
            combined.append((py_ent, "py_only"))
    return combined

def _write_row9_header(ws, col_start, col_end, acct_name):
