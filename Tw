def add_row_id(df, row_id_col="row_id"):
    """Attach a stable 1-based row_id reflecting the frame's current row order.
    Note: Assumes single-partition sequential read in Spark."""
    if row_id_col in df.columns: raise ValueError(f"Column '{row_id_col}' already exists.")
    temp_col = "__temporary_row_order__"
    while temp_col in df.columns:
        temp_col = f"_{temp_col}"                                # avoid clobbering an existing column with this name
    df_with_order = df.withColumn(temp_col, F.monotonically_increasing_id())   # cheap ordering proxy (not globally sortable across partitions in general, but OK here per the docstring's single-partition assumption)
    row_number_window = Window.orderBy(F.col(temp_col))
    return (df_with_order
            .withColumn(row_id_col, F.row_number().over(row_number_window).cast("long"))   # dense 1..N row ids
            .drop(temp_col))                                     # drop the helper ordering column

