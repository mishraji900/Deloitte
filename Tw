    total_cell.font, total_cell.alignment = S3A_FONT_BLACK, S3A_ALIGN_RIGHT
    total_cell.fill, total_cell.border, total_cell.number_format = S3A_FILL_WHITE, S3A_BORDER_FULL, MONEY_FMT

    tab2_row = tab2_row_lookup.get(normalize_text(account_value))
    tab2_cell = worksheet.cell(row=balance_row, column=tab2_column)
