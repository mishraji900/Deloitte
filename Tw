def cast_gl_columns(data, numeric_columns, date_columns, date_format, time_columns, time_format):
    """Cast the given column groups to their real types, with a before/after aggregate snapshot
    so any casting-induced data loss (e.g. a bad date parse turning into null) is visible."""
    all_columns = numeric_columns + date_columns + time_columns
    aggregate(data=data, columns=all_columns).display()   # BEFORE snapshot

