def clean_df(df):
    """Trim column names/values and replace '.' with '_' in column names."""
    # For every column: trim whitespace off the VALUES, and rename the COLUMN itself by
    # swapping '.' -> '_' and stripping whitespace (dots break backtick-quoted col refs).
    new_columns = [F.trim(F.expr(f"`{c}`")).alias(c.replace(".", "_").strip()) for c in df.columns]
    return df.select(new_columns)

