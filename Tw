        investigate_cell.value = (
            f'=IF(OR({balance_coordinate}="{DEEMED_SIGNIFICANT}",{balance_coordinate}="{FORMULA_DEEMED_SIGNIFICANT}"),"No",'
            f'IF(OR(ISBLANK({balance_coordinate}),NOT(ISNUMBER({balance_coordinate}))),"",'
