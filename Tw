    if tab2_row is None:
        tab2_cell.value, tab2_cell.number_format = "-", "General"    # account not found on Tab 2 — show a dash instead of a broken formula
    else:
        tab2_cell.value = f"={quote_sheetname(TAB_2_SHEET)}!${TAB_2_TOTAL_COLUMN}${tab2_row}"   # live cross-sheet reference

