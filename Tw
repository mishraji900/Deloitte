# =====================================================================
# VALIDATION — Consolidated & Untested Balance recon, raw vs all 5 sheets
# =====================================================================
SIGNIFICANCE_COL = "Significance"  # ponytail: rename to real header if diff
VAL_COLS = ["Consolidated", "Untested Balance"]

def _sig_ok_map(df, row_id_col="row_id"):
    if SIGNIFICANCE_COL not in df.columns:
        return {r[row_id_col]: True for r in df.select(row_id_col).collect()}
    txt = F.trim(F.col(f"`{SIGNIFICANCE_COL}`").cast("string"))
    ok = df.select(row_id_col, (txt.isNotNull() & (txt != "")).alias("ok")).collect()
    return {r[row_id_col]: bool(r["ok"]) for r in ok}

def _row_map(df, row_id_col="row_id"):
    cols = [row_id_col, "Account"] + VAL_COLS
    return {r[row_id_col]: r.asDict(recursive=True) for r in df.select(*cols).collect()}

def _status(raw_val, sheet_raw):
    if is_grey_marker(sheet_raw):
        return "GREYED", None
    sheet_val = to_decimal(sheet_raw)
    if raw_val is None and sheet_val is None:
        return "MATCH", sheet_val
    if raw_val is None or sheet_val is None:
        return "MISMATCH", sheet_val
    return ("MATCH" if raw_val == sheet_val else "MISMATCH"), sheet_val

def recon_rows(raw_map, sig_map, item_maps):
    """item_maps: {sheet_label: {row_id: record}}"""
    rows = []
    for sheet_label, id_map in item_maps.items():
        for rid, rec in id_map.items():
            raw = raw_map.get(rid)
            for col in VAL_COLS:
                raw_val = to_decimal(raw.get(col)) if raw else None
                status, sheet_val = _status(raw_val, rec.get(col))
                rows.append({
                    "sheet": sheet_label, "row_id": rid,
                    "Account": (raw or rec).get("Account"),
                    "column": col, "raw_value": raw_val, "sheet_value": sheet_val,
                    "status": status if raw else "MISSING_IN_RAW",
                    "sig_ok": sig_map.get(rid),
                })
    return rows

# ---- ground-truth raw maps (CY/PY, pre grey-out) ----
raw_cy_map, raw_py_map = _row_map(raw_tb_CY), _row_map(raw_tb_PY)
sig_cy_map, sig_py_map = _sig_ok_map(raw_tb_CY), _sig_ok_map(raw_tb_PY)

# ---- item sets actually used by each sheet, keyed by row_id ----
gcy_map = _row_map(updated_raw_tb_CY)   # sheet 1 & 2 source
gpy_map = _row_map(updated_raw_tb_PY)

vis_ids_12 = {
    r["row_id"] for r in raw_tb_CY.select("row_id", "% of consolidated balance", "Test consolidated amount").collect()
    if _is_nonzero(r["% of consolidated balance"]) and _is_no(r["Test consolidated amount"])
}
sheet1_map = {rid: v for rid, v in gcy_map.items() if rid in vis_ids_12}
sheet2_map = sheet1_map  # same source rows, sheet 2 just skips calc cols

r3 = residual_cy_py.select("CY_Row_ID", "PY_Row_ID", "CY_Greyed").collect()
sheet3_cy_map = {r["CY_Row_ID"]: gcy_map[r["CY_Row_ID"]] for r in r3 if not r["CY_Greyed"] and r["CY_Row_ID"] in gcy_map}
sheet3_py_map = {r["PY_Row_ID"]: gpy_map[r["PY_Row_ID"]] for r in r3 if r["PY_Row_ID"] is not None and r["PY_Row_ID"] in gpy_map}

sheet3a_map = {row["row_id"]: row["record"] for row in residual_rows}

sheet3b_map = {
    r["CY_Row_ID"]: gcy_map[r["CY_Row_ID"]]
    for r in tab3b_rows if r.get("CY_Row_ID") is not None and r["CY_Row_ID"] in gcy_map
}

cy_recon = recon_rows(raw_cy_map, sig_cy_map, {
    "1. Quantitative Evaluation": sheet1_map,
    "2. Qualitative Evaluation": sheet2_map,
    "3. Residual Analytic (CY)": sheet3_cy_map,
    "3a. Times M by Entity": sheet3a_map,
    "3b. Residual Analytic by entity": sheet3b_map,
})
py_recon = recon_rows(raw_py_map, sig_py_map, {"3. Residual Analytic (PY)": sheet3_py_map})

# ---- item counts (sig-blank leak check) ----
count_rows = []
for label, id_map, sig_map in [
    ("1. Quantitative Evaluation", sheet1_map, sig_cy_map),
    ("2. Qualitative Evaluation", sheet2_map, sig_cy_map),
    ("3. Residual Analytic (CY)", sheet3_cy_map, sig_cy_map),
    ("3. Residual Analytic (PY)", sheet3_py_map, sig_py_map),
    ("3a. Times M by Entity", sheet3a_map, sig_cy_map),
    ("3b. Residual Analytic by entity", sheet3b_map, sig_cy_map),
]:
    leaked = sum(1 for rid in id_map if not sig_map.get(rid, True))
    count_rows.append({"sheet": label, "items": len(id_map), "sig_blank_leaked": leaked})

# ---- write out ----
import pandas as pd
VALIDATION_OUTPUT_PATH = f"{OUTPUT_DIRECTORY}/Validation_Recon.xlsx"
all_recon = pd.DataFrame(cy_recon + py_recon)
summary = (
    all_recon.groupby(["sheet", "status"]).size().unstack(fill_value=0)
    if not all_recon.empty else pd.DataFrame()
)

with pd.ExcelWriter("/tmp/_validation_recon.xlsx", engine="openpyxl") as writer:
    summary.to_excel(writer, sheet_name="Summary")
    pd.DataFrame(count_rows).to_excel(writer, sheet_name="Item Counts", index=False)
    all_recon[all_recon["status"] != "MATCH"].to_excel(writer, sheet_name="Mismatches Only", index=False)
    all_recon.to_excel(writer, sheet_name="Full Detail", index=False)

cp.fs.put("/tmp/_validation_recon.xlsx", VALIDATION_OUTPUT_PATH, overwrite=True)
print("Validation written:", VALIDATION_OUTPUT_PATH)
print(pd.DataFrame(count_rows))
