def _spark_account_is_valid(column_name):
    # Column expression: True where the account-name cell is non-null and not blank after trim.
    source = F.col(f"`{column_name}`")
    return source.isNotNull() & (F.trim(source.cast("string")) != F.lit(""))

def _spark_numeric_or_null(column_name):
    # Column expression: parse a text/number cell into a double, treating blank/None/the grey
    # marker as SQL NULL rather than 0 (so joins/sums don't silently zero-fill missing data).
    source = F.col(f"`{column_name}`")
    source_text = F.trim(source.cast("string"))
    cleaned_text = F.regexp_replace(F.regexp_replace(source_text, ",", ""), "%", "")
    return F.when(
        source.isNull() | (source_text == F.lit("")) | (F.lower(source_text) == F.lit(NULL_MARKER)),
        F.lit(None).cast("double"),
    ).otherwise(cleaned_text.cast("double"))

def _spark_test_is_not_exact_no(dataframe, column_name):
    # Column expression: True unless the "Test consolidated amount" cell is exactly "no" (case-insensitive).
    # Used to flag CY rows that WERE fully tested (so they should be greyed out on Tab 3).
    if column_name.lower() not in [c.lower() for c in dataframe.columns]: return F.lit(False)
    source_text = F.trim(F.col(f"`{column_name}`").cast("string"))
    return F.col(f"`{column_name}`").isNull() | (F.lower(source_text) != F.lit("no"))

def _add_account_occurrence_number(dataframe, account_column, alias_map):
    # For duplicate account names within a frame, number each occurrence in row_id order (1st, 2nd, ...)
    # so the CY/PY join can pair the 1st CY "Cash" with the 1st PY "Cash", 2nd with 2nd, etc.,
    # instead of exploding into a many-to-many cross join on duplicate names.
    row_id_column = "row_id"
    source = (dataframe
              .filter(_spark_account_is_valid(account_column))
              .withColumn("_account_key", spark_account_key(account_column, alias_map))
              .withColumn("_row_id", F.col(f"`{row_id_column}`").cast("long"))
              .withColumn("_source_tiebreaker", F.monotonically_increasing_id()))   # stable tiebreak if row_ids ever collide
    occurrence_window = Window.partitionBy("_account_key").orderBy(
        F.col("_row_id").asc_nulls_last(), F.col("_source_tiebreaker").asc())
    return source.withColumn("_account_occurrence", F.row_number().over(occurrence_window))

def _build_fuzzy_alias_map(cy_keys, py_keys):
    # Build {PY_name: CY_name} aliases for account names that normalize to the SAME account_key()
    # but aren't textually identical (catches typos/minor formatting differences automatically).
    cy_norm_to_key = {}
    for key in cy_keys:
        norm = account_key(key)
        if norm and norm not in cy_norm_to_key: cy_norm_to_key[norm] = key   # first CY name wins for a given normalized key
    alias_map = {}
    for py_key in set(py_keys):
        if not py_key: continue
        cy_key = cy_norm_to_key.get(account_key(py_key))
        if cy_key is not None and cy_key != py_key: alias_map[py_key] = cy_key
    return alias_map

def _collect_account_rich_keys(dataframe, account_column):
    # Pull distinct, non-null account name strings out of a Spark frame into a plain Python list.
    return [row[0] for row in (
        dataframe.select(F.col(f"`{account_column}`").cast("string"))
        .filter(F.col(f"`{account_column}`").isNotNull()).distinct().collect())]

def _build_manual_alias_map(manual_mapping) -> dict[str, str]:
    # Convert the analyst-curated Manual_Mapping.xlsx rows into an {account_key(PY): account_key(CY)}
    # dict, skipping rows where the mapping is blank or a no-op (same key on both sides).
    rows = (manual_mapping
            .select(F.trim(F.col("`Account CY`").cast("string")).alias("acct_cy"),
                    F.trim(F.col("`Account PY`").cast("string")).alias("acct_py"))
            .filter(F.col("acct_cy").isNotNull() & (F.col("acct_cy") != "")
                    & F.col("acct_py").isNotNull() & (F.col("acct_py") != ""))
            .distinct().collect())
    return {
        account_key(row["acct_py"]): account_key(row["acct_cy"])
        for row in rows if account_key(row["acct_py"]) != account_key(row["acct_cy"])
    }

def build_residual_join(updated_raw_tb_CY, updated_raw_tb_PY, manual_mapping=None):
    # Core of Tab 3: full outer join CY accounts to PY accounts (fuzzy-key + manual alias +
    # occurrence-number matched), carrying through each side's Untested Balance and whether the
    # CY row is "greyed" (fully tested / not a residual candidate).
    cy_rich_keys = _collect_account_rich_keys(updated_raw_tb_CY, ACCOUNT_COLUMN)
    py_rich_keys = _collect_account_rich_keys(updated_raw_tb_PY, ACCOUNT_COLUMN)
    alias_map = _build_fuzzy_alias_map(cy_keys=cy_rich_keys, py_keys=py_rich_keys)
    if manual_mapping is not None:
        alias_map.update(_build_manual_alias_map(manual_mapping))   # manual aliases take precedence (applied after, so they overwrite fuzzy guesses)

    cy_greyed = _spark_test_is_not_exact_no(updated_raw_tb_CY, TEST_COLUMN)

    cy_source = (_add_account_occurrence_number(updated_raw_tb_CY, ACCOUNT_COLUMN, alias_map)
                 .select(F.col(f"`{ACCOUNT_COLUMN}`").alias("Account_CY"), F.col("_account_key"),
                         F.col("_account_occurrence"), F.col("_row_id").alias("CY_Row_ID"),
                         _spark_numeric_or_null(UNTESTED_COLUMN).alias("Untested_Balance_CY"),
                         cy_greyed.alias("CY_Greyed")))

    py_source = (_add_account_occurrence_number(updated_raw_tb_PY, ACCOUNT_COLUMN, alias_map)
                 .select(F.col(f"`{ACCOUNT_COLUMN}`").alias("Account_PY"), F.col("_account_key"),
                         F.col("_account_occurrence"), F.col("_row_id").alias("PY_Row_ID"),
                         _spark_numeric_or_null(UNTESTED_COLUMN).alias("Untested_Balance_PY")))

    cy, py = cy_source.alias("cy"), py_source.alias("py")
    join_condition = ((F.col("cy._account_key") == F.col("py._account_key"))
                        & (F.col("cy._account_occurrence") == F.col("py._account_occurrence")))
    joined = cy.join(py, join_condition, how="full_outer")   # keep CY-only and PY-only rows too, not just matches

    result = joined.select(
        F.col("cy.Account_CY").alias("Account_CY"),
        F.col("cy.Untested_Balance_CY").alias("Untested_Balance_CY"),
        F.col("py.Account_PY").alias("Account_PY"),
        F.col("py.Untested_Balance_PY").alias("Untested_Balance_PY"),
        # If there's no CY side at all, treat as greyed (nothing to investigate on the CY side);
        # otherwise use the actual CY_Greyed flag, defaulting to True if it's somehow null.
        F.when(F.col("cy.Account_CY").isNull(), F.lit(True))
         .otherwise(F.coalesce(F.col("cy.CY_Greyed"), F.lit(True))).alias("CY_Greyed"),
        F.col("cy.CY_Row_ID").alias("CY_Row_ID"),
        F.col("py.PY_Row_ID").alias("PY_Row_ID"),
        F.coalesce(F.col("cy.CY_Row_ID"), F.col("py.PY_Row_ID")).alias("_sort_row_id"),
        F.coalesce(F.col("cy._account_occurrence"), F.col("py._account_occurrence")).alias("_sort_occurrence"),
        F.coalesce(F.col("cy.Account_CY"), F.col("py.Account_PY")).alias("_sort_account"),
    )

    return (result
            .orderBy(F.col("_sort_row_id").asc_nulls_last(), F.col("_sort_occurrence").asc_nulls_last(),
                     F.col("_sort_account").asc_nulls_last())   # stable, human-readable ordering: CY row order first
            .drop("_sort_row_id", "_sort_occurrence", "_sort_account"))

_num = to_excel_number   # short alias used repeatedly below when writing values into cells

def _apply_investigate_colors(worksheet, column_letters, non_grey_rows):
    # For every non-greyed row's two "Investigate?" cells: color them directly if a literal
    # "No"/other text is already there, AND also attach live conditional-formatting rules so the
    # color stays correct even after a user edits the cell or if it holds a formula result.
    for row_number in non_grey_rows:
        for key in ("inv1", "inv2"):
            cell_reference = f"{column_letters[key]}{row_number}"
            cell = worksheet[cell_reference]
            if isinstance(cell.value, str) and not cell.value.startswith("="):
                cell.fill = GREEN_FILL if cell.value.strip().casefold() == "no" else RED_FILL
            else:
                cell.fill = WHITE_FILL
            no_formula = f'IFERROR(UPPER(TRIM({cell_reference}))="NO",FALSE)'
            worksheet.conditional_formatting.add(cell_reference, FormulaRule(formula=[no_formula], fill=GREEN_FILL, stopIfTrue=True))
            worksheet.conditional_formatting.add(cell_reference, FormulaRule(formula=[f"NOT({no_formula})"], fill=RED_FILL, stopIfTrue=True))

def write_residual_analytic_sheet(template, residual_df, sheet_name=None, anchor_cell=RESIDUAL_ANALYTIC_ANCHOR_CELL):
    # Renders the CY-vs-PY join result (from build_residual_join) into the "3. Residual Analytic"
    # sheet: header row, one data row per join result (with live Excel formulas for diff/%/investigate),
    # and colored investigate flags.
    if sheet_name is None: sheet_name = _resolve_residual_analytic_sheet(template)
    residual_rows = residual_df.collect()
    worksheet = template[sheet_name]

    header_row, start_column = coordinate_to_tuple(anchor_cell)
    label_row = header_row + 1
    first_data_row = header_row + 2
    end_column = start_column + len(KEYS) - 1

    clear_worksheet_area(worksheet, header_row, start_column, end_column=end_column, reset_fill=WHITE_FILL)
    clear_conditional_formatting(worksheet)
    worksheet.auto_filter.ref = None

    c = {key: get_column_letter(start_column + index) for index, key in enumerate(KEYS)}   # key -> column letter lookup
    worksheet.row_dimensions[header_row].height = 42

    for offset, header in enumerate(RESIDUAL_ANALYTIC_HEADERS):
        cell = worksheet.cell(row=header_row, column=start_column + offset, value=header)
        cell.fill, cell.font, cell.alignment, cell.border = HEADER_FILL, HEADER_FONT, HEADER_ALIGN, FULL_BORDER

    for key, width in COLUMN_WIDTHS.items():
        worksheet.column_dimensions[c[key]].width = width

    for key in KEYS: worksheet[f"{c[key]}{label_row}"].fill = WHITE_FILL   # blank "source" sub-header row under the real headers

    for key, text in (("cy", "Tab 2"), ("py", "PY Omnia Export Reference"), ("inv1", "{b}")):
        label_cell = worksheet[f"{c[key]}{label_row}"]
        label_cell.value, label_cell.font, label_cell.alignment = text, RED_BOLD, CTR_ALIGN

    non_grey_rows, grey_rows = [], []

    for index, record in enumerate(residual_rows):
        row = first_data_row + index
        cy_greyed = bool(record["CY_Greyed"])

        if cy_greyed:
            # greyed rows: only show the account names, blank everything else, grey styling
            grey_rows.append(row)
            for key in KEYS: worksheet[f"{c[key]}{row}"].value = None
            worksheet[f"{c['acct_cy']}{row}"].value = record["Account_CY"]
            worksheet[f"{c['acct_py']}{row}"].value = record["Account_PY"]
            _style_data_cell(worksheet[f"{c['acct_cy']}{row}"], "acct_cy", grey=False)   # account name cells stay normal-colored...
            _style_data_cell(worksheet[f"{c['acct_py']}{row}"], "acct_py", grey=False)
            _style_data_row(worksheet, row, c, grey=True)                                 # ...then the rest of the row's KEYS get greyed (overwrites acct cells too, but they had no value change)
            continue

        non_grey_rows.append(row)
        worksheet[f"{c['acct_cy']}{row}"].value = record["Account_CY"]
        worksheet[f"{c['acct_py']}{row}"].value = record["Account_PY"]
        worksheet[f"{c['cy']}{row}"].value = _num(record["Untested_Balance_CY"])
        worksheet[f"{c['py']}{row}"].value = _num(record["Untested_Balance_PY"])

        # Difference = CY - PY, blank if either side is missing
        worksheet[f"{c['diff']}{row}"] = (
            f'=IF(OR(ISBLANK({c["cy"]}{row}),ISBLANK({c["py"]}{row})),"",'
            f'{c["cy"]}{row}-{c["py"]}{row})'
        )

        # % difference relative to CY balance, guarding against blank/zero denominators
        worksheet[f"{c['pct']}{row}"] = (
            f'=IF(OR(ISBLANK({c["cy"]}{row}),ISBLANK({c["py"]}{row}),{c["py"]}{row}=0),"",'
            f'{c["diff"]}{row}/{c["cy"]}{row})'
        )

        # dollar threshold column — just repeats the constant THRESHOLD_VALUE when CY has a value
        worksheet[f"{c['thr']}{row}"] = f'=IF(ISBLANK({c["cy"]}{row}),"",{THRESHOLD_VALUE})'

        # "Investigate?" #1: Yes only if BOTH the $ difference exceeds threshold AND the % move exceeds THRESHOLD_PERCENTAGE
        worksheet[f"{c['inv1']}{row}"] = (
            f'=IF(OR(ISBLANK({c["diff"]}{row}),ISBLANK({c["thr"]}{row}),ISBLANK({c["pct"]}{row})),"",'
            f'IF(AND(ABS({c["diff"]}{row})>{c["thr"]}{row},'
            f'ABS({c["pct"]}{row})>{THRESHOLD_PERCENTAGE}),"Yes","No"))'
        )

        worksheet[f"{c['tm1']}{row}"] = f'=IF({c["inv1"]}{row}="Yes","Tab 3b","")'   # cross-reference pointer to the detail tab

        # Times-of-materiality = CY balance / materiality cell (guards div-by-zero/blank materiality)
        worksheet[f"{c['tom']}{row}"] = (
            f'=IF(OR(ISBLANK({c["cy"]}{row}),{MATERIALITY_CELL}=0,ISBLANK({MATERIALITY_CELL})),"",'
            f'{c["cy"]}{row}/{MATERIALITY_CELL})'
        )

        worksheet[f"{c['inv2']}{row}"] = f'=IF(ISBLANK({c["tom"]}{row}),"",IF(ABS({c["tom"]}{row})>1,"Yes","No"))'   # 2nd flag: balance itself exceeds 1x materiality

        worksheet[f"{c['tm2']}{row}"] = f'=IF({c["inv2"]}{row}="Yes","Tab 3a","")'   # cross-reference pointer to the by-entity tab

        _style_data_row(worksheet, row, c, grey=False)
        _apply_number_formats(worksheet, row, c)

    if residual_rows:
        last_data_row = first_data_row + len(residual_rows) - 1
        _apply_investigate_colors(worksheet, c, non_grey_rows)
        worksheet.auto_filter.ref = f"{c['acct_cy']}{header_row}:{c['tm2']}{last_data_row}"
    else:
        last_data_row = first_data_row - 1

    worksheet.freeze_panes = worksheet.cell(row=first_data_row, column=start_column)
    worksheet.sheet_view.showGridLines = False

    return {"sheet": sheet_name, "rows_written": len(residual_rows)}

