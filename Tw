    first_data_row = header_row + 2
    end_column = start_column + len(KEYS) - 1

    clear_worksheet_area(worksheet, header_row, start_column, end_column=end_column, reset_fill=WHITE_FILL)
    clear_conditional_formatting(worksheet)
    worksheet.auto_filter.ref = None

    c = {key: get_column_letter(start_column + index) for index, key in enumerate(KEYS)}
    worksheet.row_dimensions[header_row].height = 42

    for offset, header in enumerate(RESIDUAL_ANALYTIC_HEADERS):
        cell = worksheet.cell(row=header_row, column=start_column + offset, value=header)
        cell.fill, cell.font, cell.alignment, cell.border = HEADER_FILL, HEADER_FONT, HEADER_ALIGN, FULL_BORDER

    for key, width in COLUMN_WIDTHS.items():
        worksheet.column_dimensions[c[key]].width = width

    for key in KEYS: worksheet[f"{c[key]}{label_row}"].fill = WHITE_FILL

    for key, text in (("cy", "Tab 2"), ("py", "PY Omnia Export Reference"), ("inv1", "{b}")):
        label_cell = worksheet[f"{c[key]}{label_row}"]
        label_cell.value, label_cell.font, label_cell.alignment = text, RED_BOLD, CTR_ALIGN

    non_grey_rows, grey_rows = [], []

    for index, record in enumerate(residual_rows):
        row = first_data_row + index
        cy_greyed = bool(record["CY_Greyed"])

        if cy_greyed:
            # Greyed rows: only account names shown, everything else blank/grey.
            grey_rows.append(row)
            for key in KEYS: worksheet[f"{c[key]}{row}"].value = None
            worksheet[f"{c['acct_cy']}{row}"].value = record["Account_CY"]
            worksheet[f"{c['acct_py']}{row}"].value = record["Account_PY"]
            _style_data_cell(worksheet[f"{c['acct_cy']}{row}"], "acct_cy", grey=False)
            _style_data_cell(worksheet[f"{c['acct_py']}{row}"], "acct_py", grey=False)
            _style_data_row(worksheet, row, c, grey=True)
            continue

        non_grey_rows.append(row)
        worksheet[f"{c['acct_cy']}{row}"].value = record["Account_CY"]
        worksheet[f"{c['acct_py']}{row}"].value = record["Account_PY"]
        worksheet[f"{c['cy']}{row}"].value = _num(record["Untested_Balance_CY"])
        worksheet[f"{c['py']}{row}"].value = _num(record["Untested_Balance_PY"])

        # Difference = CY - PY, blank if either side is missing.
        worksheet[f"{c['diff']}{row}"] = (
            f'=IF(OR(ISBLANK({c["cy"]}{row}),ISBLANK({c["py"]}{row})),"",'
            f'{c["cy"]}{row}-{c["py"]}{row})'
