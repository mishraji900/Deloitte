# Assume your raw dataframe is 'gl_df'
filters = ["Entity", "Grouping", "LOB", "FS Line"]

# ---------------------------------------------------------
# STEP 1: BASE AGGREGATION
# ---------------------------------------------------------
sankey_base = gl_df.groupBy(*filters, "FS Category", "Flag").agg(
    F.sum("Balance").alias("Net_Balance")
)

# ---------------------------------------------------------
# STEP 2: SPLIT INTO DEBITS (Path 1) AND CREDITS (Path 2)
# ---------------------------------------------------------
debits_df = sankey_base.filter(F.col("Net_Balance") > 0).select(
    *filters,
    F.lit("1_Left_to_Center").alias("Flow_Stage"),
    F.col("Flag").alias("Source"),
    F.col("FS Category").alias("Target"),
    F.col("Net_Balance").alias("Flow_Size"),
    F.col("Flag").alias("Global_Flag") # For highlighting
)

credits_df = sankey_base.filter(F.col("Net_Balance") < 0).select(
    *filters,
    F.lit("2_Center_to_Right").alias("Flow_Stage"),
    F.col("FS Category").alias("Source"),
    F.col("Flag").alias("Target"),
    F.abs(F.col("Net_Balance")).alias("Flow_Size"),
    F.col("Flag").alias("Global_Flag") # For highlighting
)

# Combine them into one unified flow table
flows_df = debits_df.unionByName(credits_df)

# Create a unique ID for every single polygon path
flows_df = flows_df.withColumn("Path_ID", F.concat_ws("_", *filters, "Flow_Stage", "Source", "Target"))

# ---------------------------------------------------------
# STEP 3: VERTICAL STACKING (Y-AXIS COORDINATES)
# ---------------------------------------------------------
# Window to stack the Source side (Left/Center)
window_source = Window.partitionBy(*filters, "Flow_Stage").orderBy("Source", "Target")

# Window to stack the Target side (Center/Right)
window_target = Window.partitionBy(*filters, "Flow_Stage").orderBy("Target", "Source")

# Calculate Top and Bottom Y-Coordinates for both sides of the flow
stacked_df = flows_df \
    .withColumn("Source_Y_Max", F.sum("Flow_Size").over(window_source)) \
    .withColumn("Source_Y_Min", F.col("Source_Y_Max") - F.col("Flow_Size")) \
    .withColumn("Target_Y_Max", F.sum("Flow_Size").over(window_target)) \
    .withColumn("Target_Y_Min", F.col("Target_Y_Max") - F.col("Flow_Size"))

# ---------------------------------------------------------
# STEP 4: POLYGON DENSIFICATION (THE 98 POINTS)
# ---------------------------------------------------------
# Create a dataframe of numbers 1 to 98
densification_df = spark.range(1, 99).toDF("Point")

# Cross join the paths with the 98 points
polygon_df = stacked_df.crossJoin(densification_df)

# ---------------------------------------------------------
# STEP 5: CALCULATE EXACT X AND Y COORDINATES FOR TABLEAU
# ---------------------------------------------------------
polygon_df = polygon_df.withColumn(
    "X_Step",
    F.when(F.col("Point") <= 49, (F.col("Point") - 1) / 48)     # Left to Right (Top curve)
     .otherwise((98 - F.col("Point")) / 48)                     # Right to Left (Bottom curve)
)

# T_Value maps the X_Step (0 to 1) to the Sigmoid curve range (-6 to 6)
polygon_df = polygon_df.withColumn("T_Value", (F.col("X_Step") * 12) - 6)

# The Sigmoid Multiplier (creates the S-curve shape)
polygon_df = polygon_df.withColumn("Sigmoid", 1 / (1 + F.exp(-F.col("T_Value"))))

# Calculate the final Y Coordinate
# If Point <= 49, draw the Top edge using Y_Max. Else, draw the Bottom edge using Y_Min.
final_sankey_df = polygon_df.withColumn(
    "Y_Coordinate",
    F.when(
        F.col("Point") <= 49, 
        F.col("Source_Y_Max") + ((F.col("Target_Y_Max") - F.col("Source_Y_Max")) * F.col("Sigmoid"))
    ).otherwise(
        F.col("Source_Y_Min") + ((F.col("Target_Y_Min") - F.col("Source_Y_Min")) * F.col("Sigmoid"))
    )
)

# Adjust the X_Coordinate so Stage 2 (Center to Right) starts where Stage 1 ends
final_sankey_df = final_sankey_df.withColumn(
    "X_Coordinate",
    F.when(F.col("Flow_Stage") == "1_Left_to_Center", F.col("X_Step"))
     .otherwise(F.col("X_Step") + 1) # Shifts the second half of the Sankey over by 1
)

