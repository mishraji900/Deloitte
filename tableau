# ══════════════════════════════════════════════════════════════════════════════
# TB TIEOUT VALIDATION — paste as a NEW cell at the END of the notebook.
# Reuses the tie-out cell's helpers (put, fonts, fills, load_lookups, to_numeric,
# TIEOUT_SHEETS, CURRENT_TB, PRIOR_TB...). Writes a separate workbook.
#
# Amount = sum of entity columns EXCLUDING BR015 (BR015 is itself a total, so
# adding it would double). BR015 is shown as its own column and checked the same way.
# ══════════════════════════════════════════════════════════════════════════════
import pandas as pd
from openpyxl.formatting.rule import CellIsRule

# ── CONFIG ────────────────────────────────────────────────────────────────────
TOL      = 0.01
VAL_FILE = f"{OUTPUT_DIRECTORY}/TB TieOut Validation.xlsx"
QTD_SHEET = "QTD 3-31-26"

# Same rename/drop as the tie-out cell, so raw is compared like for like.
PERIODS = [
    dict(sheet="YTD 3-31-26", src="TB Report - LE Close USD", key="ytd", strict=True,
         rename={"__UNNAMED__0": ACCOUNT_COL, "__UNNAMED__123": "Elimination"},
         drop=[]),
    dict(sheet="YTD 12-31-25", src="Dec TB Report - LE Close USD", key="prior", strict=False,
         rename={"__UNNAMED__1": ACCOUNT_COL, "__UNNAMED__110": "Elimination"},
         drop=["__UNNAMED__0", "__UNNAMED__112"]),
]
EXCL = {ACCOUNT_COL, LAST_ENTITY_COL, "__sheet__", ROW_ID_COL}


# ── DATA ──────────────────────────────────────────────────────────────────────
def ent_amt(ent):
    return sum((F.coalesce(F.col(c), F.lit(0.0)) for c in ent), F.lit(0.0))


def tot(df, ent):
    """[row count, amount (entities excl BR015), BR015 total]"""
    r = df.agg(F.count("*").alias("n"), F.sum(ent_amt(ent)).alias("e"),
               F.sum(LAST_ENTITY_COL).alias("b")).first()
    return [r["n"], r["e"] or 0.0, r["b"] or 0.0]


def load_raw(p):
    """Re-read the source Excel (independent of the parquet round trip)."""
    df = read_excel(tb_excel_path, sheet_name=[p["src"]], header=0,
                    naming_convention="neutral", trim=True).drop(*p["drop"])
    for old, new in p["rename"].items():
        df = df.withColumnRenamed(old, new)
    ent = [c for c in df.columns if c not in EXCL]
    return df.select(ACCOUNT_COL, *[to_numeric(c) for c in ent + [LAST_ENTITY_COL]]).cache(), ent


def analyse(p, mapping):
    raw, ent = load_raw(p)
    filt   = raw.filter(F.col(ACCOUNT_COL).isNotNull())
    drop   = raw.filter(F.col(ACCOUNT_COL).isNull())
    joined = filt.join(mapping, ACCOUNT_COL, "left")
    nocode = joined.filter(F.col(GROUP_CODE_COL).isNull())
    inc    = joined.filter(F.col(GROUP_CODE_COL).isNotNull())
    return dict(
        raw=tot(raw, ent), drop=tot(drop, ent), filt=tot(filt, ent),
        joined=tot(joined, ent), nocode=tot(nocode, ent), inc=tot(inc, ent),
        codes={r[0]: r[1] or 0.0 for r in
               inc.groupBy(GROUP_CODE_COL).agg(F.sum(ent_amt(ent))).collect()},
        acct=inc.groupBy(ACCOUNT_COL, GROUP_CODE_COL)
                .agg(F.sum(ent_amt(ent)).alias("amt")).toPandas(),
    )


def codes_in_tieout():
    used = {c for s in TIEOUT_SHEETS for t in s.tables for r in t.rows
            if r.kind == "sigma" for c in r.codes.split("+")}
    return used | {s.side.code for s in TIEOUT_SHEETS if s.side}


# ── SHEET HELPERS ─────────────────────────────────────────────────────────────
def ok(cond):
    return f'=IF({cond},"PASS","FAIL")'


def hdr(ws, r, labels, c=2):
    for i, t in enumerate(labels):
        put(ws, r, c + i, t, font=FONT_HDR, fill=FILL_GREY, align=ALIGN_CENTER_WRAP)


def widths(ws, ws_widths):
    for col, w in zip("ABCDEFGH", ws_widths):
        ws.column_dimensions[col].width = w


def colour(ws):
    for text, hexa in (("PASS", "FFC6EFCE"), ("FAIL", "FFFFC7CE"), ("REVIEW", "FFFFEB9C")):
        ws.conditional_formatting.add("A1:H400", CellIsRule(
            operator="equal", formula=[f'"{text}"'],
            fill=PatternFill(start_color=hexa, end_color=hexa, fill_type="solid")))


# ── PART 1: YTD sheet (one per period) ────────────────────────────────────────
def write_ytd(ws, p, a, look, used):
    ws.sheet_view.showGridLines = False
    widths(ws, (2, 50, 16, 26, 26, 26, 12, 2))
    q = f"'{p['sheet']}'"
    put(ws, 1, 2, f"{p['sheet']} – TB validation  |  amount = sum of entity columns "
                   f"excl. {LAST_ENTITY_COL}; {LAST_ENTITY_COL} shown separately",
        font=FONT_BOLD, align=ALIGN_LEFT, border=None)

    def line(r, label, v, bold=False, status=None):
        f = FONT_BOLD if bold else FONT_BODY
        put(ws, r, 2, label, font=f, align=ALIGN_LEFT)
        put(ws, r, 3, v[0], font=f, align=ALIGN_RIGHT, fmt="#,##0")
        put(ws, r, 4, v[1], font=f, align=ALIGN_RIGHT, fmt=MONEY_FMT)
        put(ws, r, 5, v[2], font=f, align=ALIGN_RIGHT, fmt=MONEY_FMT)
        if status:
            put(ws, r, 6, status, font=FONT_BOLD)

    abs3 = lambda r: f"AND(ABS(C{r})<{TOL},ABS(D{r})<{TOL},ABS(E{r})<{TOL})"
    hdr(ws, 3, ["Step", "Row count", f"Amount (entities, excl {LAST_ENTITY_COL})",
                LAST_ENTITY_COL, "Status"])
    line(4, "1.  Raw (source Excel, all rows)", a["raw"])
    line(5, "2a. Dropped – Account blank", a["drop"])
    line(6, "2b. Filtered – Account present", a["filt"])
    line(7, "3a. No grouping code", a["nocode"])
    line(8, "3b. Included – has grouping code", a["inc"])
    line(10, "Raw − Dropped − Filtered   (should be 0)",
         [f"={c}4-{c}5-{c}6" for c in "CDE"], True, ok(abs3(10)))
    line(11, "Filtered − No code − Included   (should be 0)",
         [f"={c}6-{c}7-{c}8" for c in "CDE"], True, ok(abs3(11)))

    line(13, "Rows after mapping join", a["joined"])
    line(14, "Join fan-out: joined − filtered   (should be 0)",
         [f"={c}13-{c}6" for c in "CDE"], True, ok(abs3(14)))
    put(ws, 15, 2, "Accounts duplicated in mapping file   (should be 0)", font=FONT_BOLD, align=ALIGN_LEFT)
    put(ws, 15, 3, a["dup"], font=FONT_BOLD, align=ALIGN_RIGHT, fmt="#,##0")
    put(ws, 15, 6, ok("C15=0"), font=FONT_BOLD)
    line(16, "TB nets to zero: all account rows   (should be 0)",
         [None, "=D6", "=E6"], True, ok(f"AND(ABS(D16)<{TOL},ABS(E16)<{TOL})"))

    # grouping-code tie to the tie-out workbook + code coverage
    codes = sorted(set(a["codes"]) | used)
    first, last = 20, 19 + len(codes)
    put(ws, 18, 2, "Grouping codes tie to tie-out workbook (diff = 0; used codes exist in TB)",
        font=FONT_BOLD, align=ALIGN_LEFT)
    rng = f"G{first}:G{last}"
    put(ws, 18, 6, f'=IF(COUNTIF({rng},"FAIL")>0,"FAIL",IF(COUNTIF({rng},"REVIEW")>0,"REVIEW","PASS"))',
        font=FONT_BOLD)
    hdr(ws, 19, ["Grouping code", "Coverage", "Validation amount (Included)",
                 "Tie-out workbook amount", "Difference", "Status"])
    for i, code in enumerate(codes):
        r = first + i
        cover = ("Both" if code in a["codes"] and code in used else
                 "TB only" if code in a["codes"] else "Tie-out only")
        put(ws, r, 2, code, font=FONT_CODE, align=ALIGN_LEFT)
        put(ws, r, 3, cover)
        put(ws, r, 4, a["codes"].get(code, 0.0), align=ALIGN_RIGHT, fmt=MONEY_FMT)
        put(ws, r, 5, float(look[p["key"]].get(code, ZERO)), align=ALIGN_RIGHT, fmt=MONEY_FMT)
        put(ws, r, 6, f"=D{r}-E{r}", align=ALIGN_RIGHT, fmt=MONEY_FMT)
        if p["strict"]:   # current period: unused code with a balance = REVIEW, typo'd code = FAIL
            put(ws, r, 7, f'=IF(OR(ABS(F{r})>={TOL},C{r}="Tie-out only"),"FAIL",'
                          f'IF(AND(C{r}="TB only",ABS(D{r})>={TOL}),"REVIEW","PASS"))')
        else:
            put(ws, r, 7, ok(f"ABS(F{r})<{TOL}"))

    names = {10: "Raw = Dropped + Filtered", 11: "Filtered = No code + Included",
             14: "No join fan-out", 15: "No duplicate accounts in mapping",
             16: "TB nets to zero", 18: "Grouping codes tie to tie-out workbook"}
    return [(p["sheet"], t, f"{q}!F{r}") for r, t in names.items()]


# ── PART 2: QTD sheet ─────────────────────────────────────────────────────────
def write_qtd(ws, cur, pri, look):
    ws.sheet_view.showGridLines = False
    widths(ws, (2, 44, 22, 22, 22, 22, 18, 12))
    put(ws, 1, 2, "QTD validation – Included tables, current YTD − prior YTD, vs tie-out workbook QTD",
        font=FONT_BOLD, align=ALIGN_LEFT, border=None)
    m = cur.merge(pri, on=[ACCOUNT_COL, GROUP_CODE_COL], how="outer",
                  suffixes=("_cur", "_pri"), indicator=True)
    m[["amt_cur", "amt_pri"]] = m[["amt_cur", "amt_pri"]].fillna(0.0)
    g = m.groupby(GROUP_CODE_COL)[["amt_cur", "amt_pri"]].sum()

    hdr(ws, 3, ["Grouping code", "Current YTD 3/31/26", "Prior YTD 12/31/25",
                "QTD (current − prior)", "Tie-out workbook QTD", "Difference", "Status"])
    codes = sorted(set(g.index) | set(look["qtd"]))
    r = 4
    for code in codes:
        c_, p_ = g.loc[code] if code in g.index else (0.0, 0.0)
        put(ws, r, 2, code, font=FONT_CODE, align=ALIGN_LEFT)
        put(ws, r, 3, float(c_), align=ALIGN_RIGHT, fmt=MONEY_FMT)
        put(ws, r, 4, float(p_), align=ALIGN_RIGHT, fmt=MONEY_FMT)
        put(ws, r, 5, f"=C{r}-D{r}", align=ALIGN_RIGHT, fmt=MONEY_FMT)
        put(ws, r, 6, float(look["qtd"].get(code, ZERO)), align=ALIGN_RIGHT, fmt=MONEY_FMT)
        put(ws, r, 7, f"=E{r}-F{r}", align=ALIGN_RIGHT, fmt=MONEY_FMT)
        put(ws, r, 8, ok(f"ABS(G{r})<{TOL}"))
        r += 1
    put(ws, r + 1, 2, "QTD matches tie-out workbook (all codes)", font=FONT_BOLD, align=ALIGN_LEFT)
    put(ws, r + 1, 8, ok(f'COUNTIF(H4:H{r-1},"FAIL")=0'), font=FONT_BOLD)
    check_row = r + 1

    # account-level match (information; one-sided accounts are normal, e.g. new accounts)
    r += 4
    hdr(ws, r, ["Account match (Included tables)", "Accounts", "QTD amount"])
    for k, label in {"both": "In both periods", "left_only": "Current period only",
                     "right_only": "Prior period only"}.items():
        r += 1
        sub = m[m["_merge"] == k]
        put(ws, r, 2, label, align=ALIGN_LEFT)
        put(ws, r, 3, len(sub), align=ALIGN_RIGHT, fmt="#,##0")
        put(ws, r, 4, float((sub.amt_cur - sub.amt_pri).sum()), align=ALIGN_RIGHT, fmt=MONEY_FMT)
    one = m[m["_merge"] != "both"]
    if len(one):
        r += 2
        hdr(ws, r, ["Account in one period only", "Grouping code", "Current", "Prior"])
        for _, x in one.iterrows():
            r += 1
            put(ws, r, 2, x[ACCOUNT_COL], align=ALIGN_LEFT)
            put(ws, r, 3, x[GROUP_CODE_COL])
            put(ws, r, 4, float(x.amt_cur), align=ALIGN_RIGHT, fmt=MONEY_FMT)
            put(ws, r, 5, float(x.amt_pri), align=ALIGN_RIGHT, fmt=MONEY_FMT)
    return [(QTD_SHEET, "QTD matches tie-out workbook", f"'{QTD_SHEET}'!H{check_row}")]


# ── SUMMARY ───────────────────────────────────────────────────────────────────
def write_summary(ws, checks):
    ws.sheet_view.showGridLines = False
    widths(ws, (2, 18, 48, 14, 2, 2, 2, 2))
    put(ws, 1, 2, "TB TieOut validation – summary", font=FONT_BOLD, align=ALIGN_LEFT, border=None)
    hdr(ws, 3, ["Sheet", "Check", "Result"])
    for i, (sheet, label, ref) in enumerate(checks, start=4):
        put(ws, i, 2, sheet, align=ALIGN_LEFT)
        put(ws, i, 3, label, align=ALIGN_LEFT)
        put(ws, i, 4, f"={ref}", font=FONT_BOLD)
    rng = f"D4:D{3 + len(checks)}"
    put(ws, 2, 3, "OVERALL", font=FONT_BOLD, align=ALIGN_LEFT)
    put(ws, 2, 4, f'=IF(COUNTIF({rng},"FAIL")>0,"FAIL",IF(COUNTIF({rng},"REVIEW")>0,"REVIEW","PASS"))',
        font=FONT_BOLD)


# ── RUN ───────────────────────────────────────────────────────────────────────
def build_validation():
    wb = Workbook()
    wb.remove(wb.active)
    summary = wb.create_sheet("Summary")

    mapping = read_excel(Mapping_excel_path, sheet_name=["Sheet1"], header=0,
                         naming_convention="neutral", trim=True).select(ACCOUNT_COL, GROUP_CODE_COL)
    dup  = mapping.groupBy(ACCOUNT_COL).count().filter("count > 1").count()
    look = load_lookups(CURRENT_TB, PRIOR_TB)
    used = codes_in_tieout()

    checks, results = [], []
    for p in PERIODS:
        a = analyse(p, mapping)
        a["dup"] = dup
        results.append(a)
        checks += write_ytd(wb.create_sheet(p["sheet"]), p, a, look, used)
    checks += write_qtd(wb.create_sheet(QTD_SHEET), results[0]["acct"], results[1]["acct"], look)

    write_summary(summary, checks)
    for ws in wb:
        colour(ws)
    return wb


validation_wb = build_validation()
