dimensions = [
    "Entity", "Grouping", "LOB", "FS Line",           # Global Filters
    "FS Category", "Account Description",             # Y-Axis Hierarchy
    "Account Number", "Transaction Type", 
    "Flag"                                            # CRITICAL for Sankey cross-highlighting
]

# 2. Aggregate the 10M+ rows down to just the unique combinations
diverging_bar_df = gl_df.groupBy(*dimensions).agg(
    F.sum("Balance").alias("Total_Balance")
)

# 3. (Optional but recommended) Add a Debit/Credit indicator for easy coloring in Tableau
diverging_bar_df = diverging_bar_df.withColumn(
