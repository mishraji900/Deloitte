from openpyxl.styles.styleable import StyleArray

SHEET_3A = "3a. Times M by Entity"
TAB_2_SHEET = "3. Residual Analytic 6-30-2026"

ANCHOR_CELL = "B12"
BLOCK_HEIGHT = 5
DATA_ROWS = 3
THRESHOLD_CELL = "$C$7"
TAB_2_TOTAL_COLUMN = "C"   # CHECK: C = Account PY, CY total is in D
DEEMED_SIGNIFICANT = "Deemed significant"
FORMULA_DEEMED_SIGNIFICANT = "Deemed Significant"

TOTAL_HEADER = "Total"
TAB_2_TOTAL_HEADER = "Total as per Tab 2"
DIFFERENCE_HEADER = "Difference"
INVESTIGATE_LIST_HEADER = "Entities to Investigate"
INVESTIGATE_LIST_WIDTH = 60
BLUE = "FF0070C0"
GREEN_FILL_COLOR = "FFC6EFCE"
RED_FILL_COLOR = "FFFFCBCB"

_DEFAULT_STYLE = [0] * 9

S3A_FONT_BLACK, S3A_FONT_BLUE, S3A_FONT_HEADER = make_font(BLACK), make_font(BLUE), make_font(BLACK, bold=True)
S3A_ALIGN_HEADER, S3A_ALIGN_LEFT = make_alignment(wrap=True), make_alignment("left")
S3A_ALIGN_RIGHT, S3A_ALIGN_CENTER = make_alignment("right"), make_alignment("center")
S3A_ALIGN_LEFT_WRAP = make_alignment("left", "center", wrap=True)
S3A_FILL_WHITE, S3A_FILL_NONE = make_fill(WHITE), PatternFill()
S3A_BORDER_FULL, S3A_BORDER_NONE = make_border(BLACK), Border()

def s3a_get_sheet_materiality(worksheet, fallback_value):
    coordinate = MATERIALITY_CELL.replace("$", "")
    sheet_value = to_decimal(worksheet[coordinate].value)
    return fallback_value if sheet_value in {None, Decimal("0")} else sheet_value

def s3a_build_blue_pair_lookups(spark_column_row_pairs_cy, row_id_col=ROW_ID_COLUMN):
    exact_pairs, normalized_pairs = set(), set()
    row_id_key = normalize_text(row_id_col)
    for pair in spark_column_row_pairs_cy or []:
        try:
            column_name, source_row_id = pair
            if column_name is None or normalize_text(column_name) == row_id_key: continue
            source_row_id = int(source_row_id)
            if source_row_id < 1: continue
            exact_pairs.add((str(column_name).strip(), source_row_id))
            normalized_pairs.add((normalize_text(column_name), source_row_id))
        except (TypeError, ValueError): continue
    return exact_pairs, normalized_pairs

def s3a_is_blue_cell(entity_column, source_row_id, blue_exact_pairs, blue_normalized_pairs):
    try: source_row_id = int(source_row_id)
    except (ValueError, TypeError): return False
    return ((str(entity_column).strip(), source_row_id) in blue_exact_pairs
            or (normalize_text(entity_column), source_row_id) in blue_normalized_pairs)

def s3a_build_residual_rows(updated_raw_tb_CY, materiality, row_id_col=ROW_ID_COLUMN):
    materiality_value = to_decimal(materiality)
    source_columns = list(updated_raw_tb_CY.columns)
    row_id_column = require_column(source_columns, row_id_col)
    account_column = require_column(source_columns, "Account")
    percentage_column = require_column(source_columns, PERCENTAGE_COLUMN_NAME)
    test_column = require_column(source_columns, "Test consolidated amount")
    untested_column = require_column(source_columns, "Untested Balance")

    residual_rows = []
    for record in records_from(updated_raw_tb_CY):
        source_row_id = int(record.get(row_id_column))
        if normalize_text(record.get(account_column)) == "": continue
        percentage_value = to_decimal(record.get(percentage_column))
        if percentage_value in {None, Decimal("0")}: continue
        if normalize_text(record.get(test_column)) != "no": continue
        untested_value = to_decimal(record.get(untested_column))
        if untested_value is None: continue
        if abs(untested_value / materiality_value) <= Decimal("1"): continue

        residual_rows.append({"Account_CY": record.get(account_column), "row_id": source_row_id, "record": record})
    residual_rows.sort(key=lambda row: row["row_id"])
    return residual_rows

def s3a_build_tab2_row_lookup(template):
    worksheet = template[TAB_2_SHEET]
    lookup = {}
    for row_number in range(1, worksheet.max_row + 1):
        account_key_value = normalize_text(worksheet.cell(row=row_number, column=2).value)
        if account_key_value and account_key_value not in lookup:
            lookup[account_key_value] = row_number
    return lookup

def s3a_copy_block_style(worksheet, source_start_row, target_start_row, start_column, end_column, source_max_column):
    for row_offset in range(DATA_ROWS):
        source_row, target_row = source_start_row + row_offset, target_start_row + row_offset
        worksheet.row_dimensions[target_row].height = worksheet.row_dimensions[source_row].height
        for column in range(start_column, end_column + 1):
            source_cell = worksheet.cell(row=source_row, column=min(column, source_max_column))
            target_cell = worksheet.cell(row=target_row, column=column)
            if not isinstance(target_cell, MergedCell):
                style_args = source_cell._style if source_cell._style is not None else _DEFAULT_STYLE
                target_cell._style = StyleArray(style_args)

def s3a_wipe_spacer_rows(worksheet, spacer_start_row, start_column, end_column):
    for spacer_row in (spacer_start_row, spacer_start_row + 1):
        for column in range(start_column, end_column + 1):
            cell = worksheet.cell(row=spacer_row, column=column)
            if not isinstance(cell, MergedCell):
                cell.value, cell.fill, cell.border = None, S3A_FILL_NONE, S3A_BORDER_NONE
                cell.font, cell.alignment, cell.number_format = Font(), Alignment(), "General"

def s3a_apply_all_investigate_colors(worksheet, investigate_coordinates):
    for coordinate in investigate_coordinates:
        abs_coord = absolute_coordinate(coordinate)
        red_rule = FormulaRule(formula=[f'{abs_coord}<>"No"'], stopIfTrue=True)
        red_rule.dxf = DifferentialStyle(fill=PatternFill(start_color=RED_FILL_COLOR, end_color=RED_FILL_COLOR, fill_type="solid"))
        red_rule.priority = 1
        green_rule = FormulaRule(formula=[f'{abs_coord}="No"'], stopIfTrue=True)
        green_rule.dxf = DifferentialStyle(fill=PatternFill(start_color=GREEN_FILL_COLOR, end_color=GREEN_FILL_COLOR, fill_type="solid"))
        green_rule.priority = 2
        worksheet.conditional_formatting.add(coordinate, red_rule)
        worksheet.conditional_formatting.add(coordinate, green_rule)

def s3a_write_block(worksheet, block_start_row, record, account_column, source_row_id,
                     entity_columns, blue_exact_pairs, blue_normalized_pairs, tab2_row_lookup):
    # One 3-row block: row1 = headers, row2 = account + balances + Total/Tab2/Difference/Entities list,
    # row3 = "Investigate?" label + per-entity investigate formula.
    header_row, balance_row, investigate_row = block_start_row, block_start_row + 1, block_start_row + 2
    entity_start_column = 3
    entity_end_column = entity_start_column + len(entity_columns) - 1
    total_column, tab2_column, difference_column = entity_end_column + 1, entity_end_column + 2, entity_end_column + 3
    list_column = difference_column + 1   # NEW

    investigate_coordinates = []
    account_header = worksheet.cell(row=header_row, column=2)
    account_header.value = "Account"
    account_header.font, account_header.alignment = S3A_FONT_HEADER, S3A_ALIGN_HEADER
    account_header.fill, account_header.border = S3A_FILL_WHITE, S3A_BORDER_FULL

    account_value = record.get(account_column)
    if account_value in {None, ""}:
        return investigate_coordinates

    account_cell = worksheet.cell(row=balance_row, column=2)
    account_cell.value = account_value
    account_cell.font, account_cell.alignment = S3A_FONT_BLACK, S3A_ALIGN_LEFT
    account_cell.fill, account_cell.border = S3A_FILL_WHITE, S3A_BORDER_FULL

    investigate_label = worksheet.cell(row=investigate_row, column=2)
    investigate_label.value = "Investigate?"
    investigate_label.font, investigate_label.alignment = S3A_FONT_BLACK, S3A_ALIGN_RIGHT
    investigate_label.fill, investigate_label.border = S3A_FILL_WHITE, S3A_BORDER_FULL

    for entity_index, entity_column in enumerate(entity_columns, start=entity_start_column):
        header_cell = worksheet.cell(row=header_row, column=entity_index)
        header_cell.value = str(entity_column).strip()
        header_cell.font, header_cell.alignment = S3A_FONT_HEADER, S3A_ALIGN_HEADER
        header_cell.fill, header_cell.border = S3A_FILL_WHITE, S3A_BORDER_FULL

        balance_cell = worksheet.cell(row=balance_row, column=entity_index)
        investigate_cell = worksheet.cell(row=investigate_row, column=entity_index)

        source_value = record.get(entity_column)
        grey_marker = is_grey_marker(source_value)
        numeric_value = None if grey_marker else to_decimal(source_value)
        is_blue = s3a_is_blue_cell(entity_column, source_row_id, blue_exact_pairs, blue_normalized_pairs)
        balance_cell.fill, balance_cell.border = S3A_FILL_WHITE, S3A_BORDER_FULL

        if grey_marker or is_blue:
            balance_cell.value = DEEMED_SIGNIFICANT
            balance_cell.font, balance_cell.alignment, balance_cell.number_format = S3A_FONT_BLUE, S3A_ALIGN_CENTER, "General"
        elif numeric_value is not None:
            balance_cell.value = float(numeric_value)
            balance_cell.font, balance_cell.alignment, balance_cell.number_format = S3A_FONT_BLACK, S3A_ALIGN_RIGHT, MONEY_FMT
        else:
            balance_cell.value = source_value
            balance_cell.font, balance_cell.alignment, balance_cell.number_format = S3A_FONT_BLACK, S3A_ALIGN_RIGHT, "General"

        balance_coordinate = balance_cell.coordinate
        investigate_cell.value = (
            f'=IF(OR({balance_coordinate}="{DEEMED_SIGNIFICANT}",{balance_coordinate}="{FORMULA_DEEMED_SIGNIFICANT}"),"No",'
            f'IF(OR(ISBLANK({balance_coordinate}),NOT(ISNUMBER({balance_coordinate}))),"",'
            f'IF(ABS({balance_coordinate})<{THRESHOLD_CELL},"No","Investigate")))'
        )
        investigate_cell.font, investigate_cell.alignment = S3A_FONT_BLACK, S3A_ALIGN_CENTER
        investigate_cell.border, investigate_cell.number_format, investigate_cell.fill = S3A_BORDER_FULL, "General", S3A_FILL_NONE
        investigate_coordinates.append(investigate_cell.coordinate)

    for column, label in ((total_column, TOTAL_HEADER), (tab2_column, TAB_2_TOTAL_HEADER),
                          (difference_column, DIFFERENCE_HEADER), (list_column, INVESTIGATE_LIST_HEADER)):
        header_cell = worksheet.cell(row=header_row, column=column)
        header_cell.value = label
        header_cell.font, header_cell.alignment = S3A_FONT_HEADER, S3A_ALIGN_HEADER
        header_cell.fill, header_cell.border = S3A_FILL_WHITE, S3A_BORDER_FULL

    total_cell = worksheet.cell(row=balance_row, column=total_column)
    first_coordinate = worksheet.cell(row=balance_row, column=entity_start_column).coordinate
    last_coordinate = worksheet.cell(row=balance_row, column=entity_end_column).coordinate
    total_cell.value = f"=SUM({first_coordinate}:{last_coordinate})"
    total_cell.font, total_cell.alignment = S3A_FONT_BLACK, S3A_ALIGN_RIGHT
    total_cell.fill, total_cell.border, total_cell.number_format = S3A_FILL_WHITE, S3A_BORDER_FULL, MONEY_FMT

    tab2_row = tab2_row_lookup.get(normalize_text(account_value))
    tab2_cell = worksheet.cell(row=balance_row, column=tab2_column)
    tab2_cell.font, tab2_cell.alignment = S3A_FONT_BLACK, S3A_ALIGN_RIGHT
    tab2_cell.fill, tab2_cell.border, tab2_cell.number_format = S3A_FILL_WHITE, S3A_BORDER_FULL, MONEY_FMT

    if tab2_row is None:
        tab2_cell.value, tab2_cell.number_format = "-", "General"
    else:
        tab2_cell.value = f"={quote_sheetname(TAB_2_SHEET)}!${TAB_2_TOTAL_COLUMN}${tab2_row}"

    difference_cell = worksheet.cell(row=balance_row, column=difference_column)
    difference_cell.font, difference_cell.alignment = S3A_FONT_BLACK, S3A_ALIGN_RIGHT
    difference_cell.fill, difference_cell.border, difference_cell.number_format = S3A_FILL_WHITE, S3A_BORDER_FULL, MONEY_FMT

    if tab2_row is None:
        difference_cell.value, difference_cell.number_format = "-", "General"
    else:
        difference_cell.value = (
            f'=IF(OR(NOT(ISNUMBER({total_cell.coordinate})),NOT(ISNUMBER({tab2_cell.coordinate}))),"-",'
            f'IF(ROUND({total_cell.coordinate}-{tab2_cell.coordinate},0)=0,"-",'
            f'{total_cell.coordinate}-{tab2_cell.coordinate}))'
        )

    # NEW: comma-separated list of every entity whose per-entity Investigate? = "Investigate"
    hdr_first = worksheet.cell(row=header_row, column=entity_start_column).coordinate
    hdr_last = worksheet.cell(row=header_row, column=entity_end_column).coordinate
    inv_first = worksheet.cell(row=investigate_row, column=entity_start_column).coordinate
    inv_last = worksheet.cell(row=investigate_row, column=entity_end_column).coordinate

    list_cell = worksheet.cell(row=balance_row, column=list_column)
    list_cell.value = ArrayFormula(
        list_cell.coordinate,
        f'=_xlfn.TEXTJOIN(", ",TRUE,IF({inv_first}:{inv_last}="Investigate",{hdr_first}:{hdr_last},""))'
    )
    list_cell.font, list_cell.alignment = S3A_FONT_BLACK, S3A_ALIGN_LEFT_WRAP
    list_cell.fill, list_cell.border, list_cell.number_format = S3A_FILL_WHITE, S3A_BORDER_FULL, "General"

    for column in (total_column, tab2_column, difference_column, list_column):
        summary_cell = worksheet.cell(row=investigate_row, column=column)
        summary_cell.value = None
        summary_cell.font, summary_cell.alignment = S3A_FONT_BLACK, S3A_ALIGN_CENTER
        summary_cell.fill, summary_cell.border = S3A_FILL_WHITE, S3A_BORDER_FULL

    return investigate_coordinates

def populate_sheet_3a(template, updated_raw_tb_CY, residual_rows, spark_column_row_pairs_cy, materiality, row_id_col=ROW_ID_COLUMN):
    worksheet = template[SHEET_3A]
    source_columns = list(updated_raw_tb_CY.columns)
    account_column = require_column(source_columns, "Account")
    entity_columns = find_entity_columns(source_columns, excludes=["Account", "% of consolidated balance", "Test consolidated amount",
                "Untested Balance", "Eliminations", "TopSide", "Reclassifications", "__sheet__"])

    mat_coord = MATERIALITY_CELL.replace("$", "")
    worksheet[mat_coord].value = float(to_decimal(materiality))
    worksheet["C7"].value = float(THRESHOLD_VALUE)

    tab2_row_lookup = s3a_build_tab2_row_lookup(template)
    blue_exact_pairs, blue_normalized_pairs = s3a_build_blue_pair_lookups(spark_column_row_pairs_cy, row_id_col)
    header_row, start_column = coordinate_to_tuple(ANCHOR_CELL)
    last_entity_column = start_column + len(entity_columns)
    total_column, tab2_column = last_entity_column + 1, last_entity_column + 2
    difference_column = tab2_column + 1
    list_column = output_end_column = difference_column + 1   # NEW: list col is now the last col
    source_max_column = worksheet.max_column
    required_end_row = header_row + max(len(residual_rows), 1) * BLOCK_HEIGHT - 1

    if required_end_row > worksheet.max_row:
        worksheet.insert_rows(worksheet.max_row + 1, amount=required_end_row - worksheet.max_row)

    clear_worksheet_area(worksheet, header_row, start_column, end_row=max(worksheet.max_row, required_end_row), end_column=max(worksheet.max_column, output_end_column))
    clear_conditional_formatting(worksheet)

    all_investigate_coordinates = []
    for index, residual_row in enumerate(residual_rows):
        block_start_row = header_row + index * BLOCK_HEIGHT
        s3a_copy_block_style(worksheet, header_row, block_start_row, start_column, output_end_column, source_max_column)
        investigate_coordinates = s3a_write_block(
            worksheet=worksheet, block_start_row=block_start_row, record=residual_row["record"],
            account_column=account_column, source_row_id=residual_row["row_id"],
            entity_columns=entity_columns, blue_exact_pairs=blue_exact_pairs,
            blue_normalized_pairs=blue_normalized_pairs, tab2_row_lookup=tab2_row_lookup)
        all_investigate_coordinates.extend(investigate_coordinates)
        s3a_wipe_spacer_rows(worksheet, block_start_row + DATA_ROWS, start_column, output_end_column)

    s3a_apply_all_investigate_colors(worksheet, all_investigate_coordinates)
    worksheet.column_dimensions[get_column_letter(list_column)].width = INVESTIGATE_LIST_WIDTH

    return {"entity_columns": entity_columns, "blocks_written": len(residual_rows)}

residual_rows = s3a_build_residual_rows(updated_raw_tb_CY, MATERIALITY)
populate_sheet_3a(template, updated_raw_tb_CY, residual_rows, spark_column_row_pairs_cy, MATERIALITY)
