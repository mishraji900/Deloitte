// filename: main.js
const { app, BrowserWindow, ipcMain, dialog, shell } = require("electron");
const path = require("path");
const { spawn } = require("child_process");

function createWindow() {
  const win = new BrowserWindow({
    width: 1400,
    height: 900,
    webPreferences: {
      preload: path.join(__dirname, "preload.js"),
      contextIsolation: true,
      nodeIntegration: false
    }
  });

  if (app.isPackaged) {
    win.loadFile(path.join(__dirname, "dist", "index.html"));
  } else {
    win.loadURL("http://localhost:5173");
  }
}

function getBackendLaunchConfig() {
  if (app.isPackaged) {
    return {
      command: path.join(process.resourcesPath, "backend", "excel-validator-backend.exe"),
      args: []
    };
  }

  return {
    command: process.platform === "win32" ? "python" : "python3",
    args: [path.join(__dirname, "excel-validator.py")]
  };
}

function runPythonValidator(payload) {
  return new Promise((resolve, reject) => {
    const backend = getBackendLaunchConfig();
    const child = spawn(backend.command, backend.args, {
      stdio: ["pipe", "pipe", "pipe"],
      windowsHide: true
    });

    let stdout = "";
    let stderr = "";

    child.stdout.on("data", (data) => {
      stdout += data.toString();
    });

    child.stderr.on("data", (data) => {
      stderr += data.toString();
    });

    child.on("error", (error) => {
      reject(new Error(`Failed to start backend: ${error.message}`));
    });

    child.on("close", (code) => {
      if (!stdout.trim()) {
        reject(new Error(stderr || `Backend exited with code ${code}`));
        return;
      }

      try {
        resolve(JSON.parse(stdout));
      } catch {
        reject(new Error(`Invalid JSON from backend.\n${stdout}\n${stderr}`));
      }
    });

    child.stdin.write(JSON.stringify(payload));
    child.stdin.end();
  });
}

ipcMain.handle("pick-excel-file", async () => {
  const result = await dialog.showOpenDialog({
    properties: ["openFile"],
    filters: [{ name: "Excel Files", extensions: ["xls", "xlsx", "xlsm"] }]
  });

  if (result.canceled || !result.filePaths.length) {
    return null;
  }

  return result.filePaths[0];
});

ipcMain.handle("run-validation", async (_event, payload) => {
  return runPythonValidator(payload);
});

ipcMain.handle("open-report", async (_event, reportPath) => {
  if (!reportPath) return false;
  await shell.openPath(reportPath);
  return true;
});

app.whenReady().then(() => {
  createWindow();

  app.on("activate", () => {
    if (BrowserWindow.getAllWindows().length === 0) {
      createWindow();
    }
  });
});

app.on("window-all-closed", () => {
  if (process.platform !== "darwin") {
    app.quit();
  }
});
