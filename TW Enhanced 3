def ensure_required_columns(df, required_cols: list):
    """
    Guarantee df has exactly `required_cols` (adds any missing as NULL string),
    and coalesces "Company Description" from "Company" if the former is blank.
    INPUT  : df, required_cols (BASE_RAW_COLUMNS or PIPE2_RAW_COLUMNS)
    OUTPUT : df reshaped to exactly required_cols, in that order
    USED BY: base_tag() — first thing every pipeline does to its raw input.
    """
    for c in required_cols:
        if c not in df.columns:
            df = df.withColumn(c, F.lit(None).cast("string"))
    df = df.withColumn(
        "Company Description",
        F.coalesce(
            F.col("Company Description").cast("string"),
            F.col("Company").cast("string"),
        )
    )
    return df.select(*required_cols)


def add_source_quarter_col(df, quarter_value: str):
    """
    Stamp every row of df with a constant "Source Quarter" value.
    INPUT  : df, quarter_value (e.g. CURRENT_QUARTER or CARRY_FORWARD_SOURCE_QUARTER)
    OUTPUT : df + "Source Quarter" column
    USED BY: Cell 5 (Pipeline 2) — tags CY-unmatched rows with CURRENT_QUARTER,
             and carry-forward rows with CARRY_FORWARD_SOURCE_QUARTER, BEFORE
             they're unioned together. This per-row quarter later drives
             assign_aa_comment()'s Rule 3 Priority 4 (first-month-of-quarter check).
    """
    return df.withColumn("Source Quarter", F.lit(quarter_value))


def ensure_row_id(df):
    """
    Assign a stable, deterministic row_id (via row_number() over a fixed sort
    key) if df doesn't already have one.
    INPUT  : df
    OUTPUT : df + "row_id" (string) — THE identifier that follows a raw JE
             line through the entire pipeline (P1 -> P2 -> P3 -> AA tagging).
    USED BY: base_tag() — called once per pipeline, on that pipeline's input.
    CAUTION: row_id is only stable WITHIN one execution of base_tag() on a
             given input frame — it's re-derived per pipeline, not a persistent
             key from the source system.
    """
    if "row_id" in df.columns:
        return df.withColumn("row_id", F.col("row_id").cast("string"))
    preferred = [
        "Company Description", "Vendor/Customer Number", "JE Category",
        "Default Effective Date", "Month", "Net Entered",
        "Invoice Reference", "JE Batch Id", "JE Line Number",
    ]
    order_cols = [c for c in preferred if c in df.columns] or sorted(df.columns)
    return df.withColumn(
        "row_id",
        F.row_number()
         .over(Window.orderBy(*[F.col(c).asc_nulls_last() for c in order_cols]))
         .cast("string"),
    )


# ── Type-conversion helpers ──────────────────────────────────────────────────

def to_decimal_clean(col_name: str, precision: int = 38, scale: int = 6):
    """
    Parse a string money column into DecimalType, handling:
      - thousands commas ("1,234.56")
      - parenthetical negatives ("(500)" -> "-500")
      - blank strings -> NULL
    INPUT  : col_name (string column name)
    OUTPUT : a Spark Column expression (not applied yet — caller does .withColumn())
    USED BY: base_tag() (-> entered_net_dec), assign_aa_comment() fallback re-derivation.
    """
    cleaned = F.trim(F.col(col_name).cast("string"))
    cleaned = F.regexp_replace(cleaned, ",", "")
    cleaned = F.when(
        cleaned.rlike(r"^\(.*\)$"),
        F.concat(F.lit("-"), F.regexp_replace(cleaned, r"[()]", "")),
    ).otherwise(cleaned)
    cleaned = F.when(cleaned == "", None).otherwise(cleaned)
    return cleaned.cast(T.DecimalType(precision, scale))


def to_date_clean(col_name: str):
    """
    Parse a string date column by trying several format patterns in order,
    first non-null match wins (F.coalesce).
    INPUT  : col_name (string column name, e.g. "Default Effective Date")
    OUTPUT : a Spark Column expression of DateType
    USED BY: base_tag() (-> eff_dt), assign_aa_comment() fallback re-derivation.
    """
    raw = F.trim(F.col(col_name).cast("string"))
    return F.coalesce(
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "M/d/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )


def month_from_business_column(month_col):
    """
    Parse the free-text "Month" business column (formats vary: "Jan-25",
    "01-Jan-25", full dates, etc.) into a proper Date.
    INPUT  : month_col — a Spark Column (already F.col("Month"), not a name string!)
    OUTPUT : a Spark Column expression of DateType
    USED BY: base_tag() (-> month_dt), used later in rank_based_match() to
             compute month_lag between a sales row and a credit row.
    """
    raw = F.trim(month_col.cast("string"))
    return F.coalesce(
        F.to_date(raw, "dd-MMM-yy"),
        F.to_date(raw, "dd-MMM-yyyy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yy"),
        F.to_date(F.concat(F.lit("01-"), raw), "dd-MMM-yyyy"),
        F.to_date(raw, "MM/dd/yyyy"),
        F.to_date(raw, "yyyy-MM-dd"),
        F.to_date(raw, "yyyy-MM-dd HH:mm:ss"),
    )


# ── DataFrame set helpers ────────────────────────────────────────────────────

def union_non_null(*dfs):
    """
    unionByName() across any number of dataframes, silently skipping any None.
    INPUT  : *dfs — variable number of dataframe args (some may be None)
    OUTPUT : single unioned dataframe, or None if ALL inputs were None
    USED BY: everywhere two or more optional result-sets need combining —
             e.g. P1_ALL_MATCHED, P1_ALL_UNMATCHED, P3_ALL_UNMATCHED,
             all_invalid/all_exc_1/etc in Cell 8.
    """
    valid = [df for df in dfs if df is not None]
    if not valid:
        return None
    out = valid[0]
    for df in valid[1:]:
        out = out.unionByName(df, allowMissingColumns=True)
    return out


# ── Pipeline base transformation ─────────────────────────────────────────────

def base_tag(df, required_cols: list):
    """
    THE common entry-point transform for every pipeline (P1/P2/P3 each call
    this once on their raw input). Does, in order:
      1. ensure_required_columns  — pad schema to required_cols
      2. ensure_row_id            — assign row_id
      3. derive cleaned/computed helper columns (invoice_ref_clean, cat_clean,
         company_desc_clean, vendor_num_clean, eff_dt, month_dt, entered_net_dec,
         abs_entered_dec, abs_entered_key)
      4. compute "primary_key"    = Company_Vendor_AbsAmount (matching key)
      5. compute "is_valid_row"   = has row_id + amount + eff_dt + month_dt + primary_key
    INPUT  : df — raw JE dataframe (JE_raw for P1, aligned unmatched for P2/P3)
             required_cols — BASE_RAW_COLUMNS (P1) or PIPE2_RAW_COLUMNS (P2/P3)
    OUTPUT : df with ALL original + derived columns, INCLUDING invalid rows
             (caller must .filter(F.col("is_valid_row")) to split them out —
             see Cell 4/5/6 Step 1, which route invalid rows to *_INVALID tables).
    USED BY: Cell 4 (P1), Cell 5 (P2), Cell 6 (P3) — each as their very first step.
    """
    _sq = "Source Quarter"
    _cols = required_cols if _sq in required_cols else (
        required_cols + [_sq] if _sq in df.columns else required_cols
    )

    df = ensure_required_columns(df, _cols)
    df = ensure_row_id(df)
    df = (
        df
        .withColumn("invoice_ref_clean", F.trim(F.col("Invoice Reference")))
        .withColumn("cat_clean",          F.trim(F.upper(F.col("JE Category"))))
        .withColumn("company_desc_clean", F.trim(F.upper(F.col("Company Description"))))
        .withColumn("vendor_num_clean",   F.trim(F.col("Vendor/Customer Number").cast("string")))
        .withColumn("eff_dt",             to_date_clean("Default Effective Date"))
        .withColumn("Default Effective Date", F.col("eff_dt"))   # overwrite raw string col with parsed date
        .withColumn("month_dt",           month_from_business_column(F.col("Month")))
        .withColumn("entered_net_dec",    to_decimal_clean("Net Entered"))
        .withColumn("abs_entered_dec",    F.abs(F.col("entered_net_dec")))
        .withColumn("abs_entered_key",    F.col("abs_entered_dec").cast("string"))
        .withColumn("valid_company_desc",
            F.col("company_desc_clean").isNotNull() & (F.col("company_desc_clean") != ""))
        .withColumn("valid_vendor_num",
            F.col("vendor_num_clean").isNotNull() & (F.col("vendor_num_clean") != ""))
        .withColumn("primary_key",
            # matching key = Company + Vendor# + ABS(amount) — NULL if either
            # text field is invalid or amount didn't parse (row can't be matched)
            F.when(
                F.col("valid_company_desc")
                & F.col("valid_vendor_num")
                & F.col("abs_entered_dec").isNotNull(),
                F.concat_ws("_",
                    F.col("company_desc_clean"),
                    F.col("vendor_num_clean"),
                    F.col("abs_entered_key"),
                ),
            )
        )
        .withColumn("is_valid_row",
            # a row must have ALL of these to participate in matching downstream
            F.col("row_id").isNotNull()
            & F.col("entered_net_dec").isNotNull()
            & F.col("eff_dt").isNotNull()
            & F.col("month_dt").isNotNull()
            & F.col("primary_key").isNotNull()
        )
    )
    return df


# ── Matching helpers ──────────────────────────────────────────────────────────

def make_sales(src_df, pk_col: str = "primary_key"):
    """
    Slim projection of Sales-Invoice rows, renamed with 'sales_' prefix, ready
    to join against make_credit()'s output on primary_key.
    INPUT  : src_df — a base_tag()'d + duplicate-PK-filtered dataframe
             pk_col — which key column to alias as "primary_key" (P1/P2 use
                      "primary_key"; P3 passes "p3_primary_key" instead)
    OUTPUT : slim df: primary_key, sales_row_id, sales_amt, sales_eff_dt,
             sales_month, sales_ref — repartitioned by primary_key.
    USED BY: Cell 4 (p1_sales), Cell 5 (p2_sales), Cell 6 (p3_sales).
    """
    return (
        src_df.filter(F.col("cat_clean") == "SALES INVOICES")
        .select(
            F.col(pk_col).alias("primary_key"),
            F.col("row_id").alias("sales_row_id"),
            F.col("entered_net_dec").alias("sales_amt"),
            F.col("eff_dt").alias("sales_eff_dt"),
            F.col("month_dt").alias("sales_month"),
            F.col("invoice_ref_clean").alias("sales_ref"),
        )
        .repartition(NUM_PARTITIONS, "primary_key")
    )


def make_credit(src_df, pk_col: str = "primary_key"):
    """
    Same as make_sales() but for Credit-Memo rows ('credit_' prefix).
    USED BY: Cell 4 (p1_credit), Cell 5 (p2_credit), Cell 6 (p3_credit).
    """
    return (
        src_df.filter(F.col("cat_clean") == "CREDIT MEMOS")
        .select(
            F.col(pk_col).alias("primary_key"),
            F.col("row_id").alias("credit_row_id"),
            F.col("entered_net_dec").alias("credit_amt"),
            F.col("eff_dt").alias("credit_eff_dt"),
            F.col("month_dt").alias("credit_month"),
            F.col("invoice_ref_clean").alias("credit_ref"),
        )
        .repartition(NUM_PARTITIONS, "primary_key")
    )


def build_unmatched_rows(base_df, rem_sales_df, rem_credit_df,
                         name: str, stage_path: str = None):
    """
    Collect the FULL original rows for every row_id still present in the
    leftover sales/credit tables after a pipeline's match steps finish.
    INPUT  : base_df — the full (pre-split) tagged dataframe for this pipeline
                        (e.g. P1_DUP_SI_CM)
             rem_sales_df / rem_credit_df — whatever's left after run_match_pipeline()
             name — output file name
    OUTPUT : materialized dataframe of full original rows that never matched
    USED BY: Cell 4 -> P1_UNMATCHED, Cell 5 -> P2_UNMATCHED.
    """
    remaining_ids = (
        rem_sales_df.select(F.col("sales_row_id").alias("row_id"))
        .unionByName(rem_credit_df.select(F.col("credit_row_id").alias("row_id")))
        .distinct()
    )
    unmatched = base_df.join(remaining_ids, on="row_id", how="inner")
    return materialize_df(unmatched, name, "primary_key", stage_path=stage_path)


def resolve_to_original(pairs_df, base_df, match_label: str,
                        stage_name: str, stage_path: str = None,
                        has_year_flag: bool = False):
    """
    Take a "slim" pairs table (just sales_row_id/credit_row_id/match_type) and
    expand it back into FULL original JE rows for BOTH sides of each pair,
    stamping a "pair_id" (and, for Pipeline 2, a "Year Pair Flag") onto each.
    INPUT  : pairs_df — slim confirmed-pair rows (output of exhaustive_match's
                        internal union of per-iteration rank_based_match results)
             base_df  — full tagged dataframe to look up original columns from
             match_label — e.g. "SAME_MONTH_EXACT" (used to build pair_id prefix)
             has_year_flag — True only for Pipeline 2 (adds "Year Pair Flag",
                             derived from each side's "Year Flag" vs CURRENT_FY/PRIOR_FY)
    OUTPUT : one row per (pair_id, original_column...) for EACH side of a pair
             (i.e. 2 output rows per matched pair: one tagged as the sales line,
             one as the credit line) — materialized dataframe.
    USED BY: exhaustive_match() — called once at the end of each match-step's
             iterative loop, to turn confirmed pairs into the final "RESOLVED_*"
             / "P{n}_MATCHED_*" datasets.
    """
    if pairs_df is None:
        return None

    w_pair = Window.orderBy(
        F.col("primary_key").asc(),
        F.col("sales_row_id").asc(),
        F.col("credit_row_id").asc(),
    )

    pairs_with_id = (
        pairs_df
        .withColumn(
            "pair_id",
            F.concat(
                F.lit(f"{match_label}_"),
                F.row_number().over(w_pair).cast("string"),
            ),
        )
        .select("pair_id", "sales_row_id", "credit_row_id", "match_type")
    )

    if has_year_flag:
        # Pull each side's "Year Flag" (CY/PY) via a mini self-lookup against
        # base_df, then derive a human-readable "Year Pair Flag" label.
        yf_sales  = base_df.select(
            F.col("row_id").alias("sales_row_id"),
            F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("sales_year_flag"),
        )
        yf_credit = base_df.select(
            F.col("row_id").alias("credit_row_id"),
            F.upper(F.trim(F.col("Year Flag").cast("string"))).alias("credit_year_flag"),
        )
        pairs_with_id = (
            pairs_with_id
            .join(yf_sales,  on="sales_row_id",  how="left")
            .join(yf_credit, on="credit_row_id", how="left")
            .withColumn(
                "Year Pair Flag",
                F.when(
                    (F.col("sales_year_flag") == PRIOR_FY)
                    & (F.col("credit_year_flag") == CURRENT_FY),
                    F.lit("PY Sales Inv with CY Credit Memo"),
                ).when(
                    (F.col("sales_year_flag") == CURRENT_FY)
                    & (F.col("credit_year_flag") == CURRENT_FY),
                    F.lit("CY Sales Inv with CY Credit Memo"),
                ).when(
                    (F.col("sales_year_flag") == PRIOR_FY)
                    & (F.col("credit_year_flag") == PRIOR_FY),
                    F.lit("PY Sales Inv with PY Credit Memo"),
                ).when(
                    (F.col("sales_year_flag") == CURRENT_FY)
                    & (F.col("credit_year_flag") == PRIOR_FY),
                    F.lit("CY Sales Inv with PY Credit Memo"),
                ).otherwise(F.lit("Unknown"))
            )
            .select("pair_id", "sales_row_id", "credit_row_id", "match_type", "Year Pair Flag")
        )

    orig_cols = [F.col(f"orig.`{c}`") for c in base_df.columns]
    extra_meta = ["pair_id", "match_type"] + (["Year Pair Flag"] if has_year_flag else [])
    meta_cols  = [F.col(c) for c in extra_meta if c not in base_df.columns]

    # Join the pair table to base_df TWICE — once matching sales_row_id, once
    # matching credit_row_id — then union: this is how ONE pair becomes TWO
    # output rows (the sales line + the credit line), both tagged with the
    # same pair_id so they can be grouped back together downstream/in Excel.
    sales_side = (
        pairs_with_id
        .join(base_df.alias("orig"),
              pairs_with_id["sales_row_id"] == F.col("orig.row_id"), "inner")
        .select(*meta_cols, *orig_cols)
    )
    credit_side = (
        pairs_with_id
        .join(base_df.alias("orig"),
              pairs_with_id["credit_row_id"] == F.col("orig.row_id"), "inner")
        .select(*meta_cols, *orig_cols)
    )

    resolved = sales_side.unionByName(credit_side)
    return materialize_df(resolved, stage_name, "primary_key", stage_path=stage_path)


def rank_based_match(sales_df, credit_df, condition_fn, match_label: str,
                     stage_path: str = None):
    """
    ONE round of ranked bipartite (1-to-1) matching between sales_df and
    credit_df, restricted to whatever candidate rows condition_fn() lets
    through (e.g. "same month, amounts net to exactly 0").
    Ranking picks, per sales row, the BEST credit candidate (lowest amount_diff,
    then lowest month_lag, then earliest credit_eff_dt, then lowest credit_row_id)
    — and vice versa for credit rows — then keeps only pairs where BOTH sides
    independently rank each other #1 (mutual best match, like a stable-marriage
    single round).
    INPUT  : sales_df, credit_df — slim tables from make_sales()/make_credit()
                                   (or whatever's "remaining" from a prior iteration)
             condition_fn — a filter lambda from MATCH_STEPS (defines this
                            round's business rule: month_lag range, exact vs
                            approx amount, date ordering)
             match_label — string tag stamped as "match_type" on confirmed pairs
    OUTPUT : (confirmed_pairs_df | None, remaining_sales_df, remaining_credit_df)
             confirmed_pairs_df is None if nothing matched this round.
    USED BY: exhaustive_match() — called repeatedly in a loop until it returns
             None (no more matches possible with this condition_fn).
    """
    candidates = (
        sales_df.alias("s")
        .join(credit_df.alias("c"), on="primary_key", how="inner")
        .withColumn("amount_diff",
            F.abs(F.col("s.sales_amt") + F.col("c.credit_amt")))
        .withColumn("month_lag",
            F.months_between(
                F.col("c.credit_month").cast("date"),
                F.col("s.sales_month").cast("date"),
            ).cast("int"))
    )
    candidates = condition_fn(candidates)

    if candidates.limit(1).count() == 0:
        return None, sales_df, credit_df

    # Per-sales-row ranking of candidate credits, and vice versa.
    w_sales = Window.partitionBy("primary_key", "s.sales_row_id").orderBy(
        F.col("amount_diff").asc(), F.col("month_lag").asc(),
        F.col("c.credit_eff_dt").asc(), F.col("c.credit_row_id").asc(),
    )
    w_credit = Window.partitionBy("primary_key", "c.credit_row_id").orderBy(
        F.col("amount_diff").asc(), F.col("month_lag").asc(),
        F.col("s.sales_eff_dt").asc(), F.col("s.sales_row_id").asc(),
    )

    # Keep a pair only if it's rank #1 from BOTH sides (mutual best match).
    confirmed = (
        candidates
        .withColumn("rn_sales",  F.row_number().over(w_sales))
        .filter(F.col("rn_sales") == 1)
        .withColumn("rn_credit", F.row_number().over(w_credit))
        .filter(F.col("rn_credit") == 1)
        .select(
            F.col("primary_key"),
            F.col("s.sales_row_id").alias("sales_row_id"),
            F.col("c.credit_row_id").alias("credit_row_id"),
            F.col("s.sales_amt").alias("sales_amt"),
            F.col("c.credit_amt").alias("credit_amt"),
            F.col("amount_diff"),
            F.col("s.sales_eff_dt").alias("sales_eff_dt"),
            F.col("c.credit_eff_dt").alias("credit_eff_dt"),
            F.col("s.sales_month").alias("sales_month"),
            F.col("c.credit_month").alias("credit_month"),
            F.col("s.sales_ref").alias("sales_ref"),
            F.col("c.credit_ref").alias("credit_ref"),
            F.col("month_lag"),
            F.lit(match_label).alias("match_type"),
        )
    )

    if confirmed.limit(1).count() == 0:
        return None, sales_df, credit_df

    confirmed = materialize_df(confirmed, f"pairs_{match_label}", stage_path=stage_path)

    # Whatever got matched drops OUT of sales_df/credit_df for the next round
    # (via exhaustive_match()'s loop) or the next MATCH_STEPS entry (via
    # run_match_pipeline()).
    matched_s_ids = confirmed.select("sales_row_id").distinct()
    matched_c_ids = confirmed.select("credit_row_id").distinct()

    rem_sales  = sales_df.join(matched_s_ids,  on="sales_row_id",  how="left_anti")
    rem_credit = credit_df.join(matched_c_ids, on="credit_row_id", how="left_anti")

    return confirmed, rem_sales, rem_credit


def exhaustive_match(sales_df, credit_df, condition_fn, match_label: str,
                     base_df, stage_path: str = None,
                     has_year_flag: bool = False,
                     max_iterations: int = 50):
    """
    Wraps rank_based_match() in a loop: keep re-running the SAME condition_fn
    against whatever's left over, until either side is exhausted or a round
    returns 0 new pairs. This lets a single business rule (e.g. "same month,
    exact amount") mop up chains of matches (A matches B, freeing up C to
    match D, etc.) rather than stopping after one greedy pass.
    Includes a CHECKPOINT/RESUME mechanism (writes progress to CKPT_* parquet
    files) so a long-running match step surviving a cluster restart can pick
    back up instead of starting over — see "Checkpoint resume logic" below.

    INPUT  : sales_df, credit_df — slim remaining tables (from a prior step,
                                   or fresh from make_sales()/make_credit())
             condition_fn — the match rule for THIS step (from MATCH_STEPS)
             match_label — string tag for this step, e.g. "SAME_MONTH_EXACT"
             base_df — full tagged dataframe (for resolve_to_original() lookups)
             stage_path — where to write iteration/checkpoint parquet files
             has_year_flag — passed straight through to resolve_to_original()
             max_iterations — safety cap on the inner loop (default 50)
    OUTPUT : (resolved_df | None, still_unmatched_sales_df, still_unmatched_credit_df)
             resolved_df = full original rows for every pair confirmed in ANY
             iteration of this step, expanded via resolve_to_original().
    USED BY: run_match_pipeline() — called once per (label, condition_fn) in
             MATCH_STEPS, chained so each step consumes the previous step's
             leftovers.
    """
    print(f"\n[EXHAUSTIVE MATCH] {match_label}")
    base = stage_path or output_path

    ckpt_meta_path   = f"{base}/CKPT_{match_label}_meta.parquet"
    ckpt_sales_path  = f"{base}/CKPT_{match_label}_rem_sales.parquet"
    ckpt_credit_path = f"{base}/CKPT_{match_label}_rem_credit.parquet"

    start_iteration  = 1
    accumulated      = []     # list of (iter_label, parquet_path) for this step's confirmed pairs
    cur_sales        = sales_df
    cur_credit       = credit_df
    total_pairs      = 0

    # ── Checkpoint resume logic ──────────────────────────────────────────────
    # If a previous run of THIS match_label left a checkpoint behind, and the
    # per-iteration pair files it references still exist, pick up counting
    # from last_completed_iteration+1 instead of iteration 1. Guards against
    # re-running expensive iterations after a transient failure/restart.
    if _path_exists(ckpt_meta_path):
        try:
            ckpt_row  = cp.read(ckpt_meta_path).collect()[0]
            last_iter = ckpt_row["last_completed_iteration"]

            if last_iter == -1:
                # -1 is the "cleanly finished" sentinel written at the bottom
                # of this function — a completed prior run, safe to redo fresh.
                print(f"  [CKPT] Prior run completed cleanly — starting fresh.")

            elif last_iter > 0:
                _candidate_paths = [
                    (f"{match_label}_i{i}", f"{base}/pairs_{match_label}_i{i}.parquet")
                    for i in range(1, last_iter + 1)
                ]
                try:
                    _all_exist = all(
                        _path_exists(p) for _, p in _candidate_paths
                    )
                except Exception:
                    _all_exist = False

                if _all_exist:
                    total_pairs     = ckpt_row["total_pairs"]
                    cur_sales       = cp.read(ckpt_sales_path)
                    cur_credit      = cp.read(ckpt_credit_path)
                    accumulated     = list(_candidate_paths)
                    start_iteration = last_iter + 1
                    print(f"  [CKPT] Resuming from iteration {start_iteration} "
                          f"(pairs so far: {total_pairs:,})")
                else:
                    print(f"  [CKPT] Stale checkpoint (pair files missing) — starting fresh.")
            else:
                print(f"  [CKPT] Checkpoint unreadable (last_iter={last_iter}) — starting fresh.")

        except Exception:
            print(f"  [CKPT] Checkpoint unreadable — starting fresh.")
    else:
        print(f"  [CKPT] No checkpoint found — starting fresh.")

    # ── Main iteration loop ──────────────────────────────────────────────────
    # Each pass: try rank_based_match() on whatever's currently unmatched.
    # Stop when: one side runs out, no candidates pass condition_fn, or a
    # round confirms 0 pairs. Every successful iteration is checkpointed
    # to disk (ckpt_sales/credit/meta) before moving to the next.
    for iteration in range(start_iteration, max_iterations + 1):

        if cur_sales.limit(1).count() == 0 or cur_credit.limit(1).count() == 0:
            print(f"  Iter {iteration}: one side exhausted — stopping.")
            break

        iter_lbl = f"{match_label}_i{iteration}"
        print(f"  Iter {iteration} — matching...")

        pairs, rem_s, rem_c = rank_based_match(
            cur_sales, cur_credit, condition_fn, iter_lbl, stage_path=base
        )

        if pairs is None:
            print(f"  Iter {iteration}: no candidates — stopping.")
            break

        n = pairs.count()
        print(f"  Iter {iteration}: {n:,} pairs.")
        if n == 0:
            break

        total_pairs += n
        pairs = materialize_df(
            pairs.withColumn("match_type", F.lit(match_label)),
            f"pairs_{iter_lbl}", stage_path=base
        )
        accumulated.append((iter_lbl, f"{base}/pairs_{iter_lbl}.parquet"))

        cur_sales  = materialize_df(rem_s, f"rem_s_{match_label}_cur", stage_path=base)
        cur_credit = materialize_df(rem_c, f"rem_c_{match_label}_cur", stage_path=base)

        # Persist checkpoint state so a restart can resume from here.
        cp.write(cur_sales,  ckpt_sales_path,  "overwrite", register=True)
        cp.write(cur_credit, ckpt_credit_path, "overwrite", register=True)
        ckpt_meta = spark.createDataFrame(
            [(match_label, iteration, total_pairs)],
            schema=T.StructType([
                T.StructField("match_label",              T.StringType()),
                T.StructField("last_completed_iteration", T.IntegerType()),
                T.StructField("total_pairs",              T.LongType()),
            ])
        )
        cp.write(ckpt_meta, ckpt_meta_path, "overwrite", register=True)
        print(f"  [CKPT] Iter {iteration} saved. Cumulative pairs: {total_pairs:,}")

    # ── Union accumulated pairs → SLIM ──────────────────────────────────────
    # SLIM_<match_label> = every confirmed pair from every iteration of this
    # step, still in "slim" form (row-id references only, not full columns).
    if not accumulated:
        print(f"  [{match_label}] Total pairs: 0")
        return None, sales_df, credit_df

    slim_df = cp.read(accumulated[0][1])
    for _, path in accumulated[1:]:
        slim_df = slim_df.unionByName(cp.read(path))

    slim_all = materialize_df(slim_df, f"SLIM_{match_label}", stage_path=base)
    print(f"  [{match_label}] Total pairs: {total_pairs:,}")

    # ── Cleanup per-iteration pair files ────────────────────────────────────
    # Once unioned into SLIM_, the individual pairs_<label>_i<n>.parquet files
    # are redundant — delete to keep the stage folder from growing unbounded
    # across many iterations/steps.
    for iter_lbl, path in accumulated:
        try:
            dbutils.fs.rm(path, recurse=True)
            print(f"  [CLEANUP] Removed {path}")
        except Exception:
            pass

    for suffix in [f"rem_s_{match_label}_cur", f"rem_c_{match_label}_cur"]:
        try:
            dbutils.fs.rm(f"{base}/{suffix}.parquet", recurse=True)
        except Exception:
            pass

    # ── Resolve pairs back to original rows ─────────────────────────────────
    # This is the ONLY place resolve_to_original() gets called — turns the
    # slim SLIM_<label> pairs into full-column RESOLVED_<label> output.
    resolved = resolve_to_original(
        slim_all, base_df, match_label,
        f"RESOLVED_{match_label}", base, has_year_flag,
    )

    print(f"  [{match_label}] Resolved rows   : {resolved.count():,}")
    print(f"  [{match_label}] Remaining sales  : {cur_sales.count():,}")
    print(f"  [{match_label}] Remaining credit : {cur_credit.count():,}")

    # ── Mark checkpoint as cleanly complete ─────────────────────────────────
    # last_completed_iteration = -1 is the sentinel checked at the top of this
    # function — tells a future re-run "this step already finished, redo fresh
    # rather than trying to resume a completed run".
    ckpt_done = spark.createDataFrame(
        [(match_label, -1, total_pairs)],
        schema=T.StructType([
            T.StructField("match_label",              T.StringType()),
            T.StructField("last_completed_iteration", T.IntegerType()),
            T.StructField("total_pairs",              T.LongType()),
        ])
    )
    cp.write(ckpt_done, ckpt_meta_path, "overwrite", register=True)

    return resolved, cur_sales, cur_credit


# ── AA Comment logic ─────────────────────────────────────────────────────────
# FIX 1: New param `oto_df` — P3 one-to-one candidate pairs df.
#         Used to derive exact cancel flag per row_id via amount_net == 0.
#         Replaces the broken pair_id-based pair_sum approach (pair_id absent on P3 rows).
# FIX 2: `raw_df` must be FULL raw JE data (not unmatched-only subset).
#         Caller must pass: union(JE_raw, JE_raw_2_aligned) or just JE_raw.
#         See call site note below.
# FIX 3: Rule Group 3 restricted to JE Category == "CREDIT MEMOS" only.

def assign_aa_comment(df, raw_df, oto_df=None,
                      source_quarter_col: str = "Source Quarter",
                      small_amt_threshold: float = SMALL_AMT_MAX):
    """
    Final labeling step: assign an "AA Comment" (human-readable) + "AA Rule"
    (machine-readable audit trace) to every still-unmatched row, in strict
    priority order — FIRST rule to match a row wins, later rules are skipped
    for that row (implemented via `F.when(col.isNull() & condition, ...)`
    chains, so once "AA Comment" is set it's never overwritten).

    INPUT
    ----------
    df                  : P3_ALL_UNMATCHED — union of all 4 Pipeline-3 output
                           buckets (ONE_TO_MANY / DATE_SYNC / DATE_UNSYNC /
                           NO_MATCH_FOUND), each row already carries "match_type".
    raw_df              : FULL raw JE data (ALL rows incl matched) — used ONLY
                           for the Rule-3 vendor-level aggregate stats (how many
                           sales invoices / credit memos / distinct combos does
                           this vendor have anywhere in the whole dataset).
                           Must be union(JE_raw, JE_raw_2_aligned) when carry-
                           forward present, else just JE_raw. (Cell 7 builds
                           this as `raw_for_stats` before calling this function.)
    oto_df              : P3's `oto` table (one-to-one candidates, pre-split
                           into date_sync=True/False) — must have sales_row_id,
                           credit_row_id, amount_net (abs value). Used to look
                           up, per row_id, whether its pair nets to EXACTLY 0
                           (-> "Exact Match") or not (-> "Approx Match").
                           Pass None to disable this check (both DATE_SYNC and
                           DATE_UNSYNC rows would then default to Approx Match).
    source_quarter_col  : column name carrying each row's originating quarter
                          (set via add_source_quarter_col() back in Cell 5) —
                          drives Rule 3 Priority 4 below.
    small_amt_threshold : SMALL_AMT_MAX (module constant, default 5) — Rule 3
                          Priority 3 cutoff.

    OUTPUT: df + "AA Comment" + "AA Rule" columns, all working/temp columns
            dropped again at the very end.

    RULE PRIORITY (first match wins):
      Group 1 — match_type == ONE_TO_MANY               -> AA_REQUIRES_REVIEW
      Group 2a — match_type == ONE_TO_ONE_DATE_SYNC      -> Exact or Approx Match
      Group 2b — match_type == ONE_TO_ONE_DATE_UNSYNC    -> Exact or Approx Match
      Group 3  — match_type == NO_MATCH_FOUND, CREDIT MEMOS only, sub-priority:
                 P1: vendor has zero sales invoices anywhere        -> AA_ONLY_CREDITS
                 P2: vendor has exactly 1 distinct credit combo     -> AA_SINGLE_CREDIT_COMBO
                 P3: abs(amount) <= small_amt_threshold             -> AA_SMALL_AMOUNT
                 P4: eff_dt falls in row's OWN source-quarter's 1st month -> "<Month> Credit Memo"
                 P5: anything else (catch-all)                      -> AA_CLIENT_CONFIRM

    USED BY: Cell 7, called once on P3_ALL_UNMATCHED.
    """

    # ── Ensure helper columns exist ─────────────────────────────────────────
    # Defensive re-derivation in case df arrives without these (idempotent —
    # Cell 6/7 usually already has them from base_tag(), but this function
    # can theoretically be called standalone).
    if "abs_entered_dec" not in df.columns:
        df = df.withColumn("abs_entered_dec", F.abs(to_decimal_clean("Net Entered")))
    if "eff_dt" not in df.columns:
        df = df.withColumn("eff_dt", to_date_clean("Default Effective Date"))
    if "vendor_num_clean" not in df.columns:
        df = df.withColumn("vendor_num_clean",
                           F.trim(F.col("Vendor/Customer Number").cast("string")))
    if "entered_net_dec" not in df.columns:
        df = df.withColumn("entered_net_dec", to_decimal_clean("Net Entered"))
    if "cat_clean" not in df.columns:
        df = df.withColumn("cat_clean", F.trim(F.upper(F.col("JE Category"))))

    # ── Match-type expressions ───────────────────────────────────────────────
    # Booleans over the "match_type" column stamped by Pipeline 3 (Cell 6).
    otm_expr      = F.col("match_type") == "ONE_TO_MANY"
    sync_expr     = F.col("match_type") == "ONE_TO_ONE_DATE_SYNC"
    unsync_expr   = F.col("match_type") == "ONE_TO_ONE_DATE_UNSYNC"
    no_match_expr = F.col("match_type") == "NO_MATCH_FOUND"

    # FIX 3: Rule Group 3 restricted to Credit Memos only — Sales Invoices
    # that reach NO_MATCH_FOUND get NO Rule-3 comment (fall through with
    # AA Comment/Rule staying NULL).
    _no_match_cm  = no_match_expr & (F.col("cat_clean") == "CREDIT MEMOS")

    # ── FIX 1: Exact cancel detection via oto_df ────────────────────────────
    # oto_df has sales_row_id, credit_row_id, amount_net (= abs(sales_amt + credit_amt)).
    # amount_net == 0 means the pair nets to exactly zero.
    # Build a lookup keyed on row_id (works for BOTH sales and credit side of
    # a pair — union both perspectives), join onto df, then a row is an
    # "exact cancel" if its looked-up _pair_net_abs is exactly 0.
    # Only meaningfully applies to DATE_SYNC / DATE_UNSYNC rows below —
    # ONE_TO_MANY and NO_MATCH_FOUND rows won't have an oto_lookup hit anyway.
    if oto_df is not None:
        oto_lookup = (
            oto_df.select(
                F.col("sales_row_id").alias("row_id"),
                F.col("amount_net").cast(DECIMAL_TYPE).alias("_pair_net_abs"),
            ).unionByName(
                oto_df.select(
                    F.col("credit_row_id").alias("row_id"),
                    F.col("amount_net").cast(DECIMAL_TYPE).alias("_pair_net_abs"),
                )
            ).distinct()
        )
        df = df.join(oto_lookup, on="row_id", how="left")
        _exact_cancel = (
            F.col("_pair_net_abs").isNotNull()
            & (F.col("_pair_net_abs") == EXACT_ZERO)
        )
    else:
        # oto_df not supplied — exact match detection disabled for Rule 2a/2b,
        # everything in DATE_SYNC/DATE_UNSYNC falls to "Approx Match" instead.
        df = df.withColumn("_pair_net_abs", F.lit(None).cast(DECIMAL_TYPE))
        _exact_cancel = F.lit(False)

    # ── Rule Group 1: ONE_TO_MANY ────────────────────────────────────────────
    # Multiple sales<->credit candidates shared the same PK — the algorithm
    # can't pick a single confident match, so it's routed to human review.
    # HIGHEST priority (checked/set first — nothing below can override it).
    df = df.withColumn("AA Comment",
        F.when(otm_expr, F.lit(AA_REQUIRES_REVIEW))
         .otherwise(F.lit(None).cast("string"))
    ).withColumn("AA Rule",
        F.when(otm_expr, F.lit("Rule1_OTM_RequiresReview"))
         .otherwise(F.lit(None).cast("string"))
    )

    # ── Rule Group 2a: DATE_SYNC — exact or approx ──────────────────────────
    # Sales invoice date < credit memo date (correct chronological order —
    # the credit memo properly post-dates the invoice it offsets).
    # Exact = pair nets to 0 (per _exact_cancel above). Approx = within
    # P3_TOLERANCE but non-zero residual.
    # `.isNull()` guards mean this ONLY fires for rows Rule Group 1 skipped.
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull() & sync_expr & _exact_cancel,
            F.lit(AA_EXACT_MATCH),
        ).when(
            F.col("AA Comment").isNull() & sync_expr,
            F.lit(AA_APPROX_MATCH),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(F.col("AA Rule").isNull() & sync_expr & _exact_cancel,
               F.lit("Rule2a_DateSync_ExactMatch"))
         .when(F.col("AA Rule").isNull() & sync_expr,
               F.lit("Rule2a_DateSync_ApproxMatch"))
         .otherwise(F.col("AA Rule"))
    )

    # ── Rule Group 2b: DATE_UNSYNC — exact or approx ────────────────────────
    # Credit memo date <= sales invoice date (REVERSED/suspicious order —
    # credit issued before or same-day as the invoice it offsets).
    # Same exact/approx split as 2a, just a different match_type source.
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull() & unsync_expr & _exact_cancel,
            F.lit(AA_EXACT_MATCH),
        ).when(
            F.col("AA Comment").isNull() & unsync_expr,
            F.lit(AA_APPROX_MATCH),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(F.col("AA Rule").isNull() & unsync_expr & _exact_cancel,
               F.lit("Rule2b_DateUnsync_ExactMatch"))
         .when(F.col("AA Rule").isNull() & unsync_expr,
               F.lit("Rule2b_DateUnsync_ApproxMatch"))
         .otherwise(F.col("AA Rule"))
    )

    # ── Rule Group 3: NO_MATCH_FOUND — vendor-level stats ───────────────────
    # FIX 2: raw_df must be FULL raw data (all rows, matched + unmatched).
    #        Using an unmatched-only subset would UNDERCOUNT vendors that had
    #        rows successfully matched away in P1/P2, producing wrong stats.
    # Aggregated on Vendor/Customer Number grain — one row per vendor with:
    #   sales_inv_count     — distinct Sales-Invoice "Invoice Reference" values
    #   credit_memo_count   — distinct Credit-Memo "Invoice Reference" values
    #   credit_combinations — distinct (Vendor#, Net Entered) combos among credits
    vendor_stats = (
        raw_df
        .withColumn("_vn_clean", F.trim(F.col("Vendor/Customer Number").cast("string")))
        .withColumn("_cat",      F.trim(F.upper(F.col("JE Category"))))
        .groupBy("_vn_clean")
        .agg(
            F.countDistinct(
                F.when(F.col("_cat") == "SALES INVOICES", F.col("Invoice Reference"))
            ).alias("sales_inv_count"),
            F.countDistinct(
                F.when(F.col("_cat") == "CREDIT MEMOS", F.col("Invoice Reference"))
            ).alias("credit_memo_count"),
            F.countDistinct(
                F.when(F.col("_cat") == "CREDIT MEMOS",
                       F.concat_ws("|",
                           F.col("Vendor/Customer Number"),
                           F.col("Net Entered"),
                       ))
            ).alias("credit_combinations"),
        )
    )

    df = (
        df.join(
            vendor_stats.withColumnRenamed("_vn_clean", "_vn_join"),
            df["vendor_num_clean"] == F.col("_vn_join"),
            "left",
        )
        .drop("_vn_join")
    )

    # Priority 1 — vendor has ONLY credit memos, zero sales invoices at all
    # (across the FULL dataset, thanks to FIX 2). Strong signal this vendor
    # never had a matching invoice to begin with.
    # FIX 3: _no_match_cm restricts to Credit Memos only.
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull()
            & _no_match_cm
            & (F.col("sales_inv_count") == 0)
            & (F.col("credit_memo_count") > 0),
            F.lit(AA_ONLY_CREDITS),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(
            F.col("AA Rule").isNull() & _no_match_cm
            & (F.col("sales_inv_count") == 0) & (F.col("credit_memo_count") > 0),
            F.lit("Rule3P1_OnlyCredits"),
        ).otherwise(F.col("AA Rule"))
    )

    # Priority 2 — vendor has exactly ONE unique credit-memo (vendor#, amount)
    # combination anywhere — i.e. this credit memo isn't ambiguous even though
    # it didn't algorithmically match; there's nothing else it could be.
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull()
            & _no_match_cm
            & (F.col("credit_combinations") == 1),
            F.lit(AA_SINGLE_CREDIT_COMBO),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(
            F.col("AA Rule").isNull() & _no_match_cm
            & (F.col("credit_combinations") == 1),
            F.lit("Rule3P2_SingleCreditCombo"),
        ).otherwise(F.col("AA Rule"))
    )

    # Priority 3 — small absolute amount (<= small_amt_threshold, default 5).
    # Immaterial-value credit memos get auto-flagged rather than reviewed.
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull()
            & _no_match_cm
            & F.col("abs_entered_dec").isNotNull()
            & (F.col("abs_entered_dec") <= F.lit(small_amt_threshold).cast(DECIMAL_TYPE)),
            F.lit(AA_SMALL_AMOUNT),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(
            F.col("AA Rule").isNull() & _no_match_cm
            & (F.col("abs_entered_dec") <= F.lit(small_amt_threshold).cast(DECIMAL_TYPE)),
            F.lit(f"Rule3P3_SmallAmt_le{small_amt_threshold}"),
        ).otherwise(F.col("AA Rule"))
    )

    # Priority 4 — effective date falls in the FIRST calendar month of the
    # row's OWN "Source Quarter" (per-row, not the global CURRENT_QUARTER —
    # this matters for carry-forward rows whose source quarter differs).
    # e.g. a Q2 row (Apr/May/Jun) flagged if eff_dt's month == April.
    _sq_col = F.col(source_quarter_col)
    _first_month_of_sq = (
        F.when(_sq_col == "Q1", F.lit(1))
         .when(_sq_col == "Q2", F.lit(4))
         .when(_sq_col == "Q3", F.lit(7))
         .when(_sq_col == "Q4", F.lit(10))
         .otherwise(F.lit(None).cast(T.IntegerType()))
    )
    _first_month_label_of_sq = (
        F.when(_sq_col == "Q1", F.lit("January"))
         .when(_sq_col == "Q2", F.lit("April"))
         .when(_sq_col == "Q3", F.lit("July"))
         .when(_sq_col == "Q4", F.lit("October"))
         .otherwise(F.lit("Unknown"))
    )
    _first_month_comment = F.concat(_first_month_label_of_sq, F.lit(" Credit Memo"))

    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull()
            & _no_match_cm
            & F.col("eff_dt").isNotNull()
            & (F.month(F.col("eff_dt")) == _first_month_of_sq),
            _first_month_comment,
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(
            F.col("AA Rule").isNull() & _no_match_cm
            & (F.month(F.col("eff_dt")) == _first_month_of_sq),
            F.concat(F.lit("Rule3P4_FirstMonthOfQtr_"), _sq_col),
        ).otherwise(F.col("AA Rule"))
    )

    # Priority 5 — catch-all: any remaining Credit Memo with no match and no
    # prior rule hit gets pushed to the client for manual confirmation.
    df = df.withColumn("AA Comment",
        F.when(
            F.col("AA Comment").isNull() & _no_match_cm,
            F.lit(AA_CLIENT_CONFIRM),
        ).otherwise(F.col("AA Comment"))
    ).withColumn("AA Rule",
        F.when(
            F.col("AA Rule").isNull() & _no_match_cm,
            F.lit("Rule3P5_ClientConfirm"),
        ).otherwise(F.col("AA Rule"))
    )

    # Drop all temp columns added during this function — caller only wants
    # "AA Comment" / "AA Rule" added to their original schema.
    return df.drop("_pair_net_abs", "sales_inv_count", "credit_memo_count", "credit_combinations")


# ── Match-step config ────────────────────────────────────────────────────────
# MATCH_STEPS: the ORDERED sequence of business rules applied by
# run_match_pipeline() -> exhaustive_match() -> rank_based_match(). Each step
# only sees whatever's LEFT OVER from the previous step (progressively looser
# / different month-lag windows). Order matters: exact same-month/next-month
# matches are tried before wider multi-month lag windows.
#
# NOTE: "SAME_MONTH_EXACT" and "SAME_MONTH_ITERATIVE" currently have the
# IDENTICAL filter condition. Because each step consumes the previous step's
# leftovers, by the time "SAME_MONTH_ITERATIVE" runs, every row satisfying
# that condition was already claimed by "SAME_MONTH_EXACT" — so this step
# will always find 0 candidates and is effectively a no-op placeholder.
# Flag for review — likely either a copy/paste leftover or missing a distinct
# condition it was meant to have.
MATCH_STEPS = [
    (
        "NEXT_MONTH_EXACT",
        # credit memo posted exactly 1 month after the sales invoice, in
        # correct chronological order, amounts net to exactly 0
        lambda df: df.filter(
            (F.col("month_lag") == 1)
            & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
            & (F.col("amount_diff") == EXACT_ZERO)
        ),
    ),
    (
        "SAME_MONTH_EXACT",
        # same calendar month, correct date order, exact net-zero
        lambda df: df.filter(
            (F.col("month_lag") == 0)
            & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
            & (F.col("amount_diff") == EXACT_ZERO)
        ),
    ),
    (
        "LAG_1_2_MONTH",
        # widen the window: 1-2 months lag, correct order, exact net-zero
        lambda df: df.filter(
            F.col("month_lag").between(1, 2)
            & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
            & (F.col("amount_diff") == EXACT_ZERO)
        ),
    ),
    (
        "SAME_MONTH_ITERATIVE",
        # ⚠ SEE NOTE ABOVE — identical condition to SAME_MONTH_EXACT, so this
        # step will find nothing (everything it could match was already
        # claimed 2 steps earlier). Kept as-is per original logic — flag to
        # author before assuming it's dead code.
        lambda df: df.filter(
            (F.col("month_lag") == 0)
            & (F.col("s.sales_eff_dt") <= F.col("c.credit_eff_dt"))
            & (F.col("amount_diff") == EXACT_ZERO)
        ),
    ),
]

# ── Multi-step match orchestrator ────────────────────────────────────────────
def run_match_pipeline(sales_df, credit_df, base_df,
                       steps: list, stage_path: str,
                       has_year_flag: bool = False):
    """
    Drive the full MATCH_STEPS sequence for one pipeline (P1 or P2).
    Each step consumes the *remaining* (still-unmatched) sales/credit output
    of the PREVIOUS step — chained via cur_s/cur_c reassignment in the loop.

    INPUT  : sales_df, credit_df — initial slim tables (make_sales/make_credit output)
             base_df — full tagged dataframe (for resolve_to_original() lookups)
             steps — MATCH_STEPS list of (label, condition_fn) tuples
             stage_path — STAGE_PATH_P1 or STAGE_PATH_P2
             has_year_flag — True for Pipeline 2 only (adds Year Pair Flag)
    OUTPUT : (resolved_datasets, cur_s, cur_c)
             resolved_datasets — list[(match_label, resolved_df_or_None)], one
                                 per MATCH_STEPS entry, in order
             cur_s / cur_c     — whatever sales/credit rows NO step could match,
                                 fed onward: P1's leftovers -> Pipeline 2 input,
                                 P2's leftovers -> Pipeline 3 input.
    USED BY: Cell 4 (Pipeline 1) and Cell 5 (Pipeline 2).
    """
    resolved_datasets = []
    cur_s, cur_c = sales_df, credit_df

    for match_label, condition_fn in steps:
        resolved, cur_s, cur_c = exhaustive_match(
            cur_s, cur_c, condition_fn, match_label,
            base_df, stage_path=stage_path, has_year_flag=has_year_flag,
        )
        resolved_datasets.append((match_label, resolved))

    return resolved_datasets, cur_s, cur_c

