def _detect_quarter_from_string(s: str):
    """
    Try to extract 'Qn' (n=1-4) from a path/filename string via regex.
    INPUT  : any string (here: output_path)
    OUTPUT : "Q1".."Q4" or None if no match
    CALLED BY: the auto-detect block immediately below.
    """
    m = re.search(r'Q([1-4])', s, re.IGNORECASE)
    return f"Q{m.group(1)}" if m else None


def _prompt_quarter(widget_name: str, prompt_text: str = "Select Quarter"):
    """
    Create (or recreate) a Databricks dropdown widget for quarter selection.
    INPUT  : widget_name — internal widget key; prompt_text — label shown to user
    OUTPUT : the string value the user picked ("Q1".."Q4"), default "Q1"
    CALLED BY: fallback path when auto-detect fails, AND the carry-forward
               quarter prompt further down.
    NOTE: removes any pre-existing widget of the same name first, to guarantee
          the choice list always includes "Q1" as default (avoids stale widget
          state from a prior notebook run with different options).
    """
    try:
        dbutils.widgets.remove(widget_name)
    except Exception:
        pass

    dbutils.widgets.dropdown(
        widget_name,
        "Q1",
        ["Q1", "Q2", "Q3", "Q4"],
        prompt_text,
    )
    return dbutils.widgets.get(widget_name)


