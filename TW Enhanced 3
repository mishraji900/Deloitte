def _path_exists(path: str) -> bool:
    """
    Quiet existence check for DBFS / UC Volumes / ABFS paths, via raw Hadoop
    FileSystem API — avoids dbutils.fs.ls() which logs noisy ERROR lines on
    a missing path.
    INPUT  : path (str)
    OUTPUT : True/False
    USED BY: exhaustive_match()'s checkpoint-resume logic below.
    """
    try:
        jvm = spark._jvm
        hconf = spark._jsc.hadoopConfiguration()
        jpath = jvm.org.apache.hadoop.fs.Path(path)
        fs = jpath.getFileSystem(hconf)
        return fs.exists(jpath)
    except Exception as e:
        # Optional: keep this as False for fail-closed behavior,
        # or log at WARN if you want observability without hard failure.
        print(f"[WARN] _path_exists unexpected error for {path}: {e}")
        return False


def write_table(df, name: str, log: bool = True, base_path: str = None):
    """
    Final-output writer (distinct from materialize_df — this one does NOT
    read the file back, it's write-only, used for cell-ending deliverables).
    INPUT  : df — dataframe to persist (or None, in which case it's skipped)
             name — file name (no extension)
             base_path — defaults to output_path (final export area);
                         Cells 4/5/6 pass base_path=output_path_et explicitly.
    OUTPUT : none (side-effect: parquet file written)
    USED BY: end of every pipeline cell (P1/P2/P3 "Write outputs" steps),
             and the AA-comment cell (Cell 7).
    """
    if df is None:
        print(f"  [SKIP] {name} – no data")
        return
    path = f"{base_path or output_path}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    if log:
        print(f"  [WRITTEN] {path}")


def materialize_df(df, name: str, repartition_key: str = None,
                   stage_path: str = None, num_partitions: int = NUM_PARTITIONS):
    """
    Write df to a STAGE (scratch) parquet path and immediately re-read it.
    THE key perf trick of this whole notebook: every multi-step transformation
    chain gets "checkpointed" through disk to break Spark's lazy query plan,
    which would otherwise balloon exponentially across the iterative match
    loops in exhaustive_match().
    INPUT  : df — dataframe to snapshot
             name — file name (no extension)
             repartition_key — optional column to repartition on BEFORE writing
                               (used for skew control on "primary_key" heavy joins)
             stage_path — folder (STAGE_PATH_P1/P2/P3); defaults to output_path
    OUTPUT : the freshly re-read dataframe (fully materialized, lineage reset)
    USED BY: virtually every step in Cells 3/4/5/6 — this is the single most
             called function in the file.
    """
    print(f"  [MATERIALIZE] {name}")
    base = stage_path or output_path
    if repartition_key and repartition_key in df.columns:
        df = df.repartition(num_partitions, repartition_key)
    path = f"{base}/{name}.parquet"
    cp.write(df, path, "overwrite", register=True)
    return cp.read(path)


