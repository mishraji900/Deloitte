# DBTITLE 1,Pipeline 3 : Approx match using PQ and CQ Data
# =============================================================================
# CELL 6 — PIPELINE 3 (Tolerance matching on looser PK)
# GOAL: everything P1+P2 couldn't exactly match gets one more pass using a
# LOOSER primary key (Company + Vendor ONLY — no amount) and a tolerance
# window (±P3_TOLERANCE=100) instead of requiring an exact net-to-zero.
# Every row entering this pipeline ends up in EXACTLY ONE of 4 buckets —
# there is no further "unmatched, drop it" concept after Pipeline 3; row-
# count conservation is asserted explicitly at Step P3-8.
# INPUT  : P2_ALL_UNMATCHED (from Cell 5)
# OUTPUT : P3_ONE_TO_MANY     — ambiguous, multiple candidates share the PK
#          P3_DATE_SYNC       — 1:1 match, correct chronological order
#          P3_DATE_UNSYNC     — 1:1 match, reversed/same-day order
#          P3_NO_MATCH_FOUND  — nothing in tolerance range, or PK invalid
#          all 4 feed Cell 7 (AA comment tagging) and Cell 8 (final export)
# =============================================================================
print("\n" + "="*70)
print("PIPELINE 3 — Tolerance matching on looser PK (no amount in key)")
print("="*70)

# ── Step P3-0: Prep derived columns ──────────────────────────────────────────
# Re-tag P2's unmatched leftovers via base_tag() (same helper cols as before),
# then compute the LOOSER "p3_primary_key" = Company + Vendor (no amount).
# Rows where Company or Vendor itself is invalid get p3_primary_key = NULL
# and are split off into p3_invalid_pk (later folded into P3_NO_MATCH_FOUND).
print("\n[P3-S0] Preparing derived columns on P2 unmatched...")

p3_input = base_tag(P2_ALL_UNMATCHED, PIPE2_RAW_COLUMNS)

p3_input = p3_input.withColumn(
    "p3_primary_key",
    F.when(
        F.col("valid_company_desc").isNull()
        | (F.col("company_desc_clean") == "")
        | F.col("valid_vendor_num").isNull()
        | (F.col("vendor_num_clean") == ""),
        F.lit(None),
    ).otherwise(
        F.concat_ws("_", F.col("company_desc_clean"), F.col("vendor_num_clean"))
    )
).drop("is_valid_row", "valid_company_desc", "valid_vendor_num")

p3_invalid_pk = materialize_df(
    p3_input.filter(F.col("p3_primary_key").isNull()),
    "P3_invalid_pk", "row_id", stage_path=STAGE_PATH_P3,
)
# p3_base = every row with a usable p3_primary_key — the actual candidate
# pool for the tolerance cross-join below.
p3_base = materialize_df(
    p3_input.filter(F.col("p3_primary_key").isNotNull()),
    "P3_base", "p3_primary_key", stage_path=STAGE_PATH_P3,
)

debug_count("P3 valid PK",   p3_base)
debug_count("P3 invalid PK", p3_invalid_pk)

# ── Null profile on invalid PK rows ──────────────────────────────────────────
# Pure diagnostic printout — doesn't produce a dataset, just logs WHY rows
# landed in p3_invalid_pk (missing company vs vendor vs both).
print("\n  [PROFILE] PK failure breakdown")
p3_invalid_pk.select(
    F.sum(
        F.when(F.col("company_desc_clean").isNull() | (F.col("company_desc_clean") == ""), 1)
         .otherwise(0)
    ).alias("missing_company_desc"),
    F.sum(
        F.when(F.col("vendor_num_clean").isNull() | (F.col("vendor_num_clean") == ""), 1)
         .otherwise(0)
    ).alias("missing_vendor_num"),
    F.sum(
        F.when(
            (F.col("company_desc_clean").isNull() | (F.col("company_desc_clean") == ""))
            & (F.col("vendor_num_clean").isNull()  | (F.col("vendor_num_clean") == "")),
            1
        ).otherwise(0)
    ).alias("missing_both"),
).show(truncate=False)

# ── Step P3-2: Sales / credit side tables ────────────────────────────────────
# Same make_sales()/make_credit() helpers as P1/P2, but note the pk_col
# argument is "p3_primary_key" here instead of the default "primary_key".
print("\n[P3-S2] Building sales / credit side tables...")

p3_sales  = materialize_df(make_sales(p3_base,  "p3_primary_key"), "P3_sales",  stage_path=STAGE_PATH_P3)
p3_credit = materialize_df(make_credit(p3_base, "p3_primary_key"), "P3_credit", stage_path=STAGE_PATH_P3)

debug_count("P3 sales",  p3_sales)
debug_count("P3 credit", p3_credit)

# ── Step P3-3: Tolerance cross-join ──────────────────────────────────────────
# Unlike P1/P2's rank_based_match(), P3 does a SIMPLE inner join within each
# p3_primary_key group and keeps ANY pair where the net amount is within
# P3_TOLERANCE (100) — no ranking/mutual-best-match step yet (that's next,
# in P3-S4/S5/S6's one-to-many vs one-to-one split).
print(f"\n[P3-S3] Cross-joining within PK; tolerance = {P3_TOLERANCE}...")

_tol = F.lit(P3_TOLERANCE).cast(DECIMAL_TYPE)

p3_candidates = (
    p3_sales.alias("s")
    .join(p3_credit.alias("c"), on="primary_key", how="inner")
    .withColumn("amount_net", F.abs(F.col("s.sales_amt") + F.col("c.credit_amt")))
    .filter(F.col("amount_net") <= _tol)
    .select(
        "primary_key",
        F.col("s.sales_row_id"),  F.col("c.credit_row_id"),
        F.col("s.sales_amt"),     F.col("c.credit_amt"),     F.col("amount_net"),
        F.col("s.sales_eff_dt"),  F.col("c.credit_eff_dt"),
        F.col("s.sales_month"),   F.col("c.credit_month"),
        F.col("s.sales_ref"),     F.col("c.credit_ref"),
    )
)
p3_candidates = materialize_df(p3_candidates, "P3_candidates", stage_path=STAGE_PATH_P3)
debug_count("P3 candidates (within tolerance)", p3_candidates)

# ── Step P3-4: One-to-many vs one-to-one classification ─────────────────────
# For each candidate pair, count how many DISTINCT credits could match this
# sale (credit_count_per_sale) and vice versa (sales_count_per_credit).
# If either side has >1 possible partner, the WHOLE pair is "is_one_to_many"
# — ambiguous, can't auto-resolve.
print("\n[P3-S4] Classifying one-to-many vs one-to-one...")

sales_match_cts = (
    p3_candidates
    .groupBy("sales_row_id")
    .agg(F.countDistinct("credit_row_id").alias("credit_count_per_sale"))
)
credit_match_cts = (
    p3_candidates
    .groupBy("credit_row_id")
    .agg(F.countDistinct("sales_row_id").alias("sales_count_per_credit"))
)

p3_classified = (
    p3_candidates
    .join(sales_match_cts,  on="sales_row_id",  how="left")
    .join(credit_match_cts, on="credit_row_id", how="left")
    .withColumn("is_one_to_many",
        (F.col("credit_count_per_sale") > 1) | (F.col("sales_count_per_credit") > 1))
)
p3_classified = materialize_df(p3_classified, "P3_classified", stage_path=STAGE_PATH_P3)

# ── Step P3-5: ONE_TO_MANY ────────────────────────────────────────────────────
# Collect every row_id (sales OR credit side) involved in ANY ambiguous pair
# -> pull their FULL original rows from p3_base -> tag match_type=ONE_TO_MANY.
# This becomes AA_REQUIRES_REVIEW in assign_aa_comment() (Cell 7, Rule Group 1).
print("\n[P3-S5] Building ONE_TO_MANY dataset...")

otm_ids = (
    p3_classified.filter(F.col("is_one_to_many"))
    .select(F.col("sales_row_id").alias("row_id"))
    .unionByName(
        p3_classified.filter(F.col("is_one_to_many"))
        .select(F.col("credit_row_id").alias("row_id"))
    )
    .distinct()
)

P3_ONE_TO_MANY = materialize_df(
    p3_base.join(otm_ids, on="row_id", how="inner")
           .withColumn("match_type", F.lit("ONE_TO_MANY")),
    "P3_ONE_TO_MANY", stage_path=STAGE_PATH_P3,
)
debug_count("P3_ONE_TO_MANY", P3_ONE_TO_MANY)

# ── Step P3-6: ONE_TO_ONE — date sync / unsync ──────────────────────────────
# For the NON-ambiguous pairs, split by date ordering:
#   date_sync = True  -> sales_eff_dt < credit_eff_dt (correct chronological order)
#   date_sync = False -> credit_eff_dt <= sales_eff_dt (reversed/same-day, suspicious)
# `oto` (one-to-one candidates) is THE table later passed into assign_aa_comment()
# as `oto_df` in Cell 7 — used there to check if a pair nets to exactly 0.
print("\n[P3-S6] Building DATE_SYNC / DATE_UNSYNC datasets...")

oto = (
    p3_classified.filter(~F.col("is_one_to_many"))
    .withColumn("date_sync", F.col("sales_eff_dt") < F.col("credit_eff_dt"))
)
oto = materialize_df(oto, "P3_oto", stage_path=STAGE_PATH_P3)


def _ids_for_flag(oto_df, flag_val):
    """
    Collect distinct row_ids (both sales & credit side) for a given date_sync
    boolean value.
    INPUT  : oto_df (the `oto` table above), flag_val (True or False)
    OUTPUT : single-column ("row_id") distinct dataframe
    USED BY: the sync_ids / unsync_ids assignments immediately below.
    """
    flt = oto_df.filter(F.col("date_sync") == flag_val)
    return (
        flt.select(F.col("sales_row_id").alias("row_id"))
           .unionByName(flt.select(F.col("credit_row_id").alias("row_id")))
           .distinct()
    )


sync_ids   = _ids_for_flag(oto, True)
unsync_ids = _ids_for_flag(oto, False)

P3_DATE_SYNC = materialize_df(
    p3_base.join(sync_ids, on="row_id", how="inner")
           .withColumn("match_type", F.lit("ONE_TO_ONE_DATE_SYNC")),
    "P3_DATE_SYNC", stage_path=STAGE_PATH_P3,
)
P3_DATE_UNSYNC = materialize_df(
    p3_base.join(unsync_ids, on="row_id", how="inner")
           .withColumn("match_type", F.lit("ONE_TO_ONE_DATE_UNSYNC")),
    "P3_DATE_UNSYNC", stage_path=STAGE_PATH_P3,
)

debug_count("P3_DATE_SYNC",   P3_DATE_SYNC)
debug_count("P3_DATE_UNSYNC", P3_DATE_UNSYNC)

# ── Step P3-7: NO_MATCH_FOUND ────────────────────────────────────────────────
# Everything from p3_base that ISN'T in otm_ids/sync_ids/unsync_ids (i.e. had
# no candidate within tolerance at all), PLUS everything from p3_invalid_pk
# (couldn't even form a p3_primary_key) — both tagged match_type=NO_MATCH_FOUND.
print("\n[P3-S7] Building NO_MATCH_FOUND...")

matched_ids_all = (
    otm_ids
    .unionByName(sync_ids)
    .unionByName(unsync_ids)
    .distinct()
)

p3_no_match = materialize_df(
    p3_base.join(matched_ids_all, on="row_id", how="left_anti")
           .withColumn("match_type", F.lit("NO_MATCH_FOUND")),
    "P3_no_match", stage_path=STAGE_PATH_P3,
)

P3_NO_MATCH_FOUND = materialize_df(
    union_non_null(
        p3_no_match,
        p3_invalid_pk.withColumn("match_type", F.lit("NO_MATCH_FOUND")),
    ),
    "P3_NO_MATCH_FOUND", stage_path=STAGE_PATH_P3,
)
debug_count("P3_NO_MATCH_FOUND", P3_NO_MATCH_FOUND)

# ── Step P3-8: Row conservation audit ────────────────────────────────────────
# Hard assertion: every row that went INTO Pipeline 3 (p3_input) must land in
# EXACTLY one of the 4 output buckets — no row silently dropped or duplicated.
# This is the strongest data-integrity check in the whole notebook; if it
# ever fails, something upstream is double-counting or losing rows.
print("\n[P3-S8] === PIPELINE 3 AUDIT ===")

cnt_in       = p3_input.count()
cnt_otm      = P3_ONE_TO_MANY.count()
cnt_sync     = P3_DATE_SYNC.count()
cnt_unsync   = P3_DATE_UNSYNC.count()
cnt_no_match = P3_NO_MATCH_FOUND.count()
cnt_out      = cnt_otm + cnt_sync + cnt_unsync + cnt_no_match

print(f"\n  {'INPUT  — p3_input':<50} {cnt_in:>10,}")
print(f"  {'OUTPUT — P3_ONE_TO_MANY':<50} {cnt_otm:>10,}")
print(f"  {'OUTPUT — P3_DATE_SYNC':<50} {cnt_sync:>10,}")
print(f"  {'OUTPUT — P3_DATE_UNSYNC':<50} {cnt_unsync:>10,}")
print(f"  {'OUTPUT — P3_NO_MATCH_FOUND':<50} {cnt_no_match:>10,}")
print(f"  {'-'*62}")
print(f"  {'Total IN':<50} {cnt_in:>10,}")
print(f"  {'Total OUT':<50} {cnt_out:>10,}")
print(f"  {'Diff (should be 0)':<50} {cnt_in - cnt_out:>10,}")

assert cnt_in == cnt_out, (
    f"Row count mismatch! IN={cnt_in:,}  OUT={cnt_out:,}  DIFF={cnt_in - cnt_out:,}"
)

# ── Step P3-9: Write outputs ──────────────────────────────────────────────────
print("\n[P3-S9] Writing Pipeline 3 outputs...")

write_table(P3_ONE_TO_MANY,    "P3_ONE_TO_MANY",    base_path=output_path_et)
write_table(P3_DATE_SYNC,      "P3_DATE_SYNC",      base_path=output_path_et)
write_table(P3_DATE_UNSYNC,    "P3_DATE_UNSYNC",    base_path=output_path_et)
write_table(P3_NO_MATCH_FOUND, "P3_NO_MATCH_FOUND", base_path=output_path_et)


print("\n[P3] Done.")

