# ── Final row conservation check across all pipelines ───────────────────────
# THE final sanity check for the entire notebook: sum row counts across every
# terminal dataset and compare to the original JE_raw count. Any mismatch
# means a row was dropped or double-counted somewhere in P1/P2/P3/AA.
# NOTE: unlike Pipeline 3's internal check (Step P3-8, which `assert`s), this
# one only PRINTS the diff — it does not halt execution on mismatch.
print("\n[FINAL] === END-TO-END ROW CONSERVATION CHECK ===")

total_raw = JE_raw.count()
print(f"Raw rows: {total_raw:,}")

dfs = {
    "all_invalid": all_invalid,
    "all_exc_1": all_exc_1,
    "all_dup_other": all_dup_other,
    "all_unique_other": all_unique_other,
    "P1_ALL_MATCHED": P1_ALL_MATCHED,
    "P2_ALL_MATCHED": P2_ALL_MATCHED,
    "P3_ALL_UNMATCHED_COMMENTED": P3_ALL_UNMATCHED_COMMENTED,
}

total_out = 0
for name, df in dfs.items():
    if df is None:
        print(f"  {name}: None")
        continue
    try:
        cnt = df.count()
        print(f"  {name}: {cnt:,}")
        total_out += cnt
    except Exception as e:
        print(f"  [ERROR] {name} caused: {e}")
        # Optional: print schema to see columns
        # df.printSchema()
        raise

print(f"Total out: {total_out:,}")
print("\n[DONE] All pipelines complete.")

