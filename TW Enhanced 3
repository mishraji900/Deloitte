debug_count("P3 Unmatched with AA Comment", P3_ALL_UNMATCHED_COMMENTED)
debug_group_count(P3_ALL_UNMATCHED_COMMENTED, "AA Comment", "AA Comment distribution")
debug_group_count(P3_ALL_UNMATCHED_COMMENTED, "AA Rule",    "AA Rule distribution (audit trace)")

