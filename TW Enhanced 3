def align_to_raw(df, drop_cols, rename_map, target_cols):
    """
    Strip working/derived columns, apply any renames, then reshape to
    target_cols (keeping only columns that exist — missing ones are left
    for ensure_required_columns() to pad with NULL later in base_tag()).
    INPUT  : df, drop_cols (_P1_DROP), rename_map (_RENAME), target_cols (BASE_RAW_COLUMNS)
    OUTPUT : df reshaped back to raw-JE-like schema
    USED BY: this cell only — converts P1_ALL_UNMATCHED into cy_unmatched below.
    """
    df = df.drop(*[c for c in drop_cols if c in df.columns])
    for old, new in rename_map.items():
        if old in df.columns:
            df = df.withColumnRenamed(old, new)
    return df.select(*[c for c in target_cols if c in df.columns])


