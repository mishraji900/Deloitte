def audit_summary(datasets: dict):
    """
    Print a formatted {label: row_count} table for a dict of named dataframes.
    INPUT  : datasets — {label: dataframe_or_None}
    OUTPUT : bool — True if every dataset was non-None
    USED BY: end of each pipeline cell ("=== PIPELINE N AUDIT ===" blocks).
    """
    print(f"\n  {'Dataset':<50} {'Count':>10}")
    print(f"  {'-' * 62}")
    total = 0
    ok    = True
    for label, df in datasets.items():
        if df is None:
            print(f"  {label:<50} {'None':>10}")
            ok = False
        else:
            n      = df.count()
            total += n
            print(f"  {label:<50} {n:>10,}")
    print(f"  {'-' * 62}")
    print(f"  {'TOTAL':<50} {total:>10,}")
    return ok


def export_to_excel(sheets: dict, path: str):
    """
    Final workbook writer — ONE call, at the very end of the whole pipeline
    (Cell 8). Converts each named Spark dataframe to a pandas-on-Spark frame,
    drops internal working columns, reorders a few "front" columns for
    readability, then writes every {name: df} pair as its own sheet.
    INPUT  : sheets — {sheet_name: spark_dataframe}, path — output .xlsx path
    OUTPUT : none (side-effect: workbook written to `path`)
    USED BY: Cell 8 only, once, with the 7 final consolidated datasets.
    NOTE: "Source Quarter" is explicitly protected from the drop list — it
          must survive into the final workbook for audit traceability.
    """
    _front = ["primary_key", "JE Category", "Net Entered",
              "Default Effective Date", "Source Quarter"]
    _drop  = {
        "pair_id", "pk_row_count", "row_id", "invoice_ref_clean", "cat_clean",
        "company_desc_clean", "vendor_num_clean", "eff_dt", "month_dt",
        "entered_net_dec", "abs_entered_dec", "abs_entered_key",
        "is_valid_row", "valid_company_desc", "valid_vendor_num", "abs_usd_net",
        "p3_primary_key",
        # Source Quarter is intentionally NOT here
    }

    def _prep(df):
        # Per-sheet cleanup: strip internal cols, front-load key cols, convert
        # to pandas-on-Spark (required by cp.pandas.to_excel below).
        if df is None:
            return None
        df            = df.drop(*[c for c in _drop if c in df.columns])
        present_front = [c for c in _front if c in df.columns]
        rest          = [c for c in df.columns if c not in present_front]
        return df.select(*(present_front + rest)).pandas_api()

    cp.pandas.to_excel(
        dataframes  =[_prep(df) for df in sheets.values()],
        sheet_names =list(sheets.keys()),
        path        =path,
    )
    print(f"  [EXCEL] Written → {path}")


